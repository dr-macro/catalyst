<edge source="europe_political_turbule::political_stability" target="iran_hormuz_escalation::maritime_security_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute political instability in major European NATO states precipitates rapid redeployment of naval and air assets to domestic/European security tasks, reducing allied patrols and convoy-escort capacity in the Gulf and thereby raising the immediate maritime security risk in and around the Strait of Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">europe_political_turbule</data>
  <data key="d39">iran_hormuz_escalation</data>
</edge>
<edge source="europe_political_turbule::political_stability" target="russia_ukraine_war::allied_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Sharp declines in political stability in one or more key European governments (e.g., collapse of coalitions, leadership crises) directly reduce those governments' capacity and mandate to participate in coordinated Ukraine policy, producing visible fractures in allied unity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">europe_political_turbule</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
