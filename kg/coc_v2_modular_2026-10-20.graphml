  <data key="d36">Rapid churn in U.S. executive personnel raises near‑term uncertainty about trade, sanctions and macro policy cues, producing repricing and higher short‑term volatility in European equity, bond and FX markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">united_states_realignmen</data>
  <data key="d39">europe_political_turbule</data>
</edge>
<edge source="united_states_realignmen::exec_turnover_rate" target="iran_hormuz_escalation::maritime_security_risk" id="0">
