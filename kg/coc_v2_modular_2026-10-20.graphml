<edge source="iran_hormuz_escalation::oil_price_level" target="europe_political_turbule::domestic_market_volatili" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Sharp increases in benchmark oil prices raise input-cost uncertainty and inflation expectations, prompting rapid repricing in equities, bonds and currency markets and raising short-term domestic financial volatility in Europe.</data>
  <data key="d37">0-3 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">europe_political_turbule</data>
</edge>
<edge source="iran_hormuz_escalation::oil_price_level" target="europe_political_turbule::political_stability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Sustained elevated oil prices translate into higher consumer energy costs and inflation that erode government approval and increase the risk of cabinet strain or government turnover in fiscally or politically vulnerable European states.</data>
  <data key="d37">3-12 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">europe_political_turbule</data>
</edge>
<edge source="iran_hormuz_escalation::oil_price_level" target="russia_ukraine_war::sanctions_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sharp increases in oil prices driven by Hormuz-area tensions create domestic economic pain in energy-importing states and political pressure on executives and legislatures to avoid further sanctions that would exacerbate prices, reducing the willingness to escalate sanctions on Russia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
