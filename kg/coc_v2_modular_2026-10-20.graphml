<edge source="china_tech_trade_rivalry::export_control_strength" target="russia_ukraine_war::arms_supply_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Escalating export controls targeting Chinese access to advanced components incentivize Beijing or Chinese suppliers to relax export checks, route dual‑use parts via third countries, or prioritize transfers to Russia (political reciprocity), increasing the effective rate of arms‑relevant hardware reaching Russian forces.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_tech_trade_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
