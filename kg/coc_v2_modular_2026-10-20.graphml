<edge source="europe_political_turbule::protest_activity_intensi" target="china_tech_trade_rivalry::supply_chain_integration" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Large-scale, sustained protests in Europe disrupt ports, trucking and warehousing and push European firms to delay orders or re-route sourcing away from China, reducing practical connectivity and mutual dependence in supply networks.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">europe_political_turbule</data>
  <data key="d39">china_tech_trade_rivalry</data>
</edge>
<edge source="europe_political_turbule::protest_activity_intensi" target="russia_ukraine_war::arms_supply_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Large, sustained domestic protests opposing military aid or calling for neutrality put pressure on executives and parliaments to delay, restrict, or block weapons transfers, reducing the rate of arms deliveries to Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">europe_political_turbule</data>
  <data key="d39">russia_ukraine_war</data>
