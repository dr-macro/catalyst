<edge source="iran_hormuz_escalation::maritime_security_risk" target="china_tech_trade_rivalry::supply_chain_integration" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained increases in maritime security risk (e.g., in the Strait of Hormuz) force firms to reroute, shorten, or regionalize logistics and source inputs away from vulnerable sea lanes linking China to customers and suppliers, materially reducing cross-border production and distribution integration.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">china_tech_trade_rivalry</data>
</edge>
<edge source="iran_hormuz_escalation::maritime_security_risk" target="russia_ukraine_war::arms_supply_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained rise in maritime security risk raises insurance costs, forces rerouting and port-closures, and produces delays and higher transport costs that directly reduce the rate and volume of sea-dependent arms and hardware deliveries to Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_hormuz_escalation::maritime_security_risk" target="united_states_realignmen::messaging_coherence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">More frequent hostile incidents in critical waterways creates simultaneous, competing public narratives from Defense, State and the White House about threat assessments and rules of engagement, reducing consistency and alignment of executive communications.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">united_states_realignmen</data>
</edge>
