<edge source="china_tech_trade_rivalry::supply_chain_integration" target="russia_ukraine_war::allied_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Rapid decoupling and reduced supply‑chain integration with China drives Western governments to coordinate industrial, trade and strategic policy responses (joint export controls, procurement coordination, reshoring strategies), raising perceived political cohesion among allies on Russia‑related measures.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_tech_trade_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
