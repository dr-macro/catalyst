<edge source="europe_political_turbule::media_attention_intensit" target="russia_ukraine_war::arms_supply_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A sharp increase in media coverage of battlefield losses, civilian suffering, or urgent capability gaps amplifies public and legislative pressure on executives, accelerating approvals and emergency provision of arms and hardware shipments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">europe_political_turbule</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="europe_political_turbule::media_attention_intensit" target="united_states_realignmen::messaging_coherence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A spike in high‑visibility European coverage forces rapid, reactive public responses from multiple U.S. agencies and officials, producing contradictory statements and lowering overall executive messaging coherence.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">europe_political_turbule</data>
  <data key="d39">united_states_realignmen</data>
