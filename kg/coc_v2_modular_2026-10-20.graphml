<edge source="russia_ukraine_war::allied_cohesion" target="russia_ukraine_war::diplomatic_engagement" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="russia_ukraine_war::allied_cohesion" target="china_tech_trade_rivalry::export_control_strength" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Greater political unity among Western allies over Russia enables coordinated policy forums and information‑sharing that result in harmonized, stricter multilateral export control lists and enforcement applied to sensitive China‑bound technologies.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_tech_trade_rivalry</data>
</edge>
<edge source="russia_ukraine_war::allied_cohesion" target="europe_political_turbule::political_stability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Stronger perceived allied cohesion reduces domestic partisan disputes over foreign policy and eases pressure on coalition governments, lowering the risk of cabinet crises and supporting incumbent political stability.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">europe_political_turbule</data>
</edge>
<edge source="russia_ukraine_war::allied_cohesion" target="iran_hormuz_escalation::maritime_security_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher perceived allied unity behind Ukraine prompts more visible coalition naval deployments and escort operations in vulnerable sea lines, which in turn provoke asymmetric harassment and retaliatory attacks by Iran or its proxies, raising maritime security risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_hormuz_escalation</data>
</edge>
<edge source="russia_ukraine_war::allied_cohesion" target="united_states_realignmen::messaging_coherence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.8</data>
  <data key="d36">Higher perceived cohesion among allies enables the executive to coordinate unified public statements and talking points, while fractures force tailored, inconsistent messages to different partners and publics, reducing coherence.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">united_states_realignmen</data>
</edge>
