</edge>
<edge source="russia_ukraine_war::executive_policy_tilt" target="europe_political_turbule::protest_activity_intensi" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An executive tilt toward rapprochement with Russia (reduced punitive measures or engagement) provokes public backlash from pro-Ukraine constituencies and opposition parties, producing street protests and coordinated demonstrations.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">europe_political_turbule</data>
</edge>
<edge source="russia_ukraine_war::executive_policy_tilt" target="united_states_realignmen::exec_turnover_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A visible executive tilt toward engagement with the adversary provokes domestic political backlash and internal dissent that produces resignations, forced departures, and administrative reshuffles among senior staff.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">united_states_realignmen</data>
</edge>
