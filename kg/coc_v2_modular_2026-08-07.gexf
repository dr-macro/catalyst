      <edge source="strait_hormuz_standoff::maritime_attack_rate" target="israel_gaza_lebanon::military_kinetic_intensi" id="38">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rise in hostile strikes against commercial and naval vessels in the Strait is often part of a coordinated escalation by Iran-aligned actors that prompts reciprocal strikes and higher-tempo military operations across adjacent theaters, increasing the aggregate kinetic tempo in Israel–Gaza–Lebanon." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="39" value="israel_gaza_lebanon" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="strait_hormuz_standoff::maritime_attack_rate" target="israel_gaza_lebanon::great_power_engagement" id="39">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained attacks on international shipping in the Strait trigger naval deployments, sanctions threats, and diplomatic initiatives from major powers to secure trade routes, drawing those powers into deeper posture and mediation efforts related to regional crises including Israel–Gaza–Lebanon." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="39" value="israel_gaza_lebanon" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="strait_hormuz_standoff::maritime_attack_rate" target="north_korea_threat::military_escalation" id="40">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in hostile attacks in the Strait forces U.S. and coalition forces to conduct kinetic reprisals and redistribute naval assets, creating windows of perceived U.S. distraction and lowering adversary risk thresholds that prompt increased kinetic tests or strikes on the Korean Peninsula." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="39" value="north_korea_threat" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="strait_hormuz_standoff::maritime_attack_rate" target="russia_ukraine_war::interceptor_stocks" id="41">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained rise in hostile incidents in the Strait of Hormuz prompts Western and regional partners to divert interceptor missiles and air‑defense expendables to Gulf bases and carrier groups, reducing inventories available for transfer or prepositioning to the Russia–Ukraine theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="strait_hormuz_standoff::maritime_attack_rate" target="russia_ukraine_war::drone_attack_rate" id="42">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher maritime attack frequency forces reassignment of ISR, targeting assets, and munitions stockpiles to protect shipping and regional facilities, degrading surveillance and strike support in Ukraine and enabling adversary increases in drone strike tempo." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="strait_hormuz_standoff::maritime_attack_rate" target="us_china_tech_rivalry::critical_component_avail" id="43">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Kinetic attacks, seizures, and strikes on commercial vessels rapidly destroy, delay, or divert shipments of semiconductors and other critical parts transiting the strait, directly reducing immediate imports and inventories available to tech producers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
