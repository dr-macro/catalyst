      <edge source="israel_gaza_lebanon::cross_border_hostilities" target="russia_ukraine_war::interceptor_stocks" id="568">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Frequent cross-border missile and rocket exchanges drive urgent requests from Israel for interceptor missiles and air-defence munitions from Western stockpiles, producing immediate drawdowns and delaying/rescinding planned resupplies destined for Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_gaza_lebanon" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
