          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A sharp rise in documented use of commercially available drones and related components in Ukraine prompts US and allied policymakers to rapidly expand and tighten export controls on drones, optics, and dual‑use components that could be diverted to military use — including items that are commonly exported to China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
