          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A sharp rise in kinetic operations in Israel–Gaza/Lebanon increases incentives for Iran and allied proxies to conduct asymmetric retaliation or pressure operations at sea, producing more interdictions, missile/drone strikes and harassment of commercial vessels in the Hormuz passage." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_gaza_lebanon" />
          <attvalue for="39" value="strait_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
