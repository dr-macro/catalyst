          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A significant depreciation of the US dollar component of exchange_rate_level raises dollar-priced oil costs for non‑USD buyers and typically bids up crude prices as markets adjust for currency-driven demand and hedging flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="monetary_currency_shift" />
          <attvalue for="38" value="strait_of_hormuz" />
