          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Attrition of interceptor missile inventories in the Ukraine theater reduces the stocks available for transfer or redeployment to Gulf partners and naval task forces, lowering ship and port defensive capability and thereby increasing the rate of successful hostile incidents against vessels." />
          <attvalue for="37" value="6-18 months" />
