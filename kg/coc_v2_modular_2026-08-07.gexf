          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher cash and committed liquidity in regional producers and service contractors allows timely payment for chartering tankers, bunkers, insurance and port fees, preventing shipment delays and sustaining seaborne crude flows." />
