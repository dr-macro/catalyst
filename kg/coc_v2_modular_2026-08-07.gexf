        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in hostile incidents triggers emergency policy reviews and public debate in Washington and Beijing over supply‑chain safeguards and export/sanctions responses, raising firms' uncertainty about imminent regulatory actions affecting tech trade." />
