          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher cash and liquid buffers held by large energy firms and exporting sovereigns enable and finance increased outbound investment and deposit placements in foreign markets, raising net cross-border capital flows." />
