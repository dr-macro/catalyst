          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="An increased tempo of kinetic and improvised drone strikes in the Russia–Ukraine war drives wider availability, tactics, and operational learning that are exported to regional actors and proxy groups who then employ drones to strike or harass commercial vessels and offshore infrastructure in the Strait, raising the measured maritime attack frequency." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="strait_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
