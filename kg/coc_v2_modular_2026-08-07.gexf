      <edge source="russia_ukraine_war::drone_attack_rate" target="global_energy_security::operating_margin_level" id="239">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rise in drone attack frequency causes direct physical damage and temporary shutdowns at oil, gas and power facilities and raises immediate repair and security operating costs, reducing operating margins for affected energy firms." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_energy_security" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_attack_rate" target="monetary_currency_shift::exchange_rate_level" id="240">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An uptick in cross‑border drone attacks raises operational and political risk for the countries directly involved, triggering capital outflows and risk premia that depress the affected countries' currencies versus safe‑haven currencies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="monetary_currency_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_attack_rate" target="strait_of_hormuz::naval_presence_intensity" id="241">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A sustained rise in drone attacks in the Russia–Ukraine theatre accelerates diffusion of commercially available strike drones and operational tactics to regional proxies and black‑market suppliers, which in turn leads Gulf states and extra‑regional navies to surge patrols and escorts in the Strait to deter and interdict similar attacks." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="strait_of_hormuz" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_attack_rate" target="us_china_tech_rivalry::export_controls_level" id="242">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sustained rise in high-volume commercial/weaponized drone attacks demonstrably reliant on dual‑use components (IMUs, navigation chips, RF modules) prompts US/EU policymakers to broaden and tighten export controls on those components to deny easy transfer to strategic competitors (including PRC-linked supply chains)." />
