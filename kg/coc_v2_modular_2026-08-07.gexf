      <edge source="israel_gaza_lebanon::cross_border_hostilities" target="strait_hormuz_standoff::rerouting_rate" id="569">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="An increase in cross‑border strikes and cross‑front incidents raises perceived spillover risk to wider regional lines of communication, causing commercial operators to divert voyages around the Cape or choose alternative ports, increasing rerouting rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_gaza_lebanon" />
          <attvalue for="39" value="strait_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_gaza_lebanon::cross_border_hostilities" target="us_china_tech_rivalry::cross_border_capital_flo" id="570">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Frequent cross-border strikes and incidents increase perceived operational and political risk for overseas investors, causing Chinese and US tech firms and financiers to delay, reroute, or cancel cross-border M&amp;A and project financing in affected regions, reducing cross-border tech capital flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_gaza_lebanon" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
