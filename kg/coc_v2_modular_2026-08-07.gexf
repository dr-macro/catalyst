          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A spike in drone threats against shipping and coastal infrastructure prompts littoral states and major naval powers to centralize enforcement and movement controls (convoys, military escorts, no‑sail zones), increasing concentration of transit decision‑making authority." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="strait_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
