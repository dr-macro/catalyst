          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A stronger US dollar (appreciation in exchange_rate_level versus local currencies) raises the local-currency cost of dollar-priced crude and imported inputs for non‑US refiners/importers, increasing COGS and squeezing operating margins quickly." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="monetary_currency_shift" />
          <attvalue for="38" value="global_energy_security" />
          <attvalue for="27" value="0" />
