          <attvalue for="35" value="Elevated military and paramilitary activity around the Strait raises war-risk insurance premiums, chartering costs and route detours, increasing near-term cash outflows for shipping and trading desks and reducing available short-term liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="strait_of_hormuz" />
          <attvalue for="38" value="global_energy_security" />
          <attvalue for="27" value="0" />
