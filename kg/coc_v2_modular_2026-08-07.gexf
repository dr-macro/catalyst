      <edge source="strait_of_hormuz::oil_price_level" target="global_energy_security::capital_allocation_balan" id="119">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher sustained oil prices increase free cash flow, prompting many upstream and integrated companies to reallocate toward shareholder distributions (dividends/buybacks) and debt repayment rather than near-term growth capex." />
          <attvalue for="36" value="3-12 months" />
          <attvalue for="37" value="strait_of_hormuz" />
          <attvalue for="38" value="global_energy_security" />
          <attvalue for="27" value="0" />
        </attvalues>
