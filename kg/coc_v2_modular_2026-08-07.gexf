        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Cross-border attacks that damage ports, transport routes, or regional logistics hubs delay or disrupt shipments of semiconductors and other critical components transiting the region, reducing short‑term availability for technology manufacturers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_gaza_lebanon" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
