      <edge source="russia_ukraine_war::drone_attack_rate" target="israel_gaza_lebanon::cross_border_hostilities" id="180">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rising tempo of drone attacks in the Ukraine theater increases production, availability and operational knowledge of armed drones and tactics, which nonstate actors and proxies in the Israel–Gaza–Lebanon arena adopt to carry out more frequent cross‑border strikes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="israel_gaza_lebanon" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_attack_rate" target="north_korea_threat::military_escalation" id="181">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained high drone attack rates in Ukraine accelerate the spread of low‑cost attack‑drone designs, components and operational tactics via observable doctrine and illicit supply chains, enabling North Korea to scale similar strike capabilities and thus raise the intensity of kinetic engagements on the peninsula." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="north_korea_threat" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_attack_rate" target="strait_hormuz_standoff::maritime_attack_rate" id="182">
