          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heavy consumption of interceptor missiles and expendables in the Russia–Ukraine war depletes exportable inventories and delays deliveries to partners in East Asia, degrading allied air‑defence readiness and lowering the perceived cost for North Korea to carry out cross‑border strikes or airspace violations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="north_korea_threat" />
          <attvalue for="28" value="0" />
