      <edge source="strait_of_hormuz::oil_price_level" target="monetary_currency_shift::monetary_policy_stance" id="120">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained increases in global oil prices feed into headline inflation and inflation expectations, compelling central banks to adopt tighter policy stances (higher rates or hawkish guidance) to maintain inflation targets." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="strait_of_hormuz" />
          <attvalue for="38" value="monetary_currency_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="strait_of_hormuz::oil_price_level" target="russia_ukraine_war::interceptor_stocks" id="121">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in global oil prices increases Russian export revenues and budget space for munitions procurement and production, which sustains higher rates of Russian missile/drone employment and thus accelerates Ukrainian interceptor expenditure, depleting interceptor inventories." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="strait_of_hormuz" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
