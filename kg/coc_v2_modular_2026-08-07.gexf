      <edge source="strait_of_hormuz::crude_export_flow_rate" target="monetary_currency_shift::exchange_rate_level" id="102">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher crude export flows increase foreign-currency receipts and central-bank FX supply for oil-exporting jurisdictions, directly supporting their currencies and pushing exchange rates toward appreciation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="strait_of_hormuz" />
          <attvalue for="38" value="monetary_currency_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="strait_of_hormuz::crude_export_flow_rate" target="russia_ukraine_war::critical_infra_vuln" id="103">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increase in crude export flow through the Hormuz corridor dampens price spikes and curtails windfall energy revenues for Russia and its suppliers, reducing the tempo and scale of offensive strikes against Ukrainian energy and logistics infrastructure and thereby lowering critical infrastructure vulnerability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="strait_of_hormuz" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="strait_of_hormuz::crude_export_flow_rate" target="us_china_tech_rivalry::advanced_chip_capacity" id="104">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Reductions or interruptions in crude export shipping through Hormuz drive higher freight, port congestion and insurance costs and create shipment delays that disrupt delivery and installation schedules for large, time‑sensitive semiconductor fab equipment, slowing the ramp‑up of advanced chip production capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="strait_of_hormuz" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
