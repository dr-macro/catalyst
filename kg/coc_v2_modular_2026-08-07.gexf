          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Accelerated consumption of interceptor missiles in the Russia–Ukraine war strains global production and shipment pipelines, delaying replenishment to Israeli air‑defense batteries and degrading interception rates, which raises civilian casualties during strikes and rocket/drone exchanges." />
