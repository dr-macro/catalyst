      <edge source="strait_of_hormuz::crude_export_flow_rate" target="global_energy_security::operating_margin_level" id="101">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A sustained drop in seaborne crude exports reduces refinery and export terminal throughput, forcing run-rate cuts and higher per-unit fixed-cost absorption that compress operating margins for integrated producers and refiners." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="strait_of_hormuz" />
          <attvalue for="38" value="global_energy_security" />
