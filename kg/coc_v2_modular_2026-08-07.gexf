      <edge source="north_korea_threat::military_escalation" target="israel_gaza_lebanon::great_power_engagement" id="743">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Intense North Korean military tests or strikes force the US and allied commanders to reallocate naval, air and missile‑defense assets and senior diplomatic bandwidth to East Asia, reducing the depth and tempo of US-led diplomatic and military engagement in the Israel–Gaza–Lebanon theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="north_korea_threat" />
          <attvalue for="39" value="israel_gaza_lebanon" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="north_korea_threat::military_escalation" target="russia_ukraine_war::interceptor_stocks" id="744">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A surge in North Korean kinetic activity prompts the US and regional partners to hold back or reallocate interceptor missiles and air‑defence shipments to reinforce Indo‑Pacific inventories, reducing exportable interceptor stocks for Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="north_korea_threat" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="north_korea_threat::military_escalation" target="strait_hormuz_standoff::maritime_attack_rate" id="745">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="High-intensity North Korean military escalation drives U.S. and allied carrier/strike-group redeployments to Northeast Asia, temporarily reducing naval deterrence and surveillance in the Persian Gulf and thereby enabling adversaries and proxy actors to increase kinetic harassment of commercial shipping in the Hormuz corridor." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="north_korea_threat" />
          <attvalue for="39" value="strait_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="north_korea_threat::military_escalation" target="us_china_tech_rivalry::regulatory_uncertainty" id="746">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Acute increases in military escalation prompt governments to signal or prepare emergency export controls, sanctions, and contingency regulation, which immediately raises firms' uncertainty about future technology policy and enforcement." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="north_korea_threat" />
          <attvalue for="39" value="us_china_tech_rivalry" />
