      <edge source="monetary_currency_shift::exchange_rate_level" target="russia_ukraine_war::critical_infra_vuln" id="808">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An appreciation of the domestic currency (higher exchange_rate_level) lowers the local cost of imported spare parts, protective hardware and contracted services, enabling faster repairs and hardening of energy/logistics assets and thereby reducing critical infrastructure vulnerability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="monetary_currency_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
