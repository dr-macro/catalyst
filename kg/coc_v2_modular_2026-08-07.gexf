      <edge source="israel_gaza_lebanon::military_kinetic_intensi" target="north_korea_threat::military_escalation" id="551">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sustained high-intensity kinetic fighting in Israel diverts US and allied operational assets and attention away from the Indo‑Pacific, which North Korean leadership can perceive as a window to conduct missile tests or limited provocations that raise overall military escalation on the peninsula." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_gaza_lebanon" />
          <attvalue for="39" value="north_korea_threat" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_gaza_lebanon::military_kinetic_intensi" target="russia_ukraine_war::drone_attack_rate" id="552">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A surge in kinetic operations in Israel–Gaza increases battlefield demand for and combat-proven use of loitering munitions and small armed drones, prompting manufacturers and brokers to ramp up production and exports that raise the availability of such drones to actors operating against Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_gaza_lebanon" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
