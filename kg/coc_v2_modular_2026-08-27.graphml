<edge source="russia_ukraine_war::allied_military_flow" target="iran_economic_and_hormuz::sanctions_strength" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Visible increases in allied weapon and system shipments to Ukraine raise concern about arms diversion to Russia and prompt policymakers to expand and tighten sanctions and enforcement against suppliers (including Iranian entities) to block transfers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_economic_and_hormuz</data>
</edge>
