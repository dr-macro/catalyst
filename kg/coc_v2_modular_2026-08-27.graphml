<edge source="treasury_bond_market_tug::long_term_bond_yield" target="russia_ukraine_war::allied_military_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in long-term sovereign yields raises the cost of borrowing and refinancing for allied governments and defence contractors, prompting near-term budgetary tightening and delayed or reduced external materiel deliveries.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">treasury_bond_market_tug</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="treasury_bond_market_tug::long_term_bond_yield" target="us_canada_trade_spat::bilateral_trade_volume" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in long-term sovereign yields attracts capital into the currency and raises the exchange rate, making US exports to Canada more expensive and reducing cross‑border trade flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">treasury_bond_market_tug</data>
  <data key="d39">us_canada_trade_spat</data>
</edge>
<edge source="treasury_bond_market_tug::long_term_bond_yield" target="us_canada_trade_spat::corporate_investment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Higher long-term yields increase firms' expected cost of long‑duration financing and hurdle rates, causing corporations to delay or cancel capital projects and cross‑border investment commitments in the bilateral market.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">treasury_bond_market_tug</data>
  <data key="d39">us_canada_trade_spat</data>
</edge>
<edge source="treasury_bond_market_tug::long_term_bond_yield" target="us_china_tech_competitio::market_concentration" id="0">
