<edge source="us_china_tech_competitio::regulatory_enforcement" target="iran_economic_and_hormuz::third_party_compliance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Tighter and more frequent export‑control enforcement (licenses, audits, penalties) raises legal/operational risk for multinational suppliers and banks, causing them to stop or curtail transactions that could re‑route sanctioned goods to Iran and thus increase compliance.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_competitio</data>
  <data key="d39">iran_economic_and_hormuz</data>
</edge>
<edge source="us_china_tech_competitio::regulatory_enforcement" target="russia_ukraine_war::logistics_ammo_stocks" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tightened export controls and enforcement on AI-related chips and dual-use electronics quickly disrupt procurement channels and spares flows used in munitions production and repair, reducing on-hand ammunition, guidance units and sustainment stocks in theater.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_competitio</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_competitio::regulatory_enforcement" target="treasury_bond_market_tug::market_intervention_inte" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Tightened export controls or enforcement actions on AI hardware/software produce immediate counterparty stress and price dislocations in affected financial exposures, prompting central banks/treasuries to scale up direct asset purchases and emergency facilities to stabilize markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_competitio</data>
  <data key="d39">treasury_bond_market_tug</data>
</edge>
<edge source="us_china_tech_competitio::regulatory_enforcement" target="treasury_bond_market_tug::bond_market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Stronger cross-border enforcement and sanctions increase settlement, compliance and counterparty risk for dealers and foreign holders, causing wider haircuts and pullbacks that materially reduce bid/ask depth in the Treasury market.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_competitio</data>
  <data key="d39">treasury_bond_market_tug</data>
</edge>
<edge source="us_china_tech_competitio::regulatory_enforcement" target="us_canada_trade_spat::political_escalation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Stronger US export controls and enforcement on AI hardware create immediate lobbying and public pressure in Canada from affected firms and labour groups to demand retaliatory or protective economic policies, raising domestic political escalation pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_competitio</data>
  <data key="d39">us_canada_trade_spat</data>
</edge>
<edge source="us_china_tech_competitio::regulatory_enforcement" target="us_canada_trade_spat::corporate_investment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Heightened enforcement and extraterritorial export controls raise compliance risk and potential market access losses for firms operating across the US–Canada boundary, causing companies to scale back or delay bilateral-capital commitments and projects.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_competitio</data>
  <data key="d39">us_canada_trade_spat</data>
</edge>
