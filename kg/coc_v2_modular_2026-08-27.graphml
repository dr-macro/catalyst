<edge source="us_canada_trade_spat::political_escalation" target="russia_ukraine_war::allied_military_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising domestic political pressure in the US or Canada during a trade spat prompts executives or parliaments to delay or withhold approval/funding for arms transfers or export licences for equipment bound for Ukraine, reducing the rate of allied materiel deliveries.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_canada_trade_spat</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_canada_trade_spat::political_escalation" target="treasury_bond_market_tug::market_intervention_inte" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising domestic political pressure to protect affected industries and voters increases the likelihood that fiscal or monetary authorities will step in with direct bond purchases or stabilization facilities, raising the intensity of market interventions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_canada_trade_spat</data>
  <data key="d39">treasury_bond_market_tug</data>
</edge>
<edge source="us_canada_trade_spat::political_escalation" target="us_china_tech_competitio::regulatory_enforcement" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Escalating domestic political pressure in the US/Canada spat pushes policymakers and enforcement agencies to adopt and more frequently apply export‑controls and compliance actions that are explicitly aimed at limiting tech transfers to China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_canada_trade_spat</data>
  <data key="d39">us_china_tech_competitio</data>
