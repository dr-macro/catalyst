  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Larger allied military aid packages delivered as grants or direct materiel reduce the immediate financing needs of the recipient government, lowering near-term sovereign bond issuance.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">treasury_bond_market_tug</data>
</edge>
