<edge source="us_canada_trade_spat::retaliatory_intensity" target="russia_ukraine_war::allied_military_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Targeted retaliatory measures (e.g., selective export controls, expedited customs inspections) applied as part of the bilateral spat can be used to slow or block specific cargo flows—including military consignments transiting the US–Canada border—reducing delivered volumes to the theater.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_canada_trade_spat</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_canada_trade_spat::retaliatory_intensity" target="treasury_bond_market_tug::long_term_bond_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A spike in punitive measures raises near‑term economic and policy uncertainty, prompting investors to shift into US Treasuries as a safe haven and thereby pushing long‑term yields down.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_canada_trade_spat</data>
  <data key="d39">treasury_bond_market_tug</data>
</edge>
<edge source="us_canada_trade_spat::retaliatory_intensity" target="us_china_tech_competitio::hardware_capacity" id="0">
