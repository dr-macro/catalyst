<edge source="russia_ukraine_war::economic_disruption_leve" target="iran_economic_and_hormuz::affected_export_volume" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">War-driven disruptions to global energy and commodity supplies produce price spikes and supply gaps that incentivize importers and intermediaries to purchase or smuggle more sanctioned Iranian oil/commodities, increasing Iran's export volumes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_economic_and_hormuz</data>
</edge>
<edge source="russia_ukraine_war::economic_disruption_leve" target="treasury_bond_market_tug::net_bond_supply_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Wider economic disruption forces governments to finance emergency relief, reconstruction and energy subsidies, increasing sovereign bond issuance into the market.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">treasury_bond_market_tug</data>
</edge>
<edge source="russia_ukraine_war::economic_disruption_leve" target="us_canada_trade_spat::bilateral_trade_volume" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Broad economic disruption from sanctions, commodity shocks and disrupted trade routes depresses demand and raises costs for exporters and importers, reducing the flow of goods and services between the US and Canada as firms cut orders and postpone shipments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_canada_trade_spat</data>
</edge>
