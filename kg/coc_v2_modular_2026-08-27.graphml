  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Targeted retaliatory measures (tariffs, component bans, blocking cross‑border shipments) interrupt deliveries of critical semiconductor inputs to fabs, lowering utilization and near‑term producible accelerator/chip output.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_canada_trade_spat</data>
  <data key="d39">us_china_tech_competitio</data>
</edge>
