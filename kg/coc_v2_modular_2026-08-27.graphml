<edge source="treasury_bond_market_tug::bond_market_liquidity" target="russia_ukraine_war::logistics_ammo_stocks" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A fall in bond-market liquidity causes banks and dealers to hoard cash and withdraw trade‑finance and repo facilities, constraining defence firms' working capital and transport financing and thereby reducing on‑hand munitions, fuel and spare‑parts stocks at the front.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">treasury_bond_market_tug</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="treasury_bond_market_tug::bond_market_liquidity" target="us_canada_trade_spat::supply_chain_disruption" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A deterioration in bond market liquidity raises funding and roll‑over risk for banks and trade financiers, prompting tighter trade credit, reduced use of letters of credit and insurance, and thus causing delays and rerouting in cross‑border supply chains.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">treasury_bond_market_tug</data>
  <data key="d39">us_canada_trade_spat</data>
</edge>
