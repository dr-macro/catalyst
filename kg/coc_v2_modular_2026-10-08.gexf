          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Reduced/volatile Russian oil and gas flows and associated sanction‑ and insurance‑driven risk premia tighten global supply and raise spot crude and refined product prices." />
