          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Acute energy shortages and price spikes increase household economic insecurity and salient grievances, which boost support for front‑running populist candidates who promise quick, protectionist or paternalistic remedies and blame elites/foreign actors." />
