          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising sovereign spreads increase fiscal strain on oil-exporting and transit states, forcing cuts or delays to naval/coastguard patrols and maintenance that reduce deterrence and raise the frequency of attacks, seizures and harassment of commercial shipping." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_bond_stress" />
