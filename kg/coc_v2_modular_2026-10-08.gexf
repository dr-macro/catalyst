          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rapid widening in sovereign spreads forces governments to debate emergency fiscal adjustments and signals fiscal stress to markets and voters, increasing perceived uncertainty about future economic and regulatory policy choices." />
          <attvalue for="36" value="0-6 months" />
