          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved and reliable chokepoint transit (an increase in flow) lowers the business case for nearshoring and capacity building in the consuming region, thereby reducing new cross‑border investment into local vehicle manufacturing and supply‑chain assets." />
          <attvalue for="36" value="6-18 months" />
