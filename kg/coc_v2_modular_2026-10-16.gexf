          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Significant increases in Chinese investment into European vehicle plants and suppliers trigger US congressional inquiries, CFIUS reviews and DOJ/FTC probes into cross-border ties and national-security risks, raising the volume and intensity of legal actions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_eu_industrial_riva" />
