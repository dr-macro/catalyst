          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A step-up in sanctions enforcement triggers immediate investigations, asset freezes and prosecutions against firms and intermediaries, generating a higher volume and intensity of legal actions targeting actors tied to sanctionable activity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
