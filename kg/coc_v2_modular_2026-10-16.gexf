          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A marked increase in cross‑border (notably Chinese) investment into EU vehicle and supply‑chain assets provokes US political and security pushback, creating diplomatic frictions that erode coordination and burden‑sharing among allies on Ukraine policy." />
          <attvalue for="36" value="6-18 months" />
