        </attvalues>
      </edge>
      <edge source="global_ai_market_cycle::infra_valuation_index" target="us_political_alliance_st::media_scrutiny_level" id="768">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
