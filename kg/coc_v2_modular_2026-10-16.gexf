      <edge source="russia_ukraine_war::sanctions_enforcement" target="china_eu_industrial_riva::policy_response_momentum" id="257">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Stricter sanctions enforcement related to the Russia–Ukraine war raises perceived economic-security risks and compliance burdens, prompting legislators and regulators in the EU to accelerate and scale trade, investment screening and industrial-support measures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_eu_industrial_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforcement" target="global_ai_market_cycle::regulatory_scrutiny" id="258">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An uptick in sanctions enforcement prompts governments to broaden export controls, compliance checks and oversight on dual‑use technologies, directly increasing regulatory attention on AI development and transfers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_ai_market_cycle" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforcement" target="global_ai_market_cycle::investor_risk_aversion" id="259">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Stricter sanctions raise counterparty, compliance and geopolitical risk for firms working on AI, causing investors to demand higher risk premia or reduce exposure to AI assets in affected markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_ai_market_cycle" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforcement" target="middle_east_maritime_con::crude_export_flow" id="260">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Stricter enforcement of sanctions on Russian crude compels buyers to substitute volumes by purchasing more Middle Eastern crude, directly increasing Middle East export flows to fill displaced supply." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
