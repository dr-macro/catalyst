          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A visible surge in attacks on commercial shipping generates immediate political pressure and security briefs that prompt lawmakers and executives to propose and fast‑track trade, industrial‑security and supply‑chain resilience measures." />
