      <edge source="middle_east_maritime_con::chokepoint_transit_flow" target="china_eu_industrial_riva::import_market_share" id="57">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sustained reductions in commercial transit through a chokepoint raise delivery delays and freight costs for imported vehicles, causing importers to cut volumes and buyers to shift toward locally produced models, reducing import market share." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="middle_east_maritime_con" />
          <attvalue for="38" value="china_eu_industrial_riva" />
