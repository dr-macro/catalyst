      <edge source="global_ai_market_cycle::infra_valuation_index" target="china_eu_industrial_riva::policy_response_momentum" id="767">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rapidly rising valuations of dominant AI‑infrastructure firms signal concentrated foreign control of critical tech inputs, prompting policymakers in China and the EU to accelerate trade and industrial policy proposals (subsidies, local content rules, export controls) to protect domestic industry." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_ai_market_cycle" />
          <attvalue for="38" value="china_eu_industrial_riva" />
