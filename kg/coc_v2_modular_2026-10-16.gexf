      <edge source="global_ai_market_cycle::regulatory_scrutiny" target="china_eu_industrial_riva::policy_response_momentum" id="738">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened regulatory scrutiny of AI in major jurisdictions creates reputational and competitive pressure that accelerates domestic policymaking in China and the EU (e.g., faster drafting of industrial support or protective rules) to shield national automakers and suppliers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_ai_market_cycle" />
          <attvalue for="38" value="china_eu_industrial_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_ai_market_cycle::regulatory_scrutiny" target="russia_ukraine_war::sanctions_enforcement" id="739">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Ramped regulatory scrutiny of AI and dual‑use tech prompts governments and export control agencies to codify tighter controls and compliance obligations (including expanded screening and licensing), directly increasing the strictness and operational enforcement of sanctions regimes against actors like Russia." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_ai_market_cycle" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
