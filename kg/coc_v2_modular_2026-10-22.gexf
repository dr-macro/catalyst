          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Rapid, high‑reach flows of political information and unverified allegations about major AI/cloud firms heighten short‑term counterparty and reputational risk perceptions, causing lenders and bond investors to demand wider credit spreads for AI‑related borrowers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="ai_infra_market_risk" />
          <attvalue for="28" value="0" />
        </attvalues>
