      <edge source="ai_infra_market_risk::ai_investment_flow" target="us_china_tech_rivalry::regulatory_scrutiny" id="532">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rapid surge in visible AI infrastructure investment—especially concentrated or cross‑border deals—triggers policymakers and regulators to open inquiries, propose export controls and tighten oversight due to perceived national‑security, competition and concentration risks." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_infra_market_risk" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
