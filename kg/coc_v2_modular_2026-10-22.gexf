          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Faster and broader dissemination of political information and misinformation accelerates the spread of leaked vulnerabilities and fuels targeted social-engineering campaigns, increasing the frequency and success rate of cyber intrusions and related security incidents against tech infrastructure." />
