          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Faster, broader dissemination of operational, legal and reputational risks (including leaks and investor/activist signals) prompts companies to accelerate divestments, service suspensions and other market exits related to Russia/Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
