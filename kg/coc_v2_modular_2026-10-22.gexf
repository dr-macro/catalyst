          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sharp increases in high-profile media coverage of dual-use technology transfers and breaches generate congressional and public pressure that leads regulators and agencies to issue tighter export-control guidance and enforcement actions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
