          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A rise in cyber/physical security incidents tied to actors in the US–China tech rivalry generates shared threat perceptions among Western partners, triggering more frequent consultations and coordinated policy responses that increase allied cohesion on Russia/Ukraine-related measures." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
