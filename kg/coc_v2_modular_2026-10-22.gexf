      <edge source="us_domestic_politics::executive_stability" target="ai_infra_market_risk::market_liquidity" id="757">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sharp deterioration in executive stability (e.g., sudden leadership crisis or paralysis) raises near‑term policy and fiscal uncertainty, prompting market‑makers and banks to pull back inventory and widen bid‑ask spreads, which reduces market liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="ai_infra_market_risk" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_domestic_politics::executive_stability" target="iran_regional_escalation::military_engagement_inte" id="758">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A loss of executive steadiness (internal factionalism, rapid personnel turnover, or poor interagency coordination) raises the risk of miscommunication, conflicting orders, or poorly planned kinetic actions that provoke Iranian retaliation and increase regional military engagement intensity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="iran_regional_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_domestic_politics::executive_stability" target="russia_ukraine_war::sanctions_tightness" id="759">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Greater operational stability in the U.S. executive branch speeds interagency sanction design, legal review and diplomatic coordination, enabling more frequent and legally robust sanction packages to be issued and enforced." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_domestic_politics::executive_stability" target="us_china_tech_rivalry::grid_power_availability" id="760">
