          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained high‑profile media coverage of outages, concentration, or national‑security risks at large cloud/AI providers triggers regulatory reviews and enterprise vendor diversification or data‑localization measures, which reduce cross‑platform and cross‑jurisdiction coupling." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="ai_infra_market_risk" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_domestic_politics::media_attention" target="russia_ukraine_war::tech_control_enforcement" id="714">
        <attvalues>
