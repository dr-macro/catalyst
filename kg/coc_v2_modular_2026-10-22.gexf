          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Broader or more intrusive sanctions on Russian energy and finance raise market risk premia and transaction frictions, lifting benchmark oil prices even before or independent of a complete physical supply loss." />
