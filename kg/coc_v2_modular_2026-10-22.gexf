          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rapid increases in accessible high‑end compute amplify policymakers' assessment of proliferation and dual‑use risk, prompting quicker expansion and tightening of export controls and service restrictions on advanced AI hardware and cloud services that could reach adversaries including Russia." />
          <attvalue for="37" value="6-18 months" />
