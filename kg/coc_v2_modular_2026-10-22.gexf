          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::military_engagement_inte" target="ai_infra_market_risk::credit_spread" id="227">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalation in regional military engagements increases perceived tail and counterparty risk for firms with exposure to the region (including tech suppliers and cloud providers), causing lenders and bond markets to widen corporate credit spreads to price higher default and liquidity risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="ai_infra_market_risk" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::military_engagement_inte" target="ai_infra_market_risk::systemic_interconnectedn" id="228">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained military escalation drives governments and large platform/cloud operators to impose stricter regional data/localization rules and to re-architect supply chains and routing, producing deliberate segmentation and reduced coupling across global tech and infrastructure networks." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="ai_infra_market_risk" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::military_engagement_inte" target="russia_ukraine_war::allied_cohesion" id="229">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sharp uptick in Iranian-linked kinetic activity draws US/NATO operational attention and forces toward the Middle East and prompts divergent threat-prioritization among partners, reducing political willingness and bandwidth to coordinate or sustain unified support for Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::military_engagement_inte" target="russia_ukraine_war::corporate_market_actions" id="230">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating regional conflict increases sanction and insurance risk perceptions, triggering private-sector decisions (asset sales, contract suspensions, insurance withdrawals) to reduce exposure — including accelerated exits or restructurings that alter commercial ties with Russia and regional markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
