          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An uptick in cyber and physical attacks on data‑centre and logistics infrastructure (as part of tech‑rivalry coercion or retaliation) degrades port/ship AIS, provisioning and routing systems and directly disrupts commercial navigation, raising the risk to maritime transit in regional choke points." />
