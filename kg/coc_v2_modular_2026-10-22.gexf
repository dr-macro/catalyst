          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A spike in high-profile media coverage of China-related tech risks generates immediate political pressure and public outcry that drives regulators and legislators to open hearings, investigations, and expedited rule-making targeting China-linked tech activities." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="us_china_tech_rivalry" />
