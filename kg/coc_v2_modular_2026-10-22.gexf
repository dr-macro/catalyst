          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Large funding rounds, hyperscale buildouts, layoffs, IPOs or government subsidies in AI generate high‑profile reporting, congressional hearings and industry commentary that raise overall media volume and prominence around political actors and policy." />
          <attvalue for="37" value="0-6 months" />
