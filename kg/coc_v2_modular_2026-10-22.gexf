          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Faster, wider spread of (mis)information about incidents at sea can produce rapid misattribution and pressure for immediate defensive or retaliatory actions by U.S. or allied forces, producing incidents that increase security risks for commercial shipping." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_domestic_politics" />
          <attvalue for="39" value="iran_regional_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
