      <edge source="us_china_tech_rivalry::regulatory_scrutiny" target="ai_infra_market_risk::ai_investment_flow" id="426">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An increase in regulatory scrutiny raises compliance costs and approval uncertainty for AI infrastructure projects, prompting firms and financiers to delay or scale back new investments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="ai_infra_market_risk" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::regulatory_scrutiny" target="iran_regional_escalation::military_engagement_inte" id="427">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalation of export controls and sanctions on Chinese tech firms (higher regulatory scrutiny) motivates Beijing to accelerate provision of dual‑use sensors, comms and guidance components to Iran and to tacitly encourage proxy pressure, enabling Iran to intensify regional kinetic operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="iran_regional_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::regulatory_scrutiny" target="russia_ukraine_war::tech_control_enforcement" id="428">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalating regulatory scrutiny in the US–China tech rivalry leads governments to expand licensing rules, dedicate enforcement resources and tighten inspections, producing more stringent and consistently applied export/service controls that also target technologies flowing to Russian actors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::regulatory_scrutiny" target="russia_ukraine_war::corporate_market_actions" id="429">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened regulatory scrutiny raises compliance and legal risk for multinational tech firms operating across US–China channels, prompting firms to execute asset sales, suspend services, or withdraw offerings in higher-risk jurisdictions including operational actions affecting Russia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::regulatory_scrutiny" target="us_domestic_politics::media_attention" id="430">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="High-profile investigations, hearings, and rulemaking around US–China tech rivalry generate news events and leaks that directly increase press and social-media coverage of the issue." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="us_domestic_politics" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::regulatory_scrutiny" target="us_domestic_politics::executive_stability" id="431">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating, politicized regulatory action toward Chinese-linked tech firms forces the executive to coordinate trade, national-security and diplomatic responses, creating intra-administration friction and episodic crises that weaken operational stability." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="us_domestic_politics" />
          <attvalue for="28" value="0" />
        </attvalues>
