          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Increased cohesion among US and allied governments produces coordinated policy agendas and legislative initiatives (investment reviews, national-security screenings, data rules) that raise the intensity of regulatory scrutiny directed at Chinese-linked data-centre projects and providers." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
