          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A surge in AI infrastructure investment spurs dealmaking and reallocation by tech firms (M&amp;A, cloud contracts, spin‑offs and market exits) that produces a higher frequency and scale of corporate transactions affecting service provision and asset holdings relevant to Russia–Ukraine dynamics." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_infra_market_risk" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
