          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Reduced stability and coordination in the executive branch hampers timely federal decision-making and emergency support for grid resilience projects and interagency responses, delaying capacity upgrades and temporarily lowering reliable power availability for data-centre operations." />
