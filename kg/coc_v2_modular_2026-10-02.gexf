          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A fall in crude export physical flows alters trade receipts and forces portfolio rebalancing (including repatriation or flight-to-safety), producing measurable shifts in cross-border capital flows." />
