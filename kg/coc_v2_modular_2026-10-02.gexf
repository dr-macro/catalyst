          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Escalating regional security tension increases perceived political and fiscal risk for exposed states, prompting investors to widen sovereign credit spreads relative to benchmarks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_gulf_disruption" />
          <attvalue for="38" value="global_bond_market_rout" />
          <attvalue for="27" value="0" />
