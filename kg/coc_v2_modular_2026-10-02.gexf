          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sudden bond-market rout triggers cross-border capital outflows and correspondent-banking frictions that interrupt trade finance and FX settlement for exporters, directly forcing refiners and traders to cut diesel shipments to external customers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_market_rout" />
          <attvalue for="38" value="russia_ukraine_escalatio" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_market_rout::cross_border_flows" target="us_china_strategic_rival::export_control_intensity" id="627">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp reversals or freezes in cross‑border capital into sensitive tech and industrial firms prompt authorities to erect or tighten export and investment controls (FDI screens, outbound restrictions) to prevent perceived asset loss and technology flight." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_market_rout" />
          <attvalue for="38" value="us_china_strategic_rival" />
