      <edge source="mid_east_gulf_disruption::regional_tension" target="us_china_strategic_rival::export_control_intensity" id="32">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising military posturing and proxy attacks in the Gulf lead U.S. policymakers to broaden and tighten export controls (dual‑use, maritime and surveillance technologies) to prevent transfer of capabilities that could empower regional proxies or be re‑exported to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_gulf_disruption" />
          <attvalue for="38" value="us_china_strategic_rival" />
