          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sharp outflows disrupt trade and tanker finance (letters of credit, insurance, ship mortgages) and prompt payment frictions that delay shipments and reduce net crude export volumes until financing conditions normalize." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_market_rout" />
          <attvalue for="38" value="mid_east_gulf_disruption" />
