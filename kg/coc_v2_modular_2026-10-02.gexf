      <edge source="mid_east_gulf_disruption::regional_tension" target="russia_ukraine_escalatio::hybrid_attack_frequency" id="31">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sustained rises in Gulf regional tension draw US/NATO naval and air assets and intelligence focus to the Middle East, reducing immediate Western surveillance and rapid-response presence in the Black Sea/Eastern Europe and encouraging Russia to increase hybrid actions (cyber, sabotage, legal/administrative pressure) against Ukrainian targets to exploit the attention gap." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_gulf_disruption" />
          <attvalue for="38" value="russia_ukraine_escalatio" />
          <attvalue for="27" value="0" />
        </attvalues>
