          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Growing divergence in trade rules, sanction lists and regulatory compliance across blocs increases paperwork, insurance costs and de‑risking by shippers and banks, causing reroutings, port denials and temporary halts that reduce net crude export volumes out of the Gulf." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_strategic_rival" />
          <attvalue for="38" value="mid_east_gulf_disruption" />
