      <edge source="mid_east_gulf_disruption::regional_tension" target="alliance_reliability_shi::information_amplificatio" id="29">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating regional military posturing and proxy incidents increase official statements, battlefield reporting and reactive commentary, which media and social platforms rapidly amplify and circulate." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_gulf_disruption" />
