          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Diverging rules and standards split pools of market makers, increase settlement and custody frictions across jurisdictions, and raise transaction costs and bid‑ask spreads, directly degrading tradability and liquidity in affected markets." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_strategic_rival" />
          <attvalue for="38" value="global_bond_market_rout" />
