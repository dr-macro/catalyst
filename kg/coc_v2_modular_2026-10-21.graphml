  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Widening sovereign spreads and higher default/downgrade probability prompt passive bond ETF investors and authorized participants to redeem or rotate out of sovereign-bond trackers, generating net outflows from those ETFs.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_political_unrest</data>
  <data key="d40">global_financial_fragili</data>
</edge>
<edge source="western_political_unrest::sovereign_debt_stress" target="russia_ukraine_war::sanctions_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising sovereign borrowing costs and fiscal strain reduce governments' tolerance for the economic costs and budgetary measures required to design, enforce, and sustain high-intensity sanctions, causing scaling back or softer enforcement over time.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">western_political_unrest</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
