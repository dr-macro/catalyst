<edge source="global_financial_fragili::etf_net_flow_rate" target="us_china_tech_trade::asset_valuation_infra" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Net inflows into sector‑tracking ETFs produce demand for listed data‑center and infrastructure equities, mechanically lifting share prices and sector valuation multiples and thus raising market valuations of infrastructure assets; net outflows work in reverse.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_fragili</data>
  <data key="d40">us_china_tech_trade</data>
</edge>
