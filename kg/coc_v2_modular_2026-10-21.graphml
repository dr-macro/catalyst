  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sharp cross‑border capital volatility disrupts payment channels, raises insurance and hedging costs and prompts private suppliers and intermediaries to delay or reduce deliveries of arms and munitions to the theater.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_political_unrest</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
