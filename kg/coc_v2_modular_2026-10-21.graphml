  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Higher variability and abrupt reversals in cross-border capital flows create FX order-flow imbalances and liquidity gaps that translate directly into increased depreciation pressure and exchange-rate volatility.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_political_unrest</data>
  <data key="d40">global_financial_fragili</data>
</edge>
<edge source="western_political_unrest::capital_flow_volatility" target="middle_east_energy_attac::price_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Sharp swings in cross-border capital flows from Western markets drive FX and liquidity stress that forces margin calls and speculative rebalances in oil and gas markets, amplifying short-term volatility in Middle Eastern energy prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_political_unrest</data>
  <data key="d40">middle_east_energy_attac</data>
</edge>
