      <edge source="russia_ukraine_war::defense_supply_chain_flo" target="russia_ukraine_war::deterrence_effectiveness" id="227">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="3" />
          <attvalue for="32" value="+" />
          <attvalue for="27" value="0" />
        </attvalues>
