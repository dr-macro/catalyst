          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising fiscal stress in governments bearing the Ukraine burden forces cuts or reprioritisations in diplomatic staffing, travel budgets and special envoys, reducing the tempo and reach of high-level diplomatic engagement in the Israel/region theatre." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="israel_region_escalation" />
