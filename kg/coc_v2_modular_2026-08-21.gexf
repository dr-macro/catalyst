      <edge source="eastasia_alliance_strain::military_drill_scope" target="us_debt_bond_stress::bond_market_liquidity" id="498">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Larger, prolonged military exercises raise intraday volatility and margin requirements in fixed‑income markets, prompting dealers to shrink inventories and widening bid‑ask spreads, thereby reducing Treasury market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="eastasia_alliance_strain" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
