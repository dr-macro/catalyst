      <edge source="us_iran_confront::military_tension" target="eastasia_alliance_strain::alliance_cohesion_level" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sustained US–Iran military escalation draws US naval and air assets toward the Middle East and generates allied doubts about US capacity and focus in East Asia, prompting political and operational frictions among partners over burden‑sharing and commitment assumptions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="eastasia_alliance_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::military_tension" target="eastasia_alliance_strain::military_drill_scope" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Perceived distraction of US forces from the Indo‑Pacific motivates East Asian states and the US to schedule larger or more frequent joint and unilateral exercises to signal deterrence and reassure partners." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="eastasia_alliance_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::military_tension" target="israel_region_escalation::strike_intensity" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Escalating US–Iran military tension provokes direct kinetic exchanges and proxy retaliation (Iranian proxy strikes, US preemptive/retaliatory actions, or Israeli counterstrikes), increasing the frequency and scale of cross-border strikes in the Israel region." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="israel_region_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::military_tension" target="israel_region_escalation::deployment_density" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising US–Iran tensions drive Israel and regional partners to mobilize reserves and pre-position air, naval, and ground forces nearer likely flashpoints, raising force concentration and proximity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="israel_region_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::military_tension" target="russia_ukraine_war::defense_supply_chain_flo" id="37">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened US–Iran military tension draws US and allied stockpiles and production capacity toward urgent shipments, contingency stocks, and priority orders for partners in the Middle East, reducing the rate and reliability of deliveries of weapons and air‑defence systems into the Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::military_tension" target="us_debt_bond_stress::government_bond_yields" id="38">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A spike in military tensions produces a flight-to-quality that pushes large volumes of global capital into US Treasuries, raising prices and lowering nominal long‑term government bond yields within weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::military_tension" target="us_debt_bond_stress::bond_market_liquidity" id="39">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute escalation increases volatility and counterparty risk, causing primary dealers and market‑making intermediaries to pare inventories and widen bid‑ask spreads, thereby reducing government bond market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
