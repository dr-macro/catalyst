      <edge source="us_iran_confront::chokepoint_throughput" target="us_iran_confront::trade_resilience" id="59">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="3" />
          <attvalue for="32" value="+" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::chokepoint_throughput" target="eastasia_alliance_strain::diplomatic_signal_flow" id="60">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute disruptions or slowdowns in Strait/Red Sea throughput prompt East Asian governments to initiate visible diplomatic outreach—consultations with the US, Gulf suppliers, and regional security partners—to secure energy routes and coordination." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="eastasia_alliance_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::chokepoint_throughput" target="israel_region_escalation::deployment_density" id="61">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher commercial transit rates through strategic chokepoints reduce immediate perceived threats to shipping, allowing states to scale back convoy-protection patrols and forward naval/air deployments, lowering deployment density near the Israel region." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="israel_region_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::chokepoint_throughput" target="russia_ukraine_war::logistics_capacity" id="62">
