        </attvalues>
      </edge>
      <edge source="israel_region_escalation::strike_intensity" target="eastasia_alliance_strain::alliance_cohesion_level" id="693">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A surge in strike intensity forces lead states (notably the U.S.) to reallocate political and military priorities and issue conflicting public directives to partners—some governments push immediate support while others call for restraint—exposing policy divergences and lowering operational/political alignment among East Asian allies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="eastasia_alliance_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::strike_intensity" target="russia_ukraine_war::defense_supply_chain_flo" id="694">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A surge in kinetic strikes in the Israel theatre drives urgent demand for air-defence interceptors, munitions and precision-guided stocks and forces manufacturers and exporters to reallocate production and prioritized shipments to the Middle East, directly slowing scheduled deliveries into the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::strike_intensity" target="us_debt_bond_stress::net_capital_to_gov_bonds" id="695">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sharp increase in kinetic strikes raises global risk aversion and triggers immediate safe‑haven reallocations into US Treasuries, producing net capital inflows to government bonds." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::strike_intensity" target="us_debt_bond_stress::bond_market_liquidity" id="696">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sudden escalation boosts volatility and dealer balance‑sheet and risk limits, causing market‑making to pull back and reducing Treasury market depth and liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::strike_intensity" target="us_iran_confront::military_tension" id="697">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Sustained increases in cross-border strikes and attacks on proxy forces provoke direct US kinetic responses and higher alert/posture levels, raising bilateral military escalation intensity between US and Iran." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::strike_intensity" target="us_iran_confront::perceived_supply_risk" id="698">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher frequency of strikes targeting tankers, ports, or nearby infrastructure raises insurer and market concern about immediate disruptions to oil flows, increasing the assessed risk of supply interruption." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="27" value="0" />
