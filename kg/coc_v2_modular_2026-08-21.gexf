      <edge source="eastasia_alliance_strain::military_drill_scope" target="israel_region_escalation::deconflict_effectiveness" id="496">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Complex, overlapping drills create temporary airspace/sea restrictions and unplanned interactions that overwhelm or bypass routine contact channels, degrading the practical effectiveness of deconfliction mechanisms." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="eastasia_alliance_strain" />
          <attvalue for="38" value="israel_region_escalation" />
