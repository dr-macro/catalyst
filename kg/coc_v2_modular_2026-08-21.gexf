          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising budgetary pressure on major Western donors driven by war-related spending forces reallocations and publicized burden-sharing disputes that reduce political alignment and operational cooperation among US allies in East Asia." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="eastasia_alliance_strain" />
