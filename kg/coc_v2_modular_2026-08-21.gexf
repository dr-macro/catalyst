      <edge source="russia_ukraine_war::defense_supply_chain_flo" target="eastasia_alliance_strain::military_drill_scope" id="228">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Diversion of Western weapons, air-defence systems and munitions to sustain Ukrainian operations depletes forward inventories and prompts the US and regional partners to enlarge visible joint and unilateral exercises to reassure allies and compensate for temporary capability gaps." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="eastasia_alliance_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::defense_supply_chain_flo" target="israel_region_escalation::deconflict_effectiveness" id="229">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A sustained increase in Western deliveries into Ukraine provokes Russia to accelerate transfers of advanced air-defence and strike-related systems to Syrian/Iran-linked forces, complicating regional airspace geometry and making deconfliction mechanisms less effective." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="israel_region_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::defense_supply_chain_flo" target="us_debt_bond_stress::policy_balance_sheet" id="230">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Major disruptions or bottlenecks in defense supply flows force large, rapid increases in congressional military aid financed by additional Treasury issuance, prompting the Federal Reserve or other official sector actors to expand asset purchase operations to absorb issuance and stabilize markets, directly increasing the policy sector balance sheet." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::defense_supply_chain_flo" target="us_iran_confront::military_tension" id="231">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained high-rate Western deliveries of air-defence and precision munitions into the Russia–Ukraine theatre deplete US/NATO inventories and strategic lift, temporarily reducing deterrent posture and air/sea assets available in the Persian Gulf and thereby encouraging Iranian probing and higher regional military escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
