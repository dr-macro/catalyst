          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Greater concentration and proximity of US and allied naval/air/military assets near Iranian forces and key waterways increases the probability of close encounters and reciprocal force-posturing, elevating US-Iran military tension." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="us_iran_confront" />
