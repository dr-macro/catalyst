      <edge source="israel_region_escalation::diplomatic_engagement" target="eastasia_alliance_strain::diplomatic_signal_flow" id="737">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sustained, high-tempo diplomatic engagement focused on the Israel theater consumes senior leadership time and foreign‑ministry bandwidth in major powers, reducing the frequency and visibility of high-level outreach, visits, and coordinated messaging directed at East Asian partners." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="eastasia_alliance_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::diplomatic_engagement" target="russia_ukraine_war::public_financial_stress" id="738">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intense diplomatic focus and high-level negotiations oriented to the Israel crisis shift legislative and executive political capital and budgetary attention in key donor states, leading to re-prioritization or delays in supplemental assistance to Ukraine and thereby increasing Ukraine's public financial stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::diplomatic_engagement" target="us_debt_bond_stress::net_capital_to_gov_bonds" id="739">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained external diplomatic progress reduces near‑term geopolitical uncertainty, prompting investors to reallocate from safe‑haven Treasuries back into risk assets and decreasing net inflows to government bonds." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
