          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="More effective deconfliction protocols and real-time communications reduce misidentification and accidental engagements between US and Iranian units, directly lowering the intensity of military escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="us_iran_confront" />
