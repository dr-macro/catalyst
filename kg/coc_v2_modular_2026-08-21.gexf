        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Larger or longer joint and unilateral drills in East Asia tie up forward-deployed combat units, carrier/air assets and rapid-reaction reserves, reducing the pool of readily deployable combat-capable forces that could be shifted to reinforce operations related to the Russia‑Ukraine war." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="eastasia_alliance_strain" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
