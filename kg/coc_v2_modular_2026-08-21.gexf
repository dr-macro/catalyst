      <edge source="israel_region_escalation::deployment_density" target="eastasia_alliance_strain::military_drill_scope" id="770">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher concentration of deployed assets near the Israel theater leads the U.S. and regional partners to reallocate and pre-position remaining forces in the Indo‑Pacific and to enlarge the scale/duration of scheduled joint exercises there as a compensatory reassurance and deterrence measure." />
          <attvalue for="36" value="1-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="eastasia_alliance_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::deployment_density" target="russia_ukraine_war::military_force_strength" id="771">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher concentration of US/NATO naval and air assets in the Eastern Mediterranean and Gulf to respond to an Israel escalation forces temporary redeployment of ready units away from Europe, reducing the pool of combat-capable forces available to reinforce operations in the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
