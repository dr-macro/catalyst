          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Acute fiscal stress in Russia (larger deficits, emergency needs) can prompt production cuts, export restrictions, or disruption of maintenance/investment in Russian oil output, tightening global supply and lifting benchmark oil prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
