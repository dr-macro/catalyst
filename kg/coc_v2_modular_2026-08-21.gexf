      <edge source="israel_region_escalation::deconflict_effectiveness" target="eastasia_alliance_strain::escalation_propensity" id="749">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Improved deconfliction in the Israel theater reduces cross-command uncertainty and information frictions; conversely, a drop in deconfliction effectiveness erodes shared incident‑handling practices and trust among forces that operate across theaters, increasing the systemic tendency for incidents in East Asia to escalate." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="eastasia_alliance_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_region_escalation::deconflict_effectiveness" target="russia_ukraine_war::logistics_capacity" id="750">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Improved deconfliction between regional and external militaries reduces risks to commercial and military sea/air corridors (e.g., Red Sea, Gulf approaches), directly restoring routing certainty and throughput for munitions and supplies bound for Europe and Ukraine, while degraded deconfliction lowers that throughput." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_region_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
