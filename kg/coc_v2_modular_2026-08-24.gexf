      <edge source="russia_ukraine_war::strike_rate" target="tech_ai_superpower_rival::model_dev_velocity" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Higher strike rates create acute operational demands (targeting, ISR, EW) and rich real-world data/feedback that drive defense labs and contractors to shorten iteration cycles and prioritize rapid model improvements, accelerating development velocity for relevant capabilities." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="tech_ai_superpower_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::strike_rate" target="us_treasury_bond_crisis::market_stress_level" id="36">
