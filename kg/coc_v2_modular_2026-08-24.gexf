      <edge source="us_treasury_bond_crisis::market_stress_level" target="iran_gulf_flashpoint::trade_finance_avail" id="463">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute stress in the US Treasury market causes global banks to hoard liquidity and cut non‑core, higher‑risk correspondent and trade‑finance lines (including those that historically dealt indirectly with Iran), directly reducing the availability of letters of credit and correspondent services for Iranian trade." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_bond_crisis" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_treasury_bond_crisis::market_stress_level" target="iran_gulf_flashpoint::sec_pressure_effect" id="464">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Systemic bond‑market stress triggers rapid de‑risking by international banks and corporates who seek to avoid any exposures that could attract regulatory scrutiny, thereby making US extraterritorial/secondary measures more effective in curtailing third‑party dealings with Iran." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_bond_crisis" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_treasury_bond_crisis::market_stress_level" target="russia_ukraine_war::logistics_capacity" id="465">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute bond-market stress forces banks and freight financiers to pull or sharply re-price trade-finance, letters of credit and insurance, directly constraining commercial shipping, maintenance and transport throughput that sustain military and civilian materiel flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_bond_crisis" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_treasury_bond_crisis::market_stress_level" target="tech_ai_superpower_rival::ai_hardware_supply" id="466">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute stress in the bond market tightens short-term financing and triggers margin calls for suppliers and distributors, forcing producers to delay shipments or cut production of AI accelerators and boards due to working-capital shortages." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_bond_crisis" />
          <attvalue for="38" value="tech_ai_superpower_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_treasury_bond_crisis::market_stress_level" target="us_canada_trade_war::bilateral_trade_flow" id="467">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
