          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A faster pace of reciprocal trade measures increases policy and exit risk for cross-border AI ventures, prompting LPs and corporates to pull or re-allocate funding away from binational AI projects and startups." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_canada_trade_war" />
          <attvalue for="38" value="tech_ai_superpower_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
