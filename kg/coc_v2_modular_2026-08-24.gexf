      <edge source="russia_ukraine_war::resupply_rate_defense" target="us_canada_trade_war::supply_reconfig_rate" id="58">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A surge in military resupply shipments to Europe and adjacent theatres consumes container, roll‑on/roll‑off and air cargo capacity and creates input shortages, prompting North American firms to accelerate near‑sourcing and relocation of production away from exposed foreign suppliers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_canada_trade_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::resupply_rate_defense" target="us_treasury_bond_crisis::market_intervention_flow" id="59">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained increases in defensive materiel resupply funded by Western governments raise expected Treasury issuance or Treasury/Fed support needs, prompting higher rates of long‑maturity bond purchases or other yield‑smoothing interventions to absorb supply and cap yields." />
