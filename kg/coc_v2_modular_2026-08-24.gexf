      <edge source="russia_ukraine_war::escalation_pressure" target="iran_gulf_flashpoint::regional_escalation" id="124">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising escalation pressure in the Russia–Ukraine theatre forces Western naval/air assets and political attention toward Europe, reducing deterrent presence in the Gulf and creating opportunities for regional actors and proxies to intensify maritime harassment and limited strikes, increasing regional military escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="iran_gulf_flashpoint::trade_finance_avail" id="125">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="As escalation pressure around Ukraine rises, policymakers expand sanctions focus and banks increase de‑risking to avoid secondary exposure, causing correspondent banks and trade‑finance providers to curtail services for counterparties linked to Iran/Gulf trade and thereby reducing trade finance availability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="tech_ai_superpower_rival::ai_capital_inflows" id="126">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising escalation raises perceived geopolitical and sanction risks for investors and corporates (especially for cross-border tech deals), triggering risk-off behavior and postponement/cancellation of AI funding and capex into exposed firms and regions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="tech_ai_superpower_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="tech_ai_superpower_rival::market_concentration" id="127">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Heightened escalation leads governments to impose export controls, procurement preferences and industrial subsidies that disproportionately benefit large incumbent providers able to comply with security vetting and scale, increasing concentration among a few dominant AI vendors." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="tech_ai_superpower_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="us_treasury_bond_crisis::long_term_yields" id="128">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising systemic escalation pressure increases the risk of broader energy and commodity disruptions and a higher term premium (through inflation expectations and geopolitical risk), which raises market‑determined long‑maturity yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_treasury_bond_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
