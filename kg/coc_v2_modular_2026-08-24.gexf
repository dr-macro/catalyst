          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A faster pace of reciprocal trade measures raises policy and counterparty uncertainty and triggers abrupt position adjustments and liquidity withdrawals in Treasury cash/futures markets, increasing observable market stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_canada_trade_war" />
