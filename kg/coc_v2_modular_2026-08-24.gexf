          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute spikes in cross-border strikes that damage ports, energy nodes or logistics hubs produce abrupt cross-asset risk‑off flows and forced reallocations that overwhelm dealer capacity and liquidity in the Treasury market, producing order imbalances and disorderly price moves." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
