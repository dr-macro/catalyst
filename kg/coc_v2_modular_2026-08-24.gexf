      <edge source="us_canada_trade_war::retaliation_rate" target="iran_gulf_flashpoint::sec_pressure_effect" id="696">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rising pace of reciprocal US–Canada trade measures produces political backlash and reduces Ottawa’s willingness to coordinate with Washington on enforcement and information‑sharing for extraterritorial/secondary sanctions, weakening their practical effectiveness against third parties dealing with Iran." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_canada_trade_war" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
