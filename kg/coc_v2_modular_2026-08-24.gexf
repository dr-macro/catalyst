      <edge source="russia_ukraine_war::strike_rate" target="iran_gulf_flashpoint::crude_throughput_rate" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained spike in cross‑border missile and drone strikes raises insurance premiums and perceived transit risk for global shipping, prompting tanker operators to reroute or idle vessels and insurers to restrict cover for certain Gulf transits, which lowers crude throughput through key chokepoints." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
