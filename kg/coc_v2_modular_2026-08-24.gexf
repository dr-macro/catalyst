      <edge source="russia_ukraine_war::resupply_rate_defense" target="tech_ai_superpower_rival::ai_hardware_supply" id="57">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An uptick in defensive resupply (accelerators, electronics, logistics) consumes constrained global manufacturing, testing and shipping capacity and component inventories, crowding out delivery slots and inputs available for commercial AI hardware." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="tech_ai_superpower_rival" />
