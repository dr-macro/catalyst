<edge source="global_oil_rebalance::market_supply_expect" target="iran_gulf_escalation::shipping_insurance_idx" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Market expectations of tighter future supply elevate perceived transit risk for carriers and underwriters, prompting insurers to raise premiums and risk surcharges on shipments transiting the Gulf and nearby sea lanes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_oil_rebalance</data>
  <data key="d39">iran_gulf_escalation</data>
</edge>
<edge source="global_oil_rebalance::market_supply_expect" target="russia_ukraine_war::interparty_trust_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Market expectations of tighter future oil supply prompt states to pursue emergency bilateral energy deals and prioritized national stockpiling outside collective arrangements, which undermines trust that partners will equitably coordinate burdens and share resources for the Ukraine campaign.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_oil_rebalance</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
