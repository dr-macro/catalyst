<edge source="iran_gulf_escalation::shipping_insurance_idx" target="comms_cyber_warfare::valuation_exuberance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising insurance premiums and risk surcharges materially raise unit costs and delivery risk for hardware‑intensive AI firms, prompting investors to mark down growth multiples and cool speculative valuations in the AI/tech sector.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">comms_cyber_warfare</data>
</edge>
<edge source="iran_gulf_escalation::shipping_insurance_idx" target="russia_ukraine_war::military_aid_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sharp increases in insurance premiums and war-risk surcharges for shipments routing near the Gulf raise transport costs and cause carriers to delay or reroute high-value military shipments, reducing the effective delivery rate of materiel to Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_escalation::shipping_insurance_idx" target="transatlantic_cohesion::bond_yield_level" id="0">
