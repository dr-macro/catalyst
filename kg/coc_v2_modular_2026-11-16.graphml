  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">?</data>
</edge>
<edge source="comms_cyber_warfare::ai_agent_prevalence" target="comms_cyber_warfare::cyber_incident_rate" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="comms_cyber_warfare::ai_agent_prevalence" target="global_oil_rebalance::market_supply_expect" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">A larger population of autonomous trading and analytic agents rapidly ingests and amplifies spoofed or compromised telemetry (e.g., fake AIS, terminal status, pipeline SCADA signals), causing aggregated market participants to update expectations toward tighter future supply.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">comms_cyber_warfare</data>
  <data key="d39">global_oil_rebalance</data>
</edge>
<edge source="comms_cyber_warfare::ai_agent_prevalence" target="iran_gulf_escalation::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Proliferation of autonomous AI agents enables remote coordination and dynamic targeting of unmanned surface/air systems and loitering munitions against commercial vessels, increasing the frequency and effectiveness of kinetic attacks.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">comms_cyber_warfare</data>
  <data key="d39">iran_gulf_escalation</data>
</edge>
<edge source="comms_cyber_warfare::ai_agent_prevalence" target="russia_ukraine_war::military_aid_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rapid deployment of autonomous cyber/AI agents that degrade C2, logistics tracking or munitions stock visibility produces urgent battlefield shortfalls and accelerates requests for and deliveries of replacement equipment and munitions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">comms_cyber_warfare</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="comms_cyber_warfare::ai_agent_prevalence" target="transatlantic_cohesion::policy_uncertainty" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A rise in deployed autonomous trading and decision agents produces more frequent, novel market incidents and cross‑jurisdictional harms that prompt ad hoc regulatory interventions and uneven national responses, raising perceived unpredictability of future policy choices.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">comms_cyber_warfare</data>
  <data key="d39">transatlantic_cohesion</data>
</edge>
