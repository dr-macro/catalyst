  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Spikes in attacks on tankers increase immediate loss/rerouting risk and force market participants to pay a risk premium or cover anticipated shortfalls, driving up traded crude futures prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">global_oil_rebalance</data>
