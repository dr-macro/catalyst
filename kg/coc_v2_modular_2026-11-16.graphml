<edge source="iran_gulf_escalation::maritime_attack_rate" target="global_oil_rebalance::market_supply_expect" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained rise in reported maritime attacks causes traders and physical traders to revise forward-looking assessments toward greater likelihood of shipment interruptions, raising expectations of tighter future supply.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">global_oil_rebalance</data>
</edge>
<edge source="iran_gulf_escalation::maritime_attack_rate" target="russia_ukraine_war::diplomatic_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A spike in attacks on commercial shipping forces divergent policy responses (some states emphasize de‑escalation and energy security, others punitive measures), producing inconsistent messaging and eroding unified diplomatic positioning toward Russia and related sanctions coordination.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_escalation::maritime_attack_rate" target="transatlantic_cohesion::capital_flow_volatility" id="0">
