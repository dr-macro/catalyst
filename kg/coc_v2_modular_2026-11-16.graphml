<edge source="iran_gulf_escalation::energy_export_flow" target="iran_gulf_escalation::shipping_throughput" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_gulf_escalation::energy_export_flow" target="comms_cyber_warfare::compute_infra_utilizatio" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">A sharp fall in Gulf hydrocarbon/LNG shipments forces importing countries to ration fuel or face large electricity price spikes, causing hyperscalers and on-prem data centres to throttle or postpone energy‑intensive AI training and batch workloads, reducing compute utilization.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">comms_cyber_warfare</data>
</edge>
<edge source="iran_gulf_escalation::energy_export_flow" target="global_oil_rebalance::global_crude_supply" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.95</data>
  <data key="d36">A rise or fall in the physical rate of hydrocarbon and LNG shipments leaving the region directly changes the volumetric amount of crude available on international markets, immediately altering global supply.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">global_oil_rebalance</data>
</edge>
<edge source="iran_gulf_escalation::energy_export_flow" target="transatlantic_cohesion::cb_expectations" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">An increase in Gulf energy export flows eases global supply pressures and lowers near‑term inflation risk, reducing market odds of central‑bank tightening (and conversely, a drop in flows raises tightening expectations).</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">transatlantic_cohesion</data>
</edge>
<edge source="iran_gulf_escalation::shipping_insurance_idx" target="iran_gulf_escalation::shipping_throughput" id="0">
  <data key="d27">intra_causal</data>
