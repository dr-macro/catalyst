      <edge source="indo_pacific_rivalry::crisis_escalation_risk" target="global_bond_rout::bond_market_volatility" id="803">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Acute rise in military/diplomatic escalation risk triggers rapid portfolio rebalancing and hedging across sovereign debt markets, spiking realized and implied bond volatility as traders widen risk premia and run protection trades." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="indo_pacific_rivalry" />
          <attvalue for="38" value="global_bond_rout" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="indo_pacific_rivalry::crisis_escalation_risk" target="global_bond_rout::bank_funding_stress" id="804">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Heightened crisis risk increases counterparty, settlement and rollover uncertainty for banks with regional exposure, prompting liquidity hoarding and higher wholesale funding costs that raise bank funding stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="indo_pacific_rivalry" />
          <attvalue for="38" value="global_bond_rout" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="indo_pacific_rivalry::crisis_escalation_risk" target="global_fuel_supply_shock::export_control_level" id="805">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rise in escalation risk prompts governments to impose formal or informal limits on crude and refined exports to deny supplies to adversaries and conserve domestic fuel stocks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="indo_pacific_rivalry" />
          <attvalue for="38" value="global_fuel_supply_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="indo_pacific_rivalry::crisis_escalation_risk" target="global_fuel_supply_shock::refined_inventory_level" id="806">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Heightened likelihood of conflict leads governments and commercial buyers to accelerate on‑hand stockpiling of refined transport fuels as an immediate buffer against anticipated disruptions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="indo_pacific_rivalry" />
          <attvalue for="38" value="global_fuel_supply_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="indo_pacific_rivalry::crisis_escalation_risk" target="hormuz_redsea_tensions::tanker_security_risk" id="807">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Heightened Indo‑Pacific crisis risk raises great‑power distraction and risk tolerance among regional proxies and state actors, who exploit security gaps or test resolve by increasing maritime harassment and attacks on tankers in the Gulf and Red Sea." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="indo_pacific_rivalry" />
          <attvalue for="38" value="hormuz_redsea_tensions" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="indo_pacific_rivalry::crisis_escalation_risk" target="russia_ukraine_war::kinetic_attack_intensity" id="808">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An acute uptick in Indo‑Pacific crisis risk prompts rapid redeployment of Western naval/air assets and political attention away from Europe, reducing immediate deterrence and creating windows that enable Moscow to increase the tempo or scale of kinetic operations in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="indo_pacific_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
