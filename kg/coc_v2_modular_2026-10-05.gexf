          <attvalue for="35" value="Sustained increases in pledged and disbursed defense spending among multiple sovereigns raise expected future borrowing needs and issuance, putting upward pressure on long-term sovereign yields as markets price higher supply and fiscal risk." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_rout" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::defense_funding" target="hormuz_redsea_tensions::military_deploy_intensit" id="122">
