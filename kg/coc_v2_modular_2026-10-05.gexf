          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Sustained higher global oil prices raise fiscal and social-stabilization costs for energy-importing supporters, prompting budgetary reprioritization that can delay or scale back defense funding commitments for Ukraine." />
