      <edge source="hormuz_redsea_tensions::crude_inventory_levels" target="global_fuel_supply_shock::stock_release_rate" id="290">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Declining crude inventory buffers prompt authorities to increase strategic stock release rates to stabilize markets, while larger inventories allow reductions in release flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_redsea_tensions" />
          <attvalue for="38" value="global_fuel_supply_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="hormuz_redsea_tensions::crude_inventory_levels" target="russia_ukraine_war::sanctions_pressure" id="291">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Material declines in commercial and strategic crude stocks make import-dependent governments reluctant to expand or tighten energy sanctions on Russia for fear of precipitating supply shocks, reducing the intensity and scope of sanctions pressure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_redsea_tensions" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
