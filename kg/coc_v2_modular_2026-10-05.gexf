          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.95" />
          <attvalue for="35" value="Higher global crude prices raise refinery feedstock costs and margins, which are passed through into higher wholesale and retail fuel prices within weeks to months." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_redsea_tensions" />
          <attvalue for="38" value="global_fuel_supply_shock" />
