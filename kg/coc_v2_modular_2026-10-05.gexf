      <edge source="hormuz_redsea_tensions::crude_inventory_levels" target="global_bond_rout::investor_net_bond_flows" id="289">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sharp declines in onshore and floating crude stocks signal tighter near-term supply and higher inflation risk, prompting institutional and allocators to reduce duration exposure and rotate into real assets and commodities, producing net bond outflows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_redsea_tensions" />
          <attvalue for="38" value="global_bond_rout" />
