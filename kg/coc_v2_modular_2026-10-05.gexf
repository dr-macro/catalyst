      <edge source="global_fuel_supply_shock::stock_release_rate" target="hormuz_redsea_tensions::military_deploy_intensit" id="466">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Large strategic stock releases are typically accompanied by coordinated naval escorts, convoying and temporary force deployments to protect state‑sponsored shipments and guard supply lines, raising military presence in transit corridors." />
