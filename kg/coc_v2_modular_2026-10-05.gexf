      <edge source="russia_ukraine_war::sanctions_pressure" target="global_bond_rout::bond_market_liquidity" id="136">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Expanded, tightly enforced sanctions against banks, asset custodians or commodity-linked counterparties disrupt cross-border settlement and repo/interdealer activity, reducing depth and widening bid-ask spreads in global bond markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_rout" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="global_fuel_supply_shock::export_control_level" id="137">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Expanded and enforced sanction regimes impose formal bans, secondary restrictions and shipping/insurance constraints that increase aggregate export controls on crude and refined shipments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_fuel_supply_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="global_fuel_supply_shock::refined_inventory_level" id="138">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sanctions and related trade restrictions block or deter imports of Russian refined products to dependent markets, directly reducing available refined‑fuel inventories there." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_fuel_supply_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="hormuz_redsea_tensions::global_oil_price_level" id="139">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Tighter and more effectively enforced sanctions reduce Russian export volumes and raise shipping/insurance frictions, directly tightening available crude supply and pushing benchmark prices upward." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="hormuz_redsea_tensions" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="indo_pacific_rivalry::financing_constraints" id="140">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Expansion and enforcement of secondary sanctions and compliance controls tied to the Russia war prompt global banks and insurers to de-risk, withdraw correspondent services, and add sanction-related covenants, directly raising the cost and availability barriers for financing strategic Indo‑Pacific infrastructure projects." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="indo_pacific_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="indo_pacific_rivalry::strategic_investment_flo" id="141">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened sanctions risk increases due‑diligence and counterparty concerns among institutional investors and state-backed financiers, causing a measurable diversion or postponement of cross‑border strategic capital flows into projects in the Indo‑Pacific that involve counterparties exposed to secondary sanctions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="indo_pacific_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
