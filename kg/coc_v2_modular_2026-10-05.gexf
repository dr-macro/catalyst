          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Larger and faster defense budget commitments finance additional naval/air assets, contractors and sustainment that enable more or longer deployments to protect energy transit corridors in the Strait of Hormuz and the Red Sea." />
