          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rise in long-term benchmark yields attracts capital into the currency of that sovereign bond (e.g., USD), appreciating it and making dollar-priced crude more expensive for other currencies, reducing demand and putting downward pressure on global oil prices within weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_rout" />
