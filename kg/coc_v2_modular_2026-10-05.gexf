          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A surge in concentrated military deployments elevates counterparty and operational risk, prompting dealers and market-makers to cut inventory, widen spreads and reduce willingness to warehouse duration, thereby degrading bond-market liquidity." />
