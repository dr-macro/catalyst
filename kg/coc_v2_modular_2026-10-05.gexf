      <edge source="global_fuel_supply_shock::export_control_level" target="global_fuel_supply_shock::market_supply_expectatio" id="453">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="3" />
          <attvalue for="32" value="-" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_supply_shock::export_control_level" target="global_bond_rout::bond_market_liquidity" id="454">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.62" />
          <attvalue for="35" value="Tighter export controls raise cross-border settlement frictions and counterparty risk, reducing non‑domestic dealer participation and repo/backstop capacity and thereby degrading bid-ask depth and immediacy in sovereign bond markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="global_bond_rout" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_supply_shock::export_control_level" target="hormuz_redsea_tensions::tanker_security_risk" id="455">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter export controls prompt more covert ship‑to‑ship transfers, route deviations and interdiction/enforcement actions (by states or proxies), increasing exposure of tankers to harassment, seizure or attack." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="hormuz_redsea_tensions" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_supply_shock::export_control_level" target="indo_pacific_rivalry::financing_constraints" id="456">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter export controls raise counterparty, trade and insurance risk for cross-border energy contracts, prompting banks and export credit agencies to pull back or add restrictive covenants, thereby increasing infrastructure financing constraints for projects in the region." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="indo_pacific_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_supply_shock::export_control_level" target="russia_ukraine_war::alliance_cohesion" id="457">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="More restrictive or uneven export controls on fuels by some suppliers force alliance members into competing national carve‑outs and bilateral deals to secure supplies, producing diplomatic friction and weakening coordinated political and military alignment." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
