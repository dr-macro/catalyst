          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising tanker security risk raises shipping insurance and freight costs, forces rerouting and delays, and reduces delivered volumes which directly lifts wholesale and pump fuel prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_redsea_tensions" />
          <attvalue for="38" value="global_fuel_supply_shock" />
