          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger alliance commitments and force-posture emphasis in the Indo‑Pacific require redeployment of limited US and partner naval and air assets to that theater, reducing sustained force presence and operations available for Hormuz/Red Sea corridors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="indo_pacific_rivalry" />
          <attvalue for="38" value="hormuz_redsea_tensions" />
