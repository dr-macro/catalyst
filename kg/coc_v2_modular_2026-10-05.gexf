          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Damage to or credible threats against export infrastructure in the Russia–Ukraine theatre forces buyers and sellers to reroute volumes toward Gulf suppliers and longer sea legs that transit Hormuz/Bab al‑Mandeb, increasing throughput through those chokepoints." />
