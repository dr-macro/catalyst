      <edge source="global_fuel_supply_shock::refined_inventory_level" target="global_bond_rout::bond_market_volatility" id="441">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Falling refined-fuel inventories increase the probability of abrupt supply disruptions and emergency policy interventions, which raises macro and policy uncertainty and triggers more frequent, larger moves in bond prices and yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="global_bond_rout" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_supply_shock::refined_inventory_level" target="hormuz_redsea_tensions::chokepoint_throughput" id="442">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher on‑hand refined‑product inventories reduce the need for immediate cross‑border imports, lowering tanker and product flows through maritime chokepoints as import orders are deferred or canceled." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="hormuz_redsea_tensions" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_supply_shock::refined_inventory_level" target="indo_pacific_rivalry::crisis_escalation_risk" id="443">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Declining refined-fuel inventories create urgency to secure supplies, leading states and private actors to increase naval escorts, pre-position forces, and contest vulnerable shipping nodes, which raises the risk that incidents will escalate into broader crises." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="indo_pacific_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_supply_shock::refined_inventory_level" target="russia_ukraine_war::kinetic_attack_intensity" id="444">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A drop in global on‑hand refined‑fuel inventories reduces available fuel shipments and forward reserves for ground and armored formations, directly constraining operational tempo and lowering the rate and scale of kinetic strikes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_supply_shock::refined_inventory_level" target="russia_ukraine_war::sanctions_pressure" id="445">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tight global refined‑fuel stocks increase the acute domestic exposure of fuel‑importing states to shortages, prompting them to resist new or tighter punitive measures and to seek exemptions, thereby reducing the scope and enforcement of sanctions against the conflict party." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_fuel_supply_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
