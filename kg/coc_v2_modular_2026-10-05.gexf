          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A marked rise in global oil prices feeds into higher inflation and monetary tightening globally, raising borrowing costs and thereby tightening the availability and terms of capital for Indo‑Pacific infrastructure projects." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_redsea_tensions" />
          <attvalue for="38" value="indo_pacific_rivalry" />
