<edge source="china_geostrategic_push::geopolitical_tension" target="european_institutional_f::policy_uncertainty" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising China‑driven geopolitical tensions force EU institutions into rapid debates over trade restrictions, investment screening and industrial subsidies, increasing unpredictability about near‑term regulatory and fiscal choices faced by firms and markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_geostrategic_push</data>
  <data key="d39">european_institutional_f</data>
</edge>
<edge source="china_geostrategic_push::geopolitical_tension" target="european_institutional_f::banking_sector_solvency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating geopolitical friction leads to sanctions, frozen counterparties and sudden re‑pricing of China‑exposed corporate credits, producing higher loan losses and capital strain for European banks with direct China/Asia exposures.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_geostrategic_push</data>
  <data key="d39">european_institutional_f</data>
</edge>
<edge source="china_geostrategic_push::geopolitical_tension" target="global_oil_market_shock::geo_conflict_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A rise in geopolitical tension tied to China's geostrategic moves increases the probability of kinetic incidents, naval interdictions and targeted sanctions that immediately raise the frequency and intensity of events disrupting energy-related infrastructure and shipping lanes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_geostrategic_push</data>
  <data key="d39">global_oil_market_shock</data>
</edge>
<edge source="china_geostrategic_push::geopolitical_tension" target="iran_gulf_standoff::military_posture" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sharp uptick in China's geostrategic pressure prompts the US and regional partners to surge naval assets and exercises in the Gulf, which in turn provokes reciprocal Iranian force deployments and readiness increases.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_geostrategic_push</data>
  <data key="d39">iran_gulf_standoff</data>
</edge>
<edge source="china_geostrategic_push::geopolitical_tension" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating China–US strategic friction draws US political and military focus to the Indo‑Pacific and triggers disputes among allies over priorities and burden‑sharing for Ukraine support, eroding coordinated policy and resource commitments.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_geostrategic_push</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="china_geostrategic_push::geopolitical_tension" target="russia_ukraine_war::diplomatic_leverage" id="0">
  <data key="d27">cross_causal</data>
