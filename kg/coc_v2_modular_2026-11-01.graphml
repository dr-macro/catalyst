<edge source="iran_gulf_standoff::shipping_throughput" target="china_geostrategic_push::private_capital_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A drop in commercial shipping throughput raises delivery times and hardware costs for AI projects, leading private investors and firms—particularly those dependent on imported chips and servers—to delay or scale back capital deployment into AI R&amp;D and capex.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">china_geostrategic_push</data>
</edge>
<edge source="iran_gulf_standoff::shipping_throughput" target="european_institutional_f::gdp_growth_momentum" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A measurable fall in throughput reduces availability of intermediate goods and export volumes for European manufacturers and logistics sectors, causing near‑term output declines and slowing GDP growth momentum.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">european_institutional_f</data>
</edge>
