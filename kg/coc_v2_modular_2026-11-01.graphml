<edge source="china_geostrategic_push::export_control_restrict" target="european_institutional_f::gdp_growth_momentum" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Tighter Chinese export controls on chips and intermediate goods create measurable input shortages for European manufacturers, interrupting production and depressing quarterly GDP growth momentum as firms delay output and investment.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_geostrategic_push</data>
  <data key="d39">european_institutional_f</data>
</edge>
<edge source="china_geostrategic_push::export_control_restrict" target="global_oil_market_shock::refining_margin_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter export controls on critical refinery components, catalysts and control electronics reduces maintenance and upgrade throughput for refineries abroad, lowering effective processing capacity and product output and thereby widening the spread between product prices and crude costs.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_geostrategic_push</data>
  <data key="d39">global_oil_market_shock</data>
</edge>
