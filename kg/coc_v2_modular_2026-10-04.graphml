<edge source="iran_middle_east_tension::shipping_security_risk" target="global_energy_supply_sho::diesel_spot_price_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Higher perceived risk to tanker and product shipments raises insurance and freight costs and prompts immediate rerouting or delays, reducing available nearby diesel cargoes and lifting spot prices in affected markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_middle_east_tension</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="iran_middle_east_tension::shipping_security_risk" target="russia_ukraine_war::mil_escalation_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising attacks or threats to commercial shipping draw naval and intelligence assets toward the Middle East and create gaps in European-area deterrence, which adversaries can exploit to raise the tempo or scale of operations in Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_middle_east_tension</data>
  <data key="d40">russia_ukraine_war</data>
