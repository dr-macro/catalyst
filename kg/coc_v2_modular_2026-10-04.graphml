  <data key="d29">3</data>
  <data key="d34">-</data>
</edge>
<edge source="global_energy_supply_sho::diesel_inventory_level" target="russia_ukraine_war::mil_escalation_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Higher on‑hand diesel stocks in the theatre directly enable sustained mechanized and logistic operations (more vehicle/armor sorties, resupply of forward units), increasing the intensity and tempo of kinetic operations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_energy_supply_sho::diesel_inventory_level" target="sovereign_bond_market_st::leverage_unwind_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Higher diesel inventories reduce the risk of supply shocks and margin calls for commodity‑leveraged players, lowering the speed at which leveraged positions are forced to be reduced or liquidated across markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">sovereign_bond_market_st</data>
</edge>
