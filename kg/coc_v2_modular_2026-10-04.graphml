<edge source="global_energy_supply_sho::diesel_spot_price_level" target="global_energy_supply_sho::diesel_demand_rate" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">-</data>
</edge>
<edge source="global_energy_supply_sho::diesel_spot_price_level" target="russia_ukraine_war::defense_aid_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rapid increases in diesel spot prices raise logistics and operating costs for transporting and sustaining materiel, pressuring donor budgets and contractors and thereby slowing or reducing the volume and speed of military aid deliveries.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_energy_supply_sho::diesel_spot_price_level" target="sovereign_bond_market_st::volatility_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sharp increases in diesel spot prices boost operational and margin uncertainty for transport‑dependent firms and commodity traders, triggering repricing and higher realized/implied volatility in the bond and credit markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">sovereign_bond_market_st</data>
</edge>
<edge source="global_energy_supply_sho::diesel_spot_price_level" target="us_china_tech_trade_riva::capital_inflow_ai" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sharp increases in diesel spot prices raise short‑term operating and logistics costs for compute‑heavy startups and data center operators, compressing burn‑runway and reducing near‑term valuations and investor allocations to AI funds.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">us_china_tech_trade_riva</data>
</edge>
<edge source="global_energy_supply_sho::consumer_inflation_rate" target="global_energy_supply_sho::policy_interest_rate_lev" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">3</data>
  <data key="d34">+</data>
</edge>
<edge source="global_energy_supply_sho::consumer_inflation_rate" target="russia_ukraine_war::diplomatic_cooperation" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sustained rises in consumer inflation driven by energy costs increase domestic political pressure on governments to prioritize short‑term economic relief, reducing their willingness to undertake coordinated, costly diplomatic or burden‑sharing actions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_energy_supply_sho::consumer_inflation_rate" target="sovereign_bond_market_st::nominal_yield_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">A rise in consumer inflation raises expected central‑bank tightening and inflation risk premia, prompting investors to demand higher nominal government bond yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">sovereign_bond_market_st</data>
</edge>
<edge source="global_energy_supply_sho::consumer_inflation_rate" target="us_china_tech_trade_riva::capital_inflow_ai" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
