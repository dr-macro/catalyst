  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="russia_ukraine_war::energy_resilience" target="russia_ukraine_war::diplomatic_cooperation" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">?</data>
</edge>
<edge source="russia_ukraine_war::energy_resilience" target="iran_middle_east_tension::oil_price_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Improved energy supply resilience in Europe (diversified sources, storage, and LNG flows) reduces risk premia and emergency demand linked to the Russia–Ukraine conflict, lowering global oil price levels (and conversely, degraded resilience raises them).</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_middle_east_tension</data>
</edge>
<edge source="russia_ukraine_war::energy_resilience" target="sovereign_bond_market_st::market_liquidity_depth" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Acute deterioration in energy supply resilience causes sharp commodity price moves and margin stresses that force dealers and leveraged players to shrink inventories and withdraw from making markets, reducing depth in sovereign bond trading.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">sovereign_bond_market_st</data>
</edge>
<edge source="russia_ukraine_war::energy_resilience" target="us_china_tech_trade_riva::compute_capacity_total" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Reduced energy resilience from supply disruptions or price spikes increases operating and build costs for datacenters, causing hyperscalers and cloud providers to delay or scale back new AI compute buildouts, lowering aggregate installed capacity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_tech_trade_riva</data>
</edge>
