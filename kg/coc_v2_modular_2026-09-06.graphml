<edge source="energy_supply_shock::refined_inventory_level" target="global_bond_turmoil::long_term_bond_yield" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A sustained decline in refined fuel inventories raises perceived structural supply risk and inflation/rollover risk for energy‑importing sovereigns, increasing the term premium investors demand and thereby lifting long‑term sovereign yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_supply_shock</data>
  <data key="d40">global_bond_turmoil</data>
</edge>
<edge source="energy_supply_shock::refined_inventory_level" target="russia_ukraine_war::humanitarian_need_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Falling stocks of refined fuels disrupt emergency services, heating and power generation in affected population centers, producing immediate increases in medical, shelter and relief needs.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_supply_shock</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="energy_supply_shock::refined_inventory_level" target="us_china_tech_rivalry::compute_resource_conc" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Declining refined fuel inventories constrain backup power and on‑site energy flexibility for dispersed data centers and fabs, pushing workloads and new deployments toward large, centralized providers and locations with secure fuel/electricity supplies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_supply_shock</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="energy_supply_shock::refined_inventory_level" target="us_iran_confrontation::oil_flow_disruption_rate" id="0">
