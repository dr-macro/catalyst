<edge source="us_venezuelan_oil::extraction_production_ra" target="global_financial_stress::long_term_bond_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A sustained rise in US/Venezuelan oil extraction raises global crude supply and lowers near-term inflation expectations, which reduces long-term sovereign bond risk premia and yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_venezuelan_oil</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="us_venezuelan_oil::extraction_production_ra" target="russia_ukraine_war::missile_prod_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained increase in Venezuelan crude production and exports depresses global oil prices, reducing Russia's hydrocarbon revenue and thereby constraining budgetary resources available for domestic missile manufacturing, lowering missile output over time.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_venezuelan_oil</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
