<edge source="global_financial_stress::policy_rate_expectations" target="us_venezuelan_oil::investment_capital_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Higher expected policy rates raise the expected cost of capital and discount rates, reducing the present value and attractiveness of long-lead upstream projects in Venezuela and thereby lowering new financing commitments and capital flows into the sector.</data>
  <data key="d37">6-18 months</data>
