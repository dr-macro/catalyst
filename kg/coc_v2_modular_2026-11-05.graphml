<edge source="us_political_shift::political_power_distribu" target="global_ai_power_shift::policy_expectation" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A shift toward more unified control of the presidency and Congress (or toward a stronger executive) increases the probability of passage of industrial policy, export‑controls and funding measures, causing markets to expect more active US AI industrial and trade policy.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_political_shift</data>
  <data key="d40">global_ai_power_shift</data>
</edge>
<edge source="us_political_shift::political_power_distribu" target="iran_gulf_conflict::geopolitical_risk_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A shift toward concentrated executive-legislative control and hawkish majorities enables quicker authorization of military deployments, strikes, and security guarantees to Gulf partners, raising the near-term probability and intensity of Iran–Gulf confrontation.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_political_shift</data>
  <data key="d40">iran_gulf_conflict</data>
</edge>
<edge source="us_political_shift::political_power_distribu" target="russia_ukraine_war::policy_uncertainty" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A shift toward greater partisan concentration or fragmentation in US political power heightens the probability of abrupt reversals or contested votes on Ukraine aid and sanctions, increasing perceived policy uncertainty about the conflict among markets and counterparties.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_political_shift</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
