<edge source="global_ai_power_shift::oversight_intensity" target="iran_gulf_conflict::geopolitical_risk_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Stronger AI oversight in leading states leads to tighter export controls and surveillance cooperation that heighten regional suspicions and prompt retaliatory security posturing by Iran and Gulf states, increasing measurable geopolitical risk.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_ai_power_shift</data>
  <data key="d40">iran_gulf_conflict</data>
</edge>
<edge source="global_ai_power_shift::oversight_intensity" target="us_china_tech_rivalry::geopolitical_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A sustained increase in expected regulatory scrutiny of AI and related firms precipitates concrete measures (export controls, entity listings, sanctions) targeted at Chinese tech actors, provoking reciprocal measures and elevating measured US–China geopolitical tension.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_ai_power_shift</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
