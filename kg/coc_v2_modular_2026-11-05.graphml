<edge source="iran_gulf_conflict::energy_commodity_price_l" target="global_ai_power_shift::risk_premium_levels" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A spike in energy prices raises operating costs for energy‑intensive AI infrastructure (data centers, large training runs) and increases macro volatility, which investors translate into higher required risk premia for AI and related assets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_conflict</data>
  <data key="d40">global_ai_power_shift</data>
</edge>
<edge source="iran_gulf_conflict::energy_commodity_price_l" target="russia_ukraine_war::rate_path_expectation" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">A sustained rise in energy prices from Iran–Gulf disruptions raises near-term inflation expectations in Europe and globally, prompting markets to price a steeper central-bank rate path.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_conflict</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_conflict::energy_commodity_price_l" target="russia_ukraine_war::oil_supply_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Spikes in global energy prices tied to Iran–Gulf conflict increase market perceptions that oil production or transport is vulnerable to further shocks, raising the assessed probability and severity of supply disruptions relevant to the Russia–Ukraine energy context.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_conflict</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
