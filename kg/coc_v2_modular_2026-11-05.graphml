<edge source="russia_ukraine_war::policy_uncertainty" target="global_ai_power_shift::oversight_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising geopolitical policy uncertainty from the Russia–Ukraine war prompts governments to rapidly expand export controls, security reviews and vetting of cross‑border AI partnerships, directly increasing regulatory scrutiny on AI firms.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_ai_power_shift</data>
</edge>
<edge source="russia_ukraine_war::policy_uncertainty" target="iran_gulf_conflict::geopolitical_risk_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Elevated Western policy uncertainty driven by the Ukraine war leads to redeployment/prioritization of military and diplomatic resources toward Europe, weakening deterrence in the Gulf and thereby increasing the probability and intensity of Iran–Gulf security incidents.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_gulf_conflict</data>
</edge>
<edge source="russia_ukraine_war::policy_uncertainty" target="us_china_tech_rivalry::policy_uncertainty_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Escalatory incidents or surprise sanctions in the Russia–Ukraine war create unpredictable sanction lists and emergency trade measures that cause market participants to increase their expectations of abrupt, disruptive US/ally tech-policy actions affecting US–China technology links.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::policy_uncertainty" target="us_political_shift::policy_regulatory_expect" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.8</data>
  <data key="d37">Escalation or unpredictable moves in the Russia–Ukraine war prompt US policymakers to announce or consider sanctions, export controls, defense spending increases and industrial-policy interventions, causing markets and stakeholders to raise expectations of more active and stringent regulation.</data>
  <data key="d38">0-6 months</data>
