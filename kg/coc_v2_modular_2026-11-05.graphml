<edge source="us_china_tech_rivalry::policy_uncertainty_level" target="global_ai_power_shift::risk_premium_levels" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Higher policy_uncertainty about potential sanctions, export bans or abrupt regulatory shifts raises the probability and expected severity of disruptive interventions, which investors price in as higher required returns and wider spreads, increasing risk premia on AI and tech assets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_ai_power_shift</data>
</edge>
