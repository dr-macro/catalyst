<edge source="iran_houthi_maritime::sanctions_policy_intensi" target="china_taiwan_grayzone::coercion_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Escalatory sanctions targeting maritime actors provoke retaliatory or preemptive disruptive maritime behavior and divert US/allied attention and assets, creating an operational window that China can exploit to increase gray‑zone coercive pressure on Taiwan.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_houthi_maritime</data>
  <data key="d39">china_taiwan_grayzone</data>
</edge>
<edge source="iran_houthi_maritime::sanctions_policy_intensi" target="eurozone_bond_stress::sovereign_credit_spreads" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalation of sanctions or aggressive policy measures tied to Iran/Houthi maritime incidents raises compliance and trade frictions for European firms and increases near‑term fiscal uncertainty (through higher subsidies, energy costs or trade disruption), leading investors to demand wider sovereign credit spreads for affected euro-area issuers.</data>
  <data key="d37">3-12 months</data>
  <data key="d38">iran_houthi_maritime</data>
  <data key="d39">eurozone_bond_stress</data>
</edge>
<edge source="iran_houthi_maritime::sanctions_policy_intensi" target="russia_ukraine_war::sanctions_evasion_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Escalation of targeted sanctions and enforcement against Iran/Houthi shipping incentivizes the expansion and refinement of concealment tactics (e.g., ship‑to‑ship transfers, opaque flags, broker networks) that increase the global rate at which sanctioned flows are routed around restrictions and can be adopted by other sanctioned actors.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_houthi_maritime</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_houthi_maritime::sanctions_policy_intensi" target="us_china_ai_rivalry::compute_supply_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.72</data>
  <data key="d36">Greater maritime-focused sanctions and secondary‑sanctions enforcement (inspections, port denials, carrier blacklisting) directly block or delay shipments of semiconductor fabrication equipment, test gear and datacenter hardware into China, reducing immediately allocable compute hardware capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_houthi_maritime</data>
  <data key="d39">us_china_ai_rivalry</data>
</edge>
