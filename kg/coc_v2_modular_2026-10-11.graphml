<edge source="china_taiwan_grayzone::investor_risk_premium" target="eurozone_bond_stress::auction_demand" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A rise in the geopolitical investor risk premium raises required yields for exposed assets and reduces investor willingness to place competitive bids, lowering order volumes and bid‑to‑cover ratios at eurozone debt auctions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_taiwan_grayzone</data>
  <data key="d39">eurozone_bond_stress</data>
</edge>
<edge source="china_taiwan_grayzone::investor_risk_premium" target="iran_houthi_maritime::shipping_risk_premium" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising investor risk premia tied to China‑Taiwan tensions contract capital and reinsurance capacity available to shipping firms, increasing financing and insurance costs which are passed through as higher shipping risk premiums for fuel transport in the Gulf/Red Sea.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_taiwan_grayzone</data>
  <data key="d39">iran_houthi_maritime</data>
</edge>
