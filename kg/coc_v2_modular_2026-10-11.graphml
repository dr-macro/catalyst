<edge source="russia_ukraine_war::sanctions_evasion_rate" target="china_taiwan_grayzone::defense_build_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Higher sanctions‑evasion success demonstrated in the Russia–Ukraine context reveals practical procurement routes, intermediary networks and component substitution techniques that China can adopt or replicate to accelerate acquisition and integration of restricted technologies, raising its defense build rate.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_taiwan_grayzone</data>
</edge>
<edge source="russia_ukraine_war::sanctions_evasion_rate" target="eurozone_bond_stress::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An uptick in sanctions‑evasion activity raises compliance and counterparty risk for correspondent banks and asset managers, causing them to curtail or reroute eurozone inbound and outbound capital flows to avoid exposure or fines.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">eurozone_bond_stress</data>
</edge>
