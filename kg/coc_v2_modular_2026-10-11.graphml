  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An observable rise in sanctions-evasion techniques linked to the Russia-Ukraine conflict incentivizes governments and coalitions to broaden and tighten enforcement and sanction regimes (including maritime measures) against networks perceived to use similar evasion channels involving Iran/Houthi-associated actors.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_houthi_maritime</data>
</edge>
