<edge source="iran_houthi_maritime::seaborne_tanker_transit" target="eurozone_bond_stress::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A drop in tanker transit from Houthi attacks or interdiction produces immediate energy import shortfalls and higher import bills for euro-area importers, prompting foreign investors to reduce exposures to affected sovereign and corporate assets and causing net capital outflows from the Eurozone.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_houthi_maritime</data>
  <data key="d39">eurozone_bond_stress</data>
</edge>
<edge source="iran_houthi_maritime::seaborne_tanker_transit" target="russia_ukraine_war::diesel_supply_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A fall in tanker transit volumes through Red Sea/Bab el-Mandeb chokepoints directly reduces deliveries of refined diesel and crude feedstocks from Middle Eastern exporters to global markets, lowering net diesel inflows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_houthi_maritime</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
