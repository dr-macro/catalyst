          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified military pressure and associated sanctions/export controls tied to the war push states and firms to reroute procurements toward alternative suppliers and hastily sourced components, raising the prevalence of unvetted or potentially compromised hardware within technology supply chains relevant to the U.S.–China rivalry." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
