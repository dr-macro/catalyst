        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising geopolitical sourcing risk (export controls, tech denial, or visible supply-chain decoupling) increases incentives for targeted coercive signaling and asymmetric attacks by states under pressure, prompting more frequent kinetic incidents around the Strait of Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_transformati" />
          <attvalue for="38" value="iran_hormuz_conflict" />
