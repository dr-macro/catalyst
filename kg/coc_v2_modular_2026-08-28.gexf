          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained spikes in Russian kinetic operations force NATO/US to reallocate surface and air assets to the European theatre, reducing forward naval and air patrol presence in the Persian Gulf and thereby lowering commercial maritime security." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_conflict" />
