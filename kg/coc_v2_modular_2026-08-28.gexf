          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising risk of escalation triggers emergency export controls, national stockpiling and supplier rationing (by governments and large customers), which immediately tightens availability and raises pressure on advanced chip supplies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_economic_transformati" />
