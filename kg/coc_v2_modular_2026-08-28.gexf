      <edge source="iran_hormuz_conflict::maritime_security" target="russia_ukraine_war::military_pressure_level" id="53">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A degradation in Persian Gulf maritime security forces Western (especially US/UK) naval assets to reallocate to Gulf/Indian Ocean protection, temporarily reducing deterrent posture or patrol density in the Black Sea/Eastern Europe and creating windows for increased Russian military activity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_conflict::maritime_security" target="us_china_tech_rivalry::compromised_hardware_rat" id="54">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Attacks, seizures and interdictions in the Strait of Hormuz force shippers to reroute, transship, or use third‑party brokers and fill gaps with rapid purchases from non‑vetted suppliers, increasing opportunities for physical tampering or insertion of compromised components into the global hardware flow." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_conflict" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_conflict::maritime_security" target="us_trade_coercion::policy_uncertainty_level" id="55">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Improved maritime security (escorts, deconfliction, reduced attacks) lessens pressure on policymakers to impose emergency trade restrictions or export controls, thereby reducing near‑term uncertainty among firms about future trade policy enforcement." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_conflict" />
          <attvalue for="38" value="us_trade_coercion" />
          <attvalue for="27" value="0" />
