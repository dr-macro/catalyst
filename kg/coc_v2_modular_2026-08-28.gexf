      <edge source="ai_economic_transformati::regulatory_restrictions" target="russia_ukraine_war::intel_sharing_rate" id="831">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter export controls and data‑flow/privacy regulations constrain cross‑border transfer of raw sensor data, models and processing tools, directly reducing the volume and speed of intelligence products exchanged between allies supporting Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_transformati" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_transformati::regulatory_restrictions" target="us_china_tech_rivalry::detection_attribution" id="832">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter cross‑border data and export restrictions reduce the volume and timeliness of forensic telemetry sharing and joint investigations, degrading detection coverage and the speed/accuracy of attribution." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_transformati" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_transformati::regulatory_restrictions" target="us_trade_coercion::policy_uncertainty_level" id="833">
