          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising assessed probability of broader conflict in the Russia–Ukraine theatre increases global perceived supply risk for oil and gas, which is immediately priced into markets as a higher energy geopolitical risk premium affecting shipments through Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
