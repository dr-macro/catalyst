          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A rising assessed probability of wider or spillover conflict causes firms and traders to expect abrupt new tariffs, export controls, and sanctions, sharply increasing uncertainty about future US trade policy directions." />
