          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A spike in kinetic incidents around Hormuz raises the risk of wider US‑Iran confrontation, prompting increased low‑visibility diplomatic contacts among Western capitals, Moscow, and Kyiv to manage spillover risks and deconflict across theatres." />
