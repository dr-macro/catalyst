      <edge source="us_trade_coercion::reciprocal_retaliation" target="iran_hormuz_conflict::maritime_security" id="642">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Intensified reciprocal trade countermeasures (sanctions, blacklisting, insurance restrictions) provoke Iranian retaliatory maritime actions—harassment, interdiction or seizures of commercial vessels—degrading safe passage through the Strait of Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_trade_coercion" />
          <attvalue for="38" value="iran_hormuz_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_coercion::reciprocal_retaliation" target="us_china_tech_rivalry::ai_attack_enhancement" id="643">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An uptick in reciprocal trade countermeasures signals geopolitical escalation and prompts state and state‑aligned actors to accelerate investment in automated, AI‑augmented offensive cyber capabilities as a lower‑cost leverage tool." />
          <attvalue for="36" value="6-18 months" />
