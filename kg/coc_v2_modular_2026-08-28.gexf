      <edge source="ai_economic_transformati::geopolitical_risk" target="russia_ukraine_war::backchannel_activity" id="848">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising geopolitical sourcing risk (threats to supply chains, sanctions risk) creates incentives for states and intermediaries to open low‑visibility negotiations and ad hoc trade/transfer arrangements to secure critical AI components and services, increasing backchannel diplomatic contacts relevant to the conflict environment." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_transformati" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
