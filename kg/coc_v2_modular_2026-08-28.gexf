          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Spikes in geopolitical sourcing risk (e.g., sudden sanctions risk or territorial tensions) prompt faster policy moves to adjust tariffs and trade barriers as governments attempt to secure supply or signal resolve, accelerating the pace of tariff changes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_transformati" />
