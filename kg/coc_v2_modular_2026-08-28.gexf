      <edge source="russia_ukraine_war::intel_sharing_rate" target="ai_economic_transformati::ai_investment_rate" id="278">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher volumes of shared intelligence revealing adversary capabilities and vulnerabilities prompt governments and defense contractors to accelerate funding and private firms to allocate capital to AI analytics, boosting the short-to-medium-term rate of AI investment." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_economic_transformati" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::intel_sharing_rate" target="iran_hormuz_conflict::kinetic_escalation" id="279">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Increased low‑visibility transfer of operational intelligence and targeting techniques from actors engaged in Ukraine accelerates recipient actors' ability to plan and execute maritime strikes and proxy kinetic actions in the Strait of Hormuz." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::intel_sharing_rate" target="us_china_tech_rivalry::detection_attribution" id="280">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Heightened intelligence sharing around the Russia–Ukraine war drives expanded exchange of cyber indicators, forensic techniques, and joint attribution reports among U.S. and allied agencies, which directly raises the capacity to detect and attribute intrusions tied to Chinese actors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::intel_sharing_rate" target="us_trade_coercion::reciprocal_retaliation" id="281">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher rates of actionable intelligence sharing allow the US to identify circumvention routes and specific entities for targeted trade measures, which in turn elicit more intense and frequent retaliatory trade countermeasures from affected states." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_trade_coercion" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
