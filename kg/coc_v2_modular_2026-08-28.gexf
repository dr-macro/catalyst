          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rapid increases in accessible AI compute enable faster, more automated processing of satellite, drone and SIGINT feeds (object detection, change detection, translation), producing higher volumes of actionable intelligence that partner services can share and act on." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_transformati" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
