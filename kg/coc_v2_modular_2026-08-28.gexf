      <edge source="iran_hormuz_conflict::maritime_security" target="ai_economic_transformati::chip_supply_pressure" id="52">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Improved maritime security reduces insurance costs, rerouting and transit delays for freight carrying advanced semiconductor modules and finished accelerator racks, easing logistical constraints and lowering supply pressure on advanced chips." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_conflict" />
