          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified military operations drive urgent procurement of accelerators and edge compute for weapon, ISR and command systems, diverting limited accelerator inventory away from commercial AI training and lowering available commercial AI compute capacity." />
