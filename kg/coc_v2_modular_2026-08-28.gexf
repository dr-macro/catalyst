          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rapid tightening or expansion of AI export controls and data‑flow regulations creates ambiguity about permissible cross‑border transactions and compliance costs, directly increasing firms' uncertainty about future trade policy." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_transformati" />
          <attvalue for="38" value="us_trade_coercion" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_transformati::regulatory_restrictions" target="us_trade_coercion::reciprocal_retaliation" id="834">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Introduction or expansion of unilateral AI‑related export controls and compliance rules provokes affected trade partners to respond with countermeasures (tariffs, restrictions or targeted sanctions), increasing the intensity and frequency of reciprocal retaliation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_transformati" />
          <attvalue for="38" value="us_trade_coercion" />
          <attvalue for="27" value="0" />
