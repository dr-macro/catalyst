      <edge source="global_financial_turmoil::cross_asset_volatility" target="russia_ukraine_war::mediation_activation" id="703">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Acute spikes in cross‑asset volatility raise systemic‑risk concerns among major powers and financial policymakers, prompting third‑party actors and envoys to initiate or intensify mediation to calm markets and reduce geopolitical risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_turmoil" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
