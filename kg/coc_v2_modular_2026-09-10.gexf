      <edge source="israel_palestine_flashpo::escalation_risk_perc" target="russia_ukraine_war::mediation_activation" id="525">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising perceived risk of wider regional escalation in the Israel–Palestine flashpoint motivates major mediators (US, EU, UN) to increase envoy activity across multiple theaters, including stepped-up mediation efforts around Russia–Ukraine, to prevent simultaneous crises." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_palestine_flashpo" />
          <attvalue for="38" value="russia_ukraine_war" />
