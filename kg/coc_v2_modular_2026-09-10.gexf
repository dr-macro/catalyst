          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Escalating geopolitical tensions trigger asymmetric capital flows and sanction/fear‑driven reallocations into safe‑haven currencies while weighing on currencies of countries exposed to China‑US friction, increasing cross‑currency dispersion." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="global_financial_turmoil" />
