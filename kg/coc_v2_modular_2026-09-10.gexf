      <edge source="israel_palestine_flashpo::sanction_severity" target="global_financial_turmoil::sovereign_credit_spreads" id="473">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sharper, broader sanctions raise compliance costs and counterparty risk for banks and insurers with exposure to affected states and trading partners, prompting immediate re-pricing of sovereign exposure and wider credit spreads for those sovereigns." />
