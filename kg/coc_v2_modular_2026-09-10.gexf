      <edge source="russia_ukraine_war::violence_intensity" target="global_financial_turmoil::cross_asset_volatility" id="195">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Sudden battlefield escalations trigger immediate risk‑off reallocations, margin calls and rapid repricing of energy, commodity and equity exposures, spiking realized and implied volatility across asset classes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="global_financial_turmoil::market_liquidity" id="196">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sharp increases in kinetic activity cause dealers and principal market makers to pull back, widen quotes and reduce committed inventories amid higher execution risk, degrading market depth and resiliency." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="global_financial_turmoil::currency_dispersion" id="197">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalation in hostilities produces asymmetric country exposures and safe‑haven flows (into USD/CHF/JPY and away from regional/commodity currencies), increasing cross‑currency deviations from typical baselines." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="israel_palestine_flashpo::escalation_risk_perc" id="198">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A sharp uptick in Russian kinetic operations leads Moscow to deepen arms, intelligence and diplomatic support to regional partners (e.g., Iran, Syria), which increases material and strategic backing available to Palestinian militants and thereby raises stakeholders' perceived probability of wider regional escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="israel_palestine_flashpo" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="israel_palestine_flashpo::sanction_severity" id="199">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Major Russian escalations prompt Western governments to expand and harden sanctions and export‑control toolkits; those expanded authorities and precedents make it more likely that policymakers will apply stricter punitive measures to companies and actors linked to settlements." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="israel_palestine_flashpo" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="us_china_rivalry::export_control_level" id="200">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Spikes in Russian battlefield violence precipitate broader Western sanctions and an accelerated, coordinated development and enforcement of technology export controls (building legal and political precedents and enforcement networks) that the US then extends or cites in tightening controls on sensitive exports to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="us_china_rivalry::semiconductor_investment" id="201">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained high-intensity conflict raises supply‑chain and energy risk, prompting governments to accelerate subsidies and incentives for allied on‑shore/near‑shore fabs and for firms to re‑route capital away from riskier geographies, thereby boosting semiconductor investment flows into US/EU allied capacity relative to China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="us_iran_gulf_conflict::global_oil_price" id="202">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Large increases in battlefield attacks and strikes that damage export infrastructure and constrain Russian seaborne and pipeline deliveries produce immediate supply loss and forward-coverage concerns, driving benchmark crude prices up." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="us_iran_gulf_conflict::oil_market_risk_premium" id="203">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Escalating kinetic activity and the prospect of further disruption to Black Sea/Western supply routes raise market perceptions of geopolitical supply risk, increasing the risk premium demanded by traders and producers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::violence_intensity" target="us_iran_gulf_conflict::chokepoint_transit_vol" id="204">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified naval/air operations, mine‑laying and port closures in the Black Sea force tankers to suspend sailings or be rerouted away from the Turkish Straits, lowering volume through that chokepoint." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
