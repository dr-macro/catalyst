      <edge source="global_financial_turmoil::cross_asset_volatility" target="israel_palestine_flashpo::media_scrutiny_intensity" id="702">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sharp increases in cross-asset volatility drive financial and mainstream outlets to hunt for proximate geopolitical drivers, thereby raising the volume and prominence of coverage linking Israel–Palestine developments to market risk and sanctions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_turmoil" />
          <attvalue for="38" value="israel_palestine_flashpo" />
          <attvalue for="27" value="0" />
        </attvalues>
