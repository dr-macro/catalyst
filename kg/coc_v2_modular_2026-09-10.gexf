          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher geopolitical friction raises counterparty and regulatory risk, inducing market‑makers and prime brokers to reduce inventories and widen spreads, materially degrading market depth and resiliency." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="global_financial_turmoil" />
