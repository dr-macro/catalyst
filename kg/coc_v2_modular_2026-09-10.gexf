          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Spikes in cross-asset volatility raise perceived near-term supply/demand and counterparty risks among traders and refiners, prompting market participants and funds to price an additional supply-disruption premium into oil contracts." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_turmoil" />
