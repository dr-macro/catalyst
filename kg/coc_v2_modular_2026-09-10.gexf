          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="An increase in systemic US–China geopolitical tension raises stakeholders' belief that a local Israel–Palestine incident could draw in or be exploited by great powers, directly elevating perceived risk of wider escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="israel_palestine_flashpo" />
