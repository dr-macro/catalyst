      <edge source="us_iran_gulf_conflict::military_escalation_leve" target="global_financial_turmoil::cross_asset_volatility" id="367">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rise in kinetic operations and retaliation increases immediate geopolitical risk perceptions, prompting rapid risk‑off flows, option buying and mark‑to‑market repricing across equities, bonds, FX and commodities, spiking realized and implied volatility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="global_financial_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
