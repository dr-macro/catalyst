      <edge source="israel_palestine_flashpo::escalation_risk_perc" target="us_china_rivalry::geo_tension_level" id="527">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising perception of regional escalation triggers accelerated military deployments, alliance consultations and public diplomatic posturing by the US and China, quickly increasing systemic geopolitical friction." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_palestine_flashpo" />
          <attvalue for="38" value="us_china_rivalry" />
