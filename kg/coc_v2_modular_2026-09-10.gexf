          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Higher perceived probability of broader escalation hardens domestic political postures and threat perceptions among principals and their constituencies, reducing leaders' readiness in Kyiv or Moscow to accept compromises or enter talks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="israel_palestine_flashpo" />
          <attvalue for="38" value="russia_ukraine_war" />
