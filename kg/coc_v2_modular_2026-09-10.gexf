      <edge source="us_iran_gulf_conflict::military_escalation_leve" target="global_financial_turmoil::market_liquidity" id="368">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher intensity of military actions raises counterparty risk and margin volatility, causing market‑makers and banks to pull back, widen spreads and reduce depth, thereby degrading liquidity across traded markets." />
          <attvalue for="36" value="0-3 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="global_financial_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::military_escalation_leve" target="israel_palestine_flashpo::escalation_risk_perc" id="369">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="An uptick in kinetic US–Iran/Gulf operations raises assessments by governments, mediators and publics that localized incidents could cascade into wider regional war, directly increasing perceived escalation risk around the Israel–Palestine flashpoint." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="israel_palestine_flashpo" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::military_escalation_leve" target="israel_palestine_flashpo::diplomatic_reciprocity" id="370">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="High-profile clashes force external states to make public diplomatic choices (condemnations, downgrades, envoy moves) tied to their positions on US/Iran actions, prompting reciprocal diplomatic measures between those external actors and parties in the Israel–Palestine arena." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="israel_palestine_flashpo" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::military_escalation_leve" target="russia_ukraine_war::violence_intensity" id="371">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained kinetic escalation in the Gulf forces US/NATO to redeploy naval/air assets and strain munitions/ISR surge capacity, reducing the tempo and quality of battlefield support to Ukraine and thereby permitting higher Russian offensive activity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::military_escalation_leve" target="russia_ukraine_war::mediation_activation" id="372">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="High-intensity Gulf fighting absorbs diplomatic bandwidth and envoy time in Washington and major European capitals, reducing the frequency and intensity of third‑party mediation initiatives directed at the Russia–Ukraine conflict." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::military_escalation_leve" target="us_china_rivalry::geo_tension_level" id="373">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Spikes in US‑Iran military activity (naval clashes, strikes, proxy attacks) prompt reciprocal diplomatic/military posturing by the US and China (naval deployments, public condemnations, alliance signaling), directly raising systemic US–China geopolitical tension." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::military_escalation_leve" target="us_china_rivalry::export_control_level" id="374">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Intensified military escalation in the Gulf leads US policymakers to broaden and tighten export controls and licensing (citing national security and diversion risks) on technologies and dual‑use items potentially usable by actors in the conflict, and to press partners for similar restrictions vis‑à‑vis China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
