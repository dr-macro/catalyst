<edge source="middle_east_chokepoints::maritime_attack_freq" target="ai_governance::investment_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A spike in attacks causes immediate port closures, shipping delays and higher insurance for high-value hardware shipments (GPUs, racks), prompting investors and operators to postpone or cancel capital-intensive AI infrastructure deployments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_chokepoints</data>
  <data key="d39">ai_governance</data>
</edge>
