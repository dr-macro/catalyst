  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Direct strikes on production, refining or storage physically remove barrels from available supply and raise near‑term supply‑risk premia in crude markets, driving benchmark oil prices up.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_finance_shift</data>
</edge>
<edge source="russia_ukraine_war::energy_strike_rate" target="middle_east_chokepoints::oil_export_flow" id="0">
