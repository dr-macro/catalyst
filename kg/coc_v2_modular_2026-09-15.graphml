<edge source="russia_ukraine_war::energy_strike_rate" target="ai_governance::safety_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Attacks on energy infrastructure disrupt power/communications and force reallocation of technical staff and budgets to emergency restoration, degrading organizations' ability to operate and maintain AI safety monitoring and mitigation systems.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_governance</data>
