<edge source="tech_supply_divide::ai_compute_demand" target="ai_governance::regulatory_stringency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Sharp increases in observable demand for high-end compute (GPU/TPU orders, datacenter capacity bids) trigger policymakers to introduce or tighten export controls, procurement restrictions, and mandatory oversight of compute-intensive training to limit dual‑use risks.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">tech_supply_divide</data>
  <data key="d39">ai_governance</data>
</edge>
