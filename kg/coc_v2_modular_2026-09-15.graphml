  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A surge in attacks on commercial shipping lifts freight and insurance costs and triggers near-term energy and consumer-price rises, causing markets to revise upward expected central-bank tightening.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_chokepoints</data>
  <data key="d39">global_finance_shift</data>
</edge>
<edge source="middle_east_chokepoints::maritime_attack_freq" target="russia_ukraine_war::energy_price_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A spike in hostile incidents against ships in regional chokepoints raises insurance and rerouting costs, creates immediate physical and logistical bottlenecks for oil and refined product shipments, and thereby increases near‑term energy price and supply pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_chokepoints</data>
  <data key="d39">russia_ukraine_war</data>
