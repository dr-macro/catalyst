<edge source="tech_supply_divide::cloud_utilization" target="ai_governance::incident_frequency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher multi‑tenant cloud utilization increases surface area for misconfiguration, noisy‑neighbor failures, and lateral escalation, which directly raises the short‑term rate of outages, data exposures and abuse events involving deployed models.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">tech_supply_divide</data>
  <data key="d39">ai_governance</data>
</edge>
<edge source="tech_supply_divide::cloud_utilization" target="global_finance_shift::long_term_govt_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.58</data>
  <data key="d36">A jump in cloud utilization that substitutes for firms' own hardware investment reduces aggregate corporate capex and long‑dated borrowing needs, weakening demand for credit and placing modest downward pressure on long-term sovereign yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">tech_supply_divide</data>
  <data key="d39">global_finance_shift</data>
</edge>
<edge source="tech_supply_divide::cloud_utilization" target="russia_ukraine_war::border_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Higher cloud capacity utilization by military and intelligence users supports near‑real‑time geospatial data processing and shared situational awareness, reducing misidentification and uncoordinated movements that lead to cross‑border armed incidents.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">tech_supply_divide</data>
  <data key="d39">russia_ukraine_war</data>
