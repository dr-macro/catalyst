<edge source="opec_energy_volatility::crude_oil_price" target="china_eu_tech_rivalry::ai_asset_price_volatilit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.65</data>
  <data key="d37">Sharp crude price swings transmit to equity and currency markets and to risk premia on growth sectors, amplifying trading volatility and revaluations of AI‑exposed firms and instruments in China and EU markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">opec_energy_volatility</data>
  <data key="d40">china_eu_tech_rivalry</data>
</edge>
<edge source="opec_energy_volatility::crude_oil_price" target="japan_fx_bond_stress::policy_rate_expectations" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">A sharp rise in crude prices increases Japan's imported inflation outlook, leading markets to price a sooner and larger BOJ tightening and thus to higher policy-rate expectations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">opec_energy_volatility</data>
  <data key="d40">japan_fx_bond_stress</data>
</edge>
<edge source="opec_energy_volatility::crude_oil_price" target="japan_fx_bond_stress::long_term_yield_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">An oil-price spike lifts inflation expectations and global term premia, which transmits into higher long-dated JGB yields via higher expected future inflation and increased hedging costs even if short-term policy is unchanged.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">opec_energy_volatility</data>
  <data key="d40">japan_fx_bond_stress</data>
</edge>
<edge source="opec_energy_volatility::crude_oil_price" target="rus_ukr_war::cross_border_strike_rate" id="0">
