<edge source="us_iran_confront::oil_price_level" target="china_eu_tech_rivalry::ai_capital_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A sustained jump in oil prices increases operating and inflationary pressures for firms and tightens financing conditions, leading investors to reduce allocation to higher‑burn AI startups and slow new AI investment commitments.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">china_eu_tech_rivalry</data>
</edge>
<edge source="us_iran_confront::oil_price_level" target="japan_fx_bond_stress::policy_rate_expectations" id="0">
