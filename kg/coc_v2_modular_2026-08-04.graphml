  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A sustained rise in oil prices lifts imported inflation expectations in Japan, leading market participants to mark up the expected path and timing of BoJ tightening (earlier/higher policy-rate pricing).</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">japan_fx_bond_stress</data>
</edge>
