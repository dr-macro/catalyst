<edge source="us_iran_confront::mil_escalation_threat" target="china_eu_tech_rivalry::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A marked uptick in US–Iran military escalation leads EU and Chinese regulators to fast‑track and broaden AI rules and export controls on dual‑use technologies because policymakers cite immediate national‑security risks, raising the intensity and scope of scrutiny within weeks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">china_eu_tech_rivalry</data>
</edge>
<edge source="us_iran_confront::mil_escalation_threat" target="china_eu_tech_rivalry::ai_capital_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Heightened military confrontation raises geopolitical risk premia and investor risk aversion, causing venture and institutional investors to pull back or delay cross‑border AI funding rounds in China and the EU.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">china_eu_tech_rivalry</data>
</edge>
<edge source="us_iran_confront::mil_escalation_threat" target="opec_energy_volatility::military_engagement_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Rising credible threats and posturing increase the probability of preemptive or retaliatory strikes and miscalculation-driven exchanges between forces in the theatre, raising the frequency and intensity of kinetic engagements.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">opec_energy_volatility</data>
</edge>
<edge source="us_iran_confront::mil_escalation_threat" target="opec_energy_volatility::maritime_transit_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Heightened military threat prompts naval interdictions, exclusion zones, harassment of commercial vessels and more aggressive rules of engagement around chokepoints, directly increasing the likelihood that merchant shipping will be attacked, detained or rerouted.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">opec_energy_volatility</data>
