      <edge source="western_alliance_realign::diplomatic_alignment" target="middle_east_energy::military_deployment" id="646">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A shift toward closer diplomatic alignment with regional partners typically triggers basing agreements, joint exercises and explicit security commitments that lead to faster redeployment or augmentation of allied forces in the Middle East." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="middle_east_energy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::diplomatic_alignment" target="russia_ukraine_war::alliance_cohesion_level" id="647">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter diplomatic alignment with a foreign union produces synchronized positions, sanctions and public messaging that directly raise political and operational unity among security partners responding to Russia's actions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::diplomatic_alignment" target="space_weapons_race::counterspace_capability_" id="648">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Deeper diplomatic alignment produces formal intelligence‑sharing agreements, combined operational planning and authorized technology transfer that accelerate joint development and fielding of counterspace systems." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::diplomatic_alignment" target="us_china_tech_rivalry::regulatory_restrictions" id="649">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Closer diplomatic alignment among Western partners produces coordinated policy decisions (joint statements, synchronized sanctions and shared export‑control lists) that directly raise the intensity and scope of regulatory restrictions on sensitive tech flows to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
