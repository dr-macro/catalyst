      <edge source="russia_ukraine_war::drone_attack_rate" target="middle_east_energy::insurance_premium_avail" id="189">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A higher rate of drone attacks in the Russia–Ukraine war increases insurer perception of unmanned‑weapon threats and the likelihood of similar attacks on ships and coastal energy facilities, driving up premiums and exclusions for regional energy shipments." />
