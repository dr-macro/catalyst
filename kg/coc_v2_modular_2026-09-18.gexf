      <edge source="space_weapons_race::space_defense_production" target="middle_east_energy::military_deployment" id="538">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained increases in space‑defense production generate deliveries, training needs, and basing/logistics requirements that drive additional forward deployments, advisors, and force rotations into the Middle East to operate and protect new systems." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="space_weapons_race" />
          <attvalue for="38" value="middle_east_energy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="space_weapons_race::space_defense_production" target="russia_ukraine_war::arms_flow_rate" id="539">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rapid ramp‑up in production of space‑defense systems reallocates industrial capacity, skilled labor and budgetary priority away from conventional munitions and platforms, slowing the tempo and volume of arms deliveries to the Ukraine theater." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="space_weapons_race" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
