      <edge source="russia_ukraine_war::alliance_cohesion_level" target="space_weapons_race::launch_cadence" id="240">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter political and operational unity among security partners leads to coordinated replenishment and resilience programs for military and dual‑use constellations, pooled launch contracts and prioritized access to launch ranges, raising the allied launch tempo." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="space_weapons_race" />
