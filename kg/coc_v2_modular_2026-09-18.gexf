      <edge source="western_alliance_realign::regulatory_alignment" target="middle_east_energy::insurance_premium_avail" id="726">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Closer regulatory alignment with sanctioning or enhanced-risk standards forces insurers and reinsurers to withdraw or limit coverage for clients and routes that fail new compliance thresholds, raising premiums and reducing availability for Middle Eastern energy shipments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="middle_east_energy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::regulatory_alignment" target="russia_ukraine_war::drone_attack_rate" id="727">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Harmonizing technical and dual‑use regulatory standards reduces barriers to cross‑border transfers and commercial sourcing of drone components, expanding supply chains and raising the rate at which unmanned systems are fielded in the conflict over the medium term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::regulatory_alignment" target="space_weapons_race::launch_cadence" id="728">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Harmonization of export controls, licensing and safety standards removes cross‑border bureaucratic delays for satellite exports and foreign launches, shortening approval timelines and enabling more frequent launches." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::regulatory_alignment" target="us_china_tech_rivalry::advanced_chip_capacity" id="729">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Harmonization of regulatory standards across Western states (including aligned export controls and licensing rules) directly reduces Chinese firms' ability to procure specialized equipment and IP, slowing the growth of China's advanced semiconductor production capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="us_china_tech_rivalry" />
