      <edge source="middle_east_energy::military_deployment" target="russia_ukraine_war::alliance_cohesion_level" id="78">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A marked uptick in Western or regional force deployments to the Middle East diverts assets, political attention and diplomatic bandwidth, precipitating disputes among NATO/EU partners over burden‑sharing and timelines and thereby reducing cohesion on Russia‑Ukraine policy and responses." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::military_deployment" target="space_weapons_race::counterspace_capability_" id="79">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sustained increases in regional force deployments create operational requirements for space‑control and protection of theater assets, prompting accelerated procurement and testing of counterspace systems (jammers, directed‑energy, kinetic ASATs) to deny adversary ISR and communications." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::military_deployment" target="space_weapons_race::launch_cadence" id="80">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher deployment intensity generates urgent demand for theater‑specific EO/ISR and resilient communications capacity and for rapid replacement of degraded satellites, driving more taskings of commercial launch providers and short‑term increases in launch cadence." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::military_deployment" target="us_china_tech_rivalry::geo_tension_level" id="81">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A surge in deployed military forces and operations by external powers in the Middle East produces direct diplomatic incidents, competing naval/air activity, and operational friction between the United States and China (over access, escorts, and regional influence), raising bilateral geopolitical tension." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::military_deployment" target="western_alliance_realign::diplomatic_alignment" id="82">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rapid increase in regional military deployments by Middle Eastern actors or external powers triggers expedited allied consultations and coordinated diplomatic positioning within the Western union (public statements, joint démarches, and unified policy demands) to present a common stance, raising measurable diplomatic alignment." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
