      <edge source="us_china_tech_rivalry::advanced_chip_capacity" target="space_weapons_race::space_defense_production" id="332">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An increase in available advanced semiconductor capacity eases a key bottleneck for manufacturing radios, guidance units, ASICs and phased-array components, allowing existing space-defense production lines to increase output without redesign." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
