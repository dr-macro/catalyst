        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Improved institutional integration capacity streamlines export licensing, joint procurement and cross‑border logistics, which directly speeds up and increases the volume of weapons, ammunition and equipment deliveries into the Ukraine conflict zone." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="russia_ukraine_war" />
