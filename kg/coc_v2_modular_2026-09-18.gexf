          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increased flows of weapons and munitions emerging from the conflict empower militias and non‑state actors in the Middle East to conduct more frequent sabotage and attacks on pipelines, terminals and loading infrastructure, degrading physical export capacity." />
          <attvalue for="36" value="6-18 months" />
