          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher government procurement and production of space‑grade defense systems creates guaranteed demand and procurement subsidies that directly incentivize foundries and firms to expand or requalify advanced semiconductor manufacturing capacity domestically." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="space_weapons_race" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
