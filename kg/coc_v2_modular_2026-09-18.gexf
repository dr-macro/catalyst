          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Improved institutional integration enables coordinated procurement, consolidated contracts and shared production lines among partners, rapidly scaling manufacture and delivery rates of space‑relevant defense hardware." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
