          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="More advanced chips enable higher-performance on-board processing, EW payloads and seeker/GPS-denied guidance in new or upgraded platforms, directly raising the effective counterspace capabilities fielded." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
