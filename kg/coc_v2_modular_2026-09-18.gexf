      <edge source="middle_east_energy::insurance_premium_avail" target="russia_ukraine_war::arms_flow_rate" id="67">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Sharp increases in marine and cargo insurance premiums or withdrawal of cover for routes near Middle East hotspots raises transport costs and risk for maritime and multimodal shipments of weapons and munitions to Ukraine, leading to measurable delays or reductions in the tempo of arms deliveries." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::insurance_premium_avail" target="us_china_tech_rivalry::tech_capital_inflow_rate" id="68">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A rise in marine/cargo insurance premiums or a drop in insurance availability for energy and shipping routes materially raises perceived logistics and project risk for semiconductor supply chains, reducing investors' willingness to commit cross-border capital into tech manufacturing and fabs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::insurance_premium_avail" target="western_alliance_realign::integration_capacity" id="69">
