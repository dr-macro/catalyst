          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="An increase in counterspace capabilities (jamming, RF denial, and ASAT operations) directly degrades satellite navigation and datalinks that many Ukrainian and Russian UAS depend on, reducing effective launches and on‑target employment of drones." />
