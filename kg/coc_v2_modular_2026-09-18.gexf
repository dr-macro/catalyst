          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher military deployment intensity in the Middle East prompts Western states to coordinate export controls, sanctions lists and energy security regulations, accelerating harmonization of regulatory measures with the union's external standards." />
