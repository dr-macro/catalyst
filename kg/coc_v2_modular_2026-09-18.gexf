          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Documented increases in cross‑border arms transfers that involve or transit through Chinese-linked suppliers lead US regulators to impose targeted export controls and tightened licensing on dual‑use components and supply‑chain actors tied to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::arms_flow_rate" target="western_alliance_realign::integration_capacity" id="229">
