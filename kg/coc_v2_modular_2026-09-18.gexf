      <edge source="middle_east_energy::chokepoint_accessibility" target="russia_ukraine_war::energy_supply_disruption" id="38">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A significant loss of throughput at key Middle East chokepoints (e.g., Bab el‑Mandeb or Suez delays) directly constrains tanker routing and delivery capacity for fuels and refined products destined for Europe and Ukraine, causing immediate physical interruptions and shortages." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::chokepoint_accessibility" target="space_weapons_race::launch_cadence" id="39">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute reductions in maritime chokepoint accessibility spur states and commercial actors to deploy additional maritime‑domain awareness and redundant communications satellites to bypass disrupted surface links, increasing demand for smallsat deployments and near‑term launch activity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::chokepoint_accessibility" target="us_china_tech_rivalry::advanced_chip_capacity" id="40">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved accessibility and throughput at major maritime chokepoints lowers shipment risk and lead times for critical semiconductor inputs and equipment, making planned overseas fab buildouts and supply-dependent expansions more viable and increasing installed advanced-chip capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="middle_east_energy" />
