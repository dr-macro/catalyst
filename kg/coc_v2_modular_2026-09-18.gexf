      <edge source="russia_ukraine_war::arms_flow_rate" target="space_weapons_race::space_defense_production" id="227">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A surge in cross‑border arms transfers includes dual‑use components and creates demand for space‑capable sensors, EW pods and satellite survivability gear, incentivizing defense contractors to retool and raise production rates for space‑relevant systems." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::arms_flow_rate" target="us_china_tech_rivalry::regulatory_restrictions" id="228">
        <attvalues>
