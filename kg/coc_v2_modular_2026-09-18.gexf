      <edge source="us_china_tech_rivalry::advanced_chip_capacity" target="russia_ukraine_war::drone_attack_rate" id="331">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A fall in available advanced semiconductor production (domestic or accessible via trade) reduces the supply of flight‑control, guidance and sensor chips that Russia relies on, degrading procurement and repair of UAVs and thereby reducing the rate of drone attacks." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
