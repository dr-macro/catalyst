          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Higher numbers and concentration of orbital weapons raise the probability of kinetic tests/engagements and debris generation that disrupt earth‑observation, weather and communications satellites used for grid and pipeline monitoring, increasing interruptions to energy production and distribution." />
