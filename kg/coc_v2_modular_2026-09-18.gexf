      <edge source="middle_east_energy::fuel_price_level" target="russia_ukraine_war::military_engagement" id="61">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in global oil and fuel prices driven by Middle East market pressure increases Russian energy export revenue and fiscal room, enabling higher operational tempo and sustainment of combat operations in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_energy::fuel_price_level" target="western_alliance_realign::trade_tension_partner" id="62">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in global fuel prices driven by disruptions in Middle Eastern energy markets increases import costs for major Western trading partners, provoking tariffs, emergency trade measures or disputes over contracts that manifest as increased bilateral trade tension." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_energy" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="27" value="0" />
