      <edge source="space_weapons_race::counterspace_capability_" target="middle_east_energy::insurance_premium_avail" id="525">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rapid increase in counterspace capabilities raises insurers' assessed risk of GNSS/comm outages and deliberate targeting of space-enabled maritime and energy systems, causing insurers to raise premiums and restrict coverage for shipments and facilities." />
