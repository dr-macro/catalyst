      <edge source="russia_ukraine_war::military_engagement" target="middle_east_energy::military_deployment" id="176">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalation in Russia's military engagement prompts NATO, allied navies and regional powers to redeploy ships, aircraft and expeditionary forces to the Middle East to reassure partners and deter spillover, increasing regional force deployment intensity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="middle_east_energy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_engagement" target="space_weapons_race::counterspace_capability_" id="177">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="High‑intensity and visible battlefield use of space‑enabled ISR, targeting and comms in the Russia–Ukraine conflict prompts defense ministers to fast‑track funding and procurement of electronic warfare, satellite‑jamming, cyber and kinetic counterspace programs to deny adversary space support." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_engagement" target="us_china_tech_rivalry::geo_tension_level" id="178">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A marked increase in kinetic operations widens perceptions of systemic instability and prompts faster, more adversarial strategic posturing by the US and China, raising bilateral geopolitical tension." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_engagement" target="western_alliance_realign::diplomatic_alignment" id="179">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Escalations in Russian kinetic operations raise threat perceptions among nearby and like‑minded states, driving them to publicly align diplomatically with the Western political‑economic union for security and sanctions coordination." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
