      <edge source="western_alliance_realign::trade_tension_partner" target="middle_east_energy::fuel_price_level" id="631">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating trade frictions or sanctions between Western actors and a major energy supplier raise transaction costs and can directly restrict exports or chartering options, tightening supply and pushing up global fuel prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="middle_east_energy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::trade_tension_partner" target="russia_ukraine_war::energy_supply_disruption" id="632">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Escalating trade frictions (tariffs, export controls or sanctions) with a major energy exporter provoke retaliatory cuts, transit restrictions or market disruptions that materially interrupt regional energy deliveries tied to the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::trade_tension_partner" target="space_weapons_race::launch_cadence" id="633">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating trade tensions trigger tariffs, export restrictions and supplier exclusions that immediately disrupt supply chains for rocket components and launch services, reducing launch frequency." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="space_weapons_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::trade_tension_partner" target="us_china_tech_rivalry::tech_capital_inflow_rate" id="634">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising trade friction with a major partner raises political and commercial risk for investments in that partner's tech sector and prompts investors and governments to reallocate equity and subsidy flows toward domestic/allied semiconductor and tech projects, increasing capital inflows to rival (Western) tech ecosystems." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="western_alliance_realign" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
