          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Visible tests or deployments of counter‑space systems directly increase perceived vulnerability of national C4ISR and communications satellites, provoking accelerated diplomatic escalation, threat declarations, and crisis signalling between the US and China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="space_weapons_race" />
          <attvalue for="38" value="us_china_tech_rivalry" />
