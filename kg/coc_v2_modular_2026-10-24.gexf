          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising reciprocal mistrust prompts firms and platform operators to halt or delay cross‑border AI rollouts and data‑sharing arrangements with counterpart firms in adversary states, reducing the speed of AI service deployments in contested markets." />
