          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A spike in kinetic operations raises global risk aversion and prompts institutional and retail investors to reallocate into high-quality liquid assets (e.g., US Treasuries, German bunds), increasing safe-haven demand." />
