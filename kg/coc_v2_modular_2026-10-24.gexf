          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Heightened regulatory investigations and export licensing of space‑communications hardware and ground systems triggers more export controls, customs checks and de‑risking by suppliers, producing immediate delays and substitution in overlapping AI hardware and component supply chains." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="space_comm_governance" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
