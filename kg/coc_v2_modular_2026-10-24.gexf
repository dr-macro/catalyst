          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising reciprocal mistrust among states increases perceived geopolitical and counterparty risk, causing institutional investors and governments to delay or withdraw funding from large cross-border space-communications projects and reallocate capital to lower-risk alternatives." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="39" value="space_comm_governance" />
          <attvalue for="28" value="0" />
        </attvalues>
