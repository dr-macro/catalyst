          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Public political pressure or explicit requests to providers to block or restrict services to one party provokes that party to mount covert cyber and physical operations against provider infrastructure and supply chains to restore capability or retaliate, raising sabotage and espionage incidents." />
          <attvalue for="37" value="0-6 months" />
