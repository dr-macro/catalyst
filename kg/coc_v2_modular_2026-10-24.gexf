          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sharp rise in kinetic operations around the Black Sea and adjacent maritime approaches increases attacks/insurance costs and forces tankers to reroute via Suez/Red Sea or reduce sailings, producing congestion and port/backlog pressures in Middle Eastern transit corridors." />
          <attvalue for="37" value="0-6 months" />
