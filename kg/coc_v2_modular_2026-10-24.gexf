          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Heightened export controls and component shortages tied to US–China tech rivalry make legal procurement of advanced chips and sensors harder for Russian forces and proxies, incentivizing theft, clandestine procurement networks and sabotage of supply nodes to obtain or disrupt hardware." />
          <attvalue for="37" value="0-6 months" />
