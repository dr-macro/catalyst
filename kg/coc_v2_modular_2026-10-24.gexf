          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tightened export controls, licensing reviews, or investigatory actions around space-communications services create cross-border commercial disputes and service access problems that compel states and intermediaries to enter diplomatic negotiations to resolve access, exemptions, or sanctions implications." />
          <attvalue for="37" value="0-6 months" />
