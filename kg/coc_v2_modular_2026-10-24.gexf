          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A spike in kinetic operations and visible battlefield use of dual‑use technologies triggers immediate national security reviews and rapid expansion of export controls and oversight regimes that tighten AI‑related regulation affecting US–China tech interactions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="39" value="us_china_tech_rivalry" />
