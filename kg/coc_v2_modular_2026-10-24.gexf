      <edge source="western_bond_volatility::sovereign_bond_yield" target="us_china_tech_rivalry::capital_flow_to_ai" id="591">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising sovereign yields raise the risk‑free return and discount rates, compressing valuations and making long‑horizon, capital‑intensive AI investments less attractive so investors scale back funding into AI projects." />
