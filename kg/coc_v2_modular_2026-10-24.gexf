          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Heightened regulatory investigations or license suspensions of satellite communications providers can cause temporary outages or capacity reductions for maritime comms/AIS services, producing immediate increases in route miscoordination and port/terminal delays." />
