          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Improved reliability of commercial and hybrid satcom for military use shortens ISR-to-shooter cycles and sustainment of forward formations, enabling higher-tempo offensive and counter-fire operations that increase aggregate kinetic activity." />
          <attvalue for="37" value="0-6 months" />
