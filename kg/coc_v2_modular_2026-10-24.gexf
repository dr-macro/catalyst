          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rise in sovereign yields increases the domestic cost of capital and required returns, causing institutional and bank lenders to cut or reprioritize long‑horizon commitments to large tech/space‑communications projects." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_bond_volatility" />
          <attvalue for="39" value="space_comm_governance" />
          <attvalue for="28" value="0" />
