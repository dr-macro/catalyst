      <edge source="space_comm_governance::capital_allocation_rate" target="mid_east_energy::shipping_bottleneck_inde" id="767">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher rates of capital committed to space and communications projects expand satellite-based vessel tracking and broadband backhaul capacity, enabling better traffic management and reducing maritime congestion and port turnaround times." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="space_comm_governance" />
          <attvalue for="39" value="mid_east_energy" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="space_comm_governance::capital_allocation_rate" target="us_china_tech_rivalry::capital_flow_to_ai" id="768">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained increase in capital directed into large space‑communications projects diverts venture and corporate funding pools and balance‑sheet commitments away from AI buildouts, reducing net new investment into AI in the near term as LPs and corporates re‑allocate to meet space project cash needs." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="space_comm_governance" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="space_comm_governance::capital_allocation_rate" target="western_bond_volatility::sovereign_bond_yield" id="769">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained increase in capital allocated to large domestic space/communications projects diverts institutional and private savings away from sovereign bonds, reducing demand and pushing long-term sovereign yields higher." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="space_comm_governance" />
          <attvalue for="39" value="western_bond_volatility" />
          <attvalue for="28" value="0" />
