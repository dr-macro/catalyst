          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Improved operational reliability of space communications for military customers reduces perceived operational risk for systems that depend on satellite links, prompting defense and dual‑use contractors to accelerate deployment of AI agents and services that rely on those links." />
