          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Increased conflict intensity produces more kinetic, electronic-warfare and anti-satellite activity as well as deliberate jamming and cyberattacks against ground stations and links, directly degrading uptime, latency and throughput of comms used for military missions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="39" value="space_comm_governance" />
