      <edge source="western_bond_volatility::sovereign_bond_yield" target="mid_east_energy::oil_price_level" id="588">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rise in Western long-term sovereign yields raises global discount rates and lowers near-term growth and industrial activity expectations, reducing forecasted oil demand and putting downward pressure on oil prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_bond_volatility" />
          <attvalue for="39" value="mid_east_energy" />
          <attvalue for="28" value="0" />
        </attvalues>
