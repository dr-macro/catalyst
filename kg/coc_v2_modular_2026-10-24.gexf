      <edge source="western_bond_volatility::sovereign_bond_yield" target="russia_ukraine_conflict::negotiation_activity" id="589">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained increases in Western sovereign yields raise government debt‑service costs and fiscal strain, prompting reallocation or cuts in foreign policy/diplomatic budgets and slowing funding- and staff‑intensive mediation efforts that reduce negotiation activity." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="western_bond_volatility" />
          <attvalue for="39" value="russia_ukraine_conflict" />
          <attvalue for="28" value="0" />
