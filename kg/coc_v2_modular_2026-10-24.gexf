          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained rise in oil prices raises inflation expectations and risk premia, prompting investors and allocators to reweight portfolios away from long‑duration, high‑growth tech projects into commodity/energy exposures and shorter‑duration instruments, reducing net new capital flowing into AI build‑out." />
          <attvalue for="37" value="0-6 months" />
