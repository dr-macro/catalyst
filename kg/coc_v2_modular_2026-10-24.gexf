          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sharp upticks in kinetic operations prompt governments to impose export controls, sanctions, and direct orders (e.g., service denials or routing restrictions) on satellite and space-communications firms to deny support to battlefield actors, increasing explicit political interventions on provider behavior." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="39" value="space_comm_governance" />
          <attvalue for="28" value="0" />
