      <edge source="russia_ukraine_conflict::mutual_mistrust_level" target="mid_east_energy::oil_price_level" id="256">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising mutual mistrust among major powers lowers the odds of diplomatic accommodation and increases risk premia in commodity markets, prompting traders to bid up prices for Middle East crude as insurance against potential regional spillovers or export restrictions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="39" value="mid_east_energy" />
          <attvalue for="28" value="0" />
