<edge source="north_korea_missiles::external_influence_index" target="energy_maritime_chokepoi::shipping_freight_rates" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Greater external-patron leverage (naval escorts, diplomatic pressure, or targeted restrictions) forces rerouting, longer voyages or imposes operational constraints that translate directly into higher chartering and insurance costs for tanker voyages.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_missiles</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="north_korea_missiles::external_influence_index" target="us_china_tech_trade::regulatory_stringency" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A rise in external patron influence over North Korea heightens policymaker fears of coordinated tech transfer and dual-use proliferation, prompting quicker and broader export controls, licensing restrictions and sanctions on AI-related goods and services.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_missiles</data>
  <data key="d40">us_china_tech_trade</data>
</edge>
