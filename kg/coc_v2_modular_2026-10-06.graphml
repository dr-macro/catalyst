<edge source="us_china_tech_trade::ai_capability_level" target="energy_maritime_chokepoi::maritime_security_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">Higher AI capability accelerates deployment of autonomous maritime drones, improved targeting/decision software and automated ISR that lower thresholds for tactical interdiction and raise the likelihood of misidentification or incidents near chokepoints, increasing hostile encounters affecting commercial shipping.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_trade</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="us_china_tech_trade::ai_capability_level" target="iran_proxy_escalation::foreign_military_presenc" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rapid improvements in deployable AI (ISR, target recognition, logistics optimization) lower integration time and operational risk for advanced militaries, encouraging increased forward deployments and persistent allied force posture in the theater as deterrence and force-multiplication.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_trade</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
<edge source="us_china_tech_trade::ai_capability_level" target="russia_ukraine_war::kinetic_strike_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rises in frontier AI capability accelerate deployment of sensor-fusion, target-recognition and autonomous guidance software in loitering munitions, artillery spotting and strike planning used by combatants, raising the rate and accuracy of kinetic strikes.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_trade</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
