<edge source="energy_maritime_chokepoi::chokepoint_accessibility" target="iran_proxy_escalation::chokepoint_control" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">When chokepoint accessibility falls (due to mines, interdictions or harassment), local actors can more easily enforce area-denial and thereby consolidate de facto control over the passage.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
<edge source="energy_maritime_chokepoi::chokepoint_accessibility" target="russia_ukraine_war::military_aid_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Physical restriction or temporary closure of key sea passages (e.g., Black Sea approaches or the Turkish Straits) prevents or substantially delays roll-on/roll-off and heavy-equipment shipments to Ukrainian ports, forcing cancellations or long detours that reduce the volume and tempo of maritime military aid.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="energy_maritime_chokepoi::chokepoint_accessibility" target="us_china_tech_trade::ai_capability_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Improved passage through key maritime chokepoints speeds delivery of advanced chips and servers to training sites, accelerating hardware refresh cycles and enabling higher aggregate AI model training and deployment performance.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">us_china_tech_trade</data>
</edge>
