<edge source="energy_maritime_chokepoi::crude_export_flow" target="iran_proxy_escalation::foreign_military_presenc" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sharp reductions in crude export flows prompt consumer states and partners to deploy naval/air assets to protect producers and sea lines of communication, increasing foreign military presence in the region.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
<edge source="energy_maritime_chokepoi::crude_export_flow" target="russia_ukraine_war::domestic_stability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">A sustained drop in crude export volumes and related export revenues (e.g., from Russian sales disrupted by maritime interdiction or chokepoint closures) reduces government fiscal capacity and subsidies, heightening inflation and social grievances that erode domestic political stability.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
