<edge source="north_korea_missiles::arms_flow_volume" target="energy_maritime_chokepoi::tanker_availability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A surge in weapons and munitions shipments in regional sea lanes leads shipowners and operators to withdraw or refuse employment of tankers for voyages to/through affected ports or zones, shrinking the deployable tanker stock.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_missiles</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="north_korea_missiles::arms_flow_volume" target="iran_proxy_escalation::maritime_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">Increased shipments from North Korea of anti-ship missiles, cruise missiles, sea-skimming munitions, drones and naval mines directly raise Iranian-proxy strike capability and enable a higher tempo of maritime attacks against military and commercial vessels.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">north_korea_missiles</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
<edge source="north_korea_missiles::arms_flow_volume" target="russia_ukraine_war::kinetic_strike_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Direct shipments of North Korean artillery, rockets or missile munitions to Russian front-line units increase available stocks and enable higher-tempo, larger-scale barrages and missile strikes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_missiles</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="north_korea_missiles::arms_flow_volume" target="russia_ukraine_war::military_aid_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Weapons and munitions exported by North Korea to Russia constitute an increase in actual military transfers into the Russia–Ukraine theatre, raising measured military aid flows to a combatant.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_missiles</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="north_korea_missiles::arms_flow_volume" target="us_china_tech_trade::compute_capacity" id="0">
