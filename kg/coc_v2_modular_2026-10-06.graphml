  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A rise in attacks or clear threats to commercial shipping near the conflict triggers allied naval escorts, joint patrols, and coordinated diplomatic responses, increasing perceived unity and operational coordination among partners.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="energy_maritime_chokepoi::maritime_security_risk" target="us_china_tech_trade::compute_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">A rise in hostile incidents and attacks forces port closures, rerouting and inspection delays that directly slow or prevent delivery of datacenter fuel, replacement parts and accelerator hardware, producing immediate reductions in usable high-performance compute.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">us_china_tech_trade</data>
</edge>
