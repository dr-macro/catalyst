  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A surge in external forces deployed to the Gulf ties U.S. and allied assets and attention to the Middle East, which Pyongyang interprets as reduced U.S. focus/response capacity in East Asia and therefore increases DPRK incentives to pursue missile tests and other escalatory signaling.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_proxy_escalation</data>
  <data key="d40">north_korea_missiles</data>
</edge>
<edge source="iran_proxy_escalation::foreign_military_presenc" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Large-scale deployments of Western forces to counter Iran-proxy escalation create intra-alliance friction over burden‑sharing and rules of engagement, producing visible policy divergence and weakening perceived NATO/partner unity on collective deterrence vis‑à‑vis Russia.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_proxy_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_proxy_escalation::foreign_military_presenc" target="us_china_tech_trade::regulatory_stringency" id="0">
