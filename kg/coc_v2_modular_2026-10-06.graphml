<edge source="us_china_tech_trade::regulatory_stringency" target="iran_proxy_escalation::maritime_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Tightened export controls and licensing on AI-enabled targeting, sensor-fusion, and maritime-autonomy technologies restrict proxies' ability to acquire and operate high-precision guidance and autonomous maritime/drone systems, reducing the frequency and effectiveness of attacks on vessels.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_trade</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
<edge source="us_china_tech_trade::regulatory_stringency" target="north_korea_missiles::external_influence_index" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Tighter export controls and vetting on AI and dual‑use tech reduce legal channels and increase compliance risk for Chinese intermediaries, diminishing Beijing's ability to supply or broker operationally valuable tech to Pyongyang and thereby lowering external patrons' operational leverage over DPRK decision‑making.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_trade</data>
  <data key="d40">north_korea_missiles</data>
</edge>
