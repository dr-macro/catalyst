  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Rising escalation pressure prompts coastal states and naval commanders to impose navigation warnings, temporary restrictions or localized closures around narrow passages, reducing normal passability for commercial shipping.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_missiles</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="north_korea_missiles::escalation_pressure" target="us_china_tech_trade::ai_capital_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Rising escalation pressure raises geopolitical risk premiums and uncertainty for cross-border technology ventures, causing international investors and funds to scale back or delay financing for civilian AI companies tied to the region, lowering net capital flows into AI.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_missiles</data>
  <data key="d40">us_china_tech_trade</data>
