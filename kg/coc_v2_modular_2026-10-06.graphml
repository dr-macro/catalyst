<edge source="russia_ukraine_war::hybrid_attack_activity" target="energy_maritime_chokepoi::chokepoint_accessibility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sabotage, mines laid by small craft, and cyber intrusions against traffic-control/navigation aids or port systems can force temporary closures or routing restrictions at narrow straits and approaches, lowering accessibility for commercial traffic.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="russia_ukraine_war::hybrid_attack_activity" target="us_china_tech_trade::regulatory_stringency" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.78</data>
  <data key="d37">A rise in cross‑border cyber intrusions, AI‑enabled influence and sabotage linked to the conflict prompts legislatures and regulators to tighten controls on AI security, export, and certification rules to reduce abuse vectors.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_tech_trade</data>
</edge>
