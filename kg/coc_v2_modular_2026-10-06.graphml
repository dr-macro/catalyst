<edge source="energy_maritime_chokepoi::tanker_availability" target="iran_proxy_escalation::commercial_shipping_disr" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A decline in available tanker tonnage forces route juggling, shipment cancellations and longer laytimes, directly raising the rate and severity of commercial shipping disruptions for crude and refined products.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
<edge source="energy_maritime_chokepoi::tanker_availability" target="north_korea_missiles::external_influence_index" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Greater commercial tanker availability enables external patrons to deliver fuel and sanctioned commodity assistance more reliably by sea, which they can condition or time to extract political and operational leverage over North Korea.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">north_korea_missiles</data>
</edge>
<edge source="energy_maritime_chokepoi::tanker_availability" target="russia_ukraine_war::kinetic_strike_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">A sharp decline in available tanker tonnage for transporting fuel and lubricants to the theatre constrains frontline fuel resupply for vehicles, aircraft and logistics, lowering operational tempo and thereby reducing the overall rate and scale of kinetic strikes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="energy_maritime_chokepoi::tanker_availability" target="us_china_tech_trade::compute_concentration" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Greater availability of tanker tonnage eases fuel and bulk-transport bottlenecks, reducing the logistical advantage of the largest, vertically integrated cloud providers and enabling smaller operators to secure resources, thereby lowering compute-market concentration.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">us_china_tech_trade</data>
</edge>
