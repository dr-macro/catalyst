<edge source="energy_maritime_chokepoi::maritime_security_risk" target="iran_proxy_escalation::maritime_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A rise in maritime security incidents normalizes and signals capability for hostile actors, lowering operational friction and prompting an increase in the tempo and rate of maritime attacks by Iran-aligned proxies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
<edge source="energy_maritime_chokepoi::maritime_security_risk" target="north_korea_missiles::escalation_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">A rise in hostile incidents on key sea lanes near the peninsula directly prompts reciprocal naval/military deployments, alerting and hardening actors on all sides and thereby increasing the systemic pressure to escalate.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">north_korea_missiles</data>
</edge>
<edge source="energy_maritime_chokepoi::maritime_security_risk" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
