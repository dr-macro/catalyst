<edge source="global_bond_stress::sovereign_spread" target="middle_east_war::maritime_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising sovereign spreads increase fiscal strain on oil-exporting and transit states, forcing cuts or delays to naval/coastguard patrols and maintenance that reduce deterrence and raise the frequency of attacks, seizures and harassment of commercial shipping.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_bond_stress</data>
  <data key="d39">middle_east_war</data>
</edge>
<edge source="global_bond_stress::sovereign_spread" target="populist_election_wave::policy_uncertainty" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A rapid widening in sovereign spreads forces governments to debate emergency fiscal adjustments and signals fiscal stress to markets and voters, increasing perceived uncertainty about future economic and regulatory policy choices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_stress</data>
  <data key="d39">populist_election_wave</data>
</edge>
<edge source="global_bond_stress::sovereign_spread" target="russia_ukraine_war::military_conflict_lvl" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widening sovereign spreads for Russia (or its external backers) raises external borrowing costs and limits access to international credit, constraining defense procurement, ammunition purchase and force sustainment and thereby reducing the capacity for sustained conventional operations.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_bond_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_bond_stress::sovereign_spread" target="us_china_tech_rivalry::capital_flow_to_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Widening sovereign spreads raise benchmark yields and borrowing costs, directly increasing financing costs and investor discount rates for long‑duration/high‑risk AI projects and thereby reducing new equity and debt flows into AI firms and infrastructure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_stress</data>
  <data key="d39">us_china_tech_rivalry</data>
