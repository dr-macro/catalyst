<edge source="global_bond_stress::bond_liquidity" target="russia_ukraine_war::energy_supply_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A persistent decline in global bond market liquidity raises financing costs and impairs the ability of upstream and midstream energy firms to refinance or fund maintenance and investment, producing production shortfalls, export bottlenecks and greater volatility in regional energy supplies.</data>
  <data key="d37">6-18 months</data>
