<edge source="middle_east_war::maritime_incident_rate" target="global_bond_stress::bond_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Spikes in hostile maritime incidents create acute operational and counterparty uncertainty for trade finance and cross-border flows, leading dealers to pull back, widen bid-ask spreads and thin market depth, reducing bond market liquidity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_war</data>
  <data key="d39">global_bond_stress</data>
</edge>
<edge source="middle_east_war::maritime_incident_rate" target="populist_election_wave::media_coverage" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">A spike in attacks/seizures off the coast produces immediate, high‑salience headlines and televised footage that increases the volume and prominence of election reporting tying candidates to security responses.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_war</data>
  <data key="d39">populist_election_wave</data>
</edge>
<edge source="middle_east_war::maritime_incident_rate" target="russia_ukraine_war::transnational_coop_cap" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in hostile incidents against commercial shipping in the Middle East prompts coalition responses (naval escorts, shared ISR, joint sanctions implementation) that strengthen institutionalized cross‑border security and intelligence coordination relevant to managing the Russia–Ukraine crisis.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_war</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="middle_east_war::maritime_incident_rate" target="us_china_tech_rivalry::supplier_market_concentr" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A higher frequency of attacks, seizures or strikes on commercial shipping raises insurance and rerouting costs that smaller, specialised suppliers cannot absorb, pushing buyers toward larger vertically integrated hardware suppliers and raising market concentration.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">middle_east_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="middle_east_war::maritime_incident_rate" target="us_china_tech_rivalry::regulatory_activity_inte" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A surge in high-profile maritime security incidents tied to the conflict sharpens national-security concerns and triggers policymakers to accelerate export controls, sanctions and supply‑chain security measures affecting cross‑border AI hardware, increasing regulatory activity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_war</data>
  <data key="d39">us_china_tech_rivalry</data>
