  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intensified security coordination among the US and European allies over the Russia war produces coordinated risk‑management imperatives that lead to parallel diplomatic outreach (bilateral and mediated channels via regional interlocutors) toward Gulf states and Iran to defuse maritime tensions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_gulf_maritime_tensi</data>
</edge>
