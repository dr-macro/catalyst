  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_gulf_maritime_tensi::crude_price_level" target="euro_security_realignmen::wage_growth_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained higher crude prices feed through into consumer prices and inflation expectations, prompting workers and unions to press for higher nominal wages in upcoming negotiation cycles.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_gulf_maritime_tensi</data>
  <data key="d39">euro_security_realignmen</data>
</edge>
<edge source="iran_gulf_maritime_tensi::crude_price_level" target="global_monetary_tighteni::cpi_inflation_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Higher crude prices directly raise transport and heating fuel costs and raise production costs for a broad set of goods and services, producing measurable upward pressure on headline CPI within a few months.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_maritime_tensi</data>
  <data key="d39">global_monetary_tighteni</data>
</edge>
<edge source="iran_gulf_maritime_tensi::crude_price_level" target="russia_ukraine_war::military_logistics_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Sustained higher global crude prices increase Russian export revenues and foreign‑exchange receipts, enabling Moscow to finance procurement, logistics contracts and fuel purchases that directly raise the throughput and reliability of supplies to forces in Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_maritime_tensi</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_maritime_tensi::crude_price_level" target="us_china_tech_rivalry::capital_flow_into_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">1</data>
  <data key="d35">0.55</data>
  <data key="d36">Higher crude prices expand fiscal surpluses and liquidity for oil‑exporters and sovereign wealth funds in the Gulf, which in turn redeploy a portion of increased capital into strategic, revenue‑diversifying investments including AI firms and infrastructure, lifting net capital flows into the AI sector.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_gulf_maritime_tensi</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
