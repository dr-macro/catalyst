<edge source="russia_ukraine_war::kinetic_military_activit" target="euro_security_realignmen::labor_market_tightness" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Heightened cross‑border kinetic activity produces displacement and refugee flows into neighboring EU labour markets, increasing local labor supply and thus reducing vacancy-to-worker tightness once administrative integration allows employment.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">euro_security_realignmen</data>
</edge>
