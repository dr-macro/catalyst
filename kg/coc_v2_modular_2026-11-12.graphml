  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Escalation of kinetic operations near or across borders raises sovereign risk premia for affected countries (higher probability of fiscal strains, disruption and capital flight), pushing up their 10‑year government yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_monetary_tighteni</data>
</edge>
<edge source="russia_ukraine_war::kinetic_military_activit" target="us_china_tech_rivalry::geopolitical_tension_tec" id="0">
