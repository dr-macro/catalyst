  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter allied security coordination (sanctions, joint defense posture and trade restrictions) reallocates private and official capital toward perceived safe‑haven jurisdictions and away from geopolitically exposed emerging markets, reducing net cross‑border inflows into those markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_monetary_tighteni</data>
</edge>
<edge source="russia_ukraine_war::security_coordination" target="iran_gulf_maritime_tensi::diplomatic_engagement_le" id="0">
