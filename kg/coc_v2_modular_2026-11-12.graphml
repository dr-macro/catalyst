  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Deeper EU/NATO security coordination triggers expanded joint procurement and national rearmament plans that create new orders for defense and dual‑use manufacturers, prompting hiring spikes in those industries as firms scale production.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">euro_security_realignmen</data>
</edge>
<edge source="russia_ukraine_war::security_coordination" target="global_monetary_tighteni::cross_border_flows" id="0">
