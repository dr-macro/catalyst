  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Heightened regulatory scrutiny (export controls, licensing, required audits and supply‑chain reconfiguration) raises compliance, legal and sourcing costs for firms, directly increasing aggregate corporate cost pressure.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">euro_security_realignmen</data>
</edge>
<edge source="us_china_tech_rivalry::reg_scrutiny_tech" target="euro_security_realignmen::hiring_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">1</data>
  <data key="d35">0.6</data>
  <data key="d36">Immediate uncertainty and project delays from stricter transfer rules and approval processes lead firms to pause or slow hiring for cross‑border R&amp;D and specialized tech roles, reducing hiring rates.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">euro_security_realignmen</data>
</edge>
<edge source="us_china_tech_rivalry::reg_scrutiny_tech" target="global_monetary_tighteni::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Tighter export controls and enhanced vetting increase compliance costs and legal/operational barriers for foreign investors and cross‑border transactions in tech sectors, causing a near‑term pullback in net international capital flows into affected firms and jurisdictions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">global_monetary_tighteni</data>
</edge>
<edge source="us_china_tech_rivalry::reg_scrutiny_tech" target="iran_gulf_maritime_tensi::asymmetric_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter export controls spur suppliers and intermediaries to route dual‑use components and finished drone/missile electronics to Iran through covert/third‑party channels, accelerating Iranian proxy procurement and increasing the tempo of asymmetric maritime attacks.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">iran_gulf_maritime_tensi</data>
</edge>
