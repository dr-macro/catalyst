  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A spike in asymmetric attacks against shipping raises shared threat perceptions among NATO and partner navies, prompting more frequent joint planning, intelligence‑sharing and synchronized force posture decisions that increase overall security policy coordination relevant to the Russia–Ukraine theater.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_maritime_tensi</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_maritime_tensi::asymmetric_attack_rate" target="us_china_tech_rivalry::geopolitical_tension_tec" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Evidence that missiles/drones/sabotage used in asymmetric maritime attacks incorporate Chinese-origin components or supply-chain links provokes US accusations of proliferation/indirect support and precipitates escalatory tech-focused diplomatic and sanction actions versus China, raising interstate technology tensions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_maritime_tensi</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
