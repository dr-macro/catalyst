      <edge source="china_us_tech_rivalry::geo_tech_tension" target="energy_maritime_chokepoi::maritime_security_incide" id="424">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Escalating US–China technology confrontation prompts more state and paramilitary deployments, interdictions and harassment around strategic sea lanes (to signal resolve, protect undersea infrastructure or retaliate), directly increasing the frequency and severity of maritime security incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_us_tech_rivalry" />
          <attvalue for="39" value="energy_maritime_chokepoi" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="china_us_tech_rivalry::geo_tech_tension" target="energy_maritime_chokepoi::tanker_fleet_availabilit" id="425">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Technology‑related sanctions, export controls and insurance restrictions tied to the US–China rivalry cause operators and insurers to avoid certain flags, ports and routes, forcing longer voyages, detentions or idling that reduce effective tanker tonnage available for commercial employment in key chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_us_tech_rivalry" />
          <attvalue for="39" value="energy_maritime_chokepoi" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="china_us_tech_rivalry::geo_tech_tension" target="global_monetary_stress::fx_intervention_flow" id="426">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Spikes in geopolitical technology tension (export controls, sanctions, trade restrictions) create acute cross‑border capital and trade flows that prompt authorities to buy or sell FX to stabilize strategic exchange rates and secure supply chains." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_us_tech_rivalry" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="china_us_tech_rivalry::geo_tech_tension" target="global_monetary_stress::long_term_yield" id="427">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened technology geopolitics increases risk‑off demand for safe‑haven sovereign debt, raising prices and thereby lowering long‑term bond yields in the near term." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_us_tech_rivalry" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
