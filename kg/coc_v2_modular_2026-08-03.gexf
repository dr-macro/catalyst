          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Escalating US–China tech confrontation drives China to deepen trade, investment and sanctions‑evasion ties with Iran (tech transfers, financial channels), provoking US diplomatic protests, sanctions and reciprocal measures that raise bilateral diplomatic tension with Iran." />
