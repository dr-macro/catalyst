      <edge source="energy_maritime_chokepoi::chokepoint_transit_capac" target="russia_ukraine_war::energy_export_throughput" id="513">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Physical reductions or closures of key straits (e.g., minefields, port closures, or convoy restrictions) directly limit the number of tankers and LNG carriers that can transit, immediately lowering seaborne energy export volumes from Black Sea/adjacent Russian terminals." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_maritime_chokepoi::chokepoint_transit_capac" target="us_iran_confrontation::diplomatic_tension_level" id="514">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A decline in chokepoint throughput (closures or capacity losses) provokes immediate diplomatic escalation by the US — public condemnations, sanctions pressure and regional consultations — raising bilateral and multilateral tensions with parties seen as responsible or obstructive." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="us_iran_confrontation" />
