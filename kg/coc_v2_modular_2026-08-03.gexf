      <edge source="energy_maritime_chokepoi::chokepoint_transit_capac" target="china_us_tech_rivalry::chip_prod_capacity" id="512">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Reductions in physical transit capacity through key chokepoints delay or block delivery of critical semiconductor inputs and heavy fab equipment, forcing fabs to slow or suspend production and lowering effective chip production throughput." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="china_us_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
