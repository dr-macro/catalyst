          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Elevated market perception of maritime supply‑chain risk raises investor risk premia and prompts lenders and VCs to pull back financing for capital‑intensive AI infrastructure and projects—especially those sited in or dependent on exposed trade corridors—reducing capital flows to AI." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="china_us_tech_rivalry" />
