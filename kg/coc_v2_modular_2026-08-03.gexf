      <edge source="russia_ukraine_war::military_attack_intensit" target="china_us_tech_rivalry::geo_tech_tension" id="167">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp escalations and visible use of commercially sourced dual‑use technologies (drones, comms, EW) prompt rapid policy responses (export controls, investment screening) and political pressure to harderen tech decoupling between the US and strategic competitors, raising geopolitical technology tension." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_us_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_attack_intensit" target="energy_maritime_chokepoi::maritime_security_incide" id="168">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Higher rates of offensive strikes (missiles, drones, naval gunfire) near coastlines and ports directly increase the number and severity of attacks, near-misses and damage events affecting ships and sea lanes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_maritime_chokepoi" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_attack_intensit" target="global_monetary_stress::bond_market_volatility" id="169">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Sudden increases in strike intensity produce acute geopolitical uncertainty and rapid portfolio reallocation (flight-to-safety, stop-losses, hedging) that raises realized volatility in global sovereign bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_attack_intensit" target="us_iran_confrontation::military_presence_level" id="170">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained increase in Russian offensive attacks compels the US and NATO to redeploy naval, air and ground assets to Europe for deterrence and reinforcement, reducing the scale of forces and platforms the US can keep deployed in the Middle East vis-à-vis Iran." />
          <attvalue for="37" value="0-6 months" />
