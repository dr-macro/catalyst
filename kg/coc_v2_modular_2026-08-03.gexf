          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalating diplomatic hostility in the US–Iran confrontation prompts policymakers to expand export controls, sanctions and secondary‑sanctions enforcement and to coordinate allied tech‑security measures, directly increasing geopolitical friction centered on technology between the US and other major tech actors (notably China)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
