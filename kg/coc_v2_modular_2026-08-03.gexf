      <edge source="global_monetary_stress::long_term_yield" target="china_us_tech_rivalry::ai_compute_demand_rate" id="685">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained rises in long-term yields increase the cost of financing large-scale data-center and accelerator deployments and reduce corporate capex appetite, slowing the growth rate of demand for high-performance AI compute." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_stress" />
          <attvalue for="39" value="china_us_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_stress::long_term_yield" target="energy_maritime_chokepoi::tanker_fleet_availabilit" id="686">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising long-term sovereign yields increase ship financing and leasing costs and encourage owners to idle, cancel newbuilds or defer deployment, reducing effective tanker tonnage available for commercial employment." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_monetary_stress" />
          <attvalue for="39" value="energy_maritime_chokepoi" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_stress::long_term_yield" target="russia_ukraine_war::military_attack_intensit" id="687">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained increases in global long-term yields raise sovereign borrowing costs and debt-service burdens for Western governments, eroding short-to-medium-term fiscal headroom and thereby slowing or reducing external military assistance and munitions supply to Ukraine, which lowers the pace and scale of offensive operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_monetary_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_stress::long_term_yield" target="us_iran_confrontation::strike_auth_propensity" id="688">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising long-term sovereign yields raise US fiscal financing costs and political scrutiny over deficit spending, shifting executive focus toward domestic economic management and making leaders less willing to authorize new offensive strikes that would carry budgetary and political costs." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_monetary_stress" />
          <attvalue for="39" value="us_iran_confrontation" />
          <attvalue for="28" value="0" />
