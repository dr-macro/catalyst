          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="An increase in market risk perception raises risk premia and accelerates forced and discretionary portfolio rebalancing, directly increasing intraday and realized volatility in bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="global_monetary_stress" />
