          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalating diplomatic hostility and public threats increase trader, insurer, and investor perception of disruption risk, prompting higher risk premia and precautionary market behaviour." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="energy_maritime_chokepoi" />
