      <edge source="energy_maritime_chokepoi::maritime_security_incide" target="china_us_tech_rivalry::geo_tech_tension" id="561">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A sharp uptick in hostile or disruptive maritime incidents (attacks, seizures) immediately triggers defensive policy responses (sanctions, export controls, reciprocal tech restrictions) and accelerated decoupling steps that raise geopolitical technology tension between China and the US." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="china_us_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_maritime_chokepoi::maritime_security_incide" target="global_monetary_stress::bond_market_volatility" id="562">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Spikes in maritime security incidents create sudden supply and geopolitical uncertainty that trigger rapid portfolio reallocation and flight-to-quality moves, producing sharp, immediate increases in realized volatility in sovereign bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_maritime_chokepoi::maritime_security_incide" target="global_monetary_stress::fx_intervention_flow" id="563">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher frequency/severity of incidents disrupts export receipts and amplifies exchange-rate swings for exposed currencies, prompting authorities to step into FX markets with purchases or sales to smooth volatility and defend exchange-rate targets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_maritime_chokepoi::maritime_security_incide" target="russia_ukraine_war::trade_and_transport_rest" id="564">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Attacks, seizures, or mine incidents on commercial vessels provoke coastal states, ports, and insurers to impose routing bans, naval escorts, and formal/informal port restrictions, thereby increasing trade and transport constraints for goods tied to the conflict zone." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_maritime_chokepoi::maritime_security_incide" target="russia_ukraine_war::regional_spillover_incid" id="565">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Hostile or accidental maritime incidents in or near contested waters increase the likelihood of cross-border naval engagements, interdictions, or diplomatic/military responses by neighboring states, raising the rate of regional spillover incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_maritime_chokepoi::maritime_security_incide" target="us_iran_confrontation::military_presence_level" id="566">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A rise in hostile or disruptive incidents against commercial ships prompts rapid redeployments of US naval and air assets for escorts, patrols and deterrence in the affected sea lanes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="us_iran_confrontation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_maritime_chokepoi::maritime_security_incide" target="us_iran_confrontation::retaliatory_strike_rate" id="567">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="When attacks on shipping are attributed to Iranian forces or their proxies, US or allied commanders frequently respond with targeted kinetic strikes against perpetrators or their infrastructure, increasing retaliatory strike frequency." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
