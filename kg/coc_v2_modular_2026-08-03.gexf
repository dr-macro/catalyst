      <edge source="us_iran_confrontation::military_presence_level" target="china_us_tech_rivalry::avail_compute_capacity" id="84">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A sustained increase in deployed military assets drives accelerated defense procurement of high‑end servers, accelerators and hardened compute for ISR and operational AI, drawing from constrained global inventories and temporarily reducing civilian deployable compute capacity." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="china_us_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::military_presence_level" target="energy_maritime_chokepoi::chokepoint_transit_capac" id="85">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Larger deployed naval and interdiction forces in and around chokepoints lead to enforced inspections, convoying, temporary closures, and slower transit schedules, reducing effective daily throughput capacity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="energy_maritime_chokepoi" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::military_presence_level" target="global_monetary_stress::long_term_yield" id="86">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An increased deployed military footprint elevates geopolitical risk and triggers a safe‑haven bid for long-dated sovereign bonds (especially US Treasuries), putting downward pressure on long-term yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::military_presence_level" target="russia_ukraine_war::military_attack_intensit" id="87">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained increase in U.S. and allied force deployments to the Middle East prompts the redeployment of NATO/US air, naval and ISR assets away from Europe, reducing the deterrence and targeting support available to Ukraine and thereby enabling Russia to raise the tempo of offensive strikes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
