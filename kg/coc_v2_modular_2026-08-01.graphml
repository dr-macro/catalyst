  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">A fall in regional fuel availability (refined products and feedstock) reduces volumes available for shipment from production and processing hubs, directly lowering export loadings through nearby chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_energy</data>
  <data key="d40">maritime_chokepoints</data>
