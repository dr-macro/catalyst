  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.78</data>
  <data key="d37">An increase in kinetic and asymmetric strikes on energy and logistical nodes prompts coastal states and naval actors to escalate patrols, convoy escorts and interdiction operations to secure chokepoints and shipping.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_energy</data>
  <data key="d40">maritime_chokepoints</data>
</edge>
