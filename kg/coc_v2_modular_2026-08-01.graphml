<edge source="maritime_chokepoints::energy_export_flow" target="global_monetary_stress::foreign_exchange_rates" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">An increase in energy export flows boosts foreign-currency earnings and improves the trade balance for exporters, leading to appreciations in their currencies against major peers as market demand for local currency rises.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">maritime_chokepoints</data>
  <data key="d40">global_monetary_stress</data>
</edge>
<edge source="maritime_chokepoints::energy_export_flow" target="russia_ukraine_energy::fuel_supply_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">An increase in physical shipments of oil, refined products or LNG through chokepoints directly delivers product into regional markets and storage, raising regional fuel availability.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">maritime_chokepoints</data>
  <data key="d40">russia_ukraine_energy</data>
</edge>
<edge source="maritime_chokepoints::energy_export_flow" target="us_iran_confront::global_oil_price" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">An increase in regional energy export flow raises available global supply and eases tightness in markets, exerting downward pressure on benchmark oil prices (and conversely, export disruptions push prices up).</data>
  <data key="d38">0-6 months</data>
  <data key="d39">maritime_chokepoints</data>
  <data key="d40">us_iran_confront</data>
