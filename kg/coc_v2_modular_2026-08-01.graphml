  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">An increase in strike intensity raises perceived sovereign and corporate risk (higher default/operational risk and insurance costs), prompting investors to demand larger risk premia and pushing benchmark bond yields up.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_energy</data>
  <data key="d40">global_monetary_stress</data>
</edge>
<edge source="russia_ukraine_energy::strike_intensity" target="maritime_chokepoints::military_response" id="0">
