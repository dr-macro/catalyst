  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A rapid depreciation of importers' currencies (or sharp USD appreciation) raises local import and bunker costs, prompting importers and shippers to cut orders and sailings, reducing commercial traffic through key chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_monetary_stress</data>
  <data key="d40">maritime_chokepoints</data>
</edge>
<edge source="global_monetary_stress::foreign_exchange_rates" target="russia_ukraine_energy::fuel_supply_level" id="0">
  <data key="d28">cross_causal</data>
