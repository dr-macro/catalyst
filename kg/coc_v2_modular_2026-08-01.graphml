<edge source="us_china_tech_rivalry::chip_supply_pressure" target="global_monetary_stress::foreign_exchange_rates" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Acute semiconductor and memory supply constraints reduce export volumes and FX receipts for major chip-exporting economies, putting downward pressure on their currencies versus major reserve currencies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_monetary_stress</data>
</edge>
<edge source="us_china_tech_rivalry::chip_supply_pressure" target="maritime_chokepoints::maritime_transit_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Acute semiconductor and memory shortages delay repairs, retrofits and new-build outfitting of commercial vessels and port systems, producing equipment failures, port congestion and cancelled sailings that reduce transit volumes through chokepoints.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">maritime_chokepoints</data>
</edge>
