<edge source="us_iran_confront::chokepoint_access" target="global_monetary_stress::foreign_exchange_rates" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Greater functional access to key chokepoints lowers shipping costs and trade frictions, improving trade balances for transit-dependent economies and supporting appreciation of their currencies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">global_monetary_stress</data>
