<edge source="us_iran_confront::chokepoint_access" target="maritime_chokepoints::energy_export_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Restoration or preservation of functional access through primary passages (fewer closures, fewer forced diversions) directly increases the number of tankers and LNG carriers able to load and depart on schedule, raising energy export volumes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">maritime_chokepoints</data>
