  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Spikes in drone attacks increase geopolitical and operational risk for affected exporters/importers, triggering short-term capital flight and weaker local currency valuations versus major peers as investors reprice risk exposure.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">maritime_chokepoints</data>
  <data key="d40">global_monetary_stress</data>
</edge>
<edge source="maritime_chokepoints::drone_attack_rate" target="russia_ukraine_energy::infrastructure_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Higher rates of drone strikes against tankers, terminals, pipelines or offshore facilities cause direct damage and force shutdowns or reduced throughput, lowering operational capacity of energy and maritime infrastructure.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">maritime_chokepoints</data>
  <data key="d40">russia_ukraine_energy</data>
</edge>
<edge source="maritime_chokepoints::drone_attack_rate" target="us_china_tech_rivalry::chip_supply_pressure" id="0">
