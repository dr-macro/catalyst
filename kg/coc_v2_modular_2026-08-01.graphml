  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Depreciation of regional/local currencies against major currencies (i.e., a rise in FX measures showing local weakness) raises the local currency cost of imported refined fuels and credit for importers, causing immediate cutbacks or delayed imports and lower available fuel volumes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_monetary_stress</data>
  <data key="d40">russia_ukraine_energy</data>
</edge>
