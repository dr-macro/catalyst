<edge source="us_iran_confront::military_tempo" target="maritime_chokepoints::drone_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">An uptick in US/coalition kinetic operations and patrols provokes retaliatory or escalation-driven UAS strikes by Iranian forces and proxies against maritime and energy infrastructure, increasing drone attack frequency and intensity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">maritime_chokepoints</data>
</edge>
