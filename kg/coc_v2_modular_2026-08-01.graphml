<edge source="us_iran_confront::maritime_security_level" target="global_monetary_stress::crossborder_capital" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Improved maritime security reduces transport risk and insurance premia for trade-exposed firms and raises investor confidence in regional trade-dependent assets, attracting net cross-border capital inflows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">global_monetary_stress</data>
</edge>
<edge source="us_iran_confront::maritime_security_level" target="maritime_chokepoints::maritime_transit_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Visible improvements in naval escorts, patrols and interdiction success reduce the risk of interdiction and attacks, prompting carriers and shippers to resume primary routes and raising transit volumes through chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">maritime_chokepoints</data>
</edge>
<edge source="us_iran_confront::maritime_security_level" target="maritime_chokepoints::insurance_premia_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained reductions in incident frequency and demonstrable security measures lead insurers to lower war-risk surcharges and overall premiums for vessels operating in the affected sea lanes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">maritime_chokepoints</data>
</edge>
<edge source="us_iran_confront::maritime_security_level" target="us_china_tech_rivalry::chip_supply_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">An increase in maritime_security_level (fewer hostile incidents) reduces insurance costs, rerouting and port delays for semiconductor and memory shipments, thereby lowering chip and memory supply pressure within affected supply chains.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confront</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
