<edge source="global_rate_shock::market_liquidity" target="ai_safety_race::deployment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Improved market liquidity reduces transaction and short‑term financing costs for firms and cloud providers, enabling faster procurement of compute, software and integration projects and thereby accelerating deployment of frontier capabilities into products and operations.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_rate_shock</data>
  <data key="d39">ai_safety_race</data>
</edge>
<edge source="global_rate_shock::market_liquidity" target="brics_alignment_growth::supply_chain_realignment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Improved market liquidity lowers transaction, hedging and rollover costs and reduces firms' precautionary financing premia, decreasing the urgency for firms to reorganize sourcing and production geographies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_rate_shock</data>
  <data key="d39">brics_alignment_growth</data>
</edge>
<edge source="global_rate_shock::market_liquidity" target="gulf_energy_flashpoint::supply_risk_perception" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher market liquidity reduces hedging and financing costs for oil traders and shipping firms and enables faster price discovery, decreasing market participants' perceived probability and severity of supply disruptions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_rate_shock</data>
  <data key="d39">gulf_energy_flashpoint</data>
</edge>
<edge source="global_rate_shock::market_liquidity" target="russia_ukraine_conflict::military_readiness" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sudden drop in market liquidity raises transaction costs and freezes short‑term commercial credit and FX lines for defence suppliers and logistics firms, causing delays in spare parts, fuel and munitions deliveries and degrading frontline intercept and rapid‑reaction readiness within weeks to months.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_rate_shock</data>
  <data key="d39">russia_ukraine_conflict</data>
</edge>
