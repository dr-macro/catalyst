  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Expanded central-bank market operations (liquidity provision, swap lines and asset purchases) reduce financing stress and FX volatility for multinational firms, lowering near‑term incentives to relocate production or capital expenditure across jurisdictions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_rate_shock</data>
  <data key="d39">brics_alignment_growth</data>
</edge>
