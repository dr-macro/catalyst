<edge source="gulf_energy_flashpoint::shipping_route_security" target="brics_alignment_growth::supply_chain_realignment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A deterioration (fall) in shipping_route_security through Gulf chokepoints forces firms to reroute logistics and relocate sourcing away from Gulf‑dependent corridors, increasing the pace of supply_chain_realignment toward alternative producers and routes.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">gulf_energy_flashpoint</data>
  <data key="d39">brics_alignment_growth</data>
