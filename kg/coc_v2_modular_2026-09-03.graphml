  <data key="d40">global_bond_repricing</data>
</edge>
<edge source="russia_ukraine_war::sanctions_financial" target="global_oil_reordering::oil_export_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Tighter financial sanctions on Russian energy firms and banks restrict payments, insurance and shipping services, causing immediate disruptions and reductions in crude and product shipments from sanctioned exporters.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_oil_reordering</data>
</edge>
<edge source="russia_ukraine_war::sanctions_financial" target="us_china_strategic_rival::compute_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Escalating financial and export sanctions tied to the war prompt allied export-control packages that restrict sales of advanced GPUs, HPC systems and semiconductor tools to Chinese firms, directly reducing the rate at which China can install new high‑performance compute capacity.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
<edge source="russia_ukraine_war::sanctions_financial" target="us_china_strategic_rival::ai_infra_concentration" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sanctions and related export controls narrow the set of suppliers trusted or permitted to sell advanced AI infrastructure, shifting demand toward a smaller group of sanctioned‑free cloud and hardware vendors and thereby increasing market concentration.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
<edge source="russia_ukraine_war::sanctions_financial" target="us_iran_gulf_escalation::crude_throughput_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Heightened Western financial and trade sanctions on Russian oil reduce seaborne Russian exports to Europe, shifting global crude flows onto remaining suppliers and increasing volumes routed through the Gulf chokepoint to meet short-term demand.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_iran_gulf_escalation</data>
</edge>
