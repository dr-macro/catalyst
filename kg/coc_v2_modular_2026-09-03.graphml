<edge source="us_iran_gulf_escalation::mine_incident_rate" target="global_bond_repricing::market_liquidity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising mine incidents raise insurance costs and margin volatility for energy and transport counterparties, prompting balance-sheet retrenchment by dealers and wider bid-ask spreads in fixed-income markets, reducing liquidity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_escalation</data>
  <data key="d40">global_bond_repricing</data>
</edge>
<edge source="us_iran_gulf_escalation::mine_incident_rate" target="global_oil_reordering::legal_sanctions_regime_s" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A rise in mine incidents attributable to actors in the escalation generates political pressure and evidentiary basis for states and coalitions to expand and tighten sanctions targeting responsible shipping firms, insurers and financial facilitators.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_escalation</data>
  <data key="d40">global_oil_reordering</data>
</edge>
<edge source="us_iran_gulf_escalation::mine_incident_rate" target="us_china_strategic_rival::ai_infra_concentration" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A jump in maritime mine incidents raises insurance costs and perceived transport risk for moving physical servers and components, incentivizing enterprises to consolidate onto a few large hyperscalers and managed providers that can guarantee hardened, redundant infrastructure, thereby increasing market concentration in AI infrastructure.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_iran_gulf_escalation</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
