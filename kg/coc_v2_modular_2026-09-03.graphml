<edge source="global_bond_repricing::policy_rate_level" target="global_oil_reordering::oil_export_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">An increase in policy short-term rates in major consuming economies raises borrowing costs and slows economic activity, reducing fuel demand and refinery crude purchases and thereby lowering physical oil shipments from exporters within months.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_repricing</data>
  <data key="d40">global_oil_reordering</data>
</edge>
<edge source="global_bond_repricing::policy_rate_level" target="us_china_strategic_rival::ai_infra_concentration" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Higher short-term policy rates increase bank lending and working-capital costs, disproportionately squeezing smaller cloud and colocation providers and accelerating M&amp;A and exits that concentrate AI infrastructure among large, well-capitalized incumbents.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_bond_repricing</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
<edge source="global_bond_repricing::policy_rate_level" target="us_iran_gulf_escalation::maritime_control_balance" id="0">
