<edge source="us_iran_gulf_escalation::crude_throughput_rate" target="global_bond_repricing::long_term_yield_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">An increase in crude throughput through the chokepoint eases global oil supply risk, reduces inflation and inflation-risk premia priced into long-dated government debt, and thus lowers long-term yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_escalation</data>
  <data key="d40">global_bond_repricing</data>
</edge>
<edge source="us_iran_gulf_escalation::crude_throughput_rate" target="us_china_strategic_rival::financial_exposure_ai" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A decline in crude throughput that tightens energy markets and lifts prices increases operating costs for data centers and raises macro risk, which depresses valuations and investor willingness to hold AI‑linked high‑growth assets, reducing measured financial exposure to AI.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_escalation</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
