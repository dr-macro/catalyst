  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="global_fuel_supply_shock::stock_release_rate" target="global_fuel_supply_shock::strategic_reserve_level" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="global_fuel_supply_shock::stock_release_rate" target="global_fuel_supply_shock::fuel_price_level" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">-</data>
</edge>
<edge source="global_fuel_supply_shock::stock_release_rate" target="global_fuel_supply_shock::market_supply_expectatio" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="global_fuel_supply_shock::stock_release_rate" target="hormuz_redsea_tensions::military_deploy_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Large strategic stock releases are typically accompanied by coordinated naval escorts, convoying and temporary force deployments to protect state‑sponsored shipments and guard supply lines, raising military presence in transit corridors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_fuel_supply_shock</data>
  <data key="d39">hormuz_redsea_tensions</data>
</edge>
<edge source="global_fuel_supply_shock::stock_release_rate" target="indo_pacific_rivalry::alliance_commitment_stoc" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Coordinated strategic stock releases between partners operationalize burden-sharing and demonstrate tangible reciprocity, strengthening perceptions of alliance reliability and formal/informal security commitment clarity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_fuel_supply_shock</data>
  <data key="d39">indo_pacific_rivalry</data>
</edge>
