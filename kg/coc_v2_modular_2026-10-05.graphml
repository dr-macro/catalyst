<edge source="hormuz_redsea_tensions::crude_inventory_levels" target="global_bond_rout::investor_net_bond_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sharp declines in onshore and floating crude stocks signal tighter near-term supply and higher inflation risk, prompting institutional and allocators to reduce duration exposure and rotate into real assets and commodities, producing net bond outflows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">global_bond_rout</data>
</edge>
<edge source="hormuz_redsea_tensions::crude_inventory_levels" target="global_fuel_supply_shock::stock_release_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Declining crude inventory buffers prompt authorities to increase strategic stock release rates to stabilize markets, while larger inventories allow reductions in release flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">global_fuel_supply_shock</data>
</edge>
<edge source="hormuz_redsea_tensions::crude_inventory_levels" target="russia_ukraine_war::sanctions_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Material declines in commercial and strategic crude stocks make import-dependent governments reluctant to expand or tighten energy sanctions on Russia for fear of precipitating supply shocks, reducing the intensity and scope of sanctions pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
