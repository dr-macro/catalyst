  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">-</data>
</edge>
<edge source="global_fuel_supply_shock::export_control_level" target="global_fuel_supply_shock::refined_inventory_level" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="global_fuel_supply_shock::export_control_level" target="global_fuel_supply_shock::fuel_price_level" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="global_fuel_supply_shock::export_control_level" target="global_fuel_supply_shock::market_supply_expectatio" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">-</data>
</edge>
<edge source="global_fuel_supply_shock::export_control_level" target="global_bond_rout::bond_market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.62</data>
  <data key="d36">Tighter export controls raise cross-border settlement frictions and counterparty risk, reducing non‑domestic dealer participation and repo/backstop capacity and thereby degrading bid-ask depth and immediacy in sovereign bond markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_fuel_supply_shock</data>
  <data key="d39">global_bond_rout</data>
</edge>
<edge source="global_fuel_supply_shock::export_control_level" target="hormuz_redsea_tensions::tanker_security_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter export controls prompt more covert ship‑to‑ship transfers, route deviations and interdiction/enforcement actions (by states or proxies), increasing exposure of tankers to harassment, seizure or attack.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_fuel_supply_shock</data>
  <data key="d39">hormuz_redsea_tensions</data>
</edge>
<edge source="global_fuel_supply_shock::export_control_level" target="indo_pacific_rivalry::financing_constraints" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Tighter export controls raise counterparty, trade and insurance risk for cross-border energy contracts, prompting banks and export credit agencies to pull back or add restrictive covenants, thereby increasing infrastructure financing constraints for projects in the region.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_fuel_supply_shock</data>
  <data key="d39">indo_pacific_rivalry</data>
</edge>
<edge source="global_fuel_supply_shock::export_control_level" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">More restrictive or uneven export controls on fuels by some suppliers force alliance members into competing national carve‑outs and bilateral deals to secure supplies, producing diplomatic friction and weakening coordinated political and military alignment.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_fuel_supply_shock</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_fuel_supply_shock::coord_release_strength" target="global_fuel_supply_shock::refined_inventory_level" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
