<edge source="russia_ukraine_war::defense_funding" target="global_bond_rout::long_benchmark_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained increases in pledged and disbursed defense spending among multiple sovereigns raise expected future borrowing needs and issuance, putting upward pressure on long-term sovereign yields as markets price higher supply and fiscal risk.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_bond_rout</data>
</edge>
<edge source="russia_ukraine_war::defense_funding" target="hormuz_redsea_tensions::military_deploy_intensit" id="0">
