  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="hormuz_redsea_tensions::tanker_security_risk" target="hormuz_redsea_tensions::freight_rate_levels" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="hormuz_redsea_tensions::tanker_security_risk" target="hormuz_redsea_tensions::military_deploy_intensit" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="hormuz_redsea_tensions::tanker_security_risk" target="global_bond_rout::bond_market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Acute attacks or interdictions raise sudden uncertainty about energy flows and insurance/FX exposures, triggering rapid repositioning and heavier, more erratic trading in sovereign bonds which increases realized and implied bond-market volatility.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">global_bond_rout</data>
</edge>
<edge source="hormuz_redsea_tensions::tanker_security_risk" target="global_fuel_supply_shock::fuel_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising tanker security risk raises shipping insurance and freight costs, forces rerouting and delays, and reduces delivered volumes which directly lifts wholesale and pump fuel prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">global_fuel_supply_shock</data>
</edge>
<edge source="hormuz_redsea_tensions::tanker_security_risk" target="indo_pacific_rivalry::crisis_escalation_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A spike in tanker attacks or interdictions precipitates immediate naval escorts, interdiction/retaliation operations and bilateral military encounters that directly raise the propensity for incidents in the Indo‑Pacific to escalate into broader crises.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">indo_pacific_rivalry</data>
</edge>
<edge source="hormuz_redsea_tensions::tanker_security_risk" target="russia_ukraine_war::defense_funding" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A spike in attacks or interdictions against merchant shipping creates immediate domestic and parliamentary pressure in supporting states to bolster naval and related defence budgets, increasing available defense funding that can be applied to Ukraine-related capabilities.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
