<edge source="global_bond_rout::bond_market_volatility" target="global_fuel_supply_shock::market_supply_expectatio" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute bond-market volatility increases counterparty and financing risk for cross-border fuel trades, reducing willingness to carry forward positions and causing market participants to expect tighter near-term fuel availability.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_rout</data>
  <data key="d39">global_fuel_supply_shock</data>
</edge>
<edge source="global_bond_rout::bond_market_volatility" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sharp increases in bond-market volatility produce asymmetric economic impacts and domestic political pressure across allied states, incentivizing some governments to prioritize near-term economic stabilization over coordinated political or military burden‑sharing, weakening cohesion.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_rout</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
