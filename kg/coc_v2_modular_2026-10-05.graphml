<edge source="global_bond_rout::bank_funding_stress" target="global_fuel_supply_shock::refined_inventory_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising bank funding stress tightens trade and working-capital finance for refiners and fuel traders, forcing delayed imports or accelerated sales to cover liquidity needs and thereby reducing on-hand refined-fuel inventories.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_rout</data>
  <data key="d39">global_fuel_supply_shock</data>
</edge>
<edge source="global_bond_rout::bank_funding_stress" target="indo_pacific_rivalry::alliance_commitment_stoc" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Elevated bank funding stress forces governments to divert fiscal and liquidity resources to domestic financial stability and recapitalization, constraining budgets and political space for sustaining forward deployments and defence aid, thereby weakening alliance commitment credibility.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_bond_rout</data>
  <data key="d39">indo_pacific_rivalry</data>
</edge>
<edge source="global_bond_rout::bank_funding_stress" target="russia_ukraine_war::defense_funding" id="0">
