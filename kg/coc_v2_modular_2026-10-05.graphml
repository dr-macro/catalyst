  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A surge in concentrated military deployments elevates counterparty and operational risk, prompting dealers and market-makers to cut inventory, widen spreads and reduce willingness to warehouse duration, thereby degrading bond-market liquidity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">global_bond_rout</data>
</edge>
<edge source="hormuz_redsea_tensions::military_deploy_intensit" target="indo_pacific_rivalry::alliance_commitment_stoc" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained increases in deployments to protect energy corridors trigger formal assurance measures, burden‑sharing negotiations and visible capability rotations with Indo‑Pacific partners, consolidating and clarifying alliance commitments.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">indo_pacific_rivalry</data>
</edge>
<edge source="hormuz_redsea_tensions::military_deploy_intensit" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained increases in allied deployments to protect Hormuz/Red Sea lanes force uneven burden-sharing and political trade-offs among partners, producing intra-alliance disputes over priorities and thereby reducing coordinated cohesion on Ukraine policy.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_redsea_tensions</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
