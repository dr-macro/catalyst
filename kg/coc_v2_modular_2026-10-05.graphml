<edge source="global_fuel_supply_shock::fuel_price_level" target="global_fuel_supply_shock::consumer_inflation_rate" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="global_fuel_supply_shock::fuel_price_level" target="global_fuel_supply_shock::bond_yield_level" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="global_fuel_supply_shock::fuel_price_level" target="global_bond_rout::long_benchmark_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A rapid rise in fuel prices lifts headline inflation and expected future policy rates and term premia, causing investors to demand higher yields on long-dated sovereign paper.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_fuel_supply_shock</data>
  <data key="d39">global_bond_rout</data>
</edge>
<edge source="global_fuel_supply_shock::fuel_price_level" target="indo_pacific_rivalry::strategic_investment_flo" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained higher fuel prices increase returns and political priority for energy-security projects, attracting cross-border capital into refineries, storage and alternative-fuel infrastructure in the Indo-Pacific and redirecting strategic investment flows toward energy suppliers and guarantors.</data>
  <data key="d37">6-18 months</data>
