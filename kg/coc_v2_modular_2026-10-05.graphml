  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="global_fuel_supply_shock::coord_release_strength" target="global_fuel_supply_shock::market_supply_expectatio" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
