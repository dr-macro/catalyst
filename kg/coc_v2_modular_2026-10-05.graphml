<edge source="indo_pacific_rivalry::crisis_escalation_risk" target="global_bond_rout::bond_market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Acute rise in military/diplomatic escalation risk triggers rapid portfolio rebalancing and hedging across sovereign debt markets, spiking realized and implied bond volatility as traders widen risk premia and run protection trades.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">indo_pacific_rivalry</data>
  <data key="d39">global_bond_rout</data>
</edge>
<edge source="indo_pacific_rivalry::crisis_escalation_risk" target="global_bond_rout::bank_funding_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Heightened crisis risk increases counterparty, settlement and rollover uncertainty for banks with regional exposure, prompting liquidity hoarding and higher wholesale funding costs that raise bank funding stress.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">indo_pacific_rivalry</data>
  <data key="d39">global_bond_rout</data>
</edge>
