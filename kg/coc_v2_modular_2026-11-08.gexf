      <edge source="global_market_repricing::unemployment_rate" target="ai_buildout_backlash::policy_uncertainty_ai" id="623">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="An increase in unemployment raises political and public pressure over job dislocation from automation/AI, spurring more frequent legislative proposals and regulatory debate and thereby elevating uncertainty about future AI/data‑centre rules." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_market_repricing" />
          <attvalue for="39" value="ai_buildout_backlash" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_market_repricing::unemployment_rate" target="china_tech_rivalry::regulatory_tightness" id="624">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sharp increase in global (and export‑dependent) unemployment weakens external demand, incentivising Beijing to protect domestic employment and strategic domestic champions via tighter, more interventionist regulation and preferential rules for local firms." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_repricing" />
          <attvalue for="39" value="china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_market_repricing::unemployment_rate" target="russia_ukraine_war::transatl_cohesion" id="625">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Higher unemployment intensifies domestic political pressure to prioritize social and economic relief, eroding public and parliamentary support for sustained allied burden‑sharing and coordinated assistance to Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_repricing" />
