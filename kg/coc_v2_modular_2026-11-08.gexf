          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Tighter Chinese export and outbound controls on semiconductors, sensors and drone components directly restrict the ability of China‑based manufacturers and brokers to supply or re‑export key parts used in Russian UAVs, guidance kits and munitions, reducing the rate of arms and munitions delivered into Russia's procurement chains." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
