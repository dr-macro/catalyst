          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A rise in observable arms shipments and transits linked to Iran prompts U.S. kinetic interdiction operations and strikes against shipment routes, storage nodes or proxy networks in the Middle East to disrupt transfers and deter further deliveries." />
