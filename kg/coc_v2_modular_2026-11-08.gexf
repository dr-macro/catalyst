          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger perceived deterrence lowers the probability of conflict escalation and safe‑haven demand, supporting growth and inflation expectations and thus raising market‑implied future policy‑rate expectations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_market_repricing" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::deterrence_perception" target="us_iran_escalation::escalation_pressure" id="430">
        <attvalues>
