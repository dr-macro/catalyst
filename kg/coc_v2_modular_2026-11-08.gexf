      <edge source="russia_ukraine_war::deterrence_perception" target="china_tech_rivalry::regulatory_tightness" id="428">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="If the Russia war undermines confidence in existing deterrence frameworks, governments respond by expanding precautionary regulatory interventions (export vetting, security reviews, emergency authority for tech controls) that increase overall regulatory restrictiveness affecting strategic tech ties with China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::deterrence_perception" target="global_market_repricing::interest_rate_expect" id="429">
        <attvalues>
