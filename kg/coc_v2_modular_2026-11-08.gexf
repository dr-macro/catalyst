      <edge source="us_iran_escalation::chokepoint_vulnerability" target="china_tech_rivalry::foreign_firm_risk" id="221">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Greater vulnerability of Persian Gulf and nearby sea lanes increases shipping disruptions, delay risk and insurance premiums for supply chains linking to China, causing multinational firms to regard operations tied to China as higher operational and reputational risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_escalation" />
          <attvalue for="39" value="china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
