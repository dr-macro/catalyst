      <edge source="ai_buildout_backlash::policy_uncertainty_ai" target="china_tech_rivalry::regulatory_tightness" id="86">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rising uncertainty about AI rules and data‑centre policy leads regulators to impose clearer, more prescriptive and precautionary measures (moratoria, licensing, compliance mandates) to reduce perceived risk and restore control." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_buildout_backlash" />
          <attvalue for="39" value="china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
