          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained increases in state‑directed investment raise demand for commodities and intermediate goods (metals, energy, semiconductors inputs), tightening global supply/demand balances and lifting headline goods prices." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="china_tech_rivalry" />
          <attvalue for="39" value="global_market_repricing" />
          <attvalue for="28" value="0" />
