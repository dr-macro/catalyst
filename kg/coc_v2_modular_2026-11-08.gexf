          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Physical threats or interdiction of major maritime transit (e.g., Strait of Hormuz) constrains oil and commodity flows and raises freight/energy costs, which pass through quickly to consumer prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_escalation" />
          <attvalue for="39" value="global_market_repricing" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_escalation::chokepoint_vulnerability" target="russia_ukraine_war::energy_supply_stability" id="223">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising vulnerability of key Persian Gulf transit chokepoints (e.g., Strait of Hormuz) from US–Iran tensions causes immediate disruptions and insurance/shipping reroutes that reduce and destabilize energy deliveries and fuel availability for European and regional consumers relevant to the Ukraine theatre." />
