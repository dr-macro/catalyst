          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained uptick in arms and munitions deliveries forces governments to accelerate procurement spending and financing, increasing near‑term sovereign debt issuance and pushing yields higher." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_market_repricing" />
