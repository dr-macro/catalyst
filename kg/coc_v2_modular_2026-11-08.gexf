          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="An improvement in energy supply stability quickly lowers wholesale and retail energy prices and caps passthrough to consumer energy bills, directly reducing headline CPI readings." />
