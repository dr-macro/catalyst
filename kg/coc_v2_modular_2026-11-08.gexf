          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Increased transfers of Iranian-origin weapons or dual-use materiel to Russia for use in Ukraine trigger U.S. and allied secondary sanctions and expanded listings against the Iranian suppliers, shippers and financial facilitators directly tied to those flows." />
