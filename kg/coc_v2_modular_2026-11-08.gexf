      <edge source="russia_ukraine_war::deterrence_perception" target="ai_buildout_backlash::credit_spreads_datactr" id="427">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A clearer perception of credible deterrence lowers the assessed probability of kinetic or targeted attacks on critical infrastructure, leading lenders to demand smaller risk premia on data‑centre loans and bonds." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_buildout_backlash" />
