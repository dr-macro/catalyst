          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="When the state directs capital, offers subsidies or guarantees to strategic tech and AI firms, it directly injects capital and reduces perceived project risk, which attracts additional private equity and portfolio investment into AI‑linked equities." />
