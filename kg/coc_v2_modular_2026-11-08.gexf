          <attvalue for="36" value="Broader and stricter export controls raise country‑specific geopolitical and counterparty risks, prompting capital reallocation and higher sovereign risk premia that push up benchmark government bond yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_tech_rivalry" />
          <attvalue for="39" value="global_market_repricing" />
