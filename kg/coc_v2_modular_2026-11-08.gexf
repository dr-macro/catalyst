          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Stricter Chinese outbound controls on dual‑use components and surveillance/communications gear reduce Iran's near‑term access to technology used for targeting, ISR, and guidance, degrading its ability to mount or sustain proximate hostile actions and thereby lowering escalation pressure." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="china_tech_rivalry" />
          <attvalue for="39" value="us_iran_escalation" />
