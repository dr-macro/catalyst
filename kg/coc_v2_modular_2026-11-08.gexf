          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="If the Russia–Ukraine fighting strengthens allied deterrence perceptions (i.e., opponents see Western punitive capacity as credible), Iranian leaders and proxies are less likely to risk escalatory actions against U.S. forces and interests, reducing immediate escalation pressure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_iran_escalation" />
          <attvalue for="28" value="0" />
