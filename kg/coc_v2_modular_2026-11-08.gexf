          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Broadening or tightening outbound export controls creates immediate ambiguity about which AI components, cloud services, or data flows will be allowed, forcing firms to reassess compliance and build contingency plans, which raises measured policy uncertainty about AI and data‑centre rules." />
