      <edge source="ai_buildout_backlash::policy_uncertainty_ai" target="global_market_repricing::interest_rate_expect" id="87">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An increase in regulatory and policy uncertainty around AI causes markets to downgrade near‑term growth and prompt expectations that central banks will delay or slow further tightening, lowering market‑implied future policy rate paths." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_buildout_backlash" />
          <attvalue for="39" value="global_market_repricing" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_buildout_backlash::policy_uncertainty_ai" target="russia_ukraine_war::transatl_cohesion" id="88">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising uncertainty and divergent national approaches to AI export controls and data‑centre regulation produce bilateral disputes and slow coordination on export/dual‑use rules and intelligence sharing, directly eroding allied policy alignment and burden‑sharing." />
          <attvalue for="37" value="0-12 months" />
          <attvalue for="38" value="ai_buildout_backlash" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_buildout_backlash::policy_uncertainty_ai" target="russia_ukraine_war::arms_supply_flow" id="89">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Unclear or changing rules on AI‑enabled systems and data exports generate delays and legal reviews in export licensing and procurement approvals, directly slowing the authorization and shipment of AI‑enabled munitions and sensors to Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_buildout_backlash" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_buildout_backlash::policy_uncertainty_ai" target="us_iran_escalation::sanctions_pressure_level" id="90">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Spikes in AI policy uncertainty prompt policymakers to adopt precautionary export controls and broaden sanction designations on entities and intermediaries tied to AI hardware and services to prevent perceived uncontrolled transfer, thereby increasing aggregate sanctions pressure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_buildout_backlash" />
          <attvalue for="39" value="us_iran_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
