          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sustained Western arms flows to Ukraine provoke sharper rhetorical responses, diplomatic countermeasures, and closer operational alignment between Russia and China, which in turn elicit punitive measures and heightened bilateral friction between Western capitals and Beijing." />
          <attvalue for="37" value="0-6 months" />
