          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising uncertainty about AI rules drives the US and its partners to intensify bilateral and multilateral diplomatic outreach and backchannel coordination to align export rules and deconflict regional risks, increasing diplomatic engagement intensity with actors in the Iran theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_buildout_backlash" />
