      <edge source="us_iran_escalation::chokepoint_vulnerability" target="ai_buildout_backlash::credit_spreads_datactr" id="220">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Heightened vulnerability of maritime and land transit nodes raises the perceived risk that hardware deliveries and construction timelines will be disrupted, prompting lenders to demand wider spreads on data‑centre loans to cover increased operational and replacement risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_escalation" />
          <attvalue for="39" value="ai_buildout_backlash" />
