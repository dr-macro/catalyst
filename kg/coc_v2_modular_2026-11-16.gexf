          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained higher futures prices raise the value of successful supply shocks and increase net revenue available to state and proxy actors, incentivizing more maritime harassment and attacks to extract concessions or influence market flows." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_oil_rebalance" />
          <attvalue for="38" value="iran_gulf_escalation" />
