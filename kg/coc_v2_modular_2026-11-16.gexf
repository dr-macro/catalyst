          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Proliferation of autonomous AI agents enables remote coordination and dynamic targeting of unmanned surface/air systems and loitering munitions against commercial vessels, increasing the frequency and effectiveness of kinetic attacks." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="comms_cyber_warfare" />
