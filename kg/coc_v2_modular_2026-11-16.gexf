          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher capital‑flow volatility tightens external and project financing conditions for marginal oil producers and service firms, lowering market expectations of future crude supply availability." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="transatlantic_cohesion" />
          <attvalue for="38" value="global_oil_rebalance" />
          <attvalue for="27" value="0" />
