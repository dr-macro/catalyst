          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Large new or expanded committed funding signals to traders that the conflict and associated export disruptions are likely to be prolonged, shifting aggregated expectations toward tighter future crude availability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_oil_rebalance" />
          <attvalue for="27" value="0" />
