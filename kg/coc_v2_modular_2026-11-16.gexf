          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in crude futures lifts expectations for energy and logistics costs, compressing forward cash‑flow multiples for high‑burn tech/AI firms and triggering de‑risking and de‑rating in valuation‑driven segments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_rebalance" />
