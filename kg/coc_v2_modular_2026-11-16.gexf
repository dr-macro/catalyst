          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A spike in maritime attacks raises perceived geopolitical and trade risk for shipping‑exposed and EM assets, prompting rapid portfolio rebalancing and sudden cross‑border outflows that increase capital‑flow volatility in transatlantic markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
