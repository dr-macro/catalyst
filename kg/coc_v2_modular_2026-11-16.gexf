          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in attacks on commercial shipping forces divergent policy responses (some states emphasize de‑escalation and energy security, others punitive measures), producing inconsistent messaging and eroding unified diplomatic positioning toward Russia and related sanctions coordination." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
