          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Spikes in cross‑border capital‑flow volatility tighten reinsurer/investor capacity and raise risk premia for underwriting, leading insurers to impose higher premiums and surcharges on vessels operating in the Gulf." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="transatlantic_cohesion" />
          <attvalue for="38" value="iran_gulf_escalation" />
