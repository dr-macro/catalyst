          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A larger population of autonomous trading and analytic agents rapidly ingests and amplifies spoofed or compromised telemetry (e.g., fake AIS, terminal status, pipeline SCADA signals), causing aggregated market participants to update expectations toward tighter future supply." />
          <attvalue for="36" value="0-6 months" />
