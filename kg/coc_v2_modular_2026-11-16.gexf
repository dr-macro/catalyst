          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A surge in military aid to Ukraine prompts US/NATO to reassign surface combatants, escorts and logistical support from the Persian Gulf toward European seas and Atlantic/Mediterranean staging, directly reducing aggregate naval presence in the Gulf theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_escalation" />
