      <edge source="comms_cyber_warfare::systemic_coupling" target="global_oil_rebalance::chokepoint_disruption" id="587">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher systemic coupling—greater integration of port operations, AIS/ship-management systems and corporate networks—makes malware or ransomware incidents more likely to propagate into navigation, terminal scheduling and ICS, producing immediate container/traffic stoppages and delays at maritime chokepoints." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="comms_cyber_warfare" />
          <attvalue for="38" value="global_oil_rebalance" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="comms_cyber_warfare::systemic_coupling" target="global_oil_rebalance::global_crude_supply" id="588">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Stronger interconnections between corporate IT and operational technology at fields, pipelines and refineries allow cyber intrusions to reach OT controls and trigger shutdowns or production throttling, causing measurable reductions in crude throughput and exports." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="comms_cyber_warfare" />
          <attvalue for="38" value="global_oil_rebalance" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="comms_cyber_warfare::systemic_coupling" target="iran_gulf_escalation::shipping_throughput" id="589">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Stronger interconnection among port control systems, AIS, logistics platforms and carriers means a single communications or cyber disruption cascades into berth closures, cargo-processing stoppages and scheduling collapse, reducing throughput." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="comms_cyber_warfare" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="comms_cyber_warfare::systemic_coupling" target="iran_gulf_escalation::naval_deployment_lvl" id="590">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="As critical communications and logistics systems become more tightly coupled, regional governments and external navies respond to heightened risk of cyber-driven disruption by forward-deploying surface and subsurface assets to physically secure choke points and reassure shipping." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="comms_cyber_warfare" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="comms_cyber_warfare::systemic_coupling" target="russia_ukraine_war::tech_control_leverage" id="591">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Greater coupling of communications, cloud and supply‑chain nodes creates chokepoints and third‑party dependencies that actors who control or disrupt those nodes can exploit to exert operational and diplomatic leverage over battlefield communications and ISR." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="comms_cyber_warfare" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="comms_cyber_warfare::systemic_coupling" target="transatlantic_cohesion::capital_flow_volatility" id="592">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Greater systemic coupling (interconnected payment, clearing, and market infrastructures) causes local outages or cyber incidents to trigger rapid cross‑border rebalancing and withdrawal by funds and counterparties, increasing the speed and variance of capital flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="comms_cyber_warfare" />
