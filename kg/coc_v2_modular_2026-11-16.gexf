        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp increases in insurance premiums and war-risk surcharges for shipments routing near the Gulf raise transport costs and cause carriers to delay or reroute high-value military shipments, reducing the effective delivery rate of materiel to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
