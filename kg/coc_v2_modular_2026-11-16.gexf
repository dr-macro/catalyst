      <edge source="iran_gulf_escalation::shipping_throughput" target="comms_cyber_warfare::ai_agent_prevalence" id="248">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained drops in throughput delay delivery of GPUs, accelerators and prebuilt servers to cloud providers and enterprises, slowing rollouts of transaction‑capable and edge AI agents and reducing near‑term agent deployment prevalence." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="comms_cyber_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::energy_export_flow" target="iran_gulf_escalation::shipping_throughput" id="249">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="2" />
          <attvalue for="32" value="+" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::energy_export_flow" target="comms_cyber_warfare::compute_infra_utilizatio" id="250">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A sharp fall in Gulf hydrocarbon/LNG shipments forces importing countries to ration fuel or face large electricity price spikes, causing hyperscalers and on-prem data centres to throttle or postpone energy‑intensive AI training and batch workloads, reducing compute utilization." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="comms_cyber_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::energy_export_flow" target="global_oil_rebalance::global_crude_supply" id="251">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.95" />
          <attvalue for="35" value="A rise or fall in the physical rate of hydrocarbon and LNG shipments leaving the region directly changes the volumetric amount of crude available on international markets, immediately altering global supply." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="global_oil_rebalance" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::energy_export_flow" target="transatlantic_cohesion::cb_expectations" id="252">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="An increase in Gulf energy export flows eases global supply pressures and lowers near‑term inflation risk, reducing market odds of central‑bank tightening (and conversely, a drop in flows raises tightening expectations)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="transatlantic_cohesion" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
