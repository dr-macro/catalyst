          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Military aid packages increasingly include autonomous systems (loitering munitions, autonomous ISR drones, autonomy-enabled munitions), directly increasing the deployed stock of autonomous AI agents in the operational battlespace." />
