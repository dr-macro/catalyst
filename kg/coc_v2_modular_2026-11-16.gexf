          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Visible increases in allied naval deployments force governments into contested decisions over military posture, sanctions and convoy rules, heightening perceived unpredictability about future public‑policy choices among transatlantic actors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="transatlantic_cohesion" />
          <attvalue for="27" value="0" />
