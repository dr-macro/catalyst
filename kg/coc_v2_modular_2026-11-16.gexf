      <edge source="iran_gulf_escalation::maritime_attack_rate" target="global_oil_rebalance::crude_futures_price" id="200">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Spikes in attacks on tankers increase immediate loss/rerouting risk and force market participants to pay a risk premium or cover anticipated shortfalls, driving up traded crude futures prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="global_oil_rebalance" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::maritime_attack_rate" target="global_oil_rebalance::market_supply_expect" id="201">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in reported maritime attacks causes traders and physical traders to revise forward-looking assessments toward greater likelihood of shipment interruptions, raising expectations of tighter future supply." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="global_oil_rebalance" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::maritime_attack_rate" target="russia_ukraine_war::diplomatic_cohesion" id="202">
        <attvalues>
