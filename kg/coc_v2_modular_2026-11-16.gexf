        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising insurance premiums and risk surcharges materially raise unit costs and delivery risk for hardware‑intensive AI firms, prompting investors to mark down growth multiples and cool speculative valuations in the AI/tech sector." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="comms_cyber_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
