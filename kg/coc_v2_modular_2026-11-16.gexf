          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Large committed government contracts and reconstruction/defense funding raise expected future revenues for defense-tech and AI suppliers, which fuels investor speculation and upward re-rating of related technology and AI assets." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="comms_cyber_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
