          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Increased deliveries of long‑range and anti‑ship weaponry to frontline actors raise the likelihood of strikes, mines, and defensive countermeasures in and around maritime approaches, producing more interruptions and delays at regional chokepoints." />
