      <edge source="transatlantic_cohesion::capital_flow_volatility" target="comms_cyber_warfare::systemic_coupling" id="804">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Spikes in cross‑border capital‑flow volatility force rapid balance‑sheet adjustments and reliance on common liquidity providers and contracts, immediately strengthening interdependencies across markets and infrastructure nodes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="transatlantic_cohesion" />
          <attvalue for="38" value="comms_cyber_warfare" />
