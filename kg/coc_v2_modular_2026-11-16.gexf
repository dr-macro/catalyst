      <edge source="iran_gulf_escalation::naval_deployment_lvl" target="global_oil_rebalance::chokepoint_disruption" id="219">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Increased naval presence (inspections, convoying, blockades or restricted zones) mechanically lengthens transit times and forces rerouting, producing measurable disruptions and delays at strategic chokepoints." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="global_oil_rebalance" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::naval_deployment_lvl" target="russia_ukraine_war::military_aid_flow" id="220">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Reallocation of US/Allied naval and logistical assets and escorts to the Gulf reduces lift, port access prioritization and operational bandwidth for transatlantic transfers of heavy equipment, slowing the rate at which major weapons and platforms are committed to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
