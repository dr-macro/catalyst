          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A sustained drop in diesel import volumes directly reduces delivered fuel to power plants, transport fleets and industrial users in import-dependent states, causing immediate outages, rationing and delayed fuel-dependent services." />
