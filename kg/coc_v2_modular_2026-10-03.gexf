          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Tighter AI-related export controls provoke reciprocal trade measures and disruption of cross‑border flows of refinery catalysts, specialized equipment, and spare parts, constraining diesel supply chains and pushing up spot prices." />
