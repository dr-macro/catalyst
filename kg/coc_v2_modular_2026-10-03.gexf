          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Direct damage to refineries, port closures, export bans or interdictions tied to the war reduce the volume of diesel that exporters can deliver to international markets, cutting the global diesel supply rate." />
