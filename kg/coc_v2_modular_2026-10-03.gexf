          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Outages or shipment losses in Middle Eastern crude/LNG and refined products reduce global available supply to European and global markets, driving up wholesale energy prices that directly raise the energy price level relevant to the Russia–Ukraine theatre." />
