      <edge source="global_fuel_shock::diesel_spot_price" target="global_bond_rout::long_nominal_yields" id="715">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sustained rise in diesel spot prices increases headline and core inflation expectations and the inflation risk premium, causing investors to demand higher yields on long-dated government debt." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="global_bond_rout" />
