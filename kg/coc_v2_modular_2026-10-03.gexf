      <edge source="mideast_escalation::energy_supply_disruption" target="global_fuel_shock::diesel_supply_rate" id="251">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Physical damage to refineries, pipeline closures or seizure of export facilities in the Middle East immediately removes refined diesel volumes from international shipments, reducing the rate of diesel entering global markets." />
          <attvalue for="37" value="0-6 months" />
