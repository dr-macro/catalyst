          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalating export restrictions on strategic AI hardware increase bilateral friction and precipitate diplomatic and economic countermeasures, raising measured geopolitical tension that affects energy markets." />
