      <edge source="global_fuel_shock::diesel_spot_price" target="global_bond_rout::financial_conditions" id="716">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher diesel prices push up input costs and inflation, prompting central banks to tighten policy and raising borrowing costs and credit spreads, which directly tightens aggregate financial conditions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="global_bond_rout" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_shock::diesel_spot_price" target="mideast_escalation::regional_security_risk" id="717">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sharp diesel price spikes raise household and transport costs in fuel-importing economies, triggering protests, strikes and increased smuggling that elevate the frequency and intensity of local and cross-border security incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="mideast_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_shock::diesel_spot_price" target="mideast_escalation::oil_price_volatility" id="718">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Large, rapid moves in diesel spot prices force refiners and traders to change crude slates, hedges and shipment schedules, generating amplified short-term swings in broader oil and refined-product prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="mideast_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_shock::diesel_spot_price" target="russia_ukraine_war::inflation_rate" id="719">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising diesel spot prices increase transport and input costs for food and goods across the affected economies, directly feeding through to consumer prices and raising measured inflation rates in the short term." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
