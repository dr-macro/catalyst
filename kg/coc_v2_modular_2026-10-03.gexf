          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp increases in diesel spot prices raise operational and logistics costs for data centers, training runs, and hardware supply chains, compressing near-term returns and leading investors to pull back or reallocate capital away from AI projects with tight margins." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="us_china_rivalry" />
