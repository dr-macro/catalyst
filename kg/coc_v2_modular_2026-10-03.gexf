      <edge source="mideast_escalation::energy_supply_disruption" target="global_bond_rout::long_nominal_yields" id="250">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Sudden removal or delay of crude/refined flows raises global energy prices and near-term inflation expectations and forces a higher term premium as investors demand compensation for elevated inflation and geopolitical risk, pushing long-dated government yields up." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="mideast_escalation" />
