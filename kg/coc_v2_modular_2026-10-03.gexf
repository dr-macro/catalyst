      <edge source="global_fuel_shock::geopolitical_tension" target="global_bond_rout::cross_border_flows" id="745">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising geopolitical tension produces sanctions, correspondent-bank restrictions and settlement frictions that directly interrupt cross-border payments and capital transactions, reducing net cross-border flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="global_bond_rout" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_shock::geopolitical_tension" target="mideast_escalation::maritime_transit_risk" id="746">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Rising geopolitical tension increases the probability of state or non-state hostile actions (attacks, interdictions, increased naval escorts or closures) in key chokepoints, directly raising the risk of shipping disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="mideast_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_shock::geopolitical_tension" target="russia_ukraine_war::energy_price_level" id="747">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="An increase in geopolitical tension raises risk premia, insurance and rerouting costs for fuel shipments and prompts buyers to pay premiums for secure supply, directly lifting wholesale and retail energy prices in the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_fuel_shock::geopolitical_tension" target="us_china_rivalry::export_control_tightness" id="748">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Fuel-related geopolitical frictions prompt governments to securitize trade relationships and respond politically, accelerating and tightening export controls on AI-relevant hardware and dual-use technologies aimed at rival states." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_fuel_shock" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
