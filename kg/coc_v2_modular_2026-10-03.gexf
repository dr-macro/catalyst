          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A reduction in diesel import flows into the theatre causes immediate shortfalls for transport, backup generators and heating in frontline and civilian systems, producing measurable interruptions to energy services and deliveries." />
