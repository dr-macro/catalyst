      <edge source="russia_ukraine_war::security_threat_intensit" target="global_bond_rout::investor_risk_aversion" id="402">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalations in military and hybrid threats raise perceived tail‑risk and operational uncertainty for cross‑border investment, directly increasing investor risk aversion and preference for safe assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_rout" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_threat_intensit" target="global_bond_rout::cross_border_flows" id="403">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Heightened security threats trigger accelerated private capital outflows, repatriation and precautionary withdrawal of foreign credit lines from exposed jurisdictions and corridors, reducing net cross‑border inflows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_rout" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_threat_intensit" target="global_fuel_shock::diesel_inventory_level" id="404">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating military and hybrid threats prompt commercial buyers and some governments to increase precautionary stockpiles of diesel and delay outbound shipments, raising aggregated inventory levels in the near term." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_fuel_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_threat_intensit" target="mideast_escalation::regional_security_risk" id="405">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained high-intensity operations in Ukraine force Western militaries to reallocate assets and political attention away from the Middle East, creating windows for regional states and proxies to press advantages and carry out cross-border attacks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="mideast_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_threat_intensit" target="us_china_rivalry::export_control_tightness" id="406">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Escalation of military and hybrid threats around the Russia–Ukraine war prompts the US and allies to broaden and tighten national‑security export controls on dual‑use AI hardware and software to limit adversary access." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_threat_intensit" target="us_china_rivalry::semiconductor_supply" id="407">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising conflict intensity drives sanctions, targeted restrictions, and logistical disruptions (including curtailed exports of critical materials and transport interruptions), directly reducing available inputs and operational continuity for semiconductor fabs and lowering chip throughput." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_threat_intensit" target="us_china_rivalry::investment_flow_to_ai" id="408">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Greater perceived geopolitical and military risk increases government defense R&amp;D and attracts private capital into security‑oriented AI startups and capabilities as investors reposition toward technologies deemed strategic in the US–China competition." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
