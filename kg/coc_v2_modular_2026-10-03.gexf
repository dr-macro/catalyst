          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Reduced availability of advanced and legacy chips (PLCs, sensors, control units) used in refinery automation and maintenance leads to unplanned outages and lower refinery throughput, cutting diesel output." />
