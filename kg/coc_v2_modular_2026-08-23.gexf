          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Higher risk of kinetic or coercive escalation increases uncertainty and rapid repricing of geopolitical risk premia, producing sharp swings in bond prices and implied/realized volatility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="us_debt_bond_stress" />
