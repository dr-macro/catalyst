      <edge source="us_china_tech_trade::crossborder_restriction" target="north_korea_nuclear::geopolitical_tension" id="595">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="New or tightened US-China AI export controls and trade restrictions provoke diplomatic reprisals, public signaling and reciprocal measures that directly escalate strategic rivalry and tension in the Korean Peninsula security environment." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::crossborder_restriction" target="north_korea_nuclear::alliance_cohesion" id="596">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="US-imposed cross-border AI trade controls put pressure on South Korea and Japan to align licensing, screening and export-control policies, producing more near-term diplomatic coordination and policy cohesion among those allies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::crossborder_restriction" target="russia_ukraine_war::external_arms_supply_rat" id="597">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Tighter US–China cross-border export controls and trade barriers choke off shipments of semiconductors, inertial/GNSS components and other dual‑use parts used by third‑party suppliers and Russian assemblers, directly reducing the tempo of externally sourced weapons and munitions arriving into the Russia–Ukraine theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::crossborder_restriction" target="us_debt_bond_stress::cross_border_capital" id="598">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter cross-border tech/trade restrictions trigger immediate reductions in foreign investors' ability and willingness to hold domestic bonds (forced sales, reduced new purchases, and slower repatriation arrangements), producing measurable net outflows of international capital into/out of the bond market." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::crossborder_restriction" target="us_debt_bond_stress::market_liquidity" id="599">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher cross-border restrictions reduce participation by foreign dealers and repo counterparties and raise compliance/frictional costs for cross-border trading, which directly thins interdealer depth and widens bid-offer spreads in the bond market." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="us_debt_bond_stress" />
