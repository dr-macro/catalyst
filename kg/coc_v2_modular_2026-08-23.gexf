          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Spikes in missile tests, live-fire drills or near-shore naval maneuvers cause sudden repricing of geopolitical risk and prompt rapid hedging and position-squaring in Treasury futures and options, creating sharp increases in realized and implied fixed-income volatility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="north_korea_nuclear" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
