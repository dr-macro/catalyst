          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained uptick in North Korean missile tests and munitions production increases DPRK surplus stocks and political leverage, enabling faster, larger transfers of artillery, rockets and munitions to Russia for use in Ukraine." />
