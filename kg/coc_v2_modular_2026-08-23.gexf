      <edge source="russia_ukraine_war::strike_campaign_intensit" target="north_korea_nuclear::military_activity" id="178">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sustained high-rate long-range strike and drone use in Ukraine prompts North Korean leadership to accelerate and publicize its own missile/rocket tests and launch activity to validate doctrines and signal deterrence." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::strike_campaign_intensit" target="us_china_tech_trade::crossborder_restriction" id="179">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="More intensive long-range and unmanned strikes produce clearer forensic evidence of dual‑use components and supply-chain links (e.g., commercial drone parts, avionics) traceable to Chinese suppliers, prompting targeted export restrictions and customs enforcement that raise cross-border limits on relevant tech flows to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::strike_campaign_intensit" target="us_debt_bond_stress::long_term_yields" id="180">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained uptick in long-range strike intensity raises the probability of broader commodity and supply shocks and increases term premium and inflation expectations, pushing up long-term government bond yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::strike_campaign_intensit" target="us_iran_gulf_conflict::crude_price_level" id="181">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
