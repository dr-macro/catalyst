      <edge source="russia_ukraine_war::escalation_pressure" target="north_korea_nuclear::geopolitical_tension" id="275">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising reciprocal escalation in the Russia–Ukraine theater raises great-power threat perceptions and produces more assertive military and diplomatic postures by Russia, China and the United States in other theaters, increasing strategic rivalry around the Korean Peninsula." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="us_china_tech_trade::crossborder_restriction" id="276">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A spike in escalation (high-profile uses of force and reciprocal provocations) rapidly elevates US/EU threat perceptions and domestic political pressure, producing fast-moving executive actions and regulatory expansions (export controls, investment screening, sanctions) that increase trade and tech-transfer barriers vis-à-vis China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="us_debt_bond_stress::market_volatility" id="277">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising escalation pressure (reciprocal strikes, provocative acts) directly raises short-term risk premia and urgency in hedging demand, producing immediate spikes in realized and implied volatility across bond and related markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_debt_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="us_iran_gulf_conflict::regional_escalation_risk" id="278">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising escalation pressure in the Russia–Ukraine war drives Washington and NATO to reallocate naval and air deterrent assets to Europe and signals heightened great-power competition, which reduces perceived US capacity/deterrence in the Gulf and encourages Iranian forces and proxies to probe or escalate, raising regional escalation risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
