          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Large-scale external weapons deliveries to Ukraine spur expanded export controls, secondary-sanctions regimes and enhanced maritime/dual‑use screening that raise the prevalence and restrictiveness of trade barriers affecting routes and firms used by North Korea and its trading partners." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="north_korea_nuclear" />
