      <edge source="us_iran_gulf_conflict::regional_escalation_risk" target="north_korea_nuclear::military_activity" id="444">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A spike in Gulf escalation draws U.S. naval and air assets into the Middle East, reducing forward-deployed deterrence in East Asia and creating a perceived window that North Korea exploits with more frequent missile tests and drills." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::regional_escalation_risk" target="russia_ukraine_war::escalation_pressure" id="445">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened kinetic/coercive activity in the Gulf draws U.S. and allied command attention and forces into the region and degrades deterrence signaling in Europe, which Russia exploits to intensify reciprocal probing and provocative operations against Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::regional_escalation_risk" target="us_china_tech_trade::capital_flow_to_ai" id="446">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened Gulf conflict risk increases investor risk aversion toward geopolitically exposed markets and supply chains, prompting reallocations of private and sovereign capital into domestic/ally AI projects and defense‑adjacent AI startups perceived as safer." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_gulf_conflict" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
