          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in missile tests and regional military operations creates immediate operational demand for AI-enabled ISR, warning and targeting systems, pushing defense contractors and partners to accelerate production deployments of new models." />
