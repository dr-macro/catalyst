          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A North Korean nuclear escalation raises US and allied threat perceptions, prompting rapid targeted export controls, visa curbs and tighter licensing that directly increase cross-border barriers for AI-related goods, services and talent." />
