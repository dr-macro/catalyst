          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharp rise in North Korean nuclear-related tension forces Western suppliers and logistics partners to reassign diplomatic bandwidth, transport capacity and inspection resources to Indo‑Pacific contingencies, slowing approvals and physical deliveries of Western-supplied arms into the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="north_korea_nuclear" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
