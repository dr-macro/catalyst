          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in external arms deliveries exposes procurement/financing channels and corporate intermediaries, triggering stricter national-security reviews and sanctions that slow or block cross-border M&amp;A and strategic investments involving AI-related firms with Chinese counterparties." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
