          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Operational pressure to employ and sustain larger numbers of unmanned systems forces defense and adjacent commercial developers to prioritize, test, and field higher autonomy (navigation, target selection, swarm coordination), raising the average autonomy level of deployed models." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_governance_crisis" />
