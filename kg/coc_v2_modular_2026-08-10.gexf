          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Increased operational use and production of loitering munitions and maritime drones in the Russia‑Ukraine war accelerates proliferation and export of those systems (via state and gray‑market channels) to regional actors and proxies who then employ them against shipping in the Strait of Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::unmanned_weapons_rate" target="us_china_tech_rivalry::ai_compute_demand" id="211">
