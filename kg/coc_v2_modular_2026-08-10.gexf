      <edge source="hormuz_standoff::maritime_attack_rate" target="ai_governance_crisis::exploit_incident_rate" id="43">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Increased maritime attacks escalate kinetic/proxy conflict dynamics and spur state and non‑state actors to conduct offensive cyber operations against adversary logistics and AI infrastructure, raising successful exploits of models and agent systems." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="ai_governance_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="hormuz_standoff::maritime_attack_rate" target="currency_activism_shocks::fx_interv_intensity" id="44">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Spikes in maritime attacks produce sudden risk‑off flows and rapid FX sell‑offs in exposed regional currencies (exporters/importers and shipping‑linked financial centers), forcing central banks to step into the FX market more frequently and at larger scale to stem depreciation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="currency_activism_shocks" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="hormuz_standoff::maritime_attack_rate" target="russia_ukraine_war::alliance_cohesion_index" id="45">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rising tempo of hostile maritime actions forces allies to divert naval assets and political attention to the Gulf, producing disputes over burden‑sharing and priority (Middle East security vs. Ukraine) that weaken coordinated policy and operations on the Russia‑Ukraine file." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="hormuz_standoff::maritime_attack_rate" target="russia_ukraine_war::logistics_disruption_rat" id="46">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher rates of attacks on commercial shipping increase rerouting, port congestion and insurance/clearance delays that directly raise the frequency and severity of transport and transshipment interruptions affecting delivery chains into and out of the Ukraine theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="hormuz_standoff::maritime_attack_rate" target="us_china_tech_rivalry::onshoring_share" id="47">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An uptick in direct maritime and proxy attacks raises logistics and insurance risk premia for sea‑dependent supply chains, leading firms to accelerate capital allocation to domestic or near‑shore manufacturing (increasing onshoring share) to de‑risk production." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
