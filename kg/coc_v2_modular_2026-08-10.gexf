          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A successful blockade compels NATO and partner states to reallocate limited munitions and air/maritime defense stocks to regional escorts and partner defense, slowing or reducing transfers and stock replenishment available for Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
