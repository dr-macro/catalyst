          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher autonomy in deployed models increases model size, continuous runtime and orchestration needs (real‑time decision loops, simulation, multi‑agent coordination), directly raising aggregate training and inference compute requirements." />
