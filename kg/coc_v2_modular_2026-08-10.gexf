          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising autonomy reduces required human-in-the-loop oversight for UAVs and loitering munitions, permitting commanders to deploy larger numbers and longer-duration missions through software upgrades rather than slower crewed-force expansions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="ai_governance_crisis" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
