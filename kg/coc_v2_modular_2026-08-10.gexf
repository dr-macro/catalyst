          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in deployed unmanned and autonomous systems drives procurement and R&amp;D for autonomy, perception and onboard processing, increasing demand for specialised AI training and edge compute resources." />
