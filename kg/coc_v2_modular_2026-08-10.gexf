      <edge source="hormuz_standoff::blockade_effectiveness" target="russia_ukraine_war::sanctions_enforcement" id="102">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="An effective chokepoint blockade heightens immediate energy and trade security concerns for European and Asian governments, prompting political pressure to soften or delay strict enforcement of sanctions (including on energy) to stabilize markets and supply, reducing overall sanctions rigor toward actors in the Russia‑Ukraine context." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="hormuz_standoff::blockade_effectiveness" target="russia_ukraine_war::munitions_stock_level" id="103">
