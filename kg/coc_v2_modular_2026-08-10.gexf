          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained, effective blockades that disrupt shipping create operational pressures that push firms to accelerate procurement and integration of AI-driven supply‑chain automation, routing optimization, and resilience tools to maintain operations." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="ai_governance_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="hormuz_standoff::blockade_effectiveness" target="currency_activism_shocks::net_capital_flows" id="101">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A successful blockade that materially constrains trade and export receipts reduces sovereign and corporate cashflows and raises perceived country risk, prompting portfolio re‑allocations away from affected jurisdictions and producing net capital outflows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="currency_activism_shocks" />
          <attvalue for="27" value="0" />
        </attvalues>
