        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher autonomy levels allow deployment of persistent autonomous surface/underwater swarms and AI-directed interdiction tactics that can be fielded at scale to harass, disable or herd commercial traffic, increasing the practical effectiveness of localized blockades." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="ai_governance_crisis" />
          <attvalue for="38" value="hormuz_standoff" />
          <attvalue for="27" value="0" />
