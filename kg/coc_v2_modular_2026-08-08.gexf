          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter US/Western export controls on China drive Beijing to secure alternative, discounted energy supplies (including increased crude purchases from Iran) to insulate its economy, raising the volume of Iranian exports moving through or from the Gulf." />
