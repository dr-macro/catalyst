      <edge source="alliance_munitions_strai::maritime_access_control" target="iran_hormuz_standoff::shipping_route_control" id="817">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="When allied actors increase active regulation (exclusion zones, convoying, interdiction patrols or port denial), they immediately change who can enforce and direct commercial trajectories, raising the effective control over shipping routes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
