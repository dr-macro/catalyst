      <edge source="us_china_tech_rivalry::export_control_intensity" target="alliance_munitions_strai::alliance_cohesion" id="452">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="When the U.S. tightens export controls on AI‑relevant hardware and tools, like advanced semiconductors and development software, allied governments coordinate lists, licensing rules and joint enforcement to avoid loopholes, increasing policy and operational alignment among partners." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
