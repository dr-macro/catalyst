          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sustained exercises of control over routes (closures, seizures, forced rerouting) produce immediate operational gaps that compel alliances to develop or update logistics, escort, and alternative‑routing plans to preserve flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="alliance_munitions_strai" />
