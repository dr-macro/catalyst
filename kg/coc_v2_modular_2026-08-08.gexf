          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rapid consumption of interceptors creates urgent operational demand for improved targeting, sensor fusion and logistics, accelerating procurement cycles and fielding schedules for AI systems that integrate with air‑defence and command systems." />
