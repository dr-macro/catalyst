        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::energy_export_volume" target="alliance_munitions_strai::alliance_cohesion" id="173">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A pronounced drop in regional energy exports creates asymmetric economic pain and differing threat perceptions among partners, producing policy disputes over sanctions, risk tolerance, and use of force that reduce cohesion." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="alliance_munitions_strai" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::energy_export_volume" target="currency_activism::exchange_rate_level" id="174">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher hydrocarbon export volumes increase foreign-currency receipts into exporters' balance of payments, bolstering FX liquidity and central-bank reserves and therefore supporting/appreciating the nominal exchange rate." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="currency_activism" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::energy_export_volume" target="russia_ukraine_warfare::political_will_arms" id="175">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharp drop in hydrocarbon exports through the Hormuz corridor that elevates global energy prices and domestic energy strain in European democracies will increase political pressure to prioritize energy relief and fiscal support over new arms packages for Ukraine, reducing sustained political will to supply weapons." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::energy_export_volume" target="us_china_tech_rivalry::ai_deployment_rate" id="176">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Material declines in hydrocarbon exports from the corridor push up regional/global energy prices and create localized power constraints, increasing operating costs and curtailing run rates for energy‑intensive AI datacenters and slowing deployment schedules." />
