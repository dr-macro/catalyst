          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater control or interference over key shipping corridors raises trade disruption and insurance costs and increases sovereign risk premia for trade-dependent issuers, pushing up government bond yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="currency_activism" />
