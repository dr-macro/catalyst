      <edge source="alliance_munitions_strai::contingency_planning" target="iran_hormuz_standoff::energy_export_volume" id="839">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Deeper, executable contingency plans (pre‑arranged rerouting, alternative terminals, insurance and release mechanisms, and convoy logistics) allow exporters to sustain or restore flows despite disruptions, increasing short‑to‑medium term export volumes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_munitions_strai::contingency_planning" target="russia_ukraine_warfare::escalation_tension_index" id="840">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="More comprehensive, pre‑agreed crisis plans and clearer decision rules reduce ambiguity and inadvertent signaling, lowering the incidence of misperception and reactive moves that drive short‑term escalation tensions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_munitions_strai::contingency_planning" target="us_china_tech_rivalry::ai_deployment_rate" id="841">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
