      <edge source="currency_activism::crossborder_capital_flow" target="alliance_munitions_strai::contingency_planning" id="619">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An increase in freely available cross‑border capital reduces the need for pre‑financing and large prepositioned stockpiles, so planners scale back contingency prepositioning and detailed short‑term logistics plans (conversely, a sudden tightening prompts expanded contingency planning)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="currency_activism" />
          <attvalue for="38" value="alliance_munitions_strai" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="currency_activism::crossborder_capital_flow" target="iran_hormuz_standoff::energy_export_volume" id="620">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.62" />
          <attvalue for="35" value="A rise in cross-border capital flows (easier inflows of hard currency and trade finance) directly enables timely payment and settlement for hydrocarbon buyers and logistics providers, increasing the quantity of oil and gas cargoes shipped through Hormuz within weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="currency_activism" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="currency_activism::crossborder_capital_flow" target="us_china_tech_rivalry::ai_investment_flow" id="621">
