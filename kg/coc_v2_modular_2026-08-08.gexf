          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sustained surges of foreign capital into rival-country tech sectors trigger political and national‑security concerns that prompt authorities to expand or tighten export/trade restrictions targeting technology flows." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="currency_activism" />
