      <edge source="alliance_munitions_strai::maritime_access_control" target="currency_activism::crossborder_capital_flow" id="816">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tightened maritime access controls (closures, interdictions or convoying) immediately raise shipping costs, delay cargo and trade‑finance settlements and force rerouting, which contracts trade‑related cross‑border payments and prompts investors and banks to pull back from exposed corridors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="currency_activism" />
