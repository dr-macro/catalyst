          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.88" />
          <attvalue for="35" value="Increases in gross and net cross‑border capital into a country’s tech sector provide direct funding that accelerates VC deals, corporate capex and startup formation, raising the rate of AI-directed investment." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="currency_activism" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
