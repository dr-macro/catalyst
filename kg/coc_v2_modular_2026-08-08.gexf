      <edge source="alliance_munitions_strai::alliance_cohesion" target="currency_activism::crossborder_capital_flow" id="759">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved alliance cohesion reduces political and policy risk among partners and accelerates coordinated defense procurement and financing, which increases cross‑border investment, trade credit and capital flows between allied economies." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="currency_activism" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_munitions_strai::alliance_cohesion" target="iran_hormuz_standoff::negotiation_intensity" id="760">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater policy and operational alignment among partners produces unified diplomatic initiatives and coordinated bargaining positions, increasing the tempo and resources committed to multilateral negotiations over passage arrangements." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_munitions_strai::alliance_cohesion" target="russia_ukraine_warfare::political_will_arms" id="761">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Greater policy and operational alignment among defense partners enables coordinated decisions, burden‑sharing and cross‑validation that raise and sustain collective commitments to supply weapons and air‑defence systems to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_munitions_strai::alliance_cohesion" target="us_china_tech_rivalry::export_control_intensity" id="762">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Tighter policy and operational alignment among the U.S. and partner states enables coordinated design, legal harmonization and joint enforcement of sanctions and tech export restrictions targeting China, increasing the intensity of export controls." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
