      <edge source="alliance_munitions_strai::escalation_risk" target="currency_activism::gov_bond_yields" id="783">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An increase in escalation risk raises perceived sovereign credit and term premia for governments in the conflict or spillover region, driving up their government bond yields as investors demand higher compensation and domestic fiscal costs rise." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="currency_activism" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_munitions_strai::escalation_risk" target="iran_hormuz_standoff::maritime_security_risk" id="784">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A higher systemic probability of escalation raises the likelihood that state or proxy actors will undertake hostile acts at sea (harassment, interdiction, mining), directly raising measured and perceived maritime security risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_munitions_strai::escalation_risk" target="russia_ukraine_warfare::political_will_arms" id="785">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising systemic risk of escalation prompts caution among external governments, producing explicit limits or pauses on transfers of longer‑range or higher‑lethality systems to avoid perceived steps that could broaden the conflict." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
