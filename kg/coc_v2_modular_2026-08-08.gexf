      <edge source="us_china_tech_rivalry::export_control_intensity" target="currency_activism::crossborder_capital_flow" id="453">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Tighter export controls raise compliance costs, bar transactions and trigger forced divestments and deal cancellations between jurisdictions, causing investors and firms to halt or reroute cross‑border investments and thus reducing net cross‑border capital flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="currency_activism" />
          <attvalue for="27" value="0" />
