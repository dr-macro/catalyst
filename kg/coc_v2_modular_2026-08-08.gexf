          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Intensified export restrictions that materially impair a targeted country’s tech export earnings and investment outlook increase sovereign growth and credit‑risk premia, directly lifting government bond yields as investors price higher term premia and default risk." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="currency_activism" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::export_control_intensity" target="iran_hormuz_standoff::energy_export_volume" id="455">
