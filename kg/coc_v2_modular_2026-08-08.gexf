          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="High consumption of interceptors in the Russia–Ukraine theater strains global production and inventories, delaying provision and replenishment of missile‑defence and counter‑drone systems for Gulf escorts and leaving commercial shipping more exposed to attacks." />
          <attvalue for="36" value="3-12 months" />
          <attvalue for="37" value="russia_ukraine_warfare" />
          <attvalue for="38" value="iran_hormuz_standoff" />
