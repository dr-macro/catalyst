          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained allied denial or tighter regulation of sea routes reduces or delays maritime resupply of long‑range strike munitions, lowering the volume of sea‑launched/transported missile attacks and thus the rate at which air‑defence interceptors are expended." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="alliance_munitions_strai" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
