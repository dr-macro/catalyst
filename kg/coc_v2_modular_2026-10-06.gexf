      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="energy_maritime_chokepoi::crude_export_flow" id="30">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Kinetic strikes that damage export infrastructure (ports, loading terminals, storage tanks, pipelines) or render berths unusable directly reduce the volume of crude that can be loaded and exported." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_maritime_chokepoi" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="iran_proxy_escalation::foreign_military_presenc" id="31">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rapid spike in high-intensity kinetic operations in Ukraine forces NATO/US to reassign maritime and air assets to Europe for deterrence and logistics, reducing the pool of forces available for forward presence in the Iran-proxies theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_proxy_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="north_korea_missiles::escalation_pressure" id="32">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="High-intensity, large-scale missile and strike operations in Ukraine normalize massed long-range fires and damage thresholds, prompting North Korea to increase readiness, threat-posturing and pre-emptive signaling that raise escalation pressure on the Korean peninsula." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="north_korea_missiles" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="us_china_tech_trade::ai_capital_flow" id="33">
