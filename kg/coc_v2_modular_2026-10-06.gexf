      <edge source="energy_maritime_chokepoi::crude_export_flow" target="russia_ukraine_war::domestic_stability" id="694">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained drop in crude export volumes and related export revenues (e.g., from Russian sales disrupted by maritime interdiction or chokepoint closures) reduces government fiscal capacity and subsidies, heightening inflation and social grievances that erode domestic political stability." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="russia_ukraine_war" />
