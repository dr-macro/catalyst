          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A visible weakening of coalition unity over the Ukraine war (policy splits, delayed commitments) leads partner states to reduce or pause regional rotations and burden-sharing, producing a measurable drop in foreign force posture in the Middle East theater." />
