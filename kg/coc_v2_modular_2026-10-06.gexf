      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="energy_maritime_chokepoi::maritime_security_risk" id="29">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Higher rates of missile, artillery and drone strikes near coasts and on naval/port targets produce more direct attacks, mines and collateral damage to shipping, increasing the frequency and severity of hostile incidents on sea lanes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_maritime_chokepoi" />
