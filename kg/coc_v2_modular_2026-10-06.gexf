          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.66" />
          <attvalue for="36" value="Large, sustained military aid packages include procurement contracts, R&amp;D funding and classified data-sharing with defense contractors and national labs, which accelerates development and fielding of higher‑performance AI models relevant to both military and commercial deployments." />
          <attvalue for="37" value="6-18 months" />
