          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Spikes in intense kinetic operations increase perceived demand for ISR, autonomy and defense technology, prompting private and strategic investors to reallocate capital into AI firms and funds positioned to supply those capabilities." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
