      <edge source="energy_maritime_chokepoi::crude_export_flow" target="iran_proxy_escalation::foreign_military_presenc" id="693">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp reductions in crude export flows prompt consumer states and partners to deploy naval/air assets to protect producers and sea lines of communication, increasing foreign military presence in the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="iran_proxy_escalation" />
          <attvalue for="28" value="0" />
