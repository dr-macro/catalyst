          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger perceived unity among allied states enables coordinated economic measures and joint interdiction/logistics (e.g., sanctions enforcement, naval escorts/interdictions) that constrain a belligerent's ability to export crude." />
          <attvalue for="37" value="6-18 months" />
