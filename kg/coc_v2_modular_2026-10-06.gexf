          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger and more visible cohesion among US/ROK/Japan deterrent postures reduces opportunities for Moscow and Beijing to expand political and operational leverage over Pyongyang, lowering external patron influence on DPRK decision-making." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="north_korea_missiles" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="us_china_tech_trade::compute_concentration" id="57">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Tighter security alignment among the US and partners drives coordinated procurement, certification and network‑trusting arrangements that favor a small set of vetted Western cloud and HPC providers, increasing market concentration of high‑end compute." />
