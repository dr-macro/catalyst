      <edge source="energy_maritime_chokepoi::chokepoint_accessibility" target="iran_proxy_escalation::chokepoint_control" id="717">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="When chokepoint accessibility falls (due to mines, interdictions or harassment), local actors can more easily enforce area-denial and thereby consolidate de facto control over the passage." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_maritime_chokepoi" />
          <attvalue for="39" value="iran_proxy_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_maritime_chokepoi::chokepoint_accessibility" target="russia_ukraine_war::military_aid_flows" id="718">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Physical restriction or temporary closure of key sea passages (e.g., Black Sea approaches or the Turkish Straits) prevents or substantially delays roll-on/roll-off and heavy-equipment shipments to Ukrainian ports, forcing cancellations or long detours that reduce the volume and tempo of maritime military aid." />
