          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Large, rapid net outflows from ETFs force correlated liquidation of underlying cross-border holdings and unwind of currency hedges, producing abrupt, higher‑frequency swings in cross-border capital movements and settlement volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="western_political_unrest" />
