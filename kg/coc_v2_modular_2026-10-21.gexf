      <edge source="global_financial_fragili::currency_pressure_index" target="middle_east_energy_attac::supply_disruption_risk" id="756">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained depreciation pressure on an import-dependent economy's currency increases the likelihood that buyers miss payments or suppliers preemptively halt shipments (or require cash-on-delivery), raising the probability and severity of supply interruptions for energy and critical goods." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="middle_east_energy_attac" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_fragili::currency_pressure_index" target="russia_ukraine_war::arms_transfer_flow" id="757">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained depreciation pressure on the ruble (or other regional currencies) disrupts FX settlement and raises foreign‑currency costs for overseas procurement and intermediary payments, delaying or reducing the volume of imported munitions and equipment arriving into the theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_fragili::currency_pressure_index" target="us_china_tech_trade::ai_infra_investment_flow" id="758">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Appreciable depreciation pressure on the local currency raises the local‑currency cost of imported GPUs, servers and construction inputs (priced in USD), directly worsening project economics and prompting developers and investors to cut or postpone new AI infra capital deployments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_fragili::currency_pressure_index" target="western_political_unrest::law_enforcement_response" id="759">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Marked depreciation pressure raises import prices and squeezes real incomes quickly, prompting cost-of-living demonstrations that lead authorities to increase policing intensity and deploy tougher security measures." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="western_political_unrest" />
