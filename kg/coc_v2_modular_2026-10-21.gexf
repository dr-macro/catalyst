          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising sovereign borrowing costs and fiscal strain reduce governments' tolerance for the economic costs and budgetary measures required to design, enforce, and sustain high-intensity sanctions, causing scaling back or softer enforcement over time." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="western_political_unrest" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
