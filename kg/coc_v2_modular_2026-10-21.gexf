          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="2" />
          <attvalue for="33" value="+" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="global_financial_fragili::net_crossborder_flows" id="60">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Intensified and more rigorously enforced sanctions against Russian banks, energy companies and counterparties reduce correspondent‑banking access and raise counterparty risk, prompting global banks and asset managers to curtail cross‑border funding and portfolio allocations to affected jurisdictions and thereby lower net cross‑border capital flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_financial_fragili" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="us_china_tech_trade::ai_infra_investment_flow" id="61">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Intensified sanctions against Russia create political momentum and legal precedents that push the US and allied governments to broaden export controls and secondary-sanction tools on advanced chips, cloud and services, prompting investors and vendors to delay or withdraw capital deployment into AI datacenter and compute projects linked to China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="western_political_unrest::capital_flow_volatility" id="62">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rapid tightening or expansion of sanctions against Russian entities forces investors to reweight exposures to energy, banking and sanctions‑sensitive assets, triggering swift portfolio adjustments and cross‑border capital movements that raise short‑term capital flow volatility in Western markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="western_political_unrest" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="western_political_unrest::sovereign_debt_stress" id="63">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating sanctions that disrupt energy supplies and raise fiscal or trade costs for energy‑dependent Western states increase refinancing needs and investor risk premia, widening sovereign spreads and elevating sovereign debt market stress." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="western_political_unrest" />
          <attvalue for="28" value="0" />
        </attvalues>
