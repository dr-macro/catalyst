          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Widening sovereign spreads and higher default/downgrade probability prompt passive bond ETF investors and authorized participants to redeem or rotate out of sovereign-bond trackers, generating net outflows from those ETFs." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_political_unrest" />
          <attvalue for="39" value="global_financial_fragili" />
          <attvalue for="28" value="0" />
