          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened attacks or interdictions at key maritime chokepoints (e.g., Bab el-Mandeb, Suez) force rerouting, increase insurance and escort needs, and physically block scheduled sea shipments of heavy weapons and ammunition destined for the Ukraine theater, reducing delivered volume." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_energy_attac" />
          <attvalue for="39" value="russia_ukraine_war" />
