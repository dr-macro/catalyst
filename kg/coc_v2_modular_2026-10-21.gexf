      <edge source="russia_ukraine_war::alliance_cohesion_streng" target="global_financial_fragili::etf_net_flow_rate" id="90">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Stronger, credible allied coordination on defense spending and trade policy shifts investor expectations toward defense contractors and allied‑market exposures, triggering portfolio rotations into ETFs that track defense and allied‑market indices and increasing net inflows into those trackers." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_financial_fragili" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion_streng" target="middle_east_energy_attac::chokepoint_insecurity" id="91">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger policy alignment and coordinated action among allied states responding to the Russia–Ukraine war produces combined naval escorts, intelligence-sharing and interdiction operations in key straits and approaches, reducing the incidence and threat level of hostile interdictions at maritime chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_energy_attac" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion_streng" target="us_china_tech_trade::ai_infra_investment_flow" id="92">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger political and policy coordination among US allies driven by the conflict leads to harmonized investment-screening rules and coordinated restrictions on technology transfers, increasing regulatory barriers and political risk that cause a measurable reduction in cross-border financing and vendor investment into Chinese AI infrastructure projects." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion_streng" target="western_political_unrest::civil_unrest_intensity" id="93">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A decline in allied cohesion over war policy (e.g., visible splits on arms shipments, refugee policy or sanctions) sharpens domestic polarization and mobilizes opposed constituencies into larger, more widespread protests and counter‑demonstrations, raising civil unrest intensity; conversely stronger cohesion tends to dampen such mobilization." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="western_political_unrest" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
