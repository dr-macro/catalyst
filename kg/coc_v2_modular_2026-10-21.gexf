      <edge source="global_financial_fragili::etf_net_flow_rate" target="middle_east_energy_attac::price_volatility" id="809">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Large net inflows into energy/commodity ETFs provide liquidity and absorb order imbalances, damping short-term commodity and related financial price swings, whereas rapid net outflows force liquidation of underlying futures/holdings and amplify price moves." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="middle_east_energy_attac" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_fragili::etf_net_flow_rate" target="us_china_tech_trade::asset_valuation_infra" id="810">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Net inflows into sector‑tracking ETFs produce demand for listed data‑center and infrastructure equities, mechanically lifting share prices and sector valuation multiples and thus raising market valuations of infrastructure assets; net outflows work in reverse." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_fragili::etf_net_flow_rate" target="western_political_unrest::capital_flow_volatility" id="811">
        <attvalues>
