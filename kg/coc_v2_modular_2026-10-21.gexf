      <edge source="western_political_unrest::civil_unrest_intensity" target="global_financial_fragili::asset_price_volatility" id="575">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Large, geographically broad protests and riots interrupt trading, force asset re-pricing and trigger stop-loss/margin liquidation and hedging flows, producing immediate spikes in realized and implied volatility across equities, bonds and FX." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_political_unrest" />
          <attvalue for="39" value="global_financial_fragili" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_political_unrest::civil_unrest_intensity" target="middle_east_energy_attac::chokepoint_insecurity" id="576">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="High-intensity domestic unrest in Western states causes security forces and naval/coast-guard assets to be redeployed to homeland duties, reducing escort and interdiction patrols near Middle Eastern chokepoints and opening short-term windows for hostile interdictions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_political_unrest" />
          <attvalue for="39" value="middle_east_energy_attac" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_political_unrest::civil_unrest_intensity" target="russia_ukraine_war::alliance_cohesion_streng" id="577">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained, large-scale domestic protests force coalition partners and national executives to prioritize domestic concessions and parliamentary politics, producing public votes against or conditioned support for collective measures and thereby fracturing allied policy alignment on Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_political_unrest" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_political_unrest::civil_unrest_intensity" target="russia_ukraine_war::decision_tempo" id="578">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Acute spikes in street unrest consume executive bandwidth, compel rapid crisis-management meetings and risk‑averse behavior, and lead leaders to delay or slow approvals for weapons shipments and operational directives related to the conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_political_unrest" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_political_unrest::civil_unrest_intensity" target="us_china_tech_trade::ai_infra_investment_flow" id="579">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Widespread protests and street disorder disrupt construction sites, raise insurance and security premiums, and increase corporate political‑risk premia, causing firms and financiers to delay or cancel planned AI/data‑center investments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_political_unrest" />
