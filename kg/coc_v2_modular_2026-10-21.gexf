      <edge source="global_financial_fragili::asset_price_volatility" target="middle_east_energy_attac::shipping_delay_rate" id="820">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp increases in financial market volatility prompt insurers and counterparties to raise premiums or restrict cover for high-risk routes and cargoes, driving carriers to reroute or hold vessels and thereby increasing delays and average transit times." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="middle_east_energy_attac" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_fragili::asset_price_volatility" target="russia_ukraine_war::alliance_cohesion_streng" id="821">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Spike in asset-price volatility produces uneven macroeconomic pain across allied capitals, raising domestic political pressure to protect national markets and welfare that leads some allies to resist additional coordinated costs (e.g., new sanctions or higher military spending), weakening policy alignment." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_fragili::asset_price_volatility" target="us_china_tech_trade::infra_debt_stock" id="822">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in broad asset volatility increases lender risk premia and tightens credit terms for long‑dated project finance, causing banks and bond markets to reduce new lending for data‑center/AI builds and slowing growth of infrastructure debt outstanding." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
