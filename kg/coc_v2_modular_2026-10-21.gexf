        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp, sustained spikes in asset-price volatility cause abrupt realized losses for retail investors and pension-linked households, producing visible wealth shocks that trigger protests and disorder aimed at financial institutions and policy makers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_fragili" />
          <attvalue for="39" value="western_political_unrest" />
          <attvalue for="28" value="0" />
