          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Expectations of energy import shortfalls increase projected import bills and fiscal strain for net‑importing countries, prompting outward portfolio flows and immediate depreciation pressure on their currencies." />
