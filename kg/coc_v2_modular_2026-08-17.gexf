          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rising perceived risk of broader escalation gives governments political cover and urgency to tighten export controls, sanctions, vetting, and other national-security–justified restrictions on AI-related trade and finance, increasing regulatory stringency." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
