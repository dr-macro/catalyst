      <edge source="russia_ukraine_war::escalation_risk_percep" target="ai_bio_cyber_disruption::geo_alignment_pressure" id="264">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising perception that the conflict may broaden leads governments to press firms and investors to choose or reconfigure suppliers and partnerships along security blocs (e.g., vendor de‑risking, forced localization), increasing geopolitical alignment pressure on tech actors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_bio_cyber_disruption" />
