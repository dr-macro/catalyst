        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rise in perceived escalation risk drives flight-to-safety flows into major reserve currencies (e.g., USD/CHF), mechanically appreciating those currencies versus regional/commodity-linked peers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_currency_market_s" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_risk_percep" target="iran_hormuz_flashpoint::oil_price_volatility" id="266">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising perceived risk of broader escalation around Russia–Ukraine causes oil market participants to widen risk premia and increase position adjustments and speculative trading, producing higher short‑to‑medium‑term crude price volatility that is sensitive to developments in Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
