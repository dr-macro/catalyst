      <edge source="us_china_tech_trade_riva::compute_supply_conc" target="ai_bio_cyber_disruption::geo_alignment_pressure" id="336">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="When large‑scale compute is concentrated in providers tied to one geopolitical bloc, customers and upstream financiers face immediate strategic pressure (access risk, sanctions exposure) to align with that bloc to secure or insure compute access." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade_riva" />
          <attvalue for="38" value="ai_bio_cyber_disruption" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade_riva::compute_supply_conc" target="russia_ukraine_war::drone_strike_rate" id="337">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="When large-scale compute capacity is concentrated in a few providers aligned with US/EU policy, those providers can and do cut off cloud-hosted AI services or remote model training access for Russian customers, degrading autonomy, targeting software, and sortie effectiveness of Russian UAVs and lowering strike rates." />
