      <edge source="global_currency_market_s::fx_exchange_rate_level" target="iran_hormuz_flashpoint::oil_price_volatility" id="563">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Appreciation of a major invoicing currency (e.g., USD) reduces non‑dollar buyers' purchasing power and prompts rapid inventory and contract repricing, producing larger short‑term swings in crude prices tied to Gulf supply risks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_currency_market_s" />
          <attvalue for="38" value="iran_hormuz_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_currency_market_s::fx_exchange_rate_level" target="russia_ukraine_war::drone_strike_rate" id="564">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A weaker domestic currency (e.g., a depreciating ruble) raises the ruble cost of imported components, spare parts and foreign-denominated logistics for long‑range and precision drones, slowing production/maintenance and lowering the tempo of drone strikes over months." />
          <attvalue for="36" value="6-18 months" />
