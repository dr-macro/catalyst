      <edge source="iran_hormuz_flashpoint::blockade_pressure_level" target="ai_bio_cyber_disruption::compute_capacity_alloc" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Heightened blockade pressure raises transit refusals, delays and insurance costs for accelerator/GPU shipments through regional sea lanes, causing immediate shortfalls in delivered hardware and a reduction in compute capacity reserved for model training." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
          <attvalue for="38" value="ai_bio_cyber_disruption" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_flashpoint::blockade_pressure_level" target="ai_bio_cyber_disruption::geo_alignment_pressure" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained blockade pressure forces states and major purchasers to reroute and harden supply chains and to demand vetted suppliers, creating political pressure on firms and capital to align with one geopolitical bloc's security and procurement rules." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
          <attvalue for="38" value="ai_bio_cyber_disruption" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_flashpoint::blockade_pressure_level" target="global_currency_market_s::fx_intervention_intensit" id="37">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher blockade pressure directly reduces hydrocarbon export receipts and foreign-exchange inflows for regional exporters, prompting central banks to deploy reserves and persistent FX market operations to defend their currencies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
          <attvalue for="38" value="global_currency_market_s" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_flashpoint::blockade_pressure_level" target="russia_ukraine_war::escalation_risk_percep" id="38">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A visible rise in blockade pressure in the Strait of Hormuz raises collective concern among NATO, EU and regional policymakers and publics about concurrent great‑power maritime confrontation, directly increasing the perceived risk that the Russia–Ukraine conflict could broaden or trigger wider military responses." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_flashpoint::blockade_pressure_level" target="russia_ukraine_war::maritime_cargo_flow" id="39">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Sustained blockade pressure in Hormuz raises freight rates and insurance costs and forces route changes that reduce available tonnage and commercial willingness to run marginal trade routes, thereby decreasing maritime cargo flows through corridors tied to the Russia–Ukraine theatre." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_flashpoint::blockade_pressure_level" target="us_china_tech_trade_riva::industrial_policy_level" id="40">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained increases in blockade pressure that threaten energy and trade routes prompt governments to activate directed industrial policy (subsidies, mandates, directed investment) to onshore or secure critical tech and energy supply chains, including incentives for domestic compute and chip capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
