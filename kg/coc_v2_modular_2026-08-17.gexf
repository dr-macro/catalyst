      <edge source="ai_bio_cyber_disruption::compute_capacity_alloc" target="iran_hormuz_flashpoint::maritime_incident_rate" id="746">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increases in available training compute accelerate development and deployment of offensive cyber tools and autonomous navigation models (e.g., AIS/GPS spoofing, adversarial navigation agents) that directly cause more maritime collisions, navigation failures, and suspicious interdictions in the Strait region." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="ai_bio_cyber_disruption" />
          <attvalue for="38" value="iran_hormuz_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_bio_cyber_disruption::compute_capacity_alloc" target="russia_ukraine_war::drone_strike_rate" id="747">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher allocation of compute accelerates development and fine-tuning of autonomous targeting, navigation, and swarm-control models that can be integrated into UAVs, enabling operators to launch more frequent and effective drone strikes in the theatre." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="ai_bio_cyber_disruption" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_bio_cyber_disruption::compute_capacity_alloc" target="us_china_tech_trade_riva::compute_supply_conc" id="748">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Large-scale model developers reserving and pre‑paying for vast training capacity lock up provider inventory via long‑term contracts and colo commitments, reducing available capacity for others and concentrating compute supply among a few providers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_bio_cyber_disruption" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
