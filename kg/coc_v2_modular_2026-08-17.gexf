      <edge source="ai_bio_cyber_disruption::geo_alignment_pressure" target="global_currency_market_s::fx_exchange_rate_level" id="793">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified geopolitical alignment pressure forces capital and trade re‑routing away from targeted jurisdictions, reducing foreign demand for the affected currency and producing near‑term depreciation pressure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_bio_cyber_disruption" />
          <attvalue for="38" value="global_currency_market_s" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_bio_cyber_disruption::geo_alignment_pressure" target="iran_hormuz_flashpoint::blockade_pressure_level" id="794">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising geopolitical pressure on firms forces carriers, insurers, and port-service providers to align with blocs and comply with state-led denial measures, enabling or legitimizing targeted refusals of service and coordinated restrictions that raise effective blockade pressure on routes like Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_bio_cyber_disruption" />
          <attvalue for="38" value="iran_hormuz_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_bio_cyber_disruption::geo_alignment_pressure" target="russia_ukraine_war::maritime_cargo_flow" id="795">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Intensified pressure on firms and carriers to align with rival blocs prompts insurers, shipping companies, and ports to reroute or deny service to vessels associated with sanctioned/at‑risk counterparties, directly cutting commercial maritime cargo volume through regional corridors serving the conflict." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_bio_cyber_disruption" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_bio_cyber_disruption::geo_alignment_pressure" target="us_china_tech_trade_riva::industrial_policy_level" id="796">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising geopolitical pressure that forces firms and capital to choose blocs induces states to activate subsidies, mandates and directed investment to onshore or bolster domestic AI supply chains, increasing industrial policy mobilization." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="ai_bio_cyber_disruption" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
