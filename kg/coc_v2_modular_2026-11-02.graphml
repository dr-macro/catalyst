<edge source="global_energy_shock::crude_oil_price" target="china_west_rivalry::export_control_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A sharp oil price spike that signals heightened energy vulnerability or geopolitical leverage by rival producers prompts Western governments to accelerate and broaden export controls on sensitive technologies (including to China) as part of national‑security responses.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_shock</data>
  <data key="d40">china_west_rivalry</data>
</edge>
<edge source="global_energy_shock::crude_oil_price" target="monetary_policy_shock::cross_border_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A sustained rise in crude prices shifts net capital toward oil‑exporting jurisdictions and forces net outflows from oil‑importing economies to pay higher import bills, reducing cross‑border inflows (or increasing outflows) for importers.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_shock</data>
  <data key="d40">monetary_policy_shock</data>
</edge>
<edge source="global_energy_shock::crude_oil_price" target="russia_ukraine_war::escalation_incentives" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Sustained rises in global crude prices increase Russian fiscal revenues and export rents, enlarging Kremlin fiscal/military space and political willingness to sustain or intensify operations in Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_shock</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_energy_shock::crude_oil_price" target="us_iran_gulf_conflict::escalation_momentum" id="0">
