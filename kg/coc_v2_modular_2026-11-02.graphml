<edge source="us_iran_gulf_conflict::kinetic_attack_rate" target="monetary_policy_shock::bank_funding_stress" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Increased kinetic attacks on maritime targets disrupt trade receivables and trade‑finance collateral, trigger insurer and correspondent bank pullbacks and raise counterparty risk, forcing regional banks to pay higher wholesale funding costs and face tighter roll‑over conditions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_conflict</data>
  <data key="d40">monetary_policy_shock</data>
