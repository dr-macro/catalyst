<edge source="monetary_policy_shock::bank_funding_stress" target="russia_ukraine_war::arms_transfer_volume" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">Acute bank funding stress raises the cost and availability constraints on trade finance and letters of credit used by defence contractors and intermediaries, causing immediate delays, cancellations or non‑execution of weapons and munitions shipments into the conflict zone.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">monetary_policy_shock</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="monetary_policy_shock::bank_funding_stress" target="us_iran_gulf_conflict::shipping_risk_perception" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Acute stress in bank funding markets dries up trade finance and reduces insurers' and brokers' liquidity/credit lines, prompting shipowners and underwriters to treat Gulf routes as higher-risk and raise premiums or reroute cargoes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">monetary_policy_shock</data>
  <data key="d40">us_iran_gulf_conflict</data>
