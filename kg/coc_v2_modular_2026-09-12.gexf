      <edge source="gulf_redsea_shipping::military_escalation_inte" target="global_bond_monetary_str::repo_market_liquidity" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Intensifying military actions increase counterparty and settlement risk perceptions, causing banks and dealers to hoard high-quality collateral and withdraw from unsecured/secured short-term funding, tightening repo market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_redsea_shipping" />
          <attvalue for="38" value="global_bond_monetary_str" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_redsea_shipping::military_escalation_inte" target="russia_ukraine_war::kinetic_escalation" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An uptick in kinetic and paramilitary operations in the Gulf/Red Sea compels the US and European allies to reallocate surveillance and naval assets and reduces political/military bandwidth for rapid reinforcement in Europe, which Russia can exploit to increase the tempo of missile, drone and frontline operations in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_redsea_shipping" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_redsea_shipping::military_escalation_inte" target="us_china_tech_trade::compute_capacity" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Intensified maritime military and paramilitary activity prompts insurers, equipment vendors and construction contractors to delay or suspend datacenter shipments and buildouts that rely on affected ports and logistics corridors, reducing near‑term compute expansion." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="gulf_redsea_shipping" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_redsea_shipping::military_escalation_inte" target="us_economic_statecraft::non_tariff_intensity" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher intensity of military/paramilitary actions around shipping and energy infrastructure leads the US to expand non‑tariff tools (sanctions, licensing restrictions, export controls and vetting requirements) against implicated actors and supply channels." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_redsea_shipping" />
          <attvalue for="38" value="us_economic_statecraft" />
          <attvalue for="27" value="0" />
        </attvalues>
