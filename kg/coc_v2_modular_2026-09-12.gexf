          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rapid increase in US trade/sanctions measures prompts retaliatory kinetic actions or proxy strikes by targeted states and groups against shipping and energy infrastructure in the Gulf/Red Sea, raising the tempo and severity of military incidents." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_economic_statecraft" />
          <attvalue for="38" value="gulf_redsea_shipping" />
