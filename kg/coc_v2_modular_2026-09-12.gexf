          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sharp capital outflows from a supplier country create FX shortages and force firms to curtail production or lose access to trade credit, producing production stoppages and missed deliveries that disrupt U.S. supply chains." />
