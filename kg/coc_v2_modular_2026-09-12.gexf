      <edge source="global_bond_monetary_str::cross_border_flows" target="russia_ukraine_war::arms_transfer_flow" id="624">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="An increase in cross-border capital flows restores trade finance and payment channels for defense suppliers and intermediaries, directly enabling larger and faster weapons purchases and deliveries to the theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_monetary_str" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_monetary_str::cross_border_flows" target="us_china_tech_trade::chip_supply_constraint" id="625">
