          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A spike in kinetic operations in the Russia–Ukraine theater (notably strikes on ports, terminals, or export infrastructure) tightens near‑term energy supply expectations and risk premia in global markets, lifting benchmark oil prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="gulf_redsea_shipping" />
