          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute escalation drives risk‑off flows into core long‑dated sovereign bonds (flight to quality/duration), increasing demand and pushing long‑term yields down in the short term." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
