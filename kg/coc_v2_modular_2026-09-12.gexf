          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Spikes in kinetic activity raise perceived strategic risk and urgency, prompting governments and defense firms to accelerate funding and procurement of AI R&amp;D, startups and defense‑oriented AI capabilities, drawing wider private and public capital into the sector." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
