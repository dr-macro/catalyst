          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A decline in cross-border capital and trade flows reduces financing for fabs and limits inventory arbitrage across regions, increasing localized shortages and overall chip/memory tightness within a supply‑chain adjustment period." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_bond_monetary_str" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
