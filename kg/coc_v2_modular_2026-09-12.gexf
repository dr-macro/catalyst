      <edge source="global_bond_monetary_str::cross_border_flows" target="gulf_redsea_shipping::shipping_traffic_flow" id="623">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A sudden net withdrawal of cross‑border capital reduces availability of trade finance (letters of credit and working capital) for Gulf exporters and importers, prompting shipment deferrals and a measurable drop in commercial transits through the Red Sea/Gulf routes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_monetary_str" />
          <attvalue for="38" value="gulf_redsea_shipping" />
          <attvalue for="27" value="0" />
        </attvalues>
