          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rapid cadence of new sanctions and trade measures hardens negotiating positions and raises political costs for compromise, interrupting sustained high‑level mediation, backchannel engagement, and the continuity of institutional diplomacy." />
