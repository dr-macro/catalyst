          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter repo market liquidity raises short-term funding costs for exporters and trading houses that underwrite arms shipments and inventory, while a liquidity easing lowers those frictions and directly increases the volume and velocity of transfers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_monetary_str" />
          <attvalue for="38" value="russia_ukraine_war" />
