<edge source="euro_security_autonomy::manufacturing_output" target="iran_regional_escalation::crude_inventory_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">An increase in European manufacturing output raises fuel and feedstock consumption, drawing down commercial crude stocks and thus reducing crude inventory levels.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_security_autonomy</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="euro_security_autonomy::manufacturing_output" target="russia_ukraine_war::military_support_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rise in European manufacturing output increases the immediate availability of munitions, spare parts and dual-use components that can be allocated to shipments and contracts for Ukraine, raising the flow of external military materiel within weeks.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_security_autonomy</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
