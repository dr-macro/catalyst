<edge source="euro_security_autonomy::corporate_restructuring" target="russia_ukraine_war::military_balance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Accelerated corporate exits and divestments reduce Russian access to maintenance, high-tech inputs and supply relationships that sustain force readiness and production, degrading Russia's relative military capability over several quarters.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">euro_security_autonomy</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="euro_security_autonomy::corporate_restructuring" target="us_china_tech_rivalry::congressional_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">European firms that relocate production, create foreign subsidiaries, or restructure IP/ownership in jurisdictions with weaker controls prompt U.S. lawmakers to open hearings and oversight into transatlantic corporate structures and potential technology transfers to China.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">euro_security_autonomy</data>
