  <data key="d33">-</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="russia_ukraine_war::legal_norm_strength" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">?</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="russia_ukraine_war::political_polarization" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="euro_security_autonomy::policy_adjustment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Ratcheting sanctions on Russia create immediate fiscal and regulatory pressure (energy price shocks, inflation, business dislocations) that force European governments to deploy emergency policy measures (subsidies, price caps, export controls, rapid regulatory changes), accelerating the pace of policy adjustments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">euro_security_autonomy</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="global_financial_stress::market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Intensified sanctions and secondary‑sanctions risk on Russian banks and counterparties restrict correspondent banking and dollar clearing lines, increasing counterparty fragmentation and reducing depth and turnover in FX, bond and credit markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="global_financial_stress::policy_rate_expectation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Broader and tighter sanctions disrupt energy and commodity supplies and logistics, pushing commodity prices and near‑term inflation expectations higher and causing markets to anticipate tighter central‑bank policy.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="iran_regional_escalation::tanker_positioning_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Escalation of sanctions on Russian energy and shipping raises insurance and chartering risk for vessels tied to Russia, forcing charterers to reflag, reroute or redeploy tankers and increasing repositioning activity across global routes that include Middle Eastern corridors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="iran_regional_escalation::sanction_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Wider and more intrusive sanctions architectures and enforcement practices developed for Russia are adopted or extended by policymakers and enforcement agencies to target intermediaries and trade flows linked to Iran, increasing cumulative sanction pressure on Iranian energy transactions.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="us_china_tech_rivalry::adv_chip_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Tighter and broader sanctions raise compliance costs and legal risk for suppliers and banks, prompting exporters and intermediaries to proactively restrict shipments of advanced semiconductors, reducing cross‑border flows to high‑risk jurisdictions including China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="us_china_tech_rivalry::reexport_leakage_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Escalating sanctions incentivize sanctioned actors to route procurement through third‑country intermediaries and shell companies, increasing the use of re‑exports and the probability that controlled hardware is diverted to restricted end users.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
