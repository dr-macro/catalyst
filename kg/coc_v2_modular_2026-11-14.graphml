<edge source="global_financial_stress::investor_risk_aversion" target="euro_security_autonomy::corporate_restructuring" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Higher investor risk aversion reduces available equity and debt financing and raises refinancing pressure, prompting firms to accelerate asset sales, workforce reductions, mergers or reorganizations to survive financing stress.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">euro_security_autonomy</data>
</edge>
<edge source="global_financial_stress::investor_risk_aversion" target="euro_security_autonomy::supply_vulnerability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">When investors shun riskier cross-border suppliers and small upstream firms, those suppliers lose finance and exit or consolidate, increasing concentration of sources and thus supply-chain vulnerability for downstream manufacturers.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">euro_security_autonomy</data>
</edge>
<edge source="global_financial_stress::investor_risk_aversion" target="iran_regional_escalation::sanction_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A jump in investor risk aversion prompts banks, insurers and commodity traders to de‑risk by exiting or refusing Iran‑linked transactions and services, effectively increasing the intensity and scope of sanction‑style restrictions on energy trade.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="global_financial_stress::investor_risk_aversion" target="russia_ukraine_war::military_support_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in investor risk aversion depresses valuations and cash flows for defense suppliers and squeezes donor fiscal positions, prompting governments and private donors to cut back or delay military assistance shipments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_financial_stress::investor_risk_aversion" target="us_china_tech_rivalry::investor_confidence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A rise in investor risk aversion causes rapid de‑risking and forced sales of AI/semiconductor equities and funds, directly lowering aggregate investor confidence in AI assets and raising discount rates for those companies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
