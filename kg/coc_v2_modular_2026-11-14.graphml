<edge source="global_financial_stress::market_liquidity" target="euro_security_autonomy::manufacturing_output" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sudden drop in market liquidity tightens trade finance and working-capital access for manufacturers, forcing cutbacks in input purchases and production runs and thereby lowering manufacturing output within weeks to months.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">euro_security_autonomy</data>
</edge>
<edge source="global_financial_stress::market_liquidity" target="iran_regional_escalation::tanker_positioning_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sudden decline in financial market liquidity tightens trade finance and working capital for traders, leading them to consolidate cargoes and delay or cancel tanker redeployments, reducing the rate of tanker repositioning and route adjustments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="global_financial_stress::market_liquidity" target="us_china_tech_rivalry::adv_chip_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Higher market liquidity reduces transaction costs and eases trade‑finance and intermediation for large hardware deals, increasing the volume and speed of advanced chip cross‑border shipments; the reverse (liquidity drops) constrains flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
