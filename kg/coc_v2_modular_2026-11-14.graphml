<edge source="iran_regional_escalation::tanker_positioning_rate" target="euro_security_autonomy::supply_vulnerability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Accelerated tanker redeployments and longer rerouting (to avoid contested waters or sanctions risk) lengthen transit times and concentrate flows on fewer viable corridors, raising the exposure of European manufacturers to chokepoints and delivery failures.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">euro_security_autonomy</data>
</edge>
<edge source="iran_regional_escalation::tanker_positioning_rate" target="russia_ukraine_war::military_support_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increased tanker redeployments and route disruptions around the Middle East raise insurance costs and transit times for sea shipments, creating delays and occasional cancellations of maritime arms and equipment deliveries destined for Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_regional_escalation::tanker_positioning_rate" target="us_china_tech_rivalry::adv_chip_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increased tanker redeployments and route uncertainty around key chokepoints raise maritime risk perceptions, insurance premiums and transit times, causing exporters to reduce or delay shipments of high‑value advanced chips via sea routes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
