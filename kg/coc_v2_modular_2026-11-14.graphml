<edge source="russia_ukraine_war::military_support_flow" target="russia_ukraine_war::tech_proliferation_rate" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="russia_ukraine_war::military_support_flow" target="russia_ukraine_war::intelligence_sharing_flo" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="russia_ukraine_war::military_support_flow" target="euro_security_autonomy::supply_vulnerability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increased external military support to one side tends to provoke retaliatory strikes or escalatory measures (targeting energy, transport, or port infrastructure) that raise the likelihood of disruptions and concentrated chokepoints for European supply chains.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">euro_security_autonomy</data>
</edge>
<edge source="russia_ukraine_war::military_support_flow" target="global_financial_stress::investor_risk_aversion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A marked increase in external military support raises the assessed probability of escalation and a longer, more destructive conflict, prompting investors to move into safe assets and demand higher risk premia on risky assets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="russia_ukraine_war::military_support_flow" target="us_china_tech_rivalry::reexport_leakage_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A rise in inbound military materiel and dual‑use shipments into the conflict creates additional physical flows, intermediaries, and black‑market channels that smugglers and brokers can exploit to divert controlled chips via secondary markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::sanctions_intensity" target="russia_ukraine_war::military_balance" id="0">
