<edge source="iran_regional_escalation::producer_output_rate" target="euro_security_autonomy::supply_vulnerability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A decline in regional producers' output reduces available alternative supplies and increases concentration of sourcing for Europe, thereby directly increasing supply-chain vulnerability (the inverse: higher output reduces vulnerability).</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">euro_security_autonomy</data>
</edge>
<edge source="iran_regional_escalation::producer_output_rate" target="global_financial_stress::project_financing_cost" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Declines in regional producer output raise sovereign and cash‑flow risk for long‑lived projects, increasing lender risk premia and debt spreads and thereby pushing up project financing costs.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">global_financial_stress</data>
</edge>
