<edge source="euro_security_autonomy::policy_adjustment_rate" target="global_financial_stress::policy_rate_expectation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rapid increase in public fiscal and subsidy interventions to underwrite European security/autonomy raises near-term inflation and fiscal financing needs, prompting markets to update expectations toward higher central bank policy rates.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_security_autonomy</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="euro_security_autonomy::policy_adjustment_rate" target="iran_regional_escalation::sanction_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Faster EU policy adjustments let Brussels adopt, tighten or expand independent sanctions and regulatory restrictions against Iranian energy exports more quickly, increasing aggregate sanction pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_security_autonomy</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
