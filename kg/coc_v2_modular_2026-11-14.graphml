<edge source="euro_security_autonomy::supply_vulnerability" target="global_financial_stress::investor_risk_aversion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">An acute rise in Europe’s supply‑chain vulnerability produces frequent production shocks and earnings volatility for exposed firms, driving up risk premia as investors shift toward safer assets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_security_autonomy</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="euro_security_autonomy::supply_vulnerability" target="iran_regional_escalation::tanker_positioning_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Reducing Europe's supply-chain vulnerability (diversifying suppliers/routes and enlarging stocks) lowers the need for emergency rerouting and ad hoc tanker redeployments tied to Persian Gulf shipments, decreasing tanker positioning activity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_security_autonomy</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="euro_security_autonomy::supply_vulnerability" target="russia_ukraine_war::military_support_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Higher supply-chain vulnerability (more chokepoints or single-source inputs) leads to production and transport disruptions that directly delay or reduce deliveries of weapons, ammunition and sustainment supplies to Ukrainian forces.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_security_autonomy</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="euro_security_autonomy::supply_vulnerability" target="us_china_tech_rivalry::reexport_leakage_risk" id="0">
