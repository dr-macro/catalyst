  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Changes in global diesel supply immediately alter refinery and commercial stock flows so that an increase (decrease) in supply raises (lowers) days-of-supply held in storage across markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">energy_market_fragment</data>
</edge>
<edge source="russia_ukraine_war::diesel_global_supply" target="financial_markets_stress::sovereign_yield_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute diesel supply disruptions force governments to incur emergency import bills, subsidies or drawdowns of reserves, worsening near-term fiscal balances and inflation expectations and thereby putting upward pressure on sovereign bond yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">financial_markets_stress</data>
</edge>
<edge source="russia_ukraine_war::diesel_global_supply" target="gulf_maritime_flashpoint::retaliation_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Significant reductions in global diesel tied to the Russia–Ukraine war raise the strategic importance of Gulf supply lines for dependent states, increasing political and military momentum to undertake coercive or kinetic retaliation after attacks on shipping or infrastructure to secure flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">gulf_maritime_flashpoint</data>
</edge>
