<edge source="russia_ukraine_war::diesel_global_price" target="energy_market_fragment::commodity_price_level_oi" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained increases in diesel (refined product) prices widen refinery margins and prompt higher crude demand expectations, which transmits upward pressure to crude oil benchmark prices via market repricing and refinery crude buying.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">energy_market_fragment</data>
</edge>
<edge source="russia_ukraine_war::diesel_global_price" target="financial_markets_stress::market_risk_premia" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained rise in global diesel prices increases inflation uncertainty and squeezes corporate margins and cashflows, leading investors to demand higher compensation for credit and equity risk and thus raising aggregate market risk premia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">financial_markets_stress</data>
</edge>
<edge source="russia_ukraine_war::diesel_global_price" target="us_china_rivalry::capital_flow_to_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained increases in global diesel prices raise operational and logistics costs for compute‑intensive AI infrastructure (generators, transport, edge deployments), reducing projected returns and causing some investors to delay or withdraw capital from AI projects in exposed markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_rivalry</data>
</edge>
