<edge source="gulf_maritime_flashpoint::retaliation_pressure" target="energy_market_fragment::maritime_security_incide" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Growing political and military pressure to respond encourages state or proxy naval actions (interdictions, seizures, armed harassment) against vessels perceived as linked to adversaries, raising the frequency of maritime security incidents.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_flashpoint</data>
  <data key="d39">energy_market_fragment</data>
</edge>
<edge source="gulf_maritime_flashpoint::retaliation_pressure" target="financial_markets_stress::market_risk_premia" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising political and military pressure that increases the likelihood of broader escalation pushes investors to charge higher compensation for bearing geopolitical and counterparty risks across asset classes, elevating aggregate market risk premia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_flashpoint</data>
  <data key="d39">financial_markets_stress</data>
</edge>
<edge source="gulf_maritime_flashpoint::retaliation_pressure" target="russia_ukraine_war::sanctions_enforce_streng" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increased political and military pressure to retaliate after Gulf attacks leads states to expand and more strictly enforce sanctions and interdictions on shipping and diesel-related entities deemed linked to adversaries.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">gulf_maritime_flashpoint</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="gulf_maritime_flashpoint::retaliation_pressure" target="russia_ukraine_war::diesel_global_supply" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalatory retaliation that targets port facilities, export terminals, or tankers in the Gulf directly removes export capacity and interrupts diesel shipments, lowering available global supply.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_flashpoint</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="gulf_maritime_flashpoint::retaliation_pressure" target="us_china_rivalry::regulatory_scrutiny_leve" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.82</data>
  <data key="d36">Rising political/military pressure to retaliate provokes rapid government action to limit perceived dual-use risks (export controls, tighter vetting, mandatory disclosures) on AI firms and cross‑border tech ties as part of national security responses.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_flashpoint</data>
  <data key="d39">us_china_rivalry</data>
