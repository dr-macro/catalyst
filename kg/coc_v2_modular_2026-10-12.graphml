<edge source="energy_market_fragment::maritime_security_incide" target="financial_markets_stress::bond_yield_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A spike in hostile or disruptive maritime incidents produces episodic shocks to supply risk and triggers rapid hedging and rebalancing in fixed‑income markets, increasing short-term yield variability.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_market_fragment</data>
  <data key="d39">financial_markets_stress</data>
</edge>
<edge source="energy_market_fragment::maritime_security_incide" target="gulf_maritime_flashpoint::route_suspension_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">A rise in hostile incidents against ships elevates insurer/regulator risk ratings and airline operational risk assessments, prompting carriers and authorities to suspend flights or reroute services that overfly or serve the Gulf to avoid diversion and incident exposure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_market_fragment</data>
  <data key="d39">gulf_maritime_flashpoint</data>
</edge>
<edge source="energy_market_fragment::maritime_security_incide" target="gulf_maritime_flashpoint::retaliation_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Attacks on commercial shipping generate immediate political and public demand for a response and create military pressure to punish or deter perpetrators, raising the momentum for kinetic or coercive retaliation by affected states or coalitions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_market_fragment</data>
  <data key="d39">gulf_maritime_flashpoint</data>
</edge>
<edge source="energy_market_fragment::maritime_security_incide" target="russia_ukraine_war::energy_trade_volumes" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">An increase in maritime security incidents prompts voyage cancellations, port denials, rerouting and sharply higher war-risk insurance, directly reducing the rate of cross-border diesel shipments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_market_fragment</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="energy_market_fragment::maritime_security_incide" target="us_china_rivalry::data_access_restrictions" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A spike in hostile or disruptive maritime incidents leads governments to treat shipping- and port-related data as a national-security asset and rapidly tighten legal and contractual limits on cross-border data sharing (especially with rival-state firms), increasing formal and de facto data-access restrictions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_market_fragment</data>
  <data key="d39">us_china_rivalry</data>
</edge>
