          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An expansion in accessible AI compute eases production bottlenecks and reduces uncertainty about growth prospects for AI-exposed firms (stabilizing earnings expectations), which dampens short-term asset price swings; conversely, sudden compute shortages increase volatility." />
