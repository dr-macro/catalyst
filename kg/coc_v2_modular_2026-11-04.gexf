          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sustained escalation can trigger targeted sanctions, secondary-sanctions risk, and insurance/shipping disruptions that deter cross-border investment and transactions between US and Chinese tech entities, reducing net cross-border flows." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_conflict" />
          <attvalue for="39" value="us_china_tech_rivalry" />
