      <edge source="us_political_realignment::geopolitical_tension_lev" target="global_energy_supply_sho::oil_supply_risk" id="663">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Higher interstate tensions associated with a U.S. political realignment increase the likelihood of sanctions, shipping route risks and export restrictions, directly elevating the probability of oil supply interruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::geopolitical_tension_lev" target="russia_ukraine_war::oil_price_level" id="664">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A US political realignment that raises interstate friction (tougher sanctions posture, reduced diplomacy and embargo threats) immediately increases risk premia on Russian energy exports, disrupts shipping/contracting and insurance for oil trade, and so pushes global crude prices higher." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::geopolitical_tension_lev" target="russia_ukraine_war::sector_capital_realloc" id="665">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An uptick in geopolitical friction tied to US political realignment prompts rapid portfolio shifts away from Russian and other exposed EM assets into US defense, energy, and perceived safe‑haven sectors, producing measurable cross‑sector capital reallocation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::geopolitical_tension_lev" target="us_china_tech_rivalry::cross_border_flows" id="666">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rising interstate geopolitical tensions lead to sanctions, tighter capital controls and investor risk aversion, which directly reduce net cross-border capital movements (portfolio and direct investment) between the US and China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::geopolitical_tension_lev" target="us_iran_conflict::geo_conflict_intensity" id="667">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="An upward swing in geopolitical tension driven by U.S. political realignment raises domestic political pressure for tougher posture and more kinetic/diplomatic measures, increasing the likelihood and intensity of U.S.–Iran escalatory actions (strikes, sanctions, proxy operations)." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="us_iran_conflict" />
          <attvalue for="28" value="0" />
