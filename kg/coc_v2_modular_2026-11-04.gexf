      <edge source="us_iran_conflict::geo_conflict_intensity" target="russia_ukraine_war::geopolitical_tension" id="58">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A marked escalation in US‑Iran hostilities draws NATO/US diplomatic and military attention and prompts reciprocal signaling from Russia (diplomatic posturing, force deployments or opportunistic military moves), increasing the geographic spread and intensity of interstate tensions that compound the Russia‑Ukraine security environment." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
