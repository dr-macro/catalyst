      <edge source="us_political_realignment::regulatory_pressure_on_a" target="russia_ukraine_war::market_volatility" id="652">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sudden increases in US regulatory pressure on AI produce abrupt repricing and liquidity shifts in technology and adjacent sectors, which spill into energy and defense markets tied to the Russia‑Ukraine conflict and thereby raise overall market volatility tied to the war." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::regulatory_pressure_on_a" target="us_china_tech_rivalry::ai_investment_rate" id="653">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An increase in regulatory pressure (new disclosure, liability, export-control or approval requirements) raises compliance costs and legal uncertainty for AI projects, prompting VCs and corporates to slow, delay, or redirect AI funding and thus lower the AI investment rate." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::regulatory_pressure_on_a" target="us_iran_conflict::capital_allocation_flow" id="654">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Heightened regulatory scrutiny and the prospect of constraining rules increase perceived policy risk for AI projects, prompting institutional investors and corporates to delay, reprice, or withdraw planned allocations and shift capital toward lower‑risk uses (buybacks, cash, non‑AI sectors)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="us_iran_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
