          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Expanded local power-generation and grid capacity lowers operational risk and cost for data centres and manufacturing, attracting foreign direct investment and increasing cross-border capital flows into tech and cloud infrastructure projects." />
