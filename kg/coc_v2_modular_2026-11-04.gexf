      <edge source="russia_ukraine_war::sector_capital_realloc" target="global_energy_supply_sho::power_supply_capacity" id="210">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Reallocation of capital toward energy and strategic infrastructure in response to the conflict accelerates financing and construction of generation and transmission projects, increasing available power supply capacity over the medium term." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sector_capital_realloc" target="us_china_tech_rivalry::ai_investment_rate" id="211">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Reallocation of capital toward defense, cybersecurity and dual‑use sectors triggered by the war redirects corporate and government R&amp;D and procurement budgets into AI and autonomy projects, raising AI investment rates in both U.S. and Chinese tech ecosystems." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sector_capital_realloc" target="us_iran_conflict::capital_allocation_flow" id="212">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Reallocation of capital toward energy and defense sectors because of the Russia–Ukraine war redirects institutional flows and raises valuations, altering corporate and investor capital allocation decisions relevant to firms and funds exposed to the US–Iran arena." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_iran_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sector_capital_realloc" target="us_political_realignment::capital_flow_to_ai" id="213">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="When the war redirects investor and corporate capital into defense, energy, and commodity sectors, those reallocations withdraw marginal funding available to AI startups and corporate AI projects, lowering net capital flows to AI." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_political_realignment" />
          <attvalue for="28" value="0" />
        </attvalues>
