      <edge source="us_political_realignment::ai_compute_capacity" target="global_energy_supply_sho::compute_energy_demand_ra" id="615">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Expansion of accessible AI compute capacity enables more large-scale training and higher sustained inference workloads, which directly increases electricity consumption growth from compute loads." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realignment" />
