          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sharp increase in foreign (especially adversary-linked) capital into AI firms triggers mandatory national-security reviews and politically driven oversight (CFIUS-style reviews, transaction probes), increasing the intensity of regulatory scrutiny in the US–China tech rivalry." />
