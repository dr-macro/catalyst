          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalation and geographic spillovers from the Russia–Ukraine war raise allied threat perceptions and military/diplomatic posture, directly increasing bilateral U.S.–China tension through competing alignments, regional deployments, and security signaling." />
