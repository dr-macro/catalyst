          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Concentrated deployment of high-density compute facilities raises local power draw and transmission usage, reducing available spare generation/transmission margin and creating near-term capacity tightness." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="39" value="global_energy_supply_sho" />
