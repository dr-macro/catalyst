          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An escalation in US–Iran conflict raises US national-security concerns and political pressure, prompting faster and broader export controls and CFIUS-like reviews of China-linked tech transactions, increasing regulatory scrutiny in the US–China tech realm." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_conflict" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
