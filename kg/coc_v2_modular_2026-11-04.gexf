          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Heightened security concerns from the conflict prompt governments to tighten export controls, investment screening and sanctions, directly increasing regulatory scrutiny of cross‑border tech transactions involving U.S. and Chinese firms." />
