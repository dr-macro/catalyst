      <edge source="sino_us_geoecon_rivalry::export_control_stringenc" target="ai_infra_market_shift::compute_capacity_stock" id="389">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Tighter export controls on accelerators, high-end chips and related components directly prevent cross‑border shipments and installations of AI hardware, producing immediate shortfalls in operational compute capacity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="sino_us_geoecon_rivalry" />
          <attvalue for="39" value="ai_infra_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="sino_us_geoecon_rivalry::export_control_stringenc" target="cyber_critical_attacks::cyber_attack_incidence" id="390">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Tighter export controls block legal transfer of advanced components and knowledge, incentivizing state and criminal actors to conduct cyber intrusions against research labs, suppliers, and supply‑chain partners to acquire embargoed technology." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="sino_us_geoecon_rivalry" />
          <attvalue for="39" value="cyber_critical_attacks" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="sino_us_geoecon_rivalry::export_control_stringenc" target="iran_gulf_escalation::maritime_incident_rate" id="391">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharper export controls on advanced components push Beijing toward deeper security cooperation and material/dual‑use transfers to Iran (or faster arms‑supply workarounds), materially increasing Iranian/Proxy capability and willingness to mount drone/mine/attacker operations against shipping." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="sino_us_geoecon_rivalry" />
          <attvalue for="39" value="iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="sino_us_geoecon_rivalry::export_control_stringenc" target="russia_ukraine_war::allied_political_cohesio" id="392">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stricter US-led export controls on technologies bound for China create economic and industrial friction with trade-dependent allies (especially in Europe and East Asia), producing policy disagreements and delays in coordinated sanctions and aid decisions related to Ukraine that reduce allied political cohesion." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="sino_us_geoecon_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
