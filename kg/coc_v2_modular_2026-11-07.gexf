      <edge source="sino_us_geoecon_rivalry::security_econ_policy" target="ai_infra_market_shift::regulatory_scrutiny" id="503">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="When economic measures are explicitly justified by national security, governments institute additional review processes, export checks and licensing requirements that broaden and intensify oversight of AI activities." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="sino_us_geoecon_rivalry" />
          <attvalue for="39" value="ai_infra_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="sino_us_geoecon_rivalry::security_econ_policy" target="cyber_critical_attacks::regulatory_scrutiny" id="504">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="When economic policy is explicitly framed as national security, regulators receive broader mandates and political cover to increase inspections, audit demands, export controls enforcement, and sectoral oversight of firms and platforms." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="sino_us_geoecon_rivalry" />
          <attvalue for="39" value="cyber_critical_attacks" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="sino_us_geoecon_rivalry::security_econ_policy" target="iran_gulf_escalation::kinetic_conflict_rate" id="505">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Framing economic policy explicitly as national security (more sanctions, interdictions, and coercive economic measures) raises incentives for punitive responses by Iran and its proxies, producing more raids, strikes and escalatory kinetic actions in the Gulf." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="sino_us_geoecon_rivalry" />
          <attvalue for="39" value="iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="sino_us_geoecon_rivalry::security_econ_policy" target="russia_ukraine_war::negotiation_intensity" id="506">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Harder security‑framed economic policies produce stricter sanctions and conditionalities presented as non‑negotiable, reducing the political space and mutual incentive for Russia and Ukraine (and their backers) to engage in or sustain high‑tempo negotiated talks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="sino_us_geoecon_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
