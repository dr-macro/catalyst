          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Surges in AI investment drive rapid hiring, contractor onboarding, and vendor proliferation (often with rushed access provisioning and weak segregation of duties), increasing the number of privileged accounts and opportunities for credential theft or insider collusion that raise insider compromise risk." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_infra_market_shift" />
          <attvalue for="39" value="cyber_critical_attacks" />
