          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalating great‑power security competition linked to the Ukraine war increases permissive conditions and proxy activity at sea, producing more interdictions, harassments and testing of maritime boundaries in the Gulf region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
