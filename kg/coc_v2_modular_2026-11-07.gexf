          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Improved allied political cohesion produces faster intelligence sharing, coordinated incident-triage and access to partner SOC resources, directly increasing collective detection and response capability across allied networks." />
