          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Physical curtailment of oil/gas flows reduces local power availability or forces utilities to defer new hookups, directly causing AI infrastructure projects to be postponed or slowed while operators secure reliable power." />
