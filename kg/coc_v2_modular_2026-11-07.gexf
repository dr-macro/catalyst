          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Amplified great‑power security competition linked to the Russia war accelerates political support and budgetary commitments (grants, procurement guarantees, regulatory preferences) to scale domestic semiconductor and AI hardware production, directly expanding indigenous advanced‑tech capacity to reduce reliance on China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="sino_us_geoecon_rivalry" />
