      <edge source="russia_ukraine_war::kinetic_conflict_intensi" target="ai_infra_market_shift::data_center_build_rate" id="41">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising active combat raises local and regional physical‑security risk, drives up insurance and contractor costs, and disrupts supply/logistics, causing firms to postpone or cancel new data‑center construction." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_infra_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_conflict_intensi" target="cyber_critical_attacks::cyber_attack_incidence" id="42">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="As kinetic operations escalate, state and proxy actors rapidly increase synchronized offensive cyber operations (targeting command-and-control, logistics, infrastructure and communications) to complement strikes, raising the rate of successful intrusions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="cyber_critical_attacks" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_conflict_intensi" target="cyber_critical_attacks::detection_response_cap" id="43">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher kinetic intensity causes physical damage to power, telecoms and data centers and diverts cyber personnel and funding to urgent wartime tasks, directly degrading operational detection and incident‑response capacity in the affected theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="cyber_critical_attacks" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_conflict_intensi" target="iran_gulf_escalation::oil_price_volatility" id="44">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rapid uptick in kinetic operations in the Russia–Ukraine theatre raises market perceptions of near‑term supply and sanction risks, prompting sudden repricing and higher short‑term oil price volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_conflict_intensi" target="sino_us_geoecon_rivalry::export_control_stringenc" id="45">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sharp increases in battlefield use and capture/diversion of Western dual‑use hardware in Ukraine prompt US policymakers to broaden and tighten export controls and licensing rules (including extraterritorial carve‑outs) to prevent similar transfers — measures that are then applied to technology flows involving China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="sino_us_geoecon_rivalry" />
          <attvalue for="28" value="0" />
