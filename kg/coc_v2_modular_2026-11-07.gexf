          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising perceived risk that deals or ceasefires will be violated incentivizes preemptive human‑intelligence and recruitment efforts by adversaries and proxies, increasing the likelihood that insiders will be co‑opted or compromised." />
