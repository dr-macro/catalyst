      <edge source="sino_us_geoecon_rivalry::supply_chain_conc" target="ai_infra_market_shift::project_delay_rate" id="401">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="High geographic concentration of critical inputs (e.g., fabs, specialized components) raises vulnerability to sanctions, port closures or production interruptions, causing procurements to be postponed and infrastructure projects to be delayed." />
