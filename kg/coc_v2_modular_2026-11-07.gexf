      <edge source="russia_ukraine_war::external_security_compet" target="ai_infra_market_shift::project_delay_rate" id="167">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened strategic rivalry triggers export restrictions, component embargoes (GPUs, networking), and tighter investment reviews that interrupt supply chains and approvals, increasing delays for AI infrastructure projects." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_infra_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
