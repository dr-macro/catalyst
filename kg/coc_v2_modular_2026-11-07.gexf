      <edge source="iran_gulf_escalation::energy_supply_disruption" target="cyber_critical_attacks::cyber_attack_incidence" id="281">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Physical disruptions to oil and gas flows force operators into emergency configurations, increased remote access and degraded patching/segmentation while simultaneously raising the economic and strategic value of energy targets, provoking opportunistic criminals and state-linked groups to mount more cyber intrusions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="cyber_critical_attacks" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::energy_supply_disruption" target="russia_ukraine_war::allied_political_cohesio" id="282">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Physical disruptions to Gulf oil and gas flows force European and other allies into emergency bilateral energy negotiations and divergent procurement choices, producing disputes over sanctions, price‑cap implementation and burden‑sharing that weaken coordinated political stances toward Russia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::energy_supply_disruption" target="russia_ukraine_war::kinetic_conflict_intensi" id="283">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Disruptions to Gulf hydrocarbon flows push up energy revenues and create fiscal/political space for energy exporters while simultaneously raising political costs for sustained Western military support, enabling or incentivizing higher Russian operational tempo in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::energy_supply_disruption" target="sino_us_geoecon_rivalry::security_econ_policy" id="284">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Physical interruptions to Gulf oil and gas flows lead both Washington and Beijing to explicitly reframe economic measures (subsidies, stockpiling, trade measures) as national‑security imperatives aimed at energy and supply resilience." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="sino_us_geoecon_rivalry" />
