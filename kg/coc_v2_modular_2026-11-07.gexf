          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Larger private investment flows into AI firms—particularly in states aligned with or supplying technologies to Moscow—accelerate development of dual‑use surveillance and offensive tools, prompting rival powers to increase strategic pressure and competition around the Ukraine theatre." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_infra_market_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
