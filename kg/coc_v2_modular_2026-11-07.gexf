          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Higher geographic concentration of critical production and inputs creates few high‑value targets (fabs, logistics hubs, component suppliers) that attackers focus on, raising the frequency of successful disruptive or espionage cyber operations." />
