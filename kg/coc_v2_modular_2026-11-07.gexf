      <edge source="russia_ukraine_war::external_security_compet" target="ai_infra_market_shift::ai_capital_inflow" id="166">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating great‑power security competition leads governments to increase defence and strategic AI budgets and prompts private investors to back dual‑use AI firms, raising net capital flows into AI." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_infra_market_shift" />
