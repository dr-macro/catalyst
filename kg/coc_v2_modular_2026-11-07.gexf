          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sustained increases in AI investment into Gulf firms deepen commercial and security partnerships (joint ventures, on‑the‑ground programs), reducing immediate reliance on crisis shuttle diplomacy as economic linkage and private‑sector channels absorb routine coordination." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_infra_market_shift" />
          <attvalue for="39" value="iran_gulf_escalation" />
          <attvalue for="28" value="0" />
