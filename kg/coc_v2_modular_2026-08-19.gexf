      <edge source="russia_ukraine_war::drone_diffusion_rate" target="iran_gulf_conflict::attacks_on_shipping_rate" id="216">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Maritime-capable drones, sensors and tactical lessons diffused from the Ukraine conflict are adopted by Gulf state and proxy actors, enabling more frequent remote strikes and harassing attacks on commercial vessels." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_diffusion_rate" target="israel_palestine_conflic::cross_border_strikes" id="217">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rapid operational diffusion of attack drones and counter-drone tactics from the Ukraine theatre to regional actors and illicit suppliers increases non-state and proxy capability to conduct long-range, cross-boundary strike missions against adversary territory." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_diffusion_rate" target="us_asia_alliance_stress::joint_drill_intensity" id="218">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="As UAS capabilities and tactics proven in Ukraine spread to other state and non-state actors, U.S. and Asian allies increase the frequency and scope of joint counter-UAS, ISR and layered-defense exercises to develop tactics, sensors, and rules of engagement." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_asia_alliance_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_diffusion_rate" target="us_china_rivalry::compute_infrastructure_c" id="219">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Faster diffusion of autonomous and swarm drone tactics raises near-term demand for training, simulation and edge/cloud compute for both offensive autonomy and defensive counter-AI systems, prompting accelerated deployment and procurement of compute infrastructure by governments and firms involved in the US–China competition." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
