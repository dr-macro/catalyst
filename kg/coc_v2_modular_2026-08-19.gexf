      <edge source="us_asia_alliance_stress::joint_drill_intensity" target="israel_palestine_conflic::security_incident_rate" id="492">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large-scale Indo‑Pacific joint exercises temporarily redeploy US naval/air ISR and rapid‑reaction assets away from the Eastern Mediterranean/Red Sea, reducing surveillance/response capacity and raising the frequency of security incidents in the Israel–Palestine theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_asia_alliance_stress" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_asia_alliance_stress::joint_drill_intensity" target="russia_ukraine_war::military_support_stock" id="493">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained increase in large-scale US-Asia joint exercises consumes strategic airlift, munitions stocks, maintenance slots and forward-deployed personnel, reducing the immediate availability and surge capacity of equipment and logistics that can be redirected to Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_asia_alliance_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_asia_alliance_stress::joint_drill_intensity" target="us_china_rivalry::ai_hardware_capex_rate" id="494">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rapid increase in the scale/frequency of allied military exercises creates immediate operational requirements and procurement signals for AI-enabled platforms, prompting defense agencies and prime contractors to accelerate capital spending on AI-specific hardware (chips, sensors, data-center upgrades)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_asia_alliance_stress" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_asia_alliance_stress::joint_drill_intensity" target="us_china_rivalry::regulatory_scrutiny_inte" id="495">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="More intense allied drills are interpreted as rising security tensions and often trigger faster unilateral policy responses (tighter export controls, investment screening, and oversight of AI collaborations) to prevent perceived technology transfer risks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_asia_alliance_stress" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
