      <edge source="us_asia_alliance_stress::joint_drill_intensity" target="us_asia_alliance_stress::domestic_policy_pressure" id="491">
        <attvalues>
          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="2" />
