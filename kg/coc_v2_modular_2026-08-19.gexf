      <edge source="israel_palestine_conflic::cross_border_strikes" target="iran_gulf_conflict::military_escalation_leve" id="723">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Cross-border strikes that damage or kill personnel linked to Iranian proxies (e.g., in Lebanon or Syria) provoke immediate Iranian state and IRGC naval force posture increases and explicit use‑of‑force threats in adjacent maritime zones, raising aggregated military escalation levels in the Gulf and nearby seas." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_palestine_conflic" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_palestine_conflic::cross_border_strikes" target="iran_gulf_conflict::attacks_on_shipping_rate" id="724">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Strikes across borders that hit Iranian‑aligned groups or logistics nodes increase the likelihood that Iran or its proxies will carry out or authorize attacks on commercial vessels to signal retaliation and impose costs on adversaries and their partners." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_palestine_conflic" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_palestine_conflic::cross_border_strikes" target="us_asia_alliance_stress::deterrence_credibility" id="725">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating cross‑border strikes that imply wider regional involvement prompt reallocation of forward‑deployed US forces to the Middle East and create perceptions of overstretch, thereby reducing the perceived credibility of US‑backed deterrence in Asia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_palestine_conflic" />
          <attvalue for="39" value="us_asia_alliance_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_palestine_conflic::cross_border_strikes" target="us_china_rivalry::regulatory_scrutiny_inte" id="726">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Use of cross-border strikes that employ commercially available sensors, autonomy or dual-use systems triggers governments to accelerate review and restrictions on AI exports, acquisitions and military-adjacent AI applications, increasing regulatory intensity toward AI firms." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="israel_palestine_conflic" />
          <attvalue for="39" value="us_china_rivalry" />
