      <edge source="iran_gulf_conflict::military_escalation_leve" target="israel_palestine_conflic::ceasefire_stability" id="33">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Heightened military escalation in the Gulf raises perceived risk of wider regional war and incentivizes militant actors (e.g., Hamas, Hezbollah) and state patrons to test or abandon temporary truces, reducing the perceived durability of ceasefires." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::military_escalation_leve" target="israel_palestine_conflic::diplomatic_mediation" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising Gulf military tensions trigger third-party states (US, Qatar, Egypt, EU) to intensify shuttle diplomacy and mediation in Israel–Palestine to prevent spillover and manage parallel crisis channels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::military_escalation_leve" target="russia_ukraine_war::military_support_stock" id="35">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A sharp escalation in the Gulf prompts the US and European suppliers to reprioritize and redirect finite stocks of air-defense munitions, interceptors and urgent battlefield supplies to partners in the Middle East, delaying or reducing shipments earmarked for Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::military_escalation_leve" target="russia_ukraine_war::air_defense_capacity" id="36">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened Gulf conflict leads states to forward-deploy or transfer SAM systems and spares to regional partners and consume reserve interceptors, directly reducing the pool of operational air-defence assets available for transfer to Ukrainian forces." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::military_escalation_leve" target="us_asia_alliance_stress::joint_drill_intensity" id="37">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A rise in overt military escalation prompts the US and regional partners to schedule and enlarge coordinated naval and air exercises to signal readiness, reassure partners, and improve interoperability." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="us_asia_alliance_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::military_escalation_leve" target="us_china_rivalry::regulatory_scrutiny_inte" id="38">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A noticeable uptick in military escalation around the Gulf prompts U.S. and allied security agencies to expand export controls, sanctions screening and national-security vetting of AI-relevant technology flows to China, raising regulatory scrutiny intensity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
