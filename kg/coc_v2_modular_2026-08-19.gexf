      <edge source="iran_gulf_conflict::attacks_on_shipping_rate" target="israel_palestine_conflic::cross_border_strikes" id="60">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A surge in attacks on commercial shipping attributed to Iran or its proxies prompts Israeli kinetic reprisals and pre-emptive strikes against Iran-aligned groups in Lebanon/Syria, increasing the frequency and intensity of cross‑border strikes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::attacks_on_shipping_rate" target="israel_palestine_conflic::security_incident_rate" id="61">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="1" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Increased attacks on shipping raise regional alert levels and produce short-term operational upticks (raids, interdictions, clashes) by state and non‑state actors across neighboring fronts, raising the rate of discrete security incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::attacks_on_shipping_rate" target="russia_ukraine_war::drone_diffusion_rate" id="62">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Increased attacks on commercial shipping accelerate operational learning and create demand for maritime loitering and kamikaze drone designs, which are then copied, brokered or exported and adapted into other theaters including the Russia–Ukraine conflict." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::attacks_on_shipping_rate" target="us_asia_alliance_stress::diplomacy_engagement_rat" id="63">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An increase in attacks on commercial shipping forces more frequent formal and informal diplomatic contacts (coalition meetings, port-state consultations, flag-state coordination) to organize escorts, information-sharing, and legal responses." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="us_asia_alliance_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::attacks_on_shipping_rate" target="us_asia_alliance_stress::deterrence_credibility" id="64">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="If attacks on shipping continue despite allied presence and defensive measures, partners perceive defenses as ineffective and adversaries as willing to accept costs, reducing perceived deterrence credibility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="us_asia_alliance_stress" />
          <attvalue for="28" value="0" />
