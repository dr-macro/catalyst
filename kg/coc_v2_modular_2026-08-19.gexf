          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A surge in external military support directed toward Ukraine diverts political attention, logistical resources, and diplomatic capital of key mediators (notably Western governments), reducing the intensity and persistence of third‑party mediation efforts in the Israel–Palestine system." />
