          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Intensive third‑party mediation efforts (particularly US-led shuttle diplomacy) absorb senior diplomatic bandwidth and ambassadorial engagement, lowering the frequency and intensity of US diplomatic outreach and informal engagement with Asian partners in the near term." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_palestine_conflic" />
          <attvalue for="39" value="us_asia_alliance_stress" />
