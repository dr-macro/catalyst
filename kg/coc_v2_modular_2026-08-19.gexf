      <edge source="us_asia_alliance_stress::deterrence_credibility" target="iran_gulf_conflict::attacks_on_shipping_rate" id="506">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher perceived deterrence from US-led defenses raises the expected cost for Iran and its proxies to target commercial shipping, directly reducing the frequency of strikes and boardings." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_asia_alliance_stress" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_asia_alliance_stress::deterrence_credibility" target="israel_palestine_conflic::cross_border_strikes" id="507">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Perceived weakening of US/allied deterrence as attention and credibility shift toward Asia emboldens regional actors and proxies to conduct more cross‑border strikes, expecting limited outside intervention." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_asia_alliance_stress" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_asia_alliance_stress::deterrence_credibility" target="israel_palestine_conflic::ceasefire_stability" id="508">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Lowered confidence in external guarantees from strained alliances makes local actors less constrained by ceasefire terms, decreasing perceived durability and increasing violations of temporary pauses." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_asia_alliance_stress" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_asia_alliance_stress::deterrence_credibility" target="russia_ukraine_war::crossborder_incident_rat" id="509">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A perceived drop in US deterrence credibility (as signalled by retrenchment or inconsistent commitments in Asia) lowers the anticipated political and military costs for probing adversaries, incentivizing Russia to increase transboundary strikes, airspace violations or other spillover incidents." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_asia_alliance_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_asia_alliance_stress::alliance_policy_alignmen" target="us_asia_alliance_stress::joint_drill_intensity" id="510">
        <attvalues>
          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="2" />
          <attvalue for="33" value="+" />
          <attvalue for="28" value="0" />
