      <edge source="israel_palestine_conflic::diplomatic_mediation" target="russia_ukraine_war::kinetic_strike_intensity" id="744">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Intense, sustained third‑party mediation efforts focused on Israel–Palestine draw diplomatic attention and political leverage from major mediators (notably the US and EU), reducing external coordination and restraints on Moscow and thereby enabling Russia to increase the tempo or boldness of kinetic strikes in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_palestine_conflic" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
