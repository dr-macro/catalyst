      <edge source="us_china_rivalry::regulatory_scrutiny_inte" target="israel_palestine_conflic::cross_border_strikes" id="392">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A step-up in regulatory scrutiny tied to the US–China rivalry (e.g., export controls, sanctions) restricts transfer of advanced AI chips and integrated systems to regional actors, reducing their ability to conduct or sustain cross-border strike operations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="israel_palestine_conflic" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::regulatory_scrutiny_inte" target="russia_ukraine_war::drone_diffusion_rate" id="393">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Tighter export controls and enforcement related to AI hardware, firmware and software restrict legal and semi-licit transfer channels for high-end autonomy components, directly slowing the rate at which advanced drone capabilities reach Russian forces and intermediaries." />
          <attvalue for="37" value="0-6 months" />
