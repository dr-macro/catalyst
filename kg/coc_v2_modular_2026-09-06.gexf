      <edge source="us_china_tech_rivalry::industrial_policy_streng" target="energy_supply_shock::energy_supply_flow" id="442">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Aggressive industrial policies to onshore and rapidly expand AI semiconductor and datacenter capacity boost domestic energy consumption (power and feedstock), reducing exportable volumes and thereby lowering net energy supply flows to global markets." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="energy_supply_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::industrial_policy_streng" target="global_bond_turmoil::cross_border_flows" id="443">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger industrial policies (export controls, subsidies, localization mandates) force onshoring and discourage cross‑border M&amp;A and FDI in affected tech sectors, reducing net cross‑border capital flows as investment becomes more domesticized." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::industrial_policy_streng" target="russia_ukraine_war::kinetic_strike_intensity" id="444">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="State-led expansion of domestic defence and dual-use AI/robotics production (and state-facilitated export channels) increases the volume and sophistication of systems available to Russia, enabling higher-rate and more precise strike operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::industrial_policy_streng" target="russia_ukraine_war::alliance_cohesion_level" id="445">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Coordinated industrial policies and export-control regimes (subsidies, procurement rules, and harmonised controls) incentivise allied firms and governments to align procurement and tech-policy choices, raising political and operational cohesion among Ukraine-supporting states." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::industrial_policy_streng" target="us_iran_confrontation::oil_flow_disruption_rate" id="446">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Tighter US industrial-policy measures and export controls drive deeper China–Iran technical and material cooperation (including dual‑use weaponization assistance), which increases Iran's and proxies' capacity to strike tankers, terminals and pipelines, raising oil-flow disruptions." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="us_iran_confrontation" />
          <attvalue for="28" value="0" />
        </attvalues>
