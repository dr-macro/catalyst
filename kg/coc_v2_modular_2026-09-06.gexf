      <edge source="russia_ukraine_war::alliance_cohesion_level" target="global_bond_turmoil::inflation_expectations" id="104">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger political and operational cohesion among allied states enables coordinated energy embargoes or stricter export controls that tighten global energy supply, directly lifting market expectations of future consumer‑price inflation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion_level" target="us_china_tech_rivalry::regulatory_pressure_leve" id="105">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher cohesion among Western allies on responses to the war enables coordinated regulatory actions (harmonized export controls, investment-screening and joint sanctions) that raise cross-border legal and compliance burdens on AI-related transactions with strategic competitors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion_level" target="us_iran_confrontation::retaliation_momentum" id="106">
