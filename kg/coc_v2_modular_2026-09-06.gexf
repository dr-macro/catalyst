          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="An uptick in energy‑related sanctions and trade restrictions directly escalates interstate disputes and reciprocal measures, hardening diplomatic stances and raising strategic tensions between the US and China." />
