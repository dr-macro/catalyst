          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger cohesion among U.S. allies over Ukraine lowers Washington's political cost of punitive responses, shortening decision times and increasing the velocity and likelihood of reciprocal tit‑for‑tat actions in the U.S.–Iran confrontation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_iran_confrontation" />
          <attvalue for="28" value="0" />
        </attvalues>
