      <edge source="us_china_tech_rivalry::geopolitical_tension" target="energy_supply_shock::sanction_intensity" id="460">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A spike in US–China strategic friction directly triggers governments to adopt targeted export controls, financial restrictions and formal sanctions related to energy trade and services, increasing overall sanction intensity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="energy_supply_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="energy_supply_shock::energy_price_level" id="461">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Heightened rivalry raises market risk premia and precautionary buying in oil and gas markets (insurance, hedging and speculative flows), producing near‑term upward pressure on spot energy prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="energy_supply_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="global_bond_turmoil::cross_border_flows" id="462">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating US–China tech rivalry prompts investors and corporates to rapidly reroute capital into perceived safe‑haven jurisdictions (repatriation, flight to US/Euro sovereigns and dollar liquidity), materially increasing cross‑border gross flows and reallocations over weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="russia_ukraine_war::sanctions_pressure_level" id="463">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising US–China geopolitical friction increases political pressure in Washington and among partners to broaden and tighten export controls and secondary sanctions on intermediaries that could supply Russia, raising the breadth and enforcement intensity of sanctions on the conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="us_iran_confrontation::military_deployment_leve" id="464">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An uptick in US–China geopolitical tension compels the US to reallocate naval and air assets toward the Indo‑Pacific, reducing forward-deployed US/coalition force levels in the Middle East and thus lowering regional deployment concentration." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="us_iran_confrontation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
