      <edge source="us_iran_confrontation::maritime_incident_rate" target="energy_supply_shock::energy_price_level" id="212">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rising frequency of naval confrontations in key chokepoints raises shipping risk premiums, insurance and freight costs and generates an immediate market risk premium that pushes up spot energy prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="energy_supply_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::maritime_incident_rate" target="global_bond_turmoil::bond_market_volatility" id="213">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in naval confrontations at choke points produces episodic shipping/insurance shocks and sudden portfolio re‑hedging (duration rebalances and liquidity withdrawals) that produce larger intraday and interday swings in global sovereign bond prices and yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::maritime_incident_rate" target="russia_ukraine_war::sanctions_pressure_level" id="214">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rise in attacks/interdictions on commercial shipping and chokepoints increases energy security and insurance shocks that make governments reluctant to expand or strictly enforce additional sanctions on Russian energy for fear of exacerbating supply disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::maritime_incident_rate" target="us_china_tech_rivalry::industrial_policy_streng" id="215">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An uptick in naval confrontations around key chokepoints spurs governments to subsidize domestic manufacturing, secure ports, and onshore critical technology production (including AI hardware and sovereign data centers) as protective industrial policy measures." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
