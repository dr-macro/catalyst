      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="us_china_tech_rivalry::compute_resource_conc" id="33">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Destructive strikes on Ukrainian data centers, fiber routes and local hosting capacity force commercial and research workloads to be migrated quickly to large, geographically safer cloud providers, concentrating high-performance compute capacity with a smaller set of hyperscalers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
