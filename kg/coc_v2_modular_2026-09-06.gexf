          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharper, more far‑reaching energy-related sanctions impose asymmetric burdens on alliance members, provoking disputes over exemptions and burden-sharing that erode political and policy alignment." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_supply_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
