      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="energy_supply_shock::crude_capacity_util" id="30">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Increased kinetic strikes that damage or disable oilfields, pumping stations, pipelines and export infrastructure force producers to shut wells and processing trains, directly lowering utilization of installed crude production capacity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_supply_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="energy_supply_shock::refined_inventory_level" id="31">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained attacks on refineries, storage depots and fuel transport routes disrupt refining throughput and deliveries, causing regional on‑hand refined fuel stocks to be drawn down as supply is interrupted and logistical buffers are consumed." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_supply_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_strike_intensity" target="global_bond_turmoil::bond_market_volatility" id="32">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Periods of elevated battlefield strikes materially raise near‑term geopolitical and commodity‑supply uncertainty, triggering rapid repricing and larger intraday swings in sovereign and corporate bond prices and yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
