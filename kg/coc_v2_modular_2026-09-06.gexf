          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalating sanctions that target energy exports, shipping services, insurance and finance directly block or complicate shipments and sales from affected producers, reducing net volumetric flows of crude and gas to global markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_supply_shock" />
