          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="An increase in energy‑related sanctions and trade restrictions directly interrupts payment channels, freezes or seizes assets and forces banks and funds to halt or redirect transactions, thereby reducing and rerouting net cross‑border capital and trade flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_supply_shock" />
