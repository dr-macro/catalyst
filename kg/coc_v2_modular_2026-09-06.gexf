      <edge source="us_iran_confrontation::military_deployment_leve" target="russia_ukraine_war::alliance_cohesion_level" id="231">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Large U.S. and coalition redeployments to deter or prepare for action against Iran force NATO members to reallocate planning and political attention, producing sharp disagreements over burden‑sharing and priorities that reduce policy and operational alignment on responses to Russia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::military_deployment_leve" target="us_china_tech_rivalry::regulatory_pressure_leve" id="232">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Larger and more visible forward military deployments elevate perceived national‑security threat levels and prompt legislative and executive actions to tighten export controls, foreign investment reviews, and sanctions on sensitive technologies tied to China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="39" value="us_china_tech_rivalry" />
