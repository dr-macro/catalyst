          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sharp rise in kinetic strikes in Ukraine forces the U.S. to reassign naval, air and rapid-reaction units from the Middle East to bolster European defenses, reducing forward-deployed U.S. forces available against Iran." />
