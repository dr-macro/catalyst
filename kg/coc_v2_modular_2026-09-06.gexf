          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Falling stocks of refined fuels disrupt emergency services, heating and power generation in affected population centers, producing immediate increases in medical, shelter and relief needs." />
