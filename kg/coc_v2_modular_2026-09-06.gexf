      <edge source="russia_ukraine_war::sanctions_pressure_level" target="global_bond_turmoil::cross_border_flows" id="91">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Broad, enforced sanctions (including SWIFT exclusions and secondary sanctions) and associated correspondent‑bank de‑risking directly block or reroute payments and reduce banking intermediations, causing an immediate fall in gross cross‑border capital and payment flows through affected corridors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="global_bond_turmoil::long_term_bond_yield" id="92">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Targeted sanctions that restrict bank access, commodity exports, or settlement channels increase counterparty and liquidity risk in fixed‑income markets, widening term premia and pushing up long‑term sovereign yields as investors demand compensation for higher tail and liquidity risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="us_china_tech_rivalry::industrial_policy_streng" id="93">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Widening and intensifying sanctions (including secondary controls) prompt governments to expand export controls, domestic subsidies and procurement rules to secure AI-relevant supply chains and onshore production, strengthening industrial-policy interventions aimed at AI and semiconductors." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="us_iran_confrontation::military_deployment_leve" id="94">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating sanctions on Russia drive Moscow into deeper military-technical and intelligence cooperation with Tehran, which in turn prompts the U.S. to increase regional deployments to deter or counter enhanced Iran-linked capabilities." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_iran_confrontation" />
