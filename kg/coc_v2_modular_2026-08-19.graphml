<edge source="russia_ukraine_war::kinetic_strike_intensity" target="us_asia_alliance_stress::joint_drill_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A marked rise in high-intensity missile and drone strikes in Ukraine prompts U.S. and Asian partners to rapidly expand and escalate combined exercises (air/missile-defense, integrated fire-control rehearsals) to rehearse collective responses and interoperability under high-threat conditions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_asia_alliance_stress</data>
</edge>
