<edge source="us_asia_alliance_stress::alliance_policy_alignmen" target="iran_gulf_conflict::military_escalation_leve" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Closer alignment in allied policy produces more coherent signaling and coordinated political-military measures that lower the incentive for Tehran to undertake deliberate military escalation in the Gulf.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_asia_alliance_stress</data>
  <data key="d40">iran_gulf_conflict</data>
</edge>
<edge source="us_asia_alliance_stress::alliance_policy_alignmen" target="russia_ukraine_war::military_support_stock" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Weaker policy alignment among US partners reduces political consent for coordinated arms transfers, pooled financing and stock draws, producing measurable reductions and delays in allied military aid inventories available to Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_asia_alliance_stress</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_asia_alliance_stress::alliance_policy_alignmen" target="us_china_rivalry::ai_capital_inflow_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Stronger alignment of allied policy and threat assessments reduces political and regulatory risk for investors and facilitates coordinated public-private funding initiatives, increasing cross-border and allied-directed AI capital inflows.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_asia_alliance_stress</data>
  <data key="d40">us_china_rivalry</data>
