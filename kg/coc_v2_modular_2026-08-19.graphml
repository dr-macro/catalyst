<edge source="russia_ukraine_war::crossborder_incident_rat" target="iran_gulf_conflict::market_price_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">A rising rate of cross-border incidents increases perceived geopolitical risk and triggers rapid hedging and position adjustment in energy markets, producing higher short- to medium-term price volatility for crude and refined products.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_gulf_conflict</data>
</edge>
<edge source="russia_ukraine_war::crossborder_incident_rat" target="us_china_rivalry::regulatory_scrutiny_inte" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">An uptick in cross‑border incidents (e.g., autonomous drone incursions or shootdowns) generates immediate political pressure that causes US and allied regulators to intensify scrutiny, export controls and oversight of dual‑use AI and autonomy technologies tied to the US–China rivalry.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_rivalry</data>
</edge>
