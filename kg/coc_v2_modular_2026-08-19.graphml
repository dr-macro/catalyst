<edge source="russia_ukraine_war::air_defense_capacity" target="israel_palestine_conflic::casualty_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Reallocation and consumption of interceptors and air-defence systems to sustain or raise Ukraine's air-defence capacity can create temporary shortages or delayed replenishment for other partners, degrading defensive coverage and increasing the likelihood that incoming attacks in the Israel–Palestine theatre cause more casualties.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">israel_palestine_conflic</data>
</edge>
<edge source="russia_ukraine_war::air_defense_capacity" target="us_asia_alliance_stress::deterrence_credibility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Visible improvements in adversary air-defence density and effectiveness in the Ukraine theater lower confidence that allied air-delivered retaliation would penetrate contested airspace, reducing perceived credibility of airstrike-dependent deterrent threats in Asia.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_asia_alliance_stress</data>
</edge>
