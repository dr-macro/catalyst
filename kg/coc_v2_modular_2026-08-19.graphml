<edge source="us_china_rivalry::compute_infrastructure_c" target="iran_gulf_conflict::military_escalation_leve" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A rapid increase in installed compute capacity enables more capable AI-driven ISR, targeting and autonomous maritime systems that US/ally forces deploy near the Gulf, provoking reciprocal deployments and higher-risk encounters with Iranian forces.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">iran_gulf_conflict</data>
</edge>
<edge source="us_china_rivalry::compute_infrastructure_c" target="israel_palestine_conflic::casualty_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Increased aggregate compute capacity shortens development and deployment timelines for targeting, ISR and autonomous-weapons software used in the theatre, raising engagement lethality and thus the rate of fatalities and serious injuries.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">israel_palestine_conflic</data>
</edge>
<edge source="us_china_rivalry::compute_infrastructure_c" target="russia_ukraine_war::kinetic_strike_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Growth in available cloud and training compute accelerates deployment of commercial target-processing, sensor-fusion and mission-planning AI services that shorten targeting timelines and enable higher-frequency precision strikes by actors operating in the theater.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_rivalry::compute_infrastructure_c" target="us_asia_alliance_stress::deterrence_credibility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">A marked increase in adversary compute and data-center capacity enables faster development/deployment of ML-enabled ISR, electronic attack, and cyber effects that erode the effectiveness of existing forward defenses and thus reduce perceived alliance deterrence credibility.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">us_asia_alliance_stress</data>
</edge>
