<edge source="global_market_turbulence::global_bond_yield_level" target="russia_ukraine_war::policy_rate_expect" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A sustained upward move in sovereign bond yields signals higher inflation and funding costs to markets, shifting market and agent expectations toward earlier or larger central-bank policy rate hikes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_market_turbulence::global_bond_yield_level" target="state_crypto_cybercrime::market_volatility_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Sharp moves in global bond yields force repricing of discount rates and trigger margin and position adjustments across fixed income-sensitive portfolios, increasing short- to medium-term price dispersion and volatility across markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">state_crypto_cybercrime</data>
</edge>
<edge source="global_market_turbulence::global_bond_yield_level" target="us_china_tech_rivalry::market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A rapid rise in global sovereign yields increases discount rates and hedging costs, repricing risk-sensitive assets and triggering broad risk-off flows that materially increase financial market volatility.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="global_market_turbulence::global_bond_yield_level" target="us_iran_standoff::rate_expectations" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A rise in global sovereign bond yields feeds directly into market-implied paths for short- and medium-term policy rates, causing investors to revise up interest-rate expectations that shape financing conditions relevant to US policy and regional responses.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
