<edge source="global_market_turbulence::investor_risk_appetite" target="russia_ukraine_war::market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A rise in aggregate investor risk appetite increases liquidity and predictable flow patterns into risk assets, damping price swings and thus lowering realized and implied market volatility.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_market_turbulence::investor_risk_appetite" target="state_crypto_cybercrime::cyberattack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising investor risk appetite funnels more retail and institutional capital into higher-risk crypto products and newly launched trading platforms, expanding the attack surface and incentives for cybercriminals and thereby increasing successful attacks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">state_crypto_cybercrime</data>
</edge>
<edge source="global_market_turbulence::investor_risk_appetite" target="us_china_tech_rivalry::geopolitical_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">A sudden drop in global investor risk appetite precipitates capital outflows and currency pressure in China and other Asia-linked markets, provoking defensive regulatory and trade/tech measures that raise US–China political and economic tensions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="global_market_turbulence::investor_risk_appetite" target="us_iran_standoff::market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">An increase in investor risk appetite reduces flight-to-safety flows and dampens rapid sell-offs around geopolitical incidents, directly lowering realized and implied market volatility tied to US–Iran flare-ups.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">us_iran_standoff</data>
</edge>
