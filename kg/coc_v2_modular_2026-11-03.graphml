  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A sustained fall in oil prices reduces Iran's export revenues and fiscal cushions, increasing economic and political pressure on Tehran and thereby raising its incentive to pursue provocations or coercive diplomacy that escalate US–Iran tensions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
