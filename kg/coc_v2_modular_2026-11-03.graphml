<edge source="state_crypto_cybercrime::investor_risk_appetite" target="russia_ukraine_war::tech_invest_momentum" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Higher investor willingness to assume risk redirects venture and private capital toward cybersecurity, resilient communications and dual‑use technology startups serving the conflict zone, accelerating tech investment momentum relevant to the war effort.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">state_crypto_cybercrime</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
