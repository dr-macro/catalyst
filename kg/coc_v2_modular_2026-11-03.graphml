  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">An increase in financial market volatility raises perceived downside risk and margin pressures, causing investors to reduce allocations to higher‑risk assets and lower overall risk appetite.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">state_crypto_cybercrime</data>
</edge>
