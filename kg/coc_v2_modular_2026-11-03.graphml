<edge source="global_market_turbulence::tech_equity_valuation" target="russia_ukraine_war::tech_invest_momentum" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Elevated tech equity valuations lower the cost of equity financing and increase exit prospects, prompting greater capital deployment into tech R&amp;D and projects and accelerating investment momentum.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_market_turbulence::tech_equity_valuation" target="state_crypto_cybercrime::cyberattack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Sustained declines in tech valuations reduce funding and operating cash for smaller exchanges, fintechs and security teams, degrading defensive controls and raising the incidence of successful cyber intrusions and asset theft.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">state_crypto_cybercrime</data>
</edge>
<edge source="global_market_turbulence::tech_equity_valuation" target="us_china_tech_rivalry::market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">A sharp fall in aggregate tech valuations forces index rebalancing, margin calls and systematic selling (large-cap tech is highly concentrated), which amplifies cross-asset price swings and spikes measured market volatility within weeks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_turbulence</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
