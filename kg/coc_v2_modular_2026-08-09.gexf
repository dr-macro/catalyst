          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher combat use and visible effectiveness of unmanned aerial attacks accelerates transfer of drone platforms, tactics and munitions to Middle Eastern proxies and black‑market suppliers, enabling more frequent successful attacks on vessels in the Strait." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="27" value="0" />
