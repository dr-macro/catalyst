      <edge source="russia_ukraine_war::alliance_cohesion" target="currency_market_shock::short_rate_expectations" id="470">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter political coordination among allies produces more effective sanctions and coordinated energy restrictions that push near‑term inflation and policy tightening odds higher, leading markets to price in an elevated short‑rate path." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="currency_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="global_ai_competition::regulatory_constraint" id="471">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger political cohesion among allies enables coordinated policy actions—such as harmonized export controls and joint oversight on dual-use technologies—that increase the intensity and scope of regulatory constraints on AI activities." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_ai_competition" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="strait_hormuz_standoff::passage_control" id="472">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Improved political coordination among allied states leads to synchronized naval tasking orders, common rules of transit and combined checkpoint/escort operations that increase the degree of asserted control over transit through the chokepoint." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="strait_hormuz_standoff::rerouting_rate" id="473">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger allied political agreement produces coordinated security assurances, convoying and insurance guarantees that reduce commercial incentives for shippers to divert around the Strait, lowering the vessel rerouting rate." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="us_china_econ_rivalry::export_control_intensity" id="474">
