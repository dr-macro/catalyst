          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher political cohesion among US and allied governments produces coordinated policy decisions to tighten and harmonize export controls on sensitive dual‑use and defense‑adjacent technologies, raising overall export control intensity vis‑à‑vis strategic competitors." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
