          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A surge in drone attacks against energy, transport and trading infrastructure raises intraday price volatility and counterparty credit concerns, prompting market makers and liquidity providers to widen spreads and reduce inventory, lowering market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="currency_market_shock" />
