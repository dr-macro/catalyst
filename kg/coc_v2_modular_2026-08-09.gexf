          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Surges in drone attacks create immediate demand for AI-powered detection, tracking, simulation and retraining workloads, increasing short-term consumption of compute resources for defense R&amp;D and deployed systems." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_ai_competition" />
          <attvalue for="27" value="0" />
        </attvalues>
