      <edge source="currency_market_shock::cross_border_capital_flo" target="global_ai_competition::ai_investment_flow" id="835">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A sudden pullback of cross-border portfolio and financing capital reduces available foreign venture and growth funding that directly finances AI startups and infrastructure, leading to an immediate drop in AI-directed investment flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="currency_market_shock" />
          <attvalue for="38" value="global_ai_competition" />
          <attvalue for="27" value="0" />
        </attvalues>
