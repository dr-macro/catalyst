      <edge source="us_china_econ_rivalry::export_control_intensity" target="currency_market_shock::exchange_rate_pressure" id="584">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sudden tightening of export controls raises geopolitical and counterparty risk for firms operating across the US–China corridor and suppresses export receipts and FX hedging availability, prompting corporates and portfolio investors to shift funds out of the affected currency and creating acute order‑imbalances and forward‑point pressure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_econ_rivalry" />
          <attvalue for="38" value="currency_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_econ_rivalry::export_control_intensity" target="global_ai_competition::ai_model_capability" id="585">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter export controls on leading-edge accelerators, development tools and pretrained model assets directly prevent foreign teams from obtaining the hardware and software required to train and iterate large models, slowing capability improvements within a few development cycles." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_econ_rivalry" />
          <attvalue for="38" value="global_ai_competition" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_econ_rivalry::export_control_intensity" target="global_ai_competition::compute_demand_for_ai" id="586">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Legal restrictions and licensing bottlenecks on sales and cross-border transfers of high-performance GPUs and accelerators immediately reduce purchases and cloud provisioning for large-scale training outside permitted jurisdictions, lowering near-term compute consumption." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_econ_rivalry" />
          <attvalue for="38" value="global_ai_competition" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_econ_rivalry::export_control_intensity" target="russia_ukraine_war::drone_attack_intensity" id="587">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tightened export controls on semiconductors, IMUs and RF components to China reduce trans‑shipments and third‑party flows of those parts into Russian drone production lines, degrading sortie rates and complexity of Russian unmanned attacks." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_econ_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
