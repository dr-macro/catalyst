      <edge source="currency_market_shock::cross_border_capital_flo" target="russia_ukraine_war::interceptor_stock_levels" id="836">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A sudden withdrawal of cross‑border financing from defense manufacturers or from states buying interceptors reduces working capital and delays production and procurement contracts, directly lowering available inventories of expendable interceptors for air defense." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="currency_market_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="currency_market_shock::cross_border_capital_flo" target="strait_hormuz_standoff::tanker_traffic" id="837">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sharp outflows or withdrawals of cross-border financing from regional banks, shipping firms or traders disrupt chartering and working-capital lines, causing delayed sailings, cancelled charters and fewer tankers transiting the strait." />
          <attvalue for="36" value="0-6 months" />
