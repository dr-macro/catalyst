      <edge source="russia_ukraine_war::interceptor_stock_levels" target="currency_market_shock::long_term_nominal_yield" id="401">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Depleted interceptor inventories force governments into accelerated defense procurement and associated fiscal issuance to replenish stocks, increasing expected future deficits and term premia which raises long‑term nominal yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="currency_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::interceptor_stock_levels" target="global_ai_competition::ai_investment_flow" id="402">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="When interceptor inventories are depleted (i.e., stock levels fall), governments and firms redirect procurement and R&amp;D funds toward AI-enabled alternatives and counter-UAS technologies, raising AI investment flows; conversely, higher stocks dampen that pressure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_ai_competition" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::interceptor_stock_levels" target="strait_hormuz_standoff::incident_rate" id="403">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Larger interceptor inventories permit deployment of layered air‑defense escorts and regional point‑defenses for merchant traffic or naval escorts, reducing successful hostile strikes on shipping and thus lowering the maritime incident rate." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="strait_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::interceptor_stock_levels" target="us_china_econ_rivalry::prices_critical_inputs" id="404">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising interceptor inventories reduce urgent procurement pressure for components and inputs (propellants, specialty electronics, certain metals), lowering spot demand spikes and therefore downward pressure on prices for those critical inputs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_econ_rivalry" />
          <attvalue for="27" value="0" />
