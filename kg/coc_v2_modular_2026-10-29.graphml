<edge source="russia_ukraine_war::tanker_movement_rate" target="brazil_market_turmoil::exchange_rate_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher tanker movement through key sea routes reduces fuel‑related shipping disruptions and freight costs for Brazilian exporters and importers, improving the trade position and relieving downward pressure on the real.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">brazil_market_turmoil</data>
</edge>
<edge source="russia_ukraine_war::tanker_movement_rate" target="global_money_markets::market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in tanker volume/frequency eases immediate disruption signals, reduces shipping insurance and freight-rate stress, and thereby dampens energy-driven realized and implied volatility across markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_money_markets</data>
</edge>
<edge source="russia_ukraine_war::tanker_movement_rate" target="iran_regional_escalation::shipping_lane_disruption" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Reduced tanker throughput via Black Sea routes forces rerouting through Suez/Strait of Hormuz and concentrates traffic in narrow chokepoints where Iranian-aligned actors and state interdictions raise the frequency and impact of maritime disruptions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="russia_ukraine_war::tanker_movement_rate" target="us_china_tech_rivalry::semiconductor_supply_cap" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sharp reductions in maritime oil/refined-fuel shipments raise energy and logistics costs and cause temporary power/fuel shortages at energy-intensive fabs and chemical suppliers, lowering near-term fabrication output capacity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
