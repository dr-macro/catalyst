  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Efforts to bolster deterrence credibility on the Korean Peninsula (deploying interceptors, reserving SAM rounds) lead to the diversion or retention of interceptor munitions from existing global inventories that would otherwise be available to Ukraine, lowering its interceptor ammo stock.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_standoff</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="north_korea_standoff::deterrence_credibility" target="tech_semiconductor_rival::ai_hardware_capital_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An observable improvement in deterrence credibility reduces perceived urgency among governments and private investors to accelerate defense‑oriented AI/semiconductor capital expenditures, leading to slower or deferred investment flows into AI hardware.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">north_korea_standoff</data>
  <data key="d39">tech_semiconductor_rival</data>
</edge>
