<edge source="us_iran_confrontation::supply_risk_perception" target="north_korea_standoff::diplomatic_engagement" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increased perception of supply‑disruption risk spurs emergency consultations and crisis diplomacy among the US, Japan, South Korea and regional partners to secure routes and reassure markets, boosting the intensity and frequency of formal diplomatic engagement.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confrontation</data>
  <data key="d39">north_korea_standoff</data>
</edge>
<edge source="us_iran_confrontation::supply_risk_perception" target="russia_ukraine_war::missile_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Heightened perceived risk of Middle Eastern oil/gas supply disruptions pushes global energy prices up, boosting Russia's fiscal receipts and short‑term war‑financing capacity and thereby enabling higher tempo of missile/strike operations in Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confrontation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_iran_confrontation::supply_risk_perception" target="tech_semiconductor_rival::ai_hardware_capital_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Rising perceived risk of supply disruption from US–Iran confrontation pushes firms and investors to allocate capital toward onshore or diversified AI hardware capacity (chips, inventory, domestic fabs or cloud hardware) as a risk‑mitigation and resilience investment.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_iran_confrontation</data>
  <data key="d39">tech_semiconductor_rival</data>
</edge>
<edge source="us_iran_confrontation::supply_risk_perception" target="us_treasury_market_stres::short_term_funding_liqui" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A jump in perceived supply disruption risk (energy/shipping) raises volatility and margin calls, leading dealers and repo lenders to tighten haircuts and pull back unsecured/secured funding, directly reducing short‑term funding liquidity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confrontation</data>
  <data key="d39">us_treasury_market_stres</data>
</edge>
