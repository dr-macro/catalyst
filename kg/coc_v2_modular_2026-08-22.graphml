  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Stricter enforcement increases physical inspections, compliance checks, and detention of suspect shipments, creating additional stops, documentation delays and rerouting that lengthen end‑to‑end lead times for AI hardware components.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confrontation</data>
  <data key="d39">tech_semiconductor_rival</data>
</edge>
