<edge source="us_treasury_market_stres::central_bank_ops" target="north_korea_standoff::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">If the Federal Reserve tightens or reverses asset purchases to stabilize Treasury markets, Washington is likely to curtail or reprioritize costly bilateral and multilateral security support (including timing/scale of swap‑line assistance and funded exercises), producing coordination frictions with Seoul and Tokyo.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_treasury_market_stres</data>
  <data key="d39">north_korea_standoff</data>
</edge>
<edge source="us_treasury_market_stres::central_bank_ops" target="russia_ukraine_war::external_aid_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Expansionary central‑bank operations (asset purchases, swap lines, or targeted lending) add dollar and counterparty liquidity to partner financial systems, lowering borrowing/settlement costs for allied governments and defence firms and thereby enabling larger or faster transfers of military assistance.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_treasury_market_stres</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_treasury_market_stres::central_bank_ops" target="tech_semiconductor_rival::ai_hardware_capital_flow" id="0">
  <data key="d27">cross_causal</data>
