<edge source="north_korea_standoff::alliance_cohesion" target="us_iran_confrontation::trade_rerouting_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter operational coordination among US, ROK and Japanese partners increases maritime patrols, port screening and intelligence sharing that disrupts transshipment and intermediary networks commonly used to reroute Iranian cargo, lowering the rate of trade rerouting.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_standoff</data>
  <data key="d39">us_iran_confrontation</data>
