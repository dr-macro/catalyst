<edge source="us_iran_confrontation::sanctions_pressure" target="north_korea_standoff::deterrence_credibility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sharp rise in sanctions pressure provokes retaliatory or escalatory Iranian actions that compel the US to reassign naval and air assets from the Western Pacific to the Middle East, visibly reducing the perceived credibility of US deterrence on the Korean Peninsula.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confrontation</data>
  <data key="d39">north_korea_standoff</data>
</edge>
<edge source="us_iran_confrontation::sanctions_pressure" target="tech_semiconductor_rival::trade_controls_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Intensified sanctions pressure on Iran prompts US and allied policymakers to broaden and tighten export-control lists and licensing requirements for AI-related chips and components to close diversion routes and deter circumvention.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confrontation</data>
  <data key="d39">tech_semiconductor_rival</data>
</edge>
<edge source="us_iran_confrontation::sanctions_pressure" target="us_treasury_market_stres::secondary_market_liquidi" id="0">
