<edge source="tech_semiconductor_rival::supply_chain_lead_times" target="russia_ukraine_war::external_aid_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Lengthening lead times for critical components (radars, power semiconductors, specialized processors) directly delays production and scheduled deliveries of air‑defence systems and munitions from foreign suppliers, reducing the short‑term volume and tempo of external military aid to the battlefield.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">tech_semiconductor_rival</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
