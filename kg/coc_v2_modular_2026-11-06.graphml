  <data key="d35">0.7</data>
  <data key="d36">A dominant legislative majority can pass large, time‑limited subsidies, loan guarantees and targeted tax credits for AI projects that directly unlock institutional and venture capital into AI funds and infrastructure.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_political_realignment</data>
  <data key="d39">ai_buildout_and_bust</data>
</edge>
<edge source="us_political_realignment::legislative_control_bala" target="russia_ukraine_war::military_aid_flow" id="0">
  <data key="d27">cross_causal</data>
