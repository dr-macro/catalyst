<edge source="us_political_realignment::exec_leg_alignment" target="iran_gulf_conflict::conflict_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Greater executive‑legislative alignment lowers political obstacles to presidential use of force and rapid approval of military aid to Gulf partners, increasing the probability and scale of US‑linked kinetic operations that raise regional conflict intensity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_political_realignment</data>
  <data key="d39">iran_gulf_conflict</data>
</edge>
