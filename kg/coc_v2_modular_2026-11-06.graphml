<edge source="ai_buildout_and_bust::data_center_construction" target="tech_trade_and_chip_riva::chip_production_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained rise in data‑center builds raises near‑term orders for AI accelerators and related semiconductors, prompting foundries and subcontractors to reallocate run‑schedules and prioritize capacity for those chips.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_buildout_and_bust</data>
  <data key="d39">tech_trade_and_chip_riva</data>
</edge>
