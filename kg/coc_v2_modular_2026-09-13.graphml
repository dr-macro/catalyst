<edge source="iran_regional_escalation::military_engagement" target="energy_chokepoints::crude_throughput" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Heightened kinetic strikes on ports, terminals, tankers or supporting naval assets interrupts loading and transit operations and prompts port closures or shipping refusals, directly lowering crude volumes transiting export routes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_regional_escalation</data>
  <data key="d40">energy_chokepoints</data>
</edge>
<edge source="iran_regional_escalation::military_engagement" target="russia_ukraine_war::drone_warfare_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Escalating Iranian kinetic operations increase Tehran's incentives to export or expedite transfer of armed UAVs, parts and operational know‑how to external partners or to Russia, raising the frequency and scale of armed drone use in the Ukraine conflict.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_regional_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
