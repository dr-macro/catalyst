<edge source="energy_chokepoints::crude_throughput" target="russia_ukraine_war::munitions_stockpile" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A sustained increase in crude export throughput through chokepoints raises immediate export receipts for hydrocarbon exporters (notably Russian shipments routed via regional straits), providing cash flow that accelerates procurement and delivery of ammunition and thereby increases usable munitions stockpiles.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_chokepoints</data>
  <data key="d40">russia_ukraine_war</data>
