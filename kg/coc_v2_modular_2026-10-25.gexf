      <edge source="euro_bond_fragment::political_uncertainty_le" target="ai_infrastructure_risk::regulatory_scrutiny" id="777">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising political uncertainty incentivizes legislators and regulators to pursue visible oversight and precautionary interventions on prominent technologies, increasing the frequency and intensity of AI-related reviews and enforcement actions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="euro_bond_fragment" />
          <attvalue for="38" value="ai_infrastructure_risk" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="euro_bond_fragment::political_uncertainty_le" target="russia_ukraine_war::political_pressure" id="778">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising political uncertainty in euro-area governments (e.g., fragile coalitions or surprise policy shifts) leads officials to exert more visible, ad‑hoc demands on private satellite and telecom operators to demonstrate control or score political points, increasing the frequency and intensity of political requests on service decisions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="euro_bond_fragment" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="euro_bond_fragment::political_uncertainty_le" target="us_china_tech_rivalry::firm_reconfig_rate" id="779">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher political unpredictability in Europe prompts multinational firms to accelerate relocation and restructuring of sensitive supply chains and production toward more politically stable or allied jurisdictions (including the US), increasing the rate of firm reconfiguration relevant to the US–China tech rivalry." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="euro_bond_fragment" />
          <attvalue for="38" value="us_china_tech_rivalry" />
