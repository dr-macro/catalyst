          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating proxy and direct military actions spur state and non-state actors to increase offensive cyber operations and opportunistic AI-enabled attacks (e.g., automated intrusion, disinformation), raising the frequency of successful exploits." />
          <attvalue for="36" value="0-6 months" />
