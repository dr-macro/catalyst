          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Lower communications resilience (more outages/failovers to weaker channels) increases opportunities for attackers to intercept, spoof, or inject payloads and to exploit delayed updates, raising the frequency of successful AI-enabled cyber exploits; conversely, improved resilience reduces exploit success." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_infrastructure_risk" />
          <attvalue for="27" value="0" />
        </attvalues>
