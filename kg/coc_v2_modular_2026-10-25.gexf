      <edge source="russia_ukraine_war::diplomatic_tension" target="ai_infrastructure_risk::regulatory_scrutiny" id="254">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising interstate diplomatic friction around control/use of communications and services triggers governments to open export controls, investment reviews, sanctions and other regulatory actions specifically targeting AI infrastructure and service relationships, raising overall scrutiny." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_infrastructure_risk" />
          <attvalue for="27" value="0" />
        </attvalues>
