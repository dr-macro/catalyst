          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Escalating diplomatic friction tied to the conflict leads governments to suspend or downgrade formal regulatory dialogues, joint standard-setting bodies, and information-sharing arrangements, directly reducing institutional cooperation between major powers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
