      <edge source="us_iran_standoff::military_proxy_violence" target="euro_bond_fragment::political_uncertainty_le" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An uptick in proxy and military clashes tied to the US–Iran standoff forces European governments into rapid, contested policy choices (sanctions, military posture, refugee/ad hoc energy measures), raising near‑term unpredictability about policymaking and coalition stability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="euro_bond_fragment" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::military_proxy_violence" target="russia_ukraine_war::political_pressure" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="High-profile proxy attacks tied to the US–Iran standoff generate government demands and public pressure for private satcom and cloud providers to block or limit services used by hostile actors, creating precedents and bureaucratic momentum that increase frequency and intensity of political requests to operators over their Russia–Ukraine service decisions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::military_proxy_violence" target="us_china_tech_rivalry::geo_tension_level" id="37">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Spikes in US–Iran proxy fighting trigger US escalation and alliance signaling in the wider Indo‑Pacific (surge deployments, joint exercises, sanctions), which directly raise strategic friction and perceived threat levels between the US and China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="us_china_tech_rivalry" />
