          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising diplomatic tension between Russia and Western states over the Ukraine war prompts Russia to deepen military-technical cooperation with Iran (e.g., transfers, training), which raises proxy groups' strike capability and leads to more intense attacks against US-aligned targets." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
