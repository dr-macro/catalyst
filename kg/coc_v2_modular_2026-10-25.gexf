        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising diplomatic tension (threats of sanctions, export controls, or reciprocal measures) raises the perceived probability of cross‑border economic disruption for specific European sovereigns, so investors demand wider country‑specific spreads." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="euro_bond_fragment" />
          <attvalue for="27" value="0" />
        </attvalues>
