          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating regional hostilities raise geopolitical uncertainty and prompt portfolio reallocations toward safe assets, reducing aggregate investor willingness to hold riskier energy and commodity exposures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="global_energy_volatility" />
