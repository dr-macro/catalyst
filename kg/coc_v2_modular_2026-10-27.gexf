          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Active technical or policy restrictions on commercial satellite communications degrade remote monitoring, control and automated safety systems for pipelines, LNG facilities and offshore platforms, directly raising the likelihood of operational failures and temporary supply interruptions." />
