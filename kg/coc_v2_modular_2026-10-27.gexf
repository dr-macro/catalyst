          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Increased technical and policy restrictions (throttling, geofencing, access cuts) directly interrupt transnational information and financial flows, reducing the strength and speed of political and informational shock transmission across borders." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_political_realign" />
