          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="When commercial satcom services are actively restricted (by providers or states) in the Russia–Ukraine theatre, non-state Iranian-aligned actors that rely on the same global commercial links lose real-time command, targeting and guidance, materially reducing their ability and frequency to mount long-range cross-border strikes." />
          <attvalue for="36" value="0-6 months" />
