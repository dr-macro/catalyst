          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Enhanced cross‑border signalling accelerates coordination of maritime harassment, interdiction and information operations by state and proxy actors (targeting routes, flag states or ports), directly increasing rates of seaborne transport disruption." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_political_realign" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
