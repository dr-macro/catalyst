      <edge source="russia_ukraine_war::information_security_vul" target="global_energy_volatility::energy_price_volatility" id="126">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Increased susceptibility of communications channels to jamming, spoofing or false signals produces spurious outage reports and ambiguous market intelligence, prompting abrupt trading reactions and larger short-term swings in energy prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_energy_volatility" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::information_security_vul" target="global_political_realign::investor_sentiment" id="127">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="High-profile jamming, spoofing or interception incidents raise perceived operational and geopolitical risk among investors for firms and markets exposed to the theatre, lowering aggregate risk appetite and sentiment." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_political_realign" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::information_security_vul" target="iran_regional_escalation::cross_border_strike_freq" id="128">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Exposed and exploited information-security weaknesses (spoofing, jamming, comms capture) demonstrated in the Russia–Ukraine war are adopted and adapted by Iranian forces and proxies, improving their ability to degrade adversary sensors and navigation and thereby increasing successful cross‑border strike rates." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
