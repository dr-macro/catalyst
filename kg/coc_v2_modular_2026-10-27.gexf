          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalating regulatory scrutiny of AI vendors tied to US–China rivalry generates additional formal and informal government demands on commercial communications providers (compliance checks, export-control enforcement, data-localization orders) relevant to the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
