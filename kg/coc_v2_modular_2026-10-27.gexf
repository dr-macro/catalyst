      <edge source="iran_regional_escalation::cross_border_strike_freq" target="global_energy_volatility::commodity_supply_risk" id="244">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="More frequent cross-border missile and drone strikes that target or threaten export terminals, pipelines and shipping lanes increase the assessed probability and expected magnitude of near-term physical supply interruptions for energy commodities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="global_energy_volatility" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::cross_border_strike_freq" target="global_political_realign::crossborder_signal" id="245">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.78" />
          <attvalue for="35" value="Frequent cross-border strikes force neighbouring states and international institutions to issue rapid political/security responses and warnings, accelerating the speed and reach of shock transmission across borders." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="global_political_realign" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::cross_border_strike_freq" target="russia_ukraine_war::commercial_satcom_access" id="246">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher frequency of cross-border strikes increases the probability of direct damage to or operational evacuation of satellite ground infrastructure (earth stations, uplink/downlink facilities) and forces providers to suspend beams over contested airspace, reducing commercial satellite communications availability in theatres relevant to the Russia–Ukraine war." />
