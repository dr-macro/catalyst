          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Faster and stronger cross-border transmission of political information and coordination prompts states to implement targeted technical and policy restrictions (throttling, geofencing, targeted shutdowns) to blunt spillovers into the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_political_realign" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
