          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Faster and stronger cross-border transmission of political and regulatory shocks (sanctions, export controls, border closures) causes secondary supplier interruptions and logistical cascades that raise commodity supply disruption risk." />
          <attvalue for="36" value="0-6 months" />
