          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.72" />
          <attvalue for="35" value="Sharp increases in regional fighting produce high-casualty incidents and intense media coverage that mobilize local populations and diasporas into immediate demonstrations for or against government policy and military action." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="global_political_realign" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::regional_conflict_intens" target="russia_ukraine_war::service_restriction_inte" id="215">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Escalating regional conflict raises operational, insurance and legal risk for commercial providers, causing them to proactively implement technical restrictions (geofencing, beam shutdowns, bandwidth curtailment) over broader regions, which increases the intensity and scope of service restrictions affecting users in the Russia–Ukraine war zone." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::regional_conflict_intens" target="us_china_rivalry::investor_risk_appetite" id="216">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained escalation in regional conflicts increases geopolitical tail‑risk perceptions among global asset managers and VC funds, causing a measurable pullback in willingness to accept valuation and operational risk in internationally linked AI investments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="us_china_rivalry" />
