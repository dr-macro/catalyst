          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Faster, stronger cross-border signal transmission (communications, targeting data and logistics channels) directly enables Iranian command-and-control and proxy networks to coordinate and time more frequent long‑range strikes across borders." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_political_realign" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
