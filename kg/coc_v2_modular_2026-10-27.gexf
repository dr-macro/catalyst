          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher regulatory scrutiny tied to US–China rivalry (export controls, sanctions, enforcement actions) generates immediate transnational alerts and countermeasures that propagate through diplomatic channels, supply chains and financial markets, increasing the speed and strength of cross-border shock transmission." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="global_political_realign" />
          <attvalue for="27" value="0" />
