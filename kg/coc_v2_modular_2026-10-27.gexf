          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Regulatory bans or compliance burdens on specific AI/telemetry software and foreign vendors implicated by US–China rivalry cause satellite operators or their software suppliers to disable features or withdraw services in contested regions, reducing available commercial satcom capacity." />
