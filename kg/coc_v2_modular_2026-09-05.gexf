      <edge source="energy_supply_shift::perceived_supply_risk" target="china_tech_push::ai_investment_rate" id="658">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Escalating perceptions of fuel/energy supply risk induce Chinese firms and state actors to accelerate capital allocation into AI and automation projects (including energy‑efficient AI hardware and optimisation software) aimed at reducing operational energy intensity and bolstering resilience." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="energy_supply_shift" />
          <attvalue for="38" value="china_tech_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shift::perceived_supply_risk" target="global_bond_shock::bond_fund_net_flows" id="659">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in perceived energy‑supply risk triggers risk‑off reallocations as investors seek safe, liquid assets, producing net inflows into government bond funds and broad bond ETFs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shift" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shift::perceived_supply_risk" target="russia_ukraine_war::escalation_risk_level" id="660">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sudden rise in perceived energy supply risk drives states and military commands to adopt pre‑emptive posture changes, protective interdiction operations or lower thresholds for reactive force, raising the short-term risk of miscalculation and escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shift::perceived_supply_risk" target="us_iran_hostilities::sanctions_pressure_level" id="661">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising perceived risk of supply disruption prompts US policymakers to escalate economic measures (wider or tougher sanctions) aimed at deterrence and coercion of actors deemed responsible or enabling of the disruption." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shift" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="27" value="0" />
