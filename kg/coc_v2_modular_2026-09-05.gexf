          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Increased interdictions, seizures or attacks on commercial vessels provoke direct naval/coastguard responses and retaliation by affected littoral states, producing more frequent cross-border kinetic and law-enforcement incidents." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shift::maritime_incident_rate" target="us_iran_hostilities::maritime_flow_disruption" id="641">
