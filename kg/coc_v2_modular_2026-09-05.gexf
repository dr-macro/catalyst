      <edge source="russia_ukraine_war::escalation_risk_level" target="energy_supply_shift::alt_supply_ramp_rate" id="274">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising likelihood of wider escalation incentivizes governments and producers with spare capacity to authorize and finance output increases and emergency export arrangements, directly accelerating the rate at which alternative crude supplies are ramped up." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="energy_supply_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_risk_level" target="global_bond_shock::nominal_long_yield" id="275">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A rise in perceived escalation risk directly raises sovereign risk premia and term premiums (and can lift inflation risk premia via anticipated supply disruptions), pushing up long-term yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_risk_level" target="us_iran_hostilities::oil_price_level" id="276">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A marked rise in escalation risk around the Russia–Ukraine war elevates the global energy risk premium and raises the probability of disrupted Russian exports, driving up benchmark oil prices within weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="27" value="0" />
        </attvalues>
