          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharp rise in long-term sovereign yields increases financing and hedging costs for traders, refiners and ship operators, which is often passed through into higher spot and wholesale refined-fuel prices in the short term as carrying and working-capital costs rise." />
