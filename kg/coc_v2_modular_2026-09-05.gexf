          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher frequency of interdictions and attacks raises regional counterparty and shipping risk, prompting nonresident investors and banks to pull back from financing and holdings of affected sovereign/corporate debt, reducing cross‑border capital inflows into fixed‑income markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shift" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shift::maritime_incident_rate" target="russia_ukraine_war::cross_border_incidents" id="640">
