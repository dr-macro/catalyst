      <edge source="us_iran_hostilities::sanctions_pressure_level" target="china_tech_push::chip_prod_capacity" id="42">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Escalating sanctions and threat of secondary export controls prompt Chinese authorities and firms to accelerate funding, subsidies and expedited approvals for domestic specialised chip fabs to reduce import vulnerability." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_hostilities" />
          <attvalue for="38" value="china_tech_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_hostilities::sanctions_pressure_level" target="energy_supply_shift::alt_supply_ramp_rate" id="43">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter sanctions that constrain sanctioned-origin exports create commercial openings and contractual demand which alternative producers can fill by increasing output and redirecting shipments, enabling a moderate ramp-up in alternative supply." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_hostilities" />
          <attvalue for="38" value="energy_supply_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_hostilities::sanctions_pressure_level" target="global_bond_shock::market_liquidity_bonds" id="44">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising sanctions raise counterparty, compliance and settlement risk for banks and dealers, prompting them to pull back inventories and quote wider spreads in affected sovereign and corporate bond markets, reducing observable liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_hostilities" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_hostilities::sanctions_pressure_level" target="global_bond_shock::cross_border_capflow_rat" id="45">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher sanctions increase legal and operational risk for global custodians and correspondent banks, causing curbs or delays on cross-border bond purchases and thereby lowering net inbound capital flows into impacted bond markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_hostilities" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="27" value="0" />
