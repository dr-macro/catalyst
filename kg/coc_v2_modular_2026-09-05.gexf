          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained declines in cross-border capital inflows tighten external financing for upstream operators and service contractors, slowing the pace at which alternative or marginal crude sources can be developed and exported." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_bond_shock" />
          <attvalue for="38" value="energy_supply_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_shock::cross_border_capflow_rat" target="russia_ukraine_war::alliance_cohesion_level" id="549">
