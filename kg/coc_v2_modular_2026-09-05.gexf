          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in tanker throughput increases effective crude delivery capacity to markets, easing short‑term supply tightness and exerting downward pressure on benchmark crude prices." />
