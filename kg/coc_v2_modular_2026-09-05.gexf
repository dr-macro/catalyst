      <edge source="global_bond_shock::market_liquidity_bonds" target="china_tech_push::compute_capacity" id="535">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharp deterioration in bond‑market liquidity disrupts banks' and corporate treasuries' ability to roll short‑term funding and issue debt for capex, which forces postponement or downsizing of data‑centre builds and therefore reduces near‑term additions to aggregate compute capacity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_shock" />
          <attvalue for="38" value="china_tech_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_shock::market_liquidity_bonds" target="energy_supply_shift::perceived_supply_risk" id="536">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A sudden deterioration in bond-market liquidity raises margin and collateral demands across the financial system, forcing commodity traders and refiners to cut physical positions and prompting markets to reassess and raise the perceived probability of near-term fuel supply disruptions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_shock" />
          <attvalue for="38" value="energy_supply_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_shock::market_liquidity_bonds" target="us_iran_hostilities::maritime_flow_disruption" id="537">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharp deterioration in bond-market liquidity tightens bank balance sheets and trade‑finance availability for shippers and commodity traders, causing shipment delays, cancelled sailings or payment frictions that disrupt maritime flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_shock" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="27" value="0" />
