      <edge source="global_bond_shock::cross_border_capflow_rat" target="china_tech_push::chip_prod_capacity" id="546">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A drop in cross‑border capital flows into manufacturing and FDI reduces foreign equity, loans and supplier finance available for new fabs and tooling in China, slowing chip‑production line startups and capacity expansion that depend on external financing and inputs." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_bond_shock" />
          <attvalue for="38" value="china_tech_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_shock::cross_border_capflow_rat" target="energy_supply_shift::tanker_traffic_vol" id="547">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rapid net outflows of cross-border capital reduce availability of short-term trade finance and letters-of-credit for exporters and traders, causing shipment delays, cancellations and therefore lower tanker loadings/transits through chokepoints." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_shock" />
          <attvalue for="38" value="energy_supply_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_shock::cross_border_capflow_rat" target="energy_supply_shift::alt_supply_ramp_rate" id="548">
