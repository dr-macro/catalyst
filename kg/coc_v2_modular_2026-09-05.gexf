      <edge source="russia_ukraine_war::alliance_cohesion_level" target="china_tech_push::market_concentration" id="298">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger allied coordination on tech export controls and standards forces market adaptation in China that privileges large, state‑backed firms able to secure restricted inputs and government support, increasing concentration in AI-related markets." />
