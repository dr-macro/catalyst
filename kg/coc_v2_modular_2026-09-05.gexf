          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="An increase in interdiction incidents (attacks, seizures, mines) directly forces vessel slowdowns, rerouting, transits suspension and port closures, producing immediate interruptive effects on seaborne flows through chokepoints." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shift" />
