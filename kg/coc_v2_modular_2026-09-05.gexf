          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sudden net capital outflows from allied economies tighten domestic financing conditions and raise political pressure to divert resources from external commitments, reducing willingness to coordinate financing and burden-sharing among partners." />
