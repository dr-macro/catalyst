          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher policy rates raise sovereign and private borrowing costs and debt service burdens unevenly across allies, producing divergent fiscal pressures and domestic tradeoffs that reduce willingness and ability to coordinate defence spending and burden-sharing." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_inflation_bond_st" />
          <attvalue for="39" value="transatlantic_security_s" />
