          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalating transatlantic financial sanctions divert trade and capital flows away from sanctioned currencies and toward safe‑haven currencies, causing a measurable appreciation of the major safe‑haven currency index." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="global_inflation_bond_st" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::sanction_pressure_level" target="middle_east_ir_escalatio::infra_attack_rate" id="766">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sharper transatlantic sanctions on regime-linked actors increase incentives for those actors or their proxies to conduct asymmetric reprisals targeting energy infrastructure in the region as a means of imposing costs and signalling deterrence." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::sanction_pressure_level" target="russia_ukraine_war::military_coercion_level" id="767">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Immediate escalation of broad, severe sanctions on Russia increases economic and regime pressure that can prompt retaliatory kinetic escalation or attempts to change facts on the ground to break sanctions momentum." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::sanction_pressure_level" target="russia_ukraine_war::energy_supply_disruption" id="768">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Targeted sanctions on Russian energy sectors or financial links incentivize Moscow to restrict exports or undertake countermeasures (e.g., pipeline throttling or delivery cutoffs), causing acute energy supply interruptions in the conflict theater and adjacent markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::sanction_pressure_level" target="us_china_tech_rivalry::reg_scrutiny_intensity" id="769">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An uptick in sanctions and related financial measures increases regulators' workload and incentives to open compliance audits and enforcement actions focused on AI‑chip suppliers and intermediaries to prevent sanctions evasion." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
