          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained, resource‑intensive diplomatic negotiations over the Russia–Ukraine conflict absorb political capital and diplomatic bandwidth, reducing the frequency and scale of formal and informal engagement available to manage or de‑escalate crises in the Middle East." />
          <attvalue for="37" value="0-6 months" />
