      <edge source="global_inflation_bond_st::consumer_price_inflation" target="middle_east_ir_escalatio::infra_attack_rate" id="572">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Fast-rising consumer prices (especially for food and fuel) sharply increase household hardship in import-dependent Middle Eastern populations, triggering protests and empowerment of militant groups that target energy infrastructure as a means of disruption or bargaining." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_inflation_bond_st" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_inflation_bond_st::consumer_price_inflation" target="russia_ukraine_war::alliance_cohesion" id="573">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rise in consumer price inflation increases domestic political pressure and fiscal strain in Western governments, prompting cuts or slower approval of military and economic aid packages to Ukraine and thereby reducing policy alignment and burden‑sharing among allies." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_inflation_bond_st" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_inflation_bond_st::consumer_price_inflation" target="transatlantic_security_s::domestic_polarization" id="574">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sharp increases in consumer prices quickly raise household economic pain and political salience of redistribution and blame, empowering populist and opposition actors and thereby increasing domestic political polarization." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_inflation_bond_st" />
          <attvalue for="39" value="transatlantic_security_s" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_inflation_bond_st::consumer_price_inflation" target="transatlantic_security_s::negotiation_intensity" id="575">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Persistent or sudden inflation spikes—especially in energy and food—force governments to pursue urgent diplomatic talks and supplier agreements to secure prices and supplies, increasing the frequency and resource intensity of negotiations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_inflation_bond_st" />
          <attvalue for="39" value="transatlantic_security_s" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_inflation_bond_st::consumer_price_inflation" target="us_china_tech_rivalry::export_control_restrict" id="576">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sustained consumer inflation heightens political and industrial concern about domestic supply resilience for strategic goods, prompting policymakers to tighten export restrictions on advanced semiconductors to prioritize internal allocation and blunt external price/availability shocks." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_inflation_bond_st" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
