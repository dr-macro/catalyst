      <edge source="russia_ukraine_war::military_coercion_level" target="global_inflation_bond_st::ten_year_bond_yield" id="47">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating kinetic operations raise perceived geopolitical and fiscal risks for exposed sovereigns, prompting investors to require a higher term/risk premium on 10‑year sovereign bonds and pushing yields up." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_inflation_bond_st" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_coercion_level" target="middle_east_ir_escalatio::military_tension_level" id="48">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An uptick in high-intensity Russian kinetic operations prompts external powers to reallocate forces, accelerate arms transfers, and encourage regional partners to heighten readiness, thereby increasing armed-threat interactions and perceived tensions in the Middle East." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_coercion_level" target="middle_east_ir_escalatio::infra_attack_rate" id="49">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Widespread use and combat-proven employment of drones, loitering munitions and missile tactics in the Russia–Ukraine theatre are replicated or exported to Middle Eastern actors, increasing the frequency of strikes against energy infrastructure." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_coercion_level" target="transatlantic_security_s::alliance_unity" id="50">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sustained or intensified Russian kinetic operations prompt NATO and transatlantic partners to coordinate defensive posture, joint deployments and unified political messaging, increasing visible alliance unity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="transatlantic_security_s" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_coercion_level" target="us_china_tech_rivalry::export_control_restrict" id="51">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Revelations on the battlefield about Russia's use of dual‑use electronics and advanced sensors accelerate U.S. determinations that similar semiconductor components can enable military capabilities, prompting near‑term tightening and broader scope of export controls on sophisticated chips destined for China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
