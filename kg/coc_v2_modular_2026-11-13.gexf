          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute shortages and allocation pressures for advanced chips force governments to prioritize national civilian and defense customers and restrict exports, triggering allocation disputes and unilateral industrial policy measures among allies that weaken coordinated sanctions, arms transfers and diplomatic messaging on Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
