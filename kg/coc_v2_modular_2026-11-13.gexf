          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Acute chip supply stresses push governments and firms to onshore or cluster production capacity quickly, concentrating large new electricity loads and temporary fuel/logistics demands that strain grids and increase susceptibility to outages or targeted disruption." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="transatlantic_security_s" />
