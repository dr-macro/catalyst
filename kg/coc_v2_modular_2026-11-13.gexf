          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute tightness and longer lead times for AI‑chip fabrication and packaging raise producer input costs and create shortages for downstream goods (electronics, autos), which firms pass through to consumer prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_inflation_bond_st" />
