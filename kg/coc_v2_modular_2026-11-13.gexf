      <edge source="transatlantic_security_s::domestic_polarization" target="middle_east_ir_escalatio::diplomatic_engagement" id="786">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising domestic political polarization in transatlantic capitals reduces policy continuity, constrains bipartisan backing for overseas initiatives, and narrows political bandwidth, thereby directly lowering the frequency and depth of allied diplomatic engagement in the Middle East." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::domestic_polarization" target="russia_ukraine_war::military_coercion_level" id="787">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising polarization in major transatlantic states reduces political consensus for sustained arms, funding and risk-taking, producing capability gaps that Russia can exploit by increasing coercive military actions." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::domestic_polarization" target="us_china_tech_rivalry::investigation_activity" id="788">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising partisan polarization increases incentives for legislative and oversight bodies to initiate high‑profile probes of firms with China ties, raising the rate and intensity of formal investigations into the sector." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="us_china_tech_rivalry" />
