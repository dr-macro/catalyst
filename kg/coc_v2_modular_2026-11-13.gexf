          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A sustained increase in substantive diplomatic negotiations reduces acute geopolitical risk premia and safe‑haven demand, causing the dominant safe‑haven currency's trade‑weighted index to weaken as capital reallocates to risk assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
