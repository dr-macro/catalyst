      </edge>
      <edge source="transatlantic_security_s::alliance_unity" target="global_inflation_bond_st::ten_year_bond_yield" id="753">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger allied cohesion increases coordinated military and fiscal backing (direct aid, guarantees, wartime spending), raising expected sovereign issuance and risk premia which push ten‑year yields higher." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="global_inflation_bond_st" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::alliance_unity" target="middle_east_ir_escalatio::military_tension_level" id="754">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger transatlantic alliance cohesion produces coordinated forward deployments, joint exercises and escort operations in proximate waters, which regional adversaries interpret as escalatory and respond with raised readiness and reciprocal military manoeuvres." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::alliance_unity" target="russia_ukraine_war::military_coercion_level" id="755">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A more unified transatlantic alliance enables faster, larger and more predictable military assistance and coordinated deterrent postures that raise Moscow's expected costs of offensive operations, leading it to scale back kinetic coercion." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="transatlantic_security_s::alliance_unity" target="us_china_tech_rivalry::export_control_restrict" id="756">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Tighter policy coordination among transatlantic allies permits synchronized legal design and simultaneous implementation of broader, more restrictive semiconductor export controls targeting Chinese access to advanced nodes and equipment." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="transatlantic_security_s" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
