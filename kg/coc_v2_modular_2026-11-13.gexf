      <edge source="us_china_tech_rivalry::export_control_restrict" target="global_inflation_bond_st::broad_currency_index" id="449">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stricter export controls on advanced semiconductors reduce trade and investment flows to targeted foreign markets and trigger capital reallocation and safe‑haven demand into the issuer currency, mechanically appreciating the broad currency index." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_inflation_bond_st" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::export_control_restrict" target="middle_east_ir_escalatio::military_tension_level" id="450">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Tighter export controls on advanced semiconductors push China to accelerate military-technical cooperation and transfers with regional partners (notably Iran) and to increase force posture in response to perceived containment, provoking higher US/regional readiness and confrontational deployments in the Middle East." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::export_control_restrict" target="middle_east_ir_escalatio::oil_price_level" id="451">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Newly restrictive export controls raise market uncertainty and a geopolitical risk premium—including expectations of retaliatory measures against shipping and trade—producing short-term upward pressure on oil prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::export_control_restrict" target="russia_ukraine_war::alliance_cohesion" id="452">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Broad, extra‑territorial US export controls force allied governments and firms to adopt divergent implementation and waiver policies (e.g., differing rules for chip exports and investment screening), producing disputes over trade and defense coordination that reduce policy alignment among states supporting Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::export_control_restrict" target="transatlantic_security_s::negotiation_intensity" id="453">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="New or tightened U.S. export controls on advanced semiconductors force allied capitals and exporters to seek rapid policy alignment, waivers and supply‑management agreements, driving an immediate increase in formal and ad hoc diplomatic negotiations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="transatlantic_security_s" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::export_control_restrict" target="transatlantic_security_s::alliance_unity" id="454">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Broad U.S. export restrictions create asymmetric economic costs for European and other partners (differing exposure of national industries), producing disagreements over implementation and carve‑outs that weaken coordinated coalition policy." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="transatlantic_security_s" />
          <attvalue for="28" value="0" />
        </attvalues>
