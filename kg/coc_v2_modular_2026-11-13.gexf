      <edge source="us_china_tech_rivalry::supply_chain_pressure" target="middle_east_ir_escalatio::military_tension_level" id="472">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Severe chip supply‑chain stress prompts states and companies to push for protected sea lines and on‑the‑ground security for key shipments, leading to more naval escorts, interdiction operations and forward deployments in chokepoints (e.g., Strait of Hormuz), increasing the likelihood of tense military encounters." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::supply_chain_pressure" target="russia_ukraine_war::alliance_cohesion" id="473">
