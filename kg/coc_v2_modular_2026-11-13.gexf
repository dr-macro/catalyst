      <edge source="russia_ukraine_war::energy_supply_disruption" target="global_inflation_bond_st::consumer_price_inflation" id="86">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.95" />
          <attvalue for="36" value="Interruptions to Russian energy exports and pipeline flows raise wholesale oil and natural gas prices, which pass through quickly into transport, heating and production costs and thereby lift headline consumer price indices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_inflation_bond_st" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="global_inflation_bond_st::broad_currency_index" id="87">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp energy supply shocks increase demand for a dominant settlement/safe‑haven currency and prompt cross‑border commodity and precautionary capital flows, mechanically appreciating that currency's trade‑weighted index." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_inflation_bond_st" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="middle_east_ir_escalatio::oil_price_level" id="88">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Significant interruptions to Russian oil and gas exports tighten global crude and refined-product balances, driving up world prices that directly raise regional oil-price benchmarks and market expectations in the Middle East." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_ir_escalatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="transatlantic_security_s::energy_vuln" id="89">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Interruptions to Russian energy exports or infrastructure reduce supply redundancy and strain alternative logistics, directly increasing the susceptibility of transatlantic energy systems to shortages and price shocks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="transatlantic_security_s" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="transatlantic_security_s::domestic_polarization" id="90">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute energy shortages and price spikes raise contentious domestic debates over rationing, subsidies and supplier choices, amplifying political division and volatility in transatlantic countries." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="transatlantic_security_s" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="us_china_tech_rivalry::supply_chain_pressure" id="91">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Large or recurring energy interruptions in Europe force regional fabs and packaging facilities to cut output or prioritize local customers, driving reallocation of limited wafer capacity and increasing lead times and allocation disputes in the global AI‑chip supply chain." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
