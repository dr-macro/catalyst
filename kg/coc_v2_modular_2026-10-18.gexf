      <edge source="us_china_tech_trade_riva::regulatory_scrutiny_ai" target="global_energy_supply_sho::diesel_price_level" id="494">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Stronger regulatory scrutiny raises compliance costs and restricts some AI-driven route-optimization and fuel-efficiency tools used by trucking and shipping operators, increasing logistics costs and transport premia that are passed into diesel prices." />
