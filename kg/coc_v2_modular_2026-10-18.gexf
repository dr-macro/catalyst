      <edge source="russia_ukraine_war::us_executive_policy_towa" target="global_energy_supply_sho::crude_price_level" id="188">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A more restrictive U.S. executive stance (tighter sanctions, export controls or embargo-related measures) reduces accessible Russian crude to world markets and/or increases risk premia, lifting benchmark crude prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::us_executive_policy_towa" target="gulf_maritime_escalation::materiel_intel_flow" id="189">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A U.S. executive decision to prioritize resources for the Ukraine campaign (more restrictive orientation toward reallocating support) results in reduced weapons, munitions and intelligence transfers or slower replenishment to Gulf partners and proxies." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="gulf_maritime_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::us_executive_policy_towa" target="us_china_tech_trade_riva::regulatory_scrutiny_ai" id="190">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A more restrictive executive foreign‑policy orientation in response to the war drives agencies and the administration to propose stricter AI oversight, tighter vendor vetting and expanded enforcement priorities, increasing regulatory scrutiny of AI activities and partners." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::us_executive_policy_towa" target="western_alliance_fragili::donor_ad_spend_flow" id="191">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A shift in the US executive toward greater permissiveness with the adversary triggers immediate mobilization by major donors (especially hawkish or industry-aligned donors) to fund targeted ad campaigns for or against incumbents to alter policy, raising ad spend flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="western_alliance_fragili" />
          <attvalue for="28" value="0" />
        </attvalues>
