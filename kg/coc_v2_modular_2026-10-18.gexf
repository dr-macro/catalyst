      <edge source="us_china_tech_trade_riva::export_control_tightness" target="global_energy_supply_sho::maritime_security_risk" id="501">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tightening export controls on advanced AI chips and perception systems reduces foreign purchasers' access to high-end maritime surveillance, UAV and sensor upgrades, degrading situational awareness in contested sea lanes and increasing the probability/severity of disruptions to seaborne oil movements." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade_riva::export_control_tightness" target="gulf_maritime_escalation::materiel_intel_flow" id="502">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter export controls on AI/chips incentivize states and firms in affected supply chains to reroute dual‑use components and enablement services through third‑party vendors and defense partners, increasing covert transfers of hardware, software and targeting/intelligence support into Gulf proxies." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="gulf_maritime_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade_riva::export_control_tightness" target="russia_ukraine_war::satellite_comms_avail" id="503">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter export controls on AI-relevant chips and comms components restrict supply and licensing for commercial satellite manufacturers and ground-station vendors servicing the theatre, degrading availability or forcing temporary service restrictions for Ukrainian users." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
