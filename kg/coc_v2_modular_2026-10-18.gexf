        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher cohesion among U.S. and partner states produces coordinated naval patrols, joint deterrent postures and unified sanctions/diplomatic pressure that reduce the likelihood of maritime provocations crossing escalation triggers in the Gulf." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="gulf_maritime_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
