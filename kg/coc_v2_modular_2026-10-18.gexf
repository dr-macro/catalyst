      <edge source="russia_ukraine_war::allied_cohesion_level" target="us_china_tech_trade_riva::capital_flow_ai" id="204">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger allied coordination produces joint public investment vehicles, coordinated subsidy and procurement strategies and investor guidance that channel public and private capital toward allied AI firms and infrastructure, raising net capital flows into those AI assets." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_cohesion_level" target="western_alliance_fragili::messaging_coherence" id="205">
        <attvalues>
