          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Clear, consistent deterrent messaging from Western governments lowers adversary miscalculation and reduces incentives for state or proxy attacks on energy shipping, decreasing maritime security risk." />
