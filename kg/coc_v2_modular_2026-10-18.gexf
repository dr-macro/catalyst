      <edge source="global_energy_supply_sho::maritime_security_risk" target="gulf_maritime_escalation::transport_disruption" id="329">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="An increase in maritime security risk (attacks, mines, harassment) directly forces ships to slow, reroute, enter convoys or avoid ports, triggering immediate and measurable interruptions to shipping schedules, port operations and aviation-linked logistics." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="gulf_maritime_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::maritime_security_risk" target="gulf_maritime_escalation::materiel_intel_flow" id="330">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising maritime security risk prompts intensified naval patrols, inspections and insurance-driven route changes that directly reduce the volume and tempo of sea-borne transfers of fuel, weapons and intelligence between actors and proxies." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="gulf_maritime_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::maritime_security_risk" target="russia_ukraine_war::energy_attack_rate" id="331">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rise in seaborne security incidents (mines, strikes, tanker attacks) both reflects and triggers escalatory naval operations and reprisals that directly increase hostile strikes on energy shipping and onshore fuel terminals." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::maritime_security_risk" target="us_china_tech_trade_riva::export_control_tightness" id="332">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating attacks or interdictions on commercial shipping linked to rival states raises perceived strategic escalation risk, prompting policymakers to tighten and more strictly enforce export controls on AI‑relevant hardware and software to prevent transfer during contested supply‑chain disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::maritime_security_risk" target="western_alliance_fragili::exec_lead_stability" id="333">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="High-profile maritime attacks or interdictions that interrupt seaborne oil flows produce immediate political crises, visible evidence of government incapacity, and intensified opposition and coalition pressure that increase turnover or weaken executive cohesion." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="western_alliance_fragili" />
