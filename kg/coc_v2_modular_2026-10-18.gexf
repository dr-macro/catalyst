          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher availability of commercial satellite communications and data links improves vessel tracking, command-and-control and deconfliction for navies and merchant fleets, lowering the probability of incidents and route disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
