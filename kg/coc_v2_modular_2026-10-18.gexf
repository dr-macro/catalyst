      <edge source="western_alliance_fragili::exec_lead_stability" target="global_energy_supply_sho::maritime_security_risk" id="579">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Worsening executive leadership stability in key Western states causes pauses or reductions in coordinated naval patrols, intelligence-sharing and convoy-escort decisions, lowering deterrence and raising the probability/severity of attacks on seaborne oil movements." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_fragili" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_fragili::exec_lead_stability" target="gulf_maritime_escalation::materiel_intel_flow" id="580">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rapid turnover or factional splits within Western executive leadership disrupt clearance chains, export license approvals and interagency coordination, causing immediate slowdowns or pauses in arms, fuel and intelligence transfers to Gulf partners." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_fragili" />
          <attvalue for="39" value="gulf_maritime_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_fragili::exec_lead_stability" target="russia_ukraine_war::satellite_comms_avail" id="581">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater executive leadership stability preserves procurement decisions, cross-agency coordination and crisis management that secure commercial satellite capacity and rapid redundancy measures, increasing available satellite communications for operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="western_alliance_fragili" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_fragili::exec_lead_stability" target="us_china_tech_trade_riva::export_control_tightness" id="582">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="More stable executive leadership in Western governments sustains diplomatic coordination, bureaucratic follow-through and consistent enforcement capacity needed to design, approve and implement tighter export controls on AI-relevant technologies." />
