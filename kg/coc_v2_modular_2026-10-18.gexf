          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade_riva::regulatory_scrutiny_ai" target="western_alliance_fragili::messaging_coherence" id="495">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rapid increases in AI regulatory inspections, patchwork compliance rules and enforcement actions force campaign teams to alter or withdraw AI‑generated content at different times and under different interpretations, producing inconsistent public messaging across offices." />
