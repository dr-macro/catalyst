          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher allied cohesion produces coordinated talking points, shared information releases and synchronized policy signals that campaign actors and government spokespeople echo, increasing public messaging alignment; the reverse (allied splits) produces divergent narratives and incoherent messages." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="western_alliance_fragili" />
          <attvalue for="28" value="0" />
        </attvalues>
