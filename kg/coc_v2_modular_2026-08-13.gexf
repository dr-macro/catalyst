      <edge source="china_maritime_pressure::supply_concentration" target="us_china_tech_rivalry::financial_integration" id="459">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater geographic concentration of critical hardware and component supply chains raises operational and geopolitical risk on AI revenue streams, making banks and capital markets less willing to securitize or embed those assets into integrated financial instruments." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_maritime_pressure" />
