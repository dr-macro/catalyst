          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating geopolitical tension around Hormuz leads China to accelerate naval deployments, exercises, and escort missions to protect sea lines and signal deterrence, increasing regional maritime militarization." />
