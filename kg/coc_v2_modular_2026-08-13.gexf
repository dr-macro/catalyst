        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A marked rise in geopolitical tension around Hormuz raises global risk signalling and diplomatic alarm, which directly increases policymakers' and markets' subjective expectations that the Russia–Ukraine conflict could broaden or intensify." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="hormuz_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
