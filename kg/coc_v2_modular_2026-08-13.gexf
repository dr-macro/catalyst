          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Intensified regulatory actions (export controls, licensing blocks, sanctions) create abrupt market and payment frictions for targeted sectors/countries, provoking more frequent and larger public-sector FX and liquidity interventions to stabilize markets." />
