          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Large, persistent public FX interventions (e.g., by the Russian central bank defending the ruble) rapidly draw down FX reserves and hard‑currency liquidity, constraining imports of precision components and fuel logistics that sustain high-frequency drone strike operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_monetary_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
