          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharper geographic concentration of critical supply chains increases the probability and magnitude of supply disruptions that translate quickly into upward consumer and producer price pressures, compelling central banks to tighten policy to contain inflation." />
