          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Expanded compute enables more effective AI-enabled cyber and autonomy tools (AIS spoofing, automated targeting, swarming drones) that increase the frequency of navigation disruptions, interdictions and kinetic skirmishes in the Strait." />
