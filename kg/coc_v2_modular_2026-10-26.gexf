          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A major cyberexploit that disrupts French payment, clearing, or central banking IT systems would sharply raise perceived default and political risk for France by interrupting market functioning and forcing emergency policy responses, so investors demand a higher sovereign risk premium." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_market_cyber_instabil" />
          <attvalue for="38" value="france_euro_bond_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_market_cyber_instabil::cyber_exploit_rate" target="iran_gulf_standoff::maritime_attack_rate" id="561">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rise in cyber exploits against shipping systems (AIS, ECDIS, satellite comms or port OT) enables state/proxy actors or criminals to blind, redirect or disable vessels and port defenses, lowering the cost and success rate of hostile actions and thus increasing the frequency/severity of maritime attacks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_market_cyber_instabil" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
