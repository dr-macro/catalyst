          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Spikes in cyber exploits against commercial networks prompt providers to implement emergency access restrictions, filtering, and geo-blocking to contain attacks, thereby increasing private operators' effective control of who can connect and under what terms." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_market_cyber_instabil" />
          <attvalue for="38" value="russia_ukraine_war" />
