      <edge source="russia_ukraine_war::escalation_risk" target="ai_market_cyber_instabil::cyber_exploit_rate" id="134">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Rising propensity for tactical or strategic escalation motivates states and proxies to launch offensive cyber campaigns (including ransomware, intrusions, and supply‑chain attacks) that target adversary cloud and AI infrastructure, raising exploit frequency." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_market_cyber_instabil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_risk" target="france_euro_bond_crisis::contagion_transmission" id="135">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A higher risk of tactical or strategic escalation in the Russia–Ukraine war increases investors' tendency to reassess cross-border exposures, accelerating the speed and intensity with which financial stress or risk perceptions propagate between sovereign bond markets including France." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="france_euro_bond_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_risk" target="iran_gulf_standoff::insurance_premium" id="136">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A spike in escalation risk tied to the Russia–Ukraine war prompts global underwriters to reprice war/political-risk exposure and widen exclusions, causing insurers to raise premiums for coverage on maritime and energy shipments transiting the Gulf region." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_risk" target="us_china_tech_rivalry::chain_diversification" id="137">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rising systemic risk of conflict escalation that could disrupt trade routes, component supplies, or trigger sanctions drives firms and policymakers to accelerate re‑routing of suppliers and sourcing away from concentrated producers tied into the conflict arena — including China‑centric nodes." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
