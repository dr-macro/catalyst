          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An uptick in external diplomatic initiatives that de-escalate communications- and access-related disputes reduces the perceived likelihood of broader geopolitical spillovers to the EU, which lowers the additional premium investors charge for holding French sovereign debt." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
