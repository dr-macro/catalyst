          <attvalue for="35" value="Successful cyber exploits against commercial communications or AI systems that cause outages, misrouting, or corrupted targeting data create operational failures and ambiguous attribution, increasing the likelihood of rapid retaliatory strikes and wider escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_market_cyber_instabil" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
