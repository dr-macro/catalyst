      <edge source="us_canada_trade_spat::supply_chain_disruption" target="russia_ukraine_war::logistics_ammo_stocks" id="215">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Cross‑border delays, customs slowdowns and rerouting caused by the US–Canada trade spat interrupt just‑in‑time shipments of ammunition components and propellants that feed North American production lines, directly lowering on‑hand munitions and spare‑parts stocks available for Ukraine support." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_canada_trade_spat" />
          <attvalue for="38" value="russia_ukraine_war" />
