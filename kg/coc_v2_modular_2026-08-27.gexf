      </edge>
      <edge source="iran_economic_and_hormuz::affected_export_volume" target="russia_ukraine_war::kinetic_strike_rate" id="81">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A decline in Iranian export volumes (notably crude) tightens global oil supply and pushes prices up, increasing Russian energy revenue and fiscal room to procure/produce munitions and sustain higher tempo of offensive strikes in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::affected_export_volume" target="treasury_bond_market_tug::long_term_bond_yield" id="82">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher export volumes from affected suppliers relieve global energy/supply constraints, lowering inflation expectations and the inflation risk premium embedded in long-term Treasury yields, so an increase in exports pushes yields down." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="treasury_bond_market_tug" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::affected_export_volume" target="us_canada_trade_spat::bilateral_trade_volume" id="83">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An increase in export volumes from affected suppliers (e.g., restored seaborne crude from sanctioned producers) substitutes for North American sourcing, causing US buyers to import less from Canada and reducing aggregate US‑Canada goods flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="us_canada_trade_spat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
