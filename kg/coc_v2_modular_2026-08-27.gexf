      <edge source="iran_economic_and_hormuz::shipping_disrupt_rate" target="russia_ukraine_war::allied_military_flow" id="67">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A rise in attacks and seizures in the Strait of Hormuz raises insurance premiums and forces merchant shippers and private contractors to reroute or suspend voyages and compels allied navies to reassign escort assets, producing measurable delays and reduced volumes of Western arms and munitions shipments into the Ukraine theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::shipping_disrupt_rate" target="russia_ukraine_war::escalation_perception" id="68">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Visible and sustained disruptions to commercial shipping in the Gulf raise policymakers' and markets' perception that regional conflict dynamics are widening and that third‑party kinetic involvement or naval confrontations are more likely, increasing the perceived risk of escalation around the Russia–Ukraine war." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::shipping_disrupt_rate" target="treasury_bond_market_tug::bond_market_liquidity" id="69">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A rise in Strait of Hormuz shipping disruptions spikes geopolitical risk and intraday volatility, causing dealers to pull back market‑making and hoard balance‑sheet capacity, which reduces the depth and ease of executing large Treasury transactions." />
          <attvalue for="36" value="0-3 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="treasury_bond_market_tug" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::shipping_disrupt_rate" target="us_canada_trade_spat::supply_chain_disruption" id="70">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A rise in attacks/seizures/mining in the Strait of Hormuz forces tankers and bulk carriers to divert, increases voyage times and war‑risk insurance/premiums, and therefore produces measurable delays, rerouting and higher freight/transaction costs for supply chains that move seaborne inputs between the US and Canada." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="us_canada_trade_spat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::shipping_disrupt_rate" target="us_canada_trade_spat::political_escalation" id="71">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="High‑visibility maritime incidents raise domestic political pressure in both countries to demonstrate security/alignment, fueling calls for tougher economic measures or trade postures between US and Canada when one side is perceived as insufficiently responsive." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="us_canada_trade_spat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::shipping_disrupt_rate" target="us_china_tech_competitio::capital_investment_flow" id="72">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating maritime disruptions through the Strait of Hormuz raise logistics risk and insurance premiums, prompting cloud providers, hyperscalers and chip buyers to accelerate and reallocate CAPEX into redundant regional data centers, inventory stockpiles and alternative supply routes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="us_china_tech_competitio" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::shipping_disrupt_rate" target="us_china_tech_competitio::market_concentration" id="73">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Frequent shipping incidents disproportionately increase operating costs for smaller, geographically dispersed suppliers, favoring large vertically integrated manufacturers and distributors that can absorb logistics risk and thereby concentrating supply in fewer firms." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="us_china_tech_competitio" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
