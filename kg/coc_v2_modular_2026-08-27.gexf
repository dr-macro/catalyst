      <edge source="iran_economic_and_hormuz::sanctions_strength" target="treasury_bond_market_tug::bond_market_liquidity" id="40">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger sanctions increase compliance risk for banks and trading counterparties (fear of secondary sanctions), inducing deleveraging and reduced willingness to provide repo or dealer intermediation and thereby narrowing market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="treasury_bond_market_tug" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::sanctions_strength" target="us_canada_trade_spat::corporate_investment" id="41">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Tighter, broader sanctions raise compliance costs and banking/payment frictions for firms operating across the US‑Canada corridor, increasing legal/regulatory uncertainty that leads companies to delay or reduce cross‑border investment commitments." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="us_canada_trade_spat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::sanctions_strength" target="us_china_tech_competitio::regulatory_enforcement" id="42">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An intensification of sanctions expands legal authorities and political will to close loopholes and to target dual‑use channels, triggering more frequent and stricter export controls, investigations and interdiction actions against AI‑relevant goods and services." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="us_china_tech_competitio" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
