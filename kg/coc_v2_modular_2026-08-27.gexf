          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in long-term sovereign yields attracts capital into the currency and raises the exchange rate, making US exports to Canada more expensive and reducing cross‑border trade flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="treasury_bond_market_tug" />
          <attvalue for="38" value="us_canada_trade_spat" />
