          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Material cross‑border supply shocks amplify price volatility and hedging flows, leading dealers to reduce inventory and widen bid/ask spreads, which directly reduces Treasury market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_canada_trade_spat" />
          <attvalue for="38" value="treasury_bond_market_tug" />
          <attvalue for="27" value="0" />
