      <edge source="iran_economic_and_hormuz::third_party_compliance" target="russia_ukraine_war::logistics_ammo_stocks" id="49">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Greater third‑party compliance with sanctions and interdiction efforts directly blocks or freezes financial channels and cargo routes used for covert Iran→Russia transfers of missile components, drones and propellants, thereby reducing the rate at which Russia replenishes ammunition and critical components." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_economic_and_hormuz::third_party_compliance" target="us_china_tech_competitio::market_concentration" id="50">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="High compliance by third‑party traders and banks cuts off a subset of smaller or niche exporters from key markets, accelerating exits and consolidation so that AI hardware sourcing becomes concentrated among large suppliers operating within compliant jurisdictions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_economic_and_hormuz" />
          <attvalue for="38" value="us_china_tech_competitio" />
          <attvalue for="27" value="0" />
