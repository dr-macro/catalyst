          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher long-term yields increase firms' expected cost of long‑duration financing and hurdle rates, causing corporations to delay or cancel capital projects and cross‑border investment commitments in the bilateral market." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="treasury_bond_market_tug" />
          <attvalue for="38" value="us_canada_trade_spat" />
