      <edge source="iran_economic_and_hormuz::shipping_disrupt_rate" target="iran_economic_and_hormuz::escalation_expectations" id="66">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="2" />
