          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising perceptions of imminent escalation prompt central banks and treasuries to deploy preemptive bond purchases, liquidity facilities and swap lines to calm funding strains and tail-risk concerns." />
