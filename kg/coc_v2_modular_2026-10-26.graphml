<edge source="russia_ukraine_war::domestic_polit_pressure" target="ai_market_cyber_instabil::ai_capital_availability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Heightened domestic political scrutiny and mobilization against firms tied to the conflict causes investors and funds to divest or withhold financing from exposed AI projects, reducing available capital for AI buildout.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_market_cyber_instabil</data>
</edge>
<edge source="russia_ukraine_war::domestic_polit_pressure" target="france_euro_bond_crisis::sovereign_bond_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising domestic political pressure related to the Russia–Ukraine war forces the French government into higher near-term military aid, refugee support, or industrial subsidies, widening expected deficits and prompting markets to demand higher long-term yields on French sovereign debt.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">france_euro_bond_crisis</data>
</edge>
