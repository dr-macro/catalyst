</edge>
<edge source="iran_gulf_standoff::crude_price_level" target="ai_market_cyber_instabil::ai_capital_availability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained spikes in crude prices increase macroeconomic volatility and input costs for tech firms and energy‑intensive training, prompting investor risk‑off behavior and a reallocation away from high‑risk AI buildouts, reducing available capital for AI projects.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">ai_market_cyber_instabil</data>
</edge>
<edge source="iran_gulf_standoff::crude_price_level" target="france_euro_bond_crisis::sovereign_bond_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained rise in crude prices raises France's import bill and domestic inflation expectations and forces larger fiscal support for households/industries, prompting investors to demand higher long-term yields on French government debt.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">france_euro_bond_crisis</data>
</edge>
<edge source="iran_gulf_standoff::crude_price_level" target="russia_ukraine_war::escalation_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained higher crude prices materially increase Russian hydrocarbon revenues and fiscal space, enabling greater military sustainment and procurement that raises the likelihood of offensive operations or escalation in Ukraine.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_standoff::crude_price_level" target="us_china_tech_rivalry::export_control_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained rise in crude prices driven by Gulf instability increases U.S. strategic urgency around access to energy-related and dual-use capabilities and thus directly motivates expansions or tightening of export controls on technologies that could be used to exploit or mitigate energy chokepoints.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
