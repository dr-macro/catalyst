<edge source="russia_ukraine_war::military_comm_dependence" target="ai_market_cyber_instabil::compute_demand_growth" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Greater reliance on commercial telecom and satellite services drives militaries and contractors to procure and run larger AI/ML workloads for ISR, C2, targeting and autonomous systems, increasing the rate of demand growth for compute resources.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_market_cyber_instabil</data>
</edge>
<edge source="russia_ukraine_war::military_comm_dependence" target="us_china_tech_rivalry::export_control_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Visible reliance on commercial satellites and private telecoms for C2 and ISR in the Ukraine war exposes dual‑use vulnerabilities and operational flows that prompt Western governments to broaden and tighten export controls on advanced components and software that could be repurposed by adversaries including Chinese firms.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
