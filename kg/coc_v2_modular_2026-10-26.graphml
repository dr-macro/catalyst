<edge source="iran_gulf_standoff::route_accessibility" target="ai_market_cyber_instabil::compute_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Reduced accessibility at key sea lanes and chokepoints delays delivery and installation of servers, accelerators and datacenter components, directly lowering near‑term available compute capacity at affected sites.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">ai_market_cyber_instabil</data>
