<edge source="russia_ukraine_war::private_net_access_contr" target="ai_market_cyber_instabil::counterparty_concentrati" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">When non-state operators unilaterally restrict or gate commercial network access in the conflict zone, customers and states consolidate traffic and services onto a smaller set of authorized providers or national vendors, increasing concentration of critical AI counterparties.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_market_cyber_instabil</data>
</edge>
<edge source="russia_ukraine_war::private_net_access_contr" target="us_china_tech_rivalry::foreign_perceived_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">High‑profile instances of private operators unilaterally throttling or denying network/services in the conflict increase foreign stakeholders' perception that dependence on externally‑controlled commercial networks creates strategic vulnerabilities in tech and communications engagements.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
