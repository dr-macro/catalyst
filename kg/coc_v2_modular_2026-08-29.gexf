          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained drop in bilateral trade volume reduces trade-related FX receipts and settlement flows from the partner economy and weakens that partner's demand for U.S. dollar assets, resulting in reduced portfolio purchases of U.S. bonds (net outflows or smaller inflows)." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="us_bond_market_tension" />
