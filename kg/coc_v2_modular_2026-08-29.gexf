          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An uptick in government energy interventions (price caps, subsidies, emergency purchases) frees fiscal space or political capital that governments can reallocate to procurement and transfers of weapons and enabling systems into the theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_energy_reorder" />
          <attvalue for="38" value="russia_ukraine_war" />
