      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="us_bond_market_tension::nominal_treasury_yields" id="179">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sudden rise in kinetic strikes increases near-term geopolitical risk and safe‑haven demand for U.S. Treasuries, pushing nominal yields down across maturities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_bond_market_tension" />
          <attvalue for="27" value="0" />
        </attvalues>
