      <edge source="us_iran_conflict::strait_interference_risk" target="global_energy_reorder::oil_price_level" id="31">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An increase in the risk of interference raises market risk premia and prompts traders and buyers to hedge or stockpile crude, driving spot and near-term futures prices higher even before physical flows are curtailed." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="global_energy_reorder" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_conflict::strait_interference_risk" target="russia_ukraine_war::weapon_transfer_rate" id="32">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in attacks or harassment in the strait forces the US and European militaries to reallocate strategic lift, escorts and air assets to secure Middle East sea/air corridors, reducing available logistics capacity and political bandwidth for high-volume or heavy weapons shipments to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_conflict::strait_interference_risk" target="russia_ukraine_war::allied_alignment_level" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Direct attacks on commercial shipping typically provoke coordinated allied responses (naval escorts, joint sanctions/diplomacy), which strengthen short-term policy and military coordination among US and European partners that spills over into unified posture on other crises including Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_conflict::strait_interference_risk" target="us_bond_market_tension::nominal_treasury_yields" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in physical/operational interference elevates the oil-supply risk premium and spot energy prices, which lifts near-term inflation expectations and the Treasury term premium and thereby pushes nominal Treasury yields higher." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="us_bond_market_tension" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_conflict::strait_interference_risk" target="us_bond_market_tension::policy_rate_path" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increased interference-driven oil-supply risk and higher commodity prices lead markets to price earlier or larger central-bank tightening to combat inflation, raising expected policy-rate trajectories." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="us_bond_market_tension" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_conflict::strait_interference_risk" target="us_trade_unilateralism::dispute_intensity_index" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising incidents of harassment, interdiction or attacks in the strait prompt the US to escalate sanctions, tariffs and other punitive trade measures against actors associated with the interference, increasing bilateral trade dispute intensity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="us_trade_unilateralism" />
          <attvalue for="27" value="0" />
        </attvalues>
