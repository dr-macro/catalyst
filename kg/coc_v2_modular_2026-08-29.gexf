          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Increased kinetic strikes on ports, pipelines, refineries and tankers causes direct physical damage and port closures, interrupting transport and processing nodes and raising measured supply-chain disruption." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
