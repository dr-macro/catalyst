          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter, more comprehensive sanctions on Russian oil/energy exports reduce available Russian supply on global markets, driving buyers to increase imports from Persian Gulf producers and thereby raising oil volumes passing through the strait." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
