          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained increase in government energy subsidies and state market interventions financed by higher issuance raises expected sovereign supply and term premia, lifting real yields." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_energy_reorder" />
          <attvalue for="38" value="us_bond_market_tension" />
          <attvalue for="27" value="0" />
