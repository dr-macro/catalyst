          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An uptick in policy measures targeting Iranian energy (sanctions, interdiction authorizations, or forced inspections) creates incentives for retaliatory harassment or escalation by Iran or aligned groups, increasing the risk of interference with transits." />
