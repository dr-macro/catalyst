      <edge source="us_iran_conflict::vessel_transit_rate" target="global_energy_reorder::supply_disruption_level" id="51">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A fall in the rate of commercial transits through the strait interrupts scheduled deliveries and logistics chains for fuel and other goods, directly increasing measured supply-chain disruption across affected routes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="global_energy_reorder" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_conflict::vessel_transit_rate" target="us_bond_market_tension::policy_rate_path" id="52">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sudden drop in commercial vessel transits reduces traded goods throughput and near-term growth outlooks, causing market participants to lower expected policy rates as central banks are seen likely to delay or soften tightening." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="us_bond_market_tension" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_conflict::vessel_transit_rate" target="us_trade_unilateralism::bilateral_trade_volume" id="53">
