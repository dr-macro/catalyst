          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rapid increases in war-risk and route-specific insurance premiums raise energy and trade costs for European states, increasing domestic political pressure to avoid further economically painful sanctions, thereby constraining the scope and severity of new measures against Russia." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
