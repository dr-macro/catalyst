      <edge source="us_bond_market_tension::nominal_treasury_yields" target="global_energy_reorder::lng_gas_flow_volume" id="335">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher nominal Treasury yields tend to strengthen the dollar and raise local‑currency import bills and short‑term financing costs for LNG buyers, leading some buyers to reduce cargo nominations and lower cross‑border LNG flow volumes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_bond_market_tension" />
          <attvalue for="38" value="global_energy_reorder" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_bond_market_tension::nominal_treasury_yields" target="russia_ukraine_war::weapon_transfer_rate" id="336">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in US nominal Treasury yields increases borrowing and working-capital/hedging costs for European purchasers and defense contractors (and raises supplier financing costs), which delays procurement payments and deliveries, slowing the pace of weapons transfers into the theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_bond_market_tension" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_bond_market_tension::nominal_treasury_yields" target="russia_ukraine_war::allied_alignment_level" id="337">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Sustained increases in US nominal yields push up global borrowing costs and often strengthen the dollar, raising defense procurement and debt-service costs for non‑US allies and thereby generating domestic pressures that reduce the coherence and speed of allied coordination." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_bond_market_tension" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_bond_market_tension::nominal_treasury_yields" target="us_iran_conflict::strait_interference_risk" id="338">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in nominal Treasury yields raises US interest expenses and near-term fiscal pressure, prompting reallocation or temporary reductions in forward-deployed naval and air patrols in the Persian Gulf and thereby increasing the probability of Iranian harassment, interdictions, or other interference incidents." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_bond_market_tension" />
          <attvalue for="38" value="us_iran_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
