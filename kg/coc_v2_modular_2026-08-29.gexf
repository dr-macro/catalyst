      <edge source="us_trade_unilateralism::dispute_intensity_index" target="global_energy_reorder::policy_intervention_rate" id="604">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalating unilateral trade disputes prompt affected governments and trading partners to respond with more frequent and larger energy-sector interventions (subsidies, export controls, state procurement deals) to protect supply chains and strategic industries." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="global_energy_reorder" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_unilateralism::dispute_intensity_index" target="russia_ukraine_war::allied_alignment_level" id="605">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating unilateral US trade disputes with allied economies (tariffs, threats, retaliatory steps and high-profile rhetoric) erode trust and reciprocity, reducing partners' willingness to coordinate policy and military support for Ukraine." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_unilateralism::dispute_intensity_index" target="russia_ukraine_war::escalation_feedback" id="606">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="More intense unilateral US trade disputes generate reciprocal economic and rhetorical responses from Russia and its partners, strengthening feedback loops that convert each punitive action into amplified reciprocal measures within the conflict system." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_unilateralism::dispute_intensity_index" target="us_bond_market_tension::portfolio_flows" id="607">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened bilateral trade dispute intensity raises global risk and policy uncertainty, prompting a near-term flight-to-safety that reallocates cross-asset portfolios into U.S. Treasuries and other safe assets, increasing net portfolio inflows into bonds." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="us_bond_market_tension" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_unilateralism::dispute_intensity_index" target="us_iran_conflict::strait_interference_risk" id="608">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Marked escalation in US trade-dispute measures and adversarial rhetoric raises bilateral political tensions and motivates Iranian state or proxy forces to harass or interdict commercial traffic in the strait as a retaliatory or leverage tactic." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="us_iran_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_unilateralism::dispute_intensity_index" target="us_iran_conflict::insurance_premium_level" id="609">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A spike in trade-dispute intensity increases the perceived likelihood of retaliatory maritime incidents near Iran, leading insurers to raise route- and war-risk premiums for voyages through or near the strait." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="us_iran_conflict" />
