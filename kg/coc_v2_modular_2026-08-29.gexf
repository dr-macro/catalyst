          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained increase in commercial vessel transits through the strait lowers delivery times and route costs for goods, directly raising the volume of trade exchanged between the US and counterparties that rely on that corridor." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_conflict" />
          <attvalue for="38" value="us_trade_unilateralism" />
          <attvalue for="27" value="0" />
