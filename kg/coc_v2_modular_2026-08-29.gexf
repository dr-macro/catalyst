      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="global_energy_reorder::oil_price_level" id="178">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating physical attacks on production, export infrastructure and shipping lanes reduce available crude flows and raise a market risk premium, driving up oil prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_energy_reorder" />
