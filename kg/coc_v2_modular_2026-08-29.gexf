      <edge source="us_trade_unilateralism::bilateral_trade_volume" target="global_energy_reorder::lng_gas_flow_volume" id="523">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in bilateral trade volume with major LNG importers raises contracted and spot demand for US cargoes and associated logistics, increasing actual LNG flow volumes to those partners." />
