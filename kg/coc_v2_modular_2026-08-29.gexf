          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalation in sanctions on Russia prompts the US (and aligned partners) to add tariff-based trade restrictions and broaden tariff lines as enforcement and secondary-targeting tools, raising average applied tariff rates on affected imports." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_trade_unilateralism" />
          <attvalue for="27" value="0" />
