      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="us_iran_conflict::vessel_transit_rate" id="180">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A sudden spike in kinetic attacks that demonstrates expanded targeting or incidental risk to commercial shipping elevates operators' perceived transit risk and prompts some carriers to delay, divert or cancel voyages through the strait, reducing transit counts." />
