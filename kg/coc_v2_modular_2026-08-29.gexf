      <edge source="us_trade_unilateralism::applied_tariff_level" target="global_energy_reorder::lng_gas_flow_volume" id="502">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher US applied tariffs on energy-related equipment and imported gas/processed fuels raises project and trade costs, delays commissioning and reduces competitiveness of some cargoes, thereby lowering cross-border LNG and gas flows." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="global_energy_reorder" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_unilateralism::applied_tariff_level" target="russia_ukraine_war::sanctions_severity" id="503">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="When the US raises applied tariffs on goods from the target economy or key trading partners, those measures function as additional economic restrictions and lower political barriers to imposing broader punitive measures, increasing the overall severity of sanctions applied to actors linked to the conflict." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_unilateralism::applied_tariff_level" target="us_bond_market_tension::nominal_treasury_yields" id="504">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher applied U.S. tariffs raise import prices and lift short-to-medium-term inflation expectations and the inflation risk premium, which is priced into nominal Treasury yields and pushes yields higher across maturities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="us_bond_market_tension" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_unilateralism::applied_tariff_level" target="us_iran_conflict::strait_oil_export_rate" id="505">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained higher applied tariff levels depress industrial production and international trade demand over ensuing quarters, reducing seaborne oil consumption and thereby lowering volumes exported through the strait." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_trade_unilateralism" />
          <attvalue for="38" value="us_iran_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
