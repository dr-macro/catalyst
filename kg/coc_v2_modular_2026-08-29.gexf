      <edge source="russia_ukraine_war::sanctions_severity" target="us_bond_market_tension::portfolio_flows" id="210">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="More severe sanctions disrupt energy/commodity markets and raise counterparty risk, prompting investors to reallocate from equities/EM into perceived safe assets such as U.S. government bonds, increasing net flows into bond assets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_bond_market_tension" />
          <attvalue for="27" value="0" />
