<edge source="russia_ukraine_war::military_strike_intensit" target="global_financial_stress::sovereign_yield_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A sustained rise in strike intensity increases expected near-term defence and reconstruction spending and elevates sovereign risk premia for affected and proximate states, leading investors to demand higher yields on government debt.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="russia_ukraine_war::military_strike_intensit" target="middle_east_escalation::commodity_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A spike in kinetic strike intensity that damages export terminals, pipelines or refining capacity in Russia/Ukraine directly reduces available crude and refined flows to global markets and drives up oil and gas prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">middle_east_escalation</data>
</edge>
<edge source="russia_ukraine_war::military_strike_intensit" target="security_alliance_shift::critical_materials" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Sustained kinetic strikes destroy or disable mines, processing plants and rail/port transshipment nodes in-and-around the conflict zone, directly reducing exports and immediate availability of critical inputs (metals, fertilisers, specialty gases).</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">security_alliance_shift</data>
</edge>
<edge source="russia_ukraine_war::military_strike_intensit" target="us_china_tech_rivalry::chip_supply_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Escalated kinetic strikes damage or disrupt plants and logistics that produce or transport semiconductor feedstocks (specialty gases, substrates) in affected regions and transit corridors, creating acute input shortages and reducing downstream chip production capacity available to both US and Chinese firms.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
