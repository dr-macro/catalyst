  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Large spikes in financial volatility raise risk premia and trigger margin calls and forced position adjustments in commodity futures markets, producing short-covering and liquidity-driven jumps in spot oil and gas prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">middle_east_escalation</data>
</edge>
<edge source="global_financial_stress::financial_market_volatil" target="russia_ukraine_war::trade_route_throughput" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Spikes in financial-market volatility elevate freight and war-risk insurance costs and prompt charterers to delay or reroute voyages away from contested Black Sea and adjacent corridors, reducing cargo transit volumes and regularity through those routes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_financial_stress::financial_market_volatil" target="security_alliance_shift::political_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Spikes in financial‑market volatility produce rapid wealth losses and hiring freezes that generate immediate constituent, industry and legislative demands for government relief or intervention.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">security_alliance_shift</data>
</edge>
<edge source="global_financial_stress::financial_market_volatil" target="us_china_tech_rivalry::data_center_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Spikes in financial market volatility increase corporate risk premia and cash conservation behavior, prompting firms and cloud providers to postpone or scale back data‑centre construction and capacity commitments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
