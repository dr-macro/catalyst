<edge source="russia_ukraine_war::satcom_availability" target="us_china_tech_rivalry::data_center_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Persistent degradation or outages of civilian satcom services during the conflict push cloud providers and large users to build redundant, ground‑based compute sites and edge data centres, increasing installed data‑centre capacity in terrestrial locations (so increases in satcom availability would reduce that pressure).</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
