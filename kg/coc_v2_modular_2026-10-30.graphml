<edge source="security_alliance_shift::supply_chain_dependency" target="global_financial_stress::bond_market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Heightened concentration of foreign suppliers exposed by an alliance realignment leads to sudden delivery failures and counterparty FX/settlement stress that forces dealers to hoard balance sheet capacity, widening bid-ask spreads and reducing bond market liquidity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">security_alliance_shift</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="security_alliance_shift::supply_chain_dependency" target="middle_east_escalation::maritime_transit_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Greater concentration of production and inputs forces higher volumes and predictable routings through chokepoints (Suez, Strait of Hormuz), raising the probability and expected severity of shipping disruption from interdiction or attacks.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">security_alliance_shift</data>
  <data key="d39">middle_east_escalation</data>
</edge>
<edge source="security_alliance_shift::supply_chain_dependency" target="russia_ukraine_war::military_strike_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increased concentration of supply chains for munitions and ISR components causes episodic shortages or delivery delays to Ukraine, degrading its ability to interdict or absorb attacks and thereby enabling Russia to raise the tempo and scale of kinetic strikes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">security_alliance_shift</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="security_alliance_shift::supply_chain_dependency" target="us_china_tech_rivalry::regulatory_restrictions" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Greater concentration of production or inputs in rival states raises political and national‑security concern, producing tighter export controls, investment screening and data‑localization or licensing requirements that heighten regulatory stringency.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">security_alliance_shift</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
