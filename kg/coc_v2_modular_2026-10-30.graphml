<edge source="global_financial_stress::bond_market_liquidity" target="security_alliance_shift::supply_chain_dependency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter bond‑market liquidity raises short‑term financing costs and rollover risk for exporters and tier‑1 suppliers, prompting firms to consolidate suppliers and shift to fewer, financially stable sources, increasing concentration when liquidity falls (and decreasing it when liquidity improves).</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">security_alliance_shift</data>
</edge>
<edge source="global_financial_stress::bond_market_liquidity" target="us_china_tech_rivalry::regulatory_restrictions" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Improved sovereign and corporate bond market liquidity reduces acute funding stress and political pressure, lowering the likelihood that governments enact emergency capital controls, inbound FDI screening or export restrictions that constrain tech collaboration.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
