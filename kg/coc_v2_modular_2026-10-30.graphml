<edge source="global_financial_stress::sovereign_yield_level" target="russia_ukraine_war::military_strike_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Sustained increases in sovereign yields raise borrowing costs for major donor governments, forcing near-term reallocation or delay of defense procurements and external military aid to Ukraine and thereby reducing Ukrainian strike tempo and destructive scale within campaign cycles.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_financial_stress::sovereign_yield_level" target="security_alliance_shift::industrial_subsidy_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising sovereign yields increase debt‑service burdens and fiscal pressure, leading governments to reprioritise budgets and often cut or restrain discretionary industrial subsidies to stabilize public finances.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">security_alliance_shift</data>
</edge>
<edge source="global_financial_stress::sovereign_yield_level" target="us_china_tech_rivalry::ai_capex_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Higher sovereign yields raise benchmark borrowing costs and discount rates for corporations and project financiers, reducing the net present value of long‑lived AI infrastructure projects and causing firms to cut or delay AI capex commitments.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
