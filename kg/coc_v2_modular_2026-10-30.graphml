<edge source="security_alliance_shift::industrial_subsidy_level" target="global_financial_stress::cross_border_capital_flo" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Security-driven increases in targeted subsidies make protected industries less market‑efficient and signal persistent state intervention, prompting foreign portfolio and direct investors to reallocate or withhold capital, reducing net cross-border inflows.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">security_alliance_shift</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="security_alliance_shift::industrial_subsidy_level" target="russia_ukraine_war::satcom_availability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Targeted public subsidies to satellite and terminal manufacturers accelerate procurement and deployment of redundant civilian satcom capacity and local production of spares, increasing available bandwidth and resilience for users supporting Ukrainian operations.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">security_alliance_shift</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="security_alliance_shift::industrial_subsidy_level" target="us_china_tech_rivalry::chip_supply_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Targeted public subsidies, loans and tax incentives accelerate build-out and capacity commitments at domestic and allied foundries and fabs, directly increasing available high‑performance chip production and inventory.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">security_alliance_shift</data>
  <data key="d39">us_china_tech_rivalry</data>
