<edge source="us_china_tech_rivalry::chip_supply_capacity" target="global_financial_stress::financial_market_volatil" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A sudden reduction in availability of specialized chips forces earnings revisions and supply-chain disruptions at large tech firms and suppliers, triggering sharp repricing and higher volatility across equity and credit markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="us_china_tech_rivalry::chip_supply_capacity" target="russia_ukraine_war::military_strike_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in available specialized chips (from Chinese/domestic suppliers or third‑country inventories) allows Russian arms manufacturers to produce and field more guided munitions, drones and EW components, raising the tempo and precision of kinetic strikes.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_rivalry::chip_supply_capacity" target="security_alliance_shift::industrial_subsidy_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A marked reduction in specialized chip production capacity prompts governments to increase direct financial support (grants, tax credits, concessional finance) for domestic semiconductor fabs to secure supply and reduce strategic vulnerability.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">security_alliance_shift</data>
</edge>
