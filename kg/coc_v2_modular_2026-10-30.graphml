<edge source="global_financial_stress::cross_border_capital_flo" target="middle_east_escalation::sanctions_enforcement" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute capital flight and withdrawal of correspondent banking relationships degrades counterparties' ability and willingness to perform sanctions screening and transaction monitoring, enabling greater evasion and weakening enforcement in weeks to months.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">middle_east_escalation</data>
</edge>
<edge source="global_financial_stress::cross_border_capital_flo" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sharp capital outflows toward safe assets compel affected allied governments to prioritize domestic financial stability and bank backstops, generating political pressure to curb costly overseas assistance and producing policy divergence and stress within coalitions supporting Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_financial_stress::cross_border_capital_flo" target="security_alliance_shift::critical_materials" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Sustained declines in cross‑border capital flows reduce foreign direct investment and working‑capital financing for overseas mines and processors, causing production cutbacks and shorter, less diverse supplies of critical materials.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">security_alliance_shift</data>
</edge>
<edge source="global_financial_stress::cross_border_capital_flo" target="us_china_tech_rivalry::chip_supply_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increases in cross‑border capital flows facilitate FDI, joint‑venture funding and vendor financing for fabs and tooling, enabling faster expansion of specialized chip production capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
