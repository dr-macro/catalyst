          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in conflict escalation triggers domestic political pressure and national security reviews that prompt governments to impose or accelerate stricter AI governance measures (e.g., restrictions on dual‑use capabilities, monitoring requirements, or emergency controls)." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="persian_gulf_conflict" />
          <attvalue for="39" value="ai_governance_and_race" />
