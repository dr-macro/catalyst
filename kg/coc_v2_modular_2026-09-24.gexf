          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Episodes of kinetic escalation (attacks on tankers, terminals or pipelines) produce immediate physical supply interruptions and trigger risk-driven buying and short-covering in oil products markets, lifting diesel prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="persian_gulf_conflict" />
          <attvalue for="39" value="global_energy_supply_sho" />
