      <edge source="russia_ukraine_war::drone_campaign_intensity" target="ai_governance_and_race::safety_testing_rigor" id="209">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Higher operational use of drones produces near‑term incidents and edge cases that compel developers and military buyers to introduce more thorough red‑teaming and pre‑deployment safety validation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_governance_and_race" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_campaign_intensity" target="global_energy_supply_sho::chokepoint_congestion" id="210">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An upsurge in drone strikes on ships, port infrastructure or nearby facilities increases precautionary rerouting, naval escorts and inspection stopovers, which raises delays and congestion at key maritime chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_campaign_intensity" target="us_china_strategic_rival::diplomatic_engagement" id="211">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A surge in drone strikes—especially when components traceable to third‑country suppliers are implicated—provokes rapid US diplomatic démarches and crisis‑level talks with China and other suppliers to clarify responsibilities and press for export controls, increasing high‑level engagement frequency." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
