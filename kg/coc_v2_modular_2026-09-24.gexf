      <edge source="persian_gulf_conflict::chokepoint_traffic_volum" target="russia_ukraine_war::supply_chain_strain" id="106">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Disruptions and rerouting around Persian Gulf chokepoints increase shipment times and port congestion on alternative routes, producing immediate bottlenecks and delays for defense-related components and spares bound for the Russia–Ukraine theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="persian_gulf_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
