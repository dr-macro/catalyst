      <edge source="persian_gulf_conflict::risk_premia_level" target="ai_governance_and_race::model_capability_growth" id="110">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Elevated conflict risk premia raise the cost of capital, insurance and long‑term contracting for compute‑intensive projects, causing firms to cut or delay compute purchases and R&amp;D investments and thereby slowing the growth rate of deployed model capabilities." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="persian_gulf_conflict" />
          <attvalue for="39" value="ai_governance_and_race" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="persian_gulf_conflict::risk_premia_level" target="russia_ukraine_war::defense_production_rate" id="111">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising conflict risk premia prompt Middle Eastern buyers and states to place urgent arms and munitions orders, diverting finite global production capacity and prioritized delivery slots away from suppliers supporting Ukraine, reducing the flow of materiel into the Russia–Ukraine theater." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="persian_gulf_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="persian_gulf_conflict::risk_premia_level" target="us_china_strategic_rival::tech_competition" id="112">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
