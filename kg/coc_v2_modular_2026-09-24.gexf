          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rise in US–China geopolitical tension drives US and allied procurement authorities and prime contractors to reassign production slots and prioritize Indo‑Pacific capabilities, slowing the flow of new deliveries and procurements directed at Ukraine." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="russia_ukraine_war" />
