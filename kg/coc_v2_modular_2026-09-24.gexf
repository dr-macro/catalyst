          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Spikes in global diesel prices push up freight and fuel cost forecasts and insurer loss-exposure estimates, causing insurers and financial markets to raise conflict- and transit-related risk premia for Persian Gulf operations." />
