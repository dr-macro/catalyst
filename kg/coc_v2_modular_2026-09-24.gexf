          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher kinetic and proxy escalation motivates and legitimizes increased state and non‑state cyber operations (esp. targeting adversary infrastructure and supply chains), producing a near‑term rise in hacks, intrusions and exploitative attacks on AI systems and platforms." />
          <attvalue for="37" value="0-6 months" />
