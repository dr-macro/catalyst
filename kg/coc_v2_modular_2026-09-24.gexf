        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Concentrated increases in convoying, military transits or diverted commercial tonnage through alternative narrow passages overload throughput capacity and cause delays and queuing at key maritime chokepoints." />
