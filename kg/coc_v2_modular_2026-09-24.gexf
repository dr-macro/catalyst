      <edge source="us_china_strategic_rival::geopolitical_tension" target="global_energy_supply_sho::chokepoint_congestion" id="356">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Heightened US–China geopolitical tension drives increased naval patrols, convoy escorts, inspections and avoidance routing for tankers in key straits (e.g., Malacca, Hormuz, Suez), producing slower transits and localized bottlenecks at maritime chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_strategic_rival::geopolitical_tension" target="global_energy_supply_sho::diesel_price_level" id="357">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising geopolitical tension raises shipping risk premia and marine insurance costs and prompts precautionary buying and margin calls, which increase market risk pricing and push up global diesel benchmark levels even without an immediate physical shortage." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_strategic_rival::geopolitical_tension" target="persian_gulf_conflict::escalation_intensity" id="358">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rise in great-power geopolitical tension drives increased US and Chinese naval and air deployments plus amplified proxy support to regional actors, raising the frequency of close encounters, interdictions and miscalculations that directly increase operational escalation in the Gulf." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="persian_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_strategic_rival::geopolitical_tension" target="persian_gulf_conflict::chokepoint_traffic_volum" id="359">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Intensified US–China rivalry leads to more forward naval and air transits and freedom-of-navigation operations through Gulf chokepoints, raising aggregate military transit volume even as commercial actors may begin to adjust." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="persian_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_strategic_rival::geopolitical_tension" target="russia_ukraine_war::defense_production_rate" id="360">
        <attvalues>
