          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp rises in diesel prices raise operational and transport costs for smaller cloud providers and on‑premise labs that rely on diesel for backup power and logistics, causing them to cut runtime and delay training/deployment schedules and thereby slow model release cadence." />
