          <attvalue for="36" value="Increased congestion at maritime chokepoints delays shipments of specialized accelerator hardware and completed server racks from a small set of manufacturing hubs, directly constraining available training capacity and slowing the pace at which organizations can scale up model training and thus capability growth." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="ai_governance_and_race" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::chokepoint_congestion" target="ai_governance_and_race::model_release_cadence" id="577">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Persistent delays in cross‑border delivery of compute hardware and replacement parts caused by chokepoint congestion force labs and service providers to defer or stagger planned training and deployment cycles, reducing the frequency of new model releases." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="ai_governance_and_race" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::chokepoint_congestion" target="persian_gulf_conflict::escalation_intensity" id="578">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising congestion at maritime chokepoints increases close encounters, delays and interdiction operations by naval forces and coast guards, which raises the frequency of confrontations and operational escalation in the Gulf." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="persian_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::chokepoint_congestion" target="russia_ukraine_war::drone_campaign_intensity" id="579">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Increased congestion and delays at maritime chokepoints slow or block inbound shipments of drone airframes, electronics, batteries and munitions, reducing sortie rates and the geographic tempo of UAS strike and ISR operations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::chokepoint_congestion" target="us_china_strategic_rival::geopolitical_tension" id="580">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Acute congestion at major maritime chokepoints provokes higher naval escorts, interdiction incidents, and competing security postures by the US and China to secure transit, directly raising bilateral strategic friction." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="us_china_strategic_rival" />
