      <edge source="ai_governance_and_race::model_capability_growth" target="global_energy_supply_sho::diesel_trade_flows" id="660">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Faster growth in deployed AI model capabilities drives wider adoption of real-time fleet, routing and inventory optimization tools across logistics networks, reducing diesel consumption in freight and thereby lowering cross-border diesel shipment volumes." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_governance_and_race" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_governance_and_race::model_capability_growth" target="persian_gulf_conflict::escalation_intensity" id="661">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Faster growth in deployed AI capabilities (e.g., autonomous targeting, persistent ISR, and decision‑support tools) lowers the perceived cost and increases tempo of offensive operations among state and proxy actors in the Gulf, raising the likelihood and magnitude of escalatory strikes." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_governance_and_race" />
          <attvalue for="39" value="persian_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_governance_and_race::model_capability_growth" target="russia_ukraine_war::drone_campaign_intensity" id="662">
        <attvalues>
