          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Faster growth in deployed model capabilities produces more robust onboard autonomy, perception and swarm-coordination software that militaries and proxies integrate into UASs, increasing the frequency, range and effectiveness of drone strike and recon operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_governance_and_race" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
