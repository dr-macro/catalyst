          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rapid, observable jumps in deployed AI capabilities (e.g., more capable autonomous systems, surveillance/analysis tools or offensive cyber tools) change threat assessments and military doctrine, prompting reciprocal force-posturing and public strategic warnings between the U.S. and China." />
          <attvalue for="37" value="6-18 months" />
