          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Heightened Persian Gulf hostilities accelerate Iranian and proxy transfers of UAS/loitering-munition hardware, spare parts, and operational lessons to allied actors (including channels used by Russia), enabling a near‑term rise in Russian/UAS-enabled strike and reconnaissance activity over Ukraine." />
