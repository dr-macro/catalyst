      <edge source="us_china_strategic_rival::geopolitical_tension" target="ai_governance_and_race::regulatory_stringency" id="355">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising strategic tensions lead governments to enact stricter AI export controls, security-driven licensing and emergency domestic restrictions to limit adversary access and protect critical systems." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="ai_governance_and_race" />
