      <edge source="persian_gulf_conflict::chokepoint_traffic_volum" target="us_china_strategic_rival::semiconductor_capacity" id="107">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Severe slowdowns or closures at Gulf chokepoints delay critical shipments of wafers, specialty gases and fab equipment, forcing production cuts or idling that reduce the immediate flexibility of semiconductor manufacturing capacity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="persian_gulf_conflict" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
