  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="allied_arms_reshaping::procurement_priority" target="allied_arms_reshaping::oversight_pressure_level" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="allied_arms_reshaping::procurement_priority" target="allied_arms_reshaping::contracting_consolidatio" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="allied_arms_reshaping::procurement_priority" target="russia_ukraine_blacksea::drone_strike_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A shift in procurement priority toward anti-ship missiles, loitering munitions, and maritime-capable precision munitions results in faster transfers or reallocation of stocks to Ukrainian forces, enabling a higher tempo of strikes against maritime targets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">allied_arms_reshaping</data>
  <data key="d40">russia_ukraine_blacksea</data>
</edge>
<edge source="allied_arms_reshaping::procurement_priority" target="us_china_rivalry::chip_fab_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Shifting procurement priorities toward domestically sourced advanced electronics leads governments to award subsidies, guaranteed purchase agreements and defense offset contracts that accelerate financing and construction of semiconductor fabs in allied jurisdictions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">allied_arms_reshaping</data>
  <data key="d40">us_china_rivalry</data>
</edge>
<edge source="allied_arms_reshaping::industrial_capacity_use" target="allied_arms_reshaping::operational_readiness" id="0">
