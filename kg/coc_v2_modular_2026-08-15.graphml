<edge source="us_china_rivalry::tech_investment_flow" target="allied_arms_reshaping::procurement_priority" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising flows of public and private capital into AI, semiconductors and related tech alter industrial supply and capability prospects, causing defense planners to reorient procurement priorities toward those high‑tech categories.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">allied_arms_reshaping</data>
</edge>
<edge source="us_china_rivalry::tech_investment_flow" target="iran_hormuz_standoff::oil_price_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Increased US/allied investment in regional surveillance, communications and maritime security tech reduces uncertainty and the risk premium on shipments through Hormuz, putting downward pressure on benchmark oil prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">iran_hormuz_standoff</data>
</edge>
