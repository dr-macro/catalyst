  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="allied_arms_reshaping::industrial_capacity_use" target="allied_arms_reshaping::acquisition_cost_trend" id="0">
  <data key="d28">intra_causal</data>
