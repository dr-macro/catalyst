<edge source="russia_ukraine_blacksea::maritime_throughput" target="allied_arms_reshaping::deployment_tempo" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">A drop in maritime throughput (fewer safe transits) prompts allied navies and air forces to launch more frequent escort, patrol and convoy‑protection rotations, materially increasing the rate of deployments and platform movements into the theater.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_blacksea</data>
  <data key="d40">allied_arms_reshaping</data>
