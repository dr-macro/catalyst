  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Expansion or tightening of multilateral sanctions and secondary‑sanctions risk around Russian oil exports directly removes barrels from accessible global markets and deters buyers, reducing aggregate crude availability for immediate trade.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">mid_east_energy_shock</data>
