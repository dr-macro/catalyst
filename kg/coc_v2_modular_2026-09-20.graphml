<edge source="mid_east_energy_shock::energy_market_price_vola" target="ai_safety_militarization::capital_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sharp and unpredictable swings in energy prices increase operational and financing risk for energy‑intensive AI data centers and training projects, causing investors and firms to pull or delay new capital allocations into advanced AI capacity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_energy_shock</data>
  <data key="d39">ai_safety_militarization</data>
</edge>
<edge source="mid_east_energy_shock::energy_market_price_vola" target="russia_ukraine_war::sanction_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">High and volatile energy prices raise domestic economic and political costs for energy‑importing governments, making them less willing to sustain or escalate multilateral sanctions on Russia to avoid further price shocks at home.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_energy_shock</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="mid_east_energy_shock::energy_market_price_vola" target="us_china_trade_rivalry::geopolitical_risk_perc" id="0">
