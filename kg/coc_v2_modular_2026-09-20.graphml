  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">Rapid deployment of AI-enabled autonomous surface, subsurface and aerial systems (commercial and military) increases the number and sophistication of actor-capable platforms in choke points, raising the frequency of harassment, misidentification incidents, and attacks on shipping.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_safety_militarization</data>
  <data key="d39">mid_east_energy_shock</data>
</edge>
<edge source="ai_safety_militarization::deployment_rate_of_model" target="russia_ukraine_war::coercive_escalation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Faster operational deployment of AI-enabled systems (autonomous ISR, loitering munitions, targeting aids) increases actors' ability and lowers marginal cost of conducting cross-border or hybrid kinetic actions, raising the intensity and frequency of coercive operations.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_safety_militarization</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
