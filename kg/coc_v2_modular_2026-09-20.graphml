<edge source="ai_safety_militarization::regulatory_pressure" target="mid_east_energy_shock::sanctions_enforcement_in" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Heightened AI safety and dual‑use regulation prompts governments to extend export controls and intelligence-driven compliance checks to AI-relevant transfers, increasing the operational rigor and scope of sanctions and trade enforcement targeting actors in the region.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_safety_militarization</data>
  <data key="d39">mid_east_energy_shock</data>
