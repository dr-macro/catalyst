<edge source="ai_safety_militarization::safety_incident_frequenc" target="mid_east_energy_shock::energy_market_price_vola" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A rise in AI-related safety incidents (e.g., algorithmic trading errors, false signals, data poisoning) produces sudden, large orders and misinformation cascades in commodity markets, driving short-term spikes and greater volatility in energy prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_safety_militarization</data>
  <data key="d39">mid_east_energy_shock</data>
