<edge source="us_china_trade_rivalry::export_control_level" target="ai_safety_militarization::model_dev_velocity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Stricter export controls block or delay shipment of high-end AI accelerators, pre-trained models, and cloud services to targeted firms, directly reducing available training throughput and slowing iteration cycles.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_trade_rivalry</data>
  <data key="d39">ai_safety_militarization</data>
</edge>
<edge source="us_china_trade_rivalry::export_control_level" target="global_rate_repricing::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Tightening export controls immediately blocks transactions and raises compliance/legal risk, prompting foreign investors, banks and trading partners to pause or withdraw capital and trade finance to affected firms and jurisdictions, reducing net cross-border capital flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_trade_rivalry</data>
  <data key="d39">global_rate_repricing</data>
</edge>
<edge source="us_china_trade_rivalry::export_control_level" target="mid_east_energy_shock::crude_oil_supply_availab" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Tighter export controls on critical technologies to China prompt Beijing to accelerate spot purchases and build strategic reserves of Middle East crude to hedge against supply-chain pressure, drawing down volumes available to third‑party buyers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_trade_rivalry</data>
  <data key="d39">mid_east_energy_shock</data>
</edge>
<edge source="us_china_trade_rivalry::export_control_level" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Tighter export controls on advanced technologies toward China require and incentivize multilateral coordination (sharing rules, enforcement, intelligence), which increases political and operational alignment among US partners and allies on broader security policies including responses to Russia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_trade_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
