<edge source="mid_east_energy_shock::maritime_security_threat" target="ai_safety_militarization::deployment_rate_of_model" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising attacks and losses in key sea lanes prompt navies and private maritime operators to field AI-driven surveillance, autonomy and counter-drone systems, accelerating the operational deployment rate of models for maritime tasks.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">mid_east_energy_shock</data>
  <data key="d39">ai_safety_militarization</data>
</edge>
<edge source="mid_east_energy_shock::maritime_security_threat" target="global_rate_repricing::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating threats to vessels in key chokepoints raises insurance and security costs and forces some traders and banks to suspend or curtail payments and lending tied to affected routes, reducing the net rate of cross-border trade and associated capital flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_energy_shock</data>
  <data key="d39">global_rate_repricing</data>
</edge>
<edge source="mid_east_energy_shock::maritime_security_threat" target="russia_ukraine_war::defense_aid_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising maritime threats in Middle Eastern chokepoints force allied navies, airlift and escort resources to be reassigned to protect commercial traffic and regional partners, reducing the available lift, convoy protection and logistics throughput for weapons and equipment deliveries to Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_energy_shock</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="mid_east_energy_shock::maritime_security_threat" target="us_china_trade_rivalry::cross_border_investment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in attacks or perceived risk in key sea lanes raises insurance and transport costs and prompts investors to delay or redirect FDI in export-oriented and import-dependent projects, reducing cross-border investment flows between blocs (including US↔China) within investment decision cycles.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">mid_east_energy_shock</data>
  <data key="d39">us_china_trade_rivalry</data>
</edge>
