  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">An increase in coercive_escalation (more intense cross‑border kinetic, paramilitary or hybrid operations) elevates geopolitical risk and term premiums, pushing up nominal sovereign yields across maturities as investors price higher risk and potential economic disruption.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_rate_repricing</data>
</edge>
<edge source="russia_ukraine_war::coercive_escalation" target="mid_east_energy_shock::maritime_security_threat" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Increased kinetic and hybrid operations tied to the Russia‑Ukraine war (attacks on ports, mine‑laying, naval skirmishes, or proxy strikes) raises observable risks to vessels and crews in adjacent sea lanes and can spill over into chokepoints used by Middle Eastern energy shipping.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">mid_east_energy_shock</data>
</edge>
