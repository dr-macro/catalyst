<edge source="russia_ukraine_war::sanctions_stringency" target="us_china_ai_tech_rivalry::semiconductor_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">More stringent sanctions and export-control measures tied to the conflict lead suppliers and governments to restrict sales of advanced lithography tools, materials and design software to targeted jurisdictions, delaying fab tool deliveries and new wafer-line ramps and therefore reducing near-term semiconductor manufacturing capacity growth.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
