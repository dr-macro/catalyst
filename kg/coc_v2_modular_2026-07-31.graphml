<edge source="us_trade_protectionism::tariff_policy_uncertaint" target="global_financial_tension::yield_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Greater uncertainty about future tariff policies increases rapid, discrete revisions to inflation and corporate-profit forecasts, driving more frequent repricing in the bond market and higher yield volatility.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_trade_protectionism</data>
  <data key="d40">global_financial_tension</data>
</edge>
<edge source="us_trade_protectionism::tariff_policy_uncertaint" target="mideast_iran_us_conflict::shipping_insurance_premi" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising unpredictability in US tariff policy increases underwriters' perceived political and operational risk for international routes, causing war‑risk and political‑risk insurers to raise premiums for shipments transiting volatile Middle East sea lanes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_trade_protectionism</data>
  <data key="d40">mideast_iran_us_conflict</data>
</edge>
<edge source="us_trade_protectionism::tariff_policy_uncertaint" target="us_china_ai_tech_rivalry::capital_flow_ai_infra" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Rising unpredictability about tariff and trade enforcement increases jurisdictional policy risk and investor uncertainty, prompting funds and corporate investors to pause or re-allocate commitments to multi-year AI infrastructure projects.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_trade_protectionism</data>
  <data key="d40">us_china_ai_tech_rivalry</data>
</edge>
