<edge source="global_financial_tension::central_bank_credibility" target="us_china_ai_tech_rivalry::capital_flow_ai_infra" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A loss of central bank credibility raises perceived macro and currency risk for investors, prompting reallocation or withdrawal of long‑term investments away from capital‑intensive AI infrastructure projects.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">us_china_ai_tech_rivalry</data>
