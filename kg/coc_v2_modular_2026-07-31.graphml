  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Large disruptions to oil and gas flows lift headline inflation and forward inflation swaps, prompting markets to price in earlier and/or larger central‑bank tightening.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_financial_tension</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_severity" target="mideast_iran_us_conflict::oil_export_flow_volume" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Sharp disruptions to Russian energy supplies push importers (particularly in Europe and Asia) to replace lost barrels with increased purchases from Middle Eastern producers, raising crude and product export volumes transiting regional sea lanes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">mideast_iran_us_conflict</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_severity" target="us_china_ai_tech_rivalry::compute_deployment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Acute energy supply disruptions and higher electricity prices force cloud providers and hyperscalers to delay or scale back data-center builds and machine deployments in affected regions, directly slowing the rate at which new AI compute capacity is brought online.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_ai_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_severity" target="us_trade_protectionism::trade_barrier_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Severe energy disruptions raise domestic production costs and political pressure to shield energy‑intensive industries, prompting policymakers to adopt higher tariffs, import restrictions or selective export controls to protect domestic capacity.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_trade_protectionism</data>
</edge>
