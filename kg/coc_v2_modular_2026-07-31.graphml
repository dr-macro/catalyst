<edge source="global_financial_tension::yield_volatility" target="mideast_iran_us_conflict::shipping_insurance_premi" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Sharp increases in bond yield volatility signal elevated systemic risk and funding stress, provoking immediate risk‑off behavior among underwriters and reinsurers and materially raising war‑risk and political‑risk insurance premia for regional shipping.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">mideast_iran_us_conflict</data>
</edge>
<edge source="global_financial_tension::yield_volatility" target="russia_ukraine_war::intensity_conflict" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Spikes in bond-yield volatility disrupt trade finance, export credit and insurance markets that underwrite arms production and shipments, delaying deliveries and lowering the operational tempo and overall intensity of military operations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_financial_tension::yield_volatility" target="us_china_ai_tech_rivalry::tech_geopolitical_tensio" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Spikes in bond yield volatility amplify market stress and policymakers' risk aversion, provoking defensive regulatory responses (heightened screening of cross‑border tech deals, controls or capital restrictions) that increase tech geopolitical tension.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">us_china_ai_tech_rivalry</data>
</edge>
<edge source="global_financial_tension::yield_volatility" target="us_trade_protectionism::asset_price_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Spikes in bond-yield volatility force frequent revaluation of discount rates and risk premia, provoking rapid repricing in equities and credit and thus directly increasing short‑term asset-price volatility.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">us_trade_protectionism</data>
</edge>
