          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rapid increase in enforcement actions (investigations, seizures, fines) against suppliers and intermediaries forces firms to suspend or cancel deliveries and logistics support for Russian military customers, producing an immediate drop in supply flow rates." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_ai_chip_rivalry" />
