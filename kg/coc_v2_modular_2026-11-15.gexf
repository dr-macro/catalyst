          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Raising the legal scope and specificity of sanctions prompts authorities to deploy additional investigative, customs and financial-control resources (asset freezes, ship detentions, designation of facilitators), directly increasing enforcement intensity against oil-related trade." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_oil_market_shift" />
          <attvalue for="27" value="0" />
