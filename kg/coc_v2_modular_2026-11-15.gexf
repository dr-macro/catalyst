          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Broadening and institutionalization of export controls increases geopolitical fragmentation and the term premium investors demand for sovereign risk, exerting upward pressure on long-dated government bond yields." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_ai_chip_rivalry" />
          <attvalue for="38" value="global_bond_market_shock" />
