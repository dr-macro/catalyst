          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Broader export controls that cover navigation, automation, or dual‑use electronics used in tankers and port equipment disrupt parts supply, maintenance and certification cycles for vessels, causing temporary withdrawals, slower port turnarounds and a net reduction in effective tanker and tanker-support capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_ai_chip_rivalry" />
          <attvalue for="38" value="global_oil_market_shift" />
