          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A widening diesel price spread raises operational and import costs for the party with weaker refined‑product access (reducing its export competitiveness and fiscal flexibility), thereby eroding that party's relative bargaining power in negotiations over the conflict." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_oil_market_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
