          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened regulatory enforcement against illicit dual‑use transfers raises the difficulty and risk of Iran obtaining advanced AI chips for drones and targeting systems, degrading operational capability and lowering the short‑term likelihood Iranian leaders authorize kinetic retaliation." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_ai_chip_rivalry" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="27" value="0" />
