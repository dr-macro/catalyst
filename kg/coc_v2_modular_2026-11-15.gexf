          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A widening diesel price spread indicates tightening in refined-fuel markets that feeds through to higher near-term consumer/transport inflation readings, leading markets to price in a higher path for short-term policy rates." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shift" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
