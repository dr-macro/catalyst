      <edge source="russia_ukraine_war::military_supply_rate" target="iran_regional_conflict::kinetic_response_prob" id="215">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sustained increases in Western military shipments to Ukraine cause immediate depletion and reallocation of US/NATO precision munitions and rapid-fire stocks, reducing available ordnance for partners in the Middle East and thereby raising the likelihood that local actors or states will authorize kinetic options to achieve objectives before supplies run out or deterrence gaps widen." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_supply_rate" target="iran_regional_conflict::escalation_pressure" id="216">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Large-scale diversion of logistics and stockpiles to the Ukraine theater channels operational strain onto regional forces and logistics chains, increasing mobilization pressures, readiness shortfalls and incentives for preemptive or escalatory posturing in the Iran regional theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
