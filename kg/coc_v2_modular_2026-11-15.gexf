      <edge source="global_oil_market_shift::diesel_price_spread" target="china_ai_chip_rivalry::investor_risk_perception" id="569">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A widening diesel price spread raises logistics and operating costs for chip manufacturers and subcontractors (transport, generators, heat), increasing investors' perceived probability of margin pressure and supply-chain disruption for China-based AI chip firms." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shift" />
          <attvalue for="38" value="china_ai_chip_rivalry" />
