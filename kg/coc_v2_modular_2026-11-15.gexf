      <edge source="russia_ukraine_war::military_supply_rate" target="global_oil_market_shift::shipping_capacity" id="214">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A surge in military logistics and chartering to support operations congests regional ports, reallocates scarce tanker/charter capacity and raises scheduling/insurance frictions, reducing available commercial oil transport capacity on short notice." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_oil_market_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
