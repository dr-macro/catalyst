      <edge source="russia_ukraine_war::sanctions_stringency" target="china_ai_chip_rivalry::export_control_prevalenc" id="221">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Escalation of sanctions regimes tied to the Russia–Ukraine war drives governments to design, adopt and operationalize broader dual‑use export‑control lists and licensing regimes that are then applied to advanced AI‑capable chips and related suppliers, increasing the prevalence of export controls targeting that technology." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_ai_chip_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_stringency" target="china_ai_chip_rivalry::investor_risk_perception" id="222">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A visible rise in stringent sanctions and secondary‑sanctions practice around the Russia war increases investor awareness of sanction exposure and tail risk, leading investors to mark up perceived political and compliance risks for Chinese AI‑chip firms and suppliers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_ai_chip_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_stringency" target="global_bond_market_shock::cross_border_capital_flo" id="223">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter, broad financial sanctions increase counterparty and country risk perceptions, driving rapid reallocation of international portfolios into safe‑haven sovereign bonds and thereby increasing net cross‑border inflows into core bond markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_stringency" target="global_bond_market_shock::long_term_bond_yield" id="224">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating sanctions that restrict energy exports and payment channels drive up global commodity and inflation expectations, which lift inflation risk premia and therefore long‑term sovereign bond yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
