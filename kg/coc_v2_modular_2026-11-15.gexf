          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Accelerated enforcement actions against major chip firms increase credit losses and tighten bank lending conditions to the sector, leading markets to price a higher probability of future monetary easing to offset growth/headline risks, lowering policy-rate expectations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_ai_chip_rivalry" />
          <attvalue for="38" value="global_bond_market_shock" />
