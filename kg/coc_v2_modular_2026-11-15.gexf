          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter sanctions enforcement (inspections, interdictions, vessel blacklists) increases naval and coastguard interdiction activity and confrontations with Iranian ships and proxy actors, raising the frequency of hostile maritime incidents." />
