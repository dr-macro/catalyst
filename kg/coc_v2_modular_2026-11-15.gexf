          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Stricter enforcement of oil-related sanctions increases legal and counterparty risk for banks and investors, prompting rapid withdrawal or rerouting of cross-border credit and investment away from targeted jurisdictions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shift" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="27" value="0" />
