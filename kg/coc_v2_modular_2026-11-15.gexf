          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened sanctions enforcement normalizes use of trade-restriction tools and prompts policymakers to expand and tighten export-control lists and licensing regimes targeting dual-use technologies supplied to sanctioned or sanction-evading actors." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_oil_market_shift" />
          <attvalue for="38" value="china_ai_chip_rivalry" />
