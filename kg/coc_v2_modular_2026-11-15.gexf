          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Stricter sanctions enforcement reallocates investigative resources and political attention to cross-border compliance, triggering more frequent probes, audits, and legal actions against firms (including AI chip suppliers) for sanctions and export violations." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_oil_market_shift" />
          <attvalue for="38" value="china_ai_chip_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
