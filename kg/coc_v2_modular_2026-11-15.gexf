          <attvalue for="35" value="Rises in long-term government bond yields increase the cost of working-capital and project finance for refiners and raise the discount rate applied to expected margins, causing some refiners to cut runs or delay maintenance turnarounds and thereby lower utilization in the near term." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_market_shock" />
          <attvalue for="38" value="global_oil_market_shift" />
