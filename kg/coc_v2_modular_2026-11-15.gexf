      <edge source="global_bond_market_shock::cross_border_capital_flo" target="china_ai_chip_rivalry::export_control_prevalenc" id="693">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Sustained net capital outflows from China raise strategic and national‑security concerns among importing‑country policymakers, motivating them to expand the scope and strictness of export controls on advanced semiconductors." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_bond_market_shock" />
          <attvalue for="38" value="china_ai_chip_rivalry" />
