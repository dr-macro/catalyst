      <edge source="global_bond_market_shock::cross_border_capital_flo" target="global_oil_market_shift::shipping_capacity" id="694">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Increases in cross-border capital inflows lower financing costs and improve access to leasing/refinance for tanker owners and operators, enabling more charters, fewer vessel layups and timely acceptance of newbuilds, which raises effective shipping capacity over the medium term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_bond_market_shock" />
          <attvalue for="38" value="global_oil_market_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_market_shock::cross_border_capital_flo" target="iran_regional_conflict::energy_supply_risk" id="695">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sharp net capital outflows from Gulf markets quickly tighten bank liquidity and curtail trade‑finance and pre‑export lending that underpins oil shipments and tanker operations, increasing the probability of short‑term energy delivery disruptions." />
