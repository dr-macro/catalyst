      <edge source="russia_ukraine_war::military_supply_rate" target="global_bond_market_shock::long_term_bond_yield" id="213">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained uptick in military supply flows forces higher defense-related government spending and raises sovereign funding needs and term premia, prompting investors to demand higher long-term yields on government bonds." />
