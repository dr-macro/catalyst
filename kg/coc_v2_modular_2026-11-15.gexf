          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rapid escalation and formalization of export controls on AI chips prompts allied governments to extend those controls into coordinated sanctioning regimes and stricter enforcement against entities facilitating restricted tech transfers, increasing overall sanctions enforcement intensity for related trade channels." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_ai_chip_rivalry" />
          <attvalue for="38" value="global_oil_market_shift" />
