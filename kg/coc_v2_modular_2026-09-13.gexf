          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sustained rise in long-term sovereign yields raises government debt servicing and marginal borrowing costs, forcing near-term budget reprioritization and reducing the rate at which funds are committed and disbursed to military procurement programs." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
