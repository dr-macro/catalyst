      <edge source="global_bond_rate_shock::long_term_yield" target="iran_regional_escalation::oil_gas_flow" id="440">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained rises in long‑term sovereign yields signal and help precipitate global demand weakening (through higher financing costs and lower investment), which reduces crude and LNG liftings and contracted volumes exported from the region." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="iran_regional_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_rate_shock::long_term_yield" target="russia_ukraine_war::defense_funding_flow_rat" id="441">
