        </attvalues>
      </edge>
      <edge source="global_bond_rate_shock::market_liquidity" target="energy_chokepoints::tanker_freight_rate" id="519">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A bond‑market liquidity shock reduces availability of short‑term finance and hedging for traders and vessel operators, prompting voyage cancellations or risk premia that push up tanker charter and voyage rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="energy_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_rate_shock::market_liquidity" target="energy_chokepoints::chokepoint_security" id="520">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter market liquidity constrains insurers' and private security firms' ability to underwrite or pre‑finance protective deployments, leading operators to cut security spending or avoid high‑risk transits and reducing chokepoint security levels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="energy_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_rate_shock::market_liquidity" target="iran_regional_escalation::oil_gas_flow" id="521">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A sharp drop in fixed‑income market liquidity impairs trade finance, letters of credit and hedging (oil shipping finance), forcing traders and shippers to delay or cancel cargoes transiting regional chokepoints and reducing physical oil and gas flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="iran_regional_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_rate_shock::market_liquidity" target="us_china_tech_rivalry::model_deployment_rate" id="522">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sudden reduction in fixed-income market liquidity constrains short-term funding lines and exit options for startups and slows corporate financing, prompting immediate freezes on new model rollouts and capacity expansion." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_rate_shock::market_liquidity" target="us_china_tech_rivalry::safety_incident_frequenc" id="523">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter market liquidity forces cost cuts and layoffs at AI firms and reduces spending on monitoring, red‑team testing and incident response, increasing the frequency of safety, misuse, or leak events per unit time." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
