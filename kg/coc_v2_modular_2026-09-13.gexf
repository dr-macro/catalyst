          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Elevated security-driven measures (export controls, sanctions threats, contingency planning) increase perceived supply risk and induce immediate risk premia in physical markets, pushing up near-term oil spot prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="energy_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
