          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An increase in attacks/seizures on commercial and military shipping in regional routes raises loss and delay rates for Western and Black Sea‑bound arms shipments (including ammunition and missiles), directly reducing the delivered munitions available for operations in the Russia‑Ukraine theatre." />
