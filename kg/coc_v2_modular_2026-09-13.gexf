      <edge source="iran_regional_escalation::military_engagement" target="energy_chokepoints::crude_throughput" id="33">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Heightened kinetic strikes on ports, terminals, tankers or supporting naval assets interrupts loading and transit operations and prompts port closures or shipping refusals, directly lowering crude volumes transiting export routes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="energy_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::military_engagement" target="russia_ukraine_war::drone_warfare_intensity" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating Iranian kinetic operations increase Tehran's incentives to export or expedite transfer of armed UAVs, parts and operational know‑how to external partners or to Russia, raising the frequency and scale of armed drone use in the Ukraine conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::military_engagement" target="us_china_tech_rivalry::safety_incident_frequenc" id="35">
