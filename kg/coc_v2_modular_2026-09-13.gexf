      <edge source="iran_regional_escalation::sanctions_enforcement" target="global_bond_rate_shock::intervention_activity" id="83">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharper, more operationally rigorous sanctions that impede cross-border payments and dollar clearing produce funding dislocations and asset-price dislocations that compel central banks and authorities to execute targeted market interventions (FX swaps, repo operations, asset purchases) to restore functioning." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
