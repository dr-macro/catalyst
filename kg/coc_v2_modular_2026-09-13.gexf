          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A deterioration in chokepoint security lowers barriers to hostile acts (attacks, seizures, harassment) by state and non‑state actors, directly increasing the rate of disruptive maritime incidents." />
