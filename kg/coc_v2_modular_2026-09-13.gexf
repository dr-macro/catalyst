          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Stronger, more operational sanctions against Iranian entities provoke U.S. and allied agencies to broaden export controls and scrutiny of third‑party (including Chinese) tech actors to prevent sanction circumvention, raising national‑security pressure on AI-related data and hardware flows." />
          <attvalue for="37" value="0-6 months" />
