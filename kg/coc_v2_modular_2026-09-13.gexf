          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Intensified drone attacks increase uncertainty about regional assets and counterparty exposures, causing dealers to pull back inventories and widen bid‑ask spreads, reducing short‑term fixed‑income market liquidity." />
