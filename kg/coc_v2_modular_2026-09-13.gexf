          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Spikes in escalation produce sharp bond‑market volatility and dislocations, triggering central banks and sovereign authorities to conduct targeted market interventions and liquidity operations to stabilize prices and credit conditions." />
