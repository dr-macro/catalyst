          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating security-driven export controls and de-risking between the U.S. and China fragment cross-border clearing, custody and dealer networks so dealers pull back inventories and widen bid-ask spreads, reducing short-term bond market liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_bond_rate_shock" />
