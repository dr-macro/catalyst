          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Heightened national-security pressure drives faster implementation of export controls and enhanced intelligence-sharing among allies, producing more aggressive targeting, interdiction, and legal enforcement actions against networks linked to Iran." />
