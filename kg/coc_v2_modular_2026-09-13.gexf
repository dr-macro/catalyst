          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalation in kinetic engagements spurs retaliatory and opportunistic cyber operations and targeting of critical infrastructure that increase leaks, tampering, and misuse of AI systems, raising observed safety and security incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="us_china_tech_rivalry" />
