          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Increased drone use and demonstrated effectiveness in Ukraine lowers technical and operational barriers for Iran and its proxies to mount longer‑range, lower‑cost strikes against regional rivals, increasing the frequency of kinetic confrontations." />
