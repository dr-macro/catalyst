      <edge source="iran_regional_escalation::maritime_incident_rate" target="energy_chokepoints::tanker_freight_rate" id="47">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Increased incidents raise war‑risk insurance premiums, force rerouting and speed reductions, and reduce available safe sailings, directly lifting tanker hire and voyage rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="energy_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::maritime_incident_rate" target="global_bond_rate_shock::market_liquidity" id="48">
