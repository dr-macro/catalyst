          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Increased frontline use and experimentation with AI-guided and improvised drone systems produces more operational failures, unintended behaviors, capture of systems, and leakage of models/data, raising the observed frequency of safety and misuse incidents." />
