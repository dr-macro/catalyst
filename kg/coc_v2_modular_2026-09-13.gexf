      <edge source="iran_regional_escalation::sanctions_enforcement" target="energy_chokepoints::oil_spot_price" id="82">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter enforcement of sanctions restricts buyers, payment and insurance channels for targeted exporters and reduces effective available supply to spot markets, directly raising near‑term physical price levels through supply tightness and risk premia." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="energy_chokepoints" />
          <attvalue for="28" value="0" />
