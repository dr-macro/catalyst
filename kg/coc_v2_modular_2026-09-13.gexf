      <edge source="iran_regional_escalation::maritime_incident_rate" target="energy_chokepoints::chokepoint_security" id="46">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A rising rate of ship seizures, attacks and harassment directly forces temporary closures, naval escorts, and de facto denial-of-transit conditions that reduce the operational openness and safety of maritime chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="energy_chokepoints" />
          <attvalue for="28" value="0" />
