          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A surge in disruptive maritime incidents raises trade and counterparty risk, prompting dealers and market-makers to pull inventory and widen bid-ask spreads, thereby reducing short-term liquidity in global fixed-income markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
