          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="If US-led tech pressure limits China's access to Western suppliers, China may increase energy purchases from Iran as a political/economic offset, directly raising Iranian oil/gas export volumes to China." />
