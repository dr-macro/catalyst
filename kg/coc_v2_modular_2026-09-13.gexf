      <edge source="global_bond_rate_shock::long_term_yield" target="energy_chokepoints::oil_spot_price" id="439">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising long‑term sovereign yields attract portfolio flows into fixed income and raise the discount rate applied to commodity cash flows, diminishing speculative and carry demand for oil and exerting downward pressure on near‑term spot prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="energy_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
