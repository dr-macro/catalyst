          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A rise in long-term government yields raises the discount rate and long-horizon financing costs for capital- and compute-intensive AI projects, reducing their expected NPV and causing firms to delay or cancel planned model deployments." />
