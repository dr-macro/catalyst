  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sharper Western sanctions on Iran push Tehran toward deeper security cooperation with Moscow (including expedited transfers of drones, components, and advisory support), raising the tempo of lethal transfers into the Russia–Ukraine theater.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confront</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_iran_confront::sanctions_intensity" target="us_china_tech_trade::regulatory_stringency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating US sanctions on Iran triggers allied governments and export-control agencies to broaden and tighten dual‑use and end‑use screening (including tech export rules), raising regulatory strictness applied to AI-relevant trade with China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confront</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
