<edge source="energy_asset_realloc::capital_inflows_oil" target="global_bond_repricing::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Incremental debt and equity financing into upstream and midstream oil projects constitutes direct inbound capital, increasing recorded net cross‑border flows and FX conversion activity in the short term.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_asset_realloc</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="energy_asset_realloc::capital_inflows_oil" target="us_china_tech_trade::ai_investment_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising capital into the oil sector increases fiscal receipts and balance sheets of state/backed energy firms, which in turn redirect a portion of new liquidity into sovereign and corporate investments in AI R&amp;D, data centers and startups.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">energy_asset_realloc</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
<edge source="energy_asset_realloc::capital_inflows_oil" target="us_iran_confront::external_influence" id="0">
