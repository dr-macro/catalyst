<edge source="us_iran_confront::sanctions_intensity" target="energy_asset_realloc::capital_inflows_oil" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A sharp increase in sanctions raises legal and counterparty risk and transaction costs for banks and private investors, prompting lenders and equity providers to suspend or withdraw financing for upstream and midstream oil projects.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confront</data>
  <data key="d39">energy_asset_realloc</data>
</edge>
<edge source="us_iran_confront::sanctions_intensity" target="global_bond_repricing::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Escalating sanctions raise compliance and counterparty risk for banks and asset managers, prompting immediate withdrawal or rerouting of cross-border capital and net outflows from affected emerging-market fixed-income and related funds.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confront</data>
  <data key="d39">global_bond_repricing</data>
