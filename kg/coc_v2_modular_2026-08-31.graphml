<edge source="us_china_tech_trade::geo_competition" target="energy_asset_realloc::sanction_enforcement_lev" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A rise in US–China tech/geopolitical competition prompts governments to broaden and intensify export controls, financial restrictions and interagency screening targeted at adversary energy firms, directly increasing sanction enforcement levels.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_trade</data>
  <data key="d39">energy_asset_realloc</data>
</edge>
<edge source="us_china_tech_trade::geo_competition" target="energy_asset_realloc::access_agreements_extent" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Intensifying geopolitical rivalry drives state actors and state‑backed investors to secure multi‑year supply contracts and equity stakes in foreign oil fields and infrastructure as strategic hedges, expanding the scope of long‑term access agreements.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_trade</data>
  <data key="d39">energy_asset_realloc</data>
</edge>
<edge source="us_china_tech_trade::geo_competition" target="global_bond_repricing::market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A spike in US–China strategic competition raises the probability of sanctions, supply‑chain shocks and sudden policy moves, prompting fast re-pricing across bonds, equities and FX and raising short-term market volatility.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_trade</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="us_china_tech_trade::geo_competition" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Intensifying US–China tech/trade competition drives the United States and like-minded partners to deepen synchronous policies (export controls, joint R&amp;D, intelligence-sharing and pooled procurement) as hedges, increasing operational coordination and burden‑sharing among allies relevant to Ukraine support.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_trade</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_trade::geo_competition" target="us_iran_confront::sanctions_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A rise in US–China tech competition prompts the US to widen and tighten sanctions (including secondary measures) against firms and networks that enable Chinese–Iran tech cooperation, directly increasing sanctions severity on Iran-facing entities.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_trade</data>
