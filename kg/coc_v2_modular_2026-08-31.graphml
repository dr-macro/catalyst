  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Rising foreign investment in the oil sector increases dependence on external finance, technical partners and contractual relationships, which strengthens outside actors' capacity to shape local policy and strategic choices.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">energy_asset_realloc</data>
  <data key="d39">us_iran_confront</data>
</edge>
