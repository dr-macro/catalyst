<edge source="russia_ukraine_war::weapons_transfer_rate" target="global_bond_repricing::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A visible surge in weapons deliveries raises investor concerns about spillovers and retaliation, prompting non‑resident investors to pull capital out of regional bond and equity markets into safe‑haven assets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="russia_ukraine_war::weapons_transfer_rate" target="us_iran_confront::external_influence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A sustained surge in weapons transfers to Ukraine diverts finite US/NATO inventories and delivery capacity away from Middle East partners, reducing outside actors' ability to shape outcomes there via military assistance.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_iran_confront</data>
</edge>
