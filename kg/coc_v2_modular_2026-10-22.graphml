<edge source="us_domestic_politics::information_flow_rate" target="ai_infra_market_risk::credit_spread" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Rapid, high‑reach flows of political information and unverified allegations about major AI/cloud firms heighten short‑term counterparty and reputational risk perceptions, causing lenders and bond investors to demand wider credit spreads for AI‑related borrowers.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_domestic_politics</data>
  <data key="d40">ai_infra_market_risk</data>
</edge>
<edge source="us_domestic_politics::information_flow_rate" target="iran_regional_escalation::maritime_transit_securit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Faster, wider spread of (mis)information about incidents at sea can produce rapid misattribution and pressure for immediate defensive or retaliatory actions by U.S. or allied forces, producing incidents that increase security risks for commercial shipping.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_domestic_politics</data>
  <data key="d40">iran_regional_escalation</data>
</edge>
<edge source="us_domestic_politics::information_flow_rate" target="russia_ukraine_war::corporate_market_actions" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Faster, broader dissemination of operational, legal and reputational risks (including leaks and investor/activist signals) prompts companies to accelerate divestments, service suspensions and other market exits related to Russia/Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_domestic_politics</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
