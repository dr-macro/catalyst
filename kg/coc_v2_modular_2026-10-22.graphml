<edge source="us_china_tech_rivalry::security_threat_incidenc" target="ai_infra_market_risk::credit_spread" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">A rise in physical or cyber security incidents against data centres or cloud providers increases perceived operational and default risk for related borrowers, causing lenders to demand wider credit spreads.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">ai_infra_market_risk</data>
</edge>
<edge source="us_china_tech_rivalry::security_threat_incidenc" target="iran_regional_escalation::maritime_transit_securit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">An uptick in cyber and physical attacks on data‑centre and logistics infrastructure (as part of tech‑rivalry coercion or retaliation) degrades port/ship AIS, provisioning and routing systems and directly disrupts commercial navigation, raising the risk to maritime transit in regional choke points.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">iran_regional_escalation</data>
</edge>
<edge source="us_china_tech_rivalry::security_threat_incidenc" target="russia_ukraine_war::allied_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">A rise in cyber/physical security incidents tied to actors in the US–China tech rivalry generates shared threat perceptions among Western partners, triggering more frequent consultations and coordinated policy responses that increase allied cohesion on Russia/Ukraine-related measures.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_rivalry::security_threat_incidenc" target="us_domestic_politics::information_flow_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Successful cyberattacks or physical attacks on data centers, CDNs or interconnection points directly degrade platform uptime and bandwidth, slowing or interrupting the dissemination of political information and increasing reliance on lower-quality channels.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">us_domestic_politics</data>
</edge>
