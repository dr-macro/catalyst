<edge source="ai_infra_market_risk::ai_investment_flow" target="russia_ukraine_war::corporate_market_actions" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A surge in AI infrastructure investment spurs dealmaking and reallocation by tech firms (M&amp;A, cloud contracts, spin‑offs and market exits) that produces a higher frequency and scale of corporate transactions affecting service provision and asset holdings relevant to Russia–Ukraine dynamics.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">ai_infra_market_risk</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="ai_infra_market_risk::ai_investment_flow" target="us_china_tech_rivalry::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A rapid surge in visible AI infrastructure investment—especially concentrated or cross‑border deals—triggers policymakers and regulators to open inquiries, propose export controls and tighten oversight due to perceived national‑security, competition and concentration risks.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_infra_market_risk</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="ai_infra_market_risk::ai_investment_flow" target="us_domestic_politics::media_attention" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.85</data>
  <data key="d37">Large funding rounds, hyperscale buildouts, layoffs, IPOs or government subsidies in AI generate high‑profile reporting, congressional hearings and industry commentary that raise overall media volume and prominence around political actors and policy.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">ai_infra_market_risk</data>
  <data key="d40">us_domestic_politics</data>
</edge>
<edge source="ai_infra_market_risk::compute_capacity" target="ai_infra_market_risk::investor_sentiment_ai" id="0">
