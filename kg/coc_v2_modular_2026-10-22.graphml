<edge source="iran_regional_escalation::maritime_transit_securit" target="ai_infra_market_risk::compute_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Heightened risk to maritime transit causes port closures/re-routings, insurance spikes and carrier delays that materially postpone deliveries of GPUs, servers and racks, reducing near-term additions to aggregate AI compute capacity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_regional_escalation</data>
  <data key="d40">ai_infra_market_risk</data>
</edge>
<edge source="iran_regional_escalation::maritime_transit_securit" target="us_china_tech_rivalry::investor_confidence_leve" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Heightened attacks and threats to commercial shipping raise insurance and logistics costs, delay delivery of critical server hardware and construction materials, and increase project risk premia, which reduces investor appetite for new data‑centre financing.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_regional_escalation</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="iran_regional_escalation::maritime_transit_securit" target="us_domestic_politics::media_attention" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.85</data>
  <data key="d37">Attacks on or threats to commercial shipping in chokepoints generate vivid visuals, casualty and insurance stories, and trade-disruption reporting that quickly increase news and social-platform coverage of the region and related policy debates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_regional_escalation</data>
  <data key="d40">us_domestic_politics</data>
</edge>
