<edge source="iran_regional_escalation::oil_supply_disruption_le" target="ai_infra_market_risk::ai_investment_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.68</data>
  <data key="d37">Physical disruptions to oil/energy supply raise short‑term energy costs and force data centre operators to revise operating-cost forecasts upward, lowering project IRRs and prompting developers and investors to delay or scale back new AI infrastructure deployments.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">iran_regional_escalation</data>
  <data key="d40">ai_infra_market_risk</data>
