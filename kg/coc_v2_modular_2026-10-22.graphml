  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Physical interruptions to oil supply constrain fuel for oil‑fired generation and diesel reserves used for grid balancing and backup, degrading reliable power availability that data‑centres depend on.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_regional_escalation</data>
  <data key="d40">us_china_tech_rivalry</data>
