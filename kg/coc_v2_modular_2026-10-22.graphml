</edge>
<edge source="ai_infra_market_risk::compute_capacity" target="ai_infra_market_risk::systemic_interconnectedn" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">3</data>
  <data key="d34">+</data>
</edge>
<edge source="ai_infra_market_risk::compute_capacity" target="iran_regional_escalation::military_engagement_inte" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A rapid increase in available compute capacity accelerates deployment of AI-enabled ISR, real‑time targeting and autonomous systems by state and proxy actors in the region, lowering operational thresholds and increasing the tempo and intensity of kinetic exchanges.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_infra_market_risk</data>
  <data key="d40">iran_regional_escalation</data>
</edge>
<edge source="ai_infra_market_risk::compute_capacity" target="russia_ukraine_war::tech_control_enforcement" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rapid increases in accessible high‑end compute amplify policymakers' assessment of proliferation and dual‑use risk, prompting quicker expansion and tightening of export controls and service restrictions on advanced AI hardware and cloud services that could reach adversaries including Russia.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_infra_market_risk</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="ai_infra_market_risk::compute_capacity" target="us_china_tech_rivalry::grid_power_availability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sharp increases in deployed or utilized AI compute raise local electricity demand and peak loads, forcing utilities into curtailments, load‑shedding or constrained allocation that reduce reliable grid availability for data centres and nearby users.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">ai_infra_market_risk</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="ai_infra_market_risk::compute_capacity" target="us_domestic_politics::information_flow_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Increases in available inference and training capacity enable higher‑volume, lower‑latency automated generation and personalization of political content (including deepfakes and microtargeted messaging), directly accelerating the speed and reach of information and misinformation flows.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_infra_market_risk</data>
  <data key="d40">us_domestic_politics</data>
</edge>
