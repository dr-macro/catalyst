<edge source="china_eu_trade_rivalry::oil_price_volatility" target="ai_compute_chip_race::market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Larger and more frequent crude-price swings transmit through futures, options and correlated instruments, amplifying volatility across commodity and related financial markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_trade_rivalry</data>
  <data key="d40">ai_compute_chip_race</data>
