<edge source="china_eu_trade_rivalry::oil_price_volatility" target="global_energy_supply_ris::storage_inventory_volume" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising short‑term oil price volatility driven by China–EU trade shocks incentivizes traders and some governments to increase onshore and near‑shore stockpiles as a hedge, raising aggregate storage volumes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_trade_rivalry</data>
  <data key="d40">global_energy_supply_ris</data>
</edge>
<edge source="china_eu_trade_rivalry::oil_price_volatility" target="russia_ukraine_war::market_price_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Spikes in oil-price volatility driven by China–EU trade shocks propagate through global futures and physical-arbitrage channels into Brent/Urals-linked trading, directly increasing wholesale price variability in energy markets connected to the Russia–Ukraine conflict.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_trade_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
