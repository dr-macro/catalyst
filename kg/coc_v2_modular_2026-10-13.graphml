<edge source="global_energy_supply_ris::tanker_charter_rate" target="ai_compute_chip_race::market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Spikes in tanker charter rates raise uncertainty about delivery timing and costs, increasing basis risk and hedging activity which amplifies price swings and financial market volatility in the short term.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_ris</data>
  <data key="d40">ai_compute_chip_race</data>
</edge>
<edge source="global_energy_supply_ris::tanker_charter_rate" target="china_eu_trade_rivalry::trade_flow_volume" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Rising tanker charter rates increase shipping costs and freight-rate uncertainty, prompting firms to cut or reroute shipments and reducing bilateral trade volumes between high-volume partners such as China and the EU.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_ris</data>
  <data key="d40">china_eu_trade_rivalry</data>
</edge>
<edge source="global_energy_supply_ris::tanker_charter_rate" target="russia_ukraine_war::hydrocarbon_supply_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Sustained increases in tanker charter rates raise transport costs and reduce the economic viability of some shipments, causing charter cancellations, longer voyage times or route avoidance that lower net physical deliveries to destination markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_ris</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
