<edge source="china_eu_trade_rivalry::tanker_attack_risk" target="ai_compute_chip_race::route_security_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A rise in the perceived probability and expected frequency of tanker attacks directly elevates the assessed likelihood of disruption along maritime chokepoints and shipping lanes, increasing overall route security risk as operators reroute, delay sailings, or require escorts.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_trade_rivalry</data>
  <data key="d40">ai_compute_chip_race</data>
</edge>
<edge source="china_eu_trade_rivalry::tanker_attack_risk" target="global_energy_supply_ris::tanker_charter_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Higher perceived risk of hostile actions against tankers tied to China–EU rivalry raises insurance and security costs and shrinks available safe-flag capacity, driving up the cost to charter vessels.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_trade_rivalry</data>
  <data key="d40">global_energy_supply_ris</data>
</edge>
<edge source="china_eu_trade_rivalry::tanker_attack_risk" target="iran_proxy_escalation::security_incident_freq" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Escalation of China–EU naval shadowing, interdiction attempts or sanction-driven convoying raises both opportunities and incentives for Iran-aligned proxy groups to mount more attacks on tankers and ports to exploit confused maritime security conditions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_trade_rivalry</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
