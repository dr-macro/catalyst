  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sharp, sustained increases in oil spot prices lead governments to implement temporary export controls, price caps or licensing restrictions (to shield domestic markets or punish adversaries), thereby raising trade and sanction measures.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_ris</data>
  <data key="d40">iran_proxy_escalation</data>
</edge>
