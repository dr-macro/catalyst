  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Increased frequency of successful attacks on production, pipelines, terminals or export facilities directly removes physical export capacity and interrupts shipping routes, immediately lowering aggregate crude movement through the system.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_supply_ris</data>
</edge>
