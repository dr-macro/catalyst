<edge source="russia_ukraine_war::market_uncertainty" target="china_eu_trade_rivalry::energy_supply_disruption" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sharp increases in market uncertainty lead producers, traders and carriers to pull back on forward commitments and run down inventories, producing tangible interruptions in delivery schedules and localized shortages that disrupt the steady flow of energy deliveries between suppliers and EU/Asian buyers.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">china_eu_trade_rivalry</data>
