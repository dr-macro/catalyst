  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Actual interruptions to energy production, refining or transport reduce immediate available cargoes in spot markets, forcing buyers to bid up cash prices for oil and refined fuels.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_trade_rivalry</data>
  <data key="d40">ai_compute_chip_race</data>
