      <edge source="us_iran_standoff::geopolitical_tension_lev" target="global_market_turbulence::global_bond_yield_level" id="196">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.72" />
          <attvalue for="36" value="Escalating geopolitical tensions drive flight-to-safety flows into major sovereign bonds, boosting demand and putting downward pressure on yields in core markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="global_market_turbulence" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::geopolitical_tension_lev" target="russia_ukraine_war::global_liquidity" id="197">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained rise in geopolitical tension tied to a US–Iran standoff drives safe‑haven flows, tighter bank funding conditions and precautionary balance‑sheet hoarding, directly reducing the pool of readily available cross‑border funding and liquidity that underpins financing related to the Russia–Ukraine war." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::geopolitical_tension_lev" target="state_crypto_cybercrime::cyberattack_rate" id="198">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising US–Iran geopolitical tensions increase the probability of state-directed and proxy cyber operations (offensive intrusions, disruption, and espionage) as each side uses cyber tools for escalation, deniability, and retaliation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="state_crypto_cybercrime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::geopolitical_tension_lev" target="us_china_tech_rivalry::election_policy_bias" id="199">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalation in the US–Iran standoff raises domestic political salience of national-security signaling and incentivizes policymakers to adopt short-term, symbolic tech-export restrictions or sanctions aimed at China ahead of elections to gain political advantage." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
