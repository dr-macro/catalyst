      <edge source="us_iran_standoff::oil_supply_risk" target="global_market_turbulence::oil_price_level" id="209">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.92" />
          <attvalue for="36" value="Higher assessed probability of physical disruption to oil/gas raises immediate spot and futures bids as market participants price in a supply shortfall and risk premia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="global_market_turbulence" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::oil_supply_risk" target="russia_ukraine_war::oil_supply_demand_gap" id="210">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Heightened risk to oil production and shipping from a US–Iran standoff (e.g., attacks, insurance/shipping reroutes, temporary shutdowns) directly reduces available supply into global markets, widening the supply–demand gap that also affects energy conditions around the Russia–Ukraine theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::oil_supply_risk" target="russia_ukraine_war::policy_rate_expect" id="211">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute oil‑supply risk raises oil prices and near‑term inflation pressure in European and global markets, which in turn pushes up market expectations for tighter central‑bank policy relevant to countries engaged with the Russia–Ukraine war." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::oil_supply_risk" target="state_crypto_cybercrime::commodity_volatility" id="212">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Higher risk of physical disruptions to oil and gas supply from the Gulf sharply raises energy price uncertainty and triggers larger, more frequent swings in energy markets that spill over into broader commodity pricing." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="state_crypto_cybercrime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::oil_supply_risk" target="us_china_tech_rivalry::oil_price_level" id="213">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A rise in assessed probability/severity of Persian Gulf supply disruptions causes traders and refiners to bid up futures and spot crude prices immediately to pre-price potential shortfalls and risk premia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
