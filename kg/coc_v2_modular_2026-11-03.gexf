          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Acute increases in market volatility from war shocks trigger margin calls, mark-to-market losses and heightened uncertainty, prompting investors to shift allocations into safer assets and lower overall risk-taking." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
