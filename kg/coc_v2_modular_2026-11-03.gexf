        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising investor risk appetite channels more private capital into infrastructure upgrades and cybersecurity projects for energy firms, strengthening physical and cyber resilience but typically over a multi-quarter project cycle." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="state_crypto_cybercrime" />
          <attvalue for="39" value="us_china_tech_rivalry" />
