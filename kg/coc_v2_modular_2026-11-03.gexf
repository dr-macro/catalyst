      <edge source="global_market_turbulence::portfolio_reallocation_r" target="state_crypto_cybercrime::cross_border_capital" id="602">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Spikes in portfolio reallocation drive rapid purchases and sales of foreign assets (FX, equities, bonds) as managers and allocators shift exposures, producing observable increases in cross-border capital flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_turbulence" />
          <attvalue for="39" value="state_crypto_cybercrime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_market_turbulence::portfolio_reallocation_r" target="us_china_tech_rivalry::election_policy_bias" id="603">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Elevated, rapid portfolio reallocation that produces visible asset-price shocks and revenue swings increases political pressure on incumbent governments to adopt short-term, election-friendly fiscal or regulatory measures." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_turbulence" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_market_turbulence::portfolio_reallocation_r" target="us_iran_standoff::geopolitical_tension_lev" id="604">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rapid reallocation of portfolios away from Middle Eastern assets (higher reallocation rate) withdraws external capital and narrows financial options for Iran and regional proxies, increasing economic strain and the likelihood of coercive actions that elevate US–Iran tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_turbulence" />
          <attvalue for="39" value="us_iran_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
