          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher investor willingness to assume risk redirects venture and private capital toward cybersecurity, resilient communications and dual‑use technology startups serving the conflict zone, accelerating tech investment momentum relevant to the war effort." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="state_crypto_cybercrime" />
          <attvalue for="39" value="russia_ukraine_war" />
