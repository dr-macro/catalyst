      <edge source="global_market_turbulence::investor_risk_appetite" target="russia_ukraine_war::market_volatility" id="583">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rise in aggregate investor risk appetite increases liquidity and predictable flow patterns into risk assets, damping price swings and thus lowering realized and implied market volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_turbulence" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_market_turbulence::investor_risk_appetite" target="state_crypto_cybercrime::cyberattack_rate" id="584">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising investor risk appetite funnels more retail and institutional capital into higher-risk crypto products and newly launched trading platforms, expanding the attack surface and incentives for cybercriminals and thereby increasing successful attacks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_turbulence" />
          <attvalue for="39" value="state_crypto_cybercrime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_market_turbulence::investor_risk_appetite" target="us_china_tech_rivalry::geopolitical_tension" id="585">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A sudden drop in global investor risk appetite precipitates capital outflows and currency pressure in China and other Asia-linked markets, provoking defensive regulatory and trade/tech measures that raise US–China political and economic tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_turbulence" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_market_turbulence::investor_risk_appetite" target="us_iran_standoff::market_volatility" id="586">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An increase in investor risk appetite reduces flight-to-safety flows and dampens rapid sell-offs around geopolitical incidents, directly lowering realized and implied market volatility tied to US–Iran flare-ups." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_market_turbulence" />
          <attvalue for="39" value="us_iran_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
