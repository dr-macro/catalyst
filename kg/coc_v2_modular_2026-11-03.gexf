      <edge source="russia_ukraine_war::oil_supply_demand_gap" target="global_market_turbulence::oil_price_level" id="35">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="War-related export disruptions, sanctions and rerouting reduce available crude relative to consumption, drawing inventories and forcing buyers to bid up benchmark crude prices for scarce barrels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_market_turbulence" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::oil_supply_demand_gap" target="state_crypto_cybercrime::commodity_volatility" id="36">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="War-related disruptions, export bans and uncertain shipping raise the oil supply-demand gap and provoke rapid revisions to forward curves and inventories, producing larger intraday and interday swings in energy and related commodity prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="state_crypto_cybercrime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::oil_supply_demand_gap" target="us_china_tech_rivalry::oil_price_level" id="37">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.95" />
          <attvalue for="36" value="Reduction of Russian crude exports and sanctions-related shipping frictions widens the global supply shortfall, directly increasing the world oil price per barrel." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::oil_supply_demand_gap" target="us_iran_standoff::oil_supply_risk" id="38">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A larger oil supply gap caused by reduced Russian exports raises global reliance on Persian Gulf crude and creates stronger incentives for the US and regional actors to contest flows or pressure suppliers, increasing the probability of physical disruptions tied to the US–Iran standoff." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_iran_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
