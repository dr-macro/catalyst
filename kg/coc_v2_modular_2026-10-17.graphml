<edge source="russia_ukraine_war::satcom_access_avail" target="global_economic_strain::market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A deterioration or loss of commercial satcom availability disrupts market data, trading connectivity and surveillance (especially for remote regions/segments), increasing execution uncertainty and short-term asset-price volatility.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_economic_strain</data>
</edge>
<edge source="russia_ukraine_war::satcom_access_avail" target="global_energy_supply_cri::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Improved availability/reliability of commercial satellite communications enhances merchant situational awareness, AIS/monitoring and timely reporting, enabling avoidance, deterrence or rapid response that lowers the incidence of successful hostile actions against shipping and energy infrastructure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_energy_supply_cri</data>
</edge>
<edge source="russia_ukraine_war::satcom_access_avail" target="iran_proxy_escalation::armed_strike_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Greater availability/reliability of commercial satellite communications provides Iran‑backed proxies with resilient command, timing and guidance links for UAVs and loitering munitions, increasing both frequency and accuracy of strike operations.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_proxy_escalation</data>
</edge>
