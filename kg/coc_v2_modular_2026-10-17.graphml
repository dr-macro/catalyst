  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="global_energy_supply_cri::oil_price_level" target="global_energy_supply_cri::trader_sentiment_index" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="global_energy_supply_cri::oil_price_level" target="global_energy_supply_cri::refinery_margin_index" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="global_energy_supply_cri::oil_price_level" target="china_tech_trade_rivalry::ai_capital_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained rise in oil prices raises operating and energy costs for data centers and chip fabs, compressing projected returns on capital‑intensive AI infrastructure and prompting investors to reduce new capital allocations to AI ventures linked to China tech trade.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">china_tech_trade_rivalry</data>
</edge>
<edge source="global_energy_supply_cri::oil_price_level" target="global_economic_strain::policy_rate_expectations" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Sustained increases in oil prices raise consumer inflation and inflation expectations, leading markets to price in earlier and/or higher central-bank policy rate hikes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">global_economic_strain</data>
</edge>
<edge source="global_energy_supply_cri::oil_price_level" target="global_economic_strain::sovereign_fiscal_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Higher oil prices increase import and subsidy bills for net‑importing governments, widening deficits and elevating rollover and debt‑service pressures for fiscally vulnerable sovereigns.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">global_economic_strain</data>
</edge>
<edge source="global_energy_supply_cri::oil_price_level" target="iran_proxy_escalation::escalation_strength" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained higher oil prices boost fiscal and extrafiscal revenues available to state and allied networks, enabling increased funding, procurement and sustainment of proxy operations that amplify reciprocal escalation dynamics.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">iran_proxy_escalation</data>
</edge>
<edge source="global_energy_supply_cri::oil_price_level" target="russia_ukraine_war::sanctions_enforcement" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising oil prices increase the value of sanctioned energy flows and the incentive for evasion, prompting sanctioning states and regulators to intensify monitoring, interdiction and enforcement actions to protect the sanctions' economic impact.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
