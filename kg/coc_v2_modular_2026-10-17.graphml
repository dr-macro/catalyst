<edge source="global_economic_strain::policy_rate_expectations" target="china_tech_trade_rivalry::investor_sentiment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Rising expected short-term policy rates increase discount rates and reduce risk appetite, directly lowering investor confidence and willingness to back higher-risk AI ventures tied up in the China–tech rivalry.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">china_tech_trade_rivalry</data>
</edge>
<edge source="global_economic_strain::policy_rate_expectations" target="russia_ukraine_war::military_logistics_susta" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher expected short-term policy rates raise the cost of short-term financing, letters of credit and working capital for logistics contractors and fuel suppliers, producing delays or cutbacks in munitions and fuel deliveries that degrade sustainment of operations in Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
