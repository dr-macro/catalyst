<edge source="global_energy_supply_cri::global_diesel_stocks" target="china_tech_trade_rivalry::supply_chain_bottleneck" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Higher global diesel inventories reduce fuel rationing and keep trucking, inland logistics and port operations running, easing movement of semiconductor components and server hardware and thereby lowering supply‑chain bottleneck intensity for AI-related trade with/through China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">china_tech_trade_rivalry</data>
</edge>
<edge source="global_energy_supply_cri::global_diesel_stocks" target="iran_proxy_escalation::armed_strike_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.62</data>
  <data key="d36">Higher commercial and strategic diesel inventories decrease the incentive for proxies to mount strikes aimed at seizing or disrupting fuel flows, lowering the frequency and scale of armed attacks on fuel logistics and related targets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">iran_proxy_escalation</data>
</edge>
<edge source="global_energy_supply_cri::global_diesel_stocks" target="russia_ukraine_war::military_logistics_susta" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Commercial and strategic diesel inventories are the immediate source for vehicle and generator fuel for forces and partners; rapid depletion of stocks directly undermines the ability to sustain mechanized and logistical operations.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
