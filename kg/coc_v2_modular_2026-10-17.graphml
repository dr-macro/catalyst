<edge source="global_economic_strain::sovereign_fiscal_stress" target="china_tech_trade_rivalry::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Growing fiscal pressure pushes states to prioritize industrial protection and revenue-preserving oversight, leading to expanded export controls, investment screening, and enforcement measures targeting technology flows linked to China.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">china_tech_trade_rivalry</data>
</edge>
<edge source="global_economic_strain::sovereign_fiscal_stress" target="global_energy_supply_cri::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute fiscal pressure forces cuts to naval/coastguard patrols and to contracted maritime security, and increases likelihood of unpaid/undermotivated local forces, which raises the frequency of piracy and asymmetric attacks on commercial energy shipping.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">global_energy_supply_cri</data>
</edge>
<edge source="global_economic_strain::sovereign_fiscal_stress" target="iran_proxy_escalation::escalation_strength" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute increases in sovereign fiscal stress for a regional patron prompt political leaders to rely more on deniable proxy operations and calibrated attacks to project power and rally domestic support, which strengthens reciprocal escalation feedbacks between opponents and proxies.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">iran_proxy_escalation</data>
</edge>
<edge source="global_economic_strain::sovereign_fiscal_stress" target="russia_ukraine_war::alliance_defense_commit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising sovereign fiscal stress forces governments to reallocate budgetary resources and delay or scale back announced defense aid, procurement and deployments to Ukraine, reducing allied defence commitments.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
