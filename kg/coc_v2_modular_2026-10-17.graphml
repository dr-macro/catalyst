<edge source="global_economic_strain::market_volatility" target="china_tech_trade_rivalry::supply_chain_bottleneck" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Spikes in asset and FX volatility prompt suppliers and buyers to curtail trade credit and postpone orders, producing immediate production stoppages and logistics slowdowns that intensify component shortages for AI hardware.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">china_tech_trade_rivalry</data>
</edge>
<edge source="global_economic_strain::market_volatility" target="global_energy_supply_cri::tanker_availability_inde" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Spikes in market volatility prompt insurers and banks to raise or withdraw war‑risk and trade‑finance coverage and lead charterers to avoid risky routes, producing regional de‑facto shortages as tonnage is rerouted or laid up.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">global_energy_supply_cri</data>
</edge>
<edge source="global_economic_strain::market_volatility" target="iran_proxy_escalation::supply_chain_disruption" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Spikes in market volatility raise insurance and shipping risk premia and prompt lenders and contractors to delay or reroute shipments of parts, fuel and maintenance crews, producing immediate interruptions in regional logistics and supply chains used by both civilian and military actors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">iran_proxy_escalation</data>
</edge>
