<edge source="global_economic_strain::treasury_yield_level" target="global_energy_supply_cri::oil_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising benchmark government yields increase discount rates and financing costs for inventories and commodity trades and tend to strengthen the pricing currency, reducing speculative and physical crude demand and exerting downward pressure on oil prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">global_energy_supply_cri</data>
</edge>
<edge source="global_economic_strain::treasury_yield_level" target="russia_ukraine_war::energy_supply_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in benchmark government bond yields raises borrowing and trade-finance costs for energy traders and producers, prompting reduced shipments, deferred maintenance or constrained throughput that lowers physical energy flows affecting the Russia–Ukraine energy corridor and European markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_economic_strain</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
