<edge source="global_energy_supply_cri::tanker_availability_inde" target="global_energy_supply_cri::fuel_supply_demand_gap" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="global_energy_supply_cri::tanker_availability_inde" target="iran_proxy_escalation::escalation_strength" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Greater effective tanker availability reduces immediate economic leverage from disrupting shipping (and eases fuel competition), undercutting incentives for reciprocal or escalatory reprisals and thereby weakening escalation feedbacks.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">iran_proxy_escalation</data>
</edge>
<edge source="global_energy_supply_cri::tanker_availability_inde" target="russia_ukraine_war::military_logistics_susta" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Higher effective commercial tanker availability enables more fuel lift to forward ports and allied stockpiles supporting operations in-theatre, improving sustained fuel resupply for forces; reduced availability constrains those deliveries and stresses logistics lines.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_supply_cri</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
