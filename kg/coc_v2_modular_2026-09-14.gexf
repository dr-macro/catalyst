      <edge source="global_bond_inflation::financial_conditions_ind" target="iran_gulf_chokepoints::maritime_chokepoints_cap" id="604">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter financial conditions increase shipping and trade finance costs and constrain working capital for carriers and terminals, leading to stretched schedules, deferred sailings and maintenance, and thus a measurable reduction in effective throughput at major chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_inflation" />
          <attvalue for="39" value="iran_gulf_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
