          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Tighter financial conditions (higher spreads, reduced credit) constrain defense contractors' and frontline units' ability to purchase parts, finance maintenance, and sustain fuel/logistics chains, which lowers sortie rates and active operational density of drones." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_inflation" />
          <attvalue for="39" value="russia_ukraine_war" />
