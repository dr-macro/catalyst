      <edge source="global_bond_inflation::financial_conditions_ind" target="brics_china_india::financial_integration_de" id="603">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Tighter global financial conditions (wider spreads, higher volatility, reduced credit availability) prompt banks and asset managers to de-risk and cut cross-border lending and wholesale funding, directly shrinking the depth of financial linkages and coordination among BRICS, including China and India." />
          <attvalue for="37" value="0-12 months" />
          <attvalue for="38" value="global_bond_inflation" />
          <attvalue for="39" value="brics_china_india" />
          <attvalue for="28" value="0" />
