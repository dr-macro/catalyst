          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sustained high-volume weapons and aid flows signal a protracted conflict, raising a geopolitical risk premium on sovereign debt and pushing up long-term government bond yields as investors demand higher compensation." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_inflation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
