          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An uptick in China–BRICS trade and investment — including relaxed export controls or increased shipments of UAS components and dual‑use electronics from China — directly supplies Russia with parts and finished drones, enabling higher sortie rates in the theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="brics_china_india" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
