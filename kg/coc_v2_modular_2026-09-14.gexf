      <edge source="russia_ukraine_war::weapons_and_aid_flow" target="brics_china_india::financial_integration_de" id="236">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Larger Western arms and assistance packages increase the likelihood and severity of financial restrictions on Russia, incentivizing BRICS members to expand alternative payment channels, currency-swap arrangements and bilateral settlement mechanisms to preserve commerce with Russia." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="brics_china_india" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::weapons_and_aid_flow" target="global_bond_inflation::long_term_gov_yield" id="237">
