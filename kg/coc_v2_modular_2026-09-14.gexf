          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A surge in bilateral trade and investment activity raises short-term transport and industrial fuel demand (and logistic bottlenecks), directly increasing crude oil demand and lifting oil prices." />
