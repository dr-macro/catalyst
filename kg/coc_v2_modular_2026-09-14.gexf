          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large, sustained flows of weapons, sensors, and operational data into the theatre accelerate R&amp;D and field testing by allied contractors and researchers, speeding improvements in core AI models and specialist systems." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_allied_tech_rivalry" />
