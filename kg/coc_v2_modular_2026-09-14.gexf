      <edge source="us_allied_tech_rivalry::regulatory_activity_leve" target="brics_china_india::trade_investment_flow" id="769">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Heightened US‑allied regulatory activity (export controls and extraterritorial licensing on AI hardware, cloud services and dual‑use software) directly restricts BRICS firms' and investors' access to key inputs and markets, reducing cross‑border trade and investment volumes between BRICS members and external (US/allied) partners." />
