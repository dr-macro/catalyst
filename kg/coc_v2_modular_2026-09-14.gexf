      <edge source="brics_china_india::policy_coordination_stre" target="iran_gulf_chokepoints::shipping_risk_premium" id="475">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="1" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger China–India policy coordination to provide diplomatic protection, coordinated state-backed insurance or organized convoy/escort arrangements reduces insurers' perceived exposure and thus lowers the incremental shipping risk premium on Gulf-to-Asia routes." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="brics_china_india" />
          <attvalue for="39" value="iran_gulf_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_china_india::policy_coordination_stre" target="russia_ukraine_war::defense_support_burden" id="476">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger, coordinated BRICS diplomacy that blocks or weakens sanctions enforcement and export controls prolongs the conflict by sustaining Russian sustainment pathways, forcing external supporters to maintain or raise military and humanitarian aid budgets and thus increasing their fiscal burden." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="brics_china_india" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_china_india::policy_coordination_stre" target="us_allied_tech_rivalry::regulatory_activity_leve" id="477">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
