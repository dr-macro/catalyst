      <edge source="russia_ukraine_war::weapons_and_aid_flow" target="brics_china_india::trade_investment_flow" id="235">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sustained increases in Western weapons and aid to Ukraine prompt Russia to reroute energy, commodity exports and investment partnerships toward China and India to replace lost Western markets, directly raising trade and investment flows between Russia and BRICS partners." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="brics_china_india" />
          <attvalue for="28" value="0" />
        </attvalues>
