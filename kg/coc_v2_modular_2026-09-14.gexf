      <edge source="us_allied_tech_rivalry::regulatory_activity_leve" target="global_bond_inflation::long_term_gov_yield" id="770">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A marked increase in allied regulatory intervention on AI raises expected long-run drag on productivity and tech-sector growth, reducing the term premium and putting downward pressure on long-term government yields." />
          <attvalue for="37" value="6-18 months" />
