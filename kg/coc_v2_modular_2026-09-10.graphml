<edge source="global_financial_turmoil::cross_asset_volatility" target="israel_palestine_flashpo::media_scrutiny_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Sharp increases in cross-asset volatility drive financial and mainstream outlets to hunt for proximate geopolitical drivers, thereby raising the volume and prominence of coverage linking Israel–Palestine developments to market risk and sanctions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_turmoil</data>
  <data key="d39">israel_palestine_flashpo</data>
