<edge source="global_financial_turmoil::cross_asset_volatility" target="russia_ukraine_war::mediation_activation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Acute spikes in cross‑asset volatility raise systemic‑risk concerns among major powers and financial policymakers, prompting third‑party actors and envoys to initiate or intensify mediation to calm markets and reduce geopolitical risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_turmoil</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
