  <data key="d38">us_iran_gulf_conflict</data>
  <data key="d39">global_financial_turmoil</data>
</edge>
<edge source="us_iran_gulf_conflict::energy_infra_attack_rate" target="israel_palestine_flashpo::media_scrutiny_intensity" id="0">
