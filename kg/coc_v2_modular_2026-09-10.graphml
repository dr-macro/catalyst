  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Escalating geopolitical tensions trigger asymmetric capital flows and sanction/fear‑driven reallocations into safe‑haven currencies while weighing on currencies of countries exposed to China‑US friction, increasing cross‑currency dispersion.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">global_financial_turmoil</data>
</edge>
<edge source="us_china_rivalry::geo_tension_level" target="global_financial_turmoil::market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Higher geopolitical friction raises counterparty and regulatory risk, inducing market‑makers and prime brokers to reduce inventories and widen spreads, materially degrading market depth and resiliency.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">global_financial_turmoil</data>
</edge>
<edge source="us_china_rivalry::geo_tension_level" target="israel_palestine_flashpo::escalation_risk_perc" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">An increase in systemic US–China geopolitical tension raises stakeholders' belief that a local Israel–Palestine incident could draw in or be exploited by great powers, directly elevating perceived risk of wider escalation.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">israel_palestine_flashpo</data>
</edge>
<edge source="us_china_rivalry::geo_tension_level" target="israel_palestine_flashpo::media_scrutiny_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Heightened rivalry leads state and partisan media in both camps to spotlight and frame Israel–Palestine events as proxy or strategic issues, increasing volume and prominence of coverage.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">israel_palestine_flashpo</data>
</edge>
<edge source="us_china_rivalry::geo_tension_level" target="russia_ukraine_war::mediation_activation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising systemic U.S.–China geopolitical tensions reduce China's willingness and perceived neutrality to host or participate in third‑party mediation and divert diplomatic bandwidth from envoy initiatives, lowering the intensity and frequency of mediation efforts.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_china_rivalry::geo_tension_level" target="us_iran_gulf_conflict::military_escalation_leve" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rise in US–China geopolitical tensions prompts the US to increase forward naval and air deployments and adopt higher-risk signalling in adjacent theaters, producing more encounters, interdictions and miscalculation risk with Iranian forces and proxies in the Gulf.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">us_iran_gulf_conflict</data>
</edge>
