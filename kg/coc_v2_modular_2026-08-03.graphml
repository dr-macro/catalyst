<edge source="china_us_tech_rivalry::geo_tech_tension" target="energy_maritime_chokepoi::maritime_security_incide" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Escalating US–China technology confrontation prompts more state and paramilitary deployments, interdictions and harassment around strategic sea lanes (to signal resolve, protect undersea infrastructure or retaliate), directly increasing the frequency and severity of maritime security incidents.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_us_tech_rivalry</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="china_us_tech_rivalry::geo_tech_tension" target="energy_maritime_chokepoi::tanker_fleet_availabilit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Technology‑related sanctions, export controls and insurance restrictions tied to the US–China rivalry cause operators and insurers to avoid certain flags, ports and routes, forcing longer voyages, detentions or idling that reduce effective tanker tonnage available for commercial employment in key chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_us_tech_rivalry</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="china_us_tech_rivalry::geo_tech_tension" target="global_monetary_stress::fx_intervention_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Spikes in geopolitical technology tension (export controls, sanctions, trade restrictions) create acute cross‑border capital and trade flows that prompt authorities to buy or sell FX to stabilize strategic exchange rates and secure supply chains.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_us_tech_rivalry</data>
  <data key="d40">global_monetary_stress</data>
</edge>
<edge source="china_us_tech_rivalry::geo_tech_tension" target="global_monetary_stress::long_term_yield" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Heightened technology geopolitics increases risk‑off demand for safe‑haven sovereign debt, raising prices and thereby lowering long‑term bond yields in the near term.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_us_tech_rivalry</data>
  <data key="d40">global_monetary_stress</data>
</edge>
<edge source="china_us_tech_rivalry::geo_tech_tension" target="us_iran_confrontation::diplomatic_tension_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Escalating US–China tech confrontation drives China to deepen trade, investment and sanctions‑evasion ties with Iran (tech transfers, financial channels), provoking US diplomatic protests, sanctions and reciprocal measures that raise bilateral diplomatic tension with Iran.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_us_tech_rivalry</data>
  <data key="d40">us_iran_confrontation</data>
</edge>
