  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A depreciation of a major hydrocarbon-importing currency versus the invoice currency (i.e., an increase in the bilateral exchange rate) raises local import costs and leads importers to reduce or delay seaborne oil/LNG purchases, lowering physical flows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_monetary_stress</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
