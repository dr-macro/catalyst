  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A decline in chokepoint throughput (closures or capacity losses) provokes immediate diplomatic escalation by the US — public condemnations, sanctions pressure and regional consultations — raising bilateral and multilateral tensions with parties seen as responsible or obstructive.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">us_iran_confrontation</data>
</edge>
