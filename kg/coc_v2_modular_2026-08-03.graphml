<edge source="us_iran_confrontation::military_presence_level" target="china_us_tech_rivalry::avail_compute_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">A sustained increase in deployed military assets drives accelerated defense procurement of high‑end servers, accelerators and hardened compute for ISR and operational AI, drawing from constrained global inventories and temporarily reducing civilian deployable compute capacity.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_iran_confrontation</data>
  <data key="d40">china_us_tech_rivalry</data>
</edge>
<edge source="us_iran_confrontation::military_presence_level" target="energy_maritime_chokepoi::chokepoint_transit_capac" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Larger deployed naval and interdiction forces in and around chokepoints lead to enforced inspections, convoying, temporary closures, and slower transit schedules, reducing effective daily throughput capacity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confrontation</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="us_iran_confrontation::military_presence_level" target="global_monetary_stress::long_term_yield" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">An increased deployed military footprint elevates geopolitical risk and triggers a safe‑haven bid for long-dated sovereign bonds (especially US Treasuries), putting downward pressure on long-term yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confrontation</data>
  <data key="d40">global_monetary_stress</data>
</edge>
<edge source="us_iran_confrontation::military_presence_level" target="russia_ukraine_war::military_attack_intensit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A sustained increase in U.S. and allied force deployments to the Middle East prompts the redeployment of NATO/US air, naval and ISR assets away from Europe, reducing the deterrence and targeting support available to Ukraine and thereby enabling Russia to raise the tempo of offensive strikes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confrontation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_iran_confrontation::munitions_stockpile" target="us_iran_confrontation::offensive_strike_rate" id="0">
