  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Material declines in seaborne oil/LNG shipments constrain fuel availability or raise prices for power generation in import-dependent markets, causing utilities or data center operators to curtail operations or postpone deployments and thus reducing available compute capacity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
  <data key="d40">china_us_tech_rivalry</data>
</edge>
