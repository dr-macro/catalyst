<edge source="energy_maritime_chokepoi::maritime_security_incide" target="us_iran_confrontation::retaliatory_strike_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.8</data>
  <data key="d37">When attacks on shipping are attributed to Iranian forces or their proxies, US or allied commanders frequently respond with targeted kinetic strikes against perpetrators or their infrastructure, increasing retaliatory strike frequency.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_maritime_chokepoi</data>
