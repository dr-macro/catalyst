<edge source="us_iran_confrontation::diplomatic_tension_level" target="china_us_tech_rivalry::geo_tech_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Escalating diplomatic hostility in the US–Iran confrontation prompts policymakers to expand export controls, sanctions and secondary‑sanctions enforcement and to coordinate allied tech‑security measures, directly increasing geopolitical friction centered on technology between the US and other major tech actors (notably China).</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confrontation</data>
  <data key="d40">china_us_tech_rivalry</data>
</edge>
<edge source="us_iran_confrontation::diplomatic_tension_level" target="energy_maritime_chokepoi::market_risk_perception" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.85</data>
  <data key="d37">Escalating diplomatic hostility and public threats increase trader, insurer, and investor perception of disruption risk, prompting higher risk premia and precautionary market behaviour.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_confrontation</data>
  <data key="d40">energy_maritime_chokepoi</data>
</edge>
<edge source="us_iran_confrontation::diplomatic_tension_level" target="global_monetary_stress::fx_intervention_flow" id="0">
