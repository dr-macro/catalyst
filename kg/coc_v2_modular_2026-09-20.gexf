          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An increase in energy_flow_stability (more reliable cross‑border energy supplies) reduces headline energy-driven inflation and the upside shock to consumer prices, lowering the near‑term need for central banks to raise policy interest rates." />
