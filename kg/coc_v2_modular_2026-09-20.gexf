      <edge source="us_china_trade_rivalry::supply_chain_diversity" target="mid_east_energy_shock::trade_rerouting_rate" id="367">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Corporate moves to diversify supply chains away from China create new production and transshipment points, which directly increases the rate at which energy and goods shipments are re-routed to alternative sea lanes, hubs and logistics corridors." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_rivalry" />
          <attvalue for="38" value="mid_east_energy_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_trade_rivalry::supply_chain_diversity" target="russia_ukraine_war::sanction_pressure" id="368">
