          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Increases in advanced domestic semiconductor fabrication capacity raise the supply and lower the cost of accelerators and custom chips, directly enabling larger-scale training runs and faster model iteration." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_rivalry" />
          <attvalue for="38" value="ai_safety_militarization" />
