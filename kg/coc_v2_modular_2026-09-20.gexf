          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A substantive drop in available crude from the Middle East increases buyers' dependence on alternative exporters (notably Russia) and strengthens those suppliers' diplomatic leverage, prompting importing governments to dial back the severity or scope of sanctions to secure uninterrupted supplies." />
