      <edge source="us_china_trade_rivalry::supply_chain_diversity" target="global_rate_repricing::asset_allocation_tilt" id="366">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Greater geographic diversification of critical supply chains lowers concentration and earnings-volatility risk for corporates, reducing equity risk premia and prompting institutional investors to tilt portfolios toward equities and away from safe cash/bond holdings." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_rivalry" />
          <attvalue for="38" value="global_rate_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
