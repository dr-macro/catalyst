      <edge source="global_rate_repricing::asset_allocation_tilt" target="ai_safety_militarization::deployment_rate_of_model" id="589">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Shifts by large investors toward equities and technology-heavy allocations lift public and private tech valuations and cash access for AI firms, enabling faster hiring, integration and rollout of trained models into production systems." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_repricing" />
          <attvalue for="38" value="ai_safety_militarization" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_repricing::asset_allocation_tilt" target="us_china_trade_rivalry::chip_fab_capacity" id="590">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A tilt by institutional investors away from equities toward bonds/cash reduces availability and raises the cost of long-horizon equity and project finance, prompting delays, downsizing or cancellations of capital-intensive fab expansions and slowing near-term growth in operable capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_rate_repricing" />
          <attvalue for="38" value="us_china_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_repricing::cross_border_flows" target="global_rate_repricing::asset_allocation_tilt" id="591">
