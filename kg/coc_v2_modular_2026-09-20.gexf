      <edge source="mid_east_energy_shock::maritime_security_threat" target="global_rate_repricing::cross_border_flows" id="94">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating threats to vessels in key chokepoints raises insurance and security costs and forces some traders and banks to suspend or curtail payments and lending tied to affected routes, reducing the net rate of cross-border trade and associated capital flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_energy_shock" />
          <attvalue for="38" value="global_rate_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
