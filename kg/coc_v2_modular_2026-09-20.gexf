      <edge source="mid_east_energy_shock::maritime_security_threat" target="ai_safety_militarization::deployment_rate_of_model" id="93">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising attacks and losses in key sea lanes prompt navies and private maritime operators to field AI-driven surveillance, autonomy and counter-drone systems, accelerating the operational deployment rate of models for maritime tasks." />
