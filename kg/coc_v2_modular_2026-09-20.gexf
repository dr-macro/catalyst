      <edge source="mid_east_energy_shock::crude_oil_supply_availab" target="ai_safety_militarization::regulatory_pressure" id="29">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A sudden drop in crude supply reframes energy shortfalls as national-security emergencies, prompting governments to fast-track rulemaking, export controls and oversight of dual‑use technologies (including AI) to protect critical infrastructure and manage risks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_energy_shock" />
          <attvalue for="38" value="ai_safety_militarization" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="mid_east_energy_shock::crude_oil_supply_availab" target="global_rate_repricing::policy_interest_rate" id="30">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sudden drop in crude supply from the Middle East raises headline inflation and inflation expectations through higher transport and energy costs, prompting central banks to raise policy rates to defend inflation targets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_energy_shock" />
          <attvalue for="38" value="global_rate_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="mid_east_energy_shock::crude_oil_supply_availab" target="global_rate_repricing::nominal_yield_curve" id="31">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Reduced crude availability increases expected future inflation and term premia, pushing up nominal yields across maturities and steepening/raising the yield curve as investors demand compensation for higher expected inflation and risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_energy_shock" />
          <attvalue for="38" value="global_rate_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
