      <edge source="global_rate_repricing::cross_border_flows" target="ai_safety_militarization::capital_flow_rate" id="594">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A drop in cross‑border capital flows (risk‑off/global repricing) directly reduces foreign portfolio, VC and FDI into major AI hubs, lowering the net rate of new investment available for AI development and commercialisation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_repricing" />
          <attvalue for="38" value="ai_safety_militarization" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_repricing::cross_border_flows" target="mid_east_energy_shock::crude_oil_supply_availab" id="595">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An increase in cross‑border capital flows improves access to foreign financing, spare parts and offshore contractor services for exporters and refiners, sustaining production and exports and thus raising immediate crude availability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_repricing" />
          <attvalue for="38" value="mid_east_energy_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_repricing::cross_border_flows" target="russia_ukraine_war::defense_aid_flow" id="596">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Higher cross‑border capital and banking flows ease financing, payment and logistics for procurement and transfers (including spare parts and munitions), directly increasing the rate and volume of defense aid that can be delivered to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_repricing" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
