          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A spike in perceived geopolitical risk triggers a rapid risk-off reallocation and flight-to-safety, diverting portfolio and bank flows away from exposed jurisdictions into safe-haven currencies and assets, lowering net cross-border inflows to risky markets." />
