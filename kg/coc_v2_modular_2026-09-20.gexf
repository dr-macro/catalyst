          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A surge in domestic AI investment raises asset valuations and reduces the incentive for outbound M&amp;A and greenfield investment abroad (and makes foreign targets more expensive), thereby lowering cross-border investment flows between blocs." />
