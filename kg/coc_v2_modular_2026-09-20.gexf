          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="An increase in net cross-border capital flows raises available liquidity and financing for M&amp;A, greenfield projects and portfolio-backed expansions, directly boosting measured cross-border investment volumes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_repricing" />
