          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increase in allied/domestic advanced semiconductor fabrication capacity raises available supplies of critical components for precision munitions, drones and targeting systems, enabling higher and more sustained transfers of those systems to Ukraine and its partners." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_rivalry" />
