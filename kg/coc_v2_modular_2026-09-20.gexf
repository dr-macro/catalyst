          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rise in AI-related safety incidents (e.g., algorithmic trading errors, false signals, data poisoning) produces sudden, large orders and misinformation cascades in commodity markets, driving short-term spikes and greater volatility in energy prices." />
