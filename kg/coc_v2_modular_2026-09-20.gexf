          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An increase in sanction_pressure (coordinated asset freezes, transaction bans and trade restrictions) directly restricts targeted entities' access to the international banking and payments system, reducing net cross‑border capital flows as funds are frozen, blocked or rerouted." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_rate_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanction_pressure" target="mid_east_energy_shock::crude_oil_supply_availab" id="207">
