          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Expansion or tightening of multilateral sanctions and secondary‑sanctions risk around Russian oil exports directly removes barrels from accessible global markets and deters buyers, reducing aggregate crude availability for immediate trade." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="mid_east_energy_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
