          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="When Western governments and firms materially diversify supply chains away from China, the reduced economic exposure lowers political risk of Chinese retaliation and makes governments more willing to impose or tighten coordinated trade and financial sanctions on Russia." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
