          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising maritime threats in Middle Eastern chokepoints force allied navies, airlift and escort resources to be reassigned to protect commercial traffic and regional partners, reducing the available lift, convoy protection and logistics throughput for weapons and equipment deliveries to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_energy_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
