          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A meaningful increase in advanced chip fabrication capacity eases semiconductor supply constraints, reducing projected goods-price pressures and precautionary term premia, which exerts downward pressure on longer-maturity nominal yields." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_rivalry" />
          <attvalue for="38" value="global_rate_repricing" />
          <attvalue for="27" value="0" />
