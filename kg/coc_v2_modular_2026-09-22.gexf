      <edge source="russia_ukraine_war::allied_coord_strength" target="iran_gulf_escalation::state_military_response_" id="101">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger allied operational coordination and deployments to support Ukraine reallocate Western naval and air assets to Europe, reducing available forces and political willingness to conduct or scale high‑intensity military responses in the Gulf, thereby lowering state response intensity." />
