        </attvalues>
      </edge>
      <edge source="energy_supply_shock::fuel_price_level" target="ai_governance_militar::deployment_rate" id="525">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained rises in liquid fuel prices raise operational costs for military platforms and logistics, incentivizing defence services and contractors to accelerate deployment of AI-driven optimization/autonomy (route planning, fuel-saving autonomy, logistics automation) to cut fuel consumption." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="energy_supply_shock" />
          <attvalue for="38" value="ai_governance_militar" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shock::fuel_price_level" target="iran_gulf_escalation::state_military_response_" id="526">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp upward movements in fuel prices create political pressure and strategic urgency for governments to secure supply lines, prompting more intensive state-led protection, patrols, and retaliatory operations in the Gulf." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shock" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shock::fuel_price_level" target="russia_ukraine_war::allied_coord_strength" id="527">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp rises in fuel prices create shared economic and operational pressures that prompt coordinated allied policy responses (e.g., price caps, joint procurement, pooled logistics and releases from reserves) to stabilize supplies for the conflict theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shock::fuel_price_level" target="us_china_trade_tech::political_pressure" id="528">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rapid rises in retail and industrial fuel prices increase inflation and visible economic pain for voters and firms, producing immediate domestic pressure on policymakers to adopt protectionist or security-first measures in trade and technology negotiations with China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_supply_shock" />
          <attvalue for="38" value="us_china_trade_tech" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_shock::fuel_price_level" target="us_china_trade_tech::tech_decoupling_degree" id="529">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Prolonged high fuel prices raise the strategic priority of reducing external energy and supply-chain exposure, accelerating industrial policies (subsidies, localization mandates and selective restrictions) that deepen technological ecosystem fragmentation between the US and China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="energy_supply_shock" />
          <attvalue for="38" value="us_china_trade_tech" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
