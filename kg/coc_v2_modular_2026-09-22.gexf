      <edge source="us_china_trade_tech::export_control_level" target="ai_governance_militar::model_capability_level" id="300">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter export controls legally block shipments of high-end accelerators, training hardware and specialized design tools, directly reducing the training throughput and peak scale of models available to affected developers." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_tech" />
          <attvalue for="38" value="ai_governance_militar" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_trade_tech::export_control_level" target="ai_governance_militar::cyberattack_frequency" id="301">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="When legal transfer channels are restricted, state and non‑state actors have stronger incentives to pursue illicit acquisition via cyberespionage and supply‑chain intrusion, raising successful attacks against AI infrastructure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_trade_tech" />
          <attvalue for="38" value="ai_governance_militar" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_trade_tech::export_control_level" target="energy_supply_shock::refinery_throughput_rate" id="302">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter export controls on specialized refinery catalysts, control electronics and spare parts reduce import-dependent refineries' ability to maintain and replace critical components, causing measurable declines in processing rates as inventories of spares are exhausted." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_tech" />
          <attvalue for="38" value="energy_supply_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_trade_tech::export_control_level" target="iran_gulf_escalation::maritime_trade_disruptio" id="303">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tightened US export controls on dual‑use maritime and aerospace technologies incentivize China to deepen security ties and expedite transfers of asymmetric maritime capabilities to partners like Iran, raising incidents of harassment, interdiction and risk to commercial shipping in Gulf sea lanes." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_tech" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_trade_tech::export_control_level" target="russia_ukraine_war::military_ops_intensity" id="304">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter export controls on advanced semiconductors and sensors reduce availability of critical components that would otherwise be re-exported or procured for Russian guided munitions, drones and ISR systems, degrading Russia's ability to sustain high-tempo operations." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_trade_tech" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
