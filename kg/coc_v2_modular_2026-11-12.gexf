          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Interruptions to Russian crude and gas flows tighten global balances and raise market perceptions of supply fragility, prompting traders and consumers to add a larger geopolitical risk premium to energy prices that also reflects higher Gulf transit and supply risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_maritime_tensi" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
