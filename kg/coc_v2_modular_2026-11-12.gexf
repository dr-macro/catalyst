          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher corporate cost pressure (from supply disruptions, retooling, or energy shocks) raises default and funding stress in the corporate sector, widening credit and liquidity premia and spilling over into higher sovereign 10‑year yields as investors demand greater compensation." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="euro_security_realignmen" />
          <attvalue for="38" value="global_monetary_tighteni" />
