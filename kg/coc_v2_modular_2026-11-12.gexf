      <edge source="iran_gulf_maritime_tensi::energy_market_risk_premi" target="euro_security_realignmen::layoff_rate" id="409">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A higher geopolitical risk premium raises energy input costs and borrowing costs for energy‑intensive European firms, squeezing margins and prompting short‑term workforce reductions to preserve cash." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="euro_security_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_maritime_tensi::energy_market_risk_premi" target="global_monetary_tighteni::monetary_policy_expect" id="410">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="An increased geopolitical risk premium in energy markets leads market participants to price a higher probability of sustained inflation or supply shocks, shifting market-implied paths toward earlier or larger central-bank policy tightening." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_maritime_tensi::energy_market_risk_premi" target="us_china_tech_rivalry::policy_change_momentum" id="411">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in the geopolitical risk premium for energy markets creates acute economic-security pressure that accelerates domestic regulatory agendas (investment screening, export controls, industrial policy) related to critical technologies, increasing the rate at which new tech‑governance measures are proposed and advanced." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_maritime_tensi::crude_price_level" target="iran_gulf_maritime_tensi::domestic_political_press" id="412">
