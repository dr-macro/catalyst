          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sustained energy shortages and higher fuel/utility bills lead energy‑intensive and margin‑squeezed firms to delay investment and recruitment, producing an observable drop in hiring in affected sectors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="euro_security_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
