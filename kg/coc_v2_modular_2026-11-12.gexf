      <edge source="global_monetary_tighteni::policy_rate_level" target="euro_security_realignmen::corporate_cost_pressure" id="562">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An increase in policy rates raises short‑term borrowing and rollover costs for firms (and the cost of floating‑rate debt), directly increasing interest expense and compressing operating margins and cost pressures within months." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_monetary_tighteni" />
          <attvalue for="38" value="euro_security_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_tighteni::policy_rate_level" target="iran_gulf_maritime_tensi::asymmetric_attack_rate" id="563">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in policy rates (particularly US rates) tightens dollar liquidity and raises Tehran's cost of access to finance and trade, incentivizing Iran to escalate asymmetric maritime attacks and sabotage to extract leverage and revenue amid financing stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_monetary_tighteni" />
          <attvalue for="38" value="iran_gulf_maritime_tensi" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_tighteni::policy_rate_level" target="russia_ukraine_war::military_logistics_flow" id="564">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher policy rates raise sovereign and commercial borrowing costs for governments, defense contractors and freight operators, constraining working capital and slowing procurement and transport of fuel, munitions and spare parts to front-line units." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_monetary_tighteni" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_tighteni::policy_rate_level" target="us_china_tech_rivalry::capital_flow_into_ai" id="565">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher policy rates raise discount rates and borrowing costs, reducing valuations and venture/debt financing for high‑growth, long‑dated AI firms and directly curbing capital allocations into the AI sector." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_monetary_tighteni" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
