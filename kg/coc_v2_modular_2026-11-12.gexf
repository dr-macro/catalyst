          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sustained energy-price shocks increase market-implied odds of near-term central-bank tightening as investors price a higher probability of policy responses to contain inflation pressure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
        </attvalues>
