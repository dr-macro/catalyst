      <edge source="iran_gulf_maritime_tensi::shipping_disruption_seve" target="russia_ukraine_war::military_logistics_flow" id="431">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Severe interruptions to maritime transit (route closures, port delays, higher insurance and rerouting) directly slow or reduce sea shipments of heavy equipment, munitions and fuel destined for Ukraine, degrading military logistics throughput and timeliness." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_maritime_tensi::shipping_disruption_seve" target="us_china_tech_rivalry::reg_scrutiny_tech" id="432">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Severe interruptions to commercial maritime traffic prompt policymakers in the US and allies to broaden and intensify export controls and licensing scrutiny on maritime comms, navigation, and dual‑use components—particularly transfers tied to Chinese firms—raising regulatory oversight of technology transfers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
