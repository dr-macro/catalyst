      <edge source="us_china_tech_rivalry::reg_scrutiny_tech" target="euro_security_realignmen::corporate_cost_pressure" id="43">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Heightened regulatory scrutiny (export controls, licensing, required audits and supply‑chain reconfiguration) raises compliance, legal and sourcing costs for firms, directly increasing aggregate corporate cost pressure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="euro_security_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::reg_scrutiny_tech" target="euro_security_realignmen::hiring_rate" id="44">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="1" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Immediate uncertainty and project delays from stricter transfer rules and approval processes lead firms to pause or slow hiring for cross‑border R&amp;D and specialized tech roles, reducing hiring rates." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="euro_security_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::reg_scrutiny_tech" target="global_monetary_tighteni::cross_border_flows" id="45">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter export controls and enhanced vetting increase compliance costs and legal/operational barriers for foreign investors and cross‑border transactions in tech sectors, causing a near‑term pullback in net international capital flows into affected firms and jurisdictions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::reg_scrutiny_tech" target="iran_gulf_maritime_tensi::asymmetric_attack_rate" id="46">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter export controls spur suppliers and intermediaries to route dual‑use components and finished drone/missile electronics to Iran through covert/third‑party channels, accelerating Iranian proxy procurement and increasing the tempo of asymmetric maritime attacks." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="iran_gulf_maritime_tensi" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::reg_scrutiny_tech" target="russia_ukraine_war::military_logistics_flow" id="47">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter export controls and vetting on advanced components (e.g., semiconductors, sensors) in the context of US–China tech scrutiny reduce the availability of dual‑use parts routed through third parties to Russia, degrading spare‑parts throughput and sustainment of Russian field logistics." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
