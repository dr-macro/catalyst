      <edge source="iran_gulf_maritime_tensi::asymmetric_attack_rate" target="global_monetary_tighteni::cross_border_flows" id="396">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A surge in asymmetric attacks raises perceived political and operational risk for investors with regional exposure, triggering rapid portfolio withdrawals and reduced new capital commitments into affected jurisdictions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
