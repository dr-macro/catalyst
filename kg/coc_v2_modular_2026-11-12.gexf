      <edge source="iran_gulf_maritime_tensi::asymmetric_attack_rate" target="euro_security_realignmen::hiring_rate" id="395">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in missile/drone/sabotage incidents raises operational and security uncertainty for Europe‑exposed logistics, shipping and energy firms, leading them to pause expansion hiring and freeze new roles for at‑risk operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="euro_security_realignmen" />
