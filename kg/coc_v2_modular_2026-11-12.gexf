      <edge source="iran_gulf_maritime_tensi::shipping_disruption_seve" target="euro_security_realignmen::corporate_cost_pressure" id="429">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Route closures, port delays and rerouting drive up freight, inventory carrying and just‑in‑time breakdown costs for European manufacturers and retailers, directly raising their operating cost pressure." />
          <attvalue for="36" value="0-6 months" />
