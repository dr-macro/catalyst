      <edge source="euro_security_realignmen::corporate_cost_pressure" target="global_monetary_tighteni::cross_border_flows" id="694">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Sustained margin compression and profitability shocks in the corporate sector reduce foreign investor appetite for regional equities and credit, triggering net portfolio outflows from the affected markets." />
          <attvalue for="36" value="3-12 months" />
          <attvalue for="37" value="euro_security_realignmen" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
