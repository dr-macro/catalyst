      <edge source="euro_security_realignmen::corporate_cost_pressure" target="iran_gulf_maritime_tensi::asymmetric_attack_rate" id="695">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising cost pressures prompt commercial shipowners and energy firms to cut spending on armed guards, convoy fees and vulnerability-reduction measures for Gulf transits, increasing the pool of softer targets and therefore the rate of asymmetric attacks on ships and facilities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="euro_security_realignmen" />
          <attvalue for="38" value="iran_gulf_maritime_tensi" />
