          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Interruptions to oil and natural gas exports raise wholesale energy and transport costs that flow directly into headline consumer prices (fuel, heating, electricity and goods transport), lifting CPI." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="global_monetary_tighteni::monetary_policy_expect" id="252">
        <attvalues>
