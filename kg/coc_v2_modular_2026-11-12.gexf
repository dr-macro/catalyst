      <edge source="iran_gulf_maritime_tensi::energy_market_risk_premi" target="iran_gulf_maritime_tensi::market_expectations_conf" id="408">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="3" />
