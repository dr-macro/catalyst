      <edge source="russia_ukraine_war::energy_supply_disruption" target="euro_security_realignmen::corporate_cost_pressure" id="249">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Interruptions and capacity reductions in Russian gas and oil deliveries raise wholesale energy and transport prices across Europe, directly increasing firms' input and operating costs and forcing stronger cost-cutting pressure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="euro_security_realignmen" />
