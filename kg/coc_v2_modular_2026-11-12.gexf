        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened corporate losses and insurance/route-cost shocks produce concentrated lobbying from major European shipping, energy and trade firms that forces governments to increase high‑level diplomatic outreach and de‑escalation efforts with Gulf states and Iran to protect commercial flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="euro_security_realignmen" />
          <attvalue for="38" value="iran_gulf_maritime_tensi" />
          <attvalue for="27" value="0" />
