      <edge source="russia_ukraine_war::security_coordination" target="euro_security_realignmen::hiring_rate" id="270">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Deeper EU/NATO security coordination triggers expanded joint procurement and national rearmament plans that create new orders for defense and dual‑use manufacturers, prompting hiring spikes in those industries as firms scale production." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="euro_security_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_coordination" target="global_monetary_tighteni::cross_border_flows" id="271">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter allied security coordination (sanctions, joint defense posture and trade restrictions) reallocates private and official capital toward perceived safe‑haven jurisdictions and away from geopolitically exposed emerging markets, reducing net cross‑border inflows into those markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_coordination" target="iran_gulf_maritime_tensi::diplomatic_engagement_le" id="272">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified security coordination among the US and European allies over the Russia war produces coordinated risk‑management imperatives that lead to parallel diplomatic outreach (bilateral and mediated channels via regional interlocutors) toward Gulf states and Iran to defuse maritime tensions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_maritime_tensi" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
