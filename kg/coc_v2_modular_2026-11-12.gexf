      <edge source="global_monetary_tighteni::cross_border_flows" target="euro_security_realignmen::labor_market_tightness" id="619">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increase in cross‑border capital inflows (FDI and portfolio funding) supports business expansion and vacancy creation in recipient economies, tightening the labor market (more vacancies per worker) over the medium term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_monetary_tighteni" />
          <attvalue for="38" value="euro_security_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_tighteni::cross_border_flows" target="iran_gulf_maritime_tensi::shipping_disruption_seve" id="620">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Sharp cross‑border capital outflows reduce available credit for shipowners, ports and insurers in the Gulf, causing idled vessels, reduced security patrols and rerouting that materially increase the severity of shipping disruptions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_monetary_tighteni" />
          <attvalue for="38" value="iran_gulf_maritime_tensi" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_tighteni::cross_border_flows" target="russia_ukraine_war::military_logistics_flow" id="621">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sudden reduction in cross-border capital and FX flows impairs suppliers' ability to pay for imported components, credit lines and logistics services denominated in hard currency, directly disrupting deliveries of ammunition, parts and fuel to operations in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_monetary_tighteni" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_tighteni::cross_border_flows" target="us_china_tech_rivalry::reg_scrutiny_tech" id="622">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A surge in inbound cross‑border investment—especially from state‑linked or geopolitically sensitive investors—creates political attention and provokes national‑security reviews, increasing regulatory scrutiny of technology transfers and acquisitions." />
          <attvalue for="36" value="0-12 months" />
          <attvalue for="37" value="global_monetary_tighteni" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
