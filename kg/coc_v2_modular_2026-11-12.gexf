          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Actual reductions or delays in Russian crude and refined product availability tighten global supply/demand balances and directly push up benchmark crude prices (spot and near‑term futures), which transmit into Gulf market price levels." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_maritime_tensi" />
          <attvalue for="27" value="0" />
