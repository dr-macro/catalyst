      <edge source="iran_gulf_maritime_tensi::asymmetric_attack_rate" target="russia_ukraine_war::security_coordination" id="397">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in asymmetric attacks against shipping raises shared threat perceptions among NATO and partner navies, prompting more frequent joint planning, intelligence‑sharing and synchronized force posture decisions that increase overall security policy coordination relevant to the Russia–Ukraine theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="russia_ukraine_war" />
