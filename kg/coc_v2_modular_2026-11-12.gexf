          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Increased security alignment among the US and allies in response to the war produces coordinated export‑control lists and joint screening of vendors, directly expanding regulatory scrutiny of cross‑border tech transfers involving China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
