          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Evidence that missiles/drones/sabotage used in asymmetric maritime attacks incorporate Chinese-origin components or supply-chain links provokes US accusations of proliferation/indirect support and precipitates escalatory tech-focused diplomatic and sanction actions versus China, raising interstate technology tensions." />
          <attvalue for="36" value="0-6 months" />
