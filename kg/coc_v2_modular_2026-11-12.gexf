      <edge source="iran_gulf_maritime_tensi::crude_price_level" target="euro_security_realignmen::wage_growth_rate" id="414">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained higher crude prices feed through into consumer prices and inflation expectations, prompting workers and unions to press for higher nominal wages in upcoming negotiation cycles." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="euro_security_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_maritime_tensi::crude_price_level" target="global_monetary_tighteni::cpi_inflation_rate" id="415">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Higher crude prices directly raise transport and heating fuel costs and raise production costs for a broad set of goods and services, producing measurable upward pressure on headline CPI within a few months." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_maritime_tensi::crude_price_level" target="russia_ukraine_war::military_logistics_flow" id="416">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sustained higher global crude prices increase Russian export revenues and foreign‑exchange receipts, enabling Moscow to finance procurement, logistics contracts and fuel purchases that directly raise the throughput and reliability of supplies to forces in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_maritime_tensi::crude_price_level" target="us_china_tech_rivalry::capital_flow_into_ai" id="417">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="1" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Higher crude prices expand fiscal surpluses and liquidity for oil‑exporters and sovereign wealth funds in the Gulf, which in turn redeploy a portion of increased capital into strategic, revenue‑diversifying investments including AI firms and infrastructure, lifting net capital flows into the AI sector." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
