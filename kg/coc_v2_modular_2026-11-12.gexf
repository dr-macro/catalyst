          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Marked disruptions to maritime transit increase delivery times and freight costs for consumer goods and inputs, which firms pass through to retail prices, raising headline consumer inflation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_maritime_tensi" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="27" value="0" />
        </attvalues>
