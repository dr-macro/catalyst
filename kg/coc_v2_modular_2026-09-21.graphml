<edge source="us_china_strategic_rival::security_tension" target="ai_tech_power_shift::regulatory_action_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Spikes in strategic or military friction prompt governments to initiate national‑security reviews, emergency controls and new oversight measures for AI capabilities perceived as dual‑use, increasing the tempo of formal regulatory interventions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">ai_tech_power_shift</data>
</edge>
<edge source="us_china_strategic_rival::security_tension" target="global_monetary_tighteni::gov_bond_yield_curve" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Spikes in bilateral military or incident risk trigger flight‑to‑quality capital flows into core sovereign debt, mechanically bidding up bond prices and lowering yields across the curve.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">global_monetary_tighteni</data>
</edge>
<edge source="us_china_strategic_rival::security_tension" target="iran_gulf_offensive::conflict_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising US–China security tensions push Beijing to deepen political, intelligence and military cooperation with Tehran (diplomatic cover, arms transfers, and naval coordination), which emboldens Iran to increase offensive operations in the Gulf against perceived Western targets, raising the frequency and severity of kinetic engagements.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">iran_gulf_offensive</data>
</edge>
<edge source="us_china_strategic_rival::security_tension" target="russia_west_confrontatio::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Rising U.S.–China security tension reallocates U.S. diplomatic and military attention toward the Indo‑Pacific, causing European allies to question U.S. capacity and commitment to European deterrence and thereby weakening unity and burden‑sharing on Russia policy.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">russia_west_confrontatio</data>
</edge>
