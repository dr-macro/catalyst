<edge source="iran_gulf_offensive::conflict_intensity" target="ai_tech_power_shift::regulatory_action_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A spike in conflict intensity drives governments to enact urgent national‑security measures—export controls, sanctions, and expedited oversight—that increase the tempo and intensity of regulatory interventions targeting AI.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_offensive</data>
  <data key="d40">ai_tech_power_shift</data>
</edge>
<edge source="iran_gulf_offensive::conflict_intensity" target="global_monetary_tighteni::investor_risk_appetite" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising conflict intensity raises immediate geopolitical risk perceptions and triggers risk‑off portfolio rebalancing (flight to cash/sovereigns and deleveraging), directly lowering aggregate investor willingness to hold risky assets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_offensive</data>
  <data key="d40">global_monetary_tighteni</data>
</edge>
<edge source="iran_gulf_offensive::conflict_intensity" target="russia_west_confrontatio::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A spike in kinetic intensity in the Gulf forces the US to reallocate naval/air assets and political attention to the region, producing transatlantic friction over priorities and thereby weakening unity on coordinated policy toward Russia.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_offensive</data>
  <data key="d40">russia_west_confrontatio</data>
</edge>
<edge source="iran_gulf_offensive::conflict_intensity" target="us_china_strategic_rival::security_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A spike in kinetic attacks prompts increased U.S. and allied force posture and contingency planning in the Gulf and draws reciprocal Chinese patrols/diplomatic protests, producing more frequent high‑risk military encounters and strategic friction between Washington and Beijing.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_offensive</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
