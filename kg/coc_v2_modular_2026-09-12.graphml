  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A surge in weapons and drone shipments increases near‑term demand for specialized semiconductors, sensors and control SoCs used in munitions and ISR kits, tightening niche chip and memory supply lines used also by commercial AI vendors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
