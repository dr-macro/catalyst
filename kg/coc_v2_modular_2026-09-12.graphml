  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A faster pace of new trade measures raises policy uncertainty and forces frequent repricing of cross-border credit risk and sovereign spreads, directly increasing realized and implied volatility in global bond markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_economic_statecraft</data>
  <data key="d39">global_bond_monetary_str</data>
</edge>
<edge source="us_economic_statecraft::policy_escalation_rate" target="gulf_redsea_shipping::military_escalation_inte" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A rapid increase in US trade/sanctions measures prompts retaliatory kinetic actions or proxy strikes by targeted states and groups against shipping and energy infrastructure in the Gulf/Red Sea, raising the tempo and severity of military incidents.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_economic_statecraft</data>
  <data key="d39">gulf_redsea_shipping</data>
</edge>
<edge source="us_economic_statecraft::policy_escalation_rate" target="russia_ukraine_war::diplomatic_momentum" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.8</data>
  <data key="d36">A rapid cadence of new sanctions and trade measures hardens negotiating positions and raises political costs for compromise, interrupting sustained high‑level mediation, backchannel engagement, and the continuity of institutional diplomacy.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_economic_statecraft</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_economic_statecraft::policy_escalation_rate" target="us_china_tech_trade::regulatory_scrutiny" id="0">
