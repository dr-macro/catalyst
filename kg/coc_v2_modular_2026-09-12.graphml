</edge>
<edge source="russia_ukraine_war::arms_transfer_flow" target="gulf_redsea_shipping::military_escalation_inte" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher volumes of arms transfers from Russia or third parties to regional states and militias expand their anti-ship and naval strike capabilities, enabling more kinetic operations against maritime and energy infrastructure in Gulf/Red Sea littorals.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">gulf_redsea_shipping</data>
</edge>
<edge source="russia_ukraine_war::arms_transfer_flow" target="us_china_tech_trade::chip_supply_constraint" id="0">
