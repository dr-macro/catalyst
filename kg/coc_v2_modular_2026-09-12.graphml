<edge source="russia_ukraine_war::arms_transfer_flow" target="global_bond_monetary_str::long_term_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained higher volumes of externally financed arms transfers and military aid increase donor government and allied sovereign issuance or perceived fiscal needs, raising supply and risk premia on long‑dated government bonds.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
