<edge source="us_economic_statecraft::supply_chain_disruption" target="global_bond_monetary_str::long_term_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Acute interruptions to intermediate goods and logistics increase near-term and persistent inflation expectations and commodity-price pass-through, causing investors to demand higher yields on long-dated sovereign debt.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_economic_statecraft</data>
  <data key="d39">global_bond_monetary_str</data>
</edge>
<edge source="us_economic_statecraft::supply_chain_disruption" target="gulf_redsea_shipping::shipping_traffic_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Severe interruptions to intermediate goods flows and logistics increase cancellations, delays and route avoidance by carriers, directly reducing commercial transit volumes through Gulf/Red Sea routes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_economic_statecraft</data>
  <data key="d39">gulf_redsea_shipping</data>
</edge>
