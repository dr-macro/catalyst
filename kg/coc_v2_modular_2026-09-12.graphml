<edge source="global_bond_monetary_str::long_term_yield" target="us_china_tech_trade::investment_into_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising long-term sovereign yields raise discount rates and increase the cost of capital for VC and corporate R&amp;D, prompting reduced deal activity and slower funding into AI startups and projects.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_monetary_str</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
