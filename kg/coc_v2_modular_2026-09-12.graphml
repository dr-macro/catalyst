<edge source="global_bond_monetary_str::long_term_yield" target="russia_ukraine_war::strike_proliferation_rat" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising long-term yields increase the cost of capital for defense firms and buyers, slowing factory expansions, procurement contracts, and supply-chain investment that would otherwise raise the production and distribution rate of advanced strike systems.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_bond_monetary_str</data>
