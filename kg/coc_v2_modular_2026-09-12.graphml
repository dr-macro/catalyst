<edge source="us_china_tech_trade::regulatory_scrutiny" target="global_bond_monetary_str::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">New export controls, investment-screening rules and sanctions between the US and China directly curtail outbound/inbound tech transactions and portfolio allocations, causing an immediate drop in cross-border capital flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_trade</data>
  <data key="d39">global_bond_monetary_str</data>
</edge>
<edge source="us_china_tech_trade::regulatory_scrutiny" target="gulf_redsea_shipping::shipping_traffic_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A sudden intensification of export controls and customs enforcement on US–China tech trade increases inspections, paperwork and forced rerouting of container and transshipment traffic, slowing throughput and reducing volumetric shipping flow through Gulf/Red Sea routes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_trade</data>
  <data key="d39">gulf_redsea_shipping</data>
</edge>
