      <edge source="russia_ukraine_energy::strike_intensity" target="global_monetary_stress::bond_yield_levels" id="743">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An increase in strike intensity raises perceived sovereign and corporate risk (higher default/operational risk and insurance costs), prompting investors to demand larger risk premia and pushing benchmark bond yields up." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
