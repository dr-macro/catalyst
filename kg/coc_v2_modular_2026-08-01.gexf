      <edge source="russia_ukraine_energy::energy_price_volatility" target="maritime_chokepoints::insurance_premia_level" id="805">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Larger and more frequent swings in regional energy prices raise potential loss exposure for cargoes and owners, leading underwriters to widen war-risk and hull/cargo premia for vessels transiting high-risk chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="maritime_chokepoints" />
          <attvalue for="28" value="0" />
