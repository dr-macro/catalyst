      <edge source="russia_ukraine_energy::energy_price_volatility" target="global_monetary_stress::implied_policy_path" id="804">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising volatility in energy prices increases inflation uncertainty and risk premia, causing markets to reprice and imply a higher/earlier future policy-rate path to guard against upside inflation risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="global_monetary_stress" />
