      <edge source="maritime_chokepoints::insurance_premia_level" target="global_monetary_stress::bond_yield_levels" id="276">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rapid rise in insurance premia and war-risk surcharges raises perceived sovereign and corporate financing risk for countries and firms reliant on maritime trade, prompting investors to demand higher yields on sovereign and benchmark bonds." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="maritime_chokepoints" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
