      <edge source="russia_ukraine_energy::strike_intensity" target="maritime_chokepoints::military_response" id="744">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.78" />
          <attvalue for="36" value="An increase in kinetic and asymmetric strikes on energy and logistical nodes prompts coastal states and naval actors to escalate patrols, convoy escorts and interdiction operations to secure chokepoints and shipping." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="maritime_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_energy::strike_intensity" target="us_china_tech_rivalry::capital_investment_flow" id="745">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rise in targeted strikes on energy and transport infrastructure increases perceived geopolitical vulnerability of cross‑border compute and data infrastructure, prompting governments and strategic investors to accelerate and direct new capital into domestic/ally AI compute projects as a resilience priority." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_energy::strike_intensity" target="us_iran_confront::maritime_security_level" id="746">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sustained high-intensity strikes on coastal export terminals and logistics nodes redirect commercial energy traffic onto longer routes that traverse Iranian-contested waters, increasing incidents and lowering overall maritime security." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="us_iran_confront" />
          <attvalue for="28" value="0" />
