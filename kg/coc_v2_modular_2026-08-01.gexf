          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater functional access to key chokepoints lowers shipping costs and trade frictions, improving trade balances for transit-dependent economies and supporting appreciation of their currencies." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
