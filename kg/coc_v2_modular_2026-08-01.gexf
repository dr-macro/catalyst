      <edge source="us_iran_confront::maritime_security_level" target="global_monetary_stress::crossborder_capital" id="29">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Improved maritime security reduces transport risk and insurance premia for trade-exposed firms and raises investor confidence in regional trade-dependent assets, attracting net cross-border capital inflows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::maritime_security_level" target="maritime_chokepoints::maritime_transit_flow" id="30">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Visible improvements in naval escorts, patrols and interdiction success reduce the risk of interdiction and attacks, prompting carriers and shippers to resume primary routes and raising transit volumes through chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="maritime_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::maritime_security_level" target="maritime_chokepoints::insurance_premia_level" id="31">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained reductions in incident frequency and demonstrable security measures lead insurers to lower war-risk surcharges and overall premiums for vessels operating in the affected sea lanes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="maritime_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::maritime_security_level" target="us_china_tech_rivalry::chip_supply_pressure" id="32">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An increase in maritime_security_level (fewer hostile incidents) reduces insurance costs, rerouting and port delays for semiconductor and memory shipments, thereby lowering chip and memory supply pressure within affected supply chains." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
