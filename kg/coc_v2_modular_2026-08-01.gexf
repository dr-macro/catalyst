          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising war‑risk and transport insurance premia raise upfront and operating costs for building/operating data centers and fabs, eroding project returns and prompting investors to delay, scale back, or reallocate planned AI compute capital." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="maritime_chokepoints" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
