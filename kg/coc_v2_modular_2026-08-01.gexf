      <edge source="us_china_tech_rivalry::geopolitical_tech_tensio" target="global_monetary_stress::crossborder_capital" id="504">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalating tech tensions trigger export controls, sanctions and corporate de‑risking that directly block or deter cross-border M&amp;A, VC and portfolio flows into affected technology sectors and jurisdictions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tech_tensio" target="global_monetary_stress::implied_policy_path" id="505">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp increases in tech-related trade barriers and uncertainty lower near-term growth and profit projections, leading markets to price an earlier or larger easing of central-bank policy rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tech_tensio" target="maritime_chokepoints::military_response" id="506">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising US–China technology tensions prompt more frequent naval deployments, convoy escorts, and interdiction patrols around strategic chokepoints as states signal deterrence and protect commercial traffic." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="maritime_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tech_tensio" target="russia_ukraine_energy::strike_intensity" id="507">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating US–China technology rivalry prompts China to accelerate provision of alternative surveillance, comms and drone components to Russia (as a strategic hedge), enabling Russia to sustain or increase tempo and precision of strikes in Ukraine." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_energy" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tech_tensio" target="russia_ukraine_energy::shipping_throughput" id="508">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher tech rivalry increases sanctions, port inspections and interdictions on shipments suspected of carrying dual‑use tech bound for sanctioned recipients, creating delays and reducing throughput on key regional maritime corridors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_energy" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tech_tensio" target="us_iran_confront::military_tempo" id="509">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in US–China technology tensions prompts the US to surge naval and air deployments, forward-base rotations, and joint exercises with Gulf partners to protect tech supply lines and facilities, which provokes Iranian asymmetric responses and raises the rate of regional military operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="us_iran_confront" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tech_tensio" target="us_iran_confront::maritime_security_level" id="510">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Intensifying tech rivalry produces tighter export controls and more aggressive interdiction of shipments suspected of supporting rival tech programs, increasing encounters, boarding incidents and retaliatory Iranian harassment that reduce overall maritime security in regional sea lanes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="us_iran_confront" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
