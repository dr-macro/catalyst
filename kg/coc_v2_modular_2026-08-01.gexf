      <edge source="russia_ukraine_energy::infrastructure_capacity" target="us_iran_confront::military_tempo" id="756">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Losses in European/Black Sea export and transit capacity compel allied requests for protection of alternative sea routes and emergency escort operations, which—when capacity is reduced—raise US/partner operational tempo in the Gulf and adjacent areas." />
