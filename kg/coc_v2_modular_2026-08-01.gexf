          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rapid depreciation of importers' currencies (or sharp USD appreciation) raises local import and bunker costs, prompting importers and shippers to cut orders and sailings, reducing commercial traffic through key chokepoints." />
