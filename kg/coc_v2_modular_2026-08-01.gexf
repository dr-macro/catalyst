          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising war-risk and hull insurance premia raise marginal transport costs and increase delivery uncertainty, prompting abrupt rerouting, spot-market adjustments and hedging flows that amplify short-term energy-price swings." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="maritime_chokepoints" />
          <attvalue for="39" value="russia_ukraine_energy" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
