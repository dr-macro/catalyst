          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Large, rapid swings in regional energy prices raise operating costs and forced curtailments at energy‑intensive semiconductor fabs and memory production, degrading output reliability and tightening chip and memory availability for global supply chains." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="us_china_tech_rivalry" />
