          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Depreciation of regional/local currencies against major currencies (i.e., a rise in FX measures showing local weakness) raises the local currency cost of imported refined fuels and credit for importers, causing immediate cutbacks or delayed imports and lower available fuel volumes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_stress" />
          <attvalue for="39" value="russia_ukraine_energy" />
