      <edge source="russia_ukraine_energy::fuel_supply_level" target="global_monetary_stress::monetary_policy_stance" id="761">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher fuel supply availability reduces headline energy inflation pressure and lowers near-term inflation risk, enabling central banks to adopt a less-tight (lower degree of tightening) monetary policy stance." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="global_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_energy::fuel_supply_level" target="maritime_chokepoints::energy_export_flow" id="762">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A fall in regional fuel availability (refined products and feedstock) reduces volumes available for shipment from production and processing hubs, directly lowering export loadings through nearby chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="maritime_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_energy::fuel_supply_level" target="us_china_tech_rivalry::geopolitical_tech_tensio" id="763">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained regional fuel shortfalls drive closer energy and strategic coordination between Russia and importing states (including deeper energy/industrial ties with China), provoking U.S. countermeasures and export controls that raise bilateral technology and supply‑chain tensions." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_energy::fuel_supply_level" target="us_iran_confront::tanker_transit_flow" id="764">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Acute drops in regional refined-fuel availability from Russia/Europe force importers to source product shipments from Middle Eastern suppliers, raising the number of crude/refined tankers departing the Gulf and transiting chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_energy" />
          <attvalue for="39" value="us_iran_confront" />
