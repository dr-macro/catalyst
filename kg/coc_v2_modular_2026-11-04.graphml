<edge source="russia_ukraine_war::oil_price_level" target="global_energy_supply_sho::compute_energy_demand_ra" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained increases in crude prices raise fuel and electricity generation costs for data centres and miners, prompting service providers to throttle non‑essential compute growth and delay capacity expansion, reducing the compute energy demand growth rate.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="russia_ukraine_war::oil_price_level" target="us_iran_conflict::energy_supply_shock" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Higher oil prices driven by shocks in the Russia–Ukraine war reduce spare global capacity and raise the economic payoff of sanctions‑evasion and risky tanker operations, increasing the probability and magnitude of Iran‑regional disruptions that produce localized energy supply shocks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_iran_conflict</data>
</edge>
