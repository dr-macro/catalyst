<edge source="global_energy_supply_sho::geopolitical_tension_lev" target="us_china_tech_rivalry::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Rising geopolitical tensions tied to energy routes or suppliers prompt governments to tighten export controls, investment reviews and sector-specific enforcement (especially in tech), raising regulatory scrutiny of cross‑border tech activity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="global_energy_supply_sho::geopolitical_tension_lev" target="us_iran_conflict::geo_conflict_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">An uptick in systemic geopolitical tension raises the likelihood of escalatory signalling, miscalculation, and force-posturing between the U.S. and Iran, increasing the intensity and frequency of kinetic and diplomatic confrontations in the US–Iran theater.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">us_iran_conflict</data>
</edge>
<edge source="global_energy_supply_sho::geopolitical_tension_lev" target="us_political_realignment::regulatory_pressure_on_a" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising interstate tensions incentivize policymakers to impose export controls, screening, and tighter oversight of AI development and cross‑border data/tech flows to limit technology transfer and security risks, increasing regulatory pressure on AI actors.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">us_political_realignment</data>
</edge>
