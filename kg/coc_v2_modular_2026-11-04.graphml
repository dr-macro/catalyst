  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Stronger export controls and security reviews force firms to localize or replicate compute infrastructure domestically, directly increasing AI infrastructure investment to meet compliance and data‑sovereignty requirements.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="us_china_tech_rivalry::regulatory_scrutiny" target="russia_ukraine_war::sector_capital_realloc" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Tighter export controls and investment screening tied to the US–China tech rivalry prompt investors and funds to reduce exposure to targeted tech assets and reallocate capital into defense, energy and commodities sectors, increasing the observed rate of cross‑sector capital rotation relevant to the Russia–Ukraine war.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_rivalry::regulatory_scrutiny" target="us_iran_conflict::capital_allocation_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Heightened regulatory scrutiny and export controls tied to the tech rivalry prompt institutional investors and corporations to reallocate capital toward domestic security and defense-related spending (including firms providing Middle East capabilities), raising capital flows into conflict-relevant sectors.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">us_iran_conflict</data>
</edge>
<edge source="us_china_tech_rivalry::regulatory_scrutiny" target="us_political_realignment::regulatory_pressure_on_a" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A rise in high-profile regulatory reviews and enforcement actions in the tech sector translates into political momentum and regulatory proposals that target AI specifically, raising the intensity of AI-focused regulation.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">us_political_realignment</data>
</edge>
