<edge source="us_political_realignment::ai_compute_capacity" target="us_china_tech_rivalry::market_volatility_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">An expansion in accessible AI compute eases production bottlenecks and reduces uncertainty about growth prospects for AI-exposed firms (stabilizing earnings expectations), which dampens short-term asset price swings; conversely, sudden compute shortages increase volatility.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_political_realignment</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
