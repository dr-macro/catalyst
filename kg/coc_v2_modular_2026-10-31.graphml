  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A deterioration in diesel supply (shortage) raises energy and operational risk for data centers and logistics, reducing project cashflow projections and increasing lender/investor risk premia, thereby raising the effective cost of capital for AI firms.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
