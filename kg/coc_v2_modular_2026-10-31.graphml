  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="iran_gulf_standoff::maritime_oil_flow" target="iran_gulf_standoff::shipping_disruption" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="iran_gulf_standoff::maritime_oil_flow" target="eu_cohesion_crisis::energy_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A reduction in sea-borne oil and refined-product deliveries from Gulf routes (lower maritime_oil_flow) directly tightens physical supply to European refineries and fuel markets, pushing up regional energy prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">eu_cohesion_crisis</data>
</edge>
<edge source="iran_gulf_standoff::maritime_oil_flow" target="russia_ukraine_war::refinery_capacity_util" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A decline in maritime crude and product flows into key European and regional import hubs directly lowers feedstock availability, forcing refiners to cut throughput and reducing refinery capacity utilization relevant to supplies for the Russia–Ukraine theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_standoff::maritime_oil_flow" target="us_china_tech_rivalry::investor_sentiment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Reductions in oil flow through key sea lanes raise near‑term energy and input‑cost risk for manufacturers and cloud/compute operators, generating a more risk‑averse market stance and lowering investor sentiment for tech assets exposed to U.S.–China supply chains.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
