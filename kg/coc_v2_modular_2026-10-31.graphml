<edge source="eu_cohesion_crisis::energy_price_level" target="ai_economic_power_shift::compute_capacity_demand" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained rises in energy prices increase data‑centre operating costs, prompting cloud providers and large AI users to postpone capacity expansion and throttle nonessential training runs, directly lowering aggregate compute demand.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eu_cohesion_crisis</data>
  <data key="d39">ai_economic_power_shift</data>
</edge>
<edge source="eu_cohesion_crisis::energy_price_level" target="russia_ukraine_war::armed_conflict_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute increases in EU energy prices generate intense domestic political pressure to reduce economic pain, prompting governments to restrict arms shipments or pursue de-escalatory diplomatic steps that lower kinetic operations in the theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eu_cohesion_crisis</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="eu_cohesion_crisis::energy_price_level" target="us_china_tech_rivalry::supply_chain_resilience" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher energy prices driven by EU cohesion–related disruptions raise production and transport costs for intermediate electronics, causing factory slowdowns and routing frictions that immediately degrade the resilience of tech supply chains contested in the US–China rivalry.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eu_cohesion_crisis</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
