<edge source="iran_gulf_standoff::maritime_attack_rate" target="ai_economic_power_shift::capital_availability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained rise in maritime attacks heightens geopolitical risk and prompts cross-border investors and lenders to reprice or withdraw exposure to regional and open-ended technology funds, reducing the pool of deployable capital for AI projects.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">ai_economic_power_shift</data>
</edge>
<edge source="iran_gulf_standoff::maritime_attack_rate" target="eu_cohesion_crisis::fiscal_space" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in attacks on shipping raises immediate defence, maritime protection and targeted business-support spending and insurance subsidies by EU governments, constraining available fiscal headroom for other policies.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">eu_cohesion_crisis</data>
</edge>
<edge source="iran_gulf_standoff::maritime_attack_rate" target="russia_ukraine_war::armed_conflict_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A sustained uptick in Gulf maritime attacks will draw NATO/Western naval and air assets and political attention toward the Middle East, creating openings Russia can exploit to escalate operations in Ukraine or to pressure Kyiv while Western focus and resources are diverted.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_standoff::maritime_attack_rate" target="us_china_tech_rivalry::export_restriction_lvl" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A rise in attacks on vessels in the Gulf raises concerns about diversion, theft and dual‑use transfer routes, prompting U.S. regulators and security agencies to broaden or tighten export controls and blacklist authorities to reduce perceived leakages to adversaries.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="iran_gulf_standoff::maritime_oil_flow" target="iran_gulf_standoff::global_oil_balance" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_gulf_standoff::maritime_oil_flow" target="iran_gulf_standoff::oil_price_volatility" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
