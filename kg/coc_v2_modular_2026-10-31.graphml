<edge source="us_china_tech_rivalry::policy_enforce_int" target="ai_economic_power_shift::cost_of_capital" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sharper enforcement of tech and security policies raises compliance, licensing and legal risks for AI firms and prompts lenders and investors to demand higher spreads and returns, directly increasing firms' effective cost of capital.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">ai_economic_power_shift</data>
</edge>
<edge source="us_china_tech_rivalry::policy_enforce_int" target="eu_cohesion_crisis::market_confidence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A marked rise in enforcement actions and compliance checks increases regulatory uncertainty and operating costs for EU-headquartered multinationals with US/China exposure, directly reducing investor confidence in EU market stability.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">eu_cohesion_crisis</data>
</edge>
<edge source="us_china_tech_rivalry::policy_enforce_int" target="iran_gulf_standoff::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sharper enforcement (seizures, interdictions and public blacklisting) of tech/sanctions compliance increases confrontations at sea and provokes retaliatory or deterrent strikes by Iran or its proxies against commercial shipping in the Gulf.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">iran_gulf_standoff</data>
</edge>
<edge source="us_china_tech_rivalry::policy_enforce_int" target="russia_ukraine_war::sanctions_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A rise in US policy enforcement intensity leads to more aggressive use of secondary sanctions, export-control prosecutions and compliance pressure on intermediaries, directly increasing the effective sanctions pressure applied to Russian actors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
