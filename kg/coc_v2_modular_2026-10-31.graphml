<edge source="ai_economic_power_shift::compute_capacity_demand" target="eu_cohesion_crisis::energy_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Higher aggregate demand for compute capacity drives increased data‑centre electricity consumption and fuel purchases (especially in constrained local grids), exerting upward pressure on regional wholesale energy prices.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_economic_power_shift</data>
  <data key="d39">eu_cohesion_crisis</data>
</edge>
<edge source="ai_economic_power_shift::compute_capacity_demand" target="iran_gulf_standoff::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising demand for compute drives expansion of cloud and satellite analytics capacity for near‑real‑time maritime domain awareness, improving detection and interception and thereby deterring or disrupting hostile maritime actions.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_economic_power_shift</data>
  <data key="d39">iran_gulf_standoff</data>
</edge>
<edge source="ai_economic_power_shift::compute_capacity_demand" target="russia_ukraine_war::sanctions_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising demand for high‑end compute (GPUs, HPC, cloud instances) prompts export‑control tightening and targeted enforcement (blocking shipments, restricting cloud access and intermediary suppliers) to prevent advanced compute reaching Russian actors, increasing the scope and rigor of sanctions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_power_shift</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="ai_economic_power_shift::compute_capacity_demand" target="us_china_tech_rivalry::export_restriction_lvl" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rapid, observable increase in aggregate compute demand (especially for cutting‑edge GPUs/accelerators) triggers immediate national‑security assessments and political pressure that accelerate and widen export controls on high‑end chips and related tooling.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_power_shift</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="ai_economic_power_shift::compute_capacity_demand" target="us_china_tech_rivalry::supply_chain_resilience" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Sharp growth in compute demand strains capacity for advanced semiconductors, substrates and cooling/packaging inputs, producing bottlenecks and single‑point dependencies that measurably reduce the resilience of international AI hardware supply chains.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_power_shift</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
