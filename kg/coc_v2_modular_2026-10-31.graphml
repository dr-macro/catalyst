  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A surge in kinetic operations in Ukraine draws US/NATO naval and air assets to the European theatre and stretches intelligence/escort resources, reducing forward deterrence in the Gulf and enabling Iran-backed groups to increase hostile incidents against ships.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_gulf_standoff</data>
</edge>
