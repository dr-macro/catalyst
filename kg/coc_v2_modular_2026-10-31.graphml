</edge>
<edge source="iran_gulf_standoff::oil_price_volatility" target="iran_gulf_standoff::financial_volatility" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_gulf_standoff::oil_price_volatility" target="ai_economic_power_shift::cost_of_capital" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Spikes in oil-price volatility increase macroeconomic uncertainty and risk premia, widening credit and equity spreads and thereby raising borrowing costs and required returns for AI firms.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">ai_economic_power_shift</data>
</edge>
<edge source="iran_gulf_standoff::oil_price_volatility" target="eu_cohesion_crisis::market_confidence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.72</data>
  <data key="d36">Spikes in oil price volatility increase uncertainty about corporate profits, inflation and policy responses, prompting portfolio rebalancing and reducing aggregate investor confidence in European markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">eu_cohesion_crisis</data>
</edge>
<edge source="iran_gulf_standoff::oil_price_volatility" target="us_china_tech_rivalry::policy_enforce_int" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Marked oil‑price swings increase political and strategic pressure on governments to secure supplies and penalize revenue streams to adversaries, triggering faster and more vigorous enforcement of sanctions, trade screening and export controls by U.S. agencies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_standoff</data>
  <data key="d39">us_china_tech_rivalry</data>
