<edge source="eu_cohesion_crisis::market_confidence" target="ai_economic_power_shift::equity_valuation_levels" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A collapse in EU market confidence precipitates risk-off selling and multiple compression that directly reduces price multiples and private-round valuations applied to AI companies headquartered or listed in the region.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eu_cohesion_crisis</data>
  <data key="d39">ai_economic_power_shift</data>
</edge>
<edge source="eu_cohesion_crisis::market_confidence" target="iran_gulf_standoff::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in EU market confidence reduces immediate fiscal and political pressures on capitals, sustaining collective funding and participation in multinational naval patrols and intelligence-sharing that deter Iranian maritime harassment, so higher market confidence tends to lower maritime attack frequency.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eu_cohesion_crisis</data>
  <data key="d39">iran_gulf_standoff</data>
</edge>
<edge source="eu_cohesion_crisis::market_confidence" target="russia_ukraine_war::sanctions_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A sharp fall in investor confidence heightens political and industry risk aversion within the EU, leading policymakers to scale back new sanctions packages or weaken enforcement to avoid further market dislocation.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eu_cohesion_crisis</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="eu_cohesion_crisis::market_confidence" target="us_china_tech_rivalry::investor_sentiment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sharp fall in EU market confidence raises perceived geopolitical and economic risk for firms exposed to US–China tech frictions, prompting global investors to mark down and reduce allocations to those assets and thereby lowering overall investor sentiment toward the tech rivalry.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eu_cohesion_crisis</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
