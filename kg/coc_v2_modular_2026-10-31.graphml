<edge source="eu_cohesion_crisis::capital_flow_vol" target="iran_gulf_standoff::shipping_disruption" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Greater volatility in EU capital flows raises financing and insurance costs for shipowners and commodity traders, prompting route changes, capacity reductions or delays that increase practical disruptions to shipping operations in high‑risk Gulf routes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eu_cohesion_crisis</data>
  <data key="d39">iran_gulf_standoff</data>
</edge>
