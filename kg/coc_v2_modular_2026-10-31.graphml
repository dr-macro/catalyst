  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">A tightening diesel supply balance from disrupted imports or redirected flows reduces available refined fuel in markets, directly pushing up diesel and related energy prices across the EU.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">eu_cohesion_crisis</data>
