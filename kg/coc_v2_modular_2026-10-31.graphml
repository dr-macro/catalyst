  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Sustained or intensified conflict compels EU governments to increase defense spending, humanitarian aid and refugee support, directly increasing budgetary commitments and narrowing fiscal space.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">eu_cohesion_crisis</data>
</edge>
<edge source="russia_ukraine_war::armed_conflict_intensity" target="iran_gulf_standoff::maritime_attack_rate" id="0">
