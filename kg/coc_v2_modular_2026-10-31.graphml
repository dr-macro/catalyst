<edge source="russia_ukraine_war::armed_conflict_intensity" target="eu_cohesion_crisis::market_confidence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">An uptick in kinetic conflict raises near-term geopolitical risk and the probability of wider disruption, prompting investors to lower risk appetite and reducing aggregate market confidence.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">eu_cohesion_crisis</data>
