      <edge source="russia_ukraine_war::arms_transfer_rate" target="global_bond_repricing::short_term_rate" id="205">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Large, rapid arms deliveries financed by donor governments prompt accelerated short-term fiscal issuance (e.g., T-bills) and draw on domestic funding backstops, increasing near-term supply of short-duration government paper and upward pressure on short-term funding costs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::arms_transfer_rate" target="gulf_maritime_conflict::conflict_intensity" id="206">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increases in Western arms deliveries to Ukraine prompt Russia and its regional partners to accelerate supply and training for proxies (e.g., Houthi, Hezbollah) and to authorize more aggressive maritime harassment, raising kinetic and proxy strike activity in the Gulf theatre." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="gulf_maritime_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::arms_transfer_rate" target="us_china_tech_trade::export_controls_tightnes" id="207">
