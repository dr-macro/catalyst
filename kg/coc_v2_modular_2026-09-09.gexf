      <edge source="gulf_maritime_conflict::political_pressure_on_po" target="europe_political_shift::coalition_stability" id="110">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating domestic and international political pressure over how to respond to the Gulf conflict forces coalition partners into public disagreement (e.g., over military support, sanctions, refugee policy), triggering ministerial withdrawals, confidence votes or breakdowns in legislative cooperation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_maritime_conflict::political_pressure_on_po" target="russia_ukraine_war::arms_transfer_rate" id="111">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Heightened domestic and international political pressure to prioritize protection of maritime trade and to support Gulf partners prompts governments to reallocate finite military aid and procurement toward regional security needs, directly reducing the volume of arms transfers available to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_maritime_conflict::cat::iran_exclusion_zone" target="gulf_maritime_conflict::maritime_security_risk" id="112">
