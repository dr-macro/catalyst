      <edge source="gulf_maritime_conflict::conflict_intensity" target="europe_political_shift::political_trust" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in regional military and proxy strikes creates perceptions that governments are failing to protect economic interests or manage foreign risks, eroding citizens' confidence in institutions' competence and legitimacy." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_maritime_conflict::conflict_intensity" target="global_bond_repricing::portfolio_reallocation" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sharp increases in regional military and maritime attacks trigger risk-off sentiment that causes rapid, large-scale shifts of investor allocations (into safe-haven bonds, gold, FX) and away from risk assets, raising the portfolio reallocation rate." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_maritime_conflict::conflict_intensity" target="russia_ukraine_war::security_response" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A spike in Gulf maritime conflict intensity requires redeployment of U.S. and allied naval and air assets to the region and shifts political attention, directly reducing the tempo and scope of immediate security deployments and reassurance measures available for the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_maritime_conflict::conflict_intensity" target="us_china_tech_trade::export_controls_tightnes" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating conflict intensity prompts governments to broaden or tighten export controls to prevent diversion of advanced computing and dual‑use technologies to actors linked to the conflict or to reduce strategic exposure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
