          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Visible increases in weapons shipments and military aid become focal points for far-right campaigns framing governments as prioritizing foreign security over domestic needs, mobilizing voters and boosting radical-right vote share." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="europe_political_shift" />
