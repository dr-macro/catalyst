      <edge source="us_china_tech_trade::semiconductor_prod_rate" target="europe_political_shift::political_trust" id="306">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increased flow of semiconductors into European supply chains reduces shortages and production disruptions, which voters interpret as effective government/industry crisis management and thereby raises trust in political institutions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
