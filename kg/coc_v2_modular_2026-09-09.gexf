          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising short‑term funding stress raises rollover and repo costs for cloud operators and colo providers, forcing near‑term capex cuts and delays in procurement of servers/accelerators and thereby reducing AI infra deployments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
