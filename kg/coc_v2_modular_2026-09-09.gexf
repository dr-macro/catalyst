          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Interruptions to crude and refined-product flows raise geopolitical risk and push oil prices higher, elevating the term premium and inflation uncertainty and thereby lifting long-term government bond yields." />
