      <edge source="europe_political_shift::far_right_support" target="europe_political_shift::social_cohesion" id="625">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="3" />
          <attvalue for="32" value="-" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::far_right_support" target="global_bond_repricing::portfolio_reallocation" id="626">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A rapid increase in far‑right electoral support in one or more EU states triggers cross‑border risk‑off flows and reweighting of exposures (out of peripheral sovereigns/equities into core sovereigns, FX and safe assets), accelerating portfolio reallocation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_shift" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::far_right_support" target="gulf_maritime_conflict::conflict_intensity" id="627">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Electoral gains for far‑right parties in Europe shift government foreign‑policy priorities toward transactional ties and reduced support for multilateral deterrence (weaker sanctions/coordinated maritime escorts), which lowers the cost for Gulf actors and proxies to escalate strikes and maritime attacks." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="europe_political_shift" />
          <attvalue for="38" value="gulf_maritime_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::far_right_support" target="russia_ukraine_war::arms_transfer_rate" id="628">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising electoral support for far‑right parties incentivizes coalition partners or governing parties to adopt more isolationist or Russia‑sympathetic stances and to oppose or curtail lethal military aid, lowering arms deliveries to Ukraine." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="europe_political_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::far_right_support" target="us_china_tech_trade::export_controls_tightnes" id="629">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Electoral gains by radical-right parties push several European governments to adopt security‑first trade stances and blacklist or restrict Chinese access to sensitive tech, prompting the US to harmonize and broaden its own export restrictions to avoid regulatory gaps and transatlantic circumvention." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="europe_political_shift" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::far_right_support" target="us_china_tech_trade::semiconductor_prod_rate" id="630">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="When European politics tilt toward restrictive, nationalist policies and tighter FDI screening, Chinese firms and state-backed programs accelerate domestic semiconductor capacity buildout to substitute for blocked access to European fabs and design assets." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="europe_political_shift" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
