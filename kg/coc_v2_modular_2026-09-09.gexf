      <edge source="us_china_tech_trade::semiconductor_prod_rate" target="global_bond_repricing::portfolio_reallocation" id="307">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A decline in semiconductor production (i.e., a negative change) quickly compresses tech earnings prospects and supply‑chain visibility, triggering accelerated investor reallocations out of tech equities into safer assets and thus a higher portfolio reallocation rate (conversely, an increase in production dampens such reallocation)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::semiconductor_prod_rate" target="russia_ukraine_war::arms_transfer_rate" id="308">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in semiconductor output increases the supply of advanced chips for Western defense contractors and UAV manufacturers, enabling faster production and export of missiles, air-defence components and drones to Ukraine and its partners, raising delivered arms volume." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
