          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Large, visible arms transfers that incorporate dual‑use electronics and guidance systems raise concerns about technology diversion and rapid militarization, prompting regulators to extend and tighten export restrictions on advanced semiconductors and AI components to China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
