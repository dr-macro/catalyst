      <edge source="russia_ukraine_war::security_response" target="europe_political_shift::coalition_stability" id="237">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating border controls, deployments and emergency security legislation force contentious votes and budget reallocations that exacerbate policy splits within multi-party governing coalitions, increasing the risk of collapse or paralysis." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_response" target="global_bond_repricing::funding_stress" id="238">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Intensified security measures (border controls, asset freezes, stricter sanctions compliance) disrupt cross-border payment flows and collateral chains, reducing available liquidity for banks and corporates and raising short-term funding stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_response" target="gulf_maritime_conflict::maritime_security_risk" id="239">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened European/NATO security responses (troop and naval redeployments to deter escalation in/around Ukraine) pull U.S. and allied high-end naval assets toward Europe and reduce forward deterrent presence in the Gulf, increasing risk perceived by commercial shipping and opportunistic attackers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="gulf_maritime_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::security_response" target="us_china_tech_trade::ai_infra_investment_rate" id="240">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened defense postures and allied security programs translate into increased defense R&amp;D and procurement priorities for AI-enabled ISR, autonomy, and command systems, accelerating private and public capital deployment into AI compute infrastructure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
