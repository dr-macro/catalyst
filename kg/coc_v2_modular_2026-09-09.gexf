      <edge source="global_bond_repricing::funding_stress" target="europe_political_shift::policy_uncertainty" id="510">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Acute short-term funding stress compels central banks and treasuries to deploy emergency liquidity operations, ad hoc guarantees and regulatory forbearance, producing opaque, fast-moving interventions that raise perceived unpredictability about future policy directions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_repricing::funding_stress" target="gulf_maritime_conflict::shipping_throughput_rate" id="511">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute short‑term funding stress causes banks and brokers to curtail trade‑finance lines and require higher margins for letters of credit, directly forcing exporters/importers to delay or cancel shipments and reducing transit volume through Gulf chokepoints." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="gulf_maritime_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_repricing::funding_stress" target="gulf_maritime_conflict::maritime_security_risk" id="512">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Funding strains compress liquidity at insurers and private maritime security firms, prompting coverage withdrawals or sharply higher war‑risk premiums that leave commercial vessels more exposed and raise measured maritime security risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="gulf_maritime_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_repricing::funding_stress" target="russia_ukraine_war::arms_transfer_rate" id="513">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Elevated short-term funding stress tightens trade and export finance, raises working-capital costs and margin calls for defence manufacturers and logistics providers, causing delivery delays and reducing the volume and cadence of arms shipments into the theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
