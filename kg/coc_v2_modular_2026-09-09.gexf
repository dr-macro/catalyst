      <edge source="russia_ukraine_war::economic_pressure" target="europe_political_shift::policy_uncertainty" id="222">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rapid rounds of sanctions, export controls and trade disruptions force governments and firms to revise energy, fiscal and industrial policies frequently, increasing perceived ambiguity about future policy directions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::economic_pressure" target="global_bond_repricing::long_term_bond_yield" id="223">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating sanctions and trade restrictions that curb Russian energy and commodity exports create acute supply squeezes and commodity-price spikes, raising inflation expectations and the term premium and thereby pushing long-dated sovereign yields higher." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::economic_pressure" target="gulf_maritime_conflict::shipping_throughput_rate" id="224">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Escalating sanctions and trade restrictions on Russia disrupt tanker and bulk shipping patterns, raise insurance and freight costs, and force rerouting and capacity reallocation that lower effective cargo and tanker throughput through Gulf chokepoints." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="gulf_maritime_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::economic_pressure" target="us_china_tech_trade::export_controls_tightnes" id="225">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Expanded sanctions and financial pressure tied to the Russia–Ukraine war normalize and politically empower stricter trade policy, prompting US policymakers to broaden and tighten export controls on advanced computing and semiconductor exports to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
