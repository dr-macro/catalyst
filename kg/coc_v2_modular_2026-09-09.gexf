      <edge source="us_china_tech_trade::export_controls_tightnes" target="europe_political_shift::policy_uncertainty" id="334">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="When the US tightens export controls on advanced semiconductors and AI components, European firms and regulators face immediate ambiguity about supply, permitted business relationships and investment plans, raising perceived unpredictability about future technology and trade policy." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::export_controls_tightnes" target="europe_political_shift::coalition_stability" id="335">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Stricter US export controls force European governments to take definitive alignment decisions (security versus industry access) that create intra‑coalition disputes and can make governing majorities fragile or prompt partner defections." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::export_controls_tightnes" target="global_bond_repricing::long_term_bond_yield" id="336">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tightened export controls on advanced semiconductors constrain global supply and raise industry price and geopolitical risk premia, which increases inflation and term‑premium expectations and lifts long‑dated government bond yields." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::export_controls_tightnes" target="global_bond_repricing::funding_stress" id="337">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Stronger export restrictions raise counterparty, compliance and secondary‑sanctions risk for banks and nonbank intermediaries, prompting liquidity hoarding and reduced cross‑border secured/unsecured lending and thereby increasing short‑term funding stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::export_controls_tightnes" target="gulf_maritime_conflict::conflict_intensity" id="338">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tightened US/partner export controls on advanced semiconductors and dual‑use tech prompt China to accelerate military/diplomatic backing and expedited transfers of ISR, drones and missile guidance components to Gulf state and proxy partners, increasing the frequency and sophistication of maritime attacks and counterstrikes." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="gulf_maritime_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::export_controls_tightnes" target="russia_ukraine_war::arms_transfer_rate" id="339">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stricter export controls on advanced chips and related goods to China reduce China's ability and willingness to provide components and finished military systems to Russian intermediaries, leading to an observable drop in arms shipments headed to Russian forces or proxies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
