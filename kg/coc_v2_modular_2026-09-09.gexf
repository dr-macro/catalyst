          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::coalition_stability" target="europe_political_shift::social_cohesion" id="641">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="2" />
          <attvalue for="32" value="+" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::coalition_stability" target="global_bond_repricing::funding_stress" id="642">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A drop in coalition stability (or an increase in instability) raises near-term fiscal and policy default risk, prompting banks and wholesale counterparties to pull or reprice short-term lines and increase repo haircuts, directly increasing short-term funding stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_shift" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::coalition_stability" target="gulf_maritime_conflict::maritime_security_risk" id="643">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="More stable European governing coalitions are able to honor naval commitments, coordinate sanctions and intelligence sharing rapidly, and sustain multinational escorts, thereby reducing the measured maritime security risk in Gulf sea lanes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_shift" />
          <attvalue for="38" value="gulf_maritime_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_shift::coalition_stability" target="russia_ukraine_war::arms_transfer_rate" id="644">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Collapse or paralysis of governing coalitions produces caretaker governments or parliamentary deadlock that directly delay or block legislative approvals and budgetary authorizations for weapons shipments to Ukraine, reducing the flow of arms." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
