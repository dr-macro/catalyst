      <edge source="gulf_maritime_conflict::maritime_security_risk" target="europe_political_shift::policy_uncertainty" id="47">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising maritime security hazards force rapid, ad‑hoc decisions on shipping routes, insurance rules, port operations and trade restrictions, increasing ambiguity about future trade, transport and defense policy for businesses and policymakers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="europe_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_maritime_conflict::maritime_security_risk" target="global_bond_repricing::funding_stress" id="48">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher perceived hazard to shipping raises insurance and trade-finance costs and increases margining and collateral haircuts on trade-linked assets, tightening short-term wholesale and secured funding markets and increasing funding stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_maritime_conflict::maritime_security_risk" target="russia_ukraine_war::arms_transfer_rate" id="49">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising maritime security risk raises insurance, forces route closures and port restrictions, and directly delays or constrains sea-borne deliveries of heavy weapons and ammunition destined for Ukraine, lowering observed arms transfer volumes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_maritime_conflict::maritime_security_risk" target="us_china_tech_trade::ai_infra_investment_rate" id="50">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising maritime security risk increases insurance and logistics costs and raises perceived operational risk for hardware deliveries, causing firms to postpone or scale back capital deployments into AI compute infrastructure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="gulf_maritime_conflict" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
