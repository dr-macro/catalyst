  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Improved AI models accelerate deployment of predictive maintenance and process‑control optimizations at refineries, reducing unplanned outages and increasing operational availability once integrated into operations.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">tech_ai_geopolitical_riv</data>
  <data key="d40">global_energy_shocks</data>
</edge>
