<edge source="tech_ai_geopolitical_riv::model_capability_level" target="global_energy_shocks::wholesale_gas_price" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Higher AI model capability enables materially better short‑term demand and supply forecasting and automated trading strategies that reduce risk premia and speculative overshooting in gas markets, putting downward pressure on wholesale prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">tech_ai_geopolitical_riv</data>
  <data key="d40">global_energy_shocks</data>
</edge>
