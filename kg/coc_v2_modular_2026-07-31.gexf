          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising perceived risk of energy or commodity interruptions leads governments to impose export controls, emergency tariffs or quotas and other protective measures to conserve domestic supplies, increasing effective trade barriers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="mideast_iran_us_conflict" />
          <attvalue for="39" value="us_trade_protectionism" />
          <attvalue for="28" value="0" />
