      <edge source="us_china_ai_tech_rivalry::tech_geopolitical_tensio" target="mideast_iran_us_conflict::maritime_security_commit" id="461">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A spike in tech-geopolitical tension prompts the US and regional partners to expand naval patrols, convoy escorts and allied presence to deter retaliation or interdiction tied to technology disputes, directly raising aggregate maritime security commitments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_ai_tech_rivalry" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_ai_tech_rivalry::tech_geopolitical_tensio" target="mideast_iran_us_conflict::shipping_insurance_premi" id="462">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened tech rivalry increases the incidence and perceived risk of state or proxy cyber/kinetic attacks on maritime logistics and insurers' exposure, leading underwriters to raise war‑risk and political‑risk premiums for Gulf transits." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_ai_tech_rivalry" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
