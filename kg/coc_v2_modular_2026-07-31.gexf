          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Visible supply interruptions for critical tech components prompt governments to announce defensive industrial measures and export controls and to publicly assign blame, escalating bilateral tech policy friction and geopolitical tension." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_trade_protectionism" />
          <attvalue for="39" value="us_china_ai_tech_rivalry" />
