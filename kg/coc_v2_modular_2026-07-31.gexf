          <attvalue for="36" value="Sharp disruptions to Russian energy supplies push importers (particularly in Europe and Asia) to replace lost barrels with increased purchases from Middle Eastern producers, raising crude and product export volumes transiting regional sea lanes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
