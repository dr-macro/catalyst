      <edge source="global_financial_tension::central_bank_credibility" target="us_china_ai_tech_rivalry::capital_flow_ai_infra" id="619">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A loss of central bank credibility raises perceived macro and currency risk for investors, prompting reallocation or withdrawal of long‑term investments away from capital‑intensive AI infrastructure projects." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="us_china_ai_tech_rivalry" />
