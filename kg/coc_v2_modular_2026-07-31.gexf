          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Higher long‑term yields increase the cost of financing multi‑year, capital‑intensive fab builds and depress project NPVs, causing firms to delay, scale back, or cancel semiconductor capacity expansions." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="us_china_ai_tech_rivalry" />
          <attvalue for="28" value="0" />
