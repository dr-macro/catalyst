      <edge source="global_financial_tension::policy_rate_expectations" target="mideast_iran_us_conflict::shipping_insurance_premi" id="606">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising expectations of higher policy rates increase insurers' and reinsurers' cost-of-capital and prompt tighter risk-tolerance and repricing of tail exposures, leading underwriters to raise war‑risk and political‑risk premiums on shipments through the Gulf." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_tension::policy_rate_expectations" target="russia_ukraine_war::military_aid_flow" id="607">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising expectations of higher policy rates increase government borrowing costs and crowd fiscal space, making legislatures and treasuries less willing or able to approve new or larger external military aid packages." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_tension::policy_rate_expectations" target="us_china_ai_tech_rivalry::capital_flow_ai_infra" id="608">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising expected policy rates directly raise investors' discount rates and borrowing costs, reducing venture and project finance availability and thus lowering net capital flows into AI infrastructure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="us_china_ai_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_tension::policy_rate_expectations" target="us_trade_protectionism::supply_chain_disruption" id="609">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="1" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Rising expected policy rates tighten trade finance and raise rollover costs for suppliers and logistics firms, increasing bankruptcies, credit distress and inventory shortages that produce supply‑chain disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="us_trade_protectionism" />
