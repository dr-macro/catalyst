          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Expanded and tightened sanctions and export controls targeting Russia and counterparties directly restrict exports of critical inputs (e.g., neon, palladium, dual‑use components) and payment/transport channels, causing immediate procurement delays and shortages in U.S. supply chains." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_trade_protectionism" />
