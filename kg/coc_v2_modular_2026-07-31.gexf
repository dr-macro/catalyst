      <edge source="us_china_ai_tech_rivalry::tech_geopolitical_tensio" target="global_financial_tension::yield_volatility" id="460">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Escalating tech geopolitics (sanctions, export controls, sudden corporate delistings) forces rapid sectoral repricing and risk-reassessment by fixed-income investors, producing abrupt swings in credit spreads and government bond yields." />
