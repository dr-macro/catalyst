      <edge source="russia_ukraine_war::intensity_conflict" target="mideast_iran_us_conflict::shipping_insurance_premi" id="207">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A marked escalation in kinetic activity and high-profile strikes in the Russia–Ukraine theater amplifies global war-risk perceptions, prompting insurers to raise war-risk and political-risk premiums on shipments transiting exposed Middle Eastern chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
