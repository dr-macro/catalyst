          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Spikes in bond-yield volatility disrupt trade finance, export credit and insurance markets that underwrite arms production and shipments, delaying deliveries and lowering the operational tempo and overall intensity of military operations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
