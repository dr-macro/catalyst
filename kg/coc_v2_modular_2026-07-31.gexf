      <edge source="us_china_ai_tech_rivalry::semiconductor_capacity" target="mideast_iran_us_conflict::oil_export_flow_volume" id="446">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained increase (or decrease) in advanced semiconductor manufacturing capacity—especially in major Asian economies—changes industrial and data‑centre activity and therefore short‑to‑medium‑term oil demand, which translates into higher (or lower) volumes of crude and refined exports transiting Middle East sea lanes within months." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_ai_tech_rivalry" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_ai_tech_rivalry::semiconductor_capacity" target="us_trade_protectionism::supply_chain_disruption" id="447">
