          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rising assessed risk of energy and transit disruption from an Iran–US confrontation prompts the US and allied governments to adopt export controls, investment screening and supply‑chain security measures that directly harden technology trade frictions with China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="mideast_iran_us_conflict" />
          <attvalue for="39" value="us_china_ai_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
