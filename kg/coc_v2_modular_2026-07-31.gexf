          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalation in kinetic operations raises geopolitical risk premia and triggers rapid re‑pricing across commodity, equity and credit markets, directly increasing short‑term asset price volatility." />
