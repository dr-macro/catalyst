      <edge source="global_financial_tension::long_term_yield" target="mideast_iran_us_conflict::oil_export_flow_volume" id="644">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained rise in long‑term yields raises global borrowing costs and dampens investment and industrial demand, reducing crude demand and thereby lowering oil export volumes transiting Middle East chokepoints." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
