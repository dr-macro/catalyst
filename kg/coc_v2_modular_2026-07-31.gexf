      <edge source="us_trade_protectionism::supply_chain_disruption" target="mideast_iran_us_conflict::maritime_security_commit" id="812">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalating supply-chain disruptions tied to US protectionist measures push US firms and policymakers to prioritize secure maritime corridors, prompting increased naval escorts, patrols and allied security deployments in the Middle East to protect vulnerable shipments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_trade_protectionism" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_trade_protectionism::supply_chain_disruption" target="russia_ukraine_war::military_aid_flow" id="813">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Heightened supply‑chain disruptions increase delays and component shortages for weapons and ammunition production, directly reducing the rate and timeliness of external military aid deliveries to Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_trade_protectionism" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
