          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher US trade barriers quickly reduce bilateral and intermediate goods trade volumes, directly lowering container and bulk ship voyages that transit Middle East chokepoints (Suez/Strait of Hormuz) as shippers curtail shipments and demand for route capacity falls." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_trade_protectionism" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
