          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher central-bank credibility lowers political pressure to deploy ad‑hoc trade measures to stabilise growth or markets, reducing the frequency and unpredictability of tariff announcements (and the reverse when credibility falls)." />
