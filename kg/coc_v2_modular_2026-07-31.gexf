          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp increases in bond yield volatility signal elevated systemic risk and funding stress, provoking immediate risk‑off behavior among underwriters and reinsurers and materially raising war‑risk and political‑risk insurance premia for regional shipping." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
