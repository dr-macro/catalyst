          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising tariffs, quotas or other trade barriers raise costs and administrative frictions for cross‑border procurement of weapons and dual‑use components, slowing or lowering the volume of military aid transferred to Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_trade_protectionism" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
