      <edge source="mideast_iran_us_conflict::supply_disruption_risk" target="russia_ukraine_war::energy_supply_severity" id="142">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An elevated assessed risk of Middle East supply disruptions causes immediate global price shocks and reallocation of LNG/oil cargoes away from Europe, directly increasing the magnitude and likelihood of energy shortfalls tied to the Russia–Ukraine war." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="mideast_iran_us_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
