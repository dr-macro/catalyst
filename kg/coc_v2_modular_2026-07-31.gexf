          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Acute energy supply disruptions and higher electricity prices force cloud providers and hyperscalers to delay or scale back data-center builds and machine deployments in affected regions, directly slowing the rate at which new AI compute capacity is brought online." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_ai_tech_rivalry" />
