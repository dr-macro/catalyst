      <edge source="mideast_iran_us_conflict::supply_disruption_risk" target="global_financial_tension::long_term_yield" id="141">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rise in the assessed probability of energy‑supply disruptions raises expected future inflation and adds a term‑risk premium, directly pushing up long‑maturity bond yields as investors demand compensation for higher expected price and tail risks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="mideast_iran_us_conflict" />
          <attvalue for="39" value="global_financial_tension" />
