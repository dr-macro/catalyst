      <edge source="global_financial_tension::long_term_yield" target="russia_ukraine_war::energy_supply_severity" id="645">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher long-term yields raise financing and rollover costs for commodity traders, shipping firms and energy infrastructure projects, prompting reductions in shipments, inventories and investment in alternate routes that increase the likelihood and severity of energy supply disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_tension::long_term_yield" target="us_china_ai_tech_rivalry::semiconductor_capacity" id="646">
