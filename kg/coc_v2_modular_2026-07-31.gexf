          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Greater uncertainty about future tariff policies increases rapid, discrete revisions to inflation and corporate-profit forecasts, driving more frequent repricing in the bond market and higher yield volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_trade_protectionism" />
          <attvalue for="39" value="global_financial_tension" />
