          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Conflict escalation drives flight‑to‑quality into long‑duration government bonds while short‑term policy rates stay unchanged, compressing long minus short yields and flattening (or inverting) the curve." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_financial_tension" />
