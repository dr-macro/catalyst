          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher trade barriers push up import costs and near‑term inflation expectations and raise term premia as investors price policy uncertainty and protectionism risks, lifting long‑term bond yields." />
