      <edge source="us_trade_protectionism::tariff_policy_uncertaint" target="mideast_iran_us_conflict::shipping_insurance_premi" id="828">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising unpredictability in US tariff policy increases underwriters' perceived political and operational risk for international routes, causing war‑risk and political‑risk insurers to raise premiums for shipments transiting volatile Middle East sea lanes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_trade_protectionism" />
          <attvalue for="39" value="mideast_iran_us_conflict" />
          <attvalue for="28" value="0" />
