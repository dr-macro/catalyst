          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Spikes in bond yield volatility amplify market stress and policymakers' risk aversion, provoking defensive regulatory responses (heightened screening of cross‑border tech deals, controls or capital restrictions) that increase tech geopolitical tension." />
