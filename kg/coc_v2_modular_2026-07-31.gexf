          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A meaningful shortfall in semiconductor manufacturing capacity raises expectations of persistent supply constraints and sectoral price pressure, increasing inflation risk premia embedded in long-term bond yields." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_ai_tech_rivalry" />
