          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A marked uptick in kinetic operations raises policymakers' threat perceptions and domestic political pressure, prompting faster adoption of technology export controls, investment screening and adversarial rhetoric that heighten tech-sector geopolitical tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_ai_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
