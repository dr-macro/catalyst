      <edge source="us_trade_protectionism::supply_chain_disruption" target="global_financial_tension::long_term_yield" id="811">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained supply‑chain disruptions reduce expected long‑run GDP growth and capital demand, lowering the growth component of long‑term yields and putting downward pressure on those yields." />
