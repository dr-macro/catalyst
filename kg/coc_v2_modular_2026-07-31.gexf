          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Incremental increases in domestic or allied semiconductor manufacturing capacity relieve foundry bottlenecks and inventory shortages, directly reducing the frequency and severity of supply‑chain disruptions for chip‑dependent goods." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_ai_tech_rivalry" />
          <attvalue for="39" value="us_trade_protectionism" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
