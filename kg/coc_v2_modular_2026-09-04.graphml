<edge source="global_bond_turmoil::market_volatility" target="energy_supply_reordering::crude_export_flow_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Spikes in bond-market volatility drive higher margin calls and counterparty credit limits for commodity traders and refiners, causing temporary reductions in forward hedging and executed shipments that lower crude export flow rates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_turmoil</data>
  <data key="d40">energy_supply_reordering</data>
</edge>
<edge source="global_bond_turmoil::market_volatility" target="us_china_competition::geopolitical_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sharp increases in bond‑market volatility induce policy makers to adopt protective, visible measures (capital controls, defensive industrial measures, public warnings) that escalate public confrontation and reciprocal trade/tech measures between the US and China.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_turmoil</data>
  <data key="d40">us_china_competition</data>
</edge>
<edge source="global_bond_turmoil::market_volatility" target="us_iran_hostilities::oil_shipment_throughput" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A spike in bond-market volatility raises war-risk and hull insurance premia and short-term funding costs for shipowners, prompting rerouting, voyage cancellations and capacity idling that immediately reduce oil shipments through contested maritime routes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_turmoil</data>
  <data key="d40">us_iran_hostilities</data>
</edge>
<edge source="global_bond_turmoil::market_volatility" target="us_iran_hostilities::naval_military_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sharp increases in financial-market volatility that threaten oil and trade flows incentivize US policymakers and regional commands to surge naval escorts, patrols and deterrent operations to reassure markets and deter opportunistic attacks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_turmoil</data>
  <data key="d40">us_iran_hostilities</data>
</edge>
