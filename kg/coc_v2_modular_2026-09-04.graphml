<edge source="us_iran_hostilities::global_oil_price_level" target="energy_supply_reordering::foreign_capital_commitme" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sustained higher global oil prices improve project economics and expected returns, prompting international firms and financiers to increase pledged capital or restart delayed upstream/midstream investments in the producing jurisdiction.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_iran_hostilities</data>
  <data key="d40">energy_supply_reordering</data>
</edge>
<edge source="us_iran_hostilities::global_oil_price_level" target="global_bond_turmoil::long_term_nominal_yield" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Sustained rises in global oil prices lift realized and expected CPI inflation and inflation risk premia, prompting investors to demand higher compensation on long-duration nominal government bonds and thus pushing long-term yields up.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_hostilities</data>
  <data key="d40">global_bond_turmoil</data>
</edge>
<edge source="us_iran_hostilities::global_oil_price_level" target="russia_ukraine_warfare::kinetic_strike_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">A spike in global oil prices driven by US–Iran hostilities raises Russian hydrocarbon export revenues and budgetary room for procurement and munitions production, enabling Moscow to sustain or increase the tempo and scale of overt kinetic strikes in Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_hostilities</data>
  <data key="d40">russia_ukraine_warfare</data>
</edge>
