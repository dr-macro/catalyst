      <edge source="allied_arms_reshaping::deployment_tempo" target="iran_hormuz_standoff::maritime_incident_rate" id="694">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A higher tempo of allied unit and platform transits and rotations through the Strait increases the number of close encounters, interdiction attempts, and platform interactions, raising the raw frequency of collisions, confrontations and other maritime incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="allied_arms_reshaping" />
          <attvalue for="39" value="iran_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
