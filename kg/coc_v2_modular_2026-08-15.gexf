          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Increased external diplomatic pressure tied to the conflict leads the US and partner governments to coordinate tighter sanctions and expand export‑control lists for dual‑use goods (to prevent diversion to regional proxies), broadening the scope and enforcement of controls that also target technology flows to China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_lebanon_conflict" />
          <attvalue for="39" value="us_china_rivalry" />
