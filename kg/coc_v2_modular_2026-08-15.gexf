          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A shift in procurement priority toward anti-ship missiles, loitering munitions, and maritime-capable precision munitions results in faster transfers or reallocation of stocks to Ukrainian forces, enabling a higher tempo of strikes against maritime targets." />
          <attvalue for="37" value="0-6 months" />
