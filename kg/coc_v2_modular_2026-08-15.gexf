      <edge source="iran_hormuz_standoff::rerouted_trade_flow" target="allied_arms_reshaping::operational_readiness" id="77">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A persistent increase in trade rerouting imposes longer, more dispersed logistics and escort missions on forces (higher steaming hours, maintenance and crew fatigue) that directly degrade platform and unit readiness levels over time." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="allied_arms_reshaping" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::rerouted_trade_flow" target="russia_ukraine_blacksea::grain_export_rate" id="78">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large-scale rerouting of bulk shipping away from the Gulf lengthens voyages and ties up available Panamax/Handysize tonnage, reducing charterer appetite and available lift for Black Sea grain shipments and thereby lowering grain export flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="russia_ukraine_blacksea" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::rerouted_trade_flow" target="us_china_rivalry::tech_investment_flow" id="79">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Persistent increases in rerouted trade raise logistics costs and delivery uncertainty for high‑tech firms and governments, prompting accelerated capital allocations into regional/on‑shore semiconductor fabs, data centres and related projects to reduce route vulnerability." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="us_china_rivalry" />
