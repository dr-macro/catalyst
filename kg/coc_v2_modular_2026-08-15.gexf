      <edge source="allied_arms_reshaping::deployment_tempo" target="israel_lebanon_conflict::crossborder_incidents" id="695">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An uptick in allied deployments (carrier/air assets, patrols, ISR platforms) in the Eastern Mediterranean and northern Israel/Lebanon border raises deterrence and disrupts militant movement and launch preparations, reducing the frequency of cross-border incursions and strikes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="allied_arms_reshaping" />
          <attvalue for="39" value="israel_lebanon_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
