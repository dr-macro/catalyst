          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Increased allied naval and mine-countermeasure deployments to the Black Sea region provide escorts, clearance and visible deterrence that reduce commercial risk perceptions and allow more commercial transits and cargo movements." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="allied_arms_reshaping" />
          <attvalue for="39" value="russia_ukraine_blacksea" />
