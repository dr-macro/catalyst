          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A drop in Black Sea maritime throughput (fewer transits/tonnage) directly incentivizes firms and states to diversify suppliers, ports and transit corridors to reduce exposure to chokepoint disruption." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_blacksea" />
