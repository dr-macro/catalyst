      <edge source="iran_hormuz_standoff::oil_export_strait" target="allied_arms_reshaping::procurement_priority" id="104">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained fall in oil volumes transiting the strait (signalling chokepoint vulnerability) causes defense planners to reprioritise acquisitions toward mine-countermeasure, escort and maritime domain-awareness capabilities, whereas higher flows reduce that urgency." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="allied_arms_reshaping" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::oil_export_strait" target="israel_lebanon_conflict::armed_group_firepower" id="105">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A sustained drop in oil export flows through the strait reduces Iran's export revenues and logistical throughput, constraining budgetary transfers and arms shipments to Hezbollah and thereby lowering its cumulative firepower over the medium term." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="israel_lebanon_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::oil_export_strait" target="us_china_rivalry::supply_diversification" id="106">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A drop in oil flows through the Strait directly forces importers and energy‑dependent manufacturers to widen supplier bases and alternative routing (by sourcing from other producers, building inventories, or opening new routes), increasing supply‑chain diversification." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
