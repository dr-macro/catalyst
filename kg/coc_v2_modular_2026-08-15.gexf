          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Tighter US export controls create immediate compliance and interoperability gaps that prompt allied executives to issue frequent, forceful directives reshaping military policy and acquisition rules to secure access and legal cover." />
