          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Escalating export controls that heighten strategic tensions provoke Iranian signaling (threats, interdictions, temporary closures) intended to deter sanction enforcement, which directly lowers the volume of oil able or willing to transit the Strait." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="iran_hormuz_standoff" />
          <attvalue for="28" value="0" />
