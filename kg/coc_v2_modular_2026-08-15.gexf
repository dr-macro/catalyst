      <edge source="israel_lebanon_conflict::diplomatic_pressure" target="allied_arms_reshaping::exec_directive_intensity" id="577">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened diplomatic démarches and allied demands prompt executives to issue more frequent and forceful directives (export approvals, deployment authorizations, sanctions waivers or new ROE guidance) to signal responsiveness and manage partner relations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_lebanon_conflict" />
          <attvalue for="39" value="allied_arms_reshaping" />
