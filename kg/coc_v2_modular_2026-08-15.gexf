      <edge source="russia_ukraine_blacksea::maritime_throughput" target="allied_arms_reshaping::deployment_tempo" id="218">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A drop in maritime throughput (fewer safe transits) prompts allied navies and air forces to launch more frequent escort, patrol and convoy‑protection rotations, materially increasing the rate of deployments and platform movements into the theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_blacksea" />
          <attvalue for="39" value="allied_arms_reshaping" />
