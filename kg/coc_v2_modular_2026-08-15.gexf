      <edge source="russia_ukraine_blacksea::maritime_throughput" target="israel_lebanon_conflict::crossborder_incidents" id="219">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained drop in Black Sea maritime throughput diverts commercial and military traffic into the southern/eastern Mediterranean, increasing transit density near Lebanese waters and triggering more Israeli interdiction and enforcement actions that raise the frequency of cross‑border incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_blacksea" />
          <attvalue for="39" value="israel_lebanon_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
