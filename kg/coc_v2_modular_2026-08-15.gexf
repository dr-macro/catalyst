      <edge source="us_china_rivalry::export_control_intensity" target="iran_hormuz_standoff::maritime_incident_rate" id="377">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharpened US/Western export controls on Chinese high tech push Beijing toward closer operational and diplomatic alignment with Iran and encourage Iranian and proxy harassment of vessels associated with sanctioning states, raising the frequency of collisions, seizures and interdictions in the Strait." />
