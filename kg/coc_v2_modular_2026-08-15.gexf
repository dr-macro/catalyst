      <edge source="iran_hormuz_standoff::maritime_incident_rate" target="allied_arms_reshaping::deployment_tempo" id="55">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rising rate of hostile or hazardous incidents in the strait triggers immediate naval and air escort taskings, emergency patrols and forward rotations to protect transits, raising the rate of unit dispatches and rotations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="allied_arms_reshaping" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::maritime_incident_rate" target="israel_lebanon_conflict::crossborder_incidents" id="56">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in hostile incidents against vessels in the Strait leads Tehran to order or encourage Hezbollah cross-border strikes and probing attacks to impose costs and divert adversary resources, causing more Lebanon–Israel border incidents within weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="israel_lebanon_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::maritime_incident_rate" target="russia_ukraine_blacksea::drone_strike_rate" id="57">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A spike in hostile incidents in the Strait draws US/UK/French naval and air assets and ISR towards the Gulf, reducing Western presence and air/sea-based sensor/defense coverage in the Black Sea and thereby lowering deterrence and enabling a higher tempo of drone/missile strikes there." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="39" value="russia_ukraine_blacksea" />
          <attvalue for="28" value="0" />
