      <edge source="allied_arms_reshaping::exec_directive_intensity" target="iran_hormuz_standoff::maritime_incident_rate" id="682">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="More frequent and forceful executive directives that loosen rules of engagement or mandate assertive freedom-of-navigation operations produce riskier tactics and authorized aggressive maneuvers, increasing the incidence of hostile exchanges and incidents at sea independent of deployment numbers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="allied_arms_reshaping" />
          <attvalue for="39" value="iran_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="allied_arms_reshaping::exec_directive_intensity" target="israel_lebanon_conflict::military_operations" id="683">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="More forceful and frequent executive directives from allied capitals (e.g., orders to expedite weapons shipments, expand intelligence sharing, or greenlight specific kinetic options) directly enable and authorize local commanders to launch more frequent and higher-intensity strikes in the Israel–Lebanon theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="allied_arms_reshaping" />
          <attvalue for="39" value="israel_lebanon_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="allied_arms_reshaping::exec_directive_intensity" target="russia_ukraine_blacksea::drone_strike_rate" id="684">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="More frequent and forceful executive orders authorizing transfers, strike approvals, or expanded targeting authorities accelerate operational use of long-range and maritime-capable strike systems, raising strike frequency against sea and port targets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="allied_arms_reshaping" />
          <attvalue for="39" value="russia_ukraine_blacksea" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="allied_arms_reshaping::exec_directive_intensity" target="us_china_rivalry::export_control_intensity" id="685">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A surge in executive-level directives compels interagency changes to licensing policy and the rapid addition of controlled items/lists, producing immediate tightening of export restrictions on technologies bound for China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="allied_arms_reshaping" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
