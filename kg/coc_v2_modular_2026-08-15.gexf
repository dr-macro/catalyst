      <edge source="israel_lebanon_conflict::diplomatic_pressure" target="iran_hormuz_standoff::oil_price_level" id="578">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Intensified external diplomatic pressure aimed at de‑escalating Israeli–Lebanese hostilities reduces the perceived risk of a broader regional conflagration and thus cuts the risk premium baked into global oil prices, lowering the benchmark level." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_lebanon_conflict" />
          <attvalue for="39" value="iran_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
