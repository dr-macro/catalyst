          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained increases in cross‑border strikes (e.g., Israeli strikes on Hezbollah positions) provoke Tehran to authorize or task naval and proxy actors to attack or harass shipping in the Persian Gulf as asymmetric retaliation, raising the incidence of maritime incidents in the Strait of Hormuz." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_lebanon_conflict" />
          <attvalue for="39" value="iran_hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_lebanon_conflict::crossborder_incidents" target="russia_ukraine_blacksea::maritime_throughput" id="591">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher frequency of cross‑border incidents raises perceived risk for commercial shipping and insurers across adjacent sea lanes, prompting carriers to reduce sailings or reroute away from the region and thereby cutting vessel transits and cargo throughput connected to the Black Sea corridor." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_lebanon_conflict" />
          <attvalue for="39" value="russia_ukraine_blacksea" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="israel_lebanon_conflict::crossborder_incidents" target="us_china_rivalry::supply_diversification" id="592">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rise in cross‑border incidents around Israel and Lebanon causes short‑term disruptions and insurance/shipping reroutes through the eastern Mediterranean and Red Sea, prompting US firms and allies to shift procurement and logistics away from vulnerable chokepoints and concentrated suppliers and thereby accelerate supplier and route diversification." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="israel_lebanon_conflict" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
