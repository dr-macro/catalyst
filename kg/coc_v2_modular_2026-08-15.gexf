      <edge source="russia_ukraine_blacksea::drone_strike_rate" target="allied_arms_reshaping::procurement_priority" id="201">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A sustained rise in drone/missile strikes against ships and littoral facilities produces immediate operational losses and vulnerability visibility that drives allied defense planners to reallocate acquisition emphasis toward counter‑UAS, shipboard air/missile defenses, electronic warfare and short‑range interceptors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_blacksea" />
          <attvalue for="39" value="allied_arms_reshaping" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_blacksea::drone_strike_rate" target="allied_arms_reshaping::operational_readiness" id="202">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher intensity of unmanned and missile strikes increases platform damage rates, crew casualties and maintenance throughput, directly raising downtime and lowering aggregate readiness of forward naval and coastal units." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_blacksea" />
          <attvalue for="39" value="allied_arms_reshaping" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_blacksea::drone_strike_rate" target="israel_lebanon_conflict::crossborder_incidents" id="203">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A surge in drone/missile strikes on merchant vessels in the Black Sea prompts Israeli naval and air forces to broaden patrols and interdiction across the Eastern Mediterranean, increasing encounters and preemptive engagements with Lebanese actors and thus raising cross‑border incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_blacksea" />
          <attvalue for="39" value="israel_lebanon_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_blacksea::drone_strike_rate" target="israel_lebanon_conflict::military_operations" id="204">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Escalating maritime drone/missile attacks in the Black Sea raise regional threat perceptions of proliferating long‑range drone/missile threats, prompting more frequent preemptive strikes, patrols and readiness operations along the Israel–Lebanon front and so increasing operational intensity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_blacksea" />
          <attvalue for="39" value="israel_lebanon_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_blacksea::drone_strike_rate" target="us_china_rivalry::supply_diversification" id="205">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A sustained rise in maritime-targeted drone/missile strikes raises insurance, rerouting and security costs and prompts importers and logistics planners to spread sourcing and routes away from Black Sea-dependent suppliers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_blacksea" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
