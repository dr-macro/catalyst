  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Widespread attacks and insurance/route disruptions to commercial shipping force individual allies to pursue unilateral emergency energy deals and maritime security measures, fragmenting agreement on sanctions, arms transfers and burden‑sharing for the Ukraine response.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">gulf_maritime_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="gulf_maritime_escalation::transport_disruption" target="us_china_tech_trade_riva::export_control_tightness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sustained interruptions to Gulf shipping and logistics expose supply‑chain vulnerabilities for critical semiconductor and AI components, prompting regulators to tighten export rules and reshape trade policy to limit strategic dependencies and control flows of sensitive tech.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">gulf_maritime_escalation</data>
  <data key="d40">us_china_tech_trade_riva</data>
</edge>
<edge source="gulf_maritime_escalation::transport_disruption" target="western_alliance_fragili::donor_ad_spend_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Acute disruptions to shipping and aviation raise economic and political salience for affected constituencies, prompting major donors to accelerate targeted ad buys and independent expenditures to pressure policymakers or defend incumbents.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">gulf_maritime_escalation</data>
  <data key="d40">western_alliance_fragili</data>
</edge>
