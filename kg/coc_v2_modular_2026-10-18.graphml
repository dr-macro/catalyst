<edge source="russia_ukraine_war::energy_attack_rate" target="global_energy_supply_sho::refined_production_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.95</data>
  <data key="d37">Direct attacks on refineries, storage tanks, pipelines and fuel terminals cause physical damage and forced shutdowns or reduced runs, cutting refined-fuel throughput.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="russia_ukraine_war::energy_attack_rate" target="us_china_tech_trade_riva::market_price_ai_assets" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Higher rates of attacks on energy infrastructure raise electricity price volatility and outage risk for energy‑intensive data centers and fabs, increasing operating costs and downtime and exerting downward pressure on valuations of AI infrastructure and chipmaker equities.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_tech_trade_riva</data>
</edge>
