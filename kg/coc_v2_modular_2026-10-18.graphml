<edge source="russia_ukraine_war::kinetic_activity_intensi" target="global_energy_supply_sho::maritime_security_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Increased military strikes, naval operations and mine-laying in and near key sea lanes raises the probability of ship damage, interdiction, route closures and related insurance/escorting requirements.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="russia_ukraine_war::kinetic_activity_intensi" target="gulf_maritime_escalation::escalation_proximity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Sustained spikes in kinetic operations in Ukraine prompt reciprocal or diversionary actions by Russia and its partners (including naval harassment, strikes or cyberattacks) that bring Gulf actors and Western coalitions closer to nonlinear escalation thresholds.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">gulf_maritime_escalation</data>
</edge>
<edge source="russia_ukraine_war::kinetic_activity_intensi" target="us_china_tech_trade_riva::export_control_tightness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Sharp increases in battlefield kinetic activity create immediate national-security pressure on the U.S. and partners to broaden and more tightly enforce export controls on semiconductors, AI compute and related dual‑use technologies to prevent adversary acquisition.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_tech_trade_riva</data>
</edge>
<edge source="russia_ukraine_war::kinetic_activity_intensi" target="western_alliance_fragili::exec_lead_stability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Sustained increases in kinetic intensity that produce higher casualties, refugee pressures or visible battlefield setbacks elevate domestic political backlash and coalition stresses that reduce executive continuity and raise turnover risk.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">western_alliance_fragili</data>
</edge>
