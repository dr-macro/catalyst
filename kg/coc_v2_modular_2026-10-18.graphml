<edge source="us_china_tech_trade_riva::export_control_tightness" target="global_energy_supply_sho::maritime_security_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Tightening export controls on advanced AI chips and perception systems reduces foreign purchasers' access to high-end maritime surveillance, UAV and sensor upgrades, degrading situational awareness in contested sea lanes and increasing the probability/severity of disruptions to seaborne oil movements.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_trade_riva</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="us_china_tech_trade_riva::export_control_tightness" target="gulf_maritime_escalation::materiel_intel_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">Tighter export controls on AI/chips incentivize states and firms in affected supply chains to reroute dual‑use components and enablement services through third‑party vendors and defense partners, increasing covert transfers of hardware, software and targeting/intelligence support into Gulf proxies.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_trade_riva</data>
  <data key="d40">gulf_maritime_escalation</data>
</edge>
<edge source="us_china_tech_trade_riva::export_control_tightness" target="russia_ukraine_war::satellite_comms_avail" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Tighter export controls on AI-relevant chips and comms components restrict supply and licensing for commercial satellite manufacturers and ground-station vendors servicing the theatre, degrading availability or forcing temporary service restrictions for Ukrainian users.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_trade_riva</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
