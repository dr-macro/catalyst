  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Higher refined-fuel output increases readily available fuel for military logistics and frontline units, enabling higher operational tempo and more frequent/large-scale kinetic operations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
