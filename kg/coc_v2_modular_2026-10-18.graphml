<edge source="us_china_tech_trade_riva::regulatory_scrutiny_ai" target="global_energy_supply_sho::diesel_price_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Stronger regulatory scrutiny raises compliance costs and restricts some AI-driven route-optimization and fuel-efficiency tools used by trucking and shipping operators, increasing logistics costs and transport premia that are passed into diesel prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_trade_riva</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="us_china_tech_trade_riva::regulatory_scrutiny_ai" target="western_alliance_fragili::messaging_coherence" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rapid increases in AI regulatory inspections, patchwork compliance rules and enforcement actions force campaign teams to alter or withdraw AI‑generated content at different times and under different interpretations, producing inconsistent public messaging across offices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_trade_riva</data>
  <data key="d40">western_alliance_fragili</data>
</edge>
