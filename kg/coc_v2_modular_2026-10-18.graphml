<edge source="western_alliance_fragili::messaging_coherence" target="global_energy_supply_sho::maritime_security_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Clear, consistent deterrent messaging from Western governments lowers adversary miscalculation and reduces incentives for state or proxy attacks on energy shipping, decreasing maritime security risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_alliance_fragili</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="western_alliance_fragili::messaging_coherence" target="gulf_maritime_escalation::escalation_proximity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Inconsistent or contradictory public statements from Western leaders about red lines and responses create adversary uncertainty and miscalculation, bringing regional actors closer to nonlinear escalation thresholds.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_alliance_fragili</data>
  <data key="d40">gulf_maritime_escalation</data>
</edge>
<edge source="western_alliance_fragili::messaging_coherence" target="russia_ukraine_war::kinetic_activity_intensi" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Clear, consistent allied public messaging reduces adversary uncertainty about red lines and deterrent resolve, discouraging incremental probing and lowering the frequency of kinetic tests and strikes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_alliance_fragili</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
