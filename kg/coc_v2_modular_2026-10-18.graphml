<edge source="gulf_maritime_escalation::materiel_intel_flow" target="us_china_tech_trade_riva::export_control_tightness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Documented increases in weapons, sensors, drone and intelligence transfers that leverage advanced chips and ML systems trigger immediate export‑control expansions and stricter licensing (to prevent diversion), raising practical restrictiveness on AI‑relevant technologies to China and intermediary states.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">gulf_maritime_escalation</data>
  <data key="d40">us_china_tech_trade_riva</data>
</edge>
