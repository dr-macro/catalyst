<edge source="global_energy_supply_sho::maritime_security_risk" target="gulf_maritime_escalation::transport_disruption" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">An increase in maritime security risk (attacks, mines, harassment) directly forces ships to slow, reroute, enter convoys or avoid ports, triggering immediate and measurable interruptions to shipping schedules, port operations and aviation-linked logistics.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">gulf_maritime_escalation</data>
</edge>
<edge source="global_energy_supply_sho::maritime_security_risk" target="gulf_maritime_escalation::materiel_intel_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising maritime security risk prompts intensified naval patrols, inspections and insurance-driven route changes that directly reduce the volume and tempo of sea-borne transfers of fuel, weapons and intelligence between actors and proxies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">gulf_maritime_escalation</data>
</edge>
<edge source="global_energy_supply_sho::maritime_security_risk" target="russia_ukraine_war::energy_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A rise in seaborne security incidents (mines, strikes, tanker attacks) both reflects and triggers escalatory naval operations and reprisals that directly increase hostile strikes on energy shipping and onshore fuel terminals.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_energy_supply_sho::maritime_security_risk" target="us_china_tech_trade_riva::export_control_tightness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalating attacks or interdictions on commercial shipping linked to rival states raises perceived strategic escalation risk, prompting policymakers to tighten and more strictly enforce export controls on AI‑relevant hardware and software to prevent transfer during contested supply‑chain disruptions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">us_china_tech_trade_riva</data>
</edge>
<edge source="global_energy_supply_sho::maritime_security_risk" target="western_alliance_fragili::exec_lead_stability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">High-profile maritime attacks or interdictions that interrupt seaborne oil flows produce immediate political crises, visible evidence of government incapacity, and intensified opposition and coalition pressure that increase turnover or weaken executive cohesion.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">western_alliance_fragili</data>
</edge>
