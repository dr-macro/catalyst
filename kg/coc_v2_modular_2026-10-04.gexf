          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Announcements and disbursements of large, front‑loaded defense aid packages prompt institutional investors to rotate into defense suppliers and related risk assets (funded by reductions in bond allocations), accelerating the pace of portfolio rebalancing." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="sovereign_bond_market_st" />
          <attvalue for="28" value="0" />
