      <edge source="russia_ukraine_war::sanctions_pressure" target="global_energy_supply_sho::diesel_spot_price_level" id="69">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Broader or stricter sanctions on Russian refined products, payment/insurance channels and trading entities removes accessible supply and raises transaction frictions and risk premia, directly pushing up global diesel spot prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="iran_middle_east_tension::crude_export_flow" id="70">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tightening and enforcement of sanctions on Russian oil creates supply gaps and pricing incentives that prompt buyers and middlemen to source additional crude from Iran via sanctioned or opaque commercial channels, raising Iran's effective export volumes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_middle_east_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="sovereign_bond_market_st::nominal_yield_level" id="71">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Broader or more severe sanctions that implicate banks, payment channels or commodity flows increase counterparty and sovereign risk premia (and term premia) in affected jurisdictions, pushing up long‑term government bond yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="sovereign_bond_market_st" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="us_china_tech_trade_riva::compute_capacity_total" id="72">
