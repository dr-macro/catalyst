          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Reduced energy resilience from supply disruptions or price spikes increases operating and build costs for datacenters, causing hyperscalers and cloud providers to delay or scale back new AI compute buildouts, lowering aggregate installed capacity." />
