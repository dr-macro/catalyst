          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalating shipping risk drives abrupt asset-price moves and margin calls on commodity and cross‑asset positions, triggering faster forced deleveraging and higher leverage unwind rates in the sovereign bond complex." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_middle_east_tension" />
          <attvalue for="39" value="sovereign_bond_market_st" />
