      <edge source="us_china_tech_trade_riva::regulatory_enforcement" target="russia_ukraine_war::sanctions_pressure" id="426">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger, better‑resourced enforcement of export controls and trade rules increases detection and blockage of sanctions‑evasion networks and enables imposition of new targeted restrictions, raising the breadth and intensity of economic pressure applied to the conflict parties." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
