      <edge source="sovereign_bond_market_st::nominal_yield_level" target="global_energy_supply_sho::diesel_spot_price_level" id="633">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising sovereign nominal yields raise refinancing and working‑capital costs for refiners, traders and shipping firms (and increase trade finance spreads), which operators pass through as higher delivered diesel prices in spot markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="sovereign_bond_market_st" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="sovereign_bond_market_st::nominal_yield_level" target="iran_middle_east_tension::oil_price_level" id="634">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising developed‑market nominal yields raise global discount rates and tend to strengthen the dollar and increase financing costs for commodity inventory/hedging, which suppresses demand and pushes down spot crude prices within months." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="sovereign_bond_market_st" />
          <attvalue for="39" value="iran_middle_east_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="sovereign_bond_market_st::nominal_yield_level" target="russia_ukraine_war::defense_aid_flow" id="635">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising nominal government bond yields raise borrowing costs and fiscal strain for donor governments, causing them to delay, scale back, or ration cash‑intensive military aid packages and credits to Ukraine." />
          <attvalue for="37" value="0-6 months" />
