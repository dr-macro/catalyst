      <edge source="russia_ukraine_war::mil_escalation_level" target="iran_middle_east_tension::shipping_security_risk" id="35">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A marked uptick in Russian military escalation draws NATO and allied naval assets and intelligence focus toward European waters and increases risk of wider naval confrontation, reducing deterrence and leaving Middle East shipping lanes more exposed to interdiction and attacks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_middle_east_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::mil_escalation_level" target="sovereign_bond_market_st::volatility_level" id="36">
        <attvalues>
