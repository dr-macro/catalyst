          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter export controls and enforcement by the US/allies prompt China to accelerate clandestine or state-facilitated transfers of dual-use AI-enabled systems and combat drones to Iran, materially improving Iranian or proxy strike capabilities and thereby increasing the frequency/severity of military incidents in the region." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="iran_middle_east_tension" />
