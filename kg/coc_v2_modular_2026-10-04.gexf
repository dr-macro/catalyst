          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large defense aid packages include procurement and R&amp;D contracts for ISR, autonomy, and advanced sensors that channel corporate and venture capital into AI startups, model development, and compute infrastructure to meet military demand." />
