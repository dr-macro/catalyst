      <edge source="global_energy_supply_sho::diesel_export_rate" target="iran_middle_east_tension::shipping_security_risk" id="515">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Higher volumes of diesel exports increase tanker traffic through Middle East choke points (e.g., Strait of Hormuz), raising vessel density, transit congestion and exposure that directly elevates the probability and severity of attacks, interdictions or accidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="iran_middle_east_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::diesel_export_rate" target="iran_middle_east_tension::crude_export_flow" id="516">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Greater exports of refined diesel from alternative suppliers substitute for buyers' near-term needs, prompting trading houses and refiners to reduce crude liftings from Middle Eastern suppliers (including Iran) and directly lowering their crude export volumes." />
          <attvalue for="37" value="1-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="iran_middle_east_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::diesel_export_rate" target="russia_ukraine_war::energy_resilience" id="517">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An increase in net diesel exports available to the conflict region raises delivered fuel supplies for power plants, backup generators and transport, directly increasing the system's ability to absorb disruptions and maintain deliveries." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_sho::diesel_export_rate" target="us_china_tech_trade_riva::compute_capacity_total" id="518">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher diesel export flows relieve regional fuel shortages and lower transport/backup‑power risk for server shipments and on‑site operations, enabling scheduled deliveries and deployments of servers and thus increasing installed compute over the medium term." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
