          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A sudden uptick in kinetic operations raises near‑term geopolitical uncertainty and tail‑risk concerns, triggering rapid hedging and repricing across sovereign bonds and raising both realized and implied market volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="sovereign_bond_market_st" />
          <attvalue for="28" value="0" />
        </attvalues>
