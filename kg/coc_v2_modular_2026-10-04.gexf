          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened maritime security risk increases dealer inventory and funding risk, prompting wider quotes and reduced willingness to absorb large sovereign bond trades, thereby reducing market depth." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_middle_east_tension" />
          <attvalue for="39" value="sovereign_bond_market_st" />
          <attvalue for="28" value="0" />
