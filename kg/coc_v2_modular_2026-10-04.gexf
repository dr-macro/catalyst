          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Higher kinetic and hybrid escalation incentivizes rushed deployment and operationalization of autonomous, cyber, and decision‑support AI systems with compressed testing and oversight, raising the aggregate probability of unsafe or cascading AI failures." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
