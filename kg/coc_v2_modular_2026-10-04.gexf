        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Improved energy supply resilience in Europe (diversified sources, storage, and LNG flows) reduces risk premia and emergency demand linked to the Russia–Ukraine conflict, lowering global oil price levels (and conversely, degraded resilience raises them)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_middle_east_tension" />
