          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Acute deterioration in energy supply resilience causes sharp commodity price moves and margin stresses that force dealers and leveraged players to shrink inventories and withdraw from making markets, reducing depth in sovereign bond trading." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="sovereign_bond_market_st" />
