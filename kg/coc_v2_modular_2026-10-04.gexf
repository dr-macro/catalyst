          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Broader sanctions and export controls tied to the conflict restrict shipments of advanced accelerators, chip fabrication equipment, and design tools, directly reducing the volume of new high‑end compute hardware that adversary states and firms can acquire and deploy." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
          <attvalue for="28" value="0" />
