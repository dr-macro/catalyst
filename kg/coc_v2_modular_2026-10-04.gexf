      <edge source="russia_ukraine_war::mil_escalation_level" target="global_energy_supply_sho::diesel_export_rate" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher kinetic escalation causes damage to refineries, terminals and export infrastructure and prompts port closures and insurer/charterer refusals, directly reducing volumes of diesel shipped out of the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_supply_sho" />
