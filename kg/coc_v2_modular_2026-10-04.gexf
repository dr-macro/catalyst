          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger and more intrusive tech/trade enforcement increases compliance costs and operational constraints for market‑making desks and cross‑border dealers, reducing their willingness and capacity to hold large sovereign positions and thereby thinning liquidity depth." />
          <attvalue for="37" value="6-18 months" />
