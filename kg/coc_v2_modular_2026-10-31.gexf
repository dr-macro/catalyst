      <edge source="eu_cohesion_crisis::fiscal_space" target="iran_gulf_standoff::maritime_attack_rate" id="699">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Increased EU fiscal space enables additional defense and expeditionary funding (naval escorts, allied tasking, sanctions enforcement), directly raising the cost to Iranian actors of maritime interdiction and thereby reducing attack incidence." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="eu_cohesion_crisis" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
