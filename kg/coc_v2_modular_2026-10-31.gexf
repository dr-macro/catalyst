      <edge source="russia_ukraine_war::armed_conflict_intensity" target="eu_cohesion_crisis::market_confidence" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An uptick in kinetic conflict raises near-term geopolitical risk and the probability of wider disruption, prompting investors to lower risk appetite and reducing aggregate market confidence." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="eu_cohesion_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
