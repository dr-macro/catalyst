      <edge source="eu_cohesion_crisis::fiscal_space" target="russia_ukraine_war::state_private_coord" id="700">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Shrinkage of fiscal space forces EU governments to cut or delay defense procurement, joint programs and subsidies, directly reducing the frequency and depth of operational coordination and information-sharing with private defense and logistics firms supporting Ukraine." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="eu_cohesion_crisis" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
