        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A surge in kinetic conflict raises geopolitical and supply‑chain risk premia, prompting risk‑off reallocations and reducing investor confidence in assets and deals tied to US–China tech integration and cross‑border tech exposure." />
