      <edge source="us_china_tech_rivalry::policy_enforce_int" target="ai_economic_power_shift::cost_of_capital" id="351">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sharper enforcement of tech and security policies raises compliance, licensing and legal risks for AI firms and prompts lenders and investors to demand higher spreads and returns, directly increasing firms' effective cost of capital." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="ai_economic_power_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::policy_enforce_int" target="eu_cohesion_crisis::market_confidence" id="352">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A marked rise in enforcement actions and compliance checks increases regulatory uncertainty and operating costs for EU-headquartered multinationals with US/China exposure, directly reducing investor confidence in EU market stability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="eu_cohesion_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::policy_enforce_int" target="iran_gulf_standoff::maritime_attack_rate" id="353">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharper enforcement (seizures, interdictions and public blacklisting) of tech/sanctions compliance increases confrontations at sea and provokes retaliatory or deterrent strikes by Iran or its proxies against commercial shipping in the Gulf." />
