      <edge source="russia_ukraine_war::armed_conflict_intensity" target="iran_gulf_standoff::maritime_attack_rate" id="38">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A surge in kinetic operations in Ukraine draws US/NATO naval and air assets to the European theatre and stretches intelligence/escort resources, reducing forward deterrence in the Gulf and enabling Iran-backed groups to increase hostile incidents against ships." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
