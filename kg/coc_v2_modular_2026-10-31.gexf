      <edge source="ai_economic_power_shift::ai_investment_rate" target="eu_cohesion_crisis::capital_flow_vol" id="512">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rapid rise in AI investment, particularly concentrated in a handful of EU member states, draws large, quick cross-border venture, private‑equity and portfolio inflows to those hubs and prompts reallocations and occasional sudden outflows elsewhere, increasing overall capital flow volatility across the bloc." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_power_shift" />
          <attvalue for="38" value="eu_cohesion_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_power_shift::ai_investment_rate" target="iran_gulf_standoff::oil_price_volatility" id="513">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Faster AI investment accelerates deployment of high‑frequency and news‑sensitive commodity trading algorithms that amplify market reactions to Gulf incidents and signals, increasing short‑term oil price swings." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_power_shift" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_power_shift::ai_investment_rate" target="russia_ukraine_war::state_private_coord" id="514">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A faster pace of AI investment expands the number and capability of private AI vendors that governments need for ISR, targeting, logistics and decision‑support, driving more frequent contracting, data‑sharing agreements and integrated operational programs between states and firms." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="ai_economic_power_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_power_shift::ai_investment_rate" target="us_china_tech_rivalry::investor_sentiment" id="515">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained surge in AI investment concentrated in one side of the US‑China rivalry (visible via deal volume and fundraising) leads investors to downgrade risk appetite for assets exposed to geopolitical decoupling, lowering overall investor sentiment toward those cross‑border tech exposures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_economic_power_shift" />
