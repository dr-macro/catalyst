      <edge source="russia_ukraine_war::armed_conflict_intensity" target="eu_cohesion_crisis::fiscal_space" id="37">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sustained or intensified conflict compels EU governments to increase defense spending, humanitarian aid and refugee support, directly increasing budgetary commitments and narrowing fiscal space." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="eu_cohesion_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
