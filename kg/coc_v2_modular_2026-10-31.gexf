      <edge source="iran_gulf_standoff::maritime_attack_rate" target="ai_economic_power_shift::capital_availability" id="232">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in maritime attacks heightens geopolitical risk and prompts cross-border investors and lenders to reprice or withdraw exposure to regional and open-ended technology funds, reducing the pool of deployable capital for AI projects." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="ai_economic_power_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_standoff::maritime_attack_rate" target="eu_cohesion_crisis::fiscal_space" id="233">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increase in attacks on shipping raises immediate defence, maritime protection and targeted business-support spending and insurance subsidies by EU governments, constraining available fiscal headroom for other policies." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="eu_cohesion_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_standoff::maritime_attack_rate" target="russia_ukraine_war::armed_conflict_intensity" id="234">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A sustained uptick in Gulf maritime attacks will draw NATO/Western naval and air assets and political attention toward the Middle East, creating openings Russia can exploit to escalate operations in Ukraine or to pressure Kyiv while Western focus and resources are diverted." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_standoff::maritime_attack_rate" target="us_china_tech_rivalry::export_restriction_lvl" id="235">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A rise in attacks on vessels in the Gulf raises concerns about diversion, theft and dual‑use transfer routes, prompting U.S. regulators and security agencies to broaden or tighten export controls and blacklist authorities to reduce perceived leakages to adversaries." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
