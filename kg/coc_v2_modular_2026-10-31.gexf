          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Constrained EU fiscal space reduces governments' ability to subsidize strategic sectors, pushing them to prioritize inward investment and short‑term growth incentives by loosening export controls on certain dual‑use tech to attract capital, thereby lowering export restriction levels relevant to the US–China tech contest." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="eu_cohesion_crisis" />
