      <edge source="russia_ukraine_war::sanctions_pressure_level" target="ai_economic_power_shift::capital_availability" id="129">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Intensified sanctions and secondary sanctions increase counterparty, correspondent‑bank and asset‑freezing risks, prompting banks and institutional investors to pull or withhold cross‑border capital and reduce allocations to higher‑risk private tech/AI funds." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_economic_power_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="eu_cohesion_crisis::capital_flow_vol" id="130">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalating and broadened sanctions increase counterparty, compliance and settlement risk for banks and investors, triggering abrupt portfolio rebalancing and cross-border withdrawals that raise capital flow volatility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="eu_cohesion_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="iran_gulf_standoff::oil_price_volatility" id="131">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter, broader or better-enforced sanctions on Russian oil and petroleum trade reduce available liquidity and alternative supplies in global markets, producing larger and more frequent price swings." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="us_china_tech_rivalry::export_restriction_lvl" id="132">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Expansion and stricter enforcement of sanctions during the Russia–Ukraine war creates legal precedent and allied coordination that governments extend to impose broader export controls, licensing restrictions and blacklists on advanced technologies destined for Chinese firms." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
