      <edge source="russia_ukraine_war::armed_conflict_intensity" target="ai_economic_power_shift::compute_capacity_demand" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalation of kinetic operations generates higher demand for real‑time ISR, imagery analytics, battlefield AI and communications processing, raising short‑term demand for cloud and specialized compute resources." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_economic_power_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
