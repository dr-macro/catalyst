      <edge source="global_financial_ai::bond_yield_level" target="global_energy_diesel::refinery_utilization" id="767">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising long‑term bond yields increase refiners' cost of capital and make financing for turnarounds, upgrades, and merchant crude purchases more expensive, prompting deferred maintenance/operational cutbacks and a reduction in refinery throughput rates." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_financial_ai" />
          <attvalue for="39" value="global_energy_diesel" />
          <attvalue for="28" value="0" />
