          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising hostile incidents against commercial shipping increase insurance premiums, require rerouting and cause delays, directly reducing the feasible and cost-effective volume of vehicles and powertrains shipped between China and Europe." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_diesel" />
          <attvalue for="39" value="china_eu_auto_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
