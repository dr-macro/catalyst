      <edge source="china_eu_auto_rivalry::supply_chain_integration" target="global_financial_ai::bond_yield_level" id="448">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Fragmentation of China–EU vehicle supply chains raises near‑term production costs and economic risk premia for affected countries, which increases sovereign and high‑grade bond risk premia and pushes long‑term benchmark yields higher." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="china_eu_auto_rivalry" />
          <attvalue for="39" value="global_financial_ai" />
          <attvalue for="28" value="0" />
