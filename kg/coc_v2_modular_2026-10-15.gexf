          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Higher long‑term bond yields raise the benchmark cost of capital and borrowing costs for OEMs and suppliers, causing planned cross‑border greenfield investments and factory expansions between China and the EU to be scaled back or delayed." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_ai" />
          <attvalue for="39" value="china_eu_auto_rivalry" />
          <attvalue for="28" value="0" />
