      <edge source="global_energy_diesel::shipping_attack_frequenc" target="china_eu_auto_rivalry::cross_border_investment" id="564">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained increases in maritime attack risk raise expected transport interruptions and costs, incentivizing automakers to commit capital to build or expand production assets closer to target markets (higher foreign direct investment in local plants) rather than rely on long-distance shipments." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_energy_diesel" />
          <attvalue for="39" value="china_eu_auto_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_diesel::shipping_attack_frequenc" target="global_financial_ai::ai_investment_flow" id="565">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in attacks on commercial shipping raises trade disruption risk and market volatility, causing investors and corporate balance sheets to defer or reduce higher‑risk AI project funding." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_diesel" />
          <attvalue for="39" value="global_financial_ai" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_diesel::shipping_attack_frequenc" target="mideast_houthi_campaign::armed_offense_rate" id="566">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher rates of successful or visible maritime attacks lower the perceived costs and demonstrate tactics/munitions, encouraging Houthi planners to increase the tempo of missile and drone strikes against regional targets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_diesel" />
          <attvalue for="39" value="mideast_houthi_campaign" />
          <attvalue for="28" value="0" />
        </attvalues>
