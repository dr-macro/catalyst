          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A higher tempo of missile, drone and small-boat offensive strikes directed by non-state actors in the theatre results in more direct incidents against commercial shipping (strikes, attempted boardings, escorts fired upon) in adjacent sea lanes, raising recorded maritime attack frequency." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="mideast_houthi_campaign" />
          <attvalue for="39" value="global_energy_diesel" />
          <attvalue for="28" value="0" />
