          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A sustained tempo of missile/drone strikes against ports and transshipment hubs prompts automakers and tier suppliers to accelerate de-risking (nearshoring/dual-sourcing), lowering China–EU component interdependence." />
          <attvalue for="37" value="6-18 months" />
