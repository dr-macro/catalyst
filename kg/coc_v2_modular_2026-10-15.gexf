          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="An uptick in attacks on commercial shipping prompts regional states and coalition navies/air forces to increase patrols, interdictions, and kinetic responses against groups conducting those attacks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_diesel" />
          <attvalue for="39" value="mideast_houthi_campaign" />
          <attvalue for="28" value="0" />
