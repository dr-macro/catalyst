          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater cross-border supply‑chain integration raises freight and trucking activity (higher diesel consumption), which draws down finished diesel stocks and reduces aggregate inventory levels." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="china_eu_auto_rivalry" />
          <attvalue for="39" value="global_energy_diesel" />
          <attvalue for="28" value="0" />
