          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A fall in China–EU supply‑chain integration (greater fragmentation/route concentration) amplifies the strategic impact of Houthi disruptions at chokepoints, making states more likely to undertake forceful countermeasures and thereby raising overall military escalation risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_eu_auto_rivalry" />
