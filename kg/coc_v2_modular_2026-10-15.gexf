          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in offensive strikes increases realized geopolitical risk for investors with regional exposure, prompting institutional risk-off reallocations and temporary withdrawals from higher‑beta sectors including technology and venture allocations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="mideast_houthi_campaign" />
          <attvalue for="39" value="global_financial_ai" />
