          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising maritime attacks—especially those involving rockets/drones or proximate to busy air corridors—raise safety and insurance assessments, causing carriers and regulators to curtail or reroute flights and reduce service levels in the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_diesel" />
          <attvalue for="39" value="mideast_houthi_campaign" />
          <attvalue for="28" value="0" />
