          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher long‑term bond yields raise carriers' and lessors' financing and lease costs and increase required risk premia, prompting airlines to trim marginal routes, reduce frequencies, or suspend services into higher‑risk regions, thus lowering regional aviation service levels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_ai" />
          <attvalue for="39" value="mideast_houthi_campaign" />
