          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained large capital flows into the technology sector divert equity and private capital away from upstream oil companies and service‑sector financing, reducing drilling, maintenance and near‑term investment and causing a measurable decline in crude production rates." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_financial_ai" />
