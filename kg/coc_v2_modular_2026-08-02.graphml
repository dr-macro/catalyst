  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Increased allied support (grants, subsidized loans, direct procurement or in-kind military aid) lowers the recipient government's immediate borrowing needs and reduces rollover and market funding pressure.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">market_monetary_stress</data>
</edge>
