</edge>
<edge source="global_energy_shift::chokepoint_security" target="iran_us_regional_war::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Deterioration in security at major maritime chokepoints forces ad hoc burden-sharing (escorts, patrols) and exposes divergent threat tolerances and economic exposures among US partners, producing political friction and reducing coalition cohesion.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_shift</data>
  <data key="d40">iran_us_regional_war</data>
</edge>
<edge source="global_energy_shift::chokepoint_security" target="market_monetary_stress::long_term_yield" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A sustained deterioration in major maritime chokepoint security raises the persistent supply‑risk premium for energy and increases perceived long‑run fiscal and inflation uncertainty, prompting investors to demand higher term premia and pushing up long‑duration government yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_shift</data>
  <data key="d40">market_monetary_stress</data>
</edge>
<edge source="global_energy_shift::chokepoint_security" target="russia_ukraine_war::fuel_supply_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Declines in security at key maritime chokepoints (e.g., mines, naval interdictions or closures in the Black Sea/Turkish Straits) directly force port shutdowns and vessel refusals, physically reducing volumes of liquid fuels delivered to the conflict region and nearby markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_shift</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_energy_shift::chokepoint_security" target="us_china_tech_rivalry::compute_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Improved security at major maritime chokepoints reduces risk of interdiction and delay for high‑value GPU/accelerator shipments, enabling faster deliveries and installations that raise available high‑performance compute capacity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_shift</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="global_energy_shift::chokepoint_security" target="concept::maritime_chokepoint_security" id="0">
  <data key="d28">instance_of</data>
</edge>
