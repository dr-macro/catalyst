<edge source="market_monetary_stress::market_rate_expectations" target="global_energy_shift::seaborne_flow_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Rising expected short-term policy rates raise forward financing and working-capital costs for traders and shipowners and increase charter/bunker expense expectations, prompting cancellations, slower loadings and lower spot chartering for marginal cargoes and thus reducing seaborne oil and LNG shipments.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">market_monetary_stress</data>
  <data key="d40">global_energy_shift</data>
</edge>
