  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Scaling advanced semiconductor fabs substantially raises local electricity and process‑fuel demand, prompting increased LNG/oil imports shipped by sea to meet that industrial energy load and thus raising seaborne energy flows.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_energy_shift</data>
</edge>
