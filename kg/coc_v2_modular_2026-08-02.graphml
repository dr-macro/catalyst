<edge source="market_monetary_stress::inflation_expectations" target="global_energy_shift::crude_price_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Higher market inflation expectations increase demand for commodities as an inflation hedge and raise nominal price trajectories for energy contracts, directly lifting crude oil prices as traders and investors increase long positions and producers index sales to higher forward prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">market_monetary_stress</data>
  <data key="d40">global_energy_shift</data>
</edge>
<edge source="market_monetary_stress::inflation_expectations" target="russia_ukraine_war::energy_price_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Higher inflation expectations drive increased speculative positioning and hedging demand in commodity markets and accelerate pass-through pricing, amplifying short- to medium-term swings in energy prices linked to conflict-related supply/demand shocks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">market_monetary_stress</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
