  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Higher alliance political support commonly includes naval escorts, intelligence sharing and patrol deployments around vulnerable straits/canals, directly improving on-the-water security and access stability at major chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_shift</data>
</edge>
<edge source="russia_ukraine_war::alliance_support_level" target="iran_us_regional_war::military_engagement_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Sustained high levels of allied politico-material support to Ukraine consume munitions, precision-guided weapons and deployable strike platforms and prioritize European force posture, reducing immediately available U.S./coalition assets and munitions for kinetic operations in the Middle East and thus lowering short-term engagement rates against Iran.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_us_regional_war</data>
</edge>
