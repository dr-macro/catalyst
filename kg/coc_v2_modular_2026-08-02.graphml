<edge source="market_monetary_stress::central_bank_credibility" target="global_energy_shift::crude_price_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">An increase in central-bank credibility lowers perceived inflation and currency-risk premia and reduces demand for commodities as an inflation hedge, weakening speculative and portfolio flows into oil and thereby exerting downward pressure on crude prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">market_monetary_stress</data>
  <data key="d40">global_energy_shift</data>
</edge>
<edge source="market_monetary_stress::central_bank_credibility" target="us_china_tech_rivalry::regulatory_control" id="0">
