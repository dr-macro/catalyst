  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A decline in central bank credibility heightens political and public demand for economic safeguards, spurring governments to tighten export controls, compliance checks, and capital/tech restrictions on strategically sensitive AI technologies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">market_monetary_stress</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
