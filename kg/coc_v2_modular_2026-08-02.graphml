<edge source="russia_ukraine_war::fuel_supply_flow" target="global_energy_shift::seaborne_flow_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Reductions in continental pipeline or overland fuel export flows (e.g., Russian pipeline gas/oil curtailed by the conflict) prompt buyers to substitute with seaborne cargoes (LNG, oil tankers), increasing seaborne flow rates; conversely increases in land-based flows reduce seaborne shipments.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_shift</data>
</edge>
<edge source="russia_ukraine_war::fuel_supply_flow" target="iran_us_regional_war::maritime_chokepoint_sec" id="0">
