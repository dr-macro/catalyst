<edge source="iran_us_regional_war::alliance_cohesion" target="global_energy_shift::rerouting_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Tighter operational and diplomatic coordination among partner navies and flag states enables escorted convoys, corridor guarantees and port access arrangements that allow ships to follow original routes rather than divert, lowering rerouting frequency.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_us_regional_war</data>
  <data key="d40">global_energy_shift</data>
</edge>
