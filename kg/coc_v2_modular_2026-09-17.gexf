      <edge source="russia_ukraine_warfare::sanctions_severity" target="global_rate_market_shock::policy_rate_expectations" id="54">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Expansion and intensification of sanctions increase import costs and inflationary pressures, leading markets to revise up the expected path and timing of monetary tightening by central banks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="39" value="global_rate_market_shock" />
          <attvalue for="28" value="0" />
