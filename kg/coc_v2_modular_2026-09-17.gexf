      <edge source="brics_economic_realignme::crossborder_capital_vol" target="red_sea_hormuz_crisis::financial_market_volatil" id="700">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sharp increases in cross‑border capital flow volatility trigger margin calls, rapid portfolio rebalancing and funding stress that spill into energy and shipping desks, amplifying realized and implied volatility in financial markets sensitive to chokepoint risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="brics_economic_realignme" />
          <attvalue for="39" value="red_sea_hormuz_crisis" />
          <attvalue for="28" value="0" />
