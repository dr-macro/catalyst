        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A persistent increase in the official policy rate raises corporate borrowing costs and tends to appreciate the domestic currency, reducing firms' incentives and financial capacity to finance M&amp;A, greenfield projects or other outbound investment." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_rate_market_shock" />
          <attvalue for="39" value="brics_economic_realignme" />
