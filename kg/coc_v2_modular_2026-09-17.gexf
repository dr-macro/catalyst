          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater short‑term volatility in cross‑border capital flows creates funding uncertainty and investor short‑termism, which pushes firms to prioritize rapid productization and market capture over slower, precautionary safety processes." />
