          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sudden upward revision in expected policy rates triggers accelerated portfolio rebalancing and stop-start flows as global investors reduce duration and shift liquidity across borders, increasing short‑term cross‑border capital flow volatility." />
