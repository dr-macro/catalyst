          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rapid increase in policy rates suppresses demand growth and strengthens safe‑haven currencies (reducing commodity purchasing power), depressing spot and forward energy prices in global markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_rate_market_shock" />
          <attvalue for="39" value="russia_ukraine_warfare" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_market_shock::central_bank_policy_rate" target="us_china_tech_rivalry::model_deployment_rate" id="490">
