          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Improved capacity to evade sanctions (e.g., covert ship‑to‑ship transfers, reflagging, masking AIS) increases clandestine traffic through chokepoints and provokes interdiction attempts and confrontations that raise the frequency of attacks and incidents at those chokepoints." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="39" value="red_sea_hormuz_crisis" />
