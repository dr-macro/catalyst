          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger market expectations of future rate hikes increase anticipated financing and FX costs and raise uncertainty for cross-border M&amp;A and expansion, reducing the pace and intensity of US–China competitive investments and strategic market entries." />
          <attvalue for="37" value="6-18 months" />
