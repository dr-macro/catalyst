        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rise in attacks on energy and transport infrastructure prompts governments to impose emergency regulatory controls, tighter licensing, asset seizures and cybersecurity restrictions to secure critical systems and maintain supply, increasing overall state control intensity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="39" value="brics_economic_realignme" />
