      <edge source="russia_ukraine_warfare::sanctions_severity" target="brics_economic_realignme::external_financial_links" id="53">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="More severe and broader sanctions (banking, SWIFT access, asset freezes) cause foreign correspondent banks, custodians and investors to sever or limit links with targeted counterparties and jurisdictions, directly reducing the strength of external financial connections." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="39" value="brics_economic_realignme" />
