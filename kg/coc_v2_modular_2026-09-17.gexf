          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An increased ability to circumvent sanctions expands use of opaque intermediary channels and nonstandard payment routes, producing episodic flows, rapid reversals and pricing dislocations that raise short-term cross-border capital flow volatility." />
