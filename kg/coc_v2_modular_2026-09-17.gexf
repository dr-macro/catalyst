      <edge source="brics_economic_realignme::crossborder_capital_vol" target="global_rate_market_shock::sovereign_yield_level" id="699">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A surge in cross‑border capital volatility triggers nonresident and domestic investor sell‑offs of sovereign bonds, raising required risk premia and pushing benchmark yields up." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="brics_economic_realignme" />
          <attvalue for="39" value="global_rate_market_shock" />
          <attvalue for="28" value="0" />
