      <edge source="russia_ukraine_warfare::energy_infra_attack_rate" target="global_rate_market_shock::financial_conditions_ind" id="32">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Increased attacks on energy and transport infrastructure raise market volatility, disrupt commodity flows and trade, and widen credit and funding spreads, reducing liquidity and thus tightening overall financial conditions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="39" value="global_rate_market_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
