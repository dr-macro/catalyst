          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Upward revisions to expected future policy rates provoke rapid repricing of asset valuations and risk premia, triggering higher realized and implied volatility across FX, rates and commodity markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_rate_market_shock" />
          <attvalue for="39" value="red_sea_hormuz_crisis" />
          <attvalue for="28" value="0" />
