          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A tightening in aggregate financial conditions raises borrowing costs, depresses VC and growth equity exits, and forces firms to cut or delay capital-intensive AI R&amp;D and infrastructure spending, reducing AI investment flows." />
