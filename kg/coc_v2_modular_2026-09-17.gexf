      <edge source="russia_ukraine_warfare::third_party_support" target="red_sea_hormuz_crisis::maritime_security_risk" id="104">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A surge in external military and political support to Ukraine draws Western naval and ISR assets toward Europe and provokes reciprocal threats by Russia and its proxies, reducing patrol coverage and raising operator and insurer perceptions of risk in the Red Sea/Hormuz area." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="39" value="red_sea_hormuz_crisis" />
