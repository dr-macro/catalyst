          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater third‑party military and technical support to Ukraine strengthens security partnerships and signals capability sharing among Western actors, prompting rival states (notably China) to accelerate AI capability programs and intensify cross‑border strategic competition." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_warfare" />
          <attvalue for="39" value="us_china_tech_rivalry" />
