      <edge source="global_rate_market_shock::financial_conditions_ind" target="red_sea_hormuz_crisis::cargo_rerouting_volume" id="548">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A tightening of financial conditions raises insurance costs and restricts trade finance and liquidity for ship operators, prompting more owners to reroute or delay voyages to avoid higher premiums and cash-flow strain." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_rate_market_shock" />
          <attvalue for="39" value="red_sea_hormuz_crisis" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_market_shock::financial_conditions_ind" target="russia_ukraine_warfare::third_party_support" id="549">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sudden tightening of global financial conditions raises sovereign and corporate borrowing costs and market volatility, causing donor governments and private backers to delay or scale back arms transfers and budgetary aid to the Ukraine theater to avoid additional fiscal stress." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_rate_market_shock" />
          <attvalue for="39" value="russia_ukraine_warfare" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_market_shock::financial_conditions_ind" target="russia_ukraine_warfare::sanctions_severity" id="550">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A pronounced tightening of global financial conditions increases the domestic economic and market costs of additional restrictions for sanctioning states, reducing political willingness to impose broader or deeper sanctions in the near term." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_rate_market_shock" />
          <attvalue for="39" value="russia_ukraine_warfare" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_market_shock::financial_conditions_ind" target="us_china_tech_rivalry::ai_investment_flow" id="551">
        <attvalues>
