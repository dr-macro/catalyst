  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Severe congestion delays deliveries of servers, accelerators, and rack components, forcing project pauses and pushing back data-center and on-prem AI hardware deployments, reducing the pace of infrastructure investment.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">shipping_chokepoints</data>
  <data key="d40">ai_economic_shift</data>
</edge>
<edge source="shipping_chokepoints::chokepoint_congestion" target="russia_ukraine_war::energy_flow_disruption" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Increased congestion at Black Sea, Bosphorus and nearby regional chokepoints forces tankers to queue, delay or detour, directly reducing the volume and reliability of energy exports and transit flows out of Ukraine/Russian-linked routes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">shipping_chokepoints</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="shipping_chokepoints::chokepoint_congestion" target="us_china_tech_trade::component_avail" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Heightened congestion at major maritime chokepoints directly delays incoming shipments of critical electronic components and intermediate goods, reducing on‑hand and pipeline availability at downstream manufacturers.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">shipping_chokepoints</data>
  <data key="d40">us_china_tech_trade</data>
</edge>
