  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Higher congestion concentrates vessel traffic and forces closer-quarter maneuvers and queuing, increasing collisions, groundings, and tense confrontations that raise the incident rate.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">shipping_chokepoints</data>
  <data key="d40">us_iran_standoff</data>
</edge>
<edge source="shipping_chokepoints::chokepoint_congestion" target="us_iran_standoff::oil_flow_through_choke" id="0">
