          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Repeated or high‑profile attacks on merchant shipping in the Strait of Hormuz attributed to Iranian forces or proxies trigger formal protests, sanctions, and reciprocal measures, directly raising diplomatic friction between Germany and Iran/related states." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="germany_industry_transit" />
