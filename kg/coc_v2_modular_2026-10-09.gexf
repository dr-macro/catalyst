          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Large new allocations into AI-compute funds and megafunds divert institutional cash that would otherwise participate in sovereign bond auctions, reducing subscription and cover ratios at French primary auctions." />
