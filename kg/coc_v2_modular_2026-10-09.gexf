      <edge source="germany_industry_transit::info_breach_rate" target="iran_hormuz_escalation::maritime_attack_rate" id="709">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.58" />
          <attvalue for="35" value="A spike in successful breaches of German industry or logistics providers can expose tanker itineraries, cargo manifests, or enforcement patterns, enabling Iranian-linked proxies to pick higher-probability windows/targets and thereby increase maritime attacks in the Strait of Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="germany_industry_transit" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="germany_industry_transit::info_breach_rate" target="russia_ukraine_war::hybrid_attack_activity" id="710">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising information‑security breaches in German industrial and logistics firms leak operational data and/or create footholds that hostile actors can exploit to conduct or facilitate cyber intrusions, sabotage, and covert disruptions tied to the Russia‑Ukraine conflict." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="germany_industry_transit" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
