          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="High reliance on external vendors for sensors, comms and analytics used to monitor the conflict makes key data streams susceptible to supplier restrictions, outages, or covert compromise, reducing verifiable information and increasing opacity about incidents and intentions." />
