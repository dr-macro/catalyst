          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A rise in attacks around the Hormuz region raises routing risk and delays for global maritime container and component shipments, causing production and delivery bottlenecks that temporarily reduce available GPU shipment throughput to major markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
