          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating attacks trigger near‑term risk‑off behaviour among non‑resident asset managers and sovereign wealth funds, causing an outflow or reduced inflows of foreign capital into French bonds and equities as they cut euro‑area exposure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="france_bond_crisis" />
