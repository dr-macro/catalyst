          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="High‑profile breaches at German semiconductor or AI firms that reveal design/IP transfers or Chinese actor access catalyze US policy responses to tighten export controls to prevent further technology leakage." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="germany_industry_transit" />
