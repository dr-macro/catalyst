      <edge source="russia_ukraine_war::hybrid_attack_activity" target="france_bond_crisis::govt_bond_yield" id="49">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in cross‑border hybrid attacks on energy/transport or payments infrastructure elevates growth and inflation uncertainty for France, leading investors to demand higher nominal yields on French government bonds." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="france_bond_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::hybrid_attack_activity" target="germany_industry_transit::info_breach_rate" id="50">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="An uptick in deniable cyber and sabotage operations (malware, supply‑chain intrusions, credential theft and targeted OT attacks) directly raises successful compromises of networks and vendors used by German industry, increasing observed information‑security breaches." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="germany_industry_transit" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::hybrid_attack_activity" target="germany_industry_transit::tech_dependency_level" id="51">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Attribution of disruptive hybrid attacks to vendors or equipment tied to adversary jurisdictions prompts German firms and regulators to accelerate supplier substitution and procurement from trusted partners, directly reducing reliance on those external technology sources." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="germany_industry_transit" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::hybrid_attack_activity" target="iran_hormuz_escalation::maritime_attack_rate" id="52">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified Russian hybrid operations (drones, loitering munitions, cyber/EM techniques) create operational templates and readily transferable systems that Iran and regional proxies imitate or acquire, raising the rate of deniable maritime incidents in the Gulf." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::hybrid_attack_activity" target="us_china_tech_trade::gpu_supply_capacity" id="53">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened hybrid attacks (cyber intrusions, sabotage, strikes on energy/transport nodes) create direct operational interruptions at assembly, test, and distribution nodes for GPU supply chains, reducing short‑term shipment throughput and production output." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
