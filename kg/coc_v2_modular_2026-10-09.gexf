      <edge source="us_china_tech_trade::export_controls_intensit" target="germany_industry_transit::diplomatic_tension" id="455">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A measurable increase in export-control intensity provokes formal protests, retaliatory measures, and negotiation pressure from affected governments and firms, directly escalating bilateral and multilateral diplomatic friction." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="germany_industry_transit" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::export_controls_intensit" target="iran_hormuz_escalation::insurance_freight_rates" id="456">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rapid tightening and enforcement of export controls raises sanctions and compliance risk for firms and insurers involved with China-related supply chains and Gulf trade, prompting insurers and freight underwriters to raise premiums for shipments transiting the Strait of Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::export_controls_intensit" target="russia_ukraine_war::hybrid_attack_activity" id="457">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Stricter export controls directly block transfers of high‑end accelerators and dual‑use components that Russian developers and intermediaries rely on to build AI‑guided drones, electronic warfare kits and advanced targeting software, reducing the rate and sophistication of deniable/hybrid attacks within months." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::export_controls_intensit" target="russia_ukraine_war::escalation_feedback" id="458">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tightening export controls is frequently met with reciprocal political measures, covert procurement attempts and signaling (including cyber or supply‑chain attacks) that create reinforcing cycles of retaliation and counter‑retaliation, strengthening escalation feedback loops in the short term." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_trade" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
