        </attvalues>
      </edge>
      <edge source="iran_hormuz_escalation::maritime_attack_rate" target="russia_ukraine_war::military_force_projectio" id="230">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in hostile incidents in the Gulf compels US/UK/NATO to reassign naval and air assets to escort and protect shipping and to deter regional escalation, directly reducing the scale and tempo of deployable conventional assets available for operations and surge support in the Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
