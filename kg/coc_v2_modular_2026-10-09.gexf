      <edge source="russia_ukraine_war::military_force_projectio" target="france_bond_crisis::cross_border_capflow" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A sustained increase in large‑scale Russian military operations raises regional risk premia and triggers foreign portfolio rebalancing away from French bonds and equities into safer assets, producing net capital outflows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="france_bond_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_force_projectio" target="germany_industry_transit::supply_chain_vuln" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Expanded Russian conventional operations and deployments near maritime and overland transit corridors (Black Sea, Baltic, overland routes) force rerouting, port/route restrictions and higher insurance/lead‑time exposure, directly increasing fragility in German industrial supply chains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="germany_industry_transit" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_force_projectio" target="iran_hormuz_escalation::maritime_attack_rate" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Expanded Russian force projection leads to transfers of long‑range maritime strike systems, munitions and tactical advisers (or the diversion of Russian naval assets) to Iran and its proxies, materially enabling more frequent and higher‑intensity attacks on tankers and maritime infrastructure in the Strait of Hormuz." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_force_projectio" target="us_china_tech_trade::chip_prices" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Expanded conventional force deployments and kinetic operations disrupt key maritime and overland logistics corridors and increase insurance and rerouting costs, directly raising procurement and delivery costs for chips and accelerators and thereby lifting market prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
