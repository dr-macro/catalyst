      <edge source="germany_industry_transit::info_breach_rate" target="france_bond_crisis::bank_funding_stress" id="708">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Widespread cyber breaches affecting German logistics and payments providers cause operational payment interruptions and counterparty losses that transmit liquidity shocks to French banks with direct exposures, increasing their short‑term funding costs and roll‑over stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="germany_industry_transit" />
          <attvalue for="38" value="france_bond_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
