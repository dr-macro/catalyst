      <edge source="russia_ukraine_war::information_opacity" target="france_bond_crisis::auction_primary_demand" id="75">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Greater opacity about incidents and intentions increases uncertainty about tail risks, causing foreign and domestic investors to scale back participation in French sovereign primary auctions until visibility improves." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="france_bond_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
