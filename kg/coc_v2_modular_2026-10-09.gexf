        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in attacks raises Europe-specific geopolitical risk and market volatility, prompting re‑pricing of euro sovereign risk and widening France's credit spread vs safer benchmarks as investors demand a premium for perceived exposure." />
