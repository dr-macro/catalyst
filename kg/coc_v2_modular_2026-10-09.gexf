          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating hostile maritime incidents amplify national-security arguments and political pressure in Washington and allied capitals, prompting faster or stricter export-control measures on sensitive semiconductor and AI hardware flows to adversary states." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="us_china_tech_trade" />
