          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Rising German dependence on external (notably Chinese) tech raises risk for European firms and investors, prompting reallocation of capital into alternative AI compute capacity (often in US‑friendly jurisdictions), increasing flows into AI compute outside China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="germany_industry_transit" />
          <attvalue for="38" value="us_china_tech_trade" />
