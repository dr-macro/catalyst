      <edge source="france_bond_crisis::bank_funding_stress" target="germany_industry_transit::supply_chain_vuln" id="629">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="When French banks face funding stress they curtail trade finance, letters of credit and short-term working‑capital lending to exporters, importers and logistics firms, causing immediate liquidity-driven disruptions and delays in cross‑border goods flows that increase vulnerability in German industrial supply chains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="france_bond_crisis" />
          <attvalue for="38" value="germany_industry_transit" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="france_bond_crisis::bank_funding_stress" target="russia_ukraine_war::information_opacity" id="630">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Funding stress at major French banks degrades transaction monitoring and slows interbank/INTEL information sharing (including sanctions screening and SWIFT messaging responsiveness), making it harder for external observers to verify incidents and financial links related to the conflict." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="france_bond_crisis" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="france_bond_crisis::bank_funding_stress" target="us_china_tech_trade::foundry_fab_capacity" id="631">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Elevated funding stress at French banks leads those banks and syndicates to cut or delay project and equipment lending for European fab expansions and suppliers, postponing capex and reducing near‑term wafer throughput." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="france_bond_crisis" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
