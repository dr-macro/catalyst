      <edge source="russia_ukraine_war::information_opacity" target="iran_hormuz_escalation::insurance_freight_rates" id="76">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="High opacity around incidents and attributions in the Russia–Ukraine theater increases insurers' model uncertainty and tail‑risk premia, producing immediate upward pressure on marine insurance and freight surcharges for vessels operating in the Gulf even absent new local attacks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::information_opacity" target="us_china_tech_trade::capital_flow_to_ai_compu" id="77">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater opacity around incidents and intentions increases investor uncertainty about geopolitical and regulatory risk for large‑scale compute projects, causing financiers to delay or withdraw capital allocations to AI compute deployments tied to cross‑border supply chains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
