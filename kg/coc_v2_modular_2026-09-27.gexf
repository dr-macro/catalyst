          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in global long-term yields increases borrowing costs and fiscal strain for Western donor governments, making sustained high-level military support for Ukraine politically and financially harder and thereby causing Russian decision‑makers to perceive a greater window to escalate." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="russia_ukraine_security" />
          <attvalue for="27" value="0" />
