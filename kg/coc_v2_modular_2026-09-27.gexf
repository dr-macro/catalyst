          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising long-term sovereign yields raise discount rates and borrowing costs for long‑duration projects, which directly reduces bank lending and investor appetite for large, capital‑intensive data centers and cloud buildouts, lowering net financing flows into AI infrastructure." />
          <attvalue for="36" value="6-18 months" />
