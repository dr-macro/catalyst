          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Heightened regulatory scrutiny and export controls on weaponized/automated AI slow procurement and deployment of autonomous targeting systems, reducing the achievable operational tempo and destructive power of strikes." />
