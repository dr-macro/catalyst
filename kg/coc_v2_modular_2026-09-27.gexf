      <edge source="us_china_rivalry::strategic_tension_level" target="ai_buildout_risks::regulatory_scrutiny" id="67">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising high‑level geopolitical tensions politicize AI as a national‑security issue, triggering legislative hearings, agency reviews and new oversight initiatives that increase sustained regulatory scrutiny intensity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="ai_buildout_risks" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::strategic_tension_level" target="global_bond_repricing::bond_market_liquidity" id="68">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating strategic tensions increase counterparty, settlement and sanction risk, prompting dealers and cross‑border investors to withdraw or scale back market‑making activity and widening bid‑ask spreads, thereby reducing sovereign bond market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::strategic_tension_level" target="iran_gulf_conflict::attack_incident_rate" id="69">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising U.S.–China strategic tensions prompt the U.S. to redeploy naval and air assets toward the Indo‑Pacific and reduce persistent Gulf deterrence, which Iran and its proxy groups interpret as an opening and consequently increase maritime attacks on vessels and infrastructure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::strategic_tension_level" target="iran_gulf_conflict::maritime_access_level" id="70">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating friction between Washington and Beijing produces increased bilateral naval shadowing, escort missions, and occasional confrontations in chokepoints that generate episodic contestation or temporary restrictions on commercial passage." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::strategic_tension_level" target="russia_ukraine_security::military_strike_intensit" id="71">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising high‑level US–China tensions divert Western political and operational attention to the Indo‑Pacific (and create perceived windows of lower Western focus), which Moscow exploits to increase tempo and scale of conventional strikes in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_rivalry" />
          <attvalue for="38" value="russia_ukraine_security" />
          <attvalue for="27" value="0" />
        </attvalues>
