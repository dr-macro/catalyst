          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating US–China rivalry raises policymakers' and publics' sense that great‑power competition could spill into other theatres, heightening perceived risk that the Russia–Ukraine war could broaden or provoke wider involvement." />
