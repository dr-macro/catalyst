      <edge source="global_bond_repricing::cross_border_flows" target="energy_asset_realloc::capital_inflows_oil" id="510">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="An increase in net cross‑border inflows expands available foreign equity and syndicated debt, enabling sponsors and banks to fund or complete upstream and midstream oil investments and thereby raising capital directed to the oil sector." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="energy_asset_realloc" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_repricing::cross_border_flows" target="russia_ukraine_war::weapons_transfer_rate" id="511">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rapid cross‑border outflows reduce liquidity for banks, defence contractors and intermediary financiers and constrain donor governments' ability to bridge payments, causing delays or reductions in weapons deliveries to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_repricing::cross_border_flows" target="us_china_tech_trade::ai_investment_flow" id="512">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Larger net cross-border capital inflows directly increase available venture, private equity and infrastructure financing as well as cross‑border M&amp;A liquidity, boosting the rate of capital deployment into AI companies and projects." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_repricing::cross_border_flows" target="us_iran_confront::international_clearing_a" id="513">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sudden net outflows reduce correspondent-bank liquidity and raise perceived counterparty risk, prompting international banks to curtail or suspend clearing and payment services to regionally linked/sanction‑exposed banks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_repricing::cross_border_flows" target="us_iran_confront::oil_export_rate" id="514">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained capital outflows erode trade finance and working‑capital lines for exporters and their buyers (independent of formal clearing relationships), causing shipment delays and reduced crude export volumes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
