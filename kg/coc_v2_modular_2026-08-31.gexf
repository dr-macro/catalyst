          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher perceived escalation increases the probability of major energy/commodity shocks or prolonged supply disruption, which pushes up inflation expectations and leads markets to price a higher short‑term policy‑rate path." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_repricing" />
