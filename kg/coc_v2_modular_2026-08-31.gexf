          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher perceived escalation drives multilateral denial policies plus private‑sector de‑risking (insurance, equipment vendors, finance) that restrict shipment of advanced semiconductor tools and investment into Chinese fabs, reducing China's producible chip capacity over the near term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
