          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp spikes in cross‑market volatility raise near‑term risk perceptions among governments and militaries, prompting precautionary increases in readiness, forward presence and deployments to deter opportunistic escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="russia_ukraine_war" />
