          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Spikes in market volatility raise price and counterparty risk, leading traders and buyers to reduce spot purchases and shippers to delay loadings, which curtails short‑term crude export volumes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="energy_asset_realloc" />
