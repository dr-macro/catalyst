          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Targeted sanctions and tighter enforcement disrupt payment flows and spare‑parts shipments for fabs that rely on suppliers linked to sanctioned energy firms, forcing temporary slowdown or idling of production lines." />
