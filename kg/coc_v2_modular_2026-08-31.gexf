          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising perceptions that the Russia–Ukraine war could escalate prompt governments to tighten export controls, investment screening and sanctions coverage for dual‑use AI and semiconductor technologies to prevent transfer to adversaries, raising regulatory strictness on US–China tech flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
