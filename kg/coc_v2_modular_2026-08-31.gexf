          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter, more comprehensive enforcement of trade, financial and asset restrictions severs procurement channels, payment rails and logistics used to buy and ship weapons and critical components, reducing the tempo and volume of transfers to front‑line users." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_asset_realloc" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
