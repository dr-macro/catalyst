          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Stricter sanction enforcement raises counterparty, correspondent‑bank and secondary‑sanctions risk, causing foreign banks and investors to curtail lending, portfolio placements and FX settlement with the jurisdiction, directly reducing net cross‑border capital inflows." />
          <attvalue for="36" value="0-6 months" />
