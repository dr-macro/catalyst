          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharper Western sanctions on Iran push Tehran toward deeper security cooperation with Moscow (including expedited transfers of drones, components, and advisory support), raising the tempo of lethal transfers into the Russia–Ukraine theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::sanctions_intensity" target="us_china_tech_trade::regulatory_stringency" id="31">
