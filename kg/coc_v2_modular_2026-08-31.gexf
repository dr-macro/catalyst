          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating US sanctions on Iran triggers allied governments and export-control agencies to broaden and tighten dual‑use and end‑use screening (including tech export rules), raising regulatory strictness applied to AI-relevant trade with China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="us_china_tech_trade" />
