          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher intensity of sanctions narrows the eligible investor base and increases required risk premia for remaining bidders, forcing sovereign debt auctions to clear at higher yields to attract demand." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_asset_realloc" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
