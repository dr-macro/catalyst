          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved operational and political coordination among Western allies leads to pooled procurement, coordinated R&amp;D programs and subsidy packages aimed at sustaining an edge in AI, channeling additional public and private capital into allied AI startups, infrastructure and defense‑oriented AI R&amp;D." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
