          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A sharp increase in sanctions raises legal and counterparty risk and transaction costs for banks and private investors, prompting lenders and equity providers to suspend or withdraw financing for upstream and midstream oil projects." />
          <attvalue for="36" value="0-6 months" />
