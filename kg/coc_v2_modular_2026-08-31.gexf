          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sharper enforcement of sanctions on energy actors raises counterparty and payment‑risk for banks and VCs, prompting them to cut or delay cross‑border AI funding and FDI into counterparties tied to sanctioned jurisdictions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_asset_realloc" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
