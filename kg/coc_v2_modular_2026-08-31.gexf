          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising expectations of rapid escalation increase sovereign and project risk premia and prompt lenders, insurers and equity providers to delay or withdraw financing for upstream/midstream oil projects." />
