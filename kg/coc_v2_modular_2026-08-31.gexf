          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating sanctions raise compliance and counterparty risk for banks and asset managers, prompting immediate withdrawal or rerouting of cross-border capital and net outflows from affected emerging-market fixed-income and related funds." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confront" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
