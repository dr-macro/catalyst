          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute spikes in market volatility spur regulatory and political pressure to shore up strategic sectors, prompting quicker imposition or tightening of export controls, investment screens, and tech oversight aimed at stabilizing markets and protecting domestic capabilities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_repricing" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="27" value="0" />
