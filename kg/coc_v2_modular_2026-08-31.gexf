          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Strengthened allied coordination and credible burden‑sharing commitments reduce sovereign risk premia for front‑line and support countries, lowering sovereign yields across the curve as investors require less compensation for political tail risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="27" value="0" />
