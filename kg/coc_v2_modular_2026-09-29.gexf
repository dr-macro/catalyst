          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Heightened contestation or attacks in Middle Eastern maritime chokepoints trigger emergency trade measures, stricter routing rules and provisional export controls by the US and partners, producing immediate unpredictability in rules governing trade and strategic-technology flows between the US and China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
