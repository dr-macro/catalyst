          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_ai_governance::safety_incident_rate" target="global_bond_stress::market_liquidity" id="601">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="High-frequency or widely publicized AI safety incidents trigger rapid risk-off moves and concentrated selling in AI-exposed instruments, causing market-makers to widen spreads and reduce depth, thereby worsening liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_ai_governance" />
          <attvalue for="39" value="global_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_ai_governance::safety_incident_rate" target="russia_ukraine_war::drone_use_intensity" id="602">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rise in AI safety incidents (misidentifications, unintended strikes, communication failures) produces immediate operational risk and loss of trust among commanders, prompting temporary grounding, stricter human-in-the-loop requirements, or reduced mission profiles for drone units." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_ai_governance" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_ai_governance::safety_incident_rate" target="us_china_rivalry::security_tension_level" id="603">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="High-profile AI safety failures—especially involving surveillance, autonomy in critical infrastructure, or military-adjacent systems—produce mutual accusations, emergency policy responses, and force-posturing that raise perceived military and strategic risk between the US and China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_ai_governance" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_ai_governance::safety_incident_rate" target="us_iran_standoff::escalation_perception" id="604">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A spike in AI safety incidents (e.g., autonomous systems misfiring, misattributed cyber operations or false alarms) increases uncertainty and attribution risk between Washington and Tehran, making policymakers and publics judge a military escalation as more likely." />
          <attvalue for="37" value="0-6 months" />
