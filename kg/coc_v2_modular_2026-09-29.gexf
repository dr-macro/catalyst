          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Intensified AI-related regulatory scrutiny in major supplier states spurs export controls, licensing bottlenecks, and tighter vetting of compute/hardware transfers, directly delaying deliveries of components and software used in military and commercial supply chains affecting the conflict zone." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_ai_governance" />
          <attvalue for="39" value="russia_ukraine_war" />
