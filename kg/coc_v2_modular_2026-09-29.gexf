      <edge source="global_bond_stress::cross_asset_spillover" target="global_ai_governance::regulatory_scrutiny" id="848">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="When shocks rapidly transmit from bonds to equities and tech sectors, visible linkages between AI companies and systemic market stress prompt policymakers and watchdogs to initiate inquiries and tighten oversight of AI practices and market conduct." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_stress" />
          <attvalue for="39" value="global_ai_governance" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_stress::cross_asset_spillover" target="us_china_rivalry::diplomatic_signaling" id="849">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="When shocks in one asset class rapidly transmit to equities, FX and credit across US–China exposures, governments and central banks escalate visible public communications and gestures (statements, coordinated releases, reputational assignment) to calm markets and influence counterpart behavior, raising diplomatic signaling intensity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_stress" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_stress::cross_asset_spillover" target="us_iran_standoff::chokepoint_security" id="850">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger and faster cross-asset spillovers transmit shocks from oil and insurance markets into shipping costs and insurer capacity, raising transit risk and observable contestation around maritime chokepoints and thereby degrading chokepoint security." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_stress" />
