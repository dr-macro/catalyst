      <edge source="global_ai_governance::model_autonomy_level" target="russia_ukraine_war::drone_use_intensity" id="588">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher average autonomy in deployed models reduces operator workload and enables more reliable autonomous targeting, swarming, and sortie management, which militaries accelerate to increase drone operational tempo and deployment rates in the Russia–Ukraine theater." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_ai_governance" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_ai_governance::model_autonomy_level" target="us_china_rivalry::security_tension_level" id="589">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A demonstrable rise in deployed AI autonomy narrows decision cycles and increases misperception risk, prompting defensive measures (e.g., tighter rules of engagement, deployment of countermeasures) that elevate strategic-security tensions between the two powers." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_ai_governance" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_ai_governance::model_autonomy_level" target="us_iran_standoff::chokepoint_security" id="590">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher deployed autonomy in naval and aerial systems enables more frequent, harder-to-interdict swarm/loitering harassment and remote attacks around the Strait of Hormuz and nearby lanes, degrading operational security of those chokepoints." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_ai_governance" />
          <attvalue for="39" value="us_iran_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
