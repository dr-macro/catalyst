          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating, unpredictable export controls and cross‑border compliance rules tied to the rivalry cause venture funds and corporate investors to delay, divert, or withhold capital from AI startups and projects exposed to bilateral trade or sanction risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_ai_governance" />
