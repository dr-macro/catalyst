      <edge source="russia_ukraine_war::drone_use_intensity" target="global_ai_governance::model_autonomy_level" id="63">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained high operational tempo and attrition of remotely piloted systems in the conflict forces militaries and prime contractors to field drones with higher on-board decision-making (route/target selection, collision avoidance) to maintain effectiveness, raising the average autonomy level of deployed models." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_ai_governance" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::drone_use_intensity" target="us_china_rivalry::regulatory_uncertainty" id="64">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rapid battlefield adoption and export of armed and dual‑use UAV capabilities in Ukraine triggers new U.S. export controls, stricter export licensing and allied technology screening aimed at China, increasing unpredictability of trade and tech rules between the U.S. and China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
