          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising US–China regulatory uncertainty (export controls, sanctions on Chinese entities) incentivizes US authorities to expand secondary sanctions and compliance enforcement targeting China‑Iran trade networks, increasing overall sanctions pressure on Iranian-linked actors." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_rivalry" />
