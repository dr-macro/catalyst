          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rise in US–China strategic tensions increases US and regional policymakers' threat perceptions and lowers tolerance for simultaneous crises, so any Iranian provocation is judged likelier to spiral into military escalation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="us_iran_standoff" />
