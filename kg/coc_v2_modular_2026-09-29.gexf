      <edge source="us_iran_standoff::escalation_perception" target="global_ai_governance::regulatory_scrutiny" id="472">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A spike in perceived risk of military escalation prompts legislators and security agencies to fast-track tighter AI-related export controls, procurement rules and oversight (especially for dual‑use and defense-adjacent systems), raising overall regulatory attention and intervention." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="global_ai_governance" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::escalation_perception" target="global_ai_governance::model_autonomy_level" id="473">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising fears of kinetic confrontation push militaries and contractors to prioritize and fund more autonomous sensing, targeting and navigation systems to operate in contested environments, increasing the average autonomy of deployed models." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="global_ai_governance" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::escalation_perception" target="global_bond_stress::market_liquidity" id="474">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sudden rise in perceived probability of military escalation causes market-makers and principal liquidity providers to pull back and widen spreads, reducing depth and increasing transaction costs across fixed-income and FX markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="global_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::escalation_perception" target="russia_ukraine_war::kinetic_conf_intensity" id="475">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A sharp rise in perceived risk of US–Iran military escalation prompts US and NATO to reassign forces and air/missile-defense assets toward the Middle East and reduces Western operational focus, creating opportunities for Russia to intensify conventional operations in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::escalation_perception" target="us_china_rivalry::security_tension_level" id="476">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rising perception of imminent US–Iran military escalation causes the US to surge naval and air deployments and readiness plans that force China to increase patrols, contingency planning and military signaling in response, directly raising bilateral security tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
