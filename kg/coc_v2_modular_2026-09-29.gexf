        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Improved market liquidity reduces trade‑finance and commodity‑hedging costs and makes it easier to roll financing for tankers and traders, increasing the likelihood that crude and product cargoes are shipped on schedule and raising realized export flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_stress::market_liquidity" target="us_china_rivalry::regulatory_uncertainty" id="820">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sharp deterioration in market liquidity produces large, disorderly price moves in cross-border positions and prompts authorities to introduce emergency trading rules, reporting requirements or capital-flow measures directed at foreign/strategic investments, increasing regulatory unpredictability in the US–China policy space." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_stress" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_stress::market_liquidity" target="us_iran_standoff::escalation_perception" id="821">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sharp deterioration in market liquidity increases the likelihood that any military flare-up will trigger outsized asset-price dislocations and funding stress, which incentivizes US policymakers and regional actors to avoid kinetic actions and therefore lowers near-term perceptions of imminent escalation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_stress" />
