          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Heightened insecurity at maritime choke points raises demand for AI-enabled maritime ISR, autonomous vessels, and logistics-optimization tools, redirecting private and defense-related capital into AI startups and projects addressing those needs." />
          <attvalue for="37" value="6-18 months" />
