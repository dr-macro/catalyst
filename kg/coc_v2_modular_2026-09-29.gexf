          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Deterioration of security in major maritime chokepoints raises near-term oil-price risk and expected headline inflation, prompting markets to re-price toward a higher path of central-bank policy rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="global_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::chokepoint_security" target="russia_ukraine_war::oil_export_flow" id="441">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Worsening security at Gulf/Red Sea chokepoints (attacks, closures, insurance pullback) forces rerouting, reduces tanker throughput and effective export capacity, and thereby lowers global oil export flows relevant to markets that also affect the Russia–Ukraine theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::chokepoint_security" target="us_china_rivalry::regulatory_uncertainty" id="442">
