      <edge source="us_china_rivalry::security_tension_level" target="global_ai_governance::model_autonomy_level" id="266">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising US–China security frictions prompt accelerated military procurement and defense R&amp;D for stand‑off and decision‑support systems, leading firms and states to deploy AI with greater on‑platform autonomy to meet contested operational requirements." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_ai_governance" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::security_tension_level" target="global_ai_governance::regulatory_scrutiny" id="267">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Elevated strategic security concerns drive governments to expand export controls, national security reviews, and procurement restrictions on AI technologies, producing a measurable uptick in regulatory attention and enforcement actions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_ai_governance" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::security_tension_level" target="global_bond_stress::market_liquidity" id="268">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Acute rises in military/security tensions (e.g., Taiwan strait incidents or South China Sea confrontations) prompt market-makers and principal liquidity providers to pull back, widen quoted spreads and raise internal risk limits, materially reducing depth and increasing execution costs." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::security_tension_level" target="russia_ukraine_war::kinetic_conf_intensity" id="269">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising US–China security tensions pull US/Western operational focus and some high-end assets toward the Indo‑Pacific and induce more cautious or delayed Western force-projection and materiel flows to Europe, which Russia can exploit to increase conventional operations in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::security_tension_level" target="us_iran_standoff::escalation_perception" id="270">
