      <edge source="russia_ukraine_war::kinetic_conf_intensity" target="global_ai_governance::regulatory_scrutiny" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sharp escalations producing cross-border strikes, civilian casualties, or novel weapon effects prompt near-term government emergency reviews and expansion of export controls and oversight specifically targeting dual‑use AI capabilities and procurement rules." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_ai_governance" />
          <attvalue for="28" value="0" />
        </attvalues>
