      <edge source="us_iran_standoff::sanctions_pressure_level" target="russia_ukraine_war::drone_use_intensity" id="421">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating sanctions on Iran push Tehran to deepen military-technical sales and barter with partners (notably Russia) as revenue and leverage avenues, increasing transfers of armed/UAS systems that raise drone employment in the Ukraine theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
