      <edge source="us_china_rivalry::regulatory_uncertainty" target="global_bond_stress::long_term_yields" id="336">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalating, unpredictable trade and technology regulations (export controls, blacklists, investment bans) raise sovereign and currency risk premia and prompt foreign holders to reduce duration exposure, pushing up long-term government bond yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
