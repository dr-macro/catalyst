          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Heightened regulatory scrutiny that raises compliance costs and slows deployment of productivity-enhancing AI dampens growth and inflation outlooks, leading markets to price a lower expected path for short-term policy rates." />
