      <edge source="russia_ukraine_war::kinetic_conf_intensity" target="global_bond_stress::cross_asset_spillover" id="35">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A marked escalation in kinetic operations generates abrupt re-pricing across commodities, equity risk premia and FX (via supply shocks, sanctions and risk sentiment), increasing the speed and magnitude with which shocks transmit between asset classes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_conf_intensity" target="us_china_rivalry::security_tension_level" id="36">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sustained high-intensity conventional fighting forces the U.S. to deepen alliance coordination, forward deployments, and contingency planning (and prompts reciprocal Chinese military/diplomatic responses), directly raising perceived strategic risk and bilateral security friction." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_conf_intensity" target="us_iran_standoff::coalition_cohesion" id="37">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A surge in kinetic operations in Ukraine forces the US and its partners to reallocate military assets, political attention, and intelligence collection toward Europe, reducing time, presence, and operational coordination available to sustain tight alignment among regional actors confronting Iran." />
