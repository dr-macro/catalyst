          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained elevation of US–China security frictions drives temporary redeployment and prioritization of naval and air assets to the Indo‑Pacific, reducing persistent US presence and interdiction capacity around Persian Gulf chokepoints and thereby degrading chokepoint security." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
