          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Broader and tighter sanctions tied to the US–Iran standoff increase banking, insurance and logistics frictions for regional trade, producing knock-on interruptions and delays in international procurement and transport links that feed into supply chains connected to the Russia–Ukraine conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
