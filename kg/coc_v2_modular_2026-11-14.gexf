      <edge source="global_financial_stress::investor_risk_aversion" target="euro_security_autonomy::corporate_restructuring" id="667">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher investor risk aversion reduces available equity and debt financing and raises refinancing pressure, prompting firms to accelerate asset sales, workforce reductions, mergers or reorganizations to survive financing stress." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="euro_security_autonomy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_stress::investor_risk_aversion" target="euro_security_autonomy::supply_vulnerability" id="668">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="When investors shun riskier cross-border suppliers and small upstream firms, those suppliers lose finance and exit or consolidate, increasing concentration of sources and thus supply-chain vulnerability for downstream manufacturers." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="euro_security_autonomy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_stress::investor_risk_aversion" target="iran_regional_escalation::sanction_pressure_level" id="669">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A jump in investor risk aversion prompts banks, insurers and commodity traders to de‑risk by exiting or refusing Iran‑linked transactions and services, effectively increasing the intensity and scope of sanction‑style restrictions on energy trade." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_stress::investor_risk_aversion" target="russia_ukraine_war::military_support_flow" id="670">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increase in investor risk aversion depresses valuations and cash flows for defense suppliers and squeezes donor fiscal positions, prompting governments and private donors to cut back or delay military assistance shipments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
