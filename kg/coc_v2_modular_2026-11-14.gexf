      <edge source="iran_regional_escalation::crude_price_level" target="euro_security_autonomy::industrial_investment" id="404">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained increases in crude prices raise operating and input costs for energy‑intensive sectors, prompting firms to delay, cancel or downscale new capital projects and shift CAPEX toward energy efficiency rather than expansion, reducing industrial investment flows." />
