          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A rise in effective project financing costs immediately increases hurdle rates for capital projects and causes corporate and public sponsors to delay or cancel planned industrial capex, reducing the flow of new industrial investment." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="euro_security_autonomy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_stress::project_financing_cost" target="iran_regional_escalation::producer_output_rate" id="685">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher effective costs of long‑term financing raise breakevens for development and maintenance projects, causing producers to postpone or cancel drilling and capex, which lowers production growth and aggregate output rates over the medium term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_stress::project_financing_cost" target="russia_ukraine_war::military_support_flow" id="686">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising project financing costs increase the price and delay of long‑lead procurement and aid‑funded industrial projects (e.g., ammunition plants, vehicle production), slowing the rate at which external materiel and capability are delivered to the conflict zone." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
