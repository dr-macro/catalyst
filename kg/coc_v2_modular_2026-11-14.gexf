          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A rise in inbound military materiel and dual‑use shipments into the conflict creates additional physical flows, intermediaries, and black‑market channels that smugglers and brokers can exploit to divert controlled chips via secondary markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
