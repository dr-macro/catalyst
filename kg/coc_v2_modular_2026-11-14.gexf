      <edge source="russia_ukraine_war::sanctions_intensity" target="russia_ukraine_war::political_polarization" id="238">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="2" />
          <attvalue for="32" value="+" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="euro_security_autonomy::policy_adjustment_rate" id="239">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Ratcheting sanctions on Russia create immediate fiscal and regulatory pressure (energy price shocks, inflation, business dislocations) that force European governments to deploy emergency policy measures (subsidies, price caps, export controls, rapid regulatory changes), accelerating the pace of policy adjustments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="euro_security_autonomy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="global_financial_stress::market_liquidity" id="240">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Intensified sanctions and secondary‑sanctions risk on Russian banks and counterparties restrict correspondent banking and dollar clearing lines, increasing counterparty fragmentation and reducing depth and turnover in FX, bond and credit markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="global_financial_stress::policy_rate_expectation" id="241">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Broader and tighter sanctions disrupt energy and commodity supplies and logistics, pushing commodity prices and near‑term inflation expectations higher and causing markets to anticipate tighter central‑bank policy." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="iran_regional_escalation::tanker_positioning_rate" id="242">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Escalation of sanctions on Russian energy and shipping raises insurance and chartering risk for vessels tied to Russia, forcing charterers to reflag, reroute or redeploy tankers and increasing repositioning activity across global routes that include Middle Eastern corridors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="iran_regional_escalation::sanction_pressure_level" id="243">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Wider and more intrusive sanctions architectures and enforcement practices developed for Russia are adopted or extended by policymakers and enforcement agencies to target intermediaries and trade flows linked to Iran, increasing cumulative sanction pressure on Iranian energy transactions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="us_china_tech_rivalry::adv_chip_flow_rate" id="244">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter and broader sanctions raise compliance costs and legal risk for suppliers and banks, prompting exporters and intermediaries to proactively restrict shipments of advanced semiconductors, reducing cross‑border flows to high‑risk jurisdictions including China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="us_china_tech_rivalry::reexport_leakage_risk" id="245">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating sanctions incentivize sanctioned actors to route procurement through third‑country intermediaries and shell companies, increasing the use of re‑exports and the probability that controlled hardware is diverted to restricted end users." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
