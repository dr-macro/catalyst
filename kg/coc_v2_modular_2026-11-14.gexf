        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_balance" target="euro_security_autonomy::industrial_investment" id="220">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A shift in the military balance toward a greater Russian capability raises European threat perceptions and defense procurement commitments, prompting increased private and public capital expenditures into domestic defense and heavy industry capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="euro_security_autonomy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_balance" target="global_financial_stress::project_financing_cost" id="221">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A shift in military balance that increases the likelihood of a prolonged or regionally expanded conflict raises sovereign and supply‑risk premia for long‑dated infrastructure and tech projects, leading lenders to charge higher spreads and push up blended financing costs." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_balance" target="iran_regional_escalation::crude_price_level" id="222">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An improvement in Russia's military balance (greater ability to secure export infrastructure and maintain output) reduces physical disruption risk and market risk premia for Russian supplies, lowering benchmark crude prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_balance" target="us_china_tech_rivalry::congressional_scrutiny" id="223">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A deterioration in the battlefield balance (adversary gains) heightens perceived strategic vulnerability among lawmakers, triggering more frequent hearings and oversight focused on technology transfers and corporate links to geopolitical competitors." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
