      <edge source="russia_ukraine_war::military_support_flow" target="euro_security_autonomy::supply_vulnerability" id="231">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increased external military support to one side tends to provoke retaliatory strikes or escalatory measures (targeting energy, transport, or port infrastructure) that raise the likelihood of disruptions and concentrated chokepoints for European supply chains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="euro_security_autonomy" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_support_flow" target="global_financial_stress::investor_risk_aversion" id="232">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A marked increase in external military support raises the assessed probability of escalation and a longer, more destructive conflict, prompting investors to move into safe assets and demand higher risk premia on risky assets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_support_flow" target="us_china_tech_rivalry::reexport_leakage_risk" id="233">
