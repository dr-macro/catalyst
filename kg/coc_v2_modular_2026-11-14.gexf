          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sudden decline in financial market liquidity tightens trade finance and working capital for traders, leading them to consolidate cargoes and delay or cancel tanker redeployments, reducing the rate of tanker repositioning and route adjustments." />
          <attvalue for="36" value="0-6 months" />
