          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A rise in investor risk aversion causes rapid de‑risking and forced sales of AI/semiconductor equities and funds, directly lowering aggregate investor confidence in AI assets and raising discount rates for those companies." />
