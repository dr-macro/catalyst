      <edge source="euro_security_autonomy::supply_vulnerability" target="iran_regional_escalation::tanker_positioning_rate" id="525">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Reducing Europe's supply-chain vulnerability (diversifying suppliers/routes and enlarging stocks) lowers the need for emergency rerouting and ad hoc tanker redeployments tied to Persian Gulf shipments, decreasing tanker positioning activity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="euro_security_autonomy" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="euro_security_autonomy::supply_vulnerability" target="russia_ukraine_war::military_support_flow" id="526">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Higher supply-chain vulnerability (more chokepoints or single-source inputs) leads to production and transport disruptions that directly delay or reduce deliveries of weapons, ammunition and sustainment supplies to Ukrainian forces." />
