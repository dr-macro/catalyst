          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sudden drop in market liquidity tightens trade finance and working-capital access for manufacturers, forcing cutbacks in input purchases and production runs and thereby lowering manufacturing output within weeks to months." />
