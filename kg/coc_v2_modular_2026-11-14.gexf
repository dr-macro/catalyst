          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sustained jump in benchmark crude raises near‑term headline inflation and inflation expectations, causing markets to price in faster or larger central‑bank tightening." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
