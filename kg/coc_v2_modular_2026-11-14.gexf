      <edge source="euro_security_autonomy::supply_vulnerability" target="global_financial_stress::investor_risk_aversion" id="524">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An acute rise in Europe’s supply‑chain vulnerability produces frequent production shocks and earnings volatility for exposed firms, driving up risk premia as investors shift toward safer assets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="euro_security_autonomy" />
          <attvalue for="38" value="global_financial_stress" />
