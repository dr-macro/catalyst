          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rise in crude benchmark prices driven by Iran-related risk premiums increases Russian hydrocarbon export revenues and fiscal space, enabling higher defense procurement and sustainment that shifts the military capability balance in Russia's favor." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
