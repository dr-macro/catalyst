          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Larger onshore and nearshore hydrocarbon inventories provide a buffer that can be drawn down to cover production or transit outages, directly lowering the observed rate of supply disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_ris" />
          <attvalue for="39" value="china_eu_trade_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_supply_ris::storage_inventory_volume" target="iran_proxy_escalation::trade_restrictions_level" id="398">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rapid draws in global storage inventories prompt consuming and transit states to impose export restrictions, rationing or priority allocation rules to preserve domestic supplies, increasing the overall level of trade restrictions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_ris" />
          <attvalue for="39" value="iran_proxy_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
