          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Spikes in tanker charter rates raise uncertainty about delivery timing and costs, increasing basis risk and hedging activity which amplifies price swings and financial market volatility in the short term." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_ris" />
          <attvalue for="39" value="ai_compute_chip_race" />
