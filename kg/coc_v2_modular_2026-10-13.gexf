          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp increases in market uncertainty lead producers, traders and carriers to pull back on forward commitments and run down inventories, producing tangible interruptions in delivery schedules and localized shortages that disrupt the steady flow of energy deliveries between suppliers and EU/Asian buyers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
