          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Increased frequency of successful attacks on production, pipelines, terminals or export facilities directly removes physical export capacity and interrupts shipping routes, immediately lowering aggregate crude movement through the system." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_supply_ris" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
