          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Reductions in Russia-related hydrocarbon flows (pipeline outages, export curbs) tighten immediate physical availability in global markets, driving benchmark crude and diesel prices up within weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_proxy_escalation" />
          <attvalue for="28" value="0" />
