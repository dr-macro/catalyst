      <edge source="china_eu_trade_rivalry::tanker_attack_risk" target="global_energy_supply_ris::tanker_charter_rate" id="748">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Higher perceived risk of hostile actions against tankers tied to China–EU rivalry raises insurance and security costs and shrinks available safe-flag capacity, driving up the cost to charter vessels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_eu_trade_rivalry" />
          <attvalue for="39" value="global_energy_supply_ris" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
