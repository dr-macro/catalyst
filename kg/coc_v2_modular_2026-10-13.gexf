          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Declines in overland or proximate seaborne Russian supply force rerouting of tankers onto chokepoints and longer routes, concentrating traffic and raising opportunities for Iran-linked proxies to harass, seize or attack vessels and terminals." />
