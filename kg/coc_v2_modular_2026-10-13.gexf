      <edge source="global_energy_supply_ris::storage_inventory_volume" target="russia_ukraine_war::market_uncertainty" id="399">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher onshore and nearshore hydrocarbon stocks reduce ambiguity about near-term supply availability and buffer against shocks, thereby lowering collective market uncertainty among traders and policymakers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_ris" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
