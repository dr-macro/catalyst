      <edge source="ai_compute_chip_race::route_security_risk" target="china_eu_trade_rivalry::tanker_attack_risk" id="559">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising assessed risk along key sea lanes prompts opportunistic state and non‑state actors to target lightly escorted tankers and raises the measured probability of attacks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_compute_chip_race" />
          <attvalue for="39" value="china_eu_trade_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_compute_chip_race::route_security_risk" target="china_eu_trade_rivalry::trade_flow_volume" id="560">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Higher route security risk forces shippers to reroute, slow transit, and pay much higher insurance/premiums, directly reducing the volume of energy cargoes moved between regions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_compute_chip_race" />
          <attvalue for="39" value="china_eu_trade_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_compute_chip_race::route_security_risk" target="global_energy_supply_ris::crude_flow_rate" id="561">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rising security risks (attacks, mines, seizures or interdictions) cause port closures, convoying, rerouting around longer corridors and temporary shut-ins, directly reducing the physical throughput of crude shipments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_compute_chip_race" />
          <attvalue for="39" value="global_energy_supply_ris" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_compute_chip_race::route_security_risk" target="global_energy_supply_ris::oil_spot_price_level" id="562">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Elevated route risks generate an immediate supply-risk premium and anticipatory buying (and insurance surcharges), pushing up spot prices even before large physical flow reductions materialize." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_compute_chip_race" />
          <attvalue for="39" value="global_energy_supply_ris" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_compute_chip_race::route_security_risk" target="iran_proxy_escalation::security_incident_freq" id="563">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="An increased assessed risk to key routes reflects more hostile activity and weaker escorts, which directly raises opportunities and incentives for Iran-aligned proxy groups and other malign actors to attack or seize tankers, pipelines and convoys, increasing incident frequency." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_compute_chip_race" />
          <attvalue for="39" value="iran_proxy_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_compute_chip_race::route_security_risk" target="russia_ukraine_war::hydrocarbon_supply_flow" id="564">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher assessed risk to key maritime, pipeline or air corridors leads to rerouting, port shutdowns, convoy slowdowns and insurance refusals that directly reduce the net physical flow of crude, refined fuels and LNG into markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_compute_chip_race" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
