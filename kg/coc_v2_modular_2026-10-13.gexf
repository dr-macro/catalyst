      <edge source="russia_ukraine_war::energy_infra_attack_rate" target="ai_compute_chip_race::route_security_risk" id="98">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A rise in successful or attempted attacks on production, refining, storage or transport nodes directly increases the assessed probability that key maritime, pipeline or transit corridors will be disrupted or denied due to damage, closures or heightened military/escort requirements." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_compute_chip_race" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_infra_attack_rate" target="china_eu_trade_rivalry::tanker_attack_risk" id="99">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Increased kinetic attacks on pipelines, terminals and coastal energy facilities create operational precedents and opportunistic targeting patterns that raise the perceived and actual risk of hostile actions against tankers servicing routes between Asia and Europe, prompting insurers and operators to treat tanker transits as higher‑risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_eu_trade_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_infra_attack_rate" target="global_energy_supply_ris::crude_flow_rate" id="100">
