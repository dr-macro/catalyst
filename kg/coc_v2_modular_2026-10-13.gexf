      <edge source="russia_ukraine_war::hydrocarbon_supply_flow" target="china_eu_trade_rivalry::trade_flow_volume" id="29">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A drop in Russian hydrocarbon exports forces EU buyers to outcompete Asian buyers for alternative LNG/oil cargoes and charter capacity, raising freight and energy input costs and causing a measurable contraction in China‑EU manufactured goods trade volumes as supply chains and shipping slots are reallocated." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_eu_trade_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::hydrocarbon_supply_flow" target="global_energy_supply_ris::oil_spot_price_level" id="30">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A net reduction in physical hydrocarbon deliveries to global markets tightens available supply relative to demand and, through direct supply–demand mechanics, raises spot prices (and conversely increased flow depresses spot prices)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_supply_ris" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::hydrocarbon_supply_flow" target="iran_proxy_escalation::energy_price_level" id="31">
