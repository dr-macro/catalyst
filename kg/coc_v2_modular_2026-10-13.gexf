      <edge source="china_eu_trade_rivalry::tanker_attack_risk" target="ai_compute_chip_race::route_security_risk" id="747">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rise in the perceived probability and expected frequency of tanker attacks directly elevates the assessed likelihood of disruption along maritime chokepoints and shipping lanes, increasing overall route security risk as operators reroute, delay sailings, or require escorts." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_eu_trade_rivalry" />
          <attvalue for="39" value="ai_compute_chip_race" />
          <attvalue for="28" value="0" />
        </attvalues>
