      <edge source="us_iran_standoff::export_route_security" target="ai_global_rivalry::chip_supply_constraint" id="224">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Attacks, interdictions or insurance shocks on key shipping lanes (e.g., Strait of Hormuz routes) directly increase transit times, rerouting costs and insurer refusals for high-value semiconductor wafers and fab equipment, producing immediate supply bottlenecks and longer lead times for AI-capable hardware." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="ai_global_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::export_route_security" target="bond_market_shock::funding_market_stress" id="225">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Deterioration in export-route security (e.g., attacks on tankers) raises insurance and counterparty risk and forces banks/treasuries to pull or reprice short-term credit lines for trade finance, increasing stress in wholesale funding markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="bond_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::export_route_security" target="china_regional_power::supply_chain_shift_rate" id="226">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Measured declines in security along Gulf and nearby maritime routes (attacks, seizures, insurance spikes) directly raise transport and transit risk for Chinese importers and exporters, prompting firms to accelerate diversification and relocation of suppliers and routings." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="china_regional_power" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::export_route_security" target="russia_europe_war::energy_price_level" id="227">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A deterioration in security of Persian Gulf/Red Sea export routes reduces physical flows and raises short‑term risk premia, directly pushing up global and European refined fuel prices as traders anticipate lost cargoes and insurance costs rise." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="russia_europe_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
