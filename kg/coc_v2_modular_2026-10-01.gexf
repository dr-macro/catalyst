      <edge source="ai_global_rivalry::model_release_cadence" target="russia_europe_war::hybrid_attack_frequency" id="333">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A faster cadence of released AI models rapidly expands widely accessible automation, generative code, planning and targeting tools that state and proxy actors can repurpose for cyber intrusions, automated disinformation campaigns and drone/autonomous targeting, raising the rate of hybrid attacks in the Russia–Europe theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_global_rivalry" />
          <attvalue for="38" value="russia_europe_war" />
          <attvalue for="27" value="0" />
        </attvalues>
