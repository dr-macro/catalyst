          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising market and official expectations of sustained escalation raise the perceived near‑term risk of energy and logistics shocks, prompting Beijing to deploy or increase targeted fiscal transfers and subsidies (energy, transport, key manufacturers, households) to blunt economic and social fallout." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="china_regional_power" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
