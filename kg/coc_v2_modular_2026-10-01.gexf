      <edge source="russia_europe_war::energy_price_level" target="ai_global_rivalry::chip_supply_constraint" id="46">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained increases in energy prices raise operating costs for fabs and ancillary suppliers, forcing production slowdowns and delaying capacity expansions that tighten chip availability for AI infrastructure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_europe_war" />
          <attvalue for="38" value="ai_global_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_europe_war::energy_price_level" target="bond_market_shock::nominal_long_yield" id="47">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sustained rise in energy prices boosts near-term CPI and inflation expectations and raises term premia as investors demand compensation for higher expected inflation and volatility, driving up nominal long-term yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_europe_war" />
          <attvalue for="38" value="bond_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_europe_war::energy_price_level" target="china_regional_power::fiscal_subsidy_level" id="48">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A spike in global energy prices driven by the Russia–Europe war raises Chinese import and domestic fuel costs, prompting Beijing to expand targeted fiscal transfers and energy subsidies to households and energy‑intensive industries to contain inflation and social unrest." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_europe_war" />
          <attvalue for="38" value="china_regional_power" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_europe_war::energy_price_level" target="china_regional_power::interest_rate_level" id="49">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained higher imported energy prices feed into Chinese consumer and producer inflation, creating upward pressure on monetary policy that makes the People's Bank of China less likely to cut policy rates and may prompt modest tightening or higher market interest rates to anchor inflation expectations." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_europe_war" />
          <attvalue for="38" value="china_regional_power" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_europe_war::energy_price_level" target="us_iran_standoff::political_hawkishness" id="50">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sustained spikes in energy prices from the Russia–Europe war raise domestic political pressure in the US and among its allies to secure supply lines and penalize sources of disruption, prompting more hawkish rhetoric and policy stances toward Iran as a potential threat to maritime energy flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_europe_war" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="27" value="0" />
