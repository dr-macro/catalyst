      <edge source="us_iran_standoff::conflict_expectation" target="bond_market_shock::nominal_long_yield" id="242">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sudden rise in market expectations of wider or prolonged US–Iran escalation raises sovereign and term risk premia (flight-to-liquid assets, higher inflation/war-risk premia), pushing up long-dated nominal yields within weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="bond_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::conflict_expectation" target="china_regional_power::fiscal_subsidy_level" id="243">
        <attvalues>
