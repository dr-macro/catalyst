          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A quicker cadence of publicly available AI model releases increases observable capability proliferation and novel use-cases, triggering faster regulatory inquiries and intelligence attention from external governments toward the originators." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_global_rivalry" />
