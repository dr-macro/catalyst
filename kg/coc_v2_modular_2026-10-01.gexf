          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Faster release cadence of capable models lowers the technical barrier for building autonomous navigation/targeting software that non-state maritime actors and proxies adapt to harass and strike commercial shipping, increasing interdictions and degrading export-route security." />
