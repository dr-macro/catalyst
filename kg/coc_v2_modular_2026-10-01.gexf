      <edge source="bond_market_shock::funding_market_stress" target="ai_global_rivalry::model_release_cadence" id="656">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Elevated funding stress raises short‑term borrowing costs and triggers margin calls for AI firms and cloud customers, prompting them to delay compute‑intensive R&amp;D and product rollouts and thus slow the cadence of model releases." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="bond_market_shock" />
          <attvalue for="38" value="ai_global_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="bond_market_shock::funding_market_stress" target="china_regional_power::interest_rate_level" id="657">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rise in wholesale funding stress pushes up interbank and term funding costs, which is passed through to benchmark lending and market rates as banks repricing liquidity raise offered borrowing costs absent offsetting central‑bank easing." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="bond_market_shock" />
          <attvalue for="38" value="china_regional_power" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="bond_market_shock::funding_market_stress" target="russia_europe_war::transport_logistics_capa" id="658">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute funding stress raises short-term borrowing and collateral costs for shipping, freight forwarders and fuel storage operators, forcing route cuts, deferred sailings and reduced working-capital financing that directly shrinks operational transport and distribution capacity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="bond_market_shock" />
          <attvalue for="38" value="russia_europe_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="bond_market_shock::funding_market_stress" target="russia_europe_war::emergency_policy_interve" id="659">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="When funding markets seize up and energy traders, utilities or importers face margin calls or imminent cash shortfalls, governments and central banks directly deploy emergency credit lines, guarantees or inventory releases to avert supply stoppages." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="bond_market_shock" />
          <attvalue for="38" value="russia_europe_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="bond_market_shock::funding_market_stress" target="us_iran_standoff::military_presence_level" id="660">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute wholesale funding stress raises short-term financing costs for defense contractors, logistics providers and overseas base operations, prompting commanders to postpone rotations, defer nonessential deployments and temporarily reduce forward force levels." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="bond_market_shock" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="27" value="0" />
