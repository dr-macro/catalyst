      <edge source="us_iran_standoff::conflict_expectation" target="ai_global_rivalry::regulatory_activity_rate" id="241">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising market and stakeholder expectations of imminent escalation prompt regulators and legislators to fast-track export controls, sanctions, and oversight actions targeting dual-use AI technologies to deny adversaries advantage, raising the pace of regulatory interventions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="ai_global_rivalry" />
          <attvalue for="27" value="0" />
