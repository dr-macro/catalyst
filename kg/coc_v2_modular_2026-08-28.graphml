<edge source="russia_ukraine_war::escalation_risk" target="ai_economic_transformati::chip_supply_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Rising risk of escalation triggers emergency export controls, national stockpiling and supplier rationing (by governments and large customers), which immediately tightens availability and raises pressure on advanced chip supplies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_economic_transformati</data>
</edge>
<edge source="russia_ukraine_war::escalation_risk" target="iran_hormuz_conflict::energy_risk_premium" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Rising assessed probability of broader conflict in the Russia–Ukraine theatre increases global perceived supply risk for oil and gas, which is immediately priced into markets as a higher energy geopolitical risk premium affecting shipments through Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_hormuz_conflict</data>
</edge>
