</edge>
<edge source="ai_economic_transformati::chip_supply_pressure" target="ai_economic_transformati::supply_chain_lead_time" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="ai_economic_transformati::chip_supply_pressure" target="iran_hormuz_conflict::maritime_security" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter supply of advanced chips pushes actors toward gray- and black-market procurement chains that rely on covert sea shipments and small-boat transfers in the Persian Gulf, increasing interception incidents, misidentifications and localized maritime insecurity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">iran_hormuz_conflict</data>
</edge>
<edge source="ai_economic_transformati::chip_supply_pressure" target="russia_ukraine_war::military_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Stronger constraints on advanced accelerators and semiconductors raise lead times and costs for precision munitions, loitering munitions and smart munitions production, degrading the rate at which belligerents can sustain high‑intensity strike operations.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="ai_economic_transformati::chip_supply_pressure" target="us_china_tech_rivalry::compromised_hardware_rat" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Acute pressure on advanced chip supplies drives buyers toward alternative, third‑party or grey-market sources and shortens vetting cycles, increasing the probability that deployed hardware contains insecure or backdoored components.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="ai_economic_transformati::chip_supply_pressure" target="us_trade_coercion::supply_chain_disruption" id="0">
  <data key="d27">cross_causal</data>
