<edge source="ai_economic_transformati::ai_compute_capacity" target="iran_hormuz_conflict::maritime_security" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Higher available AI compute enables faster deployment and more capable AI-driven maritime surveillance, automatic vessel-tracking and anomaly detection systems by coalition navies and commercial operators, reducing surprise harassment and improving safe passage in the Strait of Hormuz.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">iran_hormuz_conflict</data>
</edge>
<edge source="ai_economic_transformati::ai_compute_capacity" target="russia_ukraine_war::intel_sharing_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rapid increases in accessible AI compute enable faster, more automated processing of satellite, drone and SIGINT feeds (object detection, change detection, translation), producing higher volumes of actionable intelligence that partner services can share and act on.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="ai_economic_transformati::ai_compute_capacity" target="us_china_tech_rivalry::ai_attack_enhancement" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Higher installed AI compute directly enables training and running larger, more capable offensive models (automated vulnerability discovery, malware generation and phishing automation), increasing the scale and sophistication of AI-enabled attacks.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="ai_economic_transformati::ai_compute_capacity" target="us_china_tech_rivalry::detection_attribution" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Greater compute availability allows defenders to train and deploy larger detection and correlation models and perform faster forensic analysis, improving intrusion detection speed and attribution quality.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
