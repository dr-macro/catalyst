<edge source="russia_ukraine_war::military_pressure_level" target="ai_economic_transformati::ai_compute_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intensified military operations drive urgent procurement of accelerators and edge compute for weapon, ISR and command systems, diverting limited accelerator inventory away from commercial AI training and lowering available commercial AI compute capacity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_economic_transformati</data>
</edge>
<edge source="russia_ukraine_war::military_pressure_level" target="iran_hormuz_conflict::maritime_security" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained spikes in Russian kinetic operations force NATO/US to reallocate surface and air assets to the European theatre, reducing forward naval and air patrol presence in the Persian Gulf and thereby lowering commercial maritime security.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_hormuz_conflict</data>
</edge>
<edge source="russia_ukraine_war::military_pressure_level" target="us_china_tech_rivalry::compromised_hardware_rat" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intensified military pressure and associated sanctions/export controls tied to the war push states and firms to reroute procurements toward alternative suppliers and hastily sourced components, raising the prevalence of unvetted or potentially compromised hardware within technology supply chains relevant to the U.S.–China rivalry.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::military_pressure_level" target="us_trade_coercion::tariff_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Sustained increases in kinetic operations (high-profile strikes, territorial gains) prompt the US to raise applied tariffs and broaden sanctionable categories on Russian-origin goods and linked third-party actors to increase economic pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_trade_coercion</data>
</edge>
