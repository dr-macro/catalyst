<edge source="iran_hormuz_conflict::energy_risk_premium" target="ai_economic_transformati::ai_compute_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A higher energy supply risk premium raises electricity and fuel costs for hyperscalers and data centres, making planned capacity expansions and GPU‑heavy training runs uneconomic and slowing growth or prompting temporary curtailment of deployed AI compute.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_hormuz_conflict</data>
  <data key="d39">ai_economic_transformati</data>
</edge>
<edge source="iran_hormuz_conflict::energy_risk_premium" target="russia_ukraine_war::military_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A higher energy risk premium from disruptions in the Hormuz corridor raises global oil/gas prices, boosting Russian hydrocarbon revenues and short‑term fiscal capacity to procure ammunition and sustain operations, enabling increased kinetic pressure in Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_conflict</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_hormuz_conflict::energy_risk_premium" target="us_trade_coercion::policy_uncertainty_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A rising energy risk premium that widens price volatility prompts governments and regulators to consider new trade interventions (tariff changes, export controls, subsidies), increasing firms' uncertainty about forthcoming trade policy and enforcement.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_conflict</data>
