<edge source="us_china_tech_rivalry::ai_attack_enhancement" target="ai_economic_transformati::ai_investment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A measurable rise in AI-enabled offensive cyber operations increases expected operational and insurance costs for AI projects and heightens investor risk aversion, causing venture and corporate capital commitments to AI hardware and startups to slow.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">ai_economic_transformati</data>
</edge>
<edge source="us_china_tech_rivalry::ai_attack_enhancement" target="iran_hormuz_conflict::chokepoint_throughput" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">AI-enabled automation and scaling of cyber operations allow attackers to launch faster, more precise campaigns (targeting ship scheduling, port logistics, or tanker control systems) that produce sustained delays and reduce cargo/tanker flow through the chokepoint.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">iran_hormuz_conflict</data>
</edge>
<edge source="us_china_tech_rivalry::ai_attack_enhancement" target="russia_ukraine_war::escalation_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">AI-driven automation and sophistication of cyber attacks increases the scale and speed of disruptive operations against Ukrainian critical infrastructure, raising the probability of kinetic retaliation, miscalculation, or rapid escalation.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_rivalry::ai_attack_enhancement" target="us_trade_coercion::policy_uncertainty_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Greater scale and sophistication of AI-enabled attacks expands the range and unpredictability of threats to critical industries, leading regulators to promulgate rapidly changing or ambiguous export controls and trade restrictions that raise firms' uncertainty about future trade policy.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">us_trade_coercion</data>
</edge>
