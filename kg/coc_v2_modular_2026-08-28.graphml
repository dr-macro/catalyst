<edge source="ai_economic_transformati::geopolitical_risk" target="iran_hormuz_conflict::kinetic_escalation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising geopolitical sourcing risk (export controls, tech denial, or visible supply-chain decoupling) increases incentives for targeted coercive signaling and asymmetric attacks by states under pressure, prompting more frequent kinetic incidents around the Strait of Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">iran_hormuz_conflict</data>
</edge>
<edge source="ai_economic_transformati::geopolitical_risk" target="russia_ukraine_war::backchannel_activity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising geopolitical sourcing risk (threats to supply chains, sanctions risk) creates incentives for states and intermediaries to open low‑visibility negotiations and ad hoc trade/transfer arrangements to secure critical AI components and services, increasing backchannel diplomatic contacts relevant to the conflict environment.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="ai_economic_transformati::geopolitical_risk" target="us_trade_coercion::tariff_escalation_speed" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Spikes in geopolitical sourcing risk (e.g., sudden sanctions risk or territorial tensions) prompt faster policy moves to adjust tariffs and trade barriers as governments attempt to secure supply or signal resolve, accelerating the pace of tariff changes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_economic_transformati</data>
  <data key="d39">us_trade_coercion</data>
</edge>
