  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Appreciation of a domestic currency lowers the landed cost of imported AI chips and datacenter equipment, enabling faster procurement and installation and thus raising hardware production/installation throughput.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">currency_activism</data>
