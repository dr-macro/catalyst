<edge source="currency_activism::rate_expectation_curve" target="russia_ukraine_warfare::political_will_arms" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A market-implied downward shift in expected short-term policy rates reduces the projected fiscal burden of multi-year aid commitments, making governments more willing to pledge or expand weapons supplies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">currency_activism</data>
  <data key="d39">russia_ukraine_warfare</data>
</edge>
