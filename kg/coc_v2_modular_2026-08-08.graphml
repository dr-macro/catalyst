<edge source="us_china_tech_rivalry::ai_deployment_rate" target="alliance_munitions_strai::maritime_access_control" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">Faster fielding of AI systems for maritime ISR, autonomous surface and underwater vehicles, and automated vessel identification enables states to monitor, classify, and enforce exclusion zones and routing in real time, allowing more active regulation or denial of maritime movement.</data>
  <data key="d37">6-18 months</data>
