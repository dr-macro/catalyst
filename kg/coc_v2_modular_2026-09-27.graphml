  <data key="d33">+</data>
</edge>
<edge source="russia_ukraine_security::defense_mobilisation" target="ai_buildout_risks::infra_financing_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Large-scale defence mobilisation reallocates government budgets, raises sovereign and supply‑chain risk and triggers export controls and capital restrictions that reduce private and foreign investment into AI physical and cloud infrastructure in the affected region.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">ai_buildout_risks</data>
</edge>
<edge source="russia_ukraine_security::defense_mobilisation" target="iran_gulf_conflict::maritime_access_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Large‑scale mobilisation and reinforcement in the Europe‑Russia theatre prompts redeployment of US/NATO naval and air assets to the European flank, reducing on‑station deterrence in the Gulf and increasing contestation/restrictions on key sea lanes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">iran_gulf_conflict</data>
</edge>
<edge source="russia_ukraine_security::defense_mobilisation" target="us_china_rivalry::export_control_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Large‑scale Russian defence mobilisation triggers expedited US policy moves to expand and tighten sanctions and export controls (including secondary enforcement) to block military‑relevant and dual‑use flows, increasing export‑control regimes that implicate Chinese firms and technologies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">us_china_rivalry</data>
</edge>
