<edge source="russia_ukraine_security::energy_availability" target="global_bond_repricing::long_term_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A reduction in energy availability raises expected near‑term inflation and term‑premia (via higher commodity prices and supply‑shock risk), which markets price into higher long‑dated sovereign yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">global_bond_repricing</data>
