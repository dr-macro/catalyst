<edge source="ai_buildout_risks::systemic_coupling" target="iran_gulf_conflict::oil_price_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.55</data>
  <data key="d36">Stronger coupling between AI infrastructure, financial trading systems, and operational maritime networks makes real‑world incidents (cyber or kinetic) more likely to rapidly trigger algorithmic trading and automated risk repricing, amplifying short‑term oil price swings.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_buildout_risks</data>
  <data key="d39">iran_gulf_conflict</data>
</edge>
<edge source="ai_buildout_risks::systemic_coupling" target="russia_ukraine_security::infrastructure_damage" id="0">
