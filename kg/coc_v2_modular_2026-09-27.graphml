<edge source="iran_gulf_conflict::attack_incident_rate" target="ai_buildout_risks::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A spike in maritime attacks increases national security concerns among policymakers, prompting expedited reviews, export controls and oversight measures focused on AI tools perceived as contributing to conflict or enabling adversarial capabilities.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_conflict</data>
  <data key="d39">ai_buildout_risks</data>
</edge>
<edge source="iran_gulf_conflict::attack_incident_rate" target="global_bond_repricing::bond_market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rising tempo of maritime attacks raises risk aversion and dealer balance-sheet costs (hedging, capital charges), prompting wider bid-ask spreads and shallower order books in sovereign bond markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_conflict</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="iran_gulf_conflict::attack_incident_rate" target="us_china_rivalry::export_control_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in maritime attacks that can be forensically linked to weaponry, components, or supply chains involving Chinese manufacturers pushes US policymakers to broaden or tighten export controls and sanctions on implicated Chinese firms and dual‑use technologies.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_gulf_conflict</data>
