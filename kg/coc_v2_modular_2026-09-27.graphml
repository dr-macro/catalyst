<edge source="iran_gulf_conflict::oil_price_volatility" target="global_bond_repricing::long_term_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Higher oil-price volatility increases inflation uncertainty and the term premium demanded by long-term investors, pushing nominal long-dated sovereign yields upward.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_conflict</data>
  <data key="d39">global_bond_repricing</data>
