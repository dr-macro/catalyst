<edge source="russia_ukraine_security::infrastructure_damage" target="ai_buildout_risks::capability_growth_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Destruction or functional loss of data centres, manufacturing plants and logistics reduces available compute, hardware production and training throughput, directly slowing the rate of AI model capability improvements.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">ai_buildout_risks</data>
</edge>
<edge source="russia_ukraine_security::infrastructure_damage" target="global_bond_repricing::bond_market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Significant damage to transport, energy and settlement infrastructure increases settlement frictions, counterparty risk and intraday volatility, causing wider bid‑ask spreads and reduced depth in bond markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="russia_ukraine_security::infrastructure_damage" target="us_china_rivalry::supply_interdependence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widespread destruction of transport, energy, and port infrastructure in and around the conflict reduces reliable throughput of goods (eg. grains, inputs), prompting importers and manufacturers to re‑source and diversify suppliers away from conflict‑affected routes and partners, lowering bilateral supply interdependence between economies including US and China.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">us_china_rivalry</data>
</edge>
