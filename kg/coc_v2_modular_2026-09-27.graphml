<edge source="ai_buildout_risks::capability_growth_rate" target="global_bond_repricing::net_fixed_income_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.57</data>
  <data key="d36">A rapid acceleration in AI model capabilities shifts investor risk appetite toward equities and venture/tech allocations, producing measurable outflows from fixed‑income funds as portfolios reallocate to capture expected excess returns.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_buildout_risks</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="ai_buildout_risks::capability_growth_rate" target="iran_gulf_conflict::attack_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Faster core model capability growth accelerates development and fielding of lower‑cost AI-enabled maritime autonomy (surveillance, target recognition, and loitering/attack drones) that state and proxy actors can deploy against vessels, raising the frequency of hostile incidents.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_buildout_risks</data>
  <data key="d39">iran_gulf_conflict</data>
</edge>
<edge source="ai_buildout_risks::capability_growth_rate" target="russia_ukraine_security::military_strike_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Faster AI capability gains shorten sensor-to-shooter cycles via improved ISR, target recognition and fire‑control automation, enabling higher sortie tempo and more destructive strikes per unit time.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_buildout_risks</data>
  <data key="d39">russia_ukraine_security</data>
</edge>
<edge source="ai_buildout_risks::capability_growth_rate" target="us_china_rivalry::export_control_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Rapid increases in AI model capabilities create credible risks of military or dual‑use advantage transfer, prompting US policymakers to widen and tighten export controls on models, chips, tooling, and related services to restrict Chinese access.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_buildout_risks</data>
