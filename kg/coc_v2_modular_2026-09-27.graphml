<edge source="us_china_rivalry::strategic_tension_level" target="ai_buildout_risks::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising high‑level geopolitical tensions politicize AI as a national‑security issue, triggering legislative hearings, agency reviews and new oversight initiatives that increase sustained regulatory scrutiny intensity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">ai_buildout_risks</data>
</edge>
<edge source="us_china_rivalry::strategic_tension_level" target="global_bond_repricing::bond_market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Escalating strategic tensions increase counterparty, settlement and sanction risk, prompting dealers and cross‑border investors to withdraw or scale back market‑making activity and widening bid‑ask spreads, thereby reducing sovereign bond market liquidity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="us_china_rivalry::strategic_tension_level" target="iran_gulf_conflict::attack_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising U.S.–China strategic tensions prompt the U.S. to redeploy naval and air assets toward the Indo‑Pacific and reduce persistent Gulf deterrence, which Iran and its proxy groups interpret as an opening and consequently increase maritime attacks on vessels and infrastructure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">iran_gulf_conflict</data>
</edge>
<edge source="us_china_rivalry::strategic_tension_level" target="iran_gulf_conflict::maritime_access_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating friction between Washington and Beijing produces increased bilateral naval shadowing, escort missions, and occasional confrontations in chokepoints that generate episodic contestation or temporary restrictions on commercial passage.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">iran_gulf_conflict</data>
</edge>
<edge source="us_china_rivalry::strategic_tension_level" target="russia_ukraine_security::military_strike_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising high‑level US–China tensions divert Western political and operational attention to the Indo‑Pacific (and create perceived windows of lower Western focus), which Moscow exploits to increase tempo and scale of conventional strikes in Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">russia_ukraine_security</data>
</edge>
<edge source="us_china_rivalry::strategic_tension_level" target="russia_ukraine_security::escalation_perception" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Escalating US–China rivalry raises policymakers' and publics' sense that great‑power competition could spill into other theatres, heightening perceived risk that the Russia–Ukraine war could broaden or provoke wider involvement.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">russia_ukraine_security</data>
</edge>
