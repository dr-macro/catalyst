<edge source="russia_ukraine_security::escalation_perception" target="ai_buildout_risks::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rising perception of imminent escalation drives policymakers to impose tighter oversight, emergency export controls and security‑focused reviews of AI vendors and deployments, increasing sustained regulatory intervention intensity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">ai_buildout_risks</data>
</edge>
<edge source="russia_ukraine_security::escalation_perception" target="ai_buildout_risks::infra_financing_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Heightened fears of conflict and cross‑border disruption prompt allied governments and strategic investors to accelerate and expand capital deployment into onshore and allied‑region AI infrastructure (data centres, localized cloud, fabs) to reduce dependence on exposed supply chains.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">ai_buildout_risks</data>
</edge>
<edge source="russia_ukraine_security::escalation_perception" target="global_bond_repricing::net_fixed_income_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rise in perceived escalation triggers a near-term flight-to-quality as investors shift allocations from equities and risky assets into sovereign bonds and high-grade fixed-income vehicles, producing net inflows into fixed-income products.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="russia_ukraine_security::escalation_perception" target="global_bond_repricing::long_term_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Higher perceived risk of wider conflict increases demand for core sovereign paper and pushes up safe‑asset prices, mechanically lowering long‑term government yields through compressed term premia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="russia_ukraine_security::escalation_perception" target="iran_gulf_conflict::attack_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher perceived risk of a wider Russia‑Ukraine war reduces Western political bandwidth and is judged by Iran and its proxy networks as an opportunity to intensify maritime harassment and strikes against ships and offshore infrastructure in the Gulf/Red Sea, raising incident frequency.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">iran_gulf_conflict</data>
</edge>
<edge source="russia_ukraine_security::escalation_perception" target="us_china_rivalry::strategic_tension_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A marked rise in perceptions that the Russia–Ukraine war could escalate prompts the United States to deepen deterrence posture and alliance coordination in Europe and the Indo‑Pacific while China increases strategic signaling and military readiness, raising bilateral strategic tensions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_security</data>
  <data key="d39">us_china_rivalry</data>
</edge>
