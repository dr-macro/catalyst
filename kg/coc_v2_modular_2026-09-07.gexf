          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Public demonstration or rapid deployment of higher-performing AI models (e.g., autonomous targeting, credible deepfakes, or advanced ISR analytics) increases public and elite perceptions of vulnerability and uncertainty, raising perceived external threat levels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="tech_ai_geopolitical_riv" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
