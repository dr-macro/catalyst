      <edge source="us_iran_gulf_conflict::maritime_attack_rate" target="global_energy_shocks::chokepoint_risk" id="50">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A higher frequency of attacks on commercial vessels directly raises the probability of transit interruptions and prompts rerouting, convoy requirements and port denials, thereby elevating chokepoint disruption risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
