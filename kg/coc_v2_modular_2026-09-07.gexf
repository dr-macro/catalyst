          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Spikes in kinetic escalation prompt rapid re‑pricing, safe‑haven rotations, and stop‑loss cascades that produce large short‑term moves in sovereign bond prices, raising bond‑market volatility." />
