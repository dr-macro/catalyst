      <edge source="tech_ai_geopolitical_riv::model_capability_level" target="global_energy_shocks::wholesale_gas_price" id="427">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher AI model capability enables materially better short‑term demand and supply forecasting and automated trading strategies that reduce risk premia and speculative overshooting in gas markets, putting downward pressure on wholesale prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="tech_ai_geopolitical_riv" />
          <attvalue for="39" value="global_energy_shocks" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_ai_geopolitical_riv::model_capability_level" target="global_energy_shocks::refinery_availability" id="428">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Improved AI models accelerate deployment of predictive maintenance and process‑control optimizations at refineries, reducing unplanned outages and increasing operational availability once integrated into operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="tech_ai_geopolitical_riv" />
          <attvalue for="39" value="global_energy_shocks" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_ai_geopolitical_riv::model_capability_level" target="global_financial_shift::bond_market_volatility" id="429">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Step changes in model capability enable faster, more aggressive algorithmic trading, model-driven hedging and cross-asset arbitrage that can amplify order flow and create short-term dislocations, raising intraday sovereign bond volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="tech_ai_geopolitical_riv" />
          <attvalue for="39" value="global_financial_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_ai_geopolitical_riv::model_capability_level" target="russia_ukraine_war::threat_perception_levels" id="430">
        <attvalues>
