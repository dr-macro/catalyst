          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Improved AI model capabilities increase the effectiveness of financial obfuscation, document/transaction forgery, and targeted influence operations that evade or blunt sanctions, prompting authorities to broaden or tighten sanctions regimes against actors in the Gulf." />
