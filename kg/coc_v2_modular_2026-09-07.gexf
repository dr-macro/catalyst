          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An increase in cross-border capital inflows provides trading houses and refiners with short-term funding and working-capital access to buy and hold crude and refined product inventories, directly raising commercial fuel stocks as purchases and forward roll activity expand." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_shift" />
