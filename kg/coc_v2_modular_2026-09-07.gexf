          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained Russian kinetic escalation forces U.S. and allied naval/air assets to be reallocated to Europe for deterrence and logistics, reducing available forward presence and routine kinetic pressure (patrols, strikes, escorts) in the Gulf theatre." />
          <attvalue for="37" value="0-6 months" />
