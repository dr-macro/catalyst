          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Spikes in kinetic escalation prompt governments and vendors to extend export controls and self‑restrict shipments of high‑end accelerators (to avoid diversion or sanctions exposure), producing immediate shortages and reduced available accelerator‑hours for AI training." />
          <attvalue for="37" value="0-6 months" />
