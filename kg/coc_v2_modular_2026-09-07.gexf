          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Direct attacks and harassment of LNG carriers and terminals create shipping delays and higher insurance/freight costs and can cause short-term supply shortfalls that push up wholesale gas benchmark prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="39" value="global_energy_shocks" />
          <attvalue for="28" value="0" />
        </attvalues>
