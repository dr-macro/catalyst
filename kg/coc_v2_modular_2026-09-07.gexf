      <edge source="us_iran_gulf_conflict::sanctions_intensity" target="global_energy_shocks::commercial_fuel_stocks" id="29">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Broader, tighter sanctions that restrict payment channels, financing and insurance for a supplier reduce its effective exports and buyers' ability to replenish, leading commercial fuel inventories to be drawn down." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="39" value="global_energy_shocks" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::sanctions_intensity" target="global_financial_shift::cross_border_flows" id="30">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Tighter and broader sanctions directly restrict correspondent banking and investor access, force portfolio rebalancing away from targeted jurisdictions, and thus reduce net cross-border capital flows into affected sovereign debt markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="39" value="global_financial_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::sanctions_intensity" target="tech_ai_geopolitical_riv::compute_capacity" id="31">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Tighter sanctions and export controls rapidly block shipments of advanced accelerators, specialized servers, and cloud services to targeted states and firms, directly reducing usable high‑performance compute available to those actors and tightening global supply for competing parties." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="39" value="tech_ai_geopolitical_riv" />
          <attvalue for="28" value="0" />
