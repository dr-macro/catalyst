          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sustained inflows into developed-market sovereign debt lower borrowing costs and fiscal strain for Western donors, making it easier for them to finance and deliver weapons, ammunition, and sustainment to Ukraine, thereby improving Ukraine's relative military-capability balance versus Russia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
