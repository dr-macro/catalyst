          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rapid rise in AI-directed fundraising and infrastructure investment attracts international institutional and private capital into private equity and offshore AI infrastructure projects, mechanically diverting net cross-border inflows away from developed-market sovereign debt issuance and reducing measured sovereign inflows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="tech_ai_geopolitical_riv" />
          <attvalue for="39" value="global_financial_shift" />
