          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large, concentrated AI financing and secondary transactions withdraw balance-sheet capacity from prime brokers and liquidity providers and reallocate dealer inventories to tech positions, reducing depth and increasing bid‑ask spreads in sovereign bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="tech_ai_geopolitical_riv" />
          <attvalue for="39" value="global_financial_shift" />
