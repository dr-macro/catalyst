          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Increased strikes and kinetic risk near conflict zones lead cloud providers and investors to suspend construction, evacuate equipment, or decommission at‑risk facilities, directly reducing local data‑center capacity available for AI workloads." />
