          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A rise in attacks on commercial vessels raises immediate geopolitical risk perceptions and increases insurance and operational costs for trade-exposed issuers, prompting investors to demand higher sovereign and corporate risk premia." />
