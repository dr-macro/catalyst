          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained or intensified military action increases the perceived probability of sanctions, supply disruptions and fiscal strain for exposed states, so investors demand higher risk premia on sovereign debt." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_financial_shift" />
