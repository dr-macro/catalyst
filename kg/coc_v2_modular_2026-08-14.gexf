      <edge source="us_iran_maritime_standof::maritime_interdiction" target="bond_inflation_shock::crossborder_capital_flow" id="285">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="An escalation in maritime_interdiction (more frequent interdiction operations) raises regional geopolitical and trade risk, prompting non‑resident investors to withdraw portfolio capital from exposed markets and reallocate into safe‑haven assets, reducing net cross‑border inflows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="bond_inflation_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::maritime_interdiction" target="brics_global_realignment::alternative_payment_link" id="286">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained interdiction by US or US-backed forces raises perceived vulnerability of dollar-cleared maritime trade, pushing BRICS central banks and major exporters to accelerate deployment and bilateral use of non‑SWIFT/alternative settlement channels to preserve trade flows." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="brics_global_realignment" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::maritime_interdiction" target="russia_ukraine_war::maritime_attack_intensit" id="287">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained increases in US–Iran maritime interdiction drive US/NATO naval and air assets to redeploy toward the Gulf, creating temporary gaps in Western maritime presence and deterrence in the Black Sea that Russia can exploit to raise the tempo of attacks on shipping there." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
