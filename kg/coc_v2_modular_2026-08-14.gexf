      <edge source="us_iran_maritime_standof::chokepoint_throughput" target="bond_inflation_shock::inflation_surprise_rate" id="225">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A decline in chokepoint_throughput (fewer barrels/day transiting key straits) produces an immediate physical supply shortfall for refined fuels in consuming markets, causing energy and transport components of CPI to print above forecasts and raising the inflation surprise rate." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="bond_inflation_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::chokepoint_throughput" target="brics_global_realignment::currency_and_capital_sta" id="226">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharp drop in throughput through key chokepoints raises trade frictions and insurance/premia costs for exporters and importers in BRICS, triggering currency pressure and episodic capital flight as markets reprice external‑trade risks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="brics_global_realignment" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::chokepoint_throughput" target="russia_ukraine_war::grain_export_flow" id="227">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A drop in throughput through key Gulf chokepoints reallocates global tanker and bulk shipping capacity and spikes freight and insurance costs, prompting carriers to avoid higher‑risk routes and reducing the effective volume and reliability of Black Sea grain exports to global markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::chokepoint_throughput" target="us_china_tech_rivalry::infra_invest_flow" id="228">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A drop in chokepoint throughput causes immediate shipment delays, higher freight and insurance costs for data‑center equipment, and project timelines slippage, which leads investors and operators to postpone or reduce AI infrastructure deployments and lower near‑term investment flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
