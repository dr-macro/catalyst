          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Improved BRICS-enabled sanctions‑evasion networks (shadow shipping services, ship-to-ship transfers, and opaque brokerage) allow more Iranian crude to reach buyers, directly increasing volumes transiting strategic chokepoints such as the Strait of Hormuz." />
          <attvalue for="36" value="0-6 months" />
