      <edge source="us_iran_maritime_standof::hostile_incident_rate" target="bond_inflation_shock::monetary_policy_risk" id="301">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained increase in hostile_incident_rate (more attacks/seizures) heightens uncertainty about the persistence of supply disruptions and growth impacts, complicating central bank reaction functions and increasing perceived uncertainty about the timing and intensity of monetary policy." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="bond_inflation_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::hostile_incident_rate" target="brics_global_realignment::sanctions_evasion_capaci" id="302">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A higher rate of attacks and seizures creates immediate operational disruptions that incentivize states and firms within BRICS to build and fund covert logistics, opaque intermediaries, and legal/financial workarounds to keep sanctioned or at‑risk trade moving." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="brics_global_realignment" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::hostile_incident_rate" target="brics_global_realignment::alignment_with_alternati" id="303">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Repeated hostile maritime incidents increase perceived reliance risk on Western security frameworks, prompting BRICS governments to deepen military-diplomatic and logistical ties with alternative security partners to diversify protection of sea lines of communication." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="brics_global_realignment" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::hostile_incident_rate" target="russia_ukraine_war::drone_strike_frequency" id="304">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A spike in hostile incidents against shipping attributable to the US–Iran standoff incentivizes Iran (and its proxies) to accelerate transfer and operational support of UAVs to Russia as reciprocal leverage, enabling higher drone strike rates in the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_standof::hostile_incident_rate" target="us_china_tech_rivalry::regulatory_stringency" id="305">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rising rate of hostile maritime incidents creates a near-term national‑security pretext that prompts U.S. policymakers to tighten export controls and related regulatory measures against competitors, increasing overall regulatory stringency in the U.S.–China tech rivalry." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_standof" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
