          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved sanctions‑evasion capacity—via procurement intermediaries, gray‑market logistics and substitute supply chains—allows sanctioned fabs and buyers to obtain critical equipment and inputs, permitting maintenance or incremental expansion of semiconductor production capacity despite formal controls." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="brics_global_realignment" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_global_realignment::sanctions_evasion_capaci" target="us_iran_maritime_standof::chokepoint_throughput" id="774">
