        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rapid shift toward alternative geopolitical alignments alters reserve usage, trade invoicing and bilateral financial arrangements, creating strategic uncertainty about central-bank interventions, reserve management and capital-control responses and thus raising perceived monetary policy risk." />
          <attvalue for="36" value="6-18 months" />
