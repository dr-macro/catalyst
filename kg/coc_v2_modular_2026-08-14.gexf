      <edge source="brics_global_realignment::sanctions_evasion_capaci" target="russia_ukraine_war::grain_export_flow" id="772">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved evasion capacity allows agricultural exporters to use middlemen, opaque paperwork and re-routing via permissive ports, raising the volume of grain shipments reaching international buyers despite formal restrictions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="brics_global_realignment" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_global_realignment::sanctions_evasion_capaci" target="us_china_tech_rivalry::semiconductor_capacity" id="773">
