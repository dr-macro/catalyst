      <edge source="brics_global_realignment::sanctions_evasion_capaci" target="russia_ukraine_war::fuel_supply_flow" id="771">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Expanded sanctions-evasion networks (front companies, reflagging, shadow brokers) enable sanctioned fuel cargoes to be rechartered, transshipped and insured through third-party intermediaries, increasing actual fuel shipments through regional routes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="brics_global_realignment" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
