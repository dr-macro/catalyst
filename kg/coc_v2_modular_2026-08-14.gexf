      <edge source="russia_ukraine_war::maritime_attack_intensit" target="bond_inflation_shock::monetary_policy_risk" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="An increase in maritime_attack_intensit raises energy/transport volatility and macroeconomic uncertainty, complicating central banks' inflation and growth forecasts and therefore increasing perceived monetary policy risk and uncertainty about timing/intensity of interventions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="bond_inflation_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::maritime_attack_intensit" target="us_china_tech_rivalry::regulatory_stringency" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A spike in maritime attacks crystallizes national‑security narratives and evidentiary links to hostile actors, prompting governments (especially the US) to tighten export controls, sanctions screening and security‑related AI policy toward China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::maritime_attack_intensit" target="us_china_tech_rivalry::infra_invest_flow" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained attacks increase insurance and operational risk for transoceanic hardware deployments, incentivizing corporations and states to accelerate capital deployment into onshore/regional cloud and AI infrastructure as a resilience/decoupling response." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::maritime_attack_intensit" target="us_iran_maritime_standof::hostile_incident_rate" id="37">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Visible increases in missile/drone/small-boat attacks in the Russia‑Ukraine theatre produce a demonstration and tactics-transfer effect that accelerates adoption of similar maritime attack patterns by regional actors (including proxies), raising the rate of hostile incidents in the US–Iran maritime theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_maritime_standof" />
          <attvalue for="27" value="0" />
