<edge source="russia_ukraine_war::drone_attack_intensity" target="china_maritime_pressure::export_control_stringenc" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A surge in effective drone strikes in Ukraine prompts governments to tighten export controls on dual‑use drone, guidance and sensor components, and trading partners (including China) respond by enacting or reinforcing stricter outbound controls to limit proliferation.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_maritime_pressure</data>
</edge>
<edge source="russia_ukraine_war::drone_attack_intensity" target="global_monetary_stress::intervention_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Surges in drone attack frequency produce sudden commodity and FX price volatility that prompt authorities to increase the frequency and scale of public market interventions to restore orderly price dynamics.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_monetary_stress</data>
</edge>
<edge source="russia_ukraine_war::drone_attack_intensity" target="hormuz_standoff::maritime_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">Operational lessons, commercial/illicit transfers, and demonstrable effectiveness of drones in the Russia–Ukraine war accelerate acquisition and tactical adoption of maritime and aerial drones by Gulf proxies and state actors, increasing the frequency of drone-enabled attacks and incidents against shipping in the Strait of Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">hormuz_standoff</data>
</edge>
