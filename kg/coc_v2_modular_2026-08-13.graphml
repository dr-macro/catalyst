<edge source="russia_ukraine_war::fuel_export_volume" target="global_monetary_stress::monetary_policy_tightnes" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained increase in regional fuel exports lowers global energy prices and inflation expectations, reducing central-bank impetus to raise real policy rates and overall monetary tightness within months.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_monetary_stress</data>
</edge>
<edge source="russia_ukraine_war::fuel_export_volume" target="hormuz_standoff::oil_export_via_hormuz" id="0">
