<edge source="hormuz_standoff::oil_export_via_hormuz" target="china_maritime_pressure::militarization_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained drop in oil exports through Hormuz (an increase in risk to shipments) prompts China to augment naval escorts and security infrastructure to safeguard energy imports, so lower Hormuz throughput drives up Chinese maritime military posture.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_standoff</data>
  <data key="d39">china_maritime_pressure</data>
</edge>
<edge source="hormuz_standoff::oil_export_via_hormuz" target="global_monetary_stress::cross_border_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A decline in oil export volumes through Hormuz reduces foreign-exchange receipts for Gulf exporters and associated petro-recycling flows, causing a drop in net cross-border capital inflows into the region and related asset classes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_standoff</data>
  <data key="d39">global_monetary_stress</data>
</edge>
<edge source="hormuz_standoff::oil_export_via_hormuz" target="russia_ukraine_war::fuel_export_volume" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in oil exports safely transiting Hormuz (restoring Middle Eastern supply) reduces buyers' need to source alternative crude, thereby lowering short-term demand for Russian exports and reducing Russia's fuel export volumes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_standoff</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
