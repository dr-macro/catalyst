<edge source="hormuz_standoff::geo_tension_level" target="china_maritime_pressure::militarization_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Escalating geopolitical tension around Hormuz leads China to accelerate naval deployments, exercises, and escort missions to protect sea lines and signal deterrence, increasing regional maritime militarization.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_standoff</data>
  <data key="d39">china_maritime_pressure</data>
</edge>
<edge source="hormuz_standoff::geo_tension_level" target="russia_ukraine_war::escalation_perception" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A marked rise in geopolitical tension around Hormuz raises global risk signalling and diplomatic alarm, which directly increases policymakers' and markets' subjective expectations that the Russia–Ukraine conflict could broaden or intensify.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">hormuz_standoff</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="hormuz_standoff::geo_tension_level" target="us_china_tech_rivalry::regulatory_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Escalating geopolitical tension around Hormuz strengthens national-security framing in Washington and allied capitals, prompting accelerated export controls, sanctions screening and tighter review of cross-border AI financing and technology transfers aimed at China.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">hormuz_standoff</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
