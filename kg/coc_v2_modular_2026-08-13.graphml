  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Sharp increases in demonstrated maritime attacks (mines, small-boat strikes, naval drones) in the Black Sea drive regional and extra‑regional navies to deploy more ships, sensors, and countermeasures to comparable sea lanes, raising overall maritime militarization.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_maritime_pressure</data>
</edge>
<edge source="russia_ukraine_war::maritime_attack_intensit" target="global_monetary_stress::cross_border_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher maritime attack intensity raises shipping insurance costs and delivery risk, compresses trade finance lines and investor risk appetite for exposed exporters, leading to net pullbacks in cross-border capital into affected markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_monetary_stress</data>
</edge>
