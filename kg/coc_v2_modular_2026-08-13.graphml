  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Faster-than-expected monetary tightening in major currencies raises borrowing costs and amplifies sanctions effectiveness and fiscal pressure on sanctioned regional actors, increasing incentives to undertake maritime harassment or attacks as pressure-release or asymmetric retaliation.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_monetary_stress</data>
  <data key="d39">hormuz_standoff</data>
</edge>
<edge source="global_monetary_stress::monetary_policy_tightnes" target="russia_ukraine_war::fuel_export_volume" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sustained monetary tightening in major demand centers depresses industrial and transport activity and lowers crude and refined-product demand, which reduces volumes that exporters (including Russian exporters) can place into seaborne shipment markets.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_monetary_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_monetary_stress::monetary_policy_tightnes" target="us_china_tech_rivalry::ai_infra_financing_flow" id="0">
