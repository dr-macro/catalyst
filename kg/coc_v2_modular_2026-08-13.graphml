<edge source="china_maritime_pressure::export_control_stringenc" target="global_monetary_stress::cross_border_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">More stringent and enforceable export controls on technology and components directly reduce cross‑border commercial transactions and investment flows (FDI, licensing, project finance), lowering net cross‑border capital flow rates into affected jurisdictions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_maritime_pressure</data>
  <data key="d39">global_monetary_stress</data>
</edge>
<edge source="china_maritime_pressure::export_control_stringenc" target="russia_ukraine_war::drone_attack_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter Chinese export controls on dual‑use avionics, sensors and communications parts reduce the supply of components available to Russian procurement networks and intermediaries, degrading Russia's ability to sustain UAV/loitering-munition operations and lowering strike frequency over the next supply‑cycle.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_maritime_pressure</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="china_maritime_pressure::export_control_stringenc" target="us_china_tech_rivalry::ai_infra_financing_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Tightened export controls increase licensing and compliance risk for lenders and investors, prompting banks and financiers to withdraw or delay commitments to cross-border AI infrastructure projects.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_maritime_pressure</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
