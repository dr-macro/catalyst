          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Attacks on commercial shipping generate immediate political and public demand for a response and create military pressure to punish or deter perpetrators, raising the momentum for kinetic or coercive retaliation by affected states or coalitions." />
