      <edge source="financial_markets_stress::cross_asset_spillovers" target="energy_market_fragment::chokepoint_transit_rate" id="753">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Intensified cross‑asset spillovers lead banks to curtail trade finance and letters‑of‑credit issuance out of caution, which directly reduces the volume of financed shipments transiting major maritime chokepoints." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="financial_markets_stress" />
          <attvalue for="38" value="energy_market_fragment" />
          <attvalue for="27" value="0" />
        </attvalues>
