          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Stronger cross‑asset spillovers transmit fixed‑income shocks into commodity funding, freight and margining channels, producing margin calls and tighter short‑term credit that force traders to cut, delay or cancel diesel shipments, reducing cross‑border diesel trade volumes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="financial_markets_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
