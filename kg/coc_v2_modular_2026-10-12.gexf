          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A sustained rise in crude oil benchmark prices lifts headline inflation and inflation expectations and forces markets to price earlier/tighter central bank action, which raises long-term sovereign yields." />
          <attvalue for="36" value="0-6 months" />
