          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A rise in hostile incidents against ships elevates insurer/regulator risk ratings and airline operational risk assessments, prompting carriers and authorities to suspend flights or reroute services that overfly or serve the Gulf to avoid diversion and incident exposure." />
          <attvalue for="36" value="0-6 months" />
