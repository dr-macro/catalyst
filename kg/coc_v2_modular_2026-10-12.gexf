      <edge source="russia_ukraine_war::sanctions_enforce_streng" target="energy_market_fragment::tanker_operational_avail" id="67">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Stronger sanctions enforcement (blacklists, port denial, insurer/charterer restrictions and threat of seizure) directly sidelines or detains tankers and causes owners/insurers to withdraw services, reducing the proportion of the fleet that is operationally deployable." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="energy_market_fragment" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforce_streng" target="financial_markets_stress::market_liquidity_level" id="68">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter sanctions enforcement forces banks and brokers to curtail market-making, close or avoid sanctioned counterparty relationships and increase compliance-driven de-risking, which reduces dealer capacity to absorb large fixed-income flows and materially compresses market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="financial_markets_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforce_streng" target="financial_markets_stress::cross_asset_spillovers" id="69">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Stronger sanctions raise the likelihood of sudden position closures, frozen settlements and jurisdictional fragmentation, producing forced rebalancing that transmits shocks from fixed income into equities, credit, FX and commodity markets more rapidly and intensely." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="financial_markets_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforce_streng" target="gulf_maritime_flashpoint::route_suspension_rate" id="70">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter enforcement of sanctions on Russian diesel pushes buyers and shippers to reroute purchases and shipments via Gulf transshipment hubs and makes carriers wary of regulatory exposure, increasing maritime congestion and incident risk in the Gulf that prompts airlines to suspend flights to/over affected ports and airspace." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="gulf_maritime_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforce_streng" target="us_china_rivalry::regulatory_scrutiny_leve" id="71">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter enforcement of sanctions on Russian energy/diesel creates legal and intelligence precedents and intergovernmental coordination that policymakers export to technology oversight, prompting faster, broader regulatory investigations and compliance demands on Chinese-linked AI firms." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforce_streng" target="us_china_rivalry::data_access_restrictions" id="72">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="As sanctions enforcement exposes routes for sanctioned entities to access services, governments respond by imposing stricter data‑localization, vetting and cross‑border transfer controls to prevent sanction circumvention, tightening data access for foreign AI developers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
