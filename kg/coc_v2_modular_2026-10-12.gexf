      <edge source="russia_ukraine_war::energy_trade_volumes" target="gulf_maritime_flashpoint::kinetic_strike_freq" id="106">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising cross-border diesel shipments through narrow Gulf chokepoints increases the number, value and predictability of maritime energy targets, incentivizing state-aligned militias and other actors to carry out more missile/armed-drone strikes against vessels, terminals and related aviation-support assets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="gulf_maritime_flashpoint" />
          <attvalue for="27" value="0" />
