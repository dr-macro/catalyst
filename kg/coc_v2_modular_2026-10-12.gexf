          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A spike in hostile or disruptive maritime incidents produces episodic shocks to supply risk and triggers rapid hedging and rebalancing in fixed‑income markets, increasing short-term yield variability." />
