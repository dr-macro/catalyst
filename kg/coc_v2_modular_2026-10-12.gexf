      <edge source="financial_markets_stress::cross_asset_spillovers" target="gulf_maritime_flashpoint::route_suspension_rate" id="754">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Intense transmission of a fixed‑income shock into commodities, credit and insurance markets rapidly raises fuel costs and war‑risk/credit insurance premia and disrupts hedging, prompting airlines to suspend higher‑risk Gulf routes to avoid sudden cost and coverage gaps." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="financial_markets_stress" />
          <attvalue for="38" value="gulf_maritime_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="financial_markets_stress::cross_asset_spillovers" target="russia_ukraine_war::energy_trade_volumes" id="755">
