      <edge source="russia_ukraine_war::energy_trade_volumes" target="energy_market_fragment::chokepoint_transit_rate" id="105">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher cross-border diesel trade volumes generate more commercial shipments and therefore increase the number of transits through major maritime chokepoints, while reductions in trade lower transit counts." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="energy_market_fragment" />
