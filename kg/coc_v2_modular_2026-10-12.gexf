          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A sharp decline in days-of-supply for refined fuels triggers emergency policy reviews that expand regulatory oversight of technologies linked to energy management and logistics, raising the intensity and scope of AI-related compliance checks and enforcement actions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_market_fragment" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
