          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A fall in days-of-supply tightens near-term fuel availability, increasing the perceived probability of demand disruption and amplifying required risk premia across credit and equity markets as investors price higher macro/earnings downside." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_market_fragment" />
          <attvalue for="38" value="financial_markets_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_fragment::fuel_inventory_days_of_s" target="gulf_maritime_flashpoint::aviation_operational_cap" id="539">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Declines in refined fuel days-of-supply at Gulf terminals and airports force airlines to reduce flight frequencies, payloads, or cancel services due to refueling constraints and contingency fuel requirements, directly lowering civil aviation operational capacity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_market_fragment" />
          <attvalue for="38" value="gulf_maritime_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_fragment::fuel_inventory_days_of_s" target="russia_ukraine_war::sanctions_enforce_streng" id="540">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rapidly declining national or regional fuel stocks increases political pressure to secure imports, prompting governments to grant waivers or relax enforcement of diesel-related sanctions to avoid domestic shortages." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="energy_market_fragment" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_fragment::fuel_inventory_days_of_s" target="us_china_rivalry::regulatory_scrutiny_leve" id="541">
        <attvalues>
