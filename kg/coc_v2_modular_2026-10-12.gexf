          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in global diesel prices increases inflation uncertainty and squeezes corporate margins and cashflows, leading investors to demand higher compensation for credit and equity risk and thus raising aggregate market risk premia." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="financial_markets_stress" />
          <attvalue for="27" value="0" />
