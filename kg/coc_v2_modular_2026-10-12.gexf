          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An increase in maritime security incidents prompts voyage cancellations, port denials, rerouting and sharply higher war-risk insurance, directly reducing the rate of cross-border diesel shipments." />
