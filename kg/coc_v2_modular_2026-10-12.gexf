          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute diesel supply disruptions force governments to incur emergency import bills, subsidies or drawdowns of reserves, worsening near-term fiscal balances and inflation expectations and thereby putting upward pressure on sovereign bond yields." />
