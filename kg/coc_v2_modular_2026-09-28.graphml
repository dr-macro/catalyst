<edge source="iran_hormuz_flashpoint::oil_export_flow" target="global_bond_market_shock::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A drop in crude export volumes reduces FX receipts for exporting jurisdictions and forces reserve drawdowns or sovereign/corporate asset sales, producing net capital outflows (reduced cross-border inflows) from those markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_flashpoint</data>
  <data key="d39">global_bond_market_shock</data>
</edge>
<edge source="iran_hormuz_flashpoint::oil_export_flow" target="russia_ukraine_war::energy_supply_stability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A measurable drop in crude export volumes through Hormuz forces rerouting and competition for limited refined product and bunker cargoes, producing short-term logistic bottlenecks and fuel delivery shortfalls that reduce the continuity of power generation and transport fuel supplies in Europe and Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_flashpoint</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_hormuz_flashpoint::oil_export_flow" target="us_china_strategic_rival::policymaker_trust" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Persistent reductions in Iranian oil exports lead China to deepen bilateral energy deals or covert procurement to secure supplies, which prompts US policymakers to downgrade trust in Chinese commitments to uphold sanctions and cooperative agreements.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_hormuz_flashpoint</data>
  <data key="d39">us_china_strategic_rival</data>
</edge>
