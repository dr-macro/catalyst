<edge source="russia_ukraine_war::investor_confidence" target="global_bond_market_shock::corporate_credit_spreads" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">An increase in investor confidence reduces risk aversion and raises demand for credit-risk assets, compressing yield premia on corporate bonds and narrowing corporate credit spreads.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_bond_market_shock</data>
</edge>
<edge source="russia_ukraine_war::investor_confidence" target="iran_hormuz_flashpoint::supply_risk_expect" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A drop in investor confidence due to escalation in the Russia–Ukraine war raises risk premia and speculative positioning in energy markets, directly elevating market expectations of supply risk for chokepoints such as the Strait of Hormuz (and a rise in investor confidence would lower those expectations).</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
