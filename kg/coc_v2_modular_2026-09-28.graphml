<edge source="iran_hormuz_flashpoint::maritime_attack_frequenc" target="ai_agent_systemic_risks::cyber_exploit_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A surge in hostile maritime incidents prompts state and non-state actors to supplement or substitute physical attacks with cyber operations against port, shipping and logistics IT/AI stacks, raising successful compromises of AI systems and dependent infrastructure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_flashpoint</data>
  <data key="d39">ai_agent_systemic_risks</data>
</edge>
<edge source="iran_hormuz_flashpoint::maritime_attack_frequenc" target="ai_agent_systemic_risks::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Visible attacks on commercial shipping that implicate automated navigation or port automation systems lead regulators to open inquiries and demand audits, controls, and reporting requirements for AI deployed in maritime-critical systems.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_flashpoint</data>
  <data key="d39">ai_agent_systemic_risks</data>
</edge>
<edge source="iran_hormuz_flashpoint::maritime_attack_frequenc" target="global_bond_market_shock::corporate_credit_spreads" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A rise in hostile incidents against commercial shipping increases insurers' and shippers' costs and causes short-term revenue volatility and supply-chain interruption for trade-exposed firms, raising default and liquidity risk perceptions and widening corporate credit spreads.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_flashpoint</data>
  <data key="d39">global_bond_market_shock</data>
</edge>
<edge source="iran_hormuz_flashpoint::maritime_attack_frequenc" target="russia_ukraine_war::military_aid_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A spike in hostile incidents in the Hormuz corridor forces Western navies and airlift/logistics assets to be re-tasked to protect shipping and evac/escort missions and creates political attention on the Middle East, which delays shipments and lowers the tempo and political willingness to dispatch new large-scale military transfers to Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_flashpoint</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_hormuz_flashpoint::maritime_attack_frequenc" target="us_china_strategic_rival::strategic_tension_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rapid rise in attacks on commercial shipping prompts sustained US naval escort and interdiction operations in and near the Strait of Hormuz, increasing the frequency of direct US-China naval encounters, public accusations, and competitive security posturing that raise overall bilateral strategic tension.</data>
  <data key="d37">0-6 months</data>
