<edge source="us_china_strategic_rival::policymaker_trust" target="ai_agent_systemic_risks::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Higher mutual trust between policymakers reduces perceived national‑security risk from foreign AI actors and therefore lowers the propensity of regulators to open investigations and impose broad compliance requirements; the reverse (falling trust) increases scrutiny.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_strategic_rival</data>
  <data key="d39">ai_agent_systemic_risks</data>
</edge>
<edge source="us_china_strategic_rival::policymaker_trust" target="global_bond_market_shock::bank_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Improved mutual trust increases the likelihood of reciprocal regulatory cooperation and central‑bank liquidity arrangements (e.g., swap lines and coordinated facility access), reducing banks' need to hoard cash and thereby increasing measurable bank balance‑sheet liquidity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_strategic_rival</data>
  <data key="d39">global_bond_market_shock</data>
