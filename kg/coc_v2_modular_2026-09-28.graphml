<edge source="russia_ukraine_war::energy_supply_stability" target="ai_agent_systemic_risks::agent_deployment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Degraded or unreliable energy supply raises operational costs and outage risk for energy-intensive agentic systems, directly slowing decisions to field new agent deployments in affected sectors and regions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_agent_systemic_risks</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_stability" target="global_bond_market_shock::policy_rate_expectations" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Improved energy supply stability lowers near-term commodity-price inflation risk and volatility, leading markets to price a lower expected path for central-bank policy rates.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_bond_market_shock</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_stability" target="iran_hormuz_flashpoint::oil_export_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A deterioration in energy supply stability tied to the Russia–Ukraine war (i.e., reduced European/Russian supply reliability) prompts buyers to reallocate purchases toward additional seaborne Middle Eastern crude, increasing tanker traffic and crude export volumes transiting the Strait of Hormuz; conversely, an improvement in supply stability would reduce that flow.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_stability" target="us_china_strategic_rival::trade_barriers_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Repeated disruptions to European energy supplies accelerate Western moves to onshore and diversify critical supply chains and energy inputs, producing new industrial policies and trade measures that raise barriers affecting Chinese exporters and suppliers.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_strategic_rival</data>
</edge>
