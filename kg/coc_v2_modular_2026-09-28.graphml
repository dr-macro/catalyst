</edge>
<edge source="global_bond_market_shock::bank_liquidity" target="global_bond_market_shock::political_response_press" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="global_bond_market_shock::bank_liquidity" target="iran_hormuz_flashpoint::physical_supply_disrupti" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">A drop in banks' short-term liquidity constrains trade finance and payment flows needed for port operations, terminal maintenance and fuel-loading logistics, producing operational stoppages and localized physical outages at export infrastructure serving Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
<edge source="global_bond_market_shock::bank_liquidity" target="russia_ukraine_war::energy_supply_stability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A drop in bank liquidity constrains energy firms' ability to finance fuel imports, maintenance and settlement of cross-border transactions, increasing the likelihood of outages and degrading energy supply stability.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_bond_market_shock::bank_liquidity" target="us_china_strategic_rival::diplomatic_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sudden tightening of bank liquidity in systemically important banks prompts emergency requests for central‑bank coordination, swap lines and government‑level crisis consultations that increase high‑level bilateral contacts between the US and China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">us_china_strategic_rival</data>
</edge>
