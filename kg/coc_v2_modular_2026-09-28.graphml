<edge source="us_china_strategic_rival::strategic_tension_level" target="global_bond_market_shock::sovereign_bond_yields" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in strategic tensions increases perceived geopolitical and sanction risk for governments closely tied to the rivalry, prompting creditors to demand higher risk premia and thus pushing up those sovereigns' bond yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_strategic_rival</data>
  <data key="d39">global_bond_market_shock</data>
</edge>
<edge source="us_china_strategic_rival::strategic_tension_level" target="iran_hormuz_flashpoint::maritime_attack_frequenc" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising US–China strategic rivalry drives increased naval deployments, more aggressive freedom‑of‑navigation operations, and intensified proxy signaling in the Gulf, which raises the incidence of hostile encounters and deliberate attacks against commercial shipping transiting Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_strategic_rival</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
