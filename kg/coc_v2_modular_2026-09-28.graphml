<edge source="global_bond_market_shock::corporate_credit_spreads" target="global_bond_market_shock::debt_rollover_pressure" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="global_bond_market_shock::corporate_credit_spreads" target="global_bond_market_shock::equity_valuation_multipl" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="global_bond_market_shock::corporate_credit_spreads" target="ai_agent_systemic_risks::agent_deployment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Wider corporate credit spreads raise borrowing and rollover costs for AI firms and their customers, prompting delays or cancellations of capital-intensive rollouts (cloud compute purchases, productionisation, integration), thereby reducing the near-term rate of agent deployments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">ai_agent_systemic_risks</data>
</edge>
<edge source="global_bond_market_shock::corporate_credit_spreads" target="iran_hormuz_flashpoint::oil_export_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widening corporate credit spreads raise borrowing and refinancing costs for tanker owners and oil traders (commercial paper, bond rolls, working-capital lines) and increase insurance costs, prompting firms to delay/cancel voyages and reduce loadings through the Strait of Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
<edge source="global_bond_market_shock::corporate_credit_spreads" target="russia_ukraine_war::military_aid_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widening corporate credit spreads raise defense and logistics firms' cost of capital and working-capital constraints, delaying production and delivery schedules for materiel that comprise military aid.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_bond_market_shock::corporate_credit_spreads" target="us_china_strategic_rival::tech_flow_regulation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Widening credit spreads for major Chinese technology firms signal financial distress and heightened risk of asset sales or foreign acquisitions of sensitive assets, provoking US regulators to tighten export controls and investment screening on technology transfers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">us_china_strategic_rival</data>
</edge>
