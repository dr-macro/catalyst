<edge source="global_bond_market_shock::sovereign_bond_yields" target="ai_agent_systemic_risks::governance_adapt_speed" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained increases in sovereign yields raise government borrowing costs and political pressure for fiscal tightening, which slows legislative attention, regulatory staffing and budgetary allocations needed to revise and implement AI governance, reducing adaptation speed.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">ai_agent_systemic_risks</data>
</edge>
<edge source="global_bond_market_shock::sovereign_bond_yields" target="russia_ukraine_war::military_aid_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A sudden rise in sovereign yields increases governments' near-term debt servicing and borrowing costs, forcing reallocation or slowing of discretionary foreign military assistance budgets and thus reducing the flow of military aid.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_shock</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_bond_market_shock::sovereign_bond_yields" target="us_china_strategic_rival::trade_barriers_level" id="0">
