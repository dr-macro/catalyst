<edge source="russia_ukraine_war::infrastructure_damage" target="ai_agent_systemic_risks::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">War-caused damage to critical infrastructure that leads to outages, misbehaviour, or cascading failures in AI-enabled services triggers investigations and enforcement actions, increasing the intensity and scope of regulatory attention on AI resilience and safety.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_agent_systemic_risks</data>
</edge>
