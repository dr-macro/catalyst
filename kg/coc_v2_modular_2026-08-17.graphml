<edge source="ai_bio_cyber_disruption::geo_alignment_pressure" target="global_currency_market_s::fx_exchange_rate_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intensified geopolitical alignment pressure forces capital and trade re‑routing away from targeted jurisdictions, reducing foreign demand for the affected currency and producing near‑term depreciation pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">global_currency_market_s</data>
</edge>
<edge source="ai_bio_cyber_disruption::geo_alignment_pressure" target="iran_hormuz_flashpoint::blockade_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising geopolitical pressure on firms forces carriers, insurers, and port-service providers to align with blocs and comply with state-led denial measures, enabling or legitimizing targeted refusals of service and coordinated restrictions that raise effective blockade pressure on routes like Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
<edge source="ai_bio_cyber_disruption::geo_alignment_pressure" target="russia_ukraine_war::maritime_cargo_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Intensified pressure on firms and carriers to align with rival blocs prompts insurers, shipping companies, and ports to reroute or deny service to vessels associated with sanctioned/at‑risk counterparties, directly cutting commercial maritime cargo volume through regional corridors serving the conflict.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="ai_bio_cyber_disruption::geo_alignment_pressure" target="us_china_tech_trade_riva::industrial_policy_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Rising geopolitical pressure that forces firms and capital to choose blocs induces states to activate subsidies, mandates and directed investment to onshore or bolster domestic AI supply chains, increasing industrial policy mobilization.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">us_china_tech_trade_riva</data>
</edge>
