  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increases in available training compute accelerate development and deployment of offensive cyber tools and autonomous navigation models (e.g., AIS/GPS spoofing, adversarial navigation agents) that directly cause more maritime collisions, navigation failures, and suspicious interdictions in the Strait region.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
