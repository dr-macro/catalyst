<edge source="ai_bio_cyber_disruption::regulatory_intervention" target="global_currency_market_s::short_rate_expectation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rapid tightening of AI regulation reduces near-term tech-sector investment and hiring, dampening growth and inflation expectations and causing markets to price in lower near‑term policy rates.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">global_currency_market_s</data>
</edge>
<edge source="ai_bio_cyber_disruption::regulatory_intervention" target="iran_hormuz_flashpoint::shipping_throughput" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Tighter export controls and cross-border AI/cloud restrictions disrupt access to logistics optimization, port automation, and customs-processing services used by regional shipping operators, producing measurable slowdowns and reductions in cargo throughput.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
<edge source="ai_bio_cyber_disruption::regulatory_intervention" target="russia_ukraine_war::port_operational_cap" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Tighter AI and dual‑use export controls and compliance inspections at borders and ports increase screening of compute hardware and related cargo bound for or transiting near the conflict, directly slowing throughput and reducing port operational capacity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="ai_bio_cyber_disruption::regulatory_intervention" target="us_china_tech_trade_riva::regulatory_stringency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Intense, high-profile regulatory actions against AI/bio/cyber risks prompt policymakers to adopt tighter cross‑border rules and export controls targeting the same classes of technologies, raising overall regulatory stringency in US–China tech trade.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_bio_cyber_disruption</data>
  <data key="d39">us_china_tech_trade_riva</data>
