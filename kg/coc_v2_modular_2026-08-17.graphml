  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising perception that the conflict may broaden leads governments to press firms and investors to choose or reconfigure suppliers and partnerships along security blocs (e.g., vendor de‑risking, forced localization), increasing geopolitical alignment pressure on tech actors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_bio_cyber_disruption</data>
</edge>
<edge source="russia_ukraine_war::escalation_risk_percep" target="global_currency_market_s::fx_exchange_rate_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rise in perceived escalation risk drives flight-to-safety flows into major reserve currencies (e.g., USD/CHF), mechanically appreciating those currencies versus regional/commodity-linked peers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_currency_market_s</data>
</edge>
<edge source="russia_ukraine_war::escalation_risk_percep" target="iran_hormuz_flashpoint::oil_price_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Rising perceived risk of broader escalation around Russia–Ukraine causes oil market participants to widen risk premia and increase position adjustments and speculative trading, producing higher short‑to‑medium‑term crude price volatility that is sensitive to developments in Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_hormuz_flashpoint</data>
</edge>
