<edge source="global_currency_market_s::monetary_policy_stance" target="ai_bio_cyber_disruption::systemic_financial_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A materially looser monetary policy stance (more accommodative) encourages higher leverage and risk-taking into concentrated AI assets and funds, increasing correlated exposures and the probability of system-wide losses linked to AI/tech counterparties.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_currency_market_s</data>
  <data key="d39">ai_bio_cyber_disruption</data>
</edge>
<edge source="global_currency_market_s::monetary_policy_stance" target="us_china_tech_trade_riva::industrial_policy_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A materially tighter monetary policy that depresses private investment and raises financing difficulties for strategic tech leads governments to respond by activating subsidies, directed credit lines or mandates to support domestic AI/tech sectors, increasing industrial policy activation.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_currency_market_s</data>
  <data key="d39">us_china_tech_trade_riva</data>
</edge>
