</edge>
<edge source="europe_political_shift::coalition_stability" target="europe_political_shift::electoral_volatility" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="europe_political_shift::coalition_stability" target="europe_political_shift::social_cohesion" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="europe_political_shift::coalition_stability" target="global_bond_repricing::funding_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A drop in coalition stability (or an increase in instability) raises near-term fiscal and policy default risk, prompting banks and wholesale counterparties to pull or reprice short-term lines and increase repo haircuts, directly increasing short-term funding stress.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">europe_political_shift</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="europe_political_shift::coalition_stability" target="gulf_maritime_conflict::maritime_security_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">More stable European governing coalitions are able to honor naval commitments, coordinate sanctions and intelligence sharing rapidly, and sustain multinational escorts, thereby reducing the measured maritime security risk in Gulf sea lanes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">europe_political_shift</data>
  <data key="d39">gulf_maritime_conflict</data>
</edge>
