<edge source="gulf_maritime_conflict::conflict_intensity" target="europe_political_shift::political_trust" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained rise in regional military and proxy strikes creates perceptions that governments are failing to protect economic interests or manage foreign risks, eroding citizens' confidence in institutions' competence and legitimacy.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">europe_political_shift</data>
</edge>
<edge source="gulf_maritime_conflict::conflict_intensity" target="global_bond_repricing::portfolio_reallocation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Sharp increases in regional military and maritime attacks trigger risk-off sentiment that causes rapid, large-scale shifts of investor allocations (into safe-haven bonds, gold, FX) and away from risk assets, raising the portfolio reallocation rate.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="gulf_maritime_conflict::conflict_intensity" target="russia_ukraine_war::security_response" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A spike in Gulf maritime conflict intensity requires redeployment of U.S. and allied naval and air assets to the region and shifts political attention, directly reducing the tempo and scope of immediate security deployments and reassurance measures available for the Russia–Ukraine theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="gulf_maritime_conflict::conflict_intensity" target="us_china_tech_trade::export_controls_tightnes" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Escalating conflict intensity prompts governments to broaden or tighten export controls to prevent diversion of advanced computing and dual‑use technologies to actors linked to the conflict or to reduce strategic exposure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
