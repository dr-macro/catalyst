<edge source="russia_ukraine_war::kinetic_attack_rate" target="europe_political_shift::political_trust" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Sustained high-intensity strikes that cause civilian casualties, infrastructure damage and visible security failures lower citizens' confidence in the government's competence and legitimacy to protect them.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">europe_political_shift</data>
</edge>
<edge source="russia_ukraine_war::kinetic_attack_rate" target="global_bond_repricing::portfolio_reallocation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sharp spikes in kinetic attacks heighten perceived geopolitical tail risk and immediacy of escalation, triggering rapid investor shifts out of risky assets into safe-haven bonds, FX and commodities and thus accelerating portfolio reallocation rates.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="russia_ukraine_war::kinetic_attack_rate" target="us_china_tech_trade::semiconductor_prod_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sustained, high‑intensity strikes disrupt Ukrainian production of critical inputs (notably industrial neon) and Black Sea logistics, creating near‑term shortages and bottlenecks that slow semiconductor fab throughput globally.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
