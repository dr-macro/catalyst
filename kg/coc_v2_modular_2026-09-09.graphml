<edge source="gulf_maritime_conflict::oil_supply_disruption_ra" target="europe_political_shift::far_right_support" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Acute disruptions to oil and refined-product availability raise energy prices and living costs, which voters attribute to incumbent governments and reward populist, protectionist and security‑focused far‑right parties promising rapid remedies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">europe_political_shift</data>
</edge>
<edge source="gulf_maritime_conflict::oil_supply_disruption_ra" target="global_bond_repricing::long_term_bond_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Interruptions to crude and refined-product flows raise geopolitical risk and push oil prices higher, elevating the term premium and inflation uncertainty and thereby lifting long-term government bond yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="gulf_maritime_conflict::oil_supply_disruption_ra" target="russia_ukraine_war::economic_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Significant disruptions to Gulf oil supplies drive up global energy prices and create domestic political and market pressure in Western capitals, causing them to scale back, delay, or soften new sanctions and trade measures against Russia, thereby reducing cumulative economic pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
