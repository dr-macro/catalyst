  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Rising maritime security risk increases insurance and logistics costs and raises perceived operational risk for hardware deliveries, causing firms to postpone or scale back capital deployments into AI compute infrastructure.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
