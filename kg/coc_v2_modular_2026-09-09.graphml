</edge>
<edge source="russia_ukraine_war::security_response" target="russia_ukraine_war::critical_infra_vuln" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="russia_ukraine_war::security_response" target="europe_political_shift::coalition_stability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Escalating border controls, deployments and emergency security legislation force contentious votes and budget reallocations that exacerbate policy splits within multi-party governing coalitions, increasing the risk of collapse or paralysis.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">europe_political_shift</data>
</edge>
<edge source="russia_ukraine_war::security_response" target="global_bond_repricing::funding_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Intensified security measures (border controls, asset freezes, stricter sanctions compliance) disrupt cross-border payment flows and collateral chains, reducing available liquidity for banks and corporates and raising short-term funding stress.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="russia_ukraine_war::security_response" target="gulf_maritime_conflict::maritime_security_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Heightened European/NATO security responses (troop and naval redeployments to deter escalation in/around Ukraine) pull U.S. and allied high-end naval assets toward Europe and reduce forward deterrent presence in the Gulf, increasing risk perceived by commercial shipping and opportunistic attackers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">gulf_maritime_conflict</data>
</edge>
<edge source="russia_ukraine_war::security_response" target="us_china_tech_trade::ai_infra_investment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Heightened defense postures and allied security programs translate into increased defense R&amp;D and procurement priorities for AI-enabled ISR, autonomy, and command systems, accelerating private and public capital deployment into AI compute infrastructure.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
