<edge source="gulf_maritime_conflict::maritime_security_risk" target="europe_political_shift::policy_uncertainty" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising maritime security hazards force rapid, ad‑hoc decisions on shipping routes, insurance rules, port operations and trade restrictions, increasing ambiguity about future trade, transport and defense policy for businesses and policymakers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">europe_political_shift</data>
</edge>
<edge source="gulf_maritime_conflict::maritime_security_risk" target="global_bond_repricing::funding_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Higher perceived hazard to shipping raises insurance and trade-finance costs and increases margining and collateral haircuts on trade-linked assets, tightening short-term wholesale and secured funding markets and increasing funding stress.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">global_bond_repricing</data>
</edge>
<edge source="gulf_maritime_conflict::maritime_security_risk" target="russia_ukraine_war::arms_transfer_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising maritime security risk raises insurance, forces route closures and port restrictions, and directly delays or constrains sea-borne deliveries of heavy weapons and ammunition destined for Ukraine, lowering observed arms transfer volumes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">gulf_maritime_conflict</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="gulf_maritime_conflict::maritime_security_risk" target="us_china_tech_trade::ai_infra_investment_rate" id="0">
