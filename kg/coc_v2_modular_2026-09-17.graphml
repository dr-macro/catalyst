  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Persistent cargo rerouting that raises transport costs and delivery risk incentivizes firms to secure supply chains by investing directly in foreign assets or facilities nearer suppliers and markets, increasing outbound corporate investment flows.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">red_sea_hormuz_crisis</data>
  <data key="d40">brics_economic_realignme</data>
</edge>
<edge source="red_sea_hormuz_crisis::cargo_rerouting_volume" target="global_rate_market_shock::financial_conditions_ind" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Large-scale rerouting increases transport costs and delivery uncertainty, raising working capital needs and trade‑finance utilisation and causing banks and markets to price higher lending spreads and reduced willingness to extend credit, thereby tightening financial conditions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">red_sea_hormuz_crisis</data>
  <data key="d40">global_rate_market_shock</data>
</edge>
<edge source="red_sea_hormuz_crisis::cargo_rerouting_volume" target="russia_ukraine_warfare::sanctions_circumvention" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sustained increases in rerouting and transshipment around Red Sea/Hormuz disruptions accelerate the deployment and refinement of ship‑to‑ship transfers, opaque ownership chains and alternate routing practices that can be adapted to hide origin/destination and thereby raise the practical capacity to evade sanctions on Russian energy.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">red_sea_hormuz_crisis</data>
  <data key="d40">russia_ukraine_warfare</data>
</edge>
<edge source="red_sea_hormuz_crisis::cargo_rerouting_volume" target="us_china_tech_rivalry::crossborder_competition" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Sustained increases in cargo rerouting that disrupt established trade corridors accelerate state and corporate efforts to localize or diversify critical inputs, intensifying bilateral and multilateral competition (notably between the US and China) to secure AI supply chains and talent.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">red_sea_hormuz_crisis</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
