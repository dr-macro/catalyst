<edge source="global_rate_market_shock::financial_conditions_ind" target="red_sea_hormuz_crisis::cargo_rerouting_volume" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A tightening of financial conditions raises insurance costs and restricts trade finance and liquidity for ship operators, prompting more owners to reroute or delay voyages to avoid higher premiums and cash-flow strain.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_rate_market_shock</data>
  <data key="d40">red_sea_hormuz_crisis</data>
</edge>
