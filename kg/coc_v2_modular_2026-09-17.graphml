<edge source="brics_economic_realignme::crossborder_capital_vol" target="red_sea_hormuz_crisis::financial_market_volatil" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Sharp increases in cross‑border capital flow volatility trigger margin calls, rapid portfolio rebalancing and funding stress that spill into energy and shipping desks, amplifying realized and implied volatility in financial markets sensitive to chokepoint risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">brics_economic_realignme</data>
  <data key="d40">red_sea_hormuz_crisis</data>
</edge>
