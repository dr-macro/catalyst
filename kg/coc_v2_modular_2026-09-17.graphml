  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">-</data>
</edge>
<edge source="russia_ukraine_warfare::energy_price_level" target="brics_economic_realignme::corporate_outbound_inves" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained higher energy prices raise export revenues and cash reserves for energy-exporting firms and sovereign owners, enabling and financing greater corporate outbound investment and acquisitions abroad.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_warfare</data>
  <data key="d40">brics_economic_realignme</data>
</edge>
<edge source="russia_ukraine_warfare::energy_price_level" target="global_rate_market_shock::central_bank_policy_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Sustained spikes in global energy prices driven by the Russia–Ukraine war push headline (and eventually core) inflation higher, prompting central banks to raise policy rates to meet inflation targets and anchor expectations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_warfare</data>
  <data key="d40">global_rate_market_shock</data>
</edge>
<edge source="russia_ukraine_warfare::energy_price_level" target="us_china_tech_rivalry::ai_investment_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained rises in energy and fuel prices increase the operating and data‑center electricity costs of training and running large models, reducing expected ROI and slowing new AI investment commitments.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_warfare</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
