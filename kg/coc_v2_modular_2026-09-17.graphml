  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Heightened bilateral tech rivalry prompts BRICS governments to scale up targeted subsidies, procurement preferences and directed finance for domestic tech and AI firms to preserve competitiveness and strategic autonomy.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">brics_economic_realignme</data>
</edge>
<edge source="us_china_tech_rivalry::crossborder_competition" target="global_rate_market_shock::sovereign_yield_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">An acute escalation in US–China tech rivalry raises geopolitical risk and prompts immediate safe‑haven demand for benchmark sovereign debt (e.g., US Treasuries), mechanically pushing benchmark yields lower.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_rate_market_shock</data>
</edge>
<edge source="us_china_tech_rivalry::crossborder_competition" target="red_sea_hormuz_crisis::maritime_security_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Escalating US–China strategic competition leads both states to increase naval patrols, escort operations and assertive shadowing in the Red Sea and Strait of Hormuz, producing more confrontations and reported incidents that raise operator and market perceptions of maritime security risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">red_sea_hormuz_crisis</data>
</edge>
