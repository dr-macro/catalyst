<edge source="red_sea_hormuz_crisis::maritime_security_risk" target="brics_economic_realignme::state_control_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A rapid rise in perceived maritime security risk leads governments to impose immediate regulatory and administrative controls (heightened port inspections, export/import restrictions, emergency energy regulations and tighter licensing) to manage supply‑chain and national security exposures.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">red_sea_hormuz_crisis</data>
  <data key="d40">brics_economic_realignme</data>
</edge>
<edge source="red_sea_hormuz_crisis::maritime_security_risk" target="global_rate_market_shock::policy_rate_expectations" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Higher perceived maritime security risk raises the probability of persistent energy and goods-supply shocks, which lifts short-term inflation expectations and leads markets to price a sooner or higher path for policy rates based on central banks' reaction functions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">red_sea_hormuz_crisis</data>
  <data key="d40">global_rate_market_shock</data>
</edge>
