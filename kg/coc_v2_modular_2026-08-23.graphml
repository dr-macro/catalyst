  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Portfolio reallocation out of stressed US bonds into equities and growth sectors drives near-term increases in venture, private equity and public funding directed at AI startups and funds.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_debt_bond_stress</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
