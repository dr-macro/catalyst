  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained uptick in North Korean missile tests and munitions production increases DPRK surplus stocks and political leverage, enabling faster, larger transfers of artillery, rockets and munitions to Russia for use in Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="north_korea_nuclear::military_activity" target="us_china_tech_trade::model_deployment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A spike in missile tests and regional military operations creates immediate operational demand for AI-enabled ISR, warning and targeting systems, pushing defense contractors and partners to accelerate production deployments of new models.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">us_china_tech_trade</data>
