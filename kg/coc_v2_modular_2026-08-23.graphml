<edge source="north_korea_nuclear::military_activity" target="us_debt_bond_stress::market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Spikes in missile tests, live-fire drills or near-shore naval maneuvers cause sudden repricing of geopolitical risk and prompt rapid hedging and position-squaring in Treasury futures and options, creating sharp increases in realized and implied fixed-income volatility.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">us_debt_bond_stress</data>
</edge>
<edge source="north_korea_nuclear::military_activity" target="us_debt_bond_stress::market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intense or unpredictable military operations increase counterparty and settlement risk, leading primary dealers and market makers to widen bid-ask spreads and reduce inventories, which materially reduces on-the-run Treasury market depth and turnover.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">us_debt_bond_stress</data>
</edge>
