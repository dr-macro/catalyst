<edge source="north_korea_nuclear::geopolitical_tension" target="russia_ukraine_war::external_arms_supply_rat" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sharp rise in North Korean nuclear-related tension forces Western suppliers and logistics partners to reassign diplomatic bandwidth, transport capacity and inspection resources to Indo‑Pacific contingencies, slowing approvals and physical deliveries of Western-supplied arms into the Russia–Ukraine theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="north_korea_nuclear::geopolitical_tension" target="us_china_tech_trade::crossborder_restriction" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A North Korean nuclear escalation raises US and allied threat perceptions, prompting rapid targeted export controls, visa curbs and tighter licensing that directly increase cross-border barriers for AI-related goods, services and talent.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
<edge source="north_korea_nuclear::geopolitical_tension" target="us_debt_bond_stress::long_term_yields" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Heightened regional strategic rivalry drives global risk-off flows into US Treasuries and compresses the term premium as investors buy long-dated government paper, mechanically lowering long-term yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">us_debt_bond_stress</data>
</edge>
