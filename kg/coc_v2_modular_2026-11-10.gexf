          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher perceived escalation risk induces state and proxy commanders to launch more preemptive, deterrent, or retaliatory strikes, raising the rate of offensive attacks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_regional_war" />
          <attvalue for="39" value="global_energy_chokepoint" />
