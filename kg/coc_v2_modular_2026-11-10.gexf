          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Large-scale, visible damage to chokepoint infrastructure generates acute domestic economic and security pressures that produce divergent national responses (calls for restraint, emergency aid, or retaliation), thereby eroding allied consensus on strategy and resource-sharing." />
