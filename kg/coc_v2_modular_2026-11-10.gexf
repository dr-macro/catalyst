          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A rapid surge in unverified reporting and rumor about the conflict overloads liaison channels and analytic pipelines, delaying validation and reducing the timeliness and operational utility of shared intelligence." />
          <attvalue for="37" value="0-6 months" />
