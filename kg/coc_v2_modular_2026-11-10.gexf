          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rising perception of imminent regional escalation prompts US policymakers to expand national-security justifications for export controls, investment reviews, and sanctions targeting Chinese tech firms, increasing intensity and scope of regulatory scrutiny." />
