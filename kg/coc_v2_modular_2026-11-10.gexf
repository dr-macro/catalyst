          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large-scale, visible damage to energy and urban assets creates pressure for rapid attribution and response, prompting states to increase timeliness and depth of intelligence exchange to coordinate defensive and diplomatic actions." />
