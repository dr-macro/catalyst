          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sustained rise in strikes against chokepoints creates immediate operational demand for coordinated maritime and energy-defense information, prompting faster and more complete bilateral and multilateral intelligence exchanges to protect shipping and infrastructure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_chokepoint" />
          <attvalue for="39" value="russia_ukraine_war" />
