      <edge source="europe_hybrid_threats::supply_chain_disruption" target="global_energy_chokepoint::energy_supply_risk" id="725">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Physical interruptions at ports, terminals and transport routes delay or block fuel and component deliveries to choke-point facilities, directly increasing the likelihood and magnitude of energy supply interruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="europe_hybrid_threats" />
          <attvalue for="39" value="global_energy_chokepoint" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_hybrid_threats::supply_chain_disruption" target="russia_ukraine_war::energy_supply_stability" id="726">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Persistent disruptions to transport, ports and logistics routes reduce deliveries of fuel, spare parts and maintenance supplies to Ukraine and neighboring markets, directly degrading continuity and reliability of energy availability in the conflict theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="europe_hybrid_threats" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_hybrid_threats::supply_chain_disruption" target="us_china_tech_rivalry::investor_sentiment_level" id="727">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Persistent disruptions to European ports, transport and component flows raise near‑term operational and earnings risk for firms dependent on US–China tech supply links, directly depressing investor sentiment for companies and sectors at the center of the tech rivalry." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="europe_hybrid_threats" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
