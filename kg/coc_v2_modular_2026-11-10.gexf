      <edge source="us_china_tech_rivalry::media_attention" target="russia_ukraine_war::political_cohesion" id="378">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Surges in public and media coverage tying Chinese tech actors to Moscow generate domestic political pressure that pushes allied governments toward more coordinated sanctions and policy alignment on the Russia–Ukraine war, increasing political cohesion among partners." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::media_attention" target="us_iran_regional_war::information_flow" id="379">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A surge in global media and social‑media coverage of the US–China tech rivalry reallocates newsroom attention and public bandwidth away from the US–Iran confrontation, reducing the volume and velocity of reporting and public information about the regional conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="us_iran_regional_war" />
