          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained rise in physical strikes against energy infrastructure prompts actors to conduct parallel cyber operations (to degrade command-and-control, disable backups, or create confusion), increasing unauthorized intrusions against European targets as part of coordinated hybrid campaigns." />
          <attvalue for="37" value="0-6 months" />
