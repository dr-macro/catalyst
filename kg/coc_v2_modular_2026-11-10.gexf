      <edge source="europe_hybrid_threats::cyber_intrusion_rate" target="russia_ukraine_war::cyber_intrusion_rate" id="693">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An uptick in unauthorized cyber operations in the European operational area reflects heightened attacker tempo and tooling that spill over into increased frequency and severity of intrusions against Ukrainian networks (shared targets, infrastructure, or mirrored campaigns)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="europe_hybrid_threats" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
