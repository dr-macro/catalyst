          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A drop in oil export throughput or transit capacity from the Gulf caused by the US–Iran confrontation produces immediate supply shocks and price volatility that reduce the continuity and reliability of energy deliveries to European and regional markets supporting the Russia–Ukraine theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_regional_war" />
          <attvalue for="39" value="russia_ukraine_war" />
