          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Improved investor sentiment toward tech-sector firms increases capital availability for component manufacturers and logistics providers, reducing insolvencies and production stoppages that would otherwise produce interruptions in European supply chains." />
          <attvalue for="37" value="6-18 months" />
