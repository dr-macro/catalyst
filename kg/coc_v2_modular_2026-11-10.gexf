          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Greater cohesion among European allies produces more aligned policies, synchronized support packages and unified messaging that directly raise consensus and coordinated political action among the states supporting Ukraine." />
