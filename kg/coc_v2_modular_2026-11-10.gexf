          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An increased volume and velocity of public reporting and operational chatter about the US–Iran war creates more exploitable situational noise and phishing/cover narratives that hostile actors use to raise the frequency and success of cyber intrusions against networks linked to the Russia–Ukraine conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_regional_war" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
