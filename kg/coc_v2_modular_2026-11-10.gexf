          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A drop in oil supply that drives price spikes and recession fears reduces risk appetite and raises discount rates, causing investors to pull back from high-growth, supply-chain‑exposed tech investments tied to US–China links and lowering sector sentiment." />
          <attvalue for="37" value="0-6 months" />
