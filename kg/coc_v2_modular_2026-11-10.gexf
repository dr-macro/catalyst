          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher tempo of successful cyber intrusions degrades command-and-control, sensor feeds and intercept coordination for air/missile defenses, lowering detection and interception performance." />
