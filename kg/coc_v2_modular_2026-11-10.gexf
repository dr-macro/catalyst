      <edge source="global_energy_chokepoint::energy_supply_risk" target="europe_hybrid_threats::supply_chain_disruption" id="601">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Heightened risk of interrupted production or transport through a major energy chokepoint forces rerouting of shipping, port congestion, fuel shortages for logistics and emergency restrictions, producing more frequent and persistent commercial supply-chain interruptions in Europe." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_chokepoint" />
          <attvalue for="39" value="europe_hybrid_threats" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_chokepoint::energy_supply_risk" target="russia_ukraine_war::energy_supply_stability" id="602">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="An increased likelihood of disruptions at global energy chokepoints directly reduces the continuity and predictability of fuel deliveries to the theater by forcing rerouting, canceling shipments, and triggering market/contractual interruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_chokepoint" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_chokepoint::energy_supply_risk" target="us_china_tech_rivalry::geopolitical_tension" id="603">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Acute increases in the risk of energy supply interruptions from a chokepoint prompt accelerated naval deployments, sanctions threats, and diplomatic pressure among consumers and suppliers—heightening interstate strategic friction between the U.S. and China over access and influence." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_chokepoint" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_chokepoint::energy_supply_risk" target="us_china_tech_rivalry::media_attention" id="604">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising likelihood of energy cutoffs at a major chokepoint generates immediate news and social-media coverage linking supply-chain vulnerability to tech-sector risks, increasing attention on the US–China technology rivalry." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_chokepoint" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
