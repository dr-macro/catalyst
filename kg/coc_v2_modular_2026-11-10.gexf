      <edge source="us_china_tech_rivalry::geopolitical_tension" target="europe_hybrid_threats::alliance_cohesion" id="449">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A spike in US–China tech rivalry creates immediate political pressure on European capitals to harmonize export controls, standards and security postures with like-minded partners, producing tighter coordinated policy and decision-making among allies." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="europe_hybrid_threats" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="europe_hybrid_threats::cyber_intrusion_rate" id="450">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising interstate tech rivalry increases incentives for state-linked actors to conduct offensive cyber operations in European networks to collect intelligence, test defences, or signal resolve, thereby raising the tempo of intrusions against targets in Europe." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="europe_hybrid_threats" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="global_energy_chokepoint::attack_frequency" id="451">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising US–China strategic friction increases proxy competition, permissive rules of engagement, and arms/tech flows to regional actors, which raises the incidence of offensive strikes (missile, drone) against energy and urban infrastructure in contested theaters." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_energy_chokepoint" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="russia_ukraine_war::hybrid_attack_intensity" id="452">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalation in US–China strategic and technological rivalry raises incentives for state and proxy actors to undertake more aggressive combined cyber, information and kinetic actions in and around Ukraine—both to exploit perceived great‑power distraction and to send strategic signals—raising hybrid-attack tempo." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="us_iran_regional_war::public_restraint" id="453">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising strategic friction between the US and China hardens domestic and allied policymaker postures and diminishes political incentives to publicly signal de‑escalation with Iran, lowering the prevalence and strength of restraint messaging." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="us_iran_regional_war" />
          <attvalue for="28" value="0" />
        </attvalues>
