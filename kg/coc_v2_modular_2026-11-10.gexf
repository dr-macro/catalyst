          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A reduction in oil supply flow (production, exports, or transit throughput) directly raises the likelihood and potential magnitude of energy-supply interruptions by shrinking available physical and market buffers." />
