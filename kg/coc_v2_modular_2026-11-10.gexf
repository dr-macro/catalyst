          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising risk of supply interruptions prompts governments and major companies to issue public calls for de‑escalation and restraint to protect access to energy and stabilize markets." />
