          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Improved policy alignment and coordinated decision-making enable faster joint deployments, shared rules of engagement and pooled sensor-fire capabilities that raise operational defense performance at energy chokepoints." />
