          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Increased speed and volume of reporting and warnings provides earlier detection cues and actionable intelligence to air/missile-defense operators, improving interception timing and asset allocation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_regional_war" />
