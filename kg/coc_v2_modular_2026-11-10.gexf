          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rising tempo of cyber intrusions in Europe attributed to Iranian state or proxy actors prompts U.S. military and intelligence warnings and risks misattribution or defensive/retaliatory moves, increasing perceived escalation risk in the US–Iran confrontation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="europe_hybrid_threats" />
