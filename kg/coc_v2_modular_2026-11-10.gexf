      <edge source="europe_hybrid_threats::cyber_intrusion_rate" target="us_china_tech_rivalry::info_security_vuln" id="694">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A rising tempo of cyber intrusions against European targets uncovers and exfiltrates credentials, tools and zero‑day knowledge used by multinational tech firms that operate in the US–China technology space, directly increasing measured information‑security vulnerabilities for actors in that rivalry." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="europe_hybrid_threats" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
