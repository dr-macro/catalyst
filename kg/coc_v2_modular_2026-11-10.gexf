          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained disruptions at European ports and logistics nodes force rerouting and schedule compression that increase transits through Middle Eastern chokepoints, raising the degree of shipping route disruptions in the US–Iran theatre." />
