        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A deterioration in energy supply stability (damaged infrastructure, export curbs or transit closures) directly increases the likelihood and potential magnitude of interruptions at global energy chokepoints such as pipelines, terminals and shipping routes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_chokepoint" />
          <attvalue for="28" value="0" />
