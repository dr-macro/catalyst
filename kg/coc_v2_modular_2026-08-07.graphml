  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A tightening in monetary policy reduces real economic activity and commodity demand and increases financing costs for commodity positions, putting downward pressure on dollar-denominated oil prices within months.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">monetary_currency_shift</data>
  <data key="d39">strait_of_hormuz</data>
</edge>
