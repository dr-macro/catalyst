  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Frequent cross-border missile and rocket exchanges drive urgent requests from Israel for interceptor missiles and air-defence munitions from Western stockpiles, producing immediate drawdowns and delaying/rescinding planned resupplies destined for Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">israel_gaza_lebanon</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="israel_gaza_lebanon::cross_border_hostilities" target="strait_hormuz_standoff::rerouting_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">An increase in cross‑border strikes and cross‑front incidents raises perceived spillover risk to wider regional lines of communication, causing commercial operators to divert voyages around the Cape or choose alternative ports, increasing rerouting rates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">israel_gaza_lebanon</data>
  <data key="d40">strait_hormuz_standoff</data>
</edge>
<edge source="israel_gaza_lebanon::cross_border_hostilities" target="us_china_tech_rivalry::cross_border_capital_flo" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Frequent cross-border strikes and incidents increase perceived operational and political risk for overseas investors, causing Chinese and US tech firms and financiers to delay, reroute, or cancel cross-border M&amp;A and project financing in affected regions, reducing cross-border tech capital flows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">israel_gaza_lebanon</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
