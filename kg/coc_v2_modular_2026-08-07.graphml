<edge source="global_energy_security::cash_liquidity_level" target="monetary_currency_shift::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher cash and liquid buffers held by large energy firms and exporting sovereigns enable and finance increased outbound investment and deposit placements in foreign markets, raising net cross-border capital flows.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_energy_security</data>
  <data key="d39">monetary_currency_shift</data>
</edge>
<edge source="global_energy_security::cash_liquidity_level" target="strait_of_hormuz::crude_export_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Higher cash and committed liquidity in regional producers and service contractors allows timely payment for chartering tankers, bunkers, insurance and port fees, preventing shipment delays and sustaining seaborne crude flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_security</data>
  <data key="d39">strait_of_hormuz</data>
</edge>
<edge source="global_energy_security::cash_liquidity_level" target="us_china_tech_rivalry::cross_border_capital_flo" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Improved cash and liquidity positions among energy sector firms and banks (after an energy shock abates) increases available lending and balance‑sheet capacity to finance cross‑border M&amp;A and greenfield investments in tech and data centers, raising cross‑border capital flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_security</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
