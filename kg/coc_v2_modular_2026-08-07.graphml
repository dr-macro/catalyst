<edge source="russia_ukraine_war::critical_infra_vuln" target="global_energy_security::cash_liquidity_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Greater vulnerability of energy infrastructure increases the likelihood of sudden asset damage and unplanned expenditures (repairs, emergency procurement, insurance deductibles), leading firms to draw down cash reserves and committed liquidity to cover short-term outflows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_energy_security</data>
</edge>
