<edge source="us_china_tech_rivalry::ai_dc_investment_rate" target="israel_gaza_lebanon::military_kinetic_intensi" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">An uptick in AI and data‑center investment by US/allied firms and governments accelerates cloud‑based ISR/processing and targeting support made available to partners, enabling faster target identification and shorter decision cycles that raise the tempo and scale of kinetic strikes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">israel_gaza_lebanon</data>
</edge>
<edge source="us_china_tech_rivalry::ai_dc_investment_rate" target="north_korea_threat::crossborder_incidents" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Increased AI and data‑centre investment by the US and its partners expands ISR, automated warning and targeting capabilities available to ROK/US forces, improving deterrence and reducing the frequency of DPRK provocations and cross‑border incidents.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">north_korea_threat</data>
</edge>
<edge source="us_china_tech_rivalry::ai_dc_investment_rate" target="strait_hormuz_standoff::maritime_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rises in AI and data‑center investment enable faster deployment of maritime domain awareness, automated monitoring and interdiction coordination that deter and reduce successful hostile actions against commercial vessels.</data>
  <data key="d38">6-18 months</data>
