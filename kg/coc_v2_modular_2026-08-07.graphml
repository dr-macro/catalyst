<edge source="strait_of_hormuz::disruption_sentiment" target="global_energy_security::investor_sentiment_index" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rise in market expectations of supply interruption quickly shifts investor risk appetite against energy-sector equities, lowering sentiment and increasing discount rates priced into those stocks.</data>
  <data key="d37">0-3 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">global_energy_security</data>
</edge>
<edge source="strait_of_hormuz::disruption_sentiment" target="monetary_currency_shift::rate_expectations" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Growing market expectations of transit disruptions lead investors to anticipate supply-driven price pressures (e.g., energy and transport costs), which raises priced-in expectations for earlier or higher central-bank policy rates.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">monetary_currency_shift</data>
</edge>
