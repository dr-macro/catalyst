<edge source="strait_of_hormuz::naval_presence_intensity" target="global_energy_security::cash_liquidity_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Elevated military and paramilitary activity around the Strait raises war-risk insurance premiums, chartering costs and route detours, increasing near-term cash outflows for shipping and trading desks and reducing available short-term liquidity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">global_energy_security</data>
</edge>
<edge source="strait_of_hormuz::naval_presence_intensity" target="monetary_currency_shift::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A surge in naval and paramilitary activity raises perceived geopolitical and shipping risk, prompting portfolio rebalancing, reduced new investment commitments and shorter-term capital withdrawals from the corridor and adjacent markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">monetary_currency_shift</data>
</edge>
<edge source="strait_of_hormuz::naval_presence_intensity" target="us_china_tech_rivalry::export_controls_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A surge in military and paramilitary activity and incidents around Hormuz provokes policy and enforcement responses in Washington (and allied capitals) that expand the scope and strictness of export controls on dual‑use and advanced technologies to China on national‑security grounds.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
