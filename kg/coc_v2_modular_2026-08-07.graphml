<edge source="strait_of_hormuz::crude_export_flow_rate" target="global_energy_security::operating_margin_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A sustained drop in seaborne crude exports reduces refinery and export terminal throughput, forcing run-rate cuts and higher per-unit fixed-cost absorption that compress operating margins for integrated producers and refiners.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">global_energy_security</data>
</edge>
<edge source="strait_of_hormuz::crude_export_flow_rate" target="monetary_currency_shift::exchange_rate_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Higher crude export flows increase foreign-currency receipts and central-bank FX supply for oil-exporting jurisdictions, directly supporting their currencies and pushing exchange rates toward appreciation.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">monetary_currency_shift</data>
</edge>
<edge source="strait_of_hormuz::crude_export_flow_rate" target="russia_ukraine_war::critical_infra_vuln" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in crude export flow through the Hormuz corridor dampens price spikes and curtails windfall energy revenues for Russia and its suppliers, reducing the tempo and scale of offensive strikes against Ukrainian energy and logistics infrastructure and thereby lowering critical infrastructure vulnerability.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="strait_of_hormuz::crude_export_flow_rate" target="us_china_tech_rivalry::advanced_chip_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Reductions or interruptions in crude export shipping through Hormuz drive higher freight, port congestion and insurance costs and create shipment delays that disrupt delivery and installation schedules for large, time‑sensitive semiconductor fab equipment, slowing the ramp‑up of advanced chip production capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">strait_of_hormuz</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
