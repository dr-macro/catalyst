  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A spike in visible cross-border incidents involving North Korea raises global war‑risk perceptions among underwriters, who promptly increase marine war and political‑risk premiums for vessels transiting other high‑exposure chokepoints such as the Strait of Hormuz.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_threat</data>
  <data key="d40">strait_hormuz_standoff</data>
</edge>
