<edge source="israel_gaza_lebanon::diplomatic_pressure_inte" target="north_korea_threat::diplomatic_engagement" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A surge in international diplomatic pressure focused on the Israel crisis consumes diplomatic bandwidth and prioritization among Western capitals, reducing the frequency and intensity of formal and back‑channel engagement with North Korea.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">israel_gaza_lebanon</data>
  <data key="d40">north_korea_threat</data>
</edge>
