<edge source="north_korea_threat::political_constraint" target="russia_ukraine_war::drone_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Rising domestic political pressure on US/ally governments to prioritize the Korea theatre leads lawmakers or executives to cut, delay, or condition funding and transfers that sustain Ukraine's drone logistics and munitions, lowering Ukraine's operational drone sortie rate.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_threat</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="north_korea_threat::political_constraint" target="us_china_tech_rivalry::cross_border_capital_flo" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Heightened domestic political pressure on leaders (legislators, publics, investors) in response to North Korean threats leads to tougher investment screening and political blocking of cross‑border tech M&amp;A and financing, reducing capital flows.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">north_korea_threat</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
