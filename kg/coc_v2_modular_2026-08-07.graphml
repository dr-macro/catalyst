  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A demonstrably looser monetary policy stance (lower policy rates and easing bias) raises risk appetite and lowers discount-rate sensitivity for energy sector equities, lifting aggregate investor sentiment toward the sector within monetary transmission timelines.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">monetary_currency_shift</data>
  <data key="d39">global_energy_security</data>
</edge>
<edge source="monetary_currency_shift::monetary_policy_stance" target="strait_of_hormuz::oil_price_level" id="0">
