<edge source="ai_tech_competition::model_capability" target="monetary_bond_stress::policy_signal_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A rapid, high‑visibility jump in model capability provokes immediate public comment and guidance from central banks, finance ministries and regulators about economic disruption and financial stability, increasing the frequency and intensity of official policy communications.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">ai_tech_competition</data>
  <data key="d40">monetary_bond_stress</data>
</edge>
<edge source="ai_tech_competition::model_capability" target="russia_ukraine_war::kinetic_attack_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Marked improvements in deployed AI models (better real‑time ISR fusion, target recognition and strike routing) shorten sensor-to-shooter cycles and enable higher tempo, more precise strike sorties, raising the observable rate and scale of kinetic attacks.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_tech_competition</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="ai_tech_competition::model_capability" target="us_iran_gulf_conflict::sanctions_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Rapid improvements in AI model capability enable more effective detection, attribution and automated analysis of sanctions-evasion networks (shipping, finance, front companies), giving policymakers the evidence and operational tools to broaden and intensify targeted sanctions against Iranian actors.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">ai_tech_competition</data>
  <data key="d40">us_iran_gulf_conflict</data>
</edge>
