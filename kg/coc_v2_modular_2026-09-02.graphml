<edge source="us_iran_gulf_conflict::tanker_incidents" target="energy_geopolitics_shift::supply_disruption_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Attacks or interdictions on tankers directly interrupt maritime delivery routes and port operations, immediately raising the probability and expected severity of upstream and logistics supply disruptions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_conflict</data>
  <data key="d40">energy_geopolitics_shift</data>
</edge>
<edge source="us_iran_gulf_conflict::tanker_incidents" target="monetary_bond_stress::long_term_bond_yields" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A marked rise in tanker incidents increases persistent geopolitical and supply‑chain uncertainty and liquidity risk, which raises term premia demanded by investors and thus lifts long-dated government bond yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_conflict</data>
  <data key="d40">monetary_bond_stress</data>
</edge>
<edge source="us_iran_gulf_conflict::tanker_incidents" target="russia_ukraine_war::supply_chain_integrity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A higher rate of attacks and interdictions on tankers forces rerouting, port avoidance and elevated insurance/inspection delays that disrupt maritime logistics for defense-relevant components and spares bound for Ukraine and its suppliers, degrading supply‑chain continuity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_conflict</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
