<edge source="energy_geopolitics_shift::capital_commitments" target="ai_tech_competition::investment_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A surge in investor capital locked into oil asset development ties up available private and public funding pools and reduces near-term allocations to AI startups, R&amp;D and infrastructure, lowering net AI investment flow.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">ai_tech_competition</data>
</edge>
<edge source="energy_geopolitics_shift::capital_commitments" target="russia_ukraine_war::defense_procurement_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising investor capital commitments into domestic energy projects increase government and partner access to cash and credit, enabling faster contracting and financing of defense acquisitions and deliveries.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
