<edge source="us_iran_gulf_conflict::sanctions_pressure" target="ai_tech_competition::regulatory_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalating sanctions routines prompt governments to broaden export controls, compliance checks and licensing regimes to cover AI-relevant hardware and software, raising formal regulatory activity aimed at AI development and transfer.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_conflict</data>
  <data key="d40">ai_tech_competition</data>
</edge>
<edge source="us_iran_gulf_conflict::sanctions_pressure" target="ai_tech_competition::investment_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Intensified sanctions drive public and private actors to onshore or ally-source critical AI supply chains and chip capacity, channeling new capital into domestic AI R&amp;D and infrastructure to reduce dependence on sanctioned/exposed partners.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_iran_gulf_conflict</data>
  <data key="d40">ai_tech_competition</data>
</edge>
<edge source="us_iran_gulf_conflict::sanctions_pressure" target="energy_geopolitics_shift::control_over_reserves" id="0">
