  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Escalating sanctions compel foreign operators and service providers to divest or be expelled from local projects, reducing the extent of external actors' operational and proprietary control over the reserves.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_iran_gulf_conflict</data>
  <data key="d40">energy_geopolitics_shift</data>
</edge>
<edge source="us_iran_gulf_conflict::sanctions_pressure" target="monetary_bond_stress::sovereign_borrowing_cost" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalating sanctions restrict access to external finance and reduce secondary‑market liquidity for targeted sovereigns (and closely linked issuers), forcing higher issuance yields and wider credit spreads on their debt.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_gulf_conflict</data>
  <data key="d40">monetary_bond_stress</data>
</edge>
