<edge source="energy_geopolitics_shift::supply_disruption_risk" target="ai_tech_competition::model_capability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Rising risk of oil/logistics disruptions drives electricity price volatility and constraints on data-center power supply or fuel for backup generators, forcing reduced large-scale training runs and degrading near-term model capability development.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">ai_tech_competition</data>
</edge>
<edge source="energy_geopolitics_shift::supply_disruption_risk" target="monetary_bond_stress::long_term_bond_yields" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A rising risk of oil supply disruptions raises near‑term inflation uncertainty and demand for a term premium from long‑dated bond investors, directly lifting long‑term government yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">monetary_bond_stress</data>
</edge>
<edge source="energy_geopolitics_shift::supply_disruption_risk" target="russia_ukraine_war::supply_chain_integrity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Higher risk of energy-supply disruptions (pipeline outages, tanker interdictions, logistic chokepoints) directly interrupts fuel availability and industrial power, halting transport and production lines and degrading defense-relevant supply-chain continuity and reliability.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="energy_geopolitics_shift::supply_disruption_risk" target="us_iran_gulf_conflict::tanker_incidents" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising assessed risk of supply disruptions incentivizes state and non-state actors to interdict or attack shipping routes and increases preemptive seizures/inspections, directly raising the observed frequency of tanker incidents in the Gulf.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">us_iran_gulf_conflict</data>
</edge>
