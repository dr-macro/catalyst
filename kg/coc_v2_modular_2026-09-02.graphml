  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">An increase in external control over a country's oil reserves erodes investor confidence in domestic asset sovereignty and governance, prompting reallocation or withdrawal of cross‑border portfolio flows away from that country's bonds and equities.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">monetary_bond_stress</data>
</edge>
<edge source="energy_geopolitics_shift::control_over_reserves" target="russia_ukraine_war::military_force_strength" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">An increase in external control over a state's oil reserves cuts state-operated oil revenue and restricts cashflow used to pay personnel, operate units and sustain mobilization, degrading available combat-capable forces within months.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
