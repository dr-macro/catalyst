<edge source="energy_geopolitics_shift::intl_legal_risk" target="ai_tech_competition::regulatory_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Elevated cross-border legal disputes and sanctions around energy deals prompt governments to broaden export controls, investment screening and cross-sector security rules, increasing regulatory pressure on AI development and deployment.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">ai_tech_competition</data>
</edge>
<edge source="energy_geopolitics_shift::intl_legal_risk" target="monetary_bond_stress::sovereign_borrowing_cost" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Escalating international legal disputes or sanction risk raises counterparty, enforceability and payout uncertainties for creditors, causing lenders to demand higher yields on sovereign issuance and widening borrowing spreads.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_geopolitics_shift</data>
  <data key="d40">monetary_bond_stress</data>
</edge>
