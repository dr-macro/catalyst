<edge source="space_comm_governance::military_service_reliab" target="russia_ukraine_conflict::conflict_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Improved reliability of commercial and hybrid satcom for military use shortens ISR-to-shooter cycles and sustainment of forward formations, enabling higher-tempo offensive and counter-fire operations that increase aggregate kinetic activity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">space_comm_governance</data>
  <data key="d40">russia_ukraine_conflict</data>
</edge>
<edge source="space_comm_governance::military_service_reliab" target="us_china_tech_rivalry::ai_deployment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Improved operational reliability of space communications for military customers reduces perceived operational risk for systems that depend on satellite links, prompting defense and dual‑use contractors to accelerate deployment of AI agents and services that rely on those links.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">space_comm_governance</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="space_comm_governance::military_service_reliab" target="western_bond_volatility::safe_haven_asset_demand" id="0">
