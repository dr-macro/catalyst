<edge source="us_china_tech_rivalry::regulatory_stringency" target="mid_east_energy::oil_export_flow_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">New restrictive export/operational rules on AI-enabled control systems and dual‑use industrial electronics reduce availability and timely servicing of critical oilfield and refinery control equipment, causing slower production and lower export flow rates as operators delay output to avoid safety incidents.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">mid_east_energy</data>
</edge>
<edge source="us_china_tech_rivalry::regulatory_stringency" target="russia_ukraine_conflict::conflict_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Stronger AI export controls and licensing restrictions by Western and allied regulators reduce Russia's access to advanced AI-enabled targeting, ISR and weapon automation, degrading its operational tempo and thereby reducing near-to-medium-term kinetic intensity.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">russia_ukraine_conflict</data>
</edge>
<edge source="us_china_tech_rivalry::regulatory_stringency" target="space_comm_governance::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.8</data>
  <data key="d37">Stricter AI and export regimes expand regulatory mandates and reporting requirements, prompting agencies to increase investigatory activity and compliance checks on space‑communications providers employing or trading AI systems.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">space_comm_governance</data>
</edge>
<edge source="us_china_tech_rivalry::regulatory_stringency" target="western_bond_volatility::safe_haven_asset_demand" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Rapid increases in export controls and cross-border regulatory barriers raise geopolitical and policy uncertainty, triggering portfolio reallocation into perceived safe-haven assets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
