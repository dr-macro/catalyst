<edge source="russia_ukraine_conflict::sabotage_espionage_rate" target="mid_east_energy::supply_disruption_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Escalation of state-linked cyber and sabotage activity tied to the Russia–Ukraine conflict spills into attacks on global energy logistics and operators (including Middle East terminals and shipping services), raising market-perceived probability of physical or operational interruptions to Middle Eastern exports.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_conflict</data>
  <data key="d40">mid_east_energy</data>
</edge>
<edge source="russia_ukraine_conflict::sabotage_espionage_rate" target="space_comm_governance::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A rise in sabotage and espionage incidents targeting satellite operators or their supply chains triggers national security and telecom regulators to open investigations, demand audits, and tighten compliance requirements for space-communications firms.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_conflict</data>
  <data key="d40">space_comm_governance</data>
</edge>
<edge source="russia_ukraine_conflict::sabotage_espionage_rate" target="us_china_tech_rivalry::supply_chain_frictions" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A higher rate of sabotage and espionage incidents (physical attacks, cyber intrusions on logistics or chip fabs, tampering) creates concrete delays, capacity losses and rerouting costs that increase component shortages and logistical frictions for AI hardware across US–China supply links.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_conflict</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_conflict::sabotage_espionage_rate" target="western_bond_volatility::bond_market_liquidity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Increases in sabotage and cyber-espionage incidents targeting trading venues, clearing or settlement systems and major market participants intermittently disrupt trading and settlement, widening bid-ask spreads and reducing market depth.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_conflict</data>
  <data key="d40">western_bond_volatility</data>
</edge>
