          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rising geopolitical risk perception leads investors and funds to delay, scale back or withdraw cross-border commitments, producing an observable drop in inbound foreign investment and increased capital flight." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="39" value="shipping_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade::geo_risk_percep" target="us_iran_standoff::global_oil_price_level" id="463">
        <attvalues>
