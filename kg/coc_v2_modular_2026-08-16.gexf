      <edge source="us_china_tech_trade::geo_risk_percep" target="russia_ukraine_war::maritime_export_throughp" id="461">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in geopolitical risk perception tied to US–China tech/trade tensions raises insurer premiums and routing risk assessments, prompting shipping companies and freight forwarders to reroute or suspend calls through nearby regional maritime corridors (including Black Sea access points), reducing throughput." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
