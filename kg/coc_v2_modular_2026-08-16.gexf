          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rapid increase in AI compute demand drives immediate, large-volume orders for GPUs/accelerators and server subsystems that draw down inventories and extend supplier lead times, reducing on‑hand and pipeline availability." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_economic_shift" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
