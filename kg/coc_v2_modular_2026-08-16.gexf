      <edge source="us_iran_standoff::maritime_incident_rate" target="ai_economic_shift::compute_demand_intensity" id="56">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in maritime incidents disrupts hardware shipments (GPUs, accelerators) and increases delivery uncertainty, causing firms to shift from on‑prem purchases to renting cloud compute, thereby raising demand intensity for cloud/hosted AI compute." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="ai_economic_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::maritime_incident_rate" target="russia_ukraine_war::maritime_export_throughp" id="57">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rising rate of hostile incidents in a major chokepoint forces shipowners/insurers to reroute, delay or avoid calling at higher-risk regional ports and reallocates available tonnage, reducing effective export throughput from other contested maritime corridors including the Black Sea." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::maritime_incident_rate" target="shipping_chokepoints::global_freight_rates" id="58">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An uptick in hostile or disruptive incidents raises insurance and security premiums, forces longer detours and slower operations, and thus raises per-voyage and spot freight prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="shipping_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::maritime_incident_rate" target="us_china_tech_trade::component_avail" id="59">
        <attvalues>
