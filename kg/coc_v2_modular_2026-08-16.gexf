          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sustained higher global oil (and related hydrocarbon) prices improve Russia's fiscal position and room for maneuver, increasing its capacity and incentive to modulate or curtail deliveries as a political/economic lever, thereby increasing disruptions and variability in regional energy flows." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
