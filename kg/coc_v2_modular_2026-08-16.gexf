          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained higher compute requirements prompt cloud providers and OEMs to change sourcing and production footprints (nearshoring, dual-sourcing, contract reallocation) to secure chip and module supply, accelerating supply‑chain reconfiguration." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_economic_shift" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
