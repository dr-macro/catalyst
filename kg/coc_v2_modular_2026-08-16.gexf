          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising regional security tensions raise country and sector risk perceptions, prompting multinational firms and portfolio investors to delay or withdraw cross-border investment into exposed jurisdictions." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="shipping_chokepoints" />
          <attvalue for="28" value="0" />
