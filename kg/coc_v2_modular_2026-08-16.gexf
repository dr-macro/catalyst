          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Disruptions to regional energy exports force longer tanker routings, raise bunker fuel price volatility and insurance premiums, and thereby push up average global freight rates for affected lanes." />
