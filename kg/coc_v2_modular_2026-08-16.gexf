      <edge source="us_iran_standoff::oil_flow_through_choke" target="ai_economic_shift::infra_invest_rate" id="42">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A persistent reduction in oil flow through the choke forces longer shipping routes, raises logistics and construction input costs and causes permitting/insurance delays, which raises capex per project and slows the pace of new AI data‑center and related infrastructure builds." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="ai_economic_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::oil_flow_through_choke" target="shipping_chokepoints::global_freight_rates" id="43">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher uninterrupted oil throughput preserves tanker availability and bunker supply stability, reducing displacement of tonnage onto longer routes and lowering shipping cost pressures that push up freight rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="shipping_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::oil_flow_through_choke" target="us_china_tech_trade::private_fin_mobil" id="44">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained reduction in oil throughput raises energy price volatility and supply uncertainty for manufacturers and logistics providers, reducing projected returns and increasing perceived project risk, which causes private investors to delay or scale back mobilization for large cross‑border tech and supply‑chain investments." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
