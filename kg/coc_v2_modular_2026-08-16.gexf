          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Sustained escalation of military posture and incidents around the Black Sea and adjacent theaters directly elevates investor, insurer and policymaker assessments of cross‑border political risk, raising the collective geopolitical risk perception that shapes US–China trade and tech decisions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
