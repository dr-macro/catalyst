          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Recurrent disruptions to energy exports increase volatility and reveal supply‑security gaps, prompting private investors to commit capital into strategic energy and resilience projects (LNG, storage, domestic capacity and related industrial onshoring) that reallocate private financing relevant to US–China tech/industrial competition." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade" />
