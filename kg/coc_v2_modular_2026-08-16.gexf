          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Severe congestion delays deliveries of servers, accelerators, and rack components, forcing project pauses and pushing back data-center and on-prem AI hardware deployments, reducing the pace of infrastructure investment." />
