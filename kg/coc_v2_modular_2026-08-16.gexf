          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rise in perceived geopolitical risk from US–China tech/trade friction will prompt traders and oil market participants to tack on a risk premium and move into precautionary inventories, driving benchmark oil prices up within weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="39" value="us_iran_standoff" />
