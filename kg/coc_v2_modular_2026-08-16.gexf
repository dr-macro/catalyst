          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Increased drone and missile strikes on ships and near-port approaches force temporary port closures and route diversions, concentrating traffic through fewer passages and producing backlogs at remaining chokepoints." />
