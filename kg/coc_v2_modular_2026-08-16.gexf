          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Elevated regional security tensions increase risk premia and prompt global investors to reprice or de-risk portfolios, lowering valuation multiples for AI companies with revenue, supply-chain or infrastructure exposure to the tense region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_economic_shift" />
