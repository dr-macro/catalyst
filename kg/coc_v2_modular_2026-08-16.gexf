          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Heightened congestion at major maritime chokepoints directly delays incoming shipments of critical electronic components and intermediate goods, reducing on‑hand and pipeline availability at downstream manufacturers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="shipping_chokepoints" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
