          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="When firms assess their supply chains as more resilient (reducing vulnerability to disruptions), they postpone or cancel active restructuring of sourcing and production footprints, lowering the observable reconfiguration rate." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="shipping_chokepoints" />
          <attvalue for="39" value="us_china_tech_trade" />
