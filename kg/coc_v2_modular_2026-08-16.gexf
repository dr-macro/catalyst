          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Increased congestion at Black Sea, Bosphorus and nearby regional chokepoints forces tankers to queue, delay or detour, directly reducing the volume and reliability of energy exports and transit flows out of Ukraine/Russian-linked routes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="shipping_chokepoints" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
