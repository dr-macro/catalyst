      <edge source="ai_economic_shift::compute_demand_intensity" target="russia_ukraine_war::drone_missile_strike_rat" id="544">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising demand for compute expands access to high-performance accelerators and cloud training runs, accelerating development and deployment of autonomous guidance, target-recognition and swarm-control software that increases the tempo and effectiveness of drone and guided-missile operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_economic_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_shift::compute_demand_intensity" target="shipping_chokepoints::chokepoint_congestion" id="545">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rapid spikes in AI compute demand create concentrated, time-sensitive shipments of GPUs, racks and servers through a small set of major ports and air hubs, producing immediate backlogs and berth/airspace shortages at those chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_economic_shift" />
          <attvalue for="39" value="shipping_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_shift::compute_demand_intensity" target="shipping_chokepoints::global_freight_rates" id="546">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Elevated compute demand raises urgent cross-border movement of high-value accelerators and server equipment, expanding demand for premium container and airfreight capacity and pushing up short-term global freight price levels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_economic_shift" />
          <attvalue for="39" value="shipping_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_economic_shift::compute_demand_intensity" target="us_china_tech_trade::component_avail" id="547">
