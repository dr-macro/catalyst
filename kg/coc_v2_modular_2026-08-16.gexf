          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising demand for compute accelerates deployment of AI-powered route‑optimization, low-latency sensor fusion and anomaly detection services by commercial shipping operators, enabling tankers to better predict, reroute and mask transits around interdiction zones and thereby reduce the effectiveness of blockades." />
          <attvalue for="37" value="0-6 months" />
