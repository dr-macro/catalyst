          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Higher congestion concentrates vessel traffic and forces closer-quarter maneuvers and queuing, increasing collisions, groundings, and tense confrontations that raise the incident rate." />
