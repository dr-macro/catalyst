          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Higher compute demand drives faster development and commercial availability of autonomous maritime drones, AI targeting and ISR systems that state and proxy actors can acquire or adapt, increasing the frequency of hostile encounters, boardings and interdictions in the corridor." />
          <attvalue for="37" value="6-18 months" />
