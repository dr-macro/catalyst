          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="When supply-chain resilience falls and buying hardware becomes unreliable, firms shift workloads from planned on-prem purchases to leased cloud/colocation capacity, raising short-term demand intensity for cloud compute and accelerators." />
