      <edge source="us_iran_standoff::blockade_effectiveness" target="ai_economic_shift::capital_inflow_rate" id="72">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A more effective blockade raises regional conflict and shipping-insurance risk premiums, prompting global and regional investors to pull back or delay equity and debt financing into AI firms and projects with supply‑chain or regional exposure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="ai_economic_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::blockade_effectiveness" target="russia_ukraine_war::drone_missile_strike_rat" id="73">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A materially more effective blockade in the Gulf draws U.S./NATO naval and air assets (surveillance, escorts, strike-capable ships) into the Persian Gulf, reducing allied deterrence and ISR in the Black Sea and thereby enabling Russia to increase the tempo of drone and missile strikes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::blockade_effectiveness" target="shipping_chokepoints::chokepoint_congestion" id="74">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Greater blockade effectiveness directly reduces permitted transits and forces vessels to wait or queue at chokepoint approaches, producing immediate backlogs and flow restriction." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="shipping_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::blockade_effectiveness" target="shipping_chokepoints::supply_chain_resilience" id="75">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="More effective interdiction undermines predictability and throughput of scheduled shipments (imports/exports and input flows), eroding firms' ability to absorb disruptions and recover from shocks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="shipping_chokepoints" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::blockade_effectiveness" target="us_china_tech_trade::tariff_enforce_int" id="76">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Greater interdiction effectiveness exposes routes and firms attempting to circumvent sanctions or controls, prompting customs and trade authorities to tighten inspections and apply tariffs and border measures more rigorously to prevent embargo/Sanctions leakage." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="39" value="us_china_tech_trade" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
