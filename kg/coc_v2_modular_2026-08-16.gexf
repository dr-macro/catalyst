      <edge source="us_china_tech_trade::geo_risk_percep" target="ai_economic_shift::asset_valuations_level" id="460">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An uptick in perceived geopolitical risk raises investor risk premia for firms with cross‑border exposure (supply, markets, IP), causing multiples and market valuations for AI‑related assets to compress as buyers reprice uncertainty." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade" />
          <attvalue for="39" value="ai_economic_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
