  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="iran_gulf_escalation::geopolitical_tension" target="iran_gulf_escalation::cyber_vulnerability" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="iran_gulf_escalation::geopolitical_tension" target="ai_data_backlash::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Escalation of Iran–Gulf incidents leads states to impose tighter security reviews, export controls and vetting of cross‑border data and AI services tied to the region, directly broadening and intensifying regulatory scrutiny of AI/data activities.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">ai_data_backlash</data>
</edge>
<edge source="iran_gulf_escalation::geopolitical_tension" target="ai_data_backlash::reg_enforcement_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Heightened regional friction prompts enforcement agencies to open sanctions and compliance investigations and to execute asset freezes or penalties against firms involved in disputed transactions or dual‑use data transfers, increasing the rate of formal enforcement actions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">ai_data_backlash</data>
</edge>
<edge source="iran_gulf_escalation::geopolitical_tension" target="russia_ukraine_war::security_incident_freque" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A sustained Iran–Gulf escalation diverts NATO/US naval, air, and ISR assets and attention to the Gulf, reducing deterrence and interdiction capacity in European/Russian theaters and thereby enabling a higher rate of discrete strikes and hostile actions in the Russia–Ukraine war.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_escalation::geopolitical_tension" target="us_china_strategic_rival::investor_confidence" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Escalation of security incidents in the Iran–Gulf theatre raises near‑term risk premia, disrupts shipping/energy flows and insurance costs, and prompts rapid portfolio rebalancing away from risk assets tied to US–China trade and markets, reducing investor confidence.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
<edge source="iran_gulf_escalation::geopolitical_tension" target="us_china_strategic_rival::regional_conflict_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sustained Gulf crises can force US force posture and asset redeployments away from the Indo‑Pacific, creating perceived deterrence gaps that adversaries or proxies test, raising regional conflict levels in the US–China strategic theatre.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
<edge source="iran_gulf_escalation::geopolitical_tension" target="us_political_realign::executive_autonomy" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Acute Iran–Gulf security incidents prompt the administration to request — and Congress and agencies to grant — expedited authorities (emergency funding, limited kinetic or intelligence authorizations, classified authorities), concentrating decision-making power in the executive for near-term responses.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">us_political_realign</data>
</edge>
<edge source="iran_gulf_escalation::policy_uncertainty" target="iran_gulf_escalation::board_responsiveness" id="0">
  <data key="d28">intra_causal</data>
