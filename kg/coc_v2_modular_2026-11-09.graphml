  <data key="d29">2</data>
  <data key="d36">0.62</data>
  <data key="d37">A rise in high-profile cyberattacks and breaches attributed to actors linked to the Russia conflict causes Gulf states and Iranian authorities to escalate vetting, audits, and investigations of telecoms, cloud providers, and industrial-control vendors operating in the region.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_gulf_escalation</data>
</edge>
