<edge source="iran_gulf_escalation::policy_uncertainty" target="iran_gulf_escalation::market_volatility" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">3</data>
  <data key="d34">+</data>
</edge>
<edge source="iran_gulf_escalation::policy_uncertainty" target="iran_gulf_escalation::capital_flow_dynamics" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">-</data>
