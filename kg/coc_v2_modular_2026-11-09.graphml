<edge source="us_china_strategic_rival::tech_regulatory_scrutiny" target="iran_gulf_escalation::tech_scrutiny_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Escalating US–China tech regulatory actions (export controls, sanctions on vendors) prompt US and allied pressure on Gulf governments and firms to police Chinese equipment and data flows, directly increasing investigatory and regulatory scrutiny of regional tech projects linked to Iran or Chinese vendors.</data>
  <data key="d38">3-12 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">iran_gulf_escalation</data>
</edge>
<edge source="us_china_strategic_rival::tech_regulatory_scrutiny" target="russia_ukraine_war::supply_chain_disruption_" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Broader export controls and regulatory pressure on Chinese and intermediary tech suppliers fragment semiconductor and component sourcing, producing concrete shortages and delivery delays for drones, communications gear and other hardware used by Ukraine and its suppliers.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_strategic_rival::tech_regulatory_scrutiny" target="us_political_realign::regulatory_uncertainty" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Intensified investigations, export controls, entity listings, and enforcement actions targeting technology firms produce new compliance requirements and unpredictable enforcement risk, directly raising firms' perceived regulatory uncertainty.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">us_political_realign</data>
</edge>
