  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">An uptick in aggregate regulatory pressure (new controls, licensing, and compliance costs linked to regional security concerns) reduces investor risk appetite for AI and data firms, depressing tech‑sector sentiment.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">ai_data_backlash</data>
</edge>
<edge source="iran_gulf_escalation::regulatory_pressure" target="russia_ukraine_war::supply_chain_disruption_" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">New sanctions, shipping restrictions, insurance rules, and enforcement tied to Iran–Gulf escalation force rerouting, additional inspections, and capacity constraints that directly delay and interrupt logistical flows used to sustain Ukrainian military and civilian supply chains.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_escalation::regulatory_pressure" target="us_political_realign::crossborder_capital_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Tighter sanctions and enforcement tied to Gulf escalation (on shipping, energy firms, banks) force rapid reallocation and de-risking by international investors and correspondent banks, increasing short-term volatility in cross-border capital flows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">us_political_realign</data>
