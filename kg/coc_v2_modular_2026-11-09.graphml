<edge source="us_china_strategic_rival::investor_confidence" target="russia_ukraine_war::market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Deterioration of investor confidence from intensified US–China rivalry drives capital withdrawal from emerging‑market and commodity exposures (including Russia‑linked assets and energy markets), producing sharper price swings and higher short‑term volatility tied to the Russia–Ukraine conflict.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_strategic_rival::investor_confidence" target="us_political_realign::crossborder_capital_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A fall in investor confidence linked to US–China strategic friction drives rapid portfolio reallocation and withdrawals from cross‑border equities, bonds, and direct investment, increasing volatility and net outflows in international capital movements.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_strategic_rival</data>
  <data key="d40">us_political_realign</data>
</edge>
