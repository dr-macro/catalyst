<edge source="us_political_realign::regulatory_uncertainty" target="ai_data_backlash::reg_enforcement_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.72</data>
  <data key="d37">Rising regulatory uncertainty induces agencies to open more enforcement actions and issue compliance interventions to define boundaries and deter breaches, raising the enforcement tempo independently of broader scrutiny debates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_political_realign</data>
  <data key="d40">ai_data_backlash</data>
</edge>
<edge source="us_political_realign::regulatory_uncertainty" target="iran_gulf_escalation::tech_scrutiny_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising US regulatory uncertainty around export controls/sanctions prompts Gulf regulators and firms to increase compliance checks, inspections, and restrictions on technology transfers and vendor relationships to avoid secondary sanctions and reputational exposure.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_political_realign</data>
  <data key="d40">iran_gulf_escalation</data>
</edge>
<edge source="us_political_realign::regulatory_uncertainty" target="russia_ukraine_war::tech_security_breach_rat" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sustained uncertainty about regulatory requirements and enforcement timing leads firms to defer compliance and security investments and disrupt vendor contracting, directly increasing the incidence of cybersecurity misconfigurations, unpatched systems, and breaches affecting actors in the Russia–Ukraine context.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_political_realign</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_political_realign::regulatory_uncertainty" target="us_china_strategic_rival::tech_regulatory_scrutiny" id="0">
