<edge source="iran_gulf_escalation::oversight_intensity" target="ai_data_backlash::media_scandal_coverage" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Intensified legislative oversight produces hearings, subpoenas and released documents about government and corporate data practices related to the region, generating higher‑profile media scandal coverage of AI/data actors.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">ai_data_backlash</data>
</edge>
<edge source="iran_gulf_escalation::oversight_intensity" target="us_china_strategic_rival::partisan_polarization" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Intense congressional oversight and hearings about Gulf incidents generate high‑visibility partisan messaging that ties executive decisions to China policy, hardening opposing narratives and increasing partisan polarization around US–China strategy.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
