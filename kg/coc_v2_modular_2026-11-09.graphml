  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">An uptick in cyberattacks and high‑profile breaches tied to the conflict prompts data‑protection and national‑security agencies to open probes and mandate stricter security controls and reporting from AI and cloud providers, increasing regulatory oversight.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">ai_data_backlash</data>
</edge>
<edge source="russia_ukraine_war::tech_security_breach_rat" target="iran_gulf_escalation::tech_scrutiny_pressure" id="0">
  <data key="d28">cross_causal</data>
