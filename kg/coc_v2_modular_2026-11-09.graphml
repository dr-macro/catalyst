<edge source="iran_gulf_escalation::policy_uncertainty" target="russia_ukraine_war::market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.8</data>
  <data key="d37">Escalation-driven ambiguity about future sanctions, energy export availability, and trade rules raises investor uncertainty about Russian and European exposures, producing larger and more frequent swings in commodity and equity prices linked to the Russia–Ukraine conflict.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_escalation::policy_uncertainty" target="us_political_realign::regulatory_uncertainty" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Ambiguity about the U.S. sanctions posture and enforcement priorities in response to Gulf incidents causes firms and markets to expect abrupt regulatory changes, directly raising perceived regulatory unpredictability.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">us_political_realign</data>
</edge>
