  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Demonstrable improvements in air/missile defenses reduce political incentives to block or tightly regulate foreign suppliers of critical components, lowering the intensity of regulatory investigations and restrictions on technology links.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_energy_chokepoint</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="global_energy_chokepoint::defense_effectiveness" target="us_iran_regional_war::escalation_risk" id="0">
