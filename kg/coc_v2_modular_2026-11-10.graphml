  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">An uptick in coordinated hybrid attacks (physical sabotage, cyber intrusions, and coercive information campaigns) targets ports, terminals and logistics hubs, producing concrete interruptions and delays in European supply chains.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">europe_hybrid_threats</data>
</edge>
<edge source="russia_ukraine_war::hybrid_attack_intensity" target="global_energy_chokepoint::attack_frequency" id="0">
