<edge source="europe_hybrid_threats::supply_chain_disruption" target="global_energy_chokepoint::energy_supply_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Physical interruptions at ports, terminals and transport routes delay or block fuel and component deliveries to choke-point facilities, directly increasing the likelihood and magnitude of energy supply interruptions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">global_energy_chokepoint</data>
</edge>
<edge source="europe_hybrid_threats::supply_chain_disruption" target="russia_ukraine_war::energy_supply_stability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Persistent disruptions to transport, ports and logistics routes reduce deliveries of fuel, spare parts and maintenance supplies to Ukraine and neighboring markets, directly degrading continuity and reliability of energy availability in the conflict theater.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="europe_hybrid_threats::supply_chain_disruption" target="us_china_tech_rivalry::investor_sentiment_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Persistent disruptions to European ports, transport and component flows raise near‑term operational and earnings risk for firms dependent on US–China tech supply links, directly depressing investor sentiment for companies and sectors at the center of the tech rivalry.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="europe_hybrid_threats::supply_chain_disruption" target="us_iran_regional_war::shipping_disruption" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sustained disruptions at European ports and logistics nodes force rerouting and schedule compression that increase transits through Middle Eastern chokepoints, raising the degree of shipping route disruptions in the US–Iran theatre.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">us_iran_regional_war</data>
</edge>
