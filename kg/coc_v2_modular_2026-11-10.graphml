<edge source="europe_hybrid_threats::alliance_cohesion" target="global_energy_chokepoint::defense_effectiveness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Improved policy alignment and coordinated decision-making enable faster joint deployments, shared rules of engagement and pooled sensor-fire capabilities that raise operational defense performance at energy chokepoints.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">global_energy_chokepoint</data>
</edge>
<edge source="europe_hybrid_threats::alliance_cohesion" target="russia_ukraine_war::political_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Greater cohesion among European allies produces more aligned policies, synchronized support packages and unified messaging that directly raise consensus and coordinated political action among the states supporting Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="europe_hybrid_threats::alliance_cohesion" target="us_china_tech_rivalry::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Stronger policy alignment and collective decision‑making among European allies leads to coordinated adoption of export controls, investment screening and sanctions aligned with US policy, directly increasing regulatory scrutiny applied to Chinese and cross‑border tech actors in the US–China rivalry.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="europe_hybrid_threats::alliance_cohesion" target="us_iran_regional_war::public_restraint" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Stronger cohesion among European and transatlantic allies enables coordinated diplomatic messaging and multilateral de‑escalation initiatives that increase public signals of restraint from U.S. leadership.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">us_iran_regional_war</data>
</edge>
