<edge source="russia_ukraine_war::cyber_intrusion_rate" target="europe_hybrid_threats::cyber_intrusion_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Escalation of cyber operations tied to the Russia–Ukraine conflict expands targeting and operational tempo against European networks (spillover, campaign expansion, reused tooling), directly increasing intrusion frequency and severity in Europe.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">europe_hybrid_threats</data>
</edge>
<edge source="russia_ukraine_war::cyber_intrusion_rate" target="global_energy_chokepoint::defense_effectiveness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Higher frequency of cyber intrusions compromises sensors, communications and fire-control systems of air/missile defenses (or forces temporary stand-downs), reducing detection-to-intercept success rates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_chokepoint</data>
</edge>
<edge source="russia_ukraine_war::cyber_intrusion_rate" target="us_china_tech_rivalry::info_security_vuln" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Increases in Russian-linked cyber intrusions targeting global supply chains and cloud providers produce more exploited zero-days and credential compromises that raise measurable information-security vulnerabilities across systems used by U.S. and Chinese tech firms.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::cyber_intrusion_rate" target="us_iran_regional_war::information_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Higher rates of cyber intrusion tied to the Russia–Ukraine conflict generate more stolen documents, falsified leaks and manipulative disclosures that accelerate and amplify public information, rumors and media reporting about the US–Iran confrontation.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_iran_regional_war</data>
</edge>
