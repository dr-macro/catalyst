  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Large-scale, visible damage to energy and urban assets creates pressure for rapid attribution and response, prompting states to increase timeliness and depth of intelligence exchange to coordinate defensive and diplomatic actions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_chokepoint</data>
  <data key="d40">europe_hybrid_threats</data>
</edge>
<edge source="global_energy_chokepoint::damage_extent" target="russia_ukraine_war::political_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Large-scale, visible damage to chokepoint infrastructure generates acute domestic economic and security pressures that produce divergent national responses (calls for restraint, emergency aid, or retaliation), thereby eroding allied consensus on strategy and resource-sharing.</data>
  <data key="d38">0-12 months</data>
  <data key="d39">global_energy_chokepoint</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
