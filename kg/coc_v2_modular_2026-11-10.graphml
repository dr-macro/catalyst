<edge source="russia_ukraine_war::intelligence_sharing" target="global_energy_chokepoint::defense_effectiveness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Improved timeliness and quality of shared intelligence enables earlier warning, better threat cueing and coordinated engagement, increasing the operational interception and mitigation performance of air/missile defenses protecting chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_chokepoint</data>
</edge>
<edge source="russia_ukraine_war::intelligence_sharing" target="us_china_tech_rivalry::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Improved intelligence-sharing about malicious activity and supply-chain risks stemming from the war supplies regulators with concrete evidence that prompts expanded investigations, audits, and restrictions on foreign technology vendors.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::intelligence_sharing" target="us_iran_regional_war::escalation_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Improvements in intelligence sharing driven by coalition practices formed during the Russia–Ukraine war reduce uncertainty and misperception among US and partner actors, lowering the assessed near‑term risk of inadvertent escalation in the US–Iran regional conflict.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_iran_regional_war</data>
</edge>
