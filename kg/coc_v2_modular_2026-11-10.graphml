  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Surges in public and media coverage tying Chinese tech actors to Moscow generate domestic political pressure that pushes allied governments toward more coordinated sanctions and policy alignment on the Russia–Ukraine war, increasing political cohesion among partners.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_rivalry::media_attention" target="us_iran_regional_war::information_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A surge in global media and social‑media coverage of the US–China tech rivalry reallocates newsroom attention and public bandwidth away from the US–Iran confrontation, reducing the volume and velocity of reporting and public information about the regional conflict.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">us_iran_regional_war</data>
</edge>
