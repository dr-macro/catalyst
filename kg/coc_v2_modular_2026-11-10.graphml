<edge source="europe_hybrid_threats::intel_sharing_eff" target="global_energy_chokepoint::attack_frequency" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">More timely and actionable intelligence exchange allows detection and disruption of attack planning and weapons transfers, reducing the rate of successful offensive strikes against energy infrastructure.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">global_energy_chokepoint</data>
</edge>
<edge source="europe_hybrid_threats::intel_sharing_eff" target="russia_ukraine_war::hybrid_attack_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Improved, timely intelligence exchange in the European space enables early detection, interdiction and attribution of planned hybrid operations, reducing the rate and scale of successful coordinated physical, cyber and informational attacks against Ukraine and its partners.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="europe_hybrid_threats::intel_sharing_eff" target="us_china_tech_rivalry::info_security_vuln" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Improved, timely intelligence sharing between European and Western partners provides actionable threat indicators and coordinated mitigation guidance to firms engaged in the US–China tech contest, directly reducing their exposure and measurable information‑security vulnerabilities.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
