</edge>
<edge source="us_china_tech_rivalry::info_security_vuln" target="europe_hybrid_threats::cyber_intrusion_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Emergence or disclosure of exploitable vulnerabilities in widely deployed vendor hardware or software used in Europe directly leads to an increase in successful unauthorized penetrations as attackers scan for and exploit those weaknesses.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">europe_hybrid_threats</data>
</edge>
<edge source="us_china_tech_rivalry::info_security_vuln" target="global_energy_chokepoint::damage_extent" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Increased information-security vulnerabilities in critical energy-control systems allow adversarial cyber intrusions (ICS/SCADA/backdoors) that directly cause outages and physical damage to power and pipeline infrastructure.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_energy_chokepoint</data>
</edge>
<edge source="us_china_tech_rivalry::info_security_vuln" target="russia_ukraine_war::cyber_intrusion_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Increased information-security vulnerabilities in tech supply chains and widely used platforms create exploitable footholds that Russian cyber actors and affiliated groups can use to increase the frequency and severity of intrusions against Ukrainian networks and Western systems supporting Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_rivalry::disclosure_transparency" target="us_china_tech_rivalry::information_flow_rate" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
