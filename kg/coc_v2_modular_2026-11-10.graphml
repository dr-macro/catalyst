<edge source="us_china_tech_rivalry::regulatory_scrutiny" target="global_energy_chokepoint::defense_effectiveness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Tighter export controls and licensing driven by regulatory scrutiny restrict access to advanced semiconductors, sensors, and maintenance support for allied air/missile defense systems, degrading detection and interception performance during upgrades and sustainment cycles.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_energy_chokepoint</data>
</edge>
