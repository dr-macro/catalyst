<edge source="us_china_tech_rivalry::geopolitical_tension" target="us_china_tech_rivalry::info_security_vuln" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="us_china_tech_rivalry::geopolitical_tension" target="europe_hybrid_threats::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A spike in US–China tech rivalry creates immediate political pressure on European capitals to harmonize export controls, standards and security postures with like-minded partners, producing tighter coordinated policy and decision-making among allies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">europe_hybrid_threats</data>
</edge>
<edge source="us_china_tech_rivalry::geopolitical_tension" target="europe_hybrid_threats::cyber_intrusion_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Rising interstate tech rivalry increases incentives for state-linked actors to conduct offensive cyber operations in European networks to collect intelligence, test defences, or signal resolve, thereby raising the tempo of intrusions against targets in Europe.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">europe_hybrid_threats</data>
</edge>
<edge source="us_china_tech_rivalry::geopolitical_tension" target="global_energy_chokepoint::attack_frequency" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising US–China strategic friction increases proxy competition, permissive rules of engagement, and arms/tech flows to regional actors, which raises the incidence of offensive strikes (missile, drone) against energy and urban infrastructure in contested theaters.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_energy_chokepoint</data>
</edge>
<edge source="us_china_tech_rivalry::geopolitical_tension" target="russia_ukraine_war::hybrid_attack_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.6</data>
  <data key="d37">Escalation in US–China strategic and technological rivalry raises incentives for state and proxy actors to undertake more aggressive combined cyber, information and kinetic actions in and around Ukraine—both to exploit perceived great‑power distraction and to send strategic signals—raising hybrid-attack tempo.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_rivalry::geopolitical_tension" target="us_iran_regional_war::public_restraint" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Rising strategic friction between the US and China hardens domestic and allied policymaker postures and diminishes political incentives to publicly signal de‑escalation with Iran, lowering the prevalence and strength of restraint messaging.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">us_iran_regional_war</data>
</edge>
