  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Reductions in crude export throughput or transit capacity reduce available fuel inventories and refineable feedstock for European markets, producing immediate instability and price volatility in energy supplies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_regional_war</data>
  <data key="d40">europe_hybrid_threats</data>
