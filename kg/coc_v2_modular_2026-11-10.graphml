<edge source="europe_hybrid_threats::energy_supply_stability" target="us_iran_regional_war::oil_supply_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Improved energy supply stability in Europe reduces near‑term European demand for additional Gulf crude and product imports, lowering incremental oil export flows from the region to global markets (and conversely, declines in stability increase Gulf flows).</data>
  <data key="d38">6-18 months</data>
  <data key="d39">europe_hybrid_threats</data>
  <data key="d40">us_iran_regional_war</data>
</edge>
