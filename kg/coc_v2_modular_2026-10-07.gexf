          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Spikes in kinetic strike intensity create urgent battlefield needs that push militaries and contractors to hastily deploy experimental AI-enabled targeting, autonomy and logistics systems with limited testing, increasing the frequency and severity of AI-related safety and operational incidents (including spillovers to civilian-adjacent systems)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_power_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
