          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute energy supply disruptions and price spikes force cloud and datacenter operators to ration capacity or postpone large-model rollouts to reduce load and costs, lowering the short-term rate at which new models are deployed into production." />
          <attvalue for="37" value="0-6 months" />
