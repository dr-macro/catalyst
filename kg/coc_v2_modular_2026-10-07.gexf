          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Additional munitions and strike-capable systems supplied from North Korean sources augment Russian stocks and enable a higher tempo and scale of missile, artillery and UAV strikes in the theatre." />
