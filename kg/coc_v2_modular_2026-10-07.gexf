          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Loss or curtailment of Russian pipeline and seaborne supplies forces buyers (especially in Europe and Asia) to increase seaborne purchases from Middle Eastern producers, raising tanker transits through regional chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_maritime" />
          <attvalue for="28" value="0" />
        </attvalues>
