      <edge source="russia_ukraine_war::allied_military_aid_flow" target="ai_power_shift::model_capability_growth" id="56">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large-scale allied military aid packages include procurement, co-funded R&amp;D, datasets and fielding contracts for autonomous ISR, perception and decision-support systems that accelerate private-sector investment and transfer of advanced models and architectures into faster-capability development cycles." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_power_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_military_aid_flow" target="middle_east_maritime::insurance_premium_level" id="57">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Surges in allied military aid to Eastern Europe prompt redeployment of Western naval and security assets away from the Middle East, reducing on-station deterrence and causing insurers to raise war-risk and hull premiums for regional transits." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_maritime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_military_aid_flow" target="us_china_competition::geopolitical_tension" id="58">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained increases in US and allied military aid to Ukraine signal more assertive alliance behavior and operational integration, which China interprets as a demonstration of US global power projection and prompts Beijing to accelerate countermeasures, raising US–China strategic tension." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
