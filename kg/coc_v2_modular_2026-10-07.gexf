      <edge source="us_china_competition::geopolitical_tension" target="ai_power_shift::model_capability_growth" id="384">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Heightened strategic rivalry and export controls induce governments and firms to divert funds and prioritize domestic AI R&amp;D and substitute technologies, accelerating capability development to regain autonomy and counter dependencies." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="ai_power_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="middle_east_maritime::maritime_attack_rate" id="385">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Spikes in US–China strategic tension prompt greater naval deployments and incentivize regional proxies and state-aligned militias to conduct harassment, seizure attempts, and attacks on commercial shipping to signal alignment or retaliate, raising maritime attack incidence." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="middle_east_maritime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="middle_east_maritime::insurance_premium_level" id="386">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher US–China rivalry raises the perceived geopolitical and wartime risk for vessels transiting Middle East waterways, causing insurers to widen war‑risk and related premiums for ships and cargoes operating in the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="middle_east_maritime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="north_korea_escalation::alliance_cohesion" id="387">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising US–China strategic tension prompts Washington to intensify diplomatic outreach, combined exercises and intelligence‑sharing with South Korea and Japan, directly increasing policy coordination and synchronized action among allies." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="north_korea_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="north_korea_escalation::arms_tech_proliferation" id="388">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="As US–China competition hardens, Chinese and Russian actors seeking leverage or deniability loosen enforcement and employ covert commercial channels to transfer dual‑use components and technical know‑how to North Korean procurement networks, increasing arms and technology flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="north_korea_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="russia_ukraine_war::allied_military_aid_flow" id="389">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained rise in US–China strategic tension leads the US and some European governments to reallocate scarce munitions budgets, industrial capacity and political attention toward Indo‑Pacific deterrence, slowing, reducing or delaying shipments and new aid packages to Ukraine." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="russia_ukraine_war::strike_intensity" id="390">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Moscow exploits periods when US and EU attention and operational support are distracted or stretched by intensified US–China rivalry to increase tempo of kinetic operations, believing Western replenishment and political will to respond will be weaker or slower." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
