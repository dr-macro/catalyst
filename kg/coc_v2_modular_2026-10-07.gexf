      <edge source="us_china_competition::regulatory_intervention" target="ai_power_shift::model_deployment_rate" id="321">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A spike in regulatory actions (audits, forced rollbacks, stop-orders, heavy compliance requirements) causes firms to pause or slow rollouts while they redesign systems, obtain approvals, or incur compliance costs, directly reducing the rate of new model deployments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="ai_power_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::regulatory_intervention" target="middle_east_maritime::tanker_transit_rate" id="322">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Intensified export controls, sanctions, or tighter port compliance measures tied to US–China competition increase legal and operational risks for shipowners and ports, prompting voyage cancellations and rerouting that reduce formal tanker transits through regional chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="middle_east_maritime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::regulatory_intervention" target="north_korea_escalation::sanctions_pressure_level" id="323">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating export controls and secondary‑sanctions measures tied to US–China competition expand the scope and targeting of listings and prohibitions on firms and intermediaries, thereby raising cumulative sanctions pressure on networks connected to North Korea." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="north_korea_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::regulatory_intervention" target="russia_ukraine_war::sanctions_pressure" id="324">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="As competition drives tougher export controls, investment screening and administrative trade measures targeting China, governments institutionalize broader controls and secondary‑sanctions tools that are readily applied or adapted to restrict Russian trade and finance, raising effective sanctions pressure on Russia." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
