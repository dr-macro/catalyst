          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter policy coordination among allied states in response to escalation increases cross-border security vetting, export screening and joint certification requirements for AI systems, slowing international deployments by firms operating across those jurisdictions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="north_korea_escalation" />
