      <edge source="russia_ukraine_war::sanctions_pressure" target="middle_east_maritime::tanker_transit_rate" id="66">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Tightened sanctions on Russian oil push buying demand toward Middle Eastern suppliers and increase spot cargo purchases and re-exports, elevating tanker traffic through key regional waterways." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_maritime" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="north_korea_escalation::arms_tech_proliferation" id="67">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Intensified sanctions on Russia drive Moscow to seek off‑market suppliers and barter partners (including North Korea), producing direct transfers and technical exchanges that increase the flow of arms and dual‑use know‑how to/from DPRK." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="north_korea_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="north_korea_escalation::logistics_capacity" id="68">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="As sanctions constrict conventional trade routes, Russian actors expand clandestine maritime and overland procurement networks with North Korean intermediaries, which builds DPRK's smuggling, transshipment and sustainment capabilities." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="north_korea_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="us_china_competition::regulatory_intervention" id="69">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Policymakers’ expanded use of sectoral and secondary sanctions against Russia creates institutional precedent and technical frameworks (e.g., export controls, finance screening) that are then adapted and applied to China-related trade and investment, increasing the frequency and severity of regulatory interventions." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="us_china_competition::foreign_investor_sent" id="70">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="The proliferation of sanctions and the risk of secondary penalties increase political and legal risk perceptions among global investors, reducing appetite for capital allocation to large geopolitical targets (including China) and lowering overall investor sentiment." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
