          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Disruptions to Russian energy exports and pipeline flows push importers to seek alternative fuels and increase short-term demand for seaborne crude and LNG, tightening markets and raising global oil price benchmarks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_maritime" />
