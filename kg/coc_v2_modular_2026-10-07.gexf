          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A sharp increase in Russian strike intensity compels the US and NATO to prioritize forces and political attention toward Europe, producing short‑term resource and presence gaps that strain coordination and perceived reassurance among US allies in Northeast Asia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="north_korea_escalation" />
