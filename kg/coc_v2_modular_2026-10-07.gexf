      <edge source="russia_ukraine_war::sanctions_pressure" target="ai_power_shift::model_capability_growth" id="65">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sanctions and attendant export controls on advanced semiconductors, cloud services and tooling increase hardware scarcity and compliance costs for liable suppliers, directly slowing the ability of teams (including global commercial labs) to train and iterate very large models." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_power_shift" />
