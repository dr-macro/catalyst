          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An escalation in North Korea drives an uptick in outbound transfers of anti-ship missiles, cruise missile kits and guidance components to regional proxies and clients, materially raising those actors' capability and willingness to conduct attacks on ships and offshore infrastructure." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="north_korea_escalation" />
          <attvalue for="39" value="middle_east_maritime" />
