          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="North Korean escalation increases flows of missiles, rockets, artillery rounds and drones from DPRK-linked suppliers to Russia, directly raising the volume of external military materiel available to Russian forces." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="north_korea_escalation" />
          <attvalue for="39" value="russia_ukraine_war" />
