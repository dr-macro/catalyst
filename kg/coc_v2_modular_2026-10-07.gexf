          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Fractures or diversion of allied coordination over a Korea crisis prompt faster redeployment of U.S. and allied naval assets to East Asia and reduce routine presence/deterrence in the Middle East, creating windows in which maritime attackers increase operations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="north_korea_escalation" />
          <attvalue for="39" value="middle_east_maritime" />
          <attvalue for="28" value="0" />
