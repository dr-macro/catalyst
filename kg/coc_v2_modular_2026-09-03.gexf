      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="global_bond_repricing::market_liquidity" id="206">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp increases in cross-border kinetic strikes trigger risk-off episodes that force primary dealers to pull back inventories and widen bid-ask spreads, degrading liquidity in regional and related global bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_repricing" />
