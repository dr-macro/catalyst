      <edge source="russia_ukraine_war::coordination_info_sharin" target="us_china_strategic_rival::geo_tech_tension" id="298">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Increased intelligence and procurement‑monitoring cooperation among the US, EU and partners (spurred by the war) enables coordinated identification of dual‑use tech flows and rapid harmonization of restrictive policies, raising bilateral techno‑nationalist frictions with China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
