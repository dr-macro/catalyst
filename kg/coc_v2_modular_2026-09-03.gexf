          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sharp reductions in cross-border capital and correspondent banking flows impede payments to foreign suppliers and intermediaries and constrain FX liquidity, causing cancellations/delays in arms contracts and lower procurement rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="39" value="russia_ukraine_war" />
