      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="global_oil_reordering::oil_export_flow" id="207">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Increased artillery, missile and air strikes against port terminals, storage and pipeline nodes in the Black Sea region and Ukraine physically damage export infrastructure and force port closures, lowering outbound oil and refined product volumes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_oil_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="us_china_strategic_rival::geo_tech_tension" id="208">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Noticeable escalations in battlefield kinetic activity tied to use of foreign components or weapons (or to civilian infrastructure strikes) increase political pressure in the US to treat adversary supply chains as security risks, prompting more unilateral and multilateral tech restrictions that heighten US‑China tech tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_strategic_rival" />
