      <edge source="russia_ukraine_war::sanctions_financial" target="global_bond_repricing::cross_border_flows" id="244">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Tighter financial sanctions restrict correspondent banking and payment rails and raise compliance costs, prompting non-resident investors and funds to repatriate or avoid exposures in affected bond markets and reducing net cross-border fixed-income flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_repricing" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_financial" target="global_oil_reordering::oil_export_flow" id="245">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Tighter financial sanctions on Russian energy firms and banks restrict payments, insurance and shipping services, causing immediate disruptions and reductions in crude and product shipments from sanctioned exporters." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_oil_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_financial" target="us_china_strategic_rival::compute_capacity" id="246">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Escalating financial and export sanctions tied to the war prompt allied export-control packages that restrict sales of advanced GPUs, HPC systems and semiconductor tools to Chinese firms, directly reducing the rate at which China can install new high‑performance compute capacity." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_financial" target="us_china_strategic_rival::ai_infra_concentration" id="247">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sanctions and related export controls narrow the set of suppliers trusted or permitted to sell advanced AI infrastructure, shifting demand toward a smaller group of sanctioned‑free cloud and hardware vendors and thereby increasing market concentration." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_financial" target="us_iran_gulf_escalation::crude_throughput_rate" id="248">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened Western financial and trade sanctions on Russian oil reduce seaborne Russian exports to Europe, shifting global crude flows onto remaining suppliers and increasing volumes routed through the Gulf chokepoint to meet short-term demand." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
