      <edge source="russia_ukraine_war::military_procurement_rat" target="global_bond_repricing::long_term_yield_level" id="281">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained acceleration in defence procurement by governments and allied purchasers increases sovereign and government-guaranteed bond issuance to finance spending, adding supply and upward pressure on long-term government yields." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_repricing" />
