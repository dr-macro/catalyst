          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained drop in oil export volumes and the resulting energy/market volatility incentivizes firms to centralize workloads with large, energy‑secure cloud providers that can guarantee power and resilience, increasing market concentration of AI infrastructure." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_oil_reordering" />
          <attvalue for="39" value="us_china_strategic_rival" />
