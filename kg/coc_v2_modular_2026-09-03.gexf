          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Improved institutionalized coordination, intelligence-sharing and tactics developed among NATO and partners in the Russia–Ukraine theatre are transferred to US and Gulf security partners, improving maritime domain awareness and convoy/escort procedures and thus raising commercial shipping confidence and transit volumes through the chokepoint." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_iran_gulf_escalation" />
          <attvalue for="28" value="0" />
