          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained high drone operational tempo in Ukraine accelerates production, proliferation and operational learning around long-range unmanned systems and maritime-delivery techniques that are exported or copied by regional actors (notably Iran and proxies), enabling more remote mine-laying and mine-delivery incidents in the Gulf corridor." />
