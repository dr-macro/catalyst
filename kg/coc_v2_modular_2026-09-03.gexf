          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising US–China tech tensions prompt rapid adoption and tightening of export controls and targeted sanction statutes to block cross‑border transfers of AI hardware, software and services, expanding the scope and enforceability of legal sanctions frameworks." />
