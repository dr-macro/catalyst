          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rises in US–China tech friction prompt U.S. and allied policymakers to expand export controls and secondary financial sanctions targeting intermediaries and firms that enable Sino-Russian technology transfers, raising aggregate sanctions pressure related to the war." />
