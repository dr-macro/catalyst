          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained or higher oil export volumes that preserve or increase export revenue provide the Russian state with fiscal resources that are then available to accelerate arms purchases and domestic procurement cycles." />
