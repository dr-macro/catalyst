      <edge source="us_iran_gulf_escalation::kinetic_engagement" target="global_bond_repricing::long_term_yield_level" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A spike in direct kinetic exchanges raises geopolitical risk and drives a near-term flight-to-safety into long-dated sovereign bonds, pushing their yields down as prices rise." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_escalation" />
          <attvalue for="39" value="global_bond_repricing" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_escalation::kinetic_engagement" target="global_oil_reordering::oil_export_flow" id="35">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Direct strikes on tankers, terminals and related marine infrastructure destroy export capacity and force port/terminal closures and cargo diversions, immediately reducing volumetric exports." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_escalation" />
          <attvalue for="39" value="global_oil_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_escalation::kinetic_engagement" target="global_oil_reordering::geopolitical_conflict_in" id="36">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Increased armed exchanges escalate threat perceptions among regional and external powers, triggering diplomatic confrontations, military posturing and allied responses that raise overall geopolitical conflict intensity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_escalation" />
          <attvalue for="39" value="global_oil_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_escalation::kinetic_engagement" target="russia_ukraine_war::coordination_info_sharin" id="37">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained increases in US/Iran kinetic exchanges prompt Washington and NATO to reassign ISR platforms, intel-liaison officers and analytic capacity to the Gulf, directly reducing the tempo and volume of institutionalized intelligence exchanges and joint planning support available to Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_escalation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_escalation::kinetic_engagement" target="russia_ukraine_war::military_procurement_rat" id="38">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in kinetic activity in the Gulf creates urgent demand for Western munitions, air-defence and naval stores that leads governments and producers to reallocate existing stocks and near-term production runs toward Middle East partners, delaying acquisition deliveries and new contracts destined for Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_escalation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_escalation::kinetic_engagement" target="us_china_strategic_rival::geo_tech_tension" id="39">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained increases in kinetic engagements in the Gulf prompt immediate US-led policy responses (expanded sanctions, tightened export controls and stricter vetting of dual‑use suppliers) that are explicitly applied to cross-border technology flows and third‑party vendors, producing a measurable rise in techno‑nationalist frictions with China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_escalation" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
