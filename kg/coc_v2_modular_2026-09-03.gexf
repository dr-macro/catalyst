        </attvalues>
      </edge>
      <edge source="global_oil_reordering::legal_sanctions_regime_s" target="global_bond_repricing::market_liquidity" id="632">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Strengthening and broadening of legal/sanctions frameworks raises compliance costs and counterparty risk, causing dealers and international participants to withdraw or limit trading in affected bond markets and thereby reducing market depth and liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
          <attvalue for="39" value="global_bond_repricing" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_reordering::legal_sanctions_regime_s" target="russia_ukraine_war::sanctions_financial" id="633">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A stronger, more coherent legal and enforcement framework (export controls, shipping rules, secondary sanctions) directly enables states and banks to impose and operationalize tougher financial restrictions on Russia's energy sector, raising aggregate financial pressure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_reordering::legal_sanctions_regime_s" target="us_china_strategic_rival::geo_tech_tension" id="634">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Tightening or expansion of export controls and secondary-sanctions frameworks directly raises cross-border restrictions on AI-related goods and services, prompting reciprocal measures and elevating techno‑nationalist friction." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_reordering::legal_sanctions_regime_s" target="us_iran_gulf_escalation::kinetic_engagement" id="635">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Tightening sanctions that choke off oil revenue and insurance/access incentivizes targeted kinetic harassment and attacks by sanctioned actors seeking to raise the political and economic costs of shipping through the route." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
          <attvalue for="39" value="us_iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
