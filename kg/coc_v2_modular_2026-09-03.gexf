          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A higher prevailing policy short-term rate raises borrowing and debt-servicing costs for regional partners and tightens allied budgetary space, producing shorter-term cuts or slower rotation of naval/patrol deployments that weaken effective maritime control versus Iranian/coercive actors." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="39" value="us_iran_gulf_escalation" />
