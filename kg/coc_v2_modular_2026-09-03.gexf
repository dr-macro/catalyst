          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A measurable increase in political authority in major energy producers lowers the perceived probability of disruptive policy or supply shocks (and associated upside inflation risk), leading markets to scale back expectations of imminent central‑bank tightening." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
          <attvalue for="39" value="global_bond_repricing" />
          <attvalue for="28" value="0" />
        </attvalues>
