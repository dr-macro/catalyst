          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A surge in cross-border capital flows into opaque jurisdictions and intermediaries expands channels for sanctioned actors to receive payments and financing, degrading the coherence and enforceability of legal sanctions frameworks and undermining sanctions effectiveness." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="39" value="global_oil_reordering" />
          <attvalue for="28" value="0" />
