      <edge source="russia_ukraine_war::coordination_info_sharin" target="global_oil_reordering::legal_sanctions_regime_s" id="297">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher institutionalized intelligence and policy coordination among Western allies enables harmonized designation lists, shared enforcement tools and coordinated legal instruments, strengthening the reach and coherence of sanctions regimes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_oil_reordering" />
          <attvalue for="28" value="0" />
