          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A rise in geopolitical conflict in key energy or trade lanes drives a near-term flight-to-quality into core sovereign debt (e.g., US, Germany), pushing prices up and long-term yields down as investors reallocate away from risk assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
          <attvalue for="39" value="global_bond_repricing" />
          <attvalue for="28" value="0" />
