          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Escalating trade controls, export restrictions and sanctions elevate compliance and political risk, prompting portfolio managers and allocators to withdraw capital from affected jurisdictions' fixed-income markets and reallocate into safer or friendlier markets, reducing net cross-border bond flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="global_bond_repricing" />
