      <edge source="global_oil_reordering::political_authority_stre" target="russia_ukraine_war::coordination_info_sharin" id="601">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger centralized political control in major oil producers enables unilateral sale and diplomatic choices (bilateral deals, non-cooperation on enforcement) that reduce the willingness of those states to participate in allied intelligence-sharing and joint enforcement efforts." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
