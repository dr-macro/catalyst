          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Elevated armed or diplomatic conflict in key production or transit regions physically disrupts chip fabs, freight corridors and power delivery to data centers, directly reducing available high‑performance compute and delaying deployments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
          <attvalue for="39" value="us_china_strategic_rival" />
