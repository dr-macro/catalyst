          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large outflows and market repricing prompt private banks and intermediaries to de-risk and cut correspondent lines, effectively intensifying financial restrictions on Russian actors beyond formal measures and raising aggregate financial pressure." />
