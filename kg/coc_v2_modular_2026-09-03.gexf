          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An increase in oil export flows raises exporters' foreign-currency receipts and associated outward capital recycling (sovereign wealth fund allocations, bank/intermediary investments), mechanically increasing net cross-border fixed‑income and related flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_oil_reordering" />
