      <edge source="russia_ukraine_war::military_procurement_rat" target="global_oil_reordering::geopolitical_conflict_in" id="282">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained increases in arms deliveries and munitions raise battlefield capabilities on one or both sides, prolonging operations and producing higher regional tension and confrontation levels that elevate geopolitical conflict intensity." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_oil_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
