      <edge source="russia_ukraine_war::drone_attack_frequency" target="global_bond_repricing::policy_rate_expectations" id="221">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising drone strikes against energy and logistics infrastructure create near-term supply disruptions and higher inflation readings, leading markets to price a higher and earlier central-bank policy rate path." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_repricing" />
