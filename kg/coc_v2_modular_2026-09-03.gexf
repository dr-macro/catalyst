          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalation in US–China strategic rivalry leads state buyers and national oil companies to reallocate purchasing away from suppliers aligned with the other side (via informal boycotts, preferred‑supplier contracts or credit restrictions), reducing export volumes from those targeted producers and rerouting flows to politically allied exporters." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="global_oil_reordering" />
