        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Acute US–China tech friction drives a flight-to-quality into developed-market sovereigns (notably US Treasuries), boosting demand for long-duration safe assets and putting downward pressure on long-term yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="39" value="global_bond_repricing" />
