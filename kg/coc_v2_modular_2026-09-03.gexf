      <edge source="us_iran_gulf_escalation::vessel_transit_rate" target="russia_ukraine_war::kinetic_attack_intensity" id="47">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained fall in commercial transit through the chokepoint reduces the political and operational rationale for allied forward naval and air patrols, lowering visible deterrence and creating conditions in which Russian forces judge they can increase the tempo and severity of kinetic strikes in and around Ukraine." />
