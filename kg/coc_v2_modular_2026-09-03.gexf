      <edge source="global_bond_repricing::policy_rate_level" target="global_oil_reordering::oil_export_flow" id="805">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An increase in policy short-term rates in major consuming economies raises borrowing costs and slows economic activity, reducing fuel demand and refinery crude purchases and thereby lowering physical oil shipments from exporters within months." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="39" value="global_oil_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_repricing::policy_rate_level" target="us_china_strategic_rival::ai_infra_concentration" id="806">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher short-term policy rates increase bank lending and working-capital costs, disproportionately squeezing smaller cloud and colocation providers and accelerating M&amp;A and exits that concentrate AI infrastructure among large, well-capitalized incumbents." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_repricing" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
