          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Stronger policy alignment among external allies responding to the Russia–Ukraine war produces coordinated diplomatic pressure, intelligence-sharing and secondary measures that increase the intensity and reach of sanctions enforcement affecting energy transactions tied to Middle East actors." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="middle_east_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="middle_east_escalation::conflict_intensity" id="289">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher cohesion among Western and external security partners reduces perceived windows of opportunity for regional proxies and states in the Middle East by strengthening deterrence and coordinated support to threatened partners, lowering the rate and scale of kinetic escalation." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="middle_east_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="security_alliance_shift::industrial_subsidy_level" id="290">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Greater policy alignment among external partners produces coordinated decisions to finance domestic defence and dual‑use industrial capacity, increasing the scale of targeted subsidies and assistance to affected sectors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="security_alliance_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="security_alliance_shift::tariff_level" id="291">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter cohesion enables allied governments to impose synchronized trade measures (tariffs/embargoes) on identified suppliers linked to the conflict, raising effective tariff intensity in targeted trade lines." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="security_alliance_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="us_china_tech_rivalry::regulatory_restrictions" id="292">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Stronger cohesion among the US and allied states after Russia's aggression produces coordinated policy responses—joint export controls, sanction packages and tighter licensing—directly increasing the stringency and enforcement of restrictions on technology and infrastructure transfers affecting China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="us_china_tech_rivalry::ai_capex_rate" id="293">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved allied policy alignment triggers coordinated public R&amp;D funding, procurement commitments and risk-sharing measures that raise firms' and governments' willingness to commit larger AI infrastructure and cloud capex within allied ecosystems to sustain a technological lead over China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
