          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Faster AI capex by the US and China accelerates deployment of ISR, targeting and autonomous mission-planning tools to their regional partners and proxies in the Middle East, lowering operational risk and thresholds for conducting more frequent precision strikes and kinetic raids." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="middle_east_escalation" />
