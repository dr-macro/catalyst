          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Deterioration in access to critical components (RF modules, power electronics, specialized chips) constrains production and repair of commercial satellite terminals and ground stations used in-theater, reducing operational bandwidth and reliability for military and civilian users." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="security_alliance_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
