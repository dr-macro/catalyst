          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A sustained rise in strike intensity increases expected near-term defence and reconstruction spending and elevates sovereign risk premia for affected and proximate states, leading investors to demand higher yields on government debt." />
          <attvalue for="36" value="0-6 months" />
