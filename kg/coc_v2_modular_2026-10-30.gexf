          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Escalated kinetic strikes damage or disrupt plants and logistics that produce or transport semiconductor feedstocks (specialty gases, substrates) in affected regions and transit corridors, creating acute input shortages and reducing downstream chip production capacity available to both US and Chinese firms." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
