      <edge source="middle_east_escalation::conflict_intensity" target="global_financial_stress::financial_market_volatil" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sharper and more frequent kinetic escalation generates immediate geopolitical risk repricing across assets, triggering rapid portfolio reallocation and spikes in equity, FX and bond volatility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_escalation" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_escalation::conflict_intensity" target="russia_ukraine_war::military_strike_intensit" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A sustained uptick in Middle East kinetic operations forces Western militaries to reallocate precision-guided munitions, ISR assets and targeting capacity to the region, reducing the flow of those strike resources to Ukraine and thereby lowering strike tempo there." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_escalation::conflict_intensity" target="security_alliance_shift::political_pressure" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A marked escalation in fighting produces visible economic dislocation (trade disruptions, service interruptions) and humanitarian spillovers that generate immediate public, industry and legislative demands on policymakers for tariff relief, carve‑outs or other trade concessions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_escalation" />
          <attvalue for="38" value="security_alliance_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_escalation::conflict_intensity" target="us_china_tech_rivalry::regulatory_restrictions" id="37">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Spikes in regional hostilities prompt immediate national-security responses (tighter export controls, investment screening and data‑flow restrictions) that directly increase regulatory barriers on technology deployment and cross-border tech activity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_escalation" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
