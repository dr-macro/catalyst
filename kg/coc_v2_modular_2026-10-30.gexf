      <edge source="security_alliance_shift::critical_materials" target="global_financial_stress::sovereign_yield_level" id="753">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An alliance shift that triggers export controls or supplier exclusion for strategic inputs produces immediate import shortages and higher input prices, pushing up government emergency import financing and risk premia and thereby raising sovereign bond yields within weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="security_alliance_shift" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="security_alliance_shift::critical_materials" target="middle_east_escalation::conflict_intensity" id="754">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved security and diversity of supply for strategic inputs (munitions components, sensors, electronics) allows regional actors and their proxies to rearm and sustain operations, increasing the scale and frequency of kinetic actions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="security_alliance_shift" />
          <attvalue for="38" value="middle_east_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
