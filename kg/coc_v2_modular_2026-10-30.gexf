          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Sustained kinetic strikes destroy or disable mines, processing plants and rail/port transshipment nodes in-and-around the conflict zone, directly reducing exports and immediate availability of critical inputs (metals, fertilisers, specialty gases)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="security_alliance_shift" />
          <attvalue for="27" value="0" />
