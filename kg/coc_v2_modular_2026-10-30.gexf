          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Higher AI capital spending accelerates commercial development of imagery‑analysis, targeting and battle‑management software that allied providers and contractors supply to Ukraine, improving targeting speed and enabling more frequent precision strikes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
