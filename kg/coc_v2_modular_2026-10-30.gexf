      <edge source="middle_east_escalation::maritime_transit_risk" target="global_financial_stress::bond_market_liquidity" id="47">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher probability of shipping disruptions raises counterparties' operational and settlement risk and pushes up insurance and margin costs, causing dealers to pull back inventories and widen bid‑ask spreads, reducing bond market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_escalation" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_escalation::maritime_transit_risk" target="russia_ukraine_war::trade_route_throughput" id="48">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher risk to shipping in key Middle East chokepoints (e.g., Red Sea, Suez approaches) forces rerouting, longer voyages and port congestion that directly cut available shipping capacity and scheduled throughput on commercial corridors serving the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_escalation::maritime_transit_risk" target="security_alliance_shift::critical_materials" id="49">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Attacks and heightened risk in chokepoints force rerouting, port suspensions and insurance refusals that immediately delay, degrade or cancel shipments of time‑sensitive critical inputs (specialty chemicals, gases, components), reducing effective access and diversity of supply." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="middle_east_escalation" />
          <attvalue for="38" value="security_alliance_shift" />
          <attvalue for="27" value="0" />
