          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Increased harassment of merchant shipping in theaters tied to the Russia–Ukraine war prompts commercial rerouting and concentration of traffic through Middle East chokepoints (e.g., Suez, Strait of Hormuz), raising the probability and expected severity of disruptive incidents there." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="middle_east_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
