          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Improved security and diversification of supplies for inputs (e.g., wafers, speciality gases, substrates, neon) reduces stoppages and input bottlenecks, raising effective throughput and short‑term chip output." />
