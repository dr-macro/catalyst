          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A spike in kinetic strike intensity that damages export terminals, pipelines or refining capacity in Russia/Ukraine directly reduces available crude and refined flows to global markets and drives up oil and gas prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="middle_east_escalation" />
          <attvalue for="27" value="0" />
