          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Spikes in financial‑market volatility produce rapid wealth losses and hiring freezes that generate immediate constituent, industry and legislative demands for government relief or intervention." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="security_alliance_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
