          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened concentration of foreign suppliers exposed by an alliance realignment leads to sudden delivery failures and counterparty FX/settlement stress that forces dealers to hoard balance sheet capacity, widening bid-ask spreads and reducing bond market liquidity." />
