          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Spikes in financial-market volatility elevate freight and war-risk insurance costs and prompt charterers to delay or reroute voyages away from contested Black Sea and adjacent corridors, reducing cargo transit volumes and regularity through those routes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
