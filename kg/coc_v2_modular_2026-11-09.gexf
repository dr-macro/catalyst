      <edge source="us_political_realign::policy_signal_coherence" target="iran_gulf_escalation::geopolitical_tension" id="775">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Improved coherence and consistency of US policy signals (clear red lines, deconfliction channels, allied messaging) reduces misperception and unintended escalation, lowering the rate of incidents and diplomatic frictions in the Iran–Gulf theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realign::policy_signal_coherence" target="russia_ukraine_war::market_volatility" id="776">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Clear, consistent US policy signals on military/financial support and sanctions reduce investor ambiguity about future exposures in war‑affected assets and commodities, directly lowering price swings in related markets; the reverse (incoherence) raises volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realign::policy_signal_coherence" target="us_china_strategic_rival::partisan_polarization" id="777">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="More coherent, consistent public policy signals reduce opportunities for opponents to frame divergent narratives about China policy, thereby lowering incentives for partisan theatricalization and cross-party escalation on the issue." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
