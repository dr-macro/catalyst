      </edge>
      <edge source="iran_gulf_escalation::geopolitical_tension" target="iran_gulf_escalation::cyber_vulnerability" id="102">
        <attvalues>
          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="2" />
          <attvalue for="33" value="+" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::geopolitical_tension" target="ai_data_backlash::regulatory_scrutiny" id="103">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Escalation of Iran–Gulf incidents leads states to impose tighter security reviews, export controls and vetting of cross‑border data and AI services tied to the region, directly broadening and intensifying regulatory scrutiny of AI/data activities." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="ai_data_backlash" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::geopolitical_tension" target="ai_data_backlash::reg_enforcement_rate" id="104">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Heightened regional friction prompts enforcement agencies to open sanctions and compliance investigations and to execute asset freezes or penalties against firms involved in disputed transactions or dual‑use data transfers, increasing the rate of formal enforcement actions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="ai_data_backlash" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::geopolitical_tension" target="russia_ukraine_war::security_incident_freque" id="105">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained Iran–Gulf escalation diverts NATO/US naval, air, and ISR assets and attention to the Gulf, reducing deterrence and interdiction capacity in European/Russian theaters and thereby enabling a higher rate of discrete strikes and hostile actions in the Russia–Ukraine war." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::geopolitical_tension" target="us_china_strategic_rival::investor_confidence" id="106">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Escalation of security incidents in the Iran–Gulf theatre raises near‑term risk premia, disrupts shipping/energy flows and insurance costs, and prompts rapid portfolio rebalancing away from risk assets tied to US–China trade and markets, reducing investor confidence." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::geopolitical_tension" target="us_china_strategic_rival::regional_conflict_level" id="107">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained Gulf crises can force US force posture and asset redeployments away from the Indo‑Pacific, creating perceived deterrence gaps that adversaries or proxies test, raising regional conflict levels in the US–China strategic theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::geopolitical_tension" target="us_political_realign::executive_autonomy" id="108">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Acute Iran–Gulf security incidents prompt the administration to request — and Congress and agencies to grant — expedited authorities (emergency funding, limited kinetic or intelligence authorizations, classified authorities), concentrating decision-making power in the executive for near-term responses." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="us_political_realign" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_escalation::policy_uncertainty" target="iran_gulf_escalation::board_responsiveness" id="109">
        <attvalues>
          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="2" />
          <attvalue for="33" value="+" />
          <attvalue for="28" value="0" />
