      <edge source="us_political_realign::policy_signal_coherence" target="ai_data_backlash::regulatory_scrutiny" id="774">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Clear, consistent public policy signals reduce regulators' need to expand investigatory reviews and ad-hoc oversight, so an increase in coherence directly lowers immediate regulatory scrutiny of sectors like AI." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="ai_data_backlash" />
          <attvalue for="28" value="0" />
