      <edge source="russia_ukraine_war::tech_security_breach_rat" target="iran_gulf_escalation::tech_scrutiny_pressure" id="302">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.62" />
          <attvalue for="36" value="A rise in high-profile cyberattacks and breaches attributed to actors linked to the Russia conflict causes Gulf states and Iranian authorities to escalate vetting, audits, and investigations of telecoms, cloud providers, and industrial-control vendors operating in the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::tech_security_breach_rat" target="us_china_strategic_rival::tech_regulatory_scrutiny" id="303">
