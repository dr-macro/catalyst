          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="An uptick in cyberattacks and high‑profile breaches tied to the conflict prompts data‑protection and national‑security agencies to open probes and mandate stricter security controls and reporting from AI and cloud providers, increasing regulatory oversight." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_data_backlash" />
