          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Greater executive autonomy enables faster unilateral operational and arms-transfer decisions (e.g., increased FONOPs, arms shipments, contingency deployments) that directly raise military interactions and escalation risk in theaters such as the Taiwan Strait." />
          <attvalue for="37" value="0-6 months" />
