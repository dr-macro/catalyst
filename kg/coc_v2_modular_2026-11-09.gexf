          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Intensified legislative oversight produces hearings, subpoenas and released documents about government and corporate data practices related to the region, generating higher‑profile media scandal coverage of AI/data actors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="ai_data_backlash" />
          <attvalue for="28" value="0" />
