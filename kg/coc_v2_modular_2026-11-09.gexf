        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Greater US executive autonomy enables faster use of kinetic, covert, or sanction tools (e.g., limited strikes, rapid sanction rollouts) without protracted legislative constraints, which elicits Iranian or proxy reprisals and increases the frequency/intensity of Gulf security incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="iran_gulf_escalation" />
