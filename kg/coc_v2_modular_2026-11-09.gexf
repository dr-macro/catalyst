      <edge source="iran_gulf_escalation::oversight_intensity" target="us_china_strategic_rival::partisan_polarization" id="37">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Intense congressional oversight and hearings about Gulf incidents generate high‑visibility partisan messaging that ties executive decisions to China policy, hardening opposing narratives and increasing partisan polarization around US–China strategy." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_escalation" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
