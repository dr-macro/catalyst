          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="High-frequency cyber and supply‑chain intrusions tied to the Russia–Ukraine conflict produce high‑profile breaches that prompt US regulators and allies to expand export controls, audits, and investigatory scrutiny of technology firms with China links." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::tech_security_breach_rat" target="us_political_realign::policy_signal_coherence" id="304">
