          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in legislative and public oversight (hearings, subpoenas, public investigations) produces competing public disclosures and partisan framing by multiple actors, generating inconsistent and muddled policy messages from the U.S. policymaking system." />
