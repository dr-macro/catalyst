          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.66" />
          <attvalue for="36" value="A rise in high-profile cyber breaches linked to the conflict forces staggered, agency-specific public disclosures and competing guidance (security, commerce, intelligence), producing conflicting messages and reduced coherence in official policy signaling." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
