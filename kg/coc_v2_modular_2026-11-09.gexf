      <edge source="us_political_realign::regulatory_uncertainty" target="ai_data_backlash::reg_enforcement_rate" id="760">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.72" />
          <attvalue for="36" value="Rising regulatory uncertainty induces agencies to open more enforcement actions and issue compliance interventions to define boundaries and deter breaches, raising the enforcement tempo independently of broader scrutiny debates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="ai_data_backlash" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realign::regulatory_uncertainty" target="iran_gulf_escalation::tech_scrutiny_pressure" id="761">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising US regulatory uncertainty around export controls/sanctions prompts Gulf regulators and firms to increase compliance checks, inspections, and restrictions on technology transfers and vendor relationships to avoid secondary sanctions and reputational exposure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="iran_gulf_escalation" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realign::regulatory_uncertainty" target="russia_ukraine_war::tech_security_breach_rat" id="762">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained uncertainty about regulatory requirements and enforcement timing leads firms to defer compliance and security investments and disrupt vendor contracting, directly increasing the incidence of cybersecurity misconfigurations, unpatched systems, and breaches affecting actors in the Russia–Ukraine context." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realign::regulatory_uncertainty" target="us_china_strategic_rival::tech_regulatory_scrutiny" id="763">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising domestic regulatory uncertainty tied to political realignment prompts agencies and Congressional committees to open new investigations and enforcement actions focused on technology firms (including those with China links), increasing scrutiny intensity." />
