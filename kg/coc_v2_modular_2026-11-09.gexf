      <edge source="us_political_realign::executive_autonomy" target="russia_ukraine_war::energy_supply_risk" id="721">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater executive autonomy enables rapid unilateral actions (e.g., targeted sanctions, export controls, approval of kinetic or covert operations) that can directly constrain or provoke disruption of energy exports, transit routes, or extraction activity tied to the Russia–Ukraine conflict, raising near‑term supply risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_realign" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
