      <edge source="russia_west_confrontatio::sanctions_severity" target="ai_tech_power_shift::ai_capability_level" id="164">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Targeted sanctions and export controls that restrict shipments of advanced GPUs, AI accelerators and high-end cloud services directly reduce available compute and specialist software for large-scale model training, lowering aggregate AI capability." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_west_confrontatio" />
          <attvalue for="39" value="ai_tech_power_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_west_confrontatio::sanctions_severity" target="global_monetary_tighteni::market_liquidity" id="165">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Broader and stricter sanctions on banks, payment systems and asset classes remove counterparties, constrain correspondent banking and increase transaction costs, directly widening bid-ask spreads and reducing market depth." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_west_confrontatio" />
          <attvalue for="39" value="global_monetary_tighteni" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_west_confrontatio::sanctions_severity" target="iran_gulf_offensive::energy_shipment_flow" id="166">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sharper sanctions on Russia accelerate security cooperation and arms transfers between Moscow and Tehran, enabling more capable attacks on tankers and routes that reduce actual energy shipments through the Gulf." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_west_confrontatio" />
          <attvalue for="39" value="iran_gulf_offensive" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_west_confrontatio::sanctions_severity" target="us_china_strategic_rival::export_controls_strength" id="167">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Escalation of sanctions on Russia prompts the US and allied capitals to broaden and harmonize outbound technology restrictions to prevent sanctioned parties from acquiring critical components or using intermediaries, and those expanded export-control frameworks are then applied to China‑relevant items." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_west_confrontatio" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
