          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An increase in investor risk appetite encourages firms and financial sponsors to maintain or expand investments and credit lines in higher‑risk markets (including Russia), directly raising corporate operational and balance‑sheet exposure to the conflict; the reverse holds when appetite falls." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="russia_west_confrontatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
