      <edge source="global_monetary_tighteni::gov_bond_yield_curve" target="ai_tech_power_shift::ai_capability_level" id="687">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising long-term sovereign yields increase the financing cost of multi-year capex (data centers, specialized hardware), prompting firms to delay or scale back large compute-intensive training runs and slowing near-term gains in aggregate AI capability." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="ai_tech_power_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
