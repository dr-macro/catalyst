      <edge source="global_monetary_tighteni::investor_risk_appetite" target="iran_gulf_offensive::conflict_intensity" id="704">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A drop in investor risk appetite reduces insurance and underwriting capacity for high‑risk Gulf transits and offshore activities, leaving vessels and energy infrastructure more exposed and increasing incentives for opportunistic kinetic attacks and escalation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="iran_gulf_offensive" />
          <attvalue for="28" value="0" />
        </attvalues>
