      <edge source="global_monetary_tighteni::investor_risk_appetite" target="ai_tech_power_shift::model_deployment_rate" id="703">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An increase in investor risk appetite expands venture and growth funding and willingness to back unproven product launches, enabling AI firms and startups to accelerate rolling models into production and commercial deployments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="ai_tech_power_shift" />
