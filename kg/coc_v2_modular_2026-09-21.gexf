          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Weakened logistics resilience reduces timely delivery, maintenance, and scaling of specialized compute and cooling infrastructure, constraining the capacity to train and operate the largest models and slowing aggregate AI capability growth." />
