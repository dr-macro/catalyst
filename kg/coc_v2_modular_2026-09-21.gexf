          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in kinetic intensity in the Gulf forces the US to reallocate naval/air assets and political attention to the region, producing transatlantic friction over priorities and thereby weakening unity on coordinated policy toward Russia." />
