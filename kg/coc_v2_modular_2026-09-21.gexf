          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained upward shift in sovereign yields (especially among key European allies) tightens domestic fiscal space and raises political and budgetary costs of sustained sanctions or military assistance, producing pressure for policy divergence and weakening alliance cohesion." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="russia_west_confrontatio" />
          <attvalue for="28" value="0" />
