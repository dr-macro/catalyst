      <edge source="global_monetary_tighteni::market_liquidity" target="russia_west_confrontatio::trade_disruption_level" id="729">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A decline in market liquidity raises trade‑finance and settlement frictions (higher transaction costs, frozen correspondent banking lines), causing immediate cancellations and delays in cross‑border shipments and thus higher trade disruption; conversely improved liquidity eases those frictions and lowers disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="russia_west_confrontatio" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_monetary_tighteni::market_liquidity" target="us_china_strategic_rival::trade_barrier_intensity" id="730">
