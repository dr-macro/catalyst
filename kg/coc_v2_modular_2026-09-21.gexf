      <edge source="global_monetary_tighteni::gov_bond_yield_curve" target="iran_gulf_offensive::maritime_accessibility" id="688">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sustained upward pressure across the sovereign yield curve raises government debt servicing costs, forcing near‑term budgetary cuts or delayed spending on coastguard patrols, port security and maritime infrastructure, reducing safe commercial access through chokepoints." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="iran_gulf_offensive" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
