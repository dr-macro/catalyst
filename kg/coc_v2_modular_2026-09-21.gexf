          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Repeated disruptions to regional transport and storage push U.S. and Chinese firms and policymakers to accelerate re‑routing and onshoring of critical technology supply chains, institutionalizing separation in production and standards and increasing technological decoupling." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_gulf_offensive" />
