          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A drop in market liquidity raises trade‑finance costs and disrupts payment chains, prompting firms and governments to favor temporary import restrictions, export licensing or local content measures that raise effective trade barriers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="us_china_strategic_rival" />
          <attvalue for="28" value="0" />
