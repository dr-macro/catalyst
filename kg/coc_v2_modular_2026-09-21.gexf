          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising conflict intensity raises immediate geopolitical risk perceptions and triggers risk‑off portfolio rebalancing (flight to cash/sovereigns and deleveraging), directly lowering aggregate investor willingness to hold risky assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_offensive" />
          <attvalue for="39" value="global_monetary_tighteni" />
