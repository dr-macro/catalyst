          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Persistent damage to regional transport and storage networks forces firms to adopt alternative routing, intermediaries or local partners (including entities tied to Russia), thereby raising their legal and economic exposure in the Russia–West confrontation." />
