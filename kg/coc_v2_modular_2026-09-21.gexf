      <edge source="global_monetary_tighteni::market_liquidity" target="iran_gulf_offensive::logistics_resilience" id="728">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A liquidity squeeze causes banks and financiers to pull or reduce trade‑credit, factoring and supplier lines to ports, terminals and carriers, degrading buffer inventories, spare‑parts availability and the ability to reroute or recover from disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="iran_gulf_offensive" />
          <attvalue for="28" value="0" />
        </attvalues>
