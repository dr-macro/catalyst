          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Falls in investor risk appetite (reduced cross‑border financing, fewer M&amp;A and JV deals) cause firms and financiers to pull back from international technology partnerships and funding, accelerating the practical separation of R&amp;D, standards and supply networks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_monetary_tighteni" />
          <attvalue for="39" value="us_china_strategic_rival" />
