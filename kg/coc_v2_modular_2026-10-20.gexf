      <edge source="russia_ukraine_war::executive_policy_tilt" target="europe_political_turbule::protest_activity_intensi" id="32">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An executive tilt toward rapprochement with Russia (reduced punitive measures or engagement) provokes public backlash from pro-Ukraine constituencies and opposition parties, producing street protests and coordinated demonstrations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::executive_policy_tilt" target="united_states_realignmen::exec_turnover_rate" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A visible executive tilt toward engagement with the adversary provokes domestic political backlash and internal dissent that produces resignations, forced departures, and administrative reshuffles among senior staff." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="united_states_realignmen" />
