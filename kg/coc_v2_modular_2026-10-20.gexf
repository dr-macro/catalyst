      <edge source="russia_ukraine_war::sanctions_pressure" target="china_tech_trade_rivalry::export_control_strength" id="42">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalating sanctions regimes around the Russia war expand regulatory capacity and legal precedents for controlling dual‑use goods, prompting governments to quickly broaden and tighten export controls that are then applied to high‑tech transfers to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="china_tech_trade_rivalry::foreign_capital_flow" id="43">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising sanctions and the attendant risk of secondary measures increase counterparty and regulatory risk perceptions, causing international investors and banks to scale back capital flows into firms and sectors perceived as exposed to geopolitical spillovers (including Chinese tech firms)." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="europe_political_turbule::domestic_market_volatili" id="44">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Tightened sanctions on Russia reduce energy and trade flows and raise uncertainty, producing immediate energy-price shocks and balance-sheet repricing that increase short-term volatility in European financial markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="iran_hormuz_escalation::oil_price_level" id="45">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalating sanctions on Russian energy and financial sectors reduce Russian export capacity and/or push buyers to shun Russian crude, tightening global supply and putting upward pressure on benchmark oil prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="iran_hormuz_escalation::maritime_security_risk" id="46">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater sanctions on Russia incentivize deeper Russia–Iran security and arms cooperation (transfers, tactics, intelligence sharing), which increases the capability and coordination of disruptive operations against commercial shipping in the Gulf, elevating maritime security risk." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="united_states_realignmen::judicial_challenge_flow" id="47">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Broadening or intensifying sanctions creates legal exposure for affected firms, intermediaries and third‑country actors, prompting more lawsuits, injunctions and administrative challenges to executive sanctions actions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="united_states_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
