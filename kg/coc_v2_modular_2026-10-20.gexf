      <edge source="united_states_realignmen::exec_turnover_rate" target="china_tech_trade_rivalry::export_control_strength" id="312">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Spikes in executive turnover lead incoming officials to institute precautionary freezes and tighter vetting on outbound technology transfers while they reassess personnel and policy, producing sharper export-control measures in the near term." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="united_states_realignmen::exec_turnover_rate" target="europe_political_turbule::political_stability" id="313">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A spike in U.S. executive turnover creates immediate uncertainty about U.S. security and diplomatic commitments, prompting coalition strain and policy scramble in vulnerable European governments that reduces their domestic stability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="united_states_realignmen::exec_turnover_rate" target="europe_political_turbule::domestic_market_volatili" id="314">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rapid churn in U.S. executive personnel raises near‑term uncertainty about trade, sanctions and macro policy cues, producing repricing and higher short‑term volatility in European equity, bond and FX markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="united_states_realignmen::exec_turnover_rate" target="iran_hormuz_escalation::maritime_security_risk" id="315">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Rapid senior and mid-level turnover degrades continuity in operational planning and interagency coordination for patrols and convoys in the Strait of Hormuz, raising the near-term likelihood of gaps that hostile actors can exploit." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="united_states_realignmen::exec_turnover_rate" target="russia_ukraine_war::arms_supply_flow" id="316">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="High turnover among executive staff disrupts continuity in procurement, licensing and interagency coordination, producing delays, missed contract deadlines and temporary pauses in arms transfers to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
