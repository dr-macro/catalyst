      <edge source="iran_hormuz_escalation::oil_price_level" target="europe_political_turbule::political_stability" id="137">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sustained elevated oil prices translate into higher consumer energy costs and inflation that erode government approval and increase the risk of cabinet strain or government turnover in fiscally or politically vulnerable European states." />
          <attvalue for="36" value="3-12 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_escalation::oil_price_level" target="russia_ukraine_war::sanctions_pressure" id="138">
