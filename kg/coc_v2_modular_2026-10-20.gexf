      <edge source="russia_ukraine_war::arms_supply_flow" target="europe_political_turbule::protest_activity_intensi" id="55">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Visible increases in weapons deliveries to Ukraine mobilize anti-war movements and polarized diaspora communities, triggering organized demonstrations and rallies in supplier and neighboring countries." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="europe_political_turbule" />
