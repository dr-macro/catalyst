      <edge source="china_tech_trade_rivalry::advanced_tech_share" target="europe_political_turbule::media_attention_intensit" id="481">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rising share of advanced technologies in China-linked exports sharpens European strategic-dependency concerns, prompting sustained high-profile media coverage and investigative reporting on tech security and supply risks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::advanced_tech_share" target="iran_hormuz_escalation::maritime_security_risk" id="482">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A higher share of advanced technologies in Chinese exports raises the global availability of dual‑use maritime systems (unmanned vessels, guidance electronics, comms and ISR kit) that can be procured through third‑party traders and repurposed by Iran or its proxies to conduct more capable and disruptive attacks on shipping." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::advanced_tech_share" target="russia_ukraine_war::arms_supply_flow" id="483">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A higher share of advanced technologies in Chinese exports increases the availability of semiconductors, sensors and other dual‑use components that can be incorporated into Russian weapons or provided via intermediaries, accelerating production and deliveries of military hardware to Russian forces." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::advanced_tech_share" target="united_states_realignmen::judicial_challenge_flow" id="484">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="When a larger share of exports consists of advanced technology, affected firms and industry groups face a higher probability of restrictive measures or licensing disputes and respond quickly with lawsuits and administrative petitions against executive actions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="united_states_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
