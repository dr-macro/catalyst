          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Stepped-up tariffs and non-tariff barriers create concentrated economic gains and losses that spur impacted corporations, industry PACs, and trade associations to increase targeted campaign contributions to influence policymakers." />
