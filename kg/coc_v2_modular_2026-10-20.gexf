          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rapid tightening of export controls forces trade and technology agencies into high-intensity enforcement and politicized licensing decisions, producing resignations, reassignments, and firings among senior officials responsible for implementation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
