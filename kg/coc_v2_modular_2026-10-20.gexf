      <edge source="china_tech_trade_rivalry::supply_chain_integration" target="russia_ukraine_war::allied_cohesion" id="533">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rapid decoupling and reduced supply‑chain integration with China drives Western governments to coordinate industrial, trade and strategic policy responses (joint export controls, procurement coordination, reshoring strategies), raising perceived political cohesion among allies on Russia‑related measures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::supply_chain_integration" target="united_states_realignmen::messaging_coherence" id="534">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher cross-border supply‑chain integration institutionalizes interagency and public‑private coordination routines (joint guidance, shared talking points), increasing consistency across executive communications; conversely, rapid breakdowns of integration remove those routines and reduce coherence." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="united_states_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
