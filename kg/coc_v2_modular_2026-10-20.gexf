      <edge source="united_states_realignmen::messaging_coherence" target="china_tech_trade_rivalry::foreign_capital_flow" id="326">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Clear, consistent executive messaging reduces perceived policy risk and regulatory uncertainty, prompting foreign investors to increase net capital inflows to U.S. assets and ventures tied to technology sectors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="united_states_realignmen::messaging_coherence" target="europe_political_turbule::media_attention_intensit" id="327">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Greater coherence in U.S. executive messaging reduces ambiguous or contradictory signals that European newsrooms amplify, leading to a measurable drop in the volume and intensity of coverage linking U.S. developments to European political unrest." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="united_states_realignmen::messaging_coherence" target="iran_hormuz_escalation::proxy_attack_frequency" id="328">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Divergent or contradictory public statements from the executive create ambiguity about U.S. red lines and resolve, which Iranian commanders and affiliated proxy groups exploit by increasing tests and limited attacks to probe responses." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="united_states_realignmen::messaging_coherence" target="russia_ukraine_war::allied_cohesion" id="329">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Clear, consistent executive communications reduce uncertainty among partners and enable synchronized policy decisions, increasing perceived allied political cohesion behind support for Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="united_states_realignmen" />
          <attvalue for="38" value="russia_ukraine_war" />
