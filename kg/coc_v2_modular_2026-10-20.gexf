      <edge source="china_tech_trade_rivalry::trade_barrier_intensity" target="iran_hormuz_escalation::oil_price_level" id="543">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Tighter trade barriers increase logistical friction and uncertainty in China‑centered trade flows, prompting precautionary crude buying and reducing effective tanker and storage capacity, which tightens physical oil markets and lifts benchmark prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::trade_barrier_intensity" target="russia_ukraine_war::sanctions_pressure" id="544">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter trade barriers imposed on or around China prompt Beijing (and Chinese firms) to compensate by facilitating alternative trade, finance and transshipment channels for sanctioned Russian sectors and counterparties, blunting the effective intensity of Western sanctions on Russia." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::trade_barrier_intensity" target="united_states_realignmen::fundraising_flow" id="545">
