      <edge source="russia_ukraine_war::allied_cohesion" target="china_tech_trade_rivalry::export_control_strength" id="74">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Greater political unity among Western allies over Russia enables coordinated policy forums and information‑sharing that result in harmonized, stricter multilateral export control lists and enforcement applied to sensitive China‑bound technologies." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_cohesion" target="europe_political_turbule::political_stability" id="75">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger perceived allied cohesion reduces domestic partisan disputes over foreign policy and eases pressure on coalition governments, lowering the risk of cabinet crises and supporting incumbent political stability." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_cohesion" target="iran_hormuz_escalation::maritime_security_risk" id="76">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher perceived allied unity behind Ukraine prompts more visible coalition naval deployments and escort operations in vulnerable sea lines, which in turn provoke asymmetric harassment and retaliatory attacks by Iran or its proxies, raising maritime security risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_cohesion" target="united_states_realignmen::messaging_coherence" id="77">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher perceived cohesion among allies enables the executive to coordinate unified public statements and talking points, while fractures force tailored, inconsistent messages to different partners and publics, reducing coherence." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="united_states_realignmen" />
          <attvalue for="27" value="0" />
        </attvalues>
