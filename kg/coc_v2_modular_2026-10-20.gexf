      <edge source="europe_political_turbule::domestic_market_volatili" target="china_tech_trade_rivalry::foreign_capital_flow" id="669">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Spikes in European financial-market volatility trigger risk-off reallocations by institutional investors and banks that rapidly curtail new investments and withdraw or withhold capital from China, producing measurable net outflows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_turbule" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_turbule::domestic_market_volatili" target="iran_hormuz_escalation::oil_price_level" id="670">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sharp volatility in European financial markets drives risk-off flows and pushes investors into commodity hedges and physical oil buying, producing a near-term upward impulse to global oil benchmark prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_turbule" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_turbule::domestic_market_volatili" target="russia_ukraine_war::sanctions_pressure" id="671">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute European market volatility raises the tangible economic and financial costs of additional restrictions, prompting governments and regulators to pause, narrow or water down new sanctions packages to avoid domestic financial spillovers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_turbule" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_turbule::domestic_market_volatili" target="united_states_realignmen::exec_turnover_rate" id="672">
