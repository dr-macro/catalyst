      <edge source="china_tech_trade_rivalry::export_control_strength" target="europe_political_turbule::domestic_market_volatili" id="493">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rapid tightening of export controls on high-tech items creates immediate earnings shocks and uncertainty for European firms with China exposure, triggering equity/bond repricing and liquidity swings in domestic markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="europe_political_turbule" />
