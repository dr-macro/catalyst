          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Sharp increases in benchmark oil prices raise input-cost uncertainty and inflation expectations, prompting rapid repricing in equities, bonds and currency markets and raising short-term domestic financial volatility in Europe." />
          <attvalue for="36" value="0-3 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="europe_political_turbule" />
