          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Sharp spikes in European market volatility transmit to U.S. firms and macroeconomic indicators, generating political pressure and blame that raise the likelihood of turnover among senior U.S. economic and regulatory executive staff." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_turbule" />
          <attvalue for="38" value="united_states_realignmen" />
          <attvalue for="27" value="0" />
