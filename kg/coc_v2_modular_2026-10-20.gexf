      <edge source="iran_hormuz_escalation::maritime_security_risk" target="china_tech_trade_rivalry::supply_chain_integration" id="151">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained increases in maritime security risk (e.g., in the Strait of Hormuz) force firms to reroute, shorten, or regionalize logistics and source inputs away from vulnerable sea lanes linking China to customers and suppliers, materially reducing cross-border production and distribution integration." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_escalation::maritime_security_risk" target="russia_ukraine_war::arms_supply_flow" id="152">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in maritime security risk raises insurance costs, forces rerouting and port-closures, and produces delays and higher transport costs that directly reduce the rate and volume of sea-dependent arms and hardware deliveries to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
