      <edge source="china_tech_trade_rivalry::trade_barrier_intensity" target="europe_political_turbule::protest_activity_intensi" id="542">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Imposition of new tariffs and quotas on intermediate goods raises input costs and forces layoffs or factory slowdowns in export-dependent EU regions, producing localized labor and community protests." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
