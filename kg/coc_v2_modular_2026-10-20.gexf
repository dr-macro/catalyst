      <edge source="china_tech_trade_rivalry::export_control_strength" target="russia_ukraine_war::arms_supply_flow" id="494">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Escalating export controls targeting Chinese access to advanced components incentivize Beijing or Chinese suppliers to relax export checks, route dual‑use parts via third countries, or prioritize transfers to Russia (political reciprocity), increasing the effective rate of arms‑relevant hardware reaching Russian forces." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
