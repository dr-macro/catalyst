      <edge source="europe_political_turbule::political_stability" target="iran_hormuz_escalation::maritime_security_risk" id="657">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute political instability in major European NATO states precipitates rapid redeployment of naval and air assets to domestic/European security tasks, reducing allied patrols and convoy-escort capacity in the Gulf and thereby raising the immediate maritime security risk in and around the Strait of Hormuz." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_turbule" />
          <attvalue for="38" value="iran_hormuz_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="europe_political_turbule::political_stability" target="russia_ukraine_war::allied_cohesion" id="658">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Sharp declines in political stability in one or more key European governments (e.g., collapse of coalitions, leadership crises) directly reduce those governments' capacity and mandate to participate in coordinated Ukraine policy, producing visible fractures in allied unity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="europe_political_turbule" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
