      <edge source="russia_ukraine_war::arms_supply_flow" target="china_tech_trade_rivalry::supply_chain_integration" id="54">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Accelerated deliveries of munitions and electronics for the Ukraine conflict divert limited high‑end semiconductor and component capacity into defence supply lines, creating shortages and incentives to re‑regionalize production that reduce cross‑border supply‑chain integration (including ties with China)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
