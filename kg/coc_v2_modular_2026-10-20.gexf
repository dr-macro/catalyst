      <edge source="iran_hormuz_escalation::proxy_attack_frequency" target="china_tech_trade_rivalry::export_control_strength" id="214">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in proxy attacks attributed to Iran or its networks generates immediate political pressure on the US, EU and partners to close leakage avenues by tightening export licenses and end‑use checks on dual‑use technologies that can be re‑exported via third parties, raising overall export control stringency." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_escalation::proxy_attack_frequency" target="europe_political_turbule::media_attention_intensit" id="215">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="A rise in proxy attacks on vessels and regional infrastructure produces incident-driven reporting (eyewitness footage, casualty and shipping disruption reports) that immediately increases volume and prominence of coverage in European media." />
          <attvalue for="36" value="0-3 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_escalation::proxy_attack_frequency" target="europe_political_turbule::cross_border_contagion" id="216">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Attacks that affect vessels, crews or nationals from multiple countries amplify transnational grievance cues among diasporas and activist networks, raising the likelihood that protest dynamics spread across borders in Europe." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="europe_political_turbule" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_escalation::proxy_attack_frequency" target="russia_ukraine_war::allied_cohesion" id="217">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rise in proxy attack frequency in the Gulf reallocates allied naval and political attention and produces divergent national threat assessments (especially between energy-dependent and less-exposed allies), visibly weakening perceived political unity around coordinated Ukraine policy." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_escalation::proxy_attack_frequency" target="united_states_realignmen::exec_turnover_rate" id="218">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in proxy attacks increases operational tempo and public scrutiny of national-security decision-making, producing blame, internal disputes and forced resignations or reshuffles among senior and mid-level executive staff." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="united_states_realignmen" />
