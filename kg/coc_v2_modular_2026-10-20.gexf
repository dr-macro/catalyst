          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A spike in high‑visibility European coverage forces rapid, reactive public responses from multiple U.S. agencies and officials, producing contradictory statements and lowering overall executive messaging coherence." />
