          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="More frequent hostile incidents in critical waterways creates simultaneous, competing public narratives from Defense, State and the White House about threat assessments and rules of engagement, reducing consistency and alignment of executive communications." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="united_states_realignmen" />
