          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sharp increases in oil prices driven by Hormuz-area tensions create domestic economic pain in energy-importing states and political pressure on executives and legislatures to avoid further sanctions that would exacerbate prices, reducing the willingness to escalate sanctions on Russia." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
