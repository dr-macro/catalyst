  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">Large portfolio flows into US Treasuries withdraw capital from global reinsurance and specialty underwriting pools, tightening capacity for war-risk coverage and causing insurers and reinsurers to raise route-specific premiums for voyages near the strait.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_bond_market_tension</data>
  <data key="d39">us_iran_conflict</data>
