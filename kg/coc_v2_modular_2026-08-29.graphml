<edge source="russia_ukraine_war::escalation_feedback" target="us_bond_market_tension::real_yield_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Stronger escalation feedback raises the probability of supply shocks and risk‑off episodes, elevating inflation uncertainty while increasing demand for nominal safe assets so inflation‑adjusted (real) yields decline.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_bond_market_tension</data>
</edge>
<edge source="russia_ukraine_war::escalation_feedback" target="us_trade_unilateralism::dispute_intensity_index" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Stronger reciprocal escalation loops convert military/political measures into tit‑for‑tat economic reprisals and defensive trade measures, increasing the frequency and severity of bilateral trade disputes and hostile trade rhetoric.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_trade_unilateralism</data>
</edge>
