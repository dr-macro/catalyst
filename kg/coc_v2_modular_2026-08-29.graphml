</edge>
<edge source="us_trade_unilateralism::bilateral_trade_volume" target="global_energy_reorder::lng_gas_flow_volume" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in bilateral trade volume with major LNG importers raises contracted and spot demand for US cargoes and associated logistics, increasing actual LNG flow volumes to those partners.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_trade_unilateralism</data>
  <data key="d39">global_energy_reorder</data>
</edge>
<edge source="us_trade_unilateralism::bilateral_trade_volume" target="us_bond_market_tension::portfolio_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained drop in bilateral trade volume reduces trade-related FX receipts and settlement flows from the partner economy and weakens that partner's demand for U.S. dollar assets, resulting in reduced portfolio purchases of U.S. bonds (net outflows or smaller inflows).</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_trade_unilateralism</data>
  <data key="d39">us_bond_market_tension</data>
</edge>
