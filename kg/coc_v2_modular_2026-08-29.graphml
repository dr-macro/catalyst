<edge source="us_bond_market_tension::real_yield_level" target="global_energy_reorder::oil_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A rise in real yields increases the discount rate and the opportunity cost of holding non‑yielding commodity positions, prompting funds and leveraged traders to cut long oil exposures and relieving upward pressure on spot and futures oil prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_bond_market_tension</data>
  <data key="d39">global_energy_reorder</data>
</edge>
<edge source="us_bond_market_tension::real_yield_level" target="us_trade_unilateralism::corporate_margin_pressur" id="0">
