  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A decline in oil export volumes through the strait directly reduces available global crude supply and forces markets to draw inventories or reprice futures, putting upward pressure on oil prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_conflict</data>
  <data key="d39">global_energy_reorder</data>
</edge>
