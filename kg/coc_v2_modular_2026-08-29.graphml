  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A spike in shipping war‑risk and route-specific insurance raises trade and earnings uncertainty, triggering risk‑off reallocations that produce net portfolio inflows into safe‑haven sovereign bonds.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_conflict</data>
  <data key="d39">us_bond_market_tension</data>
</edge>
<edge source="us_iran_conflict::insurance_premium_level" target="us_trade_unilateralism::corporate_margin_pressur" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Higher war‑risk and route‑specific insurance premiums raise per‑shipment logistics and input costs for US firms importing via the strait, directly compressing corporate profit margins.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_conflict</data>
  <data key="d39">us_trade_unilateralism</data>
</edge>
