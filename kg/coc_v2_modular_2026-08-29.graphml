<edge source="global_energy_reorder::oil_price_level" target="russia_ukraine_war::sanctions_severity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Sustained high oil prices raise domestic inflation and energy bills in sanctioning countries and increase revenue resilience for Russia, reducing political and economic willingness in democracies to escalate or broaden sanctions against Moscow.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_reorder</data>
