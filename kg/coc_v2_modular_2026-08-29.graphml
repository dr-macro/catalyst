<edge source="us_iran_conflict::insurance_premium_level" target="global_energy_reorder::policy_intervention_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Rising war-risk and route-specific insurance premiums raise import and transportation costs for governments and regulators, prompting quicker deployment of interventions such as subsidies, state shipping support, or emergency procurement to stabilize markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_conflict</data>
  <data key="d39">global_energy_reorder</data>
</edge>
<edge source="us_iran_conflict::insurance_premium_level" target="russia_ukraine_war::sanctions_severity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rapid increases in war-risk and route-specific insurance premiums raise energy and trade costs for European states, increasing domestic political pressure to avoid further economically painful sanctions, thereby constraining the scope and severity of new measures against Russia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_conflict</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
