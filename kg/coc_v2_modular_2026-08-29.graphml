<edge source="us_iran_conflict::vessel_transit_rate" target="global_energy_reorder::supply_disruption_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">A fall in the rate of commercial transits through the strait interrupts scheduled deliveries and logistics chains for fuel and other goods, directly increasing measured supply-chain disruption across affected routes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_conflict</data>
  <data key="d39">global_energy_reorder</data>
</edge>
<edge source="us_iran_conflict::vessel_transit_rate" target="us_bond_market_tension::policy_rate_path" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sudden drop in commercial vessel transits reduces traded goods throughput and near-term growth outlooks, causing market participants to lower expected policy rates as central banks are seen likely to delay or soften tightening.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_conflict</data>
  <data key="d39">us_bond_market_tension</data>
</edge>
