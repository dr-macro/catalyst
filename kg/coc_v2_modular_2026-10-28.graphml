</edge>
<edge source="china_tech_pressure::tech_controls_tightness" target="democratic_unrest_wave::protest_event_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Sharper Chinese restrictions on cross-border platforms, apps or data flows provoke rapid solidarity and rights-based mobilization among diasporas, academics and civil-society groups in democracies, increasing protest frequency.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_tech_pressure</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
<edge source="china_tech_pressure::tech_controls_tightness" target="us_iran_standoff::proxy_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Tighter Chinese controls on the export and transfer of dual‑use electronics and guidance components directly reduce the availability of parts used by Iranian proxy networks (drones, guidance kits), degrading their operational tempo and lowering attack frequency within months as inventories are exhausted.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_tech_pressure</data>
  <data key="d39">us_iran_standoff</data>
</edge>
