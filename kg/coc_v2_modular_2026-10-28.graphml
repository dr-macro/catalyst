  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Expanded export licensing and end‑use restrictions legally require commercial providers to obtain state approvals for sales or routing decisions related to sanctioned end users, reducing firms' unilateral decision‑making autonomy.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_tech_pressure</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
