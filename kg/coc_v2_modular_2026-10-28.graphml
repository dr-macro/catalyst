<edge source="us_iran_standoff::energy_supply_risk" target="china_tech_pressure::state_policy_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.8</data>
  <data key="d36">Elevated risk of oil and gas interruptions prompts importing states to intensify state-directed measures (strategic releases, subsidies, investment screening, targeted industrial supports) to secure energy and related critical supply chains.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">china_tech_pressure</data>
</edge>
<edge source="us_iran_standoff::energy_supply_risk" target="democratic_unrest_wave::investor_risk_aversion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">An increased risk of oil/gas supply disruption raises near-term macro and corporate earnings uncertainty and commodity-price volatility, causing investors to shift away from risky assets and increase cash/hedge positions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
<edge source="us_iran_standoff::energy_supply_risk" target="global_finance_shock::energy_supply_balance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Security-driven risks to production and transit (attacks on terminals/tankers, precautionary shutdowns) directly remove barrels/volumes from markets and tighten the near-term supply-demand balance.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">global_finance_shock</data>
</edge>
<edge source="us_iran_standoff::energy_supply_risk" target="global_finance_shock::monetary_policy_stance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising risk of energy disruption lifts headline and expected inflation, prompting central banks to raise the effective policy rate (tighten stance) to counter near-term inflationary pressures.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">global_finance_shock</data>
</edge>
<edge source="us_iran_standoff::energy_supply_risk" target="russia_ukraine_war::state_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Heightened energy supply risk raises political urgency among consumer states, prompting governments to intensify diplomatic, regulatory and sanctioning efforts aimed at commercial communications firms (to limit escalation vectors or deny revenue flows), thereby increasing the intensity of state pressure on providers relevant to the Russia–Ukraine war.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
