<edge source="china_tech_pressure::corporate_repositioning" target="democratic_unrest_wave::protest_event_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Accelerated relocation of production and services away from China-induced partner regions causes plant closures and layoffs that mobilize affected workers and communities into higher rates of organized protest.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_tech_pressure</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
<edge source="china_tech_pressure::corporate_repositioning" target="global_finance_shock::energy_supply_balance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rapid corporate relocation of manufacturing and associated industrial activity from lower‑energy‑intensity regions into energy‑intensive host countries raises local and regional energy demand faster than supply adjustments, tightening global supply‑demand balance and reducing surplus.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_tech_pressure</data>
