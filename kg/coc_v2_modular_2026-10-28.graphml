  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in state‑directed policy intensity leads regulators and diplomatic channels to apply more persistent administrative and diplomatic pressure on private providers to align service choices with state foreign‑policy objectives.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_tech_pressure</data>
  <data key="d39">russia_ukraine_war</data>
