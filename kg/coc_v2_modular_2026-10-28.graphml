<edge source="china_tech_pressure::export_controls" target="democratic_unrest_wave::investor_risk_aversion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Large-scale export controls on critical inputs (e.g., semiconductors) create immediate revenue and supply-chain uncertainty for exposed firms, prompting rapid portfolio rebalancing and higher market-wide risk premia among investors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_tech_pressure</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
<edge source="china_tech_pressure::export_controls" target="global_finance_shock::real_output_growth" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sharp increase in export controls on critical inputs (chips, substrates, tooling) causes immediate input shortages and higher intermediate prices for downstream manufacturers, forcing production cuts and lowering near‑term real output in affected industries and countries.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_tech_pressure</data>
  <data key="d39">global_finance_shock</data>
</edge>
<edge source="china_tech_pressure::export_controls" target="russia_ukraine_war::satcom_availability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Tighter export controls on critical satellite components and high-end chips delay or reduce production and delivery of terminals and smallsats used to provide high‑bandwidth coverage into the theatre, lowering available satcom capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_tech_pressure</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="china_tech_pressure::export_controls" target="russia_ukraine_war::provider_control_autonom" id="0">
