<edge source="us_iran_standoff::military_tension_level" target="china_tech_pressure::external_countermeasures" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Higher interstate military tension increases political pressure on governments to penalize perceived enablers through sanctions, designations and investment curbs, raising the aggregate level of external countermeasures.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">china_tech_pressure</data>
</edge>
<edge source="us_iran_standoff::military_tension_level" target="democratic_unrest_wave::contagion_susceptibility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating military tensions amplify regional media attention, refugee flows and politicized cross-border narratives, lowering barriers to imitation and increasing the likelihood that unrest in one country spreads to others.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
<edge source="us_iran_standoff::military_tension_level" target="global_finance_shock::sovereign_fiscal_pressur" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained higher military tension forces governments to increase defense spending, contingency outlays and borrowing costs, raising budget deficits and overall sovereign refinancing pressure.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">global_finance_shock</data>
</edge>
