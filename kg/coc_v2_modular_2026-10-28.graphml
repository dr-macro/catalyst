<edge source="russia_ukraine_war::state_pressure_level" target="china_tech_pressure::state_policy_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sustained use of diplomatic, regulatory and financial pressure on private providers in the conflict sets a precedent that induces other states to increase the use of direct economic and administrative tools to steer domestic tech and communications firms for security objectives.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_tech_pressure</data>
</edge>
<edge source="russia_ukraine_war::state_pressure_level" target="democratic_unrest_wave::policy_forcefulness" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained state pressure on providers to block/disrupt services creates legal and operational precedents and normalizes government intervention in communications, which domestic authorities then cite to justify more coercive policing, censorship and emergency measures against unrest.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
<edge source="russia_ukraine_war::state_pressure_level" target="global_finance_shock::sovereign_fiscal_pressur" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained state pressure (diplomatic, regulatory, financial or covert) that forces provider operational changes or induces sanctions compels governments to underwrite replacement services, provide bailouts/compensations and increase defence/support spending, widening deficits and raising sovereign refinancing needs.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_finance_shock</data>
</edge>
