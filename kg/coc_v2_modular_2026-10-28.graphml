<edge source="democratic_unrest_wave::investor_risk_aversion" target="china_tech_pressure::corporate_repositioning" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Higher investor risk aversion drives asset managers and shareholders to demand reduced exposure to politically unstable jurisdictions, accelerating firms' decisions to relocate production and reconfigure supply chains away from affected markets, increasing corporate repositioning rates.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">democratic_unrest_wave</data>
  <data key="d39">china_tech_pressure</data>
</edge>
<edge source="democratic_unrest_wave::investor_risk_aversion" target="global_finance_shock::monetary_policy_stance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A jump in investor risk aversion tightens financial conditions (widened spreads, equity falls, funding stress), prompting central banks to ease policy (lower real policy rates or add liquidity) to stabilize markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">democratic_unrest_wave</data>
  <data key="d39">global_finance_shock</data>
</edge>
<edge source="democratic_unrest_wave::investor_risk_aversion" target="russia_ukraine_war::provider_control_autonom" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising investor risk aversion reduces willingness to finance exposure to sanction‑ or conflict‑exposed operations, prompting providers to rely on internal commercial risk assessments and exercise unilateral discretion to limit or withdraw services, increasing their de facto decision autonomy.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">democratic_unrest_wave</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="democratic_unrest_wave::investor_risk_aversion" target="us_iran_standoff::shipping_disruption_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A jump in investor and insurer risk aversion raises insurance premiums and prompts shipping firms to suspend or reroute transits through high-risk Gulf and Strait corridors, materially increasing commercial shipping disruptions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">democratic_unrest_wave</data>
  <data key="d39">us_iran_standoff</data>
</edge>
