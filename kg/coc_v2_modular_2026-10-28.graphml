<edge source="russia_ukraine_war::provider_control_autonom" target="democratic_unrest_wave::investor_risk_aversion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">When commercial providers can unilaterally alter or withdraw services in response to the war, businesses face unpredictable continuity and regulatory risk, prompting investors to demand higher risk premia and shift toward safer assets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
