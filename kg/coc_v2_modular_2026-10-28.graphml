<edge source="us_iran_standoff::proxy_attack_rate" target="china_tech_pressure::tech_controls_tightness" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A rise in proxy attacks that use drones, sensors and communications gear motivates authorities to tighten export and end‑use controls on dual‑use components (sensors, RF modules, chips), increasing regulatory tightness on technology flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">china_tech_pressure</data>
</edge>
<edge source="us_iran_standoff::proxy_attack_rate" target="democratic_unrest_wave::protest_event_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in proxy attacks that produce casualties, strikes on diaspora targets, or visible civilian harm provokes public outrage and grievance framing that directly mobilizes demonstrations and vigils.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
<edge source="us_iran_standoff::proxy_attack_rate" target="russia_ukraine_war::provider_control_autonom" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in proxy attacks on telecom and ground‑station infrastructure in the US–Iran standoff prompts states to impose emergency oversight, export controls and mandatory compliance measures on commercial operators, constraining providers' unilateral decision‑making autonomy over service parameters used in the Russia–Ukraine conflict.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
