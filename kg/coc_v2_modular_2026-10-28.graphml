  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="global_finance_shock::energy_supply_balance" target="china_tech_pressure::state_policy_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">A deterioration in the energy supply balance (tighter supply) compels rapid government rationing, sectoral prioritization and emergency regulatory actions, increasing state policy intensity to allocate scarce energy and protect critical industries.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_finance_shock</data>
  <data key="d39">china_tech_pressure</data>
</edge>
<edge source="global_finance_shock::energy_supply_balance" target="democratic_unrest_wave::protest_event_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Sharp energy shortages or large price spikes (fuel, electricity) produce immediate service disruptions and cost-of-living shocks that mobilize street protests, especially in regions dependent on fuel subsidies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_finance_shock</data>
  <data key="d39">democratic_unrest_wave</data>
</edge>
