      <edge source="us_china_tech_rivalry::geopolitical_tension" target="iran_gulf_conflict::geopolitical_risk_level" id="556">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An uptick in US–China tech rivalry prompts China to harden diplomatic and security ties with Iran (e.g., increased arms, intelligence or diplomatic backing) and reduces Chinese cooperation with U.S. de-escalation efforts, directly raising the probability of confrontations and incidents in the Gulf." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
