          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sustained rise in regional geopolitical risk from Iran-Gulf incidents leads US policymakers and regulators to announce or prepare sanctions, export controls, emergency energy measures and defense-related rule changes, raising market and stakeholder expectations of more active and stringent policy/regulatory intervention." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="us_political_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
