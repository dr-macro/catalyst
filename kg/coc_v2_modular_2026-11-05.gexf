          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An escalation in Iran‑Gulf geopolitical risk prompts the US to heighten security postures, sanctions and supply‑chain safeguards that China treats as adverse moves, producing a concrete uptick in bilateral incident frequency and perceived US‑China geopolitical tension tied to tech and strategic supply chains." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="39" value="us_china_tech_rivalry" />
