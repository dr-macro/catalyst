          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Net outflows from equities triggered by Iran–Gulf tensions shift investor demand into sovereign fixed income (flight-to-safety), increasing bond prices and lowering bond yields in markets financing the Russia–Ukraine war." />
