          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalatory incidents or surprise sanctions in the Russia–Ukraine war create unpredictable sanction lists and emergency trade measures that cause market participants to increase their expectations of abrupt, disruptive US/ally tech-policy actions affecting US–China technology links." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
