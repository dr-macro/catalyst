          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Higher perceived risk of oil supply disruption pushes China toward deeper, time‑bound energy deals with Russia and prompts the United States to accelerate export‑control and supply‑chain defenses, directly intensifying geopolitical friction in the US–China tech competition." />
