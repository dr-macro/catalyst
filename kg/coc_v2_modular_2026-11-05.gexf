          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sharp escalation of Iran-Gulf tensions increases national-security salience and public demand for decisive executive action, which tends to strengthen incumbents and expand executive discretion relative to the legislature, producing measurable shifts in political power distribution over the following election cycle." />
          <attvalue for="37" value="6-18 months" />
