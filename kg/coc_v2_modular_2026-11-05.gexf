      <edge source="us_political_shift::policy_regulatory_expect" target="global_ai_power_shift::oversight_intensity" id="41">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising US expectations of stricter AI regulation prompt federal agencies and regulatory counterparts abroad to accelerate inspections, enforcement actions, and rule‑making focused on AI firms and platforms." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="39" value="global_ai_power_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::policy_regulatory_expect" target="iran_gulf_conflict::energy_commodity_price_l" id="42">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising US expectations for tighter sanctions or export restrictions affecting Iranian (or allied) oil supplies prompt traders to price in reduced future supply, driving up global energy commodity prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::policy_regulatory_expect" target="russia_ukraine_war::crossborder_capital_flow" id="43">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Stronger market expectations of imminent US sanctions or tighter regulatory restrictions cause international banks and asset managers to pre-emptively de-risk exposures to Russia and neighboring markets, generating net capital outflows from the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::policy_regulatory_expect" target="us_china_tech_rivalry::portfolio_reallocation" id="44">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising market expectations of imminent U.S. export controls or investment screening on Chinese tech prompt portfolio managers to preemptively shift allocations away from China-exposed tech names into alternative sectors and regions, raising the observed rate of portfolio reallocation within weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
