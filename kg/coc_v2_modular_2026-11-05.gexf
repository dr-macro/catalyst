      <edge source="us_political_shift::political_power_distribu" target="global_ai_power_shift::policy_expectation" id="27">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A shift toward more unified control of the presidency and Congress (or toward a stronger executive) increases the probability of passage of industrial policy, export‑controls and funding measures, causing markets to expect more active US AI industrial and trade policy." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="39" value="global_ai_power_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::political_power_distribu" target="iran_gulf_conflict::geopolitical_risk_level" id="28">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A shift toward concentrated executive-legislative control and hawkish majorities enables quicker authorization of military deployments, strikes, and security guarantees to Gulf partners, raising the near-term probability and intensity of Iran–Gulf confrontation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::political_power_distribu" target="russia_ukraine_war::policy_uncertainty" id="29">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A shift toward greater partisan concentration or fragmentation in US political power heightens the probability of abrupt reversals or contested votes on Ukraine aid and sanctions, increasing perceived policy uncertainty about the conflict among markets and counterparties." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::political_power_distribu" target="us_china_tech_rivalry::policy_uncertainty_level" id="30">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A measurable consolidation of policymaking authority (greater single-party or executive control) reduces the range of plausible legislative outcomes on tech and trade, narrowing market disagreement and lowering policy-uncertainty indices over the medium term." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
