          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rapid portfolio reallocation away from China/Asia tech into safe assets during tech-rivalry shocks drives global risk-off flows that include withdrawals from Gulf and emerging-market equities, reducing net capital flows to equities there." />
