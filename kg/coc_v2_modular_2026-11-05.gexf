          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising geopolitical policy uncertainty from the Russia–Ukraine war prompts governments to rapidly expand export controls, security reviews and vetting of cross‑border AI partnerships, directly increasing regulatory scrutiny on AI firms." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_ai_power_shift" />
