        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Elevated Western policy uncertainty driven by the Ukraine war leads to redeployment/prioritization of military and diplomatic resources toward Europe, weakening deterrence in the Gulf and thereby increasing the probability and intensity of Iran–Gulf security incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
