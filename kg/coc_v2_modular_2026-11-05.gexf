          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Surges in cross‑border equity flows into strategic AI firms during geopolitical stress—especially from state‑linked or opaque investors—trigger government investment‑screening and proposed restrictions, increasing perceived regulatory risk for the AI sector." />
