          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Stronger expectations in U.S. regulatory action (e.g., export controls, sanctions) increase the likelihood of reciprocal Chinese measures and diplomatic escalation, raising the intensity of perceived geopolitical tension in the bilateral tech relationship." />
          <attvalue for="37" value="0-6 months" />
