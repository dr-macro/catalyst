          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Heightened Iran–Gulf geopolitical risk drives global risk aversion and liquidity reallocation away from higher-risk, conflict-exposed jurisdictions, reducing net cross-border capital flows into markets affected by the Russia–Ukraine war." />
