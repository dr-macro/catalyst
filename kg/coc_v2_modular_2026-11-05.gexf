          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Escalation in US–China tech friction pushes Beijing and Moscow into deeper energy/security cooperation, leading Russia to reallocate exports toward Asian buyers and prompting route changes and supply‐prioritization that raise the probability of disruptive shortages or re-routing for European and global customers." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
