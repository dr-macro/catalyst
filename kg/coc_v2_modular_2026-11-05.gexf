          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Heightened US–China tensions trigger increased naval deployments and precautionary shipping restrictions or insurance-cost spikes on routes serving the Gulf (due to higher incident risk), which raises risk premia and pushes up energy commodity prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension" target="russia_ukraine_war::oil_supply_risk" id="558">
