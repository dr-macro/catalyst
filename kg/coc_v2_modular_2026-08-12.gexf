          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Greater effective control of the chokepoint increases operational and supply risks that advantage large, vertically integrated tech firms (which can absorb shocks and secure supplies), accelerating exit or consolidation among smaller AI competitors and raising market concentration." />
