      <edge source="taiwan_cross_strait::advanced_tech_capability" target="russia_ukraine_war::component_availability" id="539">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Increases in Taiwan's high-end semiconductor and sensor production capacity directly raise the global supply of chips and guidance components that are re‑exported or incorporated into drones used by actors in the Russia–Ukraine theater." />
          <attvalue for="37" value="0-6 months" />
