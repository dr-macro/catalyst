          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher usable transit capacity lowers logistical bottlenecks and entry barriers for smaller AI vendors, whereas constrained capacity advantages vertically integrated hyperscalers that can internalize logistics and inventories, so increases in capacity tend to reduce concentration." />
          <attvalue for="36" value="6-18 months" />
