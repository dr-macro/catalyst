      <edge source="russia_ukraine_war::escalation_pressure" target="ai_governance_cyber_risk::regulatory_pressure" id="311">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising political and operational pressure to escalate (including weaponization or offensive AI use) produces high-profile incidents and strategic concern that prompt legislators and regulators to accelerate rulemaking, export controls and oversight of AI capabilities." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_governance_cyber_risk" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="global_energy_volatility::global_oil_price_level" id="312">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Elevated political and military pressure that raises the risk of wider strikes on energy infrastructure or broader supply disruption prompts markets to price in a higher supply-risk premium, pushing up crude prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_energy_volatility" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="iran_hormuz_standoff::security_incident_rate" id="313">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Heightened escalation pressure in the Russia–Ukraine war prompts redeployment of Western naval and intelligence assets toward the European theatre, reducing patrols and deterrent presence in the Persian Gulf and thereby enabling increased Iranian harassment, seizures, or strikes on commercial shipping." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_pressure" target="us_china_tech_rivalry::trade_control_level" id="314">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising political and operational pressure to prevent further escalation prompts governments to broaden and tighten export controls and licensing on dual‑use and high‑end technologies, raising overall trade control levels." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
