      <edge source="us_china_tech_rivalry::cross_border_capital" target="iran_hormuz_standoff::coercive_leverage" id="476">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising cross-border capital directed into Iranian ports, shipbuilding, and defense-related firms (via Chinese or third-party investors/circumvention channels) finances materiel and infrastructure upgrades that materially increase Iran's ability to threaten or disrupt sea lanes, thereby raising its coercive leverage." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="iran_hormuz_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
