          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained net inflows into a jurisdiction's tech/industrial sectors relax external financing constraints and currency pressure, reducing the need for monetary authorities to hike policy rates (or allowing them to cut) to stabilize markets and fund the economy." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_currency_friction" />
