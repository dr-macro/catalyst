      <edge source="taiwan_cross_strait::trade_restriction_level" target="global_currency_friction::fx_funding_stress" id="576">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An abrupt increase in export controls or licensing on Taiwan tech and components forces corporates and suppliers to pre-fund imports and roll or extend USD hedges, sharply raising demand for dollar liquidity and widening cross‑currency basis spreads." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="taiwan_cross_strait" />
          <attvalue for="39" value="global_currency_friction" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="taiwan_cross_strait::trade_restriction_level" target="hormuz_standoff::maritime_incident_rate" id="577">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalation of export controls on Taiwanese tech provokes PRC coercive signaling and forward naval/paramilitary deployments as deterrence and bargaining leverage, which increases harassment, interdiction attempts and close encounters by forces operating in distant but politically salient sea lanes including the Strait of Hormuz." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="taiwan_cross_strait" />
          <attvalue for="39" value="hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="taiwan_cross_strait::trade_restriction_level" target="russia_ukraine_war::component_availability" id="578">
