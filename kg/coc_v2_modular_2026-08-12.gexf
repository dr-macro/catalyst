      <edge source="iran_hormuz_standoff::security_incident_rate" target="global_energy_volatility::global_oil_price_level" id="70">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An uptick in attacks, seizures or strikes produces immediate supply disruptions, emergency cargo diversions and spot-market re‑pricing as traders and refiners anticipate shortfalls, putting upward pressure on global crude prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="global_energy_volatility" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_hormuz_standoff::security_incident_rate" target="russia_ukraine_war::air_defense_capacity" id="71">
        <attvalues>
