          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Demonstrated ability to threaten maritime trade strengthens U.S. and allied political justification to broaden export controls and tighten licensing regimes aimed at limiting China's ability to acquire sensitive technologies or dual‑use goods." />
