      <edge source="russia_ukraine_war::cross_border_incidents" target="global_currency_friction::fx_intervention_level" id="219">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Spikes in cross‑border strikes and airspace violations produce abrupt regional capital flows and exchange-rate pressure that prompt central banks and sovereigns to step up deliberate FX operations to stabilise markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_currency_friction" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::cross_border_incidents" target="hormuz_standoff::oil_risk_premium" id="220">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="An uptick in cross‑border strikes and airspace violations in the Russia–Ukraine system elevates global geopolitical tensions and market perceptions of contagion risk, causing traders to add a higher security/risk premium to oil tied to Hormuz-route vulnerabilities." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::cross_border_incidents" target="taiwan_cross_strait::investment_capital_flow" id="221">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An uptick in cross‑border strikes and airspace violations in Ukraine raises perceived geopolitical risk among global investors, causing near‑term reductions or repricing of capital flows into technology and manufacturing assets tied to Taiwan/China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="taiwan_cross_strait" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::cross_border_incidents" target="us_china_tech_rivalry::cross_border_capital" id="222">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An uptick in cross‑border strikes, airspace violations or spillovers raises geopolitical risk perceptions and prompts investors and financiers to reduce or delay cross‑border FDI and portfolio flows into sensitive tech sectors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
