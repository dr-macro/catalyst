          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increased cross‑border capital flows from Chinese or other foreign investors into Russian UAV and component firms provide working capital and investment to scale production lines and procurement, raising the tempo and quantity of drone strikes in the near term." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
