          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Curtailment of cross‑border investment into port terminals, storage and ship‑repair capacity (driven by tech‑rivalry restrictions and screening) delays or cancels upgrades and reduces throughput, lowering effective maritime transit capacity for crude and products." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="global_energy_volatility" />
          <attvalue for="27" value="0" />
        </attvalues>
