          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="An increase in cross‑border technology transfer reduces operational uncertainty for multinationals in supply chains, decreasing precautionary drawdowns of USD credit lines and hedging demand and thereby easing cross‑currency funding strains over time." />
          <attvalue for="37" value="6-18 months" />
