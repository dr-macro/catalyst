        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="When Taiwanese firms (e.g., leading foundries) increase process-node know‑how and deploy it in existing fabs, they directly raise operable advanced-manufacturing throughput (semiconductor wafer starts and advanced module output) available to global markets." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="taiwan_cross_strait" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
