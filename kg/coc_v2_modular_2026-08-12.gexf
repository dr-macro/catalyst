          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A spike in attacks and seizures causes immediate vessel diversions, cargo losses and insurance/port disruptions that degrade firms' ability to maintain flows and recover, lowering measured supply‑chain resilience within weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
