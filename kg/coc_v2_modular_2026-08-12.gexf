          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An uptick in transfers of sensitive designs, process IP or equipment from Taiwanese entities to PRC firms triggers immediate policy responses (licensing changes, new entity listings and stricter export controls) from the US and allies to block further leakage." />
