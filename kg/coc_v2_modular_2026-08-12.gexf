          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising frequency and effectiveness of unmanned attacks on ships and port infrastructure raises insurers' and charterers' perceived hazard, producing higher insurance/war-risk surcharges and freight premiums." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_energy_volatility" />
