          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A rise in effective/coercive control by local actors leads to more inspections, seizures, convoying and route closures that directly reduce the sustainable throughput of commercial oil shipping through the chokepoint." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="global_energy_volatility" />
