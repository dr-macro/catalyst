      <edge source="global_currency_friction::fx_funding_stress" target="hormuz_standoff::choke_point_transit_volu" id="821">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Acute cross‑currency funding stress raises dollar/working‑capital costs for shipowners, charterers and insurers, causing cancellations, delays or rerouting of tanker voyages and thereby reducing tanker transit volumes through Hormuz." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_currency_friction" />
          <attvalue for="39" value="hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_currency_friction::fx_funding_stress" target="russia_ukraine_war::component_availability" id="822">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising cross‑currency funding stress increases the cost and reduces the availability of foreign‑currency payments for Russian importers and third‑party intermediaries, choking off purchases of foreign drone components and subsystems." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_currency_friction" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
