          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Successful cyber intrusions on port operating systems, vessel automation or traffic-management platforms directly force slowdowns, berth closures and rerouting that reduce sustainable crude/product shipment throughput through chokepoints." />
