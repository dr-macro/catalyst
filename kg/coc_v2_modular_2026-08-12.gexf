      <edge source="global_currency_friction::exchange_rate_level" target="russia_ukraine_war::component_availability" id="746">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A depreciation of the ruble (a rise in the ruble‑per‑USD exchange rate) raises the local currency price of imported drone parts, reducing procurement volumes and diversity of foreign suppliers for components." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_currency_friction" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_currency_friction::exchange_rate_level" target="taiwan_cross_strait::manufacturing_export_flo" id="747">
        <attvalues>
