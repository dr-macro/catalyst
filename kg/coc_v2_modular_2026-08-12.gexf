          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A spike in maritime security incidents prompts states, militaries and opportunistic actors to launch more offensive and defensive cyber operations (including targeting shipping, port infrastructure and AI-enabled logistics systems), raising the frequency and severity of cyberattacks on AI supply chains and deployed models." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="ai_governance_cyber_risk" />
