          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A stronger foreign currency (e.g., USD appreciation / higher USD/TWD exchange rate) makes Taiwan's USD‑priced manufactured goods cheaper for buyers abroad, directly raising export volumes as exporters win or expand orders and pass through price competitiveness." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_currency_friction" />
          <attvalue for="39" value="taiwan_cross_strait" />
          <attvalue for="28" value="0" />
        </attvalues>
