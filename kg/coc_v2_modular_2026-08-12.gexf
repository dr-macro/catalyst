      <edge source="us_china_tech_rivalry::trade_control_level" target="ai_governance_cyber_risk::ai_investment_flow" id="448">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter export controls and licensing uncertainty cause investors (both domestic risk-averse VCs and foreign limited partners) to withhold or reroute funding from firms whose addressable markets or supply access are curtailed, reducing capital deployment into AI projects." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="ai_governance_cyber_risk" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="ai_governance_cyber_risk::model_productization" id="449">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Restrictions on export of accelerators, development toolchains and pretrained assets directly prevent companies from acquiring necessary hardware and software components, delaying or blocking the conversion of research models into deployable commercial products." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="ai_governance_cyber_risk" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="global_energy_volatility::tanker_risk_premium" id="450">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Stricter US-China export controls and licensing enforcement provoke interdictions, sanctions‑related boardings and increased naval/escort deployments along key shipping routes, raising insurers' and charterers' perceived war/contingency risk and thus the tanker risk premium." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="global_energy_volatility" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="russia_ukraine_war::drone_attack_rate" id="451">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter export controls on advanced semiconductors and avionics destined for China reduce the pool of re‑exportable/high‑end chips that find their way to Russian drone manufacturers, degrading guidance/EW capability and lowering the rate of effective drone attacks within months." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="russia_ukraine_war::air_defense_capacity" id="452">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Stricter controls on sensors, high‑end ICs and test equipment limit third‑party supplies that would otherwise be transferred to Russian radar and interceptor producers, reducing maintenance/production rates and degrading operational air‑defence capacity over the medium term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
