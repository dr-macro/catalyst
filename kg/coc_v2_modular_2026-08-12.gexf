          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in hostile incidents in the Strait of Hormuz drives NATO/US to redeploy mobile air-defence batteries, spares and trained crews to protect bases, ships and supply lines in the Gulf, reducing operational air-defence availability for the Ukraine theater." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
