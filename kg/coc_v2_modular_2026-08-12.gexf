          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Faster conversion of AI research into commercial logistics, port-automation and scheduling products leads to quicker deployment of tools (autonomous berthing, predictive maintenance, optimized slotting) that raise effective throughput even during elevated regional tensions." />
