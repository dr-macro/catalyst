      <edge source="taiwan_cross_strait::manufacturing_export_flo" target="hormuz_standoff::choke_point_transit_volu" id="546">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sudden fall in Taiwan-origin manufactured exports signals weaker global industrial activity and reduces near-term refinery feedstock and refined-product demand, producing fewer tanker loadings and a measurable drop in transit volume through key chokepoints such as the Strait of Hormuz." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="taiwan_cross_strait" />
          <attvalue for="39" value="hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="taiwan_cross_strait::manufacturing_export_flo" target="us_china_tech_rivalry::supply_chain_resilience" id="547">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sustained high-volume outbound shipments of critical components (chips, modules) from Taiwanese manufacturers directly reduce upstream shortages and bottlenecks, thereby improving the ability of US/China technology value chains to maintain production and recover from disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="taiwan_cross_strait" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
