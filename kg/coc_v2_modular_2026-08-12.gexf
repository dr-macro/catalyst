          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A materially stronger reserve currency (e.g., USD) increases the real purchasing power of US/allied defence and security budgets for forward deployments and escorts, sustaining patrol presence in the Strait and lowering the frequency of hostile or interdiction incidents." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_currency_friction" />
          <attvalue for="39" value="hormuz_standoff" />
          <attvalue for="28" value="0" />
