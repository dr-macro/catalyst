      <edge source="hormuz_standoff::oil_price_level" target="russia_ukraine_war::drone_attack_rate" id="24">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained spikes in global oil prices boost export revenue for Russia on short notice, increasing available budget and hard-currency purchasing power to procure, field, or replenish drones and munitions, thereby raising the frequency of drone attacks in the Ukraine theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="hormuz_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
