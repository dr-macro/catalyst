      <edge source="us_china_tech_rivalry::trade_control_level" target="global_currency_friction::fx_funding_stress" id="386">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Tighter export controls and licensing regimes interrupt normal cross-border payments and correspondent-banking relationships and force firms to seek hard-currency pre-funding or alternative corridors, immediately widening basis spreads and reducing FX liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_currency_friction" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="global_currency_friction::fx_intervention_level" id="387">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp, policy-driven trade restrictions create abrupt one-sided FX flows and volatility (eg sudden export/import payment shifts or sanction-triggered flows), prompting monetary authorities to conduct larger or more frequent FX market interventions to stabilize exchange rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="global_currency_friction" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="hormuz_standoff::maritime_incident_rate" id="388">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rapid expansion of export controls on maritime and dual‑use technology prompts Beijing to respond with more assertive naval/coast‑guard patrols and closer operational coordination with regional partners (including proxy harassment), increasing hostile interdiction and harassment incidents in and around the Strait of Hormuz." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="hormuz_standoff::choke_point_transit_volu" id="389">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Broader export controls and tightened secondary‑sanctions enforcement raise legal, compliance and insurance risks for shipowners and charterers, causing firms to suspend or reroute tanker transits through Hormuz and temporarily reduce throughput." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="hormuz_standoff::oil_risk_premium" id="390">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating export controls and visible tech‑rivalry confrontations increase market expectations of retaliatory measures or escalation affecting Gulf transit, so traders and risk‑models add a higher geopolitical risk premium to oil prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="hormuz_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="russia_ukraine_war::component_availability" id="391">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Tighter export controls and licensing on chips, sensors and dual‑use subsystems directly block legal shipments and raise prices/uncertainty for intermediaries supplying the Russia‑Ukraine theatre, reducing the market availability of drone components within weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="russia_ukraine_war::cross_border_incidents" id="392">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Stricter export controls incentivize covert routing and use of third‑country brokers for restricted tech transfers, increasing the number of interdictions, seizures and contested transit incidents that cross political or physical borders." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::trade_control_level" target="taiwan_cross_strait::technology_transfer_flow" id="393">
