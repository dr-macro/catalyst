          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A fall in cross-border capital (driven by sanctions, tighter screening, or risk aversion tied to the rivalry) immediately reduces net inbound equity and direct investment from Chinese and third‑party investors into Taiwanese industrial and tech firms." />
