          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Greater ability to threaten or intermittently disrupt transit increases perceived and actuarial war/terrorism risk, causing insurers and charterers to add war-risk surcharges and contingency margins to freight rates." />
