          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="An increase in crude prices directly raises expected near-term energy and transport costs, leading firms and households to revise up short- and medium-term inflation expectations." />
