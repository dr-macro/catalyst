        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Accelerated transfer of guidance algorithms, AI payload designs, or manufacturing know‑how from Taiwan to firms in the region enables faster fielding of more effective UAVs by third parties or beneficiaries, raising the frequency and effectiveness of drone attacks in the Russia–Ukraine war." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="taiwan_cross_strait" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
