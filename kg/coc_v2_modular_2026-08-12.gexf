          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp rises in global oil prices raise production and transport costs and short‑term inflation, prompting risk‑off reallocations and reducing cross‑border equity and project finance into Taiwan's manufacturing and tech sectors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="hormuz_standoff" />
          <attvalue for="39" value="taiwan_cross_strait" />
          <attvalue for="28" value="0" />
