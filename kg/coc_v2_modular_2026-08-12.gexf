          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Tighter export controls and licensing (e.g., US/Allied restrictions on chip tools and design IP) impose legal and commercial barriers that directly reduce the legal rate at which Taiwanese firms can transfer advanced designs, tooling, and IP to mainland Chinese partners." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="taiwan_cross_strait" />
          <attvalue for="28" value="0" />
        </attvalues>
