      <edge source="taiwan_cross_strait::manufacturing_export_flo" target="global_currency_friction::exchange_rate_level" id="545">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained rise in Taiwan's manufacturing export shipments increases foreign‑currency (USD) inflows into the region, easing demand for safe‑haven currencies and putting downward pressure on major USD bilateral exchange rates (i.e., USD weakens vs affected Asian currencies)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="taiwan_cross_strait" />
          <attvalue for="39" value="global_currency_friction" />
          <attvalue for="28" value="0" />
        </attvalues>
