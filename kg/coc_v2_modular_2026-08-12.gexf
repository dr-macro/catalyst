          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Increased cross‑border capital into relevant manufacturers or trading intermediaries enables ramped production or bulk purchases of complete UAVs and rapid export to combat actors, raising the frequency of drone strikes as inventories and production are expanded." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
