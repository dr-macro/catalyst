          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Stronger coercive control of the Strait of Hormuz increases delays, insurance and rerouting costs for global shipping, directly amplifying interruptions to commodity and energy trade flows that interact with Russia–Ukraine trade corridors (e.g., grain and oil export logistics)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_standoff" />
          <attvalue for="38" value="russia_ukraine_war" />
