          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Elevated oil prices increase fiscal and liquidity cushions for Gulf sovereign funds and exporters, prompting accelerated outbound strategic investments and acquisitions into global tech and industrial assets that affect cross‑border capital flows in the US‑China tech competition." />
