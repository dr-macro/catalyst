  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Deeper BRICS financial linkages and alternative payment rails reduce sanctions frictions and allow Russia and its suppliers to settle purchases and logistics more easily, increasing the volume and regularity of arms and materiel reaching conflict actors.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">brics_china_india</data>
