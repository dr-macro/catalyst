  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rapid increases in US‑allied AI capabilities spur deeper India‑US security and technology collaboration (shared procurement, joint R&amp;D and intelligence exchanges), which China interprets as a shifting balance and responds with military/diplomatic measures that elevate China–India bilateral tensions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_allied_tech_rivalry</data>
  <data key="d40">brics_china_india</data>
</edge>
