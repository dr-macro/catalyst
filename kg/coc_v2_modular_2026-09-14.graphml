  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Tighter global financial conditions (wider spreads, higher volatility, reduced credit availability) prompt banks and asset managers to de-risk and cut cross-border lending and wholesale funding, directly shrinking the depth of financial linkages and coordination among BRICS, including China and India.</data>
  <data key="d38">0-12 months</data>
  <data key="d39">global_bond_inflation</data>
  <data key="d40">brics_china_india</data>
</edge>
<edge source="global_bond_inflation::financial_conditions_ind" target="iran_gulf_chokepoints::maritime_chokepoints_cap" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Tighter financial conditions increase shipping and trade finance costs and constrain working capital for carriers and terminals, leading to stretched schedules, deferred sailings and maintenance, and thus a measurable reduction in effective throughput at major chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_inflation</data>
  <data key="d40">iran_gulf_chokepoints</data>
</edge>
<edge source="global_bond_inflation::financial_conditions_ind" target="russia_ukraine_war::drone_operational_densit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Tighter financial conditions (higher spreads, reduced credit) constrain defense contractors' and frontline units' ability to purchase parts, finance maintenance, and sustain fuel/logistics chains, which lowers sortie rates and active operational density of drones.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_inflation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
