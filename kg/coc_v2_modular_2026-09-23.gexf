          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Acute increases in energy-route or supplier-targeted political friction (e.g., sanctions, seizures, naval incidents) directly reduce bilateral confidence by signaling hostile intent and prompting mutual threat reassessments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="us_china_strategic_compe" />
