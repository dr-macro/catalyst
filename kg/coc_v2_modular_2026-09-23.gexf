          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A higher systemic likelihood that incidents will broaden increases diplomatic friction, sanctions risk and public risk premia, directly raising measured geopolitical tension levels among states and markets." />
