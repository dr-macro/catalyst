          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising energy-related diplomatic frictions and security incidents among partners (e.g., disputes over transit, diversion of supplies) produce unilateral national measures and political friction that erode coordination and policy alignment within allied coalitions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="russia_ukraine_war" />
