          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="New or tightened sanctions (banking, insurance, port access and shipping restrictions) directly block and delay shipments and financial settlement for diesel exports from affected suppliers, immediately reducing cross-border diesel flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_supply_sho" />
          <attvalue for="28" value="0" />
