          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Broad sanctions and export controls on dual-use technologies create precedents and political pressure that prompt governments and blocs to expand AI-related export controls, reporting rules, and oversight, raising overall regulatory attention." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
