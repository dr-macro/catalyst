          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rising energy-related geopolitical tensions prompt authorities to tighten export licensing and broaden controls on equipment and technologies deemed useful to an adversary, increasing overall export-control stringency toward the other side." />
