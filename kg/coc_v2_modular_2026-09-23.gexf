          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter export controls on specialty catalysts, control systems and spare parts used in refining constrain access to critical inputs and maintenance supplies, causing unplanned outages and reduced run‑rates at affected refineries over time." />
