      <edge source="global_energy_supply_sho::geo_political_tension" target="middle_east_iran_houthis::oil_supply_disruption" id="844">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Elevated geopolitical tension increases the frequency of naval escorts, interdictions, punitive strikes, and retaliatory actions in the theater, which directly raises the probability and scale of physical disruptions to crude and refined oil shipments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_supply_sho" />
          <attvalue for="39" value="middle_east_iran_houthis" />
