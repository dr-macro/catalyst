          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger cohesion among Western and regional partners preserves coordinated naval patrols, intelligence-sharing and combined strikes, which suppress Houthi attacks and reduce disruptions to maritime trade." />
