          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Heightened sanctions regimes around the Russia–Ukraine war prompt governments to broaden and harden export‑control licensing and enforcement to prevent sanctioned diversion and close loopholes, leading to tighter controls that are then extended to technologies affecting US–China flows." />
          <attvalue for="37" value="0-6 months" />
