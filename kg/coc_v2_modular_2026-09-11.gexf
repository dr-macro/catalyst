      <edge source="global_financial_stress::market_liquidity" target="iran_houthi_escalation::shipping_operating_costs" id="747">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sudden drop in bond-market liquidity forces banks and insurers to hoard capital and withdraw trade-finance/insurance capacity, prompting immediate rises in letters-of-credit fees and war-risk/PDV insurance premiums that raise per-voyage shipping costs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="iran_houthi_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_stress::market_liquidity" target="north_korea_nuclear::tech_diffusion_rate" id="748">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Improved bond market liquidity lowers the cost and risk of short-term financing (eg repo, working capital) for trading houses and brokers that procure and move dual‑use components, increasing the speed at which such technologies diffuse into gray‑market channels that can reach North Korea." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_stress::market_liquidity" target="us_china_tech_rivalry::cross_border_transfer" id="749">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Deteriorating bond and credit market liquidity raises transaction costs and elevates financing and counterparty risk for cross‑border M&amp;A, joint ventures and supplier contracts, causing firms to curtail overseas R&amp;D partnerships and personnel exchanges that transmit tacit technology." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_financial_stress" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
