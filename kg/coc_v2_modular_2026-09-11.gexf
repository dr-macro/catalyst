          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher insurance premiums, rerouting and security surcharges materially raise transaction and logistics costs for exporters and project sponsors, causing private investors and funds to scale back or delay cross‑border capital commitments into technology and energy projects (including those channels that can be repurposed for DPRK procurement)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_houthi_escalation" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
