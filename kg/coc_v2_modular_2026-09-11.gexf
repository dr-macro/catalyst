      <edge source="iran_houthi_escalation::sanctions_intensity" target="global_financial_stress::market_liquidity" id="105">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Expanded sanctions reduce correspondent-banking links and constrain market-makers' ability to intermediate cross-border bond trades, causing dealers to pull back and reducing observable bond-market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_houthi_escalation" />
          <attvalue for="38" value="global_financial_stress" />
