      <edge source="russia_ukraine_war::political_will_backers" target="iran_houthi_escalation::maritime_incident_rate" id="247">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising political will among Western backers to sustain Ukraine leads to diversion of limited naval assets and rules‑of‑engagement political capital toward European deterrence, reducing patrols/deterrence in the Red Sea/Arabian Sea and thereby enabling more Houthi attacks and seizures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_houthi_escalation" />
