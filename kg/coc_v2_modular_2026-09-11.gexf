          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Credible intelligence or visible evidence of a sustained increase in North Korean missile industrial output triggers US administrative actions and diplomatic pressure on allied suppliers to broaden export restrictions on components and tooling used in missile guidance and propulsion, which spill over into tighter controls on related high‑end tech sent to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="north_korea_nuclear" />
