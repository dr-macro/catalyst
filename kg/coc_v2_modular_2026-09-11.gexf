      <edge source="iran_houthi_escalation::sanctions_intensity" target="global_financial_stress::corporate_spread_level" id="106">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Tighter sanctions increase counterparty, settlement and trade-risk for internationally active firms (and their banks), reducing access to funding and increasing perceived default risk, which pushes corporate spreads wider." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_houthi_escalation" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_houthi_escalation::sanctions_intensity" target="north_korea_nuclear::cross_border_cap_flow" id="107">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger and more rigorously enforced sanctions against Iran/Houthi-related entities prompt correspondent banks and institutional investors to de‑risk by withdrawing or restricting foreign capital exposures, reducing net cross‑border flows into sectors and intermediaries that could be exploited by DPRK networks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_houthi_escalation" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_houthi_escalation::sanctions_intensity" target="us_china_tech_rivalry::export_control_intensity" id="108">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalation of sanctions tied to Iran/Houthi activity prompts the US and allies to broaden and more tightly enforce export‑control licensing and entity lists to prevent sanction circumvention and dual‑use flows — including preemptive restrictions that affect China‑linked supply chains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_houthi_escalation" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
