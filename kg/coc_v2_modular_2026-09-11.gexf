          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rapid rise in North Korea's missile production capacity increases the assessed probability of strikes and supply‑chain disruption for regional firms and insurers, causing investors to demand higher credit spreads on corporates with exposure to those risks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="north_korea_nuclear" />
          <attvalue for="38" value="global_financial_stress" />
