          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::conflict_intensity" target="global_financial_stress::corporate_spread_level" id="189">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A sustained rise in overall combat intensity increases operational interruptions, counterparty risk and default probability for firms (especially in Europe and energy‑sensitive sectors), so investors demand higher credit spreads on corporate bonds." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::conflict_intensity" target="iran_houthi_escalation::shipping_operating_costs" id="190">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A marked increase in overall Russia–Ukraine kinetic intensity raises global maritime and geopolitical risk premia and prompts insurers and war‑risk underwriters to lift premiums and require more costly security measures, directly increasing per‑voyage operating costs for carriers in adjacent and global routes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_houthi_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::conflict_intensity" target="us_china_tech_rivalry::semiconductor_fab_capaci" id="191">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalating conflict disrupts production and logistics of critical inputs (e.g., semiconductor‑grade neon, specialty gases, transport routes) originating in or routed through the conflict region, causing downtime and reduced effective output at advanced fabs globally." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::conflict_intensity" target="us_china_tech_rivalry::cross_border_transfer" id="192">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising conflict intensity raises commercial and compliance risk (insurance, sanctions exposure, due diligence burdens), prompting firms, universities and intermediaries to curtail or delay cross‑border transfers of technology, tooling and tacit expertise to higher‑risk foreign partners including Chinese entities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
