          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sudden reduction in cross‑border capital flows into Asian and defence‑sensitive bond markets (driven by North Korean nuclear escalations) removes nonresident liquidity providers and raises margin/financing costs for dealers, materially reducing bond market depth and tradability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="north_korea_nuclear" />
          <attvalue for="38" value="global_financial_stress" />
