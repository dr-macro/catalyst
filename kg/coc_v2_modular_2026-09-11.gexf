      <edge source="north_korea_nuclear::missile_prod_capacity" target="russia_ukraine_war::aerial_strike_rate" id="504">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An increase in North Korea's missile production capacity enables larger, faster shipments of complete missiles and missile components to Russia, directly enlarging Russia's munitions stockpiles and permitting a higher sustained rate of missile/loitering-munition strikes in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="north_korea_nuclear" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
