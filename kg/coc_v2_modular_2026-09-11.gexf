          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained high political support among Ukraine backers further isolates Russia, prompting Moscow to deepen reciprocal military-diplomatic cooperation with Pyongyang (e.g., security consultations, coordinated messaging, barter deals), thereby raising perceived strategic alignment." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="north_korea_nuclear" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
