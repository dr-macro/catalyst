      <edge source="russia_ukraine_war::aerial_strike_rate" target="global_financial_stress::market_liquidity" id="200">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp increases in missile and drone strikes create episodic volatility and operational/settlement risks that prompt market‑makers to pull back and widen quotes, reducing bond market depth and liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
