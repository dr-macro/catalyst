          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained spike in aerial strikes raises market perceptions of near‑term supply disruption risk (via possible export chokepoint damage and escalation spillovers), prompting traders to bid up benchmark crude prices on risk‑premium adjustments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_houthi_escalation" />
