          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising cross‑border capital flows routed through North Korean/Russian networks facilitate sanctions‑evasion and liquidity transfers that augment Russian access to funds or credit for military procurement, increasing readily available resources for defense operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="north_korea_nuclear" />
