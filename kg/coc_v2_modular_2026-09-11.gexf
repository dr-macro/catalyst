          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater ease and standardization in producing offensive weapons in North Korea leads to large, low‑cost exports of drones, rockets, or munitions to Russian forces and proxies, increasing the scale and geographic spread of kinetic operations across the theater." />
