      <edge source="mid_east_gulf_escalation::nonstate_attack_activity" target="eurozone_bond_stress::sovereign_spread" id="85">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising attacks on shipping and terminals increase trade disruption and insurance costs for export‑dependent eurozone countries, prompting investors to demand wider yield spreads on sovereigns with large external financing needs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_gulf_escalation" />
          <attvalue for="38" value="eurozone_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
