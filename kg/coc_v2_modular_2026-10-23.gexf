          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.62" />
          <attvalue for="35" value="Increased attacks on shipping and terminals in Gulf and adjacent sea lanes disrupt maritime logistics, force route diversions and raise insurance costs, producing immediate shipment delays and shortages of semiconductors and critical raw-material consignments bound for AI hardware manufacturing." />
