          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened great‑power competition leads Russia to expand covert materiel, training, and intelligence support to Iran‑aligned militias and proxy groups, enabling more frequent and capable attacks on shipping and terminals." />
