      <edge source="russia_ukraine_war_diplo::regulatory_response" target="eurozone_bond_stress::fiscal_financing_pressur" id="286">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Stronger legal and sanctioning measures that restrict access to financial markets and counterparties increase borrowing costs and limit rollover options for affected governments, raising short‑to‑medium‑term fiscal financing pressure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war_diplo" />
          <attvalue for="38" value="eurozone_bond_stress" />
