          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising attacks on shipping and infrastructure by non‑state actors directly compels Turkey to expand maritime patrols, ISR deployments and interdiction operations, thereby increasing its effective maritime control capacity in the short term." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_gulf_escalation" />
          <attvalue for="38" value="turkey_regional_realignm" />
