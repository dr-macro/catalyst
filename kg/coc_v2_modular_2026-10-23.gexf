        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Intensified strategic competition among major powers forces Ankara to accelerate hedging and partnership shifts (e.g., deeper outreach to Russia, China or NATO partners) to preserve strategic autonomy and leverage, increasing the rate of regional alignment changes." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war_diplo" />
          <attvalue for="38" value="turkey_regional_realignm" />
          <attvalue for="27" value="0" />
