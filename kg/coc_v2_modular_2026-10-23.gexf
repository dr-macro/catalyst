      <edge source="russia_ukraine_war_diplo::regulatory_response" target="turkey_regional_realignm::energy_supply_risk" id="287">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Broader legal and sanctions measures tied to diplomacy over the war disrupt trade channels and contractual certainty for energy suppliers and shippers linked to the region, increasing the probability of pipeline/LNG or shipping interruptions affecting Turkey's energy flows." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war_diplo" />
          <attvalue for="38" value="turkey_regional_realignm" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war_diplo::regulatory_response" target="us_china_tech_rivalry::chip_rare_earth_supply" id="288">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rapid expansion of sanctions and export controls tied to the Russia–Ukraine conflict directly restricts suppliers and exports of advanced semiconductor equipment and certain critical materials, reducing immediate hardware availability for AI supply chains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war_diplo" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
