      <edge source="us_china_tech_rivalry::geopolitical_tension_lev" target="eurozone_bond_stress::capital_outflow_rate" id="436">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A spike in US–China tech tensions triggers immediate risk‑off and regulatory repricing (export controls, sanctions fears) that leads European institutional investors and multinational corporations to relocate liquidity and reduce exposures to European assets, raising net capital outflows from the eurozone." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="eurozone_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension_lev" target="mid_east_gulf_escalation::geopolitical_risk" id="437">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising US–China technology friction translates into heightened great‑power rivalry and public signalling that directly increases market and policymaker assessments of the probability that tensions will spill into the Gulf as proxy escalations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="mid_east_gulf_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension_lev" target="mid_east_gulf_escalation::oil_price_level" id="438">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher US–China tech tensions raise energy‑market risk premia (through fears of sanctions, shipping disruptions, and precautionary stockpiling by states), producing an almost immediate upward pressure on global oil prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="mid_east_gulf_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension_lev" target="russia_ukraine_war_diplo::great_power_pressure" id="439">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An uptick in US–China tech tensions prompts harder strategic posturing, alliance coordination and signaling among other great powers (e.g., US/EU tightening toward China, China leaning toward Russia), raising overall great-power pressure on the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="russia_ukraine_war_diplo" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension_lev" target="turkey_regional_realignm::def_dip_intensity" id="440">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising US–China geopolitical tension triggers both powers (and their partners) to increase security engagement with Turkey—more port calls, joint exercises, arms offers and bilateral defence talks—as they seek influence and reassurance, raising the scale and frequency of defence diplomacy." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="turkey_regional_realignm" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::geopolitical_tension_lev" target="turkey_regional_realignm::regional_alignment_flow" id="441">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="As US–China rivalry intensifies, Ankara faces greater competitive pressure and inducements from both sides, prompting accelerated re‑evaluations and swaps of partnerships (new agreements, strategic hedging or pivots) that increase the rate of regional alignment shifts." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="turkey_regional_realignm" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
