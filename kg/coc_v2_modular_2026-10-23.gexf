          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter FDI screening, licensing requirements, and sanctions introduced in response to war-related security concerns raise compliance costs and legal risk for cross-border investments into AI firms (notably into China-linked entities), reducing capital flows into those AI assets." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war_diplo" />
          <attvalue for="38" value="us_china_tech_rivalry" />
