          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Heightened great-power competition stemming from the conflict drives governments to increase subsidies, defense contracts, and procurement preferences for domestic tech, prompting corporations to accelerate AI R&amp;D and capital spending to capture security-driven demand." />
