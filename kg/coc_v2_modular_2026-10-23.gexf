          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in attacks on shipping and terminals prompts private operators (insurers, satellite and comms firms, shipping companies) to centralize, restrict, or harden access to their communications and tracking services to mitigate risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="mid_east_gulf_escalation" />
          <attvalue for="38" value="russia_ukraine_war_diplo" />
          <attvalue for="27" value="0" />
