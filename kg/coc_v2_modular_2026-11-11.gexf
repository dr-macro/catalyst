          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="High‑intensity congressional oversight and investigations constrain executive discretion and politicize foreign‑policy channels, reducing the frequency and scale of formal diplomatic engagement with Gulf and Iranian interlocutors." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_shift" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
