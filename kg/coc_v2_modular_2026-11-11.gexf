          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rapid reallocations of portfolios into commodity and energy exposures push up energy prices and cash flows to major hydrocarbon exporters, materially increasing those exporters' export revenue available for military procurement and sustainment, enabling higher kinetic activity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_inflation_and_rat" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
