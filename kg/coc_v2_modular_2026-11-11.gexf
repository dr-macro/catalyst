          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A rapid increase in portfolio allocations into commodity exposures or energy-linked instruments pushes futures curves and spot liquidity toward higher crude prices as funds buy oil-related contracts and storage/hedging activity rises." />
