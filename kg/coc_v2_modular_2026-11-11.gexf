        </attvalues>
      </edge>
      <edge source="us_political_shift::public_alignment" target="iran_gulf_flashpoint::diplo_engage_rate" id="834">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A rapid net shift in public preferences toward de‑escalation raises political pressure on elected officials to initiate or expand diplomatic contacts and negotiations with Gulf parties and intermediaries." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_shift" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::public_alignment" target="russia_ukraine_war::disinfo_prevalence" id="835">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Growing domestic public sympathy for narratives critical of Ukraine or supportive of disengagement increases receptive audiences and domestic amplification channels for Russian-origin disinformation, raising its overall prevalence and reach." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::public_alignment" target="us_china_tech_rivalry::media_attention_intensit" id="836">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger public alignment behind a tougher US stance on China raises audience interest and creates more newsworthy political angles, driving increased volume and persistence of media coverage on the US–China tech rivalry." />
