      <edge source="russia_ukraine_war::infra_resilience_level" target="iran_gulf_flashpoint::transit_risk_level" id="64">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Higher resilience of energy and transport infrastructure in the Russia–Ukraine theatre reduces demonstrable vulnerability and insurance/re-routing pressures, which lowers perceived shipping transit risk in the Gulf (and vice versa when resilience falls)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::infra_resilience_level" target="us_political_shift::legal_pressure_flow" id="65">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Declines in critical-infrastructure resilience attributed to conflict-related attacks or failures generate contractor liability claims, regulatory enforcement actions and litigation targeting officials, increasing legal proceedings over the medium term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
