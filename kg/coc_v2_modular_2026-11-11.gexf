      <edge source="us_political_shift::oversight_intensity" target="global_inflation_and_rat::cross_border_capital_flo" id="798">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified high-profile oversight and investigations increase perceived regulatory and political risk for foreign investors, prompting reduced new inflows and net withdrawals of cross-border capital." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_shift" />
          <attvalue for="38" value="global_inflation_and_rat" />
