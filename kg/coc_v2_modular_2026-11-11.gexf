      <edge source="russia_ukraine_war::disinfo_prevalence" target="global_inflation_and_rat::portfolio_reallocation_r" id="146">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="1" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Widespread disinformation about shortages, sanctions or bank stability increases perceived uncertainty and tail‑risk, prompting faster investor reallocation toward liquid and perceived safe assets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_inflation_and_rat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::disinfo_prevalence" target="iran_gulf_flashpoint::diplo_engage_rate" id="147">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Expanded disinformation campaigns that amplify or misattribute incidents in the Gulf increase perceived threat and ambiguity among regional and extra‑regional actors, prompting more frequent diplomatic contacts, clarifications and crisis management talks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::disinfo_prevalence" target="us_china_tech_rivalry::regulatory_scrutiny" id="148">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Widespread, adversary‑linked disinformation campaigns expose platform moderation and foreign‑influence vulnerabilities, leading regulators to open probes and increase enforcement actions against intermediaries and cross‑border data practices affecting Chinese and other firms." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::disinfo_prevalence" target="us_political_shift::public_alignment" id="149">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Coordinated false or misleading narratives about the war amplify partisan framings and entrenched cues from political leaders, increasing public alignment with competing political positions and parties." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
