        </attvalues>
      </edge>
      <edge source="us_political_shift::power_balance_stock" target="global_inflation_and_rat::long_term_gov_yield" id="754">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained shift in formal policymaking power toward a fiscal-expansionary majority raises market expectations of larger future deficits and higher term premia, directly repricing long-maturity government bonds upward." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_political_shift" />
          <attvalue for="38" value="global_inflation_and_rat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::power_balance_stock" target="iran_gulf_flashpoint::proxy_attack_rate" id="755">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A consolidation of formal policymaking power in a more hawkish executive enables quicker authorization of visible kinetic actions and naval interdictions in the Gulf, which Iran and its proxies respond to with increased indirect/deniable attacks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_shift" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::power_balance_stock" target="russia_ukraine_war::kinetic_attack_intensity" id="756">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A shift in formal power away from an executive willing/able to authorize large-scale military and financial support (e.g., stronger congressional restriction) reduces Ukraine's near-term combat sustainment and deterrence, encouraging Russia to raise the tempo and scale of kinetic operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_shift" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_shift::power_balance_stock" target="us_china_tech_rivalry::export_controls" id="757">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A concentration of formal policymaking authority in national-security-oriented executive offices enables faster issuance of restrictive export-control rules and licensing changes that tighten limits on transfers of semiconductors, AI chips, and related know‑how to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_shift" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
