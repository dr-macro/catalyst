          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Heightened congressional oversight and investigations into tech firms' China ties produce direct referrals, publicized findings, and political pressure that prompt agencies (e.g., Commerce, FTC) to open or intensify enforcement actions and supervisory reviews of affected companies." />
          <attvalue for="36" value="0-6 months" />
