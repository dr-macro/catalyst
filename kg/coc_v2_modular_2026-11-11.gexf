      <edge source="russia_ukraine_war::energy_supply_stability" target="global_inflation_and_rat::inflation_expectations" id="74">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Interruptions or volatility in Russian/Ukraine-related gas and oil flows push spot energy prices up and increase price volatility, which market participants and consumers incorporate into near-term inflation forecasts." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_inflation_and_rat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stability" target="global_inflation_and_rat::long_term_gov_yield" id="75">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sustained energy-supply disruptions raise expected future inflation and sovereign financing needs (subsidies, defense/reconstruction), increasing term premia and yields on long-maturity government bonds." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_inflation_and_rat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stability" target="iran_gulf_flashpoint::oil_price_level" id="76">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Deterioration in energy supply stability caused by the Russia–Ukraine conflict tightens physical flows and risk premia in global markets, directly pushing benchmark oil prices higher." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stability" target="us_china_tech_rivalry::ai_capital_allocation" id="77">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="More stable and predictable energy supplies reduce operational risk and projected power costs for large AI compute projects, increasing investor willingness to commit capital to AI infrastructure and firms, whereas instability drives capital away or into less energy‑intensive geographies." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stability" target="us_political_shift::policy_uncertainty" id="78">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Greater stability in energy supplies (fewer disruptions from the conflict) reduces the need for emergency legislation, tariff or sanction shifts and ad hoc interventions, thereby lowering near-term policy unpredictability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
