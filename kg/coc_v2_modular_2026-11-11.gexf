      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="global_inflation_and_rat::cross_border_capital_flo" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Short-term spikes in kinetic attacks amplify geopolitical risk and prompt non‑resident investors to withdraw capital from exposed regional markets, reducing net cross‑border inflows to those markets and altering global flow patterns." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_inflation_and_rat" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="iran_gulf_flashpoint::proxy_attack_rate" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained spikes in Russian kinetic operations increase demand for Iranian long‑range strike systems and political reciprocity, prompting Tehran to accelerate arming and tasking of Gulf proxies and thereby raising proxy attack frequency." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="us_china_tech_rivalry::export_controls" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sharp increases in battlefield kinetic activity amplify national security concerns about the military application of advanced technologies and prompt executive agencies to broaden or tighten export‑control lists and licensing enforcement on strategic components relevant to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="us_china_tech_rivalry::legislative_activity_lev" id="37">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="High‑visibility escalations spur congressional urgency and constituent pressure that translate into more hearings, bills and rapid legislative initiatives focused on tech supply‑chain security, sanctions and industrial policy with implications for US–China tech competition." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="us_political_shift::oversight_intensity" id="38">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Spikes in frontline offensives or major strikes prompt immediate congressional and executive-branch hearings, subpoenas and reviews of military aid, intelligence and procurement decisions, raising oversight activity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_political_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
