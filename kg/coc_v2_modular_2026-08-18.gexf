          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Declining defense inventories prompt governments and institutional investors to reallocate capital toward munitions, logistics and defense tech procurement, crowding out venture and growth funding for non‑defense AI ventures." />
