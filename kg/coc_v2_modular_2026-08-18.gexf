          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increased attacks degrading transport and port infrastructure in the Black Sea and surrounding corridors reduce available shipping capacity and raise freight/insurance costs, constraining global container availability and thereby reducing the volume of manufactured exports that China can deliver on existing schedules." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
