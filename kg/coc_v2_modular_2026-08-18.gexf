          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="High rates of infrastructure damage in the Russia–Ukraine theater increase demand for naval escorts, mine‑countermeasure and logistics ships in nearby waters, prompting allied navies to reassign platforms away from APAC and reducing available deployable ships." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="alliance_cred_apac" />
          <attvalue for="27" value="0" />
        </attvalues>
