      <edge source="alliance_cred_apac::external_military_provoc" target="ai_capital_governance::capital_flow_to_ai" id="752">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Spikes in external military provocations prompt governments to announce emergency funding and procurement for surveillance/defense AI and push private investors toward security‑oriented AI startups, rapidly increasing capital directed into AI development." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_cred_apac" />
          <attvalue for="38" value="ai_capital_governance" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_cred_apac::external_military_provoc" target="china_tech_trade_rivalry::trade_controls_intensity" id="753">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A spike in hostile incidents directed at alliance members produces immediate political pressure for punitive economic measures and coordinated export controls or sanctions against the perceived adversary, increasing overall trade-control intensity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_cred_apac" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_cred_apac::external_military_provoc" target="china_tech_trade_rivalry::state_export_support_int" id="754">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained external military pressure on allied economies incentivizes governments to accelerate subsidies, financing and market-support programs to bolster domestic firms and reduce vulnerability to coercive measures." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="alliance_cred_apac" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_cred_apac::external_military_provoc" target="iran_hormuz_crisis::maritime_incident_freq" id="755">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="An uptick in hostile or coercive military actions from outside the alliance (strikes, ship harassment, seizures) directly produces more attacks, interdictions, and close‑encounter incidents against commercial and naval vessels in the maritime domain." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_cred_apac" />
          <attvalue for="38" value="iran_hormuz_crisis" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_cred_apac::external_military_provoc" target="iran_hormuz_crisis::perceived_escalation_ris" id="756">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Rising external military provocations increase stakeholders' assessments that the confrontation may broaden or intensify by creating pressure for reciprocal responses and signaling willingness to escalate." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="alliance_cred_apac" />
          <attvalue for="38" value="iran_hormuz_crisis" />
          <attvalue for="27" value="0" />
