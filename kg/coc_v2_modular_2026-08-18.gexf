          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter AI regulatory scrutiny in major markets triggers near‑term policy responses (export licensing, entity listings, screening of AI transfers) that directly expand and tighten cross‑border trade controls on AI‑relevant goods, software and services." />
