          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Shortfalls in allied defense supply stocks trigger industrial policy responses—direct subsidies, export financing and diplomatic procurement support—to scale allied production and secure alternative suppliers, increasing state‑level export support focused on strategic industries and allies (and often aimed at reducing dependence on China)." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
