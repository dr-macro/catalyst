          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increase in maritime incidents raises sector and route risk premia, prompting portfolio reallocation and slowing foreign direct investment into export‑dependent manufacturing and tech sectors, producing net capital outflows or reduced inflows." />
