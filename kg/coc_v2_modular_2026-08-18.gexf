          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter regulatory scrutiny and certification requirements for AI systems (including export/control and safety testing) delay installation and fielding of new autonomy and predictive‑maintenance software, keeping ships and submarines in yards longer and reducing deployable platform stocks." />
