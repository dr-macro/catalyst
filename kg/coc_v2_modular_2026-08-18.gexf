          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Diversion of munitions, interceptors and spares to sustain operations in Ukraine reduces inventories available to support prolonged coalition operations in APAC, directly lowering operational sustainability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="alliance_cred_apac" />
