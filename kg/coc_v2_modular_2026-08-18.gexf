          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained higher incident rates drive prolonged deployments and higher operating hours for surface and subsurface units, accelerating maintenance cycles and reducing the stock of immediately available platforms." />
