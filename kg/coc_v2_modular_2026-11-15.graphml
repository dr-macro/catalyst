<edge source="global_oil_market_shift::shipping_capacity" target="china_ai_chip_rivalry::foreign_customer_exposur" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A drop in available shipping capacity forces exporters to prioritize domestic or nearby customers and cancel or delay foreign contracts, reducing the share of revenue and contractual dependence on overseas customers for Chinese AI chip vendors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_oil_market_shift</data>
  <data key="d39">china_ai_chip_rivalry</data>
</edge>
<edge source="global_oil_market_shift::shipping_capacity" target="global_bond_market_shock::market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A sudden drop in available shipping capacity for crude and refined products raises uncertainty about deliveries and inventory sufficiency, amplifying short-term price swings and cross-market volatility.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_oil_market_shift</data>
  <data key="d39">global_bond_market_shock</data>
</edge>
<edge source="global_oil_market_shift::shipping_capacity" target="iran_regional_conflict::maritime_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Reduced shipping capacity concentrates crude and product flows on fewer vessels and routes, increasing chokepoint density and the chance that a single interdiction, attack, or accident becomes a contested maritime incident.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_oil_market_shift</data>
  <data key="d39">iran_regional_conflict</data>
</edge>
<edge source="global_oil_market_shift::shipping_capacity" target="russia_ukraine_war::military_supply_rate" id="0">
