  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.72</data>
  <data key="d36">Greater agreement among allied states on responses to the Russia conflict produces coordinated policy decisions to harmonize trade restrictions and close regulatory gaps, leading to more frequent multilateral adoption of export controls covering AI chips.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_ai_chip_rivalry</data>
</edge>
