  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sudden rise in investor perceived risk in the AI chip sector triggers widespread de-risking and rebalancing across portfolios, producing spikes in realized and implied volatility in equities, FX and rates markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_ai_chip_rivalry</data>
  <data key="d39">global_bond_market_shock</data>
</edge>
<edge source="china_ai_chip_rivalry::investor_risk_perception" target="global_oil_market_shift::shipping_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A spike in investor risk perception tied to the China AI chip rivalry tightens financing and raises the cost of capital and insurance for shipowners and shipyards, delaying newbuild deliveries and forcing temporary layups that reduce available shipping capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_ai_chip_rivalry</data>
  <data key="d39">global_oil_market_shift</data>
</edge>
