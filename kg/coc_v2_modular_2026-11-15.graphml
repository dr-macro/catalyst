  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Visible reputational harm to companies identified as supplying Russia intensifies domestic political pressure in allied states and NGOs for punitive coordination, making multilateral partners more willing to agree on unified statements and measures.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_ai_chip_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
