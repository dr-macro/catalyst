<edge source="global_oil_market_shift::diesel_price_spread" target="china_ai_chip_rivalry::investor_risk_perception" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A widening diesel price spread raises logistics and operating costs for chip manufacturers and subcontractors (transport, generators, heat), increasing investors' perceived probability of margin pressure and supply-chain disruption for China-based AI chip firms.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_oil_market_shift</data>
  <data key="d39">china_ai_chip_rivalry</data>
</edge>
<edge source="global_oil_market_shift::diesel_price_spread" target="global_bond_market_shock::policy_rate_expectation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A widening diesel price spread indicates tightening in refined-fuel markets that feeds through to higher near-term consumer/transport inflation readings, leading markets to price in a higher path for short-term policy rates.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_oil_market_shift</data>
  <data key="d39">global_bond_market_shock</data>
</edge>
<edge source="global_oil_market_shift::diesel_price_spread" target="russia_ukraine_war::leverage_asymmetry" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A widening diesel price spread raises operational and import costs for the party with weaker refined‑product access (reducing its export competitiveness and fiscal flexibility), thereby eroding that party's relative bargaining power in negotiations over the conflict.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_oil_market_shift</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
