  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">An increase in available tanker/RO-RO/wagon capacity directly raises the volume and tempo at which foreign weapons, ammunition and logistical supplies can be moved into theater, speeding deliveries to forces in Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_oil_market_shift</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
