<edge source="ai_infrastructure_risk::infra_deploy_rate" target="euro_bond_fragment::sovereign_borrowing_cost" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rapid AI infrastructure rollout raises near‑term demand for capital and energy, increasing inflationary pressure and fiscal/financing needs which push sovereign yields higher.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_infrastructure_risk</data>
  <data key="d39">euro_bond_fragment</data>
</edge>
<edge source="ai_infrastructure_risk::infra_deploy_rate" target="russia_ukraine_war::satcom_availability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A faster deployment rate of AI-enabled sensors and edge processing in theater raises persistent demand for satellite backhaul and spectrum, which can congest transponder capacity and reduce the proportion of time and coverage available to other users in the conflict zone.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_infrastructure_risk</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="ai_infrastructure_risk::infra_deploy_rate" target="us_china_tech_rivalry::firm_reconfig_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rapid concentration of new AI data centers and chip capacity in particular jurisdictions prompts firms to relocate, co‑locate, or reconfigure supply chains and partnerships to secure compute access and latency advantages.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_infrastructure_risk</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
