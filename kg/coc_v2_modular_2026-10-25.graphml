<edge source="euro_bond_fragment::bond_market_volatility" target="ai_infrastructure_risk::ai_asset_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Spikes in bond-market volatility cause market makers and institutional liquidity providers to pull back and widen spreads, directly reducing depth and tradability for niche AI-linked securities and debt instruments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_bond_fragment</data>
  <data key="d39">ai_infrastructure_risk</data>
</edge>
<edge source="euro_bond_fragment::bond_market_volatility" target="us_china_tech_rivalry::geo_tension_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Spikes in European bond-market volatility politicise economic vulnerability and drive EU governments to seek clearer security alignments (notably closer coordination with the US) and more confrontational postures toward China, thereby increasing geopolitical tension between the US and China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_bond_fragment</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
