<edge source="us_iran_standoff::shipping_disruption" target="ai_infrastructure_risk::infra_deploy_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Route closures, port delays, and interdicted shipments directly delay or block delivery of servers, GPUs, networking gear and other datacenter components, slowing the rate of bringing new AI infrastructure online.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">ai_infrastructure_risk</data>
</edge>
<edge source="us_iran_standoff::shipping_disruption" target="euro_bond_fragment::bond_market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Acute interruptions to key maritime routes cause immediate investor repricing of growth and inflation prospects for Europe, producing abrupt adjustments in sovereign yields and elevated short‑term bond-market volatility.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">euro_bond_fragment</data>
</edge>
<edge source="us_iran_standoff::shipping_disruption" target="russia_ukraine_war::satcom_availability" id="0">
