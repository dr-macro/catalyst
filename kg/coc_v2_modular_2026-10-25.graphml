<edge source="us_china_tech_rivalry::export_ctrl_stringency" target="euro_bond_fragment::safe_haven_capital_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">New or tightened US export controls on key tech raise immediate cross-border investment risk perceptions and trigger portfolio shifts into perceived safe‑haven assets (e.g., German Bunds, USD Treasury proxies), increasing net safe‑haven inflows to Europe.</data>
  <data key="d37">0-6 months</data>
