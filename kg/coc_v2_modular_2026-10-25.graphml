  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sharp increases in war-risk and cargo insurance premiums raise import and replacement costs for specialized cloud providers, compressing margins and increasing short- to mid-term solvency and liquidity pressure.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">ai_infrastructure_risk</data>
</edge>
<edge source="us_iran_standoff::maritime_insurance_rate" target="russia_ukraine_war::restriction_incentives" id="0">
