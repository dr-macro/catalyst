<edge source="euro_bond_fragment::political_uncertainty_le" target="ai_infrastructure_risk::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Rising political uncertainty incentivizes legislators and regulators to pursue visible oversight and precautionary interventions on prominent technologies, increasing the frequency and intensity of AI-related reviews and enforcement actions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_bond_fragment</data>
  <data key="d39">ai_infrastructure_risk</data>
</edge>
<edge source="euro_bond_fragment::political_uncertainty_le" target="russia_ukraine_war::political_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising political uncertainty in euro-area governments (e.g., fragile coalitions or surprise policy shifts) leads officials to exert more visible, ad‑hoc demands on private satellite and telecom operators to demonstrate control or score political points, increasing the frequency and intensity of political requests on service decisions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">euro_bond_fragment</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="euro_bond_fragment::political_uncertainty_le" target="us_china_tech_rivalry::firm_reconfig_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Higher political unpredictability in Europe prompts multinational firms to accelerate relocation and restructuring of sensitive supply chains and production toward more politically stable or allied jurisdictions (including the US), increasing the rate of firm reconfiguration relevant to the US–China tech rivalry.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">euro_bond_fragment</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
