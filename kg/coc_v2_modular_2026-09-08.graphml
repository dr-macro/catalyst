<edge source="china_us_tech_trade::ai_compute_capacity" target="russia_ukraine_war::cyber_intrusion_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Greater aggregate AI compute enables faster training and deployment of models for vulnerability research, automated spear‑phishing content generation and malware obfuscation, lowering the cost and time-per-attack and thereby raising cyber intrusion rates.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_us_tech_trade</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="china_us_tech_trade::ai_compute_capacity" target="us_iran_maritime_war::maritime_security_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Greater AI compute capacity enables faster, higher‑fidelity processing of satellite, AIS and ISR sensor feeds and automated anomaly/target detection for US and allied operators, improving attribution and deterrence and lowering the expected rate of hostile maritime incidents.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_us_tech_trade</data>
  <data key="d39">us_iran_maritime_war</data>
</edge>
<edge source="china_us_tech_trade::ai_compute_capacity" target="us_iran_maritime_war::sanctions_evasion_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">Increased compute capacity allows enforcement agencies and financial institutions to run more sophisticated ML models and cross‑source analytics on payments, shipping and trade data, raising detection rates and thereby reducing successful sanctions‑evasion activity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_us_tech_trade</data>
  <data key="d39">us_iran_maritime_war</data>
</edge>
