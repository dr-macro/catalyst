<edge source="us_iran_maritime_war::maritime_blockade_degree" target="china_us_tech_trade::capital_investment_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A more intensive blockade raises shipping and insurance costs and elevates perceived geopolitical risk, prompting foreign and US investors to delay, downsize or withdraw financing for AI infrastructure projects tied to China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_war</data>
  <data key="d39">china_us_tech_trade</data>
</edge>
<edge source="us_iran_maritime_war::maritime_blockade_degree" target="global_bond_turmoil::nonbank_funding_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A tighter maritime blockade disrupts trade flows and delays export receipts, triggering margin calls and liquidity mismatches for trade-finance conduits and shadow lenders and thereby increasing nonbank funding stress.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_war</data>
  <data key="d39">global_bond_turmoil</data>
</edge>
<edge source="us_iran_maritime_war::maritime_blockade_degree" target="global_energy_shock::sovereign_asset_access" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Intensified maritime blockades and port restrictions immobilize cargo and revenue flows, prompt banks and insurers to freeze related accounts/transactions and cause custodians to withhold or seize shipments, materially reducing the ability of external claimants to access or monetize state-linked maritime assets and receipts.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_war</data>
  <data key="d39">global_energy_shock</data>
</edge>
<edge source="us_iran_maritime_war::maritime_blockade_degree" target="global_energy_shock::contract_enforceability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Widespread blockade-driven failures to perform deliveries increase force-majeure invocations, produce cross-jurisdictional disputes and discourage courts and insurers from reliably upholding remedies, lowering predictable enforceability of oil-sector contracts.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_war</data>
  <data key="d39">global_energy_shock</data>
</edge>
<edge source="us_iran_maritime_war::maritime_blockade_degree" target="russia_ukraine_war::external_security_coop" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">An intensified maritime blockade in the Middle East forces Western navies and security planners to reallocate assets and attention to regional escort and de‑confliction tasks, reducing their capacity and political bandwidth for coordinated security assistance and intelligence efforts tied to Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_war</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
