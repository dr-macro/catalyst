  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A rise in wartime cyber intrusions that exploit or reveal vulnerabilities in cloud and model‑hosting infrastructure prompts regulators to tighten security requirements and limits on foreign access to AI compute resources.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_us_tech_trade</data>
</edge>
<edge source="russia_ukraine_war::cyber_intrusion_rate" target="global_energy_shock::contract_enforceability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising cyberattacks against registries, title systems and trading platforms corrupt records and chain-of-custody evidence, directly undermining courts' and counterparties' ability to reliably adjudicate and enforce oil-sector contracts.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_energy_shock</data>
</edge>
<edge source="russia_ukraine_war::cyber_intrusion_rate" target="us_iran_maritime_war::maritime_security_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">An uptick in cyber intrusions tied to the Russia–Ukraine conflict normalizes and proliferates maritime-targeted cyber tactics (GPS/AIS spoofing, port IT attacks) and motivates copycat operations, increasing the probability and severity of hostile disruptions to commercial vessels in the US–Iran maritime theater.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_iran_maritime_war</data>
</edge>
