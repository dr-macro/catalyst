  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sustained rise in kinetic attacks in the Russia–Ukraine theater (strikes on ports, tank farms, or export infrastructure) reduces Russian and Black Sea export throughput, tightening global crude supply and raising benchmark oil prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_iran_maritime_war</data>
</edge>
