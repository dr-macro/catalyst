<edge source="russia_ukraine_war::external_security_coop" target="china_us_tech_trade::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Increased allied security coordination driven by the war produces harmonized export controls and coordinated policy actions that raise the intensity and scope of regulatory intervention targeting AI compute and cross‑border tech transfers with China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_us_tech_trade</data>
</edge>
<edge source="russia_ukraine_war::external_security_coop" target="china_us_tech_trade::capital_investment_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Stronger external security cooperation leads governments to tighten investment screening and impose sanctions/blacklists that directly block or deter Chinese M&amp;A and capital flows into US/allied AI infrastructure, reducing cross‑border capital_investment_ai from China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">china_us_tech_trade</data>
</edge>
<edge source="russia_ukraine_war::external_security_coop" target="global_bond_turmoil::nonbank_funding_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intensified external security cooperation that broadens coordinated sanctions and compliance measures raises counterparty and settlement risk for nonbank institutions (MMFs, brokers, shadow banks), increasing funding frictions and roll‑over stress in those channels.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_bond_turmoil</data>
</edge>
<edge source="russia_ukraine_war::external_security_coop" target="global_energy_shock::contract_enforceability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Tighter coordinated security cooperation among external partners produces synchronized sanctions, asset freezes and cross-border legal actions that invalidate, suspend or complicate the enforcement of commercial oil contracts with targeted entities.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_energy_shock</data>
</edge>
<edge source="russia_ukraine_war::external_security_coop" target="us_iran_maritime_war::maritime_blockade_degree" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Heightened external security cooperation (NATO/US force posture shifts to reinforce Europe) prompts redeployment of Western naval assets away from the Middle East, creating security gaps that Iran can exploit to impose de facto restrictions or harassment of shipping, increasing blockade-like disruption.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_iran_maritime_war</data>
</edge>
