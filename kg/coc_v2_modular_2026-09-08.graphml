<edge source="global_bond_turmoil::nominal_treasury_yields" target="china_us_tech_trade::capital_investment_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A sustained rise in nominal Treasury yields increases discount rates and borrowing costs for US and Chinese tech firms and their investors, making large, long‑duration AI infrastructure projects less financially attractive and prompting near‑term capex cuts.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_turmoil</data>
  <data key="d39">china_us_tech_trade</data>
</edge>
<edge source="global_bond_turmoil::nominal_treasury_yields" target="russia_ukraine_war::wartime_funding_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained rises in Treasury yields increase borrowing costs and projected debt‑service burdens for US and European governments, tightening fiscal room and lowering politically feasible levels of direct military and macro‑financial support for Ukraine.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_bond_turmoil</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_bond_turmoil::nominal_treasury_yields" target="us_iran_maritime_war::oil_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising nominal U.S. Treasury yields typically strengthen the dollar and increase the discount rate applied to future commodity cash flows, exerting downward pressure on crude oil prices in the near term.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_turmoil</data>
  <data key="d39">us_iran_maritime_war</data>
</edge>
