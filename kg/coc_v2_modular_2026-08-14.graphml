  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">An increase in maritime_attack_intensit raises energy/transport volatility and macroeconomic uncertainty, complicating central banks' inflation and growth forecasts and therefore increasing perceived monetary policy risk and uncertainty about timing/intensity of interventions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">bond_inflation_shock</data>
