<edge source="russia_ukraine_war::fuel_supply_flow" target="bond_inflation_shock::inflation_surprise_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A rise in fuel_supply_flow (i.e., restored/greater fuel shipments through the region) lowers wholesale and transport fuel prices, causing realized inflation to come in below prior market forecasts and thus reducing the inflation surprise rate.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">bond_inflation_shock</data>
</edge>
