<edge source="russia_ukraine_war::shipping_transit_volume" target="bond_inflation_shock::crossborder_capital_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in shipping_transit_volume boosts trade activity and trade-finance settlements and reduces shipping/insurance risk premia, prompting higher cross-border portfolio and trade-related capital flows into affected corridors and instruments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">bond_inflation_shock</data>
</edge>
<edge source="russia_ukraine_war::shipping_transit_volume" target="brics_global_realignment::alternative_payment_link" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained drops in commercial transit through key routes force exporters and importers to set up bilateral clearing arrangements and routings outside standard correspondent‑bank pipelines, accelerating adoption and integration of non‑SWIFT/alternative payment channels.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">brics_global_realignment</data>
</edge>
<edge source="russia_ukraine_war::shipping_transit_volume" target="us_iran_maritime_standof::chokepoint_throughput" id="0">
