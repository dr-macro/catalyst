</edge>
<edge source="brics_global_realignment::alignment_with_alternati" target="bond_inflation_shock::monetary_policy_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rapid shift toward alternative geopolitical alignments alters reserve usage, trade invoicing and bilateral financial arrangements, creating strategic uncertainty about central-bank interventions, reserve management and capital-control responses and thus raising perceived monetary policy risk.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">brics_global_realignment</data>
  <data key="d39">bond_inflation_shock</data>
</edge>
<edge source="brics_global_realignment::alignment_with_alternati" target="us_china_tech_rivalry::regulatory_stringency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A visible shift by BRICS toward alternative geopolitical alignments prompts the US and allied governments to broaden export controls, investment screening and AI oversight on tech ties with aligned partners, increasing regulatory stringency in the US–China tech rivalry.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">brics_global_realignment</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="brics_global_realignment::alignment_with_alternati" target="us_iran_maritime_standof::hostile_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A faster BRICS-alignment by Iran's partners (training, arms transfers, intelligence sharing and diplomatic backing) increases Iran's operational capacity and political willingness to conduct or authorize more maritime harassment and seizures in the Gulf, raising the rate of hostile incidents.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">brics_global_realignment</data>
  <data key="d39">us_iran_maritime_standof</data>
</edge>
