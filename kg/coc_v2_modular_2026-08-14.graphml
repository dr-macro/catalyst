<edge source="us_iran_maritime_standof::maritime_interdiction" target="bond_inflation_shock::crossborder_capital_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">An escalation in maritime_interdiction (more frequent interdiction operations) raises regional geopolitical and trade risk, prompting non‑resident investors to withdraw portfolio capital from exposed markets and reallocate into safe‑haven assets, reducing net cross‑border inflows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_standof</data>
  <data key="d39">bond_inflation_shock</data>
</edge>
<edge source="us_iran_maritime_standof::maritime_interdiction" target="brics_global_realignment::alternative_payment_link" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained interdiction by US or US-backed forces raises perceived vulnerability of dollar-cleared maritime trade, pushing BRICS central banks and major exporters to accelerate deployment and bilateral use of non‑SWIFT/alternative settlement channels to preserve trade flows.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_iran_maritime_standof</data>
  <data key="d39">brics_global_realignment</data>
</edge>
<edge source="us_iran_maritime_standof::maritime_interdiction" target="russia_ukraine_war::maritime_attack_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained increases in US–Iran maritime interdiction drive US/NATO naval and air assets to redeploy toward the Gulf, creating temporary gaps in Western maritime presence and deterrence in the Black Sea that Russia can exploit to raise the tempo of attacks on shipping there.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_standof</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
