<edge source="us_iran_maritime_standof::hostile_incident_rate" target="bond_inflation_shock::monetary_policy_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained increase in hostile_incident_rate (more attacks/seizures) heightens uncertainty about the persistence of supply disruptions and growth impacts, complicating central bank reaction functions and increasing perceived uncertainty about the timing and intensity of monetary policy.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_standof</data>
  <data key="d39">bond_inflation_shock</data>
</edge>
<edge source="us_iran_maritime_standof::hostile_incident_rate" target="brics_global_realignment::sanctions_evasion_capaci" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A higher rate of attacks and seizures creates immediate operational disruptions that incentivize states and firms within BRICS to build and fund covert logistics, opaque intermediaries, and legal/financial workarounds to keep sanctioned or at‑risk trade moving.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_standof</data>
  <data key="d39">brics_global_realignment</data>
</edge>
<edge source="us_iran_maritime_standof::hostile_incident_rate" target="brics_global_realignment::alignment_with_alternati" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Repeated hostile maritime incidents increase perceived reliance risk on Western security frameworks, prompting BRICS governments to deepen military-diplomatic and logistical ties with alternative security partners to diversify protection of sea lines of communication.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_iran_maritime_standof</data>
  <data key="d39">brics_global_realignment</data>
</edge>
<edge source="us_iran_maritime_standof::hostile_incident_rate" target="russia_ukraine_war::drone_strike_frequency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">A spike in hostile incidents against shipping attributable to the US–Iran standoff incentivizes Iran (and its proxies) to accelerate transfer and operational support of UAVs to Russia as reciprocal leverage, enabling higher drone strike rates in the Russia–Ukraine theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_standof</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_iran_maritime_standof::hostile_incident_rate" target="us_china_tech_rivalry::regulatory_stringency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A rising rate of hostile maritime incidents creates a near-term national‑security pretext that prompts U.S. policymakers to tighten export controls and related regulatory measures against competitors, increasing overall regulatory stringency in the U.S.–China tech rivalry.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_maritime_standof</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
