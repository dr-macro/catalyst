<edge source="bond_inflation_shock::crossborder_capital_flow" target="brics_global_realignment::currency_and_capital_sta" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Sharp net capital outflows driven by a bond/inflation shock drain FX reserves and liquidity in BRICS markets, producing exchange‑rate pressure and forcing emergency capital controls or large nominal depreciations that reduce currency and capital stability.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">bond_inflation_shock</data>
  <data key="d39">brics_global_realignment</data>
</edge>
<edge source="bond_inflation_shock::crossborder_capital_flow" target="russia_ukraine_war::maritime_attack_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A decline in cross-border capital flows reduces shipowners' and insurers' liquidity to pay for private security, higher-risk routing or elevated premiums, leaving vessels more exposed and increasing the rate of maritime attacks.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">bond_inflation_shock</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="bond_inflation_shock::crossborder_capital_flow" target="us_china_tech_rivalry::data_center_capacity" id="0">
