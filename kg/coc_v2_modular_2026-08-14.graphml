  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A spike in maritime attacks crystallizes national‑security narratives and evidentiary links to hostile actors, prompting governments (especially the US) to tighten export controls, sanctions screening and security‑related AI policy toward China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
