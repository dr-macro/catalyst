  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Acute reductions in regional fuel shipments raise import bills and energy-price volatility for fuel‑importing BRICS economies, worsening current‑account balances and prompting exchange‑rate pressure and short‑term capital outflows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">brics_global_realignment</data>
</edge>
