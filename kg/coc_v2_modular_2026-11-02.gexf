          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Higher maritime security incidents (attacks, seizures, blockades) directly interrupt tanker movements and pipeline feeder logistics, causing measurable disruptions to energy supply chains and delivery timetables into Europe and adjacent markets." />
