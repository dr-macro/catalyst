          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A material rise in the energy component of inflation pushes headline and near‑term inflation expectations higher, prompting monetary authorities to raise policy rates to re-anchor expectations and tighten financial conditions." />
