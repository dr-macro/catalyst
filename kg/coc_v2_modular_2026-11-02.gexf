          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising China–West tensions force some states to recalibrate trade and political ties with China, fracturing unanimity in multilateral forums and weakening coordinated diplomatic pressure and support streams related to the Russia–Ukraine conflict." />
