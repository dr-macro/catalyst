          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Widening sovereign spreads raise debt‑service and rollover costs, forcing regional governments and potential mediators to reallocate scarce fiscal and political capital away from active mediation and diplomatic outreach in the Gulf." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="us_iran_gulf_conflict" />
