          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained rise in crude prices shifts net capital toward oil‑exporting jurisdictions and forces net outflows from oil‑importing economies to pay higher import bills, reducing cross‑border inflows (or increasing outflows) for importers." />
