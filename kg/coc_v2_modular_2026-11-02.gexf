          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute stress in bank funding markets dries up trade finance and reduces insurers' and brokers' liquidity/credit lines, prompting shipowners and underwriters to treat Gulf routes as higher-risk and raise premiums or reroute cargoes." />
