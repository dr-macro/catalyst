      <edge source="monetary_policy_shock::bank_funding_stress" target="russia_ukraine_war::arms_transfer_volume" id="739">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Acute bank funding stress raises the cost and availability constraints on trade finance and letters of credit used by defence contractors and intermediaries, causing immediate delays, cancellations or non‑execution of weapons and munitions shipments into the conflict zone." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
