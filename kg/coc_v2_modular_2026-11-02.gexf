      <edge source="monetary_policy_shock::sovereign_spread_level" target="global_energy_shock::upstream_prod_rate" id="655">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher sovereign spreads in oil‑exporting jurisdictions raise sovereign and state‑owned enterprise borrowing costs and constrain budgeted upstream capex and maintenance, leading to lower production rates as projects are delayed or curtailed." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="global_energy_shock" />
          <attvalue for="28" value="0" />
