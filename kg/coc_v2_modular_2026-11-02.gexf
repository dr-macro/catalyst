          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Widening sovereign spreads raise government financing costs and reduce fiscal space for subsidies and guarantees that underpin state‑backed semiconductor capacity expansions, causing postponement or cancellation of planned fabs and reducing capacity growth." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="china_west_rivalry" />
          <attvalue for="28" value="0" />
