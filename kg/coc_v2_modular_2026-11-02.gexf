      <edge source="russia_ukraine_war::kinetic_conflict_intensi" target="global_energy_shock::shipping_security_risk" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Higher levels of strikes, missile and drone activity and interdictions directly increase incidents and credible threats to tankers and LNG carriers, raising insurance, convoy requirements and rerouting that constitute higher measured maritime security risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_conflict_intensi" target="global_energy_shock::crude_oil_price" id="35">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Escalating kinetic activity raises immediate market risk premia and heightens the probability of near‑term supply losses (through damage or export disruptions), driving spot and futures crude prices up." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_conflict_intensi" target="monetary_policy_shock::cross_border_flows" id="36">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="An increase in kinetic military intensity raises immediate operational and political risk (including insurance, logistics and sanctions risk), prompting foreign investors and banks to withdraw funds, suspend new lending and repatriate capital, thereby reducing net cross‑border flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="monetary_policy_shock" />
          <attvalue for="28" value="0" />
