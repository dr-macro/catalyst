          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Surges in arms transfers elevate cross‑border payments through sanctioned or opaque channels and concentrate counterparty exposure in certain banks, raising correspondent‑bank risk and liquidity hoarding which increases wholesale funding stress." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="monetary_policy_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
