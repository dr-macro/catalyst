      <edge source="monetary_policy_shock::policy_interest_rate" target="china_west_rivalry::capital_funding_flow" id="687">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An increase in policy interest rates raises discount rates and borrowing costs, prompting global investors and lenders to cut risk capital and cross‑border credit to Chinese and China‑exposed AI firms, reducing capital funding flows into those activities." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="china_west_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="monetary_policy_shock::policy_interest_rate" target="china_west_rivalry::chip_supply_capacity" id="688">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher policy rates increase the cost of debt and equity for capital‑intensive semiconductor projects, leading firms and financiers to delay or downscale fab investments and equipment orders, lowering chip supply capacity over the medium term." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="china_west_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="monetary_policy_shock::policy_interest_rate" target="global_energy_shock::crude_oil_price" id="689">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained rise in policy interest rates in major economies reduces aggregate demand and borrowing‑dependent consumption/investment and often strengthens the currency, lowering physical oil demand and exerting downward pressure on global crude prices within a few months." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="global_energy_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="monetary_policy_shock::policy_interest_rate" target="russia_ukraine_war::arms_transfer_volume" id="690">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A sustained rise in policy interest rates increases debt‑service costs and tightens fiscal space for donor governments, prompting slower approvals, reduced export credit support, or postponement of budgeted military aid deliveries which lowers arms transfer volumes to the theatre." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
