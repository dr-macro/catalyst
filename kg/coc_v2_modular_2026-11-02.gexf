      <edge source="russia_ukraine_war::arms_transfer_volume" target="china_west_rivalry::export_control_intensity" id="55">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rapid increases in arms transfers and discovery of Western-origin or dual-use components in fielded Russian systems prompt Western governments to widen and tighten export controls on dual‑use tech and components, including measures that extend to suppliers and end‑users linked to China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_west_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::arms_transfer_volume" target="global_energy_shock::refined_fuel_price" id="56">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Larger flows of weapons and associated logistics increase military consumption of diesel/jet fuel and create congestion at ports and logistics hubs, tightening local commercial refined‑fuel availability and pushing wholesale/retail prices higher." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::arms_transfer_volume" target="monetary_policy_shock::bank_funding_stress" id="57">
