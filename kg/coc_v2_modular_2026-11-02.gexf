          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Widening sovereign spreads among coalition states increases domestic economic and political pressure to prioritize fiscal stabilization, making governments more reluctant to sustain costly coordinated sanctions, financial support, or unified diplomatic stances and thereby reducing diplomatic cohesion." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_policy_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="monetary_policy_shock::sovereign_spread_level" target="us_iran_gulf_conflict::diplomatic_engagement_in" id="657">
