          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Escalating China–West political and geoeconomic tensions raise perceived country and policy risk for states tied to either bloc, prompting investors to demand higher risk premia and widening sovereign bond spreads." />
