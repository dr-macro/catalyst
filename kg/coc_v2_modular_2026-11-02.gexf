          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained escalation drives operators and host authorities to curtail production, evacuate personnel, delay maintenance and investment, and order shut‑ins in exposed fields, reducing upstream output volumes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="39" value="global_energy_shock" />
