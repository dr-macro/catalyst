          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Growing escalation momentum in the Gulf creates windows where US and allied attention and political will are constrained, which Russia can interpret as lowered risk of coordinated Western escalation and thus raises its incentives to escalate in Ukraine." />
