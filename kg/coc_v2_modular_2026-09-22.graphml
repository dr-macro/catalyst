<edge source="iran_gulf_escalation::state_military_response_" target="ai_governance_militar::safety_engineering_effor" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalated state military operations create urgent requirements for reliable, hardened AI capabilities, prompting defense budgets and acquisition programs to allocate more resources to safety, robustness testing and hardening projects.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">ai_governance_militar</data>
</edge>
<edge source="iran_gulf_escalation::state_military_response_" target="energy_supply_shock::pipeline_transit_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">State strikes, seizures or security operations targeting pipeline corridors, pumping stations or access roads force temporary shutdowns or reduced operating capacity, lowering transit volumes through pipelines.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">energy_supply_shock</data>
</edge>
<edge source="iran_gulf_escalation::state_military_response_" target="russia_ukraine_war::military_ops_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intensified state military responses by the US and partners in the Gulf consume precision munitions, ISR and logistics capacity and prompt temporary reallocation of shipments and stocks that delays or reduces deliveries of long‑range strike and air‑defense systems to Ukraine, degrading Kyiv's ability to blunt Russian offensives and enabling higher Russian operational tempo.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
