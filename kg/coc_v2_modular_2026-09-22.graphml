<edge source="us_china_trade_tech::export_control_level" target="ai_governance_militar::model_capability_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Tighter export controls legally block shipments of high-end accelerators, training hardware and specialized design tools, directly reducing the training throughput and peak scale of models available to affected developers.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_trade_tech</data>
  <data key="d39">ai_governance_militar</data>
</edge>
<edge source="us_china_trade_tech::export_control_level" target="ai_governance_militar::cyberattack_frequency" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">When legal transfer channels are restricted, state and non‑state actors have stronger incentives to pursue illicit acquisition via cyberespionage and supply‑chain intrusion, raising successful attacks against AI infrastructure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_trade_tech</data>
  <data key="d39">ai_governance_militar</data>
</edge>
<edge source="us_china_trade_tech::export_control_level" target="energy_supply_shock::refinery_throughput_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter export controls on specialized refinery catalysts, control electronics and spare parts reduce import-dependent refineries' ability to maintain and replace critical components, causing measurable declines in processing rates as inventories of spares are exhausted.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_trade_tech</data>
  <data key="d39">energy_supply_shock</data>
</edge>
<edge source="us_china_trade_tech::export_control_level" target="iran_gulf_escalation::maritime_trade_disruptio" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tightened US export controls on dual‑use maritime and aerospace technologies incentivize China to deepen security ties and expedite transfers of asymmetric maritime capabilities to partners like Iran, raising incidents of harassment, interdiction and risk to commercial shipping in Gulf sea lanes.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_trade_tech</data>
  <data key="d39">iran_gulf_escalation</data>
</edge>
<edge source="us_china_trade_tech::export_control_level" target="russia_ukraine_war::military_ops_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter export controls on advanced semiconductors and sensors reduce availability of critical components that would otherwise be re-exported or procured for Russian guided munitions, drones and ISR systems, degrading Russia's ability to sustain high-tempo operations.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_trade_tech</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
