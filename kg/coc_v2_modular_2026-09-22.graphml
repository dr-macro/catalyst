  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.8</data>
  <data key="d36">Damage and outages to energy production and transmission degrade data‑center uptime and edge connectivity in affected areas, directly slowing the rate at which new or updated AI models and services can be deployed and scaled.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">ai_governance_militar</data>
</edge>
<edge source="russia_ukraine_war::energy_infra_disruption" target="energy_supply_shock::refinery_throughput_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Kinetic damage, power loss or operational interruptions at refineries and associated utilities directly reduces processing capacity and forces shutdowns or lower runs.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">energy_supply_shock</data>
</edge>
<edge source="russia_ukraine_war::energy_infra_disruption" target="energy_supply_shock::pipeline_transit_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Physical attacks or sabotage to pipeline segments, pumping stations and terminals force immediate pump-stops and route closures, cutting volumes transiting the network.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">energy_supply_shock</data>
</edge>
<edge source="russia_ukraine_war::energy_infra_disruption" target="iran_gulf_escalation::maritime_trade_disruptio" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Disruption to Russian/European energy infrastructure shifts crude and refined product flows onto Middle Eastern suppliers, increasing tanker transits and chokepoint traffic through the Strait of Hormuz and thereby raising congestion, insurance/escorting requirements and the incidence of maritime trade interruptions in the Gulf.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_gulf_escalation</data>
</edge>
<edge source="russia_ukraine_war::energy_infra_disruption" target="us_china_trade_tech::rare_earth_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widespread outages and damage to energy supply and transport infrastructure reduce output and processing capacity at mines/refineries and raise shipping/insurance costs, directly lowering the volume of critical‑mineral shipments flowing through the bilateral corridor.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_trade_tech</data>
</edge>
