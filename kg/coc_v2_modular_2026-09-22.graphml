  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Attacks and interdictions in the Gulf raise insurance, force ship diversions and port delays, directly reducing the volume and frequency of critical-mineral shipments traversing the US–China shipping corridor.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">us_china_trade_tech</data>
</edge>
