<edge source="energy_supply_shock::pipeline_transit_rate" target="ai_governance_militar::model_capability_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Restored or increased pipeline transit stabilizes local power/fuel supplies for datacenters and on‑premise training facilities, allowing paused or curtailed large-scale model training and compute‑intensive development to resume, raising aggregate deployed model capability.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">energy_supply_shock</data>
  <data key="d39">ai_governance_militar</data>
</edge>
<edge source="energy_supply_shock::pipeline_transit_rate" target="iran_gulf_escalation::maritime_trade_disruptio" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Increases in pipeline transit capacity/throughput shift volumes off sea routes, reducing tanker congestion and target density and thus lowering the risk and severity of maritime trade disruption.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_supply_shock</data>
  <data key="d39">iran_gulf_escalation</data>
</edge>
<edge source="energy_supply_shock::pipeline_transit_rate" target="russia_ukraine_war::energy_infra_disruption" id="0">
