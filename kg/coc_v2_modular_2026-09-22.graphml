  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Higher levels of commercial fuel inventories reduce immediate supply anxiety among importers and exporters, decreasing the frequency and urgency of high-level diplomatic contacts and emergency negotiations over Gulf security.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_supply_shock</data>
  <data key="d39">iran_gulf_escalation</data>
</edge>
<edge source="energy_supply_shock::storage_inventory_level" target="us_china_trade_tech::export_control_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A sharp drawdown in commercial and strategic fuel inventories prompts authorities to tighten legal and administrative export restrictions on energy-related goods and associated dual-use technologies to conserve supplies and prevent outward flows to strategic competitors such as China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_supply_shock</data>
  <data key="d39">us_china_trade_tech</data>
