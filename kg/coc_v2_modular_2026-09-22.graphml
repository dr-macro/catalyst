  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Interruptions and rerouting of shipping delay or block delivery of high‑end GPUs, cooling systems and other datacenter hardware, directly reducing available training capacity and thus achievable model capability in the near term.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">ai_governance_militar</data>
</edge>
<edge source="iran_gulf_escalation::maritime_trade_disruptio" target="energy_supply_shock::crude_export_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Physical interdiction of tankers, attacks on ports/terminals and the imposition of de facto no-go zones prevent crude cargoes from loading or reaching export routes, directly reducing export volumes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">energy_supply_shock</data>
</edge>
<edge source="iran_gulf_escalation::maritime_trade_disruptio" target="energy_supply_shock::fuel_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Increased interdiction and rerouting raise freight costs, insurance premiums and delivery times for refined products and marine bunkers, producing an immediate risk/freight-driven uplift in spot fuel prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_escalation</data>
  <data key="d39">energy_supply_shock</data>
</edge>
