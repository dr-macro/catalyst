  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A faster, larger wave of China/EU industrial and trade policies (export controls, subsidies, procurement rules) prompts counterpart regulators and competition authorities worldwide to open investigations and tighten oversight of AI supply chains and deployments on national-security and economic‑sovereignty grounds.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">china_eu_industrial_riva</data>
  <data key="d39">global_ai_market_cycle</data>
</edge>
<edge source="china_eu_industrial_riva::policy_response_momentum" target="middle_east_maritime_con::market_risk_premium" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Rapid introduction or escalation of trade/industrial measures (tariffs, export controls, investment screening) raises near-term supply‑chain and geopolitical uncertainty, prompting traders, insurers and lenders to demand higher risk premia in energy and shipping markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_eu_industrial_riva</data>
  <data key="d39">middle_east_maritime_con</data>
</edge>
