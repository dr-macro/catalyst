  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained surge of global capital into AI startups and infrastructure diverts cross‑border investor allocations away from capital‑intensive vehicle manufacturing and supply‑chain projects, reducing net foreign investment into auto plants and related assets in China/EU.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">china_eu_industrial_riva</data>
</edge>
<edge source="global_ai_market_cycle::funding_flow_to_ai" target="russia_ukraine_war::allied_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increased funding for AI accelerates joint R&amp;D, interoperable tools and public‑private consortia among partner states, creating shared capabilities and procurement pathways that reinforce political and operational alignment among allies.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
