<edge source="global_ai_market_cycle::deployment_rate_models" target="china_eu_industrial_riva::localisation_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Faster deployment of ready‑made, foreign AI driving stacks incentivizes OEMs to integrate those external platforms rather than develop or source equivalent local systems, lowering the share of locally produced software/hardware content.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">china_eu_industrial_riva</data>
</edge>
<edge source="global_ai_market_cycle::deployment_rate_models" target="middle_east_maritime_con::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">Faster deployment of advanced models lowers the cost and increases accuracy of autonomous maritime drones, remote targeting and coordination tools that non‑state actors can field, enabling more frequent and effective attacks on commercial vessels.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">middle_east_maritime_con</data>
</edge>
<edge source="global_ai_market_cycle::deployment_rate_models" target="russia_ukraine_war::fuel_reroute_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Faster deployment of advanced AI models into maritime monitoring, AIS anomaly detection and trade‑flow analytics improves identification of covert ship‑to‑ship transfers and routing anomalies, reducing the speed and success rate of illicit fuel rerouting around sanctions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_ai_market_cycle::deployment_rate_models" target="us_political_alliance_st::scandal_revelation_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Faster and broader deployment of advanced models increases the incidence of operational failures, privacy leaks, and harmful outputs which produce concrete allegations and damaging disclosures entering public and legal channels.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">us_political_alliance_st</data>
