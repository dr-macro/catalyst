  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Stricter enforcement of sanctions on Russian crude compels buyers to substitute volumes by purchasing more Middle Eastern crude, directly increasing Middle East export flows to fill displaced supply.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">middle_east_maritime_con</data>
</edge>
