<edge source="global_ai_market_cycle::infra_valuation_index" target="china_eu_industrial_riva::policy_response_momentum" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rapidly rising valuations of dominant AI‑infrastructure firms signal concentrated foreign control of critical tech inputs, prompting policymakers in China and the EU to accelerate trade and industrial policy proposals (subsidies, local content rules, export controls) to protect domestic industry.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">china_eu_industrial_riva</data>
</edge>
