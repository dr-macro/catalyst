  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Heightened regulatory scrutiny of AI in major jurisdictions creates reputational and competitive pressure that accelerates domestic policymaking in China and the EU (e.g., faster drafting of industrial support or protective rules) to shield national automakers and suppliers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">china_eu_industrial_riva</data>
</edge>
<edge source="global_ai_market_cycle::regulatory_scrutiny" target="russia_ukraine_war::sanctions_enforcement" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Ramped regulatory scrutiny of AI and dual‑use tech prompts governments and export control agencies to codify tighter controls and compliance obligations (including expanded screening and licensing), directly increasing the strictness and operational enforcement of sanctions regimes against actors like Russia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_ai_market_cycle</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
