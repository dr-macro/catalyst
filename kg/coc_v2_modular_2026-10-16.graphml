  <data key="d36">An uptick in sanctions enforcement prompts governments to broaden export controls, compliance checks and oversight on dual‑use technologies, directly increasing regulatory attention on AI development and transfers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_ai_market_cycle</data>
</edge>
<edge source="russia_ukraine_war::sanctions_enforcement" target="global_ai_market_cycle::investor_risk_aversion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Stricter sanctions raise counterparty, compliance and geopolitical risk for firms working on AI, causing investors to demand higher risk premia or reduce exposure to AI assets in affected markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_ai_market_cycle</data>
</edge>
<edge source="russia_ukraine_war::sanctions_enforcement" target="middle_east_maritime_con::crude_export_flow" id="0">
