<edge source="middle_east_maritime_con::maritime_attack_rate" target="china_eu_industrial_riva::policy_response_momentum" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">A visible surge in attacks on commercial shipping generates immediate political pressure and security briefs that prompt lawmakers and executives to propose and fast‑track trade, industrial‑security and supply‑chain resilience measures.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_maritime_con</data>
  <data key="d39">china_eu_industrial_riva</data>
</edge>
<edge source="middle_east_maritime_con::maritime_attack_rate" target="global_ai_market_cycle::infra_valuation_index" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in attacks on commercial shipping disrupts shipments of semiconductors, servers and rack equipment, causing delivery delays and cost overruns that depress near-term revenue/profit forecasts for AI infrastructure providers and lower their market valuations.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_maritime_con</data>
  <data key="d39">global_ai_market_cycle</data>
</edge>
<edge source="middle_east_maritime_con::maritime_attack_rate" target="russia_ukraine_war::diesel_export_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating attacks on tankers and offshore facilities prompt shippers, charterers and insurers to suspend or limit voyages from the region, immediately reducing diesel shipments to international markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_maritime_con</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="middle_east_maritime_con::maritime_attack_rate" target="us_political_alliance_st::media_scrutiny_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Spikes in attacks on commercial vessels generate immediate incident-driven coverage and investigative reporting focused on government policy and military response, increasing overall media scrutiny.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_maritime_con</data>
  <data key="d39">us_political_alliance_st</data>
</edge>
