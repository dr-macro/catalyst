          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sudden rise in standoff escalation triggers a flight-to-quality and order imbalances that concentrate trading in on-the-run Treasuries, overwhelming dealer inventories and market‑making capacity and widening bid/ask spreads, thereby reducing secondary‑market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="north_korea_standoff" />
          <attvalue for="38" value="us_treasury_market_stres" />
