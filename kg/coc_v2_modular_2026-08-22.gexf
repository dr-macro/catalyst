          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A jump in perceived supply disruption risk (energy/shipping) raises volatility and margin calls, leading dealers and repo lenders to tighten haircuts and pull back unsecured/secured funding, directly reducing short‑term funding liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="us_treasury_market_stres" />
