      <edge source="tech_semiconductor_rival::trade_controls_ai" target="russia_ukraine_war::missile_attack_rate" id="590">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stricter export controls that block advanced semiconductors and specialized AI chips to Russian defense contractors reduce the availability of guidance, seeker and flight‑control electronics for cruise/precision missiles, lowering the number of serviceable munitions Russia can produce and launch." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="tech_semiconductor_rival" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_semiconductor_rival::trade_controls_ai" target="us_iran_confrontation::sanctions_enforcement" id="591">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="When governments tighten AI export controls they typically fold new licensing requirements and interdiction priorities into existing sanctions apparatuses, prompting more investigations, cross‑border compliance checks and punitive actions against shipments to Iran." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_semiconductor_rival" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_semiconductor_rival::trade_controls_ai" target="us_iran_confrontation::trade_rerouting_rate" id="592">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="More restrictive AI export rules make direct legal supply to sanctioned destinations harder, causing exporters and buyers to route consignments through intermediary jurisdictions and transshipment networks to evade controls." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_semiconductor_rival" />
          <attvalue for="38" value="us_iran_confrontation" />
          <attvalue for="27" value="0" />
