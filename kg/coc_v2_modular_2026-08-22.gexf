      <edge source="us_iran_confrontation::supply_risk_perception" target="north_korea_standoff::diplomatic_engagement" id="93">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increased perception of supply‑disruption risk spurs emergency consultations and crisis diplomacy among the US, Japan, South Korea and regional partners to secure routes and reassure markets, boosting the intensity and frequency of formal diplomatic engagement." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="north_korea_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::supply_risk_perception" target="russia_ukraine_war::missile_attack_rate" id="94">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened perceived risk of Middle Eastern oil/gas supply disruptions pushes global energy prices up, boosting Russia's fiscal receipts and short‑term war‑financing capacity and thereby enabling higher tempo of missile/strike operations in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::supply_risk_perception" target="tech_semiconductor_rival::ai_hardware_capital_flow" id="95">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising perceived risk of supply disruption from US–Iran confrontation pushes firms and investors to allocate capital toward onshore or diversified AI hardware capacity (chips, inventory, domestic fabs or cloud hardware) as a risk‑mitigation and resilience investment." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="tech_semiconductor_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::supply_risk_perception" target="us_treasury_market_stres::short_term_funding_liqui" id="96">
