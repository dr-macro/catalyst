      <edge source="us_treasury_market_stres::central_bank_ops" target="north_korea_standoff::alliance_cohesion" id="411">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="If the Federal Reserve tightens or reverses asset purchases to stabilize Treasury markets, Washington is likely to curtail or reprioritize costly bilateral and multilateral security support (including timing/scale of swap‑line assistance and funded exercises), producing coordination frictions with Seoul and Tokyo." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_market_stres" />
          <attvalue for="38" value="north_korea_standoff" />
