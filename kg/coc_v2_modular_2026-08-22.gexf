      <edge source="russia_ukraine_war::missile_attack_rate" target="tech_semiconductor_rival::robotics_deployment_rate" id="241">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increased tempo of missile strikes raises demand for remote, explosive‑ordnance and reconnaissance robots for inspection, repair and force protection, accelerating procurement and field deployments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="tech_semiconductor_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
