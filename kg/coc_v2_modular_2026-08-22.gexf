      <edge source="russia_ukraine_war::missile_attack_rate" target="north_korea_standoff::deterrence_credibility" id="240">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A high tempo of Russian ballistic/cruise strikes that demonstrate ability to overwhelm or bypass allied air defenses lowers regional perceptions that US/ROK missile defenses would reliably stop a large DPRK salvo, reducing deterrence credibility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="north_korea_standoff" />
          <attvalue for="27" value="0" />
