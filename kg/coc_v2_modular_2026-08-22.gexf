          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Reduced short‑term funding availability forces component suppliers and contract manufacturers to cut inventory purchases and production smoothing, producing shipment bottlenecks and lengthening end‑to‑end lead times for AI hardware components." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_market_stres" />
          <attvalue for="38" value="tech_semiconductor_rival" />
