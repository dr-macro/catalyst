      <edge source="us_treasury_market_stres::central_bank_ops" target="russia_ukraine_war::external_aid_flow" id="412">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Expansionary central‑bank operations (asset purchases, swap lines, or targeted lending) add dollar and counterparty liquidity to partner financial systems, lowering borrowing/settlement costs for allied governments and defence firms and thereby enabling larger or faster transfers of military assistance." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_market_stres" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_treasury_market_stres::central_bank_ops" target="tech_semiconductor_rival::ai_hardware_capital_flow" id="413">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained central‑bank balance‑sheet tightening (asset sales/roll‑off) lifts long‑term yields and risk premia, raising discount rates and making large, long‑dated semiconductor and data‑center investments less attractive, thereby slowing capital allocation to AI hardware." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_treasury_market_stres" />
          <attvalue for="38" value="tech_semiconductor_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
