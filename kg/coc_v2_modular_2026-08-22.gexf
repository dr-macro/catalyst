      <edge source="russia_ukraine_war::missile_attack_rate" target="us_treasury_market_stres::secondary_market_liquidi" id="242">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp increases in missile_attack_rate trigger immediate risk‑off flows into on‑the‑run US Treasuries, concentrating buy orders and temporarily deepening and tightening secondary‑market liquidity for those benchmark securities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_treasury_market_stres" />
