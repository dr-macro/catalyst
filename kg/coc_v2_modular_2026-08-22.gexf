      <edge source="us_iran_confrontation::sanctions_enforcement" target="north_korea_standoff::alliance_cohesion" id="47">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stricter, extraterritorial sanctions enforcement (including secondary sanctions) exposes allied firms and banks to penalties, creating diplomatic disputes and coordination frictions that erode trust and practical cohesion among US partners in the region." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="north_korea_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
