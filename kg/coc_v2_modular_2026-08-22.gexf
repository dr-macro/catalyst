          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Greater short‑term funding liquidity allows defence contractors and their supply chains to draw working capital, accelerate production and pay for expedited transport, directly increasing the rate at which interceptor munitions are produced and restocked." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_market_stres" />
          <attvalue for="38" value="russia_ukraine_war" />
