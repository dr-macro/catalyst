      <edge source="us_iran_confrontation::sanctions_pressure" target="north_korea_standoff::deterrence_credibility" id="32">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sharp rise in sanctions pressure provokes retaliatory or escalatory Iranian actions that compel the US to reassign naval and air assets from the Western Pacific to the Middle East, visibly reducing the perceived credibility of US deterrence on the Korean Peninsula." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="north_korea_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::sanctions_pressure" target="tech_semiconductor_rival::trade_controls_ai" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Intensified sanctions pressure on Iran prompts US and allied policymakers to broaden and tighten export-control lists and licensing requirements for AI-related chips and components to close diversion routes and deter circumvention." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="tech_semiconductor_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confrontation::sanctions_pressure" target="us_treasury_market_stres::secondary_market_liquidi" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating sanctions pressure raises counterparty and geopolitical tail‑risk premia, decreasing dealers' willingness to warehouse long‑dated Treasuries and widening bid‑ask spreads, which directly lowers secondary market depth and resiliency." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="us_treasury_market_stres" />
          <attvalue for="27" value="0" />
        </attvalues>
