          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Stricter enforcement (e.g., penalties on correspondent banks and tightened compliance) directly disrupts dollar clearing and correspondent relationships, prompting the Fed to expand liquidity facilities and swap/standing repo operations to backstop dollar funding and market functioning." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="us_treasury_market_stres" />
