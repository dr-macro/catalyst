          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A tightening in short‑term funding (higher repo rates or reduced availability) raises bridge‑finance and working‑capital costs for chipmakers, cloud operators and their financiers, prompting firms and investors to delay or scale back near‑term orders and capex for AI hardware." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_treasury_market_stres" />
          <attvalue for="38" value="tech_semiconductor_rival" />
