      <edge source="us_iran_confrontation::sanctions_enforcement" target="tech_semiconductor_rival::supply_chain_lead_times" id="48">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Stricter enforcement increases physical inspections, compliance checks, and detention of suspect shipments, creating additional stops, documentation delays and rerouting that lengthen end‑to‑end lead times for AI hardware components." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_confrontation" />
          <attvalue for="38" value="tech_semiconductor_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
