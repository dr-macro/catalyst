<edge source="russia_ukraine_war::infrastructure_integrity" target="us_debt_bond_stress::government_bond_yields" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Substantial damage to regional energy and transport infrastructure from the war tightens global commodity and energy supplies, raises US inflation and inflation expectations, and thereby pushes up nominal US Treasury yields across the curve.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_debt_bond_stress</data>
</edge>
<edge source="russia_ukraine_war::infrastructure_integrity" target="us_iran_confront::chokepoint_throughput" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Kinetic damage or closure of Black Sea export terminals and grain/oil transshipment nodes forces exporters to reroute shipments via southern corridors (Suez/Strait of Hormuz), increasing commercial tanker traffic and throughput at those chokepoints.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_iran_confront</data>
</edge>
