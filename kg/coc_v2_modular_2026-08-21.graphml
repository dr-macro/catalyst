<edge source="russia_ukraine_war::logistics_capacity" target="eastasia_alliance_strain::diplomatic_signal_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Severe degradation of logistics and transport networks tied to the war concentrates crisis-management and diplomatic resources on Europe, reducing the frequency and visibility of official diplomatic outreach and high-level signalling in East Asia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">eastasia_alliance_strain</data>
</edge>
<edge source="russia_ukraine_war::logistics_capacity" target="us_iran_confront::perceived_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Reduced logistics capacity in the Russia–Ukraine theatre (mined sea lanes, rail/port closures) raises market attention to concentrated transit routes and contingency fragility, increasing traders' and buyers' assessed risk of wider oil supply disruptions including via Gulf routes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_iran_confront</data>
</edge>
