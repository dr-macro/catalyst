<edge source="eastasia_alliance_strain::diplomatic_signal_flow" target="russia_ukraine_war::logistics_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">1</data>
  <data key="d35">0.6</data>
  <data key="d36">A contraction in diplomatic outreach and coordination (fewer high‑level engagements, transit agreements and liaison channels) degrades real‑time coordination for air/sea corridors, overflight and port access, producing bottlenecks and lower effective logistics throughput into the Ukraine theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eastasia_alliance_strain</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="eastasia_alliance_strain::diplomatic_signal_flow" target="us_iran_confront::perceived_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Visible, sustained diplomatic outreach and de‑escalatory messaging from regional actors reduces uncertainty about intent and crisis trajectories, directly lowering market and stakeholder perceptions of supply disruption risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">eastasia_alliance_strain</data>
  <data key="d39">us_iran_confront</data>
</edge>
