  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A widening US sovereign credit spread signals weaker perceived US fiscal/strategic staying power to regional adversaries, encouraging opportunistic coercive actions or testing of deterrence thresholds that raise the systemic propensity for incidents to escalate.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_debt_bond_stress</data>
  <data key="d39">eastasia_alliance_strain</data>
</edge>
