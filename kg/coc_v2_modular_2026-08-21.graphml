<edge source="israel_region_escalation::diplomatic_engagement" target="eastasia_alliance_strain::diplomatic_signal_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.8</data>
  <data key="d36">Sustained, high-tempo diplomatic engagement focused on the Israel theater consumes senior leadership time and foreign‑ministry bandwidth in major powers, reducing the frequency and visibility of high-level outreach, visits, and coordinated messaging directed at East Asian partners.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">israel_region_escalation</data>
  <data key="d39">eastasia_alliance_strain</data>
</edge>
<edge source="israel_region_escalation::diplomatic_engagement" target="russia_ukraine_war::public_financial_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intense diplomatic focus and high-level negotiations oriented to the Israel crisis shift legislative and executive political capital and budgetary attention in key donor states, leading to re-prioritization or delays in supplemental assistance to Ukraine and thereby increasing Ukraine's public financial stress.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">israel_region_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="israel_region_escalation::diplomatic_engagement" target="us_debt_bond_stress::net_capital_to_gov_bonds" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained external diplomatic progress reduces near‑term geopolitical uncertainty, prompting investors to reallocate from safe‑haven Treasuries back into risk assets and decreasing net inflows to government bonds.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">israel_region_escalation</data>
  <data key="d39">us_debt_bond_stress</data>
</edge>
