<edge source="us_iran_confront::chokepoint_throughput" target="eastasia_alliance_strain::diplomatic_signal_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute disruptions or slowdowns in Strait/Red Sea throughput prompt East Asian governments to initiate visible diplomatic outreach—consultations with the US, Gulf suppliers, and regional security partners—to secure energy routes and coordination.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confront</data>
  <data key="d39">eastasia_alliance_strain</data>
</edge>
<edge source="us_iran_confront::chokepoint_throughput" target="israel_region_escalation::deployment_density" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher commercial transit rates through strategic chokepoints reduce immediate perceived threats to shipping, allowing states to scale back convoy-protection patrols and forward naval/air deployments, lowering deployment density near the Israel region.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confront</data>
  <data key="d39">israel_region_escalation</data>
</edge>
<edge source="us_iran_confront::chokepoint_throughput" target="russia_ukraine_war::logistics_capacity" id="0">
