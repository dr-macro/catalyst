  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in perceived oil supply disruption risk drives risk‑off reallocation and hedging by institutional investors toward highly liquid sovereign bonds, producing net inflows into government bond markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_confront</data>
  <data key="d39">us_debt_bond_stress</data>
</edge>
