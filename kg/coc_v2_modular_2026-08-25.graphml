<edge source="iran_maritime_pressure::oil_flow_volume" target="iran_maritime_pressure::energy_market_liquidity" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">3</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_maritime_pressure::oil_flow_volume" target="russia_ukraine_war::critical_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A reduction in crude and refined product throughput through key chokepoints directly increases shortages and rerouting pressure for fuel and bunker supply chains used to sustain military and logistical operations supporting the Ukraine war, raising critical‑supply risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_maritime_pressure</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_maritime_pressure::oil_flow_volume" target="treasury_market_stress::long_term_yields" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained increase in oil transit volumes eases near‑term supply concerns, lowers upside inflation and geopolitical risk premia priced into long‑dated sovereign bonds, and so reduces long‑term yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_maritime_pressure</data>
  <data key="d39">treasury_market_stress</data>
</edge>
<edge source="iran_maritime_pressure::oil_flow_volume" target="us_canada_tariff_row::political_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained reduction in oil transit volume pushes up fuel and transport costs, hurting energy‑intensive sectors and regional employers who then press policymakers for protective trade actions or relief, raising domestic political pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_maritime_pressure</data>
  <data key="d39">us_canada_tariff_row</data>
</edge>
<edge source="iran_maritime_pressure::oil_flow_volume" target="us_china_tech_rivalry::compute_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Acute reductions in oil transit volume drive up regional fuel and electricity prices and can cause localized fuel shortages, forcing temporary curtailment or higher operating costs at energy‑intensive datacenters and fabs and thereby reducing available compute.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_maritime_pressure</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
