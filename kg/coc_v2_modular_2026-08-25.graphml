<edge source="us_canada_tariff_row::retaliatory_match_degree" target="iran_maritime_pressure::third_party_compliance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Stronger reciprocal tariff measures by Canada lead Ottawa to adopt legal protections, guidance, or financial support that enable Canadian and allied firms to keep trading with sanctioned Iranian entities, which reduces third-party firms' willingness to comply with U.S. secondary sanctions.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_canada_tariff_row</data>
  <data key="d39">iran_maritime_pressure</data>
</edge>
<edge source="us_canada_tariff_row::retaliatory_match_degree" target="treasury_market_stress::long_term_yields" id="0">
