<edge source="treasury_market_stress::market_volatility" target="iran_maritime_pressure::shipping_insurance_premi" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Sharp spikes in Treasury-market volatility force insurers and reinsurers to de‑risk and reprice exposures, reducing war‑risk capacity and driving up war‑risk and hull insurance premia for vessels operating in the Gulf/Strait of Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">treasury_market_stress</data>
  <data key="d39">iran_maritime_pressure</data>
</edge>
<edge source="treasury_market_stress::market_volatility" target="russia_ukraine_war::international_support_fl" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sharp Treasury-market volatility triggers risk-off behavior by asset managers and creates political pressure on legislators and ministries to shore up domestic markets, causing donor states and private contractors to slow or defer shipments and financing for Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">treasury_market_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="treasury_market_stress::market_volatility" target="russia_ukraine_war::critical_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Elevated volatility in Treasury and related fixed-income markets leads banks and insurers to withdraw or repricing trade finance and war-risk insurance, raising the likelihood of interrupted deliveries of fuel, spare parts and munitions into Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">treasury_market_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="treasury_market_stress::market_volatility" target="us_canada_tariff_row::political_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Sharp increases in Treasury-market volatility produce visible losses for pension funds, money-market stress and sudden credit tightening for exporters and manufacturers, which quickly raises domestic business and voter demands for protectionist measures and therefore heightens political pressure to impose tariffs.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">treasury_market_stress</data>
  <data key="d39">us_canada_tariff_row</data>
</edge>
