<edge source="us_china_tech_rivalry::ai_capital_flow" target="iran_maritime_pressure::maritime_security_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Increased investment into AI specifically funds rapid procurement and fielding of maritime surveillance and autonomous response platforms by private security firms and state actors, raising on‑water detection and response capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">iran_maritime_pressure</data>
</edge>
<edge source="us_china_tech_rivalry::ai_capital_flow" target="treasury_market_stress::buyback_intervention" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A surge in private capital into AI projects diverts demand from safe sovereign bonds, raising Treasury yields and liquidity strains that increase the likelihood and scale of official buyback interventions to stabilize long-dated yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">treasury_market_stress</data>
</edge>
