<edge source="us_canada_tariff_row::industrial_interdependen" target="russia_ukraine_war::critical_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A breakdown in deep US–Canada manufacturing integration severs just‑in‑time lines for components (electronics, ammunition subcomponents, vehicle parts) used in Western supplies to Ukraine, directly increasing the risk of shortages and rerouting failures in those critical supply chains.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_canada_tariff_row</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_canada_tariff_row::industrial_interdependen" target="russia_ukraine_war::econ_infra_vulnerability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Disruption of integrated US–Canada supply and maintenance chains delays delivery of spare parts, repair crews and specialist equipment used for energy and logistics infrastructure relevant to Ukraine’s sustainment, increasing susceptibility to outages and cascading failures.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_canada_tariff_row</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_canada_tariff_row::industrial_interdependen" target="us_china_tech_rivalry::compute_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Deep US‑Canada manufacturing integration means tariffs or border frictions disrupt delivery of servers, power equipment and specialized components for North American data centers, delaying builds and expansions and reducing available AI training/inference compute capacity in the near term.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_canada_tariff_row</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
