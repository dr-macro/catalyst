<edge source="russia_ukraine_war::critical_supply_risk" target="iran_maritime_pressure::oil_flow_volume" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Disruptions and sanctions on Russian crude prompt buyers to source more oil from Gulf producers, increasing tanker throughput through chokepoints such as the Strait of Hormuz and raising measured oil transit volume.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_maritime_pressure</data>
</edge>
<edge source="russia_ukraine_war::critical_supply_risk" target="treasury_market_stress::long_term_yields" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Acute disruptions to energy and key commodity supplies raise near-term inflation expectations and term premia, forcing repricing of long-dated sovereign bonds upward.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">treasury_market_stress</data>
</edge>
<edge source="russia_ukraine_war::critical_supply_risk" target="us_canada_tariff_row::industrial_interdependen" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">War-driven interruptions to critical inputs and energy prompt North American manufacturers to regionalize and re-source components away from fragile cross-border chains, directly reducing depth of US–Canada industrial integration.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_canada_tariff_row</data>
</edge>
<edge source="russia_ukraine_war::critical_supply_risk" target="us_china_tech_rivalry::chip_manufacturing_cap" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">War-related disruptions and sanctions interrupt supplies of key semiconductor inputs (e.g., specialty gases, substrates, tool shipments) and constrain cross-border equipment flows, forcing fabs to idle or cut throughput and reducing near-term advanced chip output.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
