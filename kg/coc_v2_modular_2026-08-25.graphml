<edge source="iran_maritime_pressure::maritime_security_level" target="iran_maritime_pressure::escalation_pressure" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_maritime_pressure::maritime_security_level" target="iran_maritime_pressure::diplomatic_coordination" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_maritime_pressure::maritime_security_level" target="russia_ukraine_war::international_support_fl" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in naval escorts and active maritime security in response to Iran pressure lowers transit risk for weapons and aid shipments and thereby facilitates higher rates of military and materiel transfers to Ukraine; conversely, a drop in security suppresses those flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_maritime_pressure</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_maritime_pressure::shipping_insurance_premi" target="iran_maritime_pressure::oil_flow_volume" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="iran_maritime_pressure::shipping_insurance_premi" target="iran_maritime_pressure::vessel_transit_delay_rat" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_maritime_pressure::shipping_insurance_premi" target="iran_maritime_pressure::investor_risk_positionin" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">-</data>
</edge>
<edge source="iran_maritime_pressure::shipping_insurance_premi" target="iran_maritime_pressure::escalation_pressure" id="0">
  <data key="d27">intra_causal</data>
  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="iran_maritime_pressure::shipping_insurance_premi" target="russia_ukraine_war::market_disruption" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sharp rise in shipping insurance and war‑risk premia for vessels in the Iran‑affected sea lanes immediately raises transport costs, forces rerouting and hedging, and triggers price and volatility spikes in energy, grain and commodity markets linked to the Russia–Ukraine conflict.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_maritime_pressure</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_maritime_pressure::shipping_insurance_premi" target="treasury_market_stress::market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A rapid rise in shipping war‑risk and insurance premia acts as a high‑frequency signal of elevated geopolitical risk that causes immediate repricing across fixed‑income desks and increases trade volumes into/out of Treasuries, raising intramarket price swings.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_maritime_pressure</data>
  <data key="d39">treasury_market_stress</data>
</edge>
<edge source="iran_maritime_pressure::shipping_insurance_premi" target="us_canada_tariff_row::political_pressure_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A sharp rise in shipping insurance and war‑risk premia immediately raises landed import prices and delivery uncertainty for firms and consumers, spurring industry and constituency lobbying for protective or compensatory trade measures that increase domestic political pressure on governments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_maritime_pressure</data>
  <data key="d39">us_canada_tariff_row</data>
</edge>
<edge source="iran_maritime_pressure::shipping_insurance_premi" target="us_china_tech_rivalry::chip_manufacturing_cap" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising war‑risk and hull insurance premia raise the cost and risk of maritime transport for high‑value semiconductor tools, substrates and chemicals, prompting delays, cancellations or reduced frequency of shipments that create immediate throughput bottlenecks at fabs.</data>
  <data key="d37">0-6 months</data>
