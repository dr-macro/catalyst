<edge source="russia_ukraine_war::market_disruption" target="iran_maritime_pressure::shipping_insurance_premi" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Heightened volatility in commodity and freight markets tied to the Russia–Ukraine war raises perceived systemic risk for tanker and merchant routes, prompting insurers to widen war‑risk and hull/policy premia for ships operating in regions where Iran exerts pressure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_maritime_pressure</data>
</edge>
<edge source="russia_ukraine_war::market_disruption" target="treasury_market_stress::market_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Volatility and functional strains in commodity, insurance and related markets produce margin calls, forced reallocations and cross-market spillovers that directly amplify price swings in the Treasury market.</data>
  <data key="d37">0-3 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">treasury_market_stress</data>
</edge>
