          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Spikes in short- and medium-term energy price volatility increase risk premia and induce precautionary buying and inventory hoarding by market participants, exerting upward pressure on benchmark crude price levels." />
          <attvalue for="37" value="0-6 months" />
