      <edge source="global_energy_shift::chokepoint_security" target="global_energy_shift::naval_presence_level" id="513">
        <attvalues>
          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="2" />
          <attvalue for="33" value="-" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_shift::chokepoint_security" target="iran_us_regional_war::alliance_cohesion" id="514">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Deterioration in security at major maritime chokepoints forces ad hoc burden-sharing (escorts, patrols) and exposes divergent threat tolerances and economic exposures among US partners, producing political friction and reducing coalition cohesion." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_shift" />
          <attvalue for="39" value="iran_us_regional_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_shift::chokepoint_security" target="market_monetary_stress::long_term_yield" id="515">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained deterioration in major maritime chokepoint security raises the persistent supply‑risk premium for energy and increases perceived long‑run fiscal and inflation uncertainty, prompting investors to demand higher term premia and pushing up long‑duration government yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_shift" />
          <attvalue for="39" value="market_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_shift::chokepoint_security" target="russia_ukraine_war::fuel_supply_flow" id="516">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Declines in security at key maritime chokepoints (e.g., mines, naval interdictions or closures in the Black Sea/Turkish Straits) directly force port shutdowns and vessel refusals, physically reducing volumes of liquid fuels delivered to the conflict region and nearby markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_shift::chokepoint_security" target="us_china_tech_rivalry::compute_capacity" id="517">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Improved security at major maritime chokepoints reduces risk of interdiction and delay for high‑value GPU/accelerator shipments, enabling faster deliveries and installations that raise available high‑performance compute capacity." />
