      <edge source="russia_ukraine_war::fuel_supply_flow" target="global_energy_shift::seaborne_flow_rate" id="204">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Reductions in continental pipeline or overland fuel export flows (e.g., Russian pipeline gas/oil curtailed by the conflict) prompt buyers to substitute with seaborne cargoes (LNG, oil tankers), increasing seaborne flow rates; conversely increases in land-based flows reduce seaborne shipments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_shift" />
          <attvalue for="28" value="0" />
