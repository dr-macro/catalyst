          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Wider and more intense proxy fighting elevates perceived sovereign and regional risk, driving up term premia and long-dated government yields for exposed issuers as investors demand higher compensation for prolonged geopolitical risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="market_monetary_stress" />
