      <edge source="market_monetary_stress::market_rate_expectations" target="global_energy_shift::seaborne_flow_rate" id="789">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising expected short-term policy rates raise forward financing and working-capital costs for traders and shipowners and increase charter/bunker expense expectations, prompting cancellations, slower loadings and lower spot chartering for marginal cargoes and thus reducing seaborne oil and LNG shipments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="global_energy_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="market_monetary_stress::market_rate_expectations" target="iran_us_regional_war::proxy_activation_level" id="790">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="An upward revision in expected policy rates typically strengthens the dollar and tightens global liquidity, squeezing Iran's access to hard currency and prompting Tehran to increase reliance on and activation of proxies to project influence and offset economic pressure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="iran_us_regional_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="market_monetary_stress::market_rate_expectations" target="russia_ukraine_war::fuel_supply_flow" id="791">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rise in market-implied short-term rate paths raises trade-finance and working-capital costs for energy traders and shipowners, producing delays, reduced cargo financing and intermittent interruptions in commercial fuel shipments to theaters affected by the conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
