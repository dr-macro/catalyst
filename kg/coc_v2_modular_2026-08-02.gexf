      <edge source="iran_us_regional_war::escalation_pressure" target="russia_ukraine_war::alliance_support_level" id="49">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A spike in Iran–US escalation ties down US diplomatic bandwidth and political capital (and forces prioritization of Middle East contingency planning), causing Washington and key European partners to scale back or delay political/diplomatic backing and high-profile initiatives for Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="russia_ukraine_war" />
