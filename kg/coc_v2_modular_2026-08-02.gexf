      <edge source="market_monetary_stress::central_bank_credibility" target="global_energy_shift::crude_price_level" id="781">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An increase in central-bank credibility lowers perceived inflation and currency-risk premia and reduces demand for commodities as an inflation hedge, weakening speculative and portfolio flows into oil and thereby exerting downward pressure on crude prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="global_energy_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="market_monetary_stress::central_bank_credibility" target="us_china_tech_rivalry::regulatory_control" id="782">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A decline in central bank credibility heightens political and public demand for economic safeguards, spurring governments to tighten export controls, compliance checks, and capital/tech restrictions on strategically sensitive AI technologies." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="market_monetary_stress" />
