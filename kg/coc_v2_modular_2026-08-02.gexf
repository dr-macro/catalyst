      <edge source="russia_ukraine_war::energy_price_volatility" target="iran_us_regional_war::escalation_pressure" id="236">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large and sustained volatility or spikes in global energy prices increase the economic and political payoff to coercive disruption (and in some cases state revenues), incentivizing Gulf actors and Iran to take riskier, pressure-inducing actions that raise systemic escalation pressure between regional actors and the U.S." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_us_regional_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_price_volatility" target="market_monetary_stress::long_term_yield" id="237">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp, sustained swings in energy prices raise uncertainty about future inflation and fiscal backstops, increasing the term premium investors demand on long-duration government bonds and pushing long-term yields up." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="market_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
