          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater activation of proxies increases demand for ISR, targeting, logistics and autonomous force‑multipliers, prompting militaries and defense contractors to accelerate procurement and fielding of AI systems and pushing some commercial operators to expedite AI deployment for continuity and resilience." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
