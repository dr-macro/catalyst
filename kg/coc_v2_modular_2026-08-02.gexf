      <edge source="market_monetary_stress::fiscal_financing_pressur" target="market_monetary_stress::market_rate_expectations" id="749">
        <attvalues>
          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="2" />
          <attvalue for="33" value="+" />
