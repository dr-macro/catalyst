          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened activation of Iran-backed proxies (e.g., Houthi attacks) against tankers and shipping lanes disrupts tanker transits and commercial schedules, directly reducing the volume and continuity of liquid fuel shipments reaching European and regional markets relevant to the Russia–Ukraine theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="russia_ukraine_war" />
