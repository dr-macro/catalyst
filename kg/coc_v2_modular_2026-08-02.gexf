      <edge source="russia_ukraine_war::alliance_support_level" target="global_energy_shift::chokepoint_security" id="271">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher alliance political support commonly includes naval escorts, intelligence sharing and patrol deployments around vulnerable straits/canals, directly improving on-the-water security and access stability at major chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_support_level" target="iran_us_regional_war::military_engagement_rate" id="272">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sustained high levels of allied politico-material support to Ukraine consume munitions, precision-guided weapons and deployable strike platforms and prioritize European force posture, reducing immediately available U.S./coalition assets and munitions for kinetic operations in the Middle East and thus lowering short-term engagement rates against Iran." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_us_regional_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_support_level" target="market_monetary_stress::fiscal_financing_pressur" id="273">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Increased allied support (grants, subsidized loans, direct procurement or in-kind military aid) lowers the recipient government's immediate borrowing needs and reduces rollover and market funding pressure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="market_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_support_level" target="us_china_tech_rivalry::regulatory_control" id="274">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Intensified allied political support produces coordinated sanctions and export-control packages and institutional templates that are adapted/expanded to tighten AI and semiconductor export and inspection regimes vis-à-vis China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_support_level" target="us_china_tech_rivalry::capital_flow_to_ai" id="275">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher alliance support channels more defense aid, joint R&amp;D funding, and procurement commitments into allied AI and compute projects, redirecting public and private capital toward AI development in US-led ecosystems." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
