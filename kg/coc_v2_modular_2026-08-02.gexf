          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rise in crude prices directly increases consumer fuel and transport costs and upstream input prices, which market participants and survey respondents incorporate into near‑term and medium‑term inflation expectations." />
          <attvalue for="37" value="0-6 months" />
