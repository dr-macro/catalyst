        </attvalues>
      </edge>
      <edge source="market_monetary_stress::fiscal_financing_pressur" target="global_energy_shift::crude_price_level" id="750">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Intensifying fiscal financing pressure in major oil-exporting governments creates an immediate incentive to protect revenue by maintaining or increasing export volumes and avoiding voluntary production cuts, which raises supply and puts downward pressure on benchmark crude prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="global_energy_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="market_monetary_stress::fiscal_financing_pressur" target="iran_us_regional_war::alliance_cohesion" id="751">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising fiscal financing pressure forces governments (especially the US and Gulf partners) to cut or delay foreign military assistance, joint exercises and reimbursable operations, directly reducing political and operational alignment among coalition partners." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="iran_us_regional_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="market_monetary_stress::fiscal_financing_pressur" target="russia_ukraine_war::alliance_support_level" id="752">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising fiscal financing pressure in major donor governments forces near-term budget tightening and increases domestic political resistance to additional military and economic aid, causing a measurable reduction in expressed and material alliance support for actors in the conflict." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="market_monetary_stress::fiscal_financing_pressur" target="russia_ukraine_war::strike_frequency" id="753">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Increased fiscal financing pressure on the Russian state (higher borrowing costs and constrained access to markets) reduces procurement and production of munitions and spare parts, lowering the tempo and frequency of strikes on the battlefield." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="market_monetary_stress::fiscal_financing_pressur" target="us_china_tech_rivalry::chip_production_capacity" id="754">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising fiscal financing pressure forces governments to cut or delay subsidies, tax incentives, and public guarantees that underwrite expensive fab builds, reducing near‑term additions to advanced semiconductor production capacity." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="market_monetary_stress" />
          <attvalue for="39" value="us_china_tech_rivalry" />
