      <edge source="iran_us_regional_war::military_engagement_rate" target="global_energy_shift::seaborne_flow_rate" id="31">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Higher tempo and scale of kinetic operations (strikes, blockades, interdictions) directly damages terminals, forces port closures and no-sail advisories, and prompts cancellations that reduce the volume of oil and LNG actually moved by sea." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="global_energy_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
