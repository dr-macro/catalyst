          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An upward revision in expected short-term policy rates raises expected financing costs and discount rates, prompting VCs and corporate treasuries to reduce new commitments and delay rounds for AI startups and infrastructure projects." />
