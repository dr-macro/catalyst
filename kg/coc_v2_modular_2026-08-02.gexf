          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising systemic escalation risk raises market risk premia and speculative buying (and prompts hedging by consumers and traders), producing upward pressure and episodic spikes in benchmark crude prices." />
