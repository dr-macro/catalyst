          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Reduced liquid-fuel flows from Russia force rerouting and increased crude/product shipments out of the Persian Gulf and via alternative long-haul routes, raising tanker density, transit congestion and exposure at the Strait of Hormuz and Suez and thereby degrading chokepoint security." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_us_regional_war" />
          <attvalue for="28" value="0" />
