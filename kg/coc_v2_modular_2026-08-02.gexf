      <edge source="iran_us_regional_war::military_engagement_rate" target="market_monetary_stress::fiscal_financing_pressur" id="32">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained increases in kinetic engagements raise defense and emergency spending while prompting investor risk premia on sovereign debt, tightening rollover conditions and increasing fiscal financing pressure for affected states." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="market_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_regional_war::military_engagement_rate" target="russia_ukraine_war::strike_frequency" id="33">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained high-rate kinetic operations by US and Western forces in the Iran–US theatre increase immediate demand on precision munitions and logistics, prompting reallocation or slower deliveries of weapons to Ukraine and thereby reducing Ukrainian-capable strike frequency." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_regional_war::military_engagement_rate" target="us_china_tech_rivalry::capital_flow_to_ai" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in kinetic operations raises geopolitical and market risk premiums, prompting global investors and venture funds to pull back or reallocate capital away from high‑growth civilian AI ventures (and cross‑border tech deals), lowering short‑term financing into AI projects." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
