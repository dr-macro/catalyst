          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp, persistent energy-price volatility raises operating costs and risk premia for energy-intensive AI compute (data centers/GPU farms), causing investors and cloud providers to delay or scale back capital commitments to new AI infrastructure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
