      <edge source="iran_us_regional_war::maritime_chokepoint_sec" target="market_monetary_stress::inflation_expectations" id="100">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rise in threats or attacks at Strait of Hormuz and other regional chokepoints acutely raises oil and shipping-cost premia, which markets quickly translate into higher near- and medium-term inflation expectations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="market_monetary_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_regional_war::maritime_chokepoint_sec" target="russia_ukraine_war::energy_price_volatility" id="101">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Deterioration in security around key chokepoints (Red Sea, Bab al-Mandeb, Suez approaches) forces rerouting, increases insurance and freight costs and injects uncertainty into delivery schedules, which raises short- to medium-term volatility in energy prices affecting markets linked to the Russia–Ukraine conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_regional_war::maritime_chokepoint_sec" target="us_china_tech_rivalry::chip_production_capacity" id="102">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained attacks and higher insurance/closure risks in key waterways (Red Sea/Strait of Hormuz/Bab el‑Mandeb) directly disrupt shipments of specialty gases, substrates and finished semiconductor components, forcing fabs to curtail output or delay production runs and reducing near‑term chip capacity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_regional_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
