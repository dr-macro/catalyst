<edge source="us_iran_standoff::chokepoint_security" target="global_ai_governance::investment_flow_to_ai" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Heightened insecurity at maritime choke points raises demand for AI-enabled maritime ISR, autonomous vessels, and logistics-optimization tools, redirecting private and defense-related capital into AI startups and projects addressing those needs.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_iran_standoff</data>
  <data key="d40">global_ai_governance</data>
</edge>
<edge source="us_iran_standoff::chokepoint_security" target="global_bond_stress::policy_rate_expectations" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Deterioration of security in major maritime chokepoints raises near-term oil-price risk and expected headline inflation, prompting markets to re-price toward a higher path of central-bank policy rates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_standoff</data>
  <data key="d40">global_bond_stress</data>
</edge>
<edge source="us_iran_standoff::chokepoint_security" target="russia_ukraine_war::oil_export_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Worsening security at Gulf/Red Sea chokepoints (attacks, closures, insurance pullback) forces rerouting, reduces tanker throughput and effective export capacity, and thereby lowers global oil export flows relevant to markets that also affect the Russia–Ukraine theater.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_standoff</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_iran_standoff::chokepoint_security" target="us_china_rivalry::regulatory_uncertainty" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Heightened contestation or attacks in Middle Eastern maritime chokepoints trigger emergency trade measures, stricter routing rules and provisional export controls by the US and partners, producing immediate unpredictability in rules governing trade and strategic-technology flows between the US and China.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_standoff</data>
  <data key="d40">us_china_rivalry</data>
</edge>
