<edge source="us_china_rivalry::regulatory_uncertainty" target="global_ai_governance::investment_flow_to_ai" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalating, unpredictable export controls and cross‑border compliance rules tied to the rivalry cause venture funds and corporate investors to delay, divert, or withhold capital from AI startups and projects exposed to bilateral trade or sanction risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
