          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained increases in shipping disruptions advantage hyperscalers with integrated logistics and on‑site stockpiles, prompting firms and customers to concentrate workloads on a smaller set of providers with resilient supply chains and on‑prem capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_escalation" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
