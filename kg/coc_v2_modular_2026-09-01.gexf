          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Concentration of critical AI infrastructure in a few operators creates single points of failure and sanction/attack targets such that an outage or regulatory action against one provider triggers rapid deleveraging and margin calls that widen bid-ask spreads and withdraw liquidity from related cash and repo markets." />
          <attvalue for="36" value="0-6 months" />
