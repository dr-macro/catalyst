          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Deeper formalized defense cooperation leads allied governments and contractors to pool requirements and procure shared secure cloud and edge platforms from a small set of vetted vendors, concentrating critical AI infrastructure under those providers." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
