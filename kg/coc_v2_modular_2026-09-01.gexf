          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in commercial shipping disruptions from Middle East insecurity prompts NATO/EU members to deepen naval coordination, intelligence sharing, and joint logistics planning, increasing institutional defense cooperation that also shapes collective support modalities for Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
