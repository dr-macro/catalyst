      <edge source="us_china_tech_rivalry::market_concentration_ai" target="global_financial_stress::implied_volatility" id="401">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater market concentration raises the systemic importance of a handful of firms so that any geopolitical shock, sanctions, or operational problem at a dominant provider causes spikes in option-implied volatility across tech-heavy and broad indices as investors reprices tail risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::market_concentration_ai" target="russia_ukraine_war::arms_transfer_volume" id="402">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="High concentration of AI suppliers in jurisdictions aligned with export-control regimes makes coordinated denial of AI-enabled components and platforms to Russia easier, reducing the volume/value of advanced arms transfers to Russia." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::market_concentration_ai" target="us_iran_escalation::shipping_disruption_rate" id="403">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="If a few dominant cloud/AI providers suspend services (satcom, routing/analytics, insurance-pricing models) to vessels, brokers or insurers linked to Iran in response to sanctions or compliance risk, affected shipping is delayed, rerouted, or halted, raising disruption rates." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="us_iran_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::market_concentration_ai" target="us_iran_escalation::oil_export_capacity" id="404">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Dominant platform and data providers can effectively block Iranian exporters from essential services (trading platforms, satellite navigation/monitoring, insurance underwriting), which reduces the practical ability of Iran to move and sell oil despite physical production." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="us_iran_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::market_concentration_ai" target="us_venezuelan_oil::investor_risk_perception" id="405">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Greater concentration of AI service providers increases single‑vendor control over cloud, payments/settlement tooling, and analytics used by oil traders and service firms, making it easier for external actors to deny services or comply with extraterritorial sanctions and thereby raising investors' perceived political/legal risk in Venezuelan oil." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_china_tech_rivalry" />
          <attvalue for="38" value="us_venezuelan_oil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_rivalry::labor_skill_alignment" target="us_china_tech_rivalry::ai_model_capability" id="406">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="2" />
