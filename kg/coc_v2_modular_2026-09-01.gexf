          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Deeper institutionalized defense cooperation among the US and European allies increases capacity and political will for coordinated secondary sanctions and enforcement, raising legal/compliance and political-risk perceptions among investors in Venezuelan oil projects." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_venezuelan_oil" />
          <attvalue for="27" value="0" />
