          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Centralized AI/cloud infrastructure under Western control enables rapid provision of high-end ISR and target‑planning AI services to Ukrainian forces, increasing tempo and precision of kinetic strikes." />
