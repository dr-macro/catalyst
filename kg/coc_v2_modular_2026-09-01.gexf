      <edge source="russia_ukraine_war::kin_strike_intensity" target="global_financial_stress::implied_volatility" id="192">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Spikes in kinetic strike intensity generate rapid newsflow and higher near-term geopolitical uncertainty, which market participants immediately price into option markets and other volatility-sensitive instruments, raising implied volatilities across equities, FX and commodities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kin_strike_intensity" target="global_financial_stress::long_term_bond_yield" id="193">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sustained or large increases in strike intensity raise perceived persistent geopolitical and energy-supply risks, increasing the term premium demanded by investors and pushing up long-dated sovereign bond yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_financial_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kin_strike_intensity" target="us_china_tech_rivalry::infrastructure_centraliz" id="194">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified kinetic strikes that disrupt regional data centers, logistics nodes or fabs prompt firms to relocate or consolidate compute and storage into fewer, larger, and more resilient facilities or major cloud providers, increasing infrastructure centralization." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kin_strike_intensity" target="us_iran_escalation::global_oil_price" id="195">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained increases in kinetic strike intensity that damage or threaten energy-related infrastructure and raise market uncertainty around Russian and regional energy supplies drive a higher risk premium in oil markets, pushing global benchmark prices up." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kin_strike_intensity" target="us_venezuelan_oil::extraction_production_ra" id="196">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in kinetic strikes that degrades Russian export capacity or raises crude-price volatility prompts the US and partner importers to authorize sanction waivers or logistical changes to bring more Venezuelan crude to market, enabling a near-term increase in Venezuelan extraction and exports." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_venezuelan_oil" />
          <attvalue for="27" value="0" />
        </attvalues>
