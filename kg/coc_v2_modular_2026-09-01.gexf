      <edge source="russia_ukraine_war::defense_coop_depth" target="us_iran_escalation::military_engagement" id="270">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Deeper institutionalized defense cooperation and interoperability in Europe tied to the Russia–Ukraine war compels the U.S. to retain or redeploy forces and command assets to the European theater, reducing available forward-deployed U.S. posture and operational tempo in the Middle East and thereby lowering the frequency/scale of U.S.–Iran kinetic exchanges." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
