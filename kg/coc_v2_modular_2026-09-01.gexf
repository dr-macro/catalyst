          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising commercial-shipping delays and reroutes increase lead times and shortages for specialized AI hardware (GPUs, interconnects), constraining available training compute and slowing cadence of large-scale model development and capability gains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_escalation" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
