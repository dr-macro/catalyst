      <edge source="global_rate_shock::long_term_nominal_yields" target="ai_safety_race::average_model_capability" id="495">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising long-term yields increase the hurdle rate for long‑duration capital expenditures, reducing willingness to finance large compute clusters and sustained training campaigns, which lowers the average capability of frontier models produced." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="ai_safety_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_shock::long_term_nominal_yields" target="brics_alignment_growth::investment_divergence" id="496">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in long-term nominal yields raises the global cost of capital unevenly, making projects in higher‑cost markets less attractive and prompting asymmetric capital allocation that widens investment flow divergence across rival regions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="brics_alignment_growth" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_shock::long_term_nominal_yields" target="russia_ukraine_conflict::energy_supply_disruption" id="497">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A spike in long‑term yields increases refinancing costs and insurance premiums for energy traders and infrastructure owners, delaying repairs to damaged pipelines/terminals and constraining credit‑financed fuel imports, thereby increasing energy supply disruptions in the conflict zone." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
