          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Improved market liquidity reduces transaction and short‑term financing costs for firms and cloud providers, enabling faster procurement of compute, software and integration projects and thereby accelerating deployment of frontier capabilities into products and operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="ai_safety_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_shock::market_liquidity" target="brics_alignment_growth::supply_chain_realignment" id="583">
        <attvalues>
