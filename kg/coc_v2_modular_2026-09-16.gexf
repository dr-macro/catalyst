      <edge source="brics_alignment_growth::investment_divergence" target="ai_safety_race::safety_incident_freq" id="722">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Widening allocation gaps that divert safety‑related funding away from some developer communities reduce testing, red‑teaming and monitoring capacity there, raising the probability that deployed frontier models produce harmful or insecure behaviours." />
