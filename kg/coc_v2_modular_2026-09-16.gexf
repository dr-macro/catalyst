      <edge source="brics_alignment_growth::cross_border_capital" target="ai_safety_race::frontier_dev_speed" id="713">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Large net capital flows away from incumbent AI hubs reduce venture funding, cloud credits and M&amp;A activity for frontier teams, cutting R&amp;D budgets and slowing the pace of new high‑capability model development." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="ai_safety_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_alignment_growth::cross_border_capital" target="global_rate_shock::market_liquidity" id="714">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rapid intensification of cross-border capital movements (net outflows from particular sovereign bond markets toward rival blocs) drains dealer inventories and order-book depth in those markets, widening bid-ask spreads and reducing market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="global_rate_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_alignment_growth::cross_border_capital" target="russia_ukraine_conflict::energy_supply_disruption" id="715">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increased inward capital flows to Russian energy and logistics firms finance repairs, spare‑parts imports and alternative export arrangements, thereby reducing the occurrence and duration of energy supply disruptions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
