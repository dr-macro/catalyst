          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher expected policy rates raise projected borrowing costs and fiscal strain for Western governments, shifting political priorities toward domestic economic stabilisation and reducing appetite and bandwidth for sustained high‑intensity diplomatic pressure campaigns over the medium term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_rate_shock" />
