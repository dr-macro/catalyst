          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Improved market liquidity lowers transaction, hedging and rollover costs and reduces firms' precautionary financing premia, decreasing the urgency for firms to reorganize sourcing and production geographies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="brics_alignment_growth" />
          <attvalue for="27" value="0" />
        </attvalues>
