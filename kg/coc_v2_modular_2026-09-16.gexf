          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Accelerated relocation of upstream investment and field maintenance capacity out of Gulf jurisdictions reduces near‑term production reliability and increases the probability of unplanned outages, causing market participants to raise perceived supply disruption risk." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="gulf_energy_flashpoint" />
          <attvalue for="27" value="0" />
