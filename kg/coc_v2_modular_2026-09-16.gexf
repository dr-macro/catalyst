      <edge source="brics_alignment_growth::geopolitical_alignment" target="global_rate_shock::sovereign_debt_issuance" id="694">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="States reorienting diplomatic/economic alignment toward alternative blocs often increase strategic public spending and alter reserve and financing strategies, prompting higher sovereign debt issuance as governments tap markets or new lenders to fund the transition." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="global_rate_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_alignment_growth::geopolitical_alignment" target="gulf_energy_flashpoint::geopolitical_tension" id="695">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Expanded political alignment between regional actors and BRICS partners brings increased diplomatic protection and higher-profile military/economic cooperation that emboldens tougher postures and provokes reciprocal measures, raising the frequency and severity of hostile actions that threaten energy flows." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="gulf_energy_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_alignment_growth::geopolitical_alignment" target="russia_ukraine_conflict::diplomatic_pressure_leve" id="696">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="As more states reorient toward Russia's alternative bloc they publicly refrain from condemnations, block punitive multilateral initiatives and provide political cover, lowering the aggregate diplomatic pressure aimed at forcing Russian de‑escalation." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="brics_alignment_growth::geopolitical_alignment" target="russia_ukraine_conflict::energy_strike_rate" id="697">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Stronger alignment creates channels for deniable transfers of munitions, targeting intelligence and permissive coordination from aligned partners, directly increasing Russian capacity and willingness to conduct strikes on Ukrainian energy infrastructure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="russia_ukraine_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
