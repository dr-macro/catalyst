          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sudden drop in market liquidity raises transaction costs and freezes short‑term commercial credit and FX lines for defence suppliers and logistics firms, causing delays in spare parts, fuel and munitions deliveries and degrading frontline intercept and rapid‑reaction readiness within weeks to months." />
