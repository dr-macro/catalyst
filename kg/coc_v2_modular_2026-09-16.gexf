          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising market-implied policy rates attract capital into the dollar and raise discount rates, reducing demand for commodities and putting downward pressure on dollar‑priced crude benchmarks within weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="gulf_energy_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_shock::policy_rate_expectations" target="russia_ukraine_conflict::diplomatic_pressure_leve" id="507">
