      <edge source="brics_alignment_growth::corporate_reallocation" target="global_rate_shock::central_bank_ops" id="779">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An accelerated rate of corporate capital and cash relocation across jurisdictions creates acute short-term funding and FX pressures (deposit shifts, higher FX demand), prompting central banks to expand market operations (liquidity injections, FX swaps or asset purchases) to stabilize funding markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="brics_alignment_growth" />
          <attvalue for="38" value="global_rate_shock" />
          <attvalue for="27" value="0" />
