      <edge source="global_rate_shock::policy_rate_expectations" target="ai_safety_race::frontier_dev_speed" id="504">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Higher expected policy rates raise the effective cost of equity and debt for AI firms and investors, compressing venture and corporate funding and causing firms to postpone hires, large training runs and multi‑quarter R&amp;D projects, which slows frontier development." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="ai_safety_race" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_shock::policy_rate_expectations" target="brics_alignment_growth::cross_border_capital" id="505">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher expected short-term policy rates in major central banks reprices institutional portfolios and draws yield-sensitive flows toward higher‑rate jurisdictions, increasing the volume and directional intensity of cross-border capital movements." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="brics_alignment_growth" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_rate_shock::policy_rate_expectations" target="gulf_energy_flashpoint::global_oil_price_level" id="506">
