          <attvalue for="28" value="1" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Expanded central‑bank market operations (liquidity provision/asset purchases) lower short‑term funding stress and stabilize asset prices, enabling some firms to sustain R&amp;D budgets and complete planned training runs, producing a modest uptick in frontier development speed." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_shock" />
