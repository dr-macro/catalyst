          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher market liquidity reduces hedging and financing costs for oil traders and shipping firms and enables faster price discovery, decreasing market participants' perceived probability and severity of supply disruptions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_rate_shock" />
          <attvalue for="38" value="gulf_energy_flashpoint" />
          <attvalue for="27" value="0" />
