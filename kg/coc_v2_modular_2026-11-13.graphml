<edge source="global_inflation_bond_st::consumer_price_inflation" target="middle_east_ir_escalatio::infra_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Fast-rising consumer prices (especially for food and fuel) sharply increase household hardship in import-dependent Middle Eastern populations, triggering protests and empowerment of militant groups that target energy infrastructure as a means of disruption or bargaining.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_inflation_bond_st</data>
  <data key="d40">middle_east_ir_escalatio</data>
</edge>
<edge source="global_inflation_bond_st::consumer_price_inflation" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A rise in consumer price inflation increases domestic political pressure and fiscal strain in Western governments, prompting cuts or slower approval of military and economic aid packages to Ukraine and thereby reducing policy alignment and burden‑sharing among allies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_inflation_bond_st</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_inflation_bond_st::consumer_price_inflation" target="transatlantic_security_s::domestic_polarization" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Sharp increases in consumer prices quickly raise household economic pain and political salience of redistribution and blame, empowering populist and opposition actors and thereby increasing domestic political polarization.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_inflation_bond_st</data>
  <data key="d40">transatlantic_security_s</data>
</edge>
<edge source="global_inflation_bond_st::consumer_price_inflation" target="transatlantic_security_s::negotiation_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Persistent or sudden inflation spikes—especially in energy and food—force governments to pursue urgent diplomatic talks and supplier agreements to secure prices and supplies, increasing the frequency and resource intensity of negotiations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_inflation_bond_st</data>
  <data key="d40">transatlantic_security_s</data>
</edge>
<edge source="global_inflation_bond_st::consumer_price_inflation" target="us_china_tech_rivalry::export_control_restrict" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Sustained consumer inflation heightens political and industrial concern about domestic supply resilience for strategic goods, prompting policymakers to tighten export restrictions on advanced semiconductors to prioritize internal allocation and blunt external price/availability shocks.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_inflation_bond_st</data>
  <data key="d40">us_china_tech_rivalry</data>
