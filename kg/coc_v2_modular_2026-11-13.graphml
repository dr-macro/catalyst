  <data key="d34">-</data>
</edge>
<edge source="transatlantic_security_s::domestic_polarization" target="transatlantic_security_s::military_posture" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="transatlantic_security_s::domestic_polarization" target="transatlantic_security_s::deterrence_credibility" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">-</data>
</edge>
<edge source="transatlantic_security_s::domestic_polarization" target="transatlantic_security_s::info_polarization" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">3</data>
  <data key="d34">+</data>
</edge>
<edge source="transatlantic_security_s::domestic_polarization" target="middle_east_ir_escalatio::diplomatic_engagement" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising domestic political polarization in transatlantic capitals reduces policy continuity, constrains bipartisan backing for overseas initiatives, and narrows political bandwidth, thereby directly lowering the frequency and depth of allied diplomatic engagement in the Middle East.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">transatlantic_security_s</data>
  <data key="d40">middle_east_ir_escalatio</data>
</edge>
<edge source="transatlantic_security_s::domestic_polarization" target="russia_ukraine_war::military_coercion_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Rising polarization in major transatlantic states reduces political consensus for sustained arms, funding and risk-taking, producing capability gaps that Russia can exploit by increasing coercive military actions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">transatlantic_security_s</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="transatlantic_security_s::domestic_polarization" target="us_china_tech_rivalry::investigation_activity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Rising partisan polarization increases incentives for legislative and oversight bodies to initiate high‑profile probes of firms with China ties, raising the rate and intensity of formal investigations into the sector.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">transatlantic_security_s</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="transatlantic_security_s::economic_interdependence" target="transatlantic_security_s::negotiation_intensity" id="0">
