<edge source="us_china_tech_rivalry::reg_scrutiny_intensity" target="middle_east_ir_escalatio::diplomatic_engagement" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Marked increases in US regulatory scrutiny of Chinese tech firms generate reciprocal political hardening in Beijing, reducing Chinese willingness to participate in or back US-led or mediated diplomatic de‑escalation initiatives in the Middle East.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">middle_east_ir_escalatio</data>
</edge>
