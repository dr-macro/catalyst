</edge>
<edge source="us_china_tech_rivalry::supply_chain_pressure" target="global_inflation_bond_st::consumer_price_inflation" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Acute tightness and longer lead times for AI‑chip fabrication and packaging raise producer input costs and create shortages for downstream goods (electronics, autos), which firms pass through to consumer prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">global_inflation_bond_st</data>
</edge>
<edge source="us_china_tech_rivalry::supply_chain_pressure" target="middle_east_ir_escalatio::military_tension_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Severe chip supply‑chain stress prompts states and companies to push for protected sea lines and on‑the‑ground security for key shipments, leading to more naval escorts, interdiction operations and forward deployments in chokepoints (e.g., Strait of Hormuz), increasing the likelihood of tense military encounters.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">middle_east_ir_escalatio</data>
</edge>
<edge source="us_china_tech_rivalry::supply_chain_pressure" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Acute shortages and allocation pressures for advanced chips force governments to prioritize national civilian and defense customers and restrict exports, triggering allocation disputes and unilateral industrial policy measures among allies that weaken coordinated sanctions, arms transfers and diplomatic messaging on Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="us_china_tech_rivalry::supply_chain_pressure" target="transatlantic_security_s::energy_vuln" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Acute chip supply stresses push governments and firms to onshore or cluster production capacity quickly, concentrating large new electricity loads and temporary fuel/logistics demands that strain grids and increase susceptibility to outages or targeted disruption.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">transatlantic_security_s</data>
</edge>
