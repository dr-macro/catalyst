          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Elevated investment spending in AI infrastructure boosts near‑term aggregate demand and input-price pressures (construction, electricity, semiconductors), prompting markets to revise up expected central-bank tightening over the policy horizon." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="tech_supply_divide" />
          <attvalue for="38" value="global_finance_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
