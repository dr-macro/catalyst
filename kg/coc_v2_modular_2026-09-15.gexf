          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Visible, large investments into AI infrastructure lower marginal training costs and signal commercial viability, directly attracting additional finance into frontier model R&amp;D and commercialization by improving expected returns on upstream bets." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="tech_supply_divide" />
          <attvalue for="38" value="ai_governance" />
          <attvalue for="27" value="0" />
