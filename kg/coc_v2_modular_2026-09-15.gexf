          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A rise in policy interest rates raises the cost of borrowing and increases discount rates for investors and VC funds, causing immediate pull‑backs or down‑valuations of capital committed to high‑burn, long‑horizon frontier AI projects." />
