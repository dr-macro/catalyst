          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher short‑term policy rates raise corporate borrowing costs and tighten working‑capital budgets, prompting enterprises to defer non‑critical cloud deployments and scale‑ups, which lowers near‑term cloud capacity utilization." />
