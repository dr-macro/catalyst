          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter policy rates raise borrowing and hedging costs and reduce market liquidity, causing insurers, traders and investors to demand wider risk premia on oil and shipping exposures." />
