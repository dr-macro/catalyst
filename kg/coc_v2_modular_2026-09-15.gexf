          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Increased investment in AI/compute infrastructure funds procurement and deployment of maritime ISR, long‑endurance drones and autonomous surface/underwater craft by states and private security firms, enabling more persistent patrols and higher deployed naval/maritime security presence around chokepoints." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="tech_supply_divide" />
