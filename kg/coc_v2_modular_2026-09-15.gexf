      <edge source="tech_supply_divide::infra_capital_flow" target="global_finance_shift::long_term_govt_yield" id="821">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sustained rise in capital directed to AI data centers and related fixed assets leads firms and municipalities to issue more long-dated debt and reallocates investor demand away from sovereign bonds, exerting upward pressure on benchmark long-term yields." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="tech_supply_divide" />
          <attvalue for="38" value="global_finance_shift" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
