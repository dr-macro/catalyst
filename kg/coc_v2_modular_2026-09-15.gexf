          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rise in short-term policy rates depresses aggregate demand and freight/industrial activity within months, reducing near‑term energy consumption and easing price and supply pressure on energy markets." />
