        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp spikes in global staple and energy prices driven by the conflict intensify competition among major powers for secure supplies and open markets, prompting more aggressive trade diplomacy, resource-linked alignments, and public confrontation that raise US–China geopolitical tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
