          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rising risk of regulatory expropriation in energy-producing jurisdictions causes dealers and funds to withdraw market-making capacity and reduce willingness to hold affected sovereign/corporate bonds, widening spreads and reducing depth in those bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
