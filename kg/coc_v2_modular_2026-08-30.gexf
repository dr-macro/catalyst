      </edge>
      <edge source="us_china_rivalry::export_control_stringenc" target="energy_market_shift::asset_transfer_flow" id="411">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Tighter export controls raise compliance, licensing and legal risks for foreign energy firms operating with counterparties in restricted jurisdictions, prompting accelerated divestments and forced sales that increase the rate of energy asset transfers." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::export_control_stringenc" target="global_financial_tension::portfolio_realloc_rate" id="412">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharper, more strictly enforced export controls on semiconductor technology create abrupt earnings and strategic-viability uncertainty for targeted firms and supply-chain participants, prompting discretionary and systematic funds to rebalance portfolios away from exposed sectors and jurisdictions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::export_control_stringenc" target="iran_war_stalemate::finance_rerouting" id="413">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Tightened export controls on dual-use semiconductors and related services incentivize Iranian actors and their intermediaries to shift payments into alternative channels, escrow arrangements, and non‑USD/via third‑country conduits to procure restricted goods, increasing finance rerouting." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::export_control_stringenc" target="russia_ukraine_war::military_intensity" id="414">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Tighter U.S. export controls on advanced semiconductors and equipment reduce the flow of high-end chips and componentry (directly or via Chinese intermediaries) into Russia's weapons supply chain, degrading precision-guided munitions and ISR capabilities and thereby lowering the scale and tempo of Russian kinetic operations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
