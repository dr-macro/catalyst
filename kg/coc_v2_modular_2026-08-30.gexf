          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rapid transfers and reflagging of energy assets and tankers to evade restrictions increase insurer refusals, port denials and inspections, elevating the risk of delays, seizures and route detours." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="iran_war_stalemate" />
