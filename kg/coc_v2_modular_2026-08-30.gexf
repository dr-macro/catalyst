      <edge source="russia_ukraine_war::logistics_disruption" target="energy_market_shift::capital_flow_oil" id="199">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Damage to ports, pipelines and transit corridors in the Black Sea/adjacent export routes constrains supply reliability for region-linked crude, increasing returns to non-conflict upstream projects and causing investors to reallocate capital toward alternative oil developments." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
