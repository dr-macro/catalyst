      <edge source="russia_ukraine_war::export_throughput_rate" target="global_financial_tension::portfolio_realloc_rate" id="207">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A fall in agricultural export throughput raises near-term sovereign and corporate revenue uncertainty for exporters and trade-linked markets, prompting faster shifts of investor allocations into defensive assets and away from affected EM and commodity-linked positions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::export_throughput_rate" target="iran_war_stalemate::domestic_pressure" id="208">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A fall in Ukrainian/Russian agricultural export throughput tightens global staple supplies and raises food inflation in import-dependent markets like Iran, increasing consumer hardship and domestic political pressure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
