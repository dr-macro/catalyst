          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Elevated risk of maritime transit interruptions pushes firms to shorten and regionalize sourcing, increasing concentration of critical semiconductor suppliers and production in a smaller set of 'trusted' locations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_war_stalemate" />
