          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="A sustained increase in upstream oil investment raises near- to mid-term global supply expectations and downward pressure on oil prices, lowering Russia's export receipts and therefore its fiscal capacity to finance high-intensity military operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
