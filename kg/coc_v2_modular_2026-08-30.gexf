      <edge source="russia_ukraine_war::logistics_disruption" target="energy_market_shift::expropriation_risk" id="200">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Severe and sustained disruption of fuel and oil transport infrastructure prompts host governments to impose emergency controls, relicense operations, or seize facilities to secure domestic supply, raising the probability of regulatory expropriation of foreign energy assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::logistics_disruption" target="global_financial_tension::bond_market_liquidity" id="201">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.66" />
          <attvalue for="36" value="Widespread damage to ports and transport nodes strains cash flows and credit in trade-exposed corporates and dealer inventories, causing market makers to pull back and bid-ask spreads to widen, reducing bond-market liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::logistics_disruption" target="iran_war_stalemate::shipping_disruption" id="202">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Damage to Black Sea logistics and port nodes diverts cargo onto longer routes and through regional chokepoints (e.g., Suez, Strait of Hormuz), increasing congestion, insurance costs and the probability of maritime incidents in the same corridors used around Iran." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::logistics_disruption" target="us_china_rivalry::chip_production_capacity" id="203">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Damage and closure of Black Sea ports and overland logistics chokepoints increase shipping times, insurance costs and shortages for specialty gases, substrates and other inputs that flow through those routes, causing affected fabs to curtail runs and temporarily reduce chip production capacity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
