          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rapid transfers of energy assets into state-aligned or sanctioned-insulated owners enable continuity of export operations and revenue capture that can be redirected to military spending and logistics for ongoing combat operations." />
