      <edge source="iran_war_stalemate::shipping_disruption" target="global_financial_tension::bond_market_liquidity" id="74">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Increased risk of maritime interruptions spikes volatility and counterparty/funding strains, causing dealers to pull back and bid-ask spreads to widen, reducing bond market liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_war_stalemate" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
