      <edge source="iran_war_stalemate::shipping_disruption" target="us_china_rivalry::geopolitical_tension_lev" id="76">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Repeated Iran-related attacks and insurance-cost spikes on key maritime routes force the U.S. and China into naval escorts, competing port-access diplomacy, and security guarantees that raise bilateral strategic tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_war_stalemate" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
