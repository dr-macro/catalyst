      <edge source="russia_ukraine_war::commodity_price_level" target="global_financial_tension::long_term_yield" id="211">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Sustained increases in staple commodity prices lift inflation expectations and inflation risk premia, which market participants price into nominal long-term sovereign yields, pushing those yields higher." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::commodity_price_level" target="iran_war_stalemate::domestic_pressure" id="212">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A sustained rise in global staple commodity prices transmits directly into higher food and transport costs in Iran, amplifying cost-of-living stress and the likelihood of protests and political unrest." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
