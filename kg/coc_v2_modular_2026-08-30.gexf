      <edge source="us_china_rivalry::geopolitical_tension_lev" target="energy_market_shift::sanction_pressure" id="441">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rising US–China strategic tension leads policymakers and allied governments to expand and coordinate targeted economic measures and secondary sanctions against firms and transactions linked to the other side, directly increasing international sanction pressure on energy deals." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::geopolitical_tension_lev" target="energy_market_shift::control_share_reserves" id="442">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="As US–China rivalry intensifies, host governments implement restrictions, renegotiations or reassignments that reduce the effective share of proven reserves under external actors' control to secure domestic strategic autonomy." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::geopolitical_tension_lev" target="global_financial_tension::portfolio_realloc_rate" id="443">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Acute rises in geopolitical tension (e.g., sanctions, military incidents, diplomatic escalation) trigger rapid risk-off behavior and cross-asset selling by global investors, driving accelerated reallocations into perceived safe assets and away from exposed equities and emerging-market positions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::geopolitical_tension_lev" target="iran_war_stalemate::shipping_disruption" id="444">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising US–China strategic tensions drive greater naval presence, surveillance and contestation around key sea lanes and chokepoints, raising the probability of interdictions, inspections, and insurance/operational interruptions that disrupt shipping serving the Iran theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::geopolitical_tension_lev" target="iran_war_stalemate::oil_export_constraint" id="445">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating great‑power rivalry increases diplomatic pressure and coordinated administrative measures (port denials, reflagging pressure, insurance restrictions) among allied partners that effectively constrain or slow Iranian oil exports." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
