      <edge source="energy_market_shift::sanction_pressure" target="global_financial_tension::short_term_rate" id="807">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Heightened sanction pressure restricts correspondent banking and dollar-clearing relationships for targeted counterparties, shrinking short-term funding supply and forcing banks to raise overnight and short-term lending rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_shift::sanction_pressure" target="iran_war_stalemate::finance_rerouting" id="808">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Heightened sanctions on energy transactions prompt banks, traders and states to shift payments into alternative currencies, correspondent banks and opaque intermediaries to preserve oil trade." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_shift::sanction_pressure" target="iran_war_stalemate::domestic_pressure" id="809">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Increased sanction pressure on the energy sector directly reduces export receipts and curtails imports of critical goods, producing inflation, shortages and protests that raise domestic political pressure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_shift::sanction_pressure" target="russia_ukraine_war::military_intensity" id="810">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Tightened international energy sanctions curtail Russian oil and gas export volumes and access to payment/finance channels, materially reducing budgetary revenue available for arms procurement, mobilization and sustainment of operations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_shift::sanction_pressure" target="russia_ukraine_war::export_throughput_rate" id="811">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalated energy-related sanctions targeting shipping, insurance and port services raises transit risk and rerouting costs in the Black Sea and adjacent corridors, causing delays and reduced volumes of Ukrainian agricultural exports reaching global markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_shift::sanction_pressure" target="us_china_rivalry::geopolitical_tension_lev" id="812">
