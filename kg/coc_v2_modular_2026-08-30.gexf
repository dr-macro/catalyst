      <edge source="russia_ukraine_war::military_intensity" target="energy_market_shift::sanction_pressure" id="185">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Marked escalations in combat (major offensives, strategic strikes) trigger immediate political and public pressure on Western and allied governments to impose additional energy-related sanctions (exports, finance, services) against parties linked to the aggression." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_intensity" target="energy_market_shift::asset_transfer_flow" id="186">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Increased fighting raises operational, legal and reputational risk for foreign energy firms operating in or exposed to the conflict, prompting accelerated divestments, forced sales, or formal transfers of ownership of energy assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_intensity" target="global_financial_tension::monetary_signal_strength" id="187">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Acute escalation in military operations raises macro and financial-market uncertainty (inflation and growth risks), prompting central banks to issue clearer or more forceful forward guidance to anchor expectations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_intensity" target="us_china_rivalry::export_control_stringenc" id="188">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A marked escalation in Russian kinetic operations that reveals or increases use of imported dual-use electronics and battlefield dependence on foreign components prompts US policymakers to broaden and tighten semiconductor export controls and end-user restrictions to limit diversion to adversaries (including precautionary measures directed at China)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_intensity" target="us_china_rivalry::fab_investment_rate" id="189">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sustained, high-intensity conflict increases perceived supply-chain and strategic risk among Western governments and firms, accelerating public subsidies, approvals, and private commitments to build domestic/allied fabs to reduce dependence on rivals and thereby raising the near‑term rate of fab investment starts." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
