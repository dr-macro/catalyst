          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Increased risk that host governments will seize or alter asset ownership reduces foreign semiconductor firms' willingness to commit capital to new fabs, slowing the rate of fab investment in affected jurisdictions." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="energy_market_shift" />
