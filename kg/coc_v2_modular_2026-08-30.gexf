      <edge source="energy_market_shift::capital_flow_oil" target="global_financial_tension::portfolio_realloc_rate" id="835">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A rapid increase or retrenchment of capital into the oil sector compels institutional investors to rotate allocations (selling or buying other asset classes) to rebalance exposures, raising the observable pace of portfolio reallocation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_shift::capital_flow_oil" target="iran_war_stalemate::economic_warfare" id="836">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A surge in foreign capital into a sanctioned jurisdiction's oil sector provokes reciprocal coercive measures (targeted sanctions, asset freezes, trade restrictions) by adversaries seeking to block or punish those investments." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_market_shift::capital_flow_oil" target="russia_ukraine_war::military_intensity" id="837">
        <attvalues>
