          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Expanding sanction regimes create legal frameworks and domestic political momentum that are translated into stricter, more broadly enforced semiconductor export controls to limit strategic transfers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_market_shift" />
          <attvalue for="39" value="us_china_rivalry" />
