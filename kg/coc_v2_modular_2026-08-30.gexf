      <edge source="global_financial_tension::portfolio_realloc_rate" target="global_financial_tension::intermediary_funding_cos" id="639">
        <attvalues>
          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="2" />
          <attvalue for="33" value="+" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_tension::portfolio_realloc_rate" target="energy_market_shift::asset_transfer_flow" id="640">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A faster pace of investor reallocations toward commodity exposure or resource equities increases demand for direct ownership of oil assets and drives more M&amp;A, joint-venture deals and formal asset transfers in the upstream sector." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_tension::portfolio_realloc_rate" target="iran_war_stalemate::finance_rerouting" id="641">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="When investors rapidly reallocate away from region- or sanction-exposed assets, banks and intermediaries curtail correspondent relationships and payment services for those clients, forcing corporates and banks to route transactions through alternative channels, currencies, or non‑standard intermediaries." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="iran_war_stalemate" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_tension::portfolio_realloc_rate" target="russia_ukraine_war::commodity_price_level" id="642">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Rapid portfolio reallocation into commodity futures and physical agricultural hedges (flight to hard assets) increases speculative and physical demand for grains/oilseeds, pushing up spot and futures prices within weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_financial_tension::portfolio_realloc_rate" target="us_china_rivalry::chip_production_capacity" id="643">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A rapid investor reallocation away from capital‑intensive and illiquid tech assets reduces available equity and growth capital for chipmakers and fabs, slowing project financing, construction starts and near‑term capacity additions." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_financial_tension" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
