          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Increased U.S.–China rivalry raises trade frictions, shipping risk premia and insurance costs and prompts precautionary stockpiling and rerouting, which together push up global prices for staple commodities (grains and related agricultural commodities)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
