      <edge source="iran_war_stalemate::finance_rerouting" target="energy_market_shift::asset_transfer_flow" id="118">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="The expansion of alternative payment channels and non‑standard settlement mechanisms enables sanctioned or high-risk buyers to fund and close transactions that previously were blocked, increasing the rate of energy asset ownership transfers to nontraditional actors." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_war_stalemate" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_war_stalemate::finance_rerouting" target="global_financial_tension::portfolio_realloc_rate" id="119">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Redirection of cross-border flows into alternative rails and currencies forces institutional investors to rebalance allocations more rapidly away from assets tied to disrupted channels, raising the pace of portfolio reallocation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_war_stalemate" />
          <attvalue for="39" value="global_financial_tension" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_war_stalemate::finance_rerouting" target="us_china_rivalry::export_control_stringenc" id="120">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Wider use of alternative payment rails and intermediaries to evade Iran-related sanctions motivates U.S. policymakers to broaden and tighten semiconductor export controls to block circumvention channels." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_war_stalemate" />
          <attvalue for="39" value="us_china_rivalry" />
