          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Increased risk of maritime interdiction or route instability makes cross-border due diligence and deal execution more costly and uncertain, slowing or cancelling planned sales and transfers of energy assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_war_stalemate" />
          <attvalue for="39" value="energy_market_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
