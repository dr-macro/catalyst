      <edge source="iran_war_stalemate::shipping_disruption" target="russia_ukraine_war::export_throughput_rate" id="75">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher risk and incidents to major maritime routes (Suez/Red Sea) force rerouting, increase insurance and voyage times and reduce vessel availability, directly lowering the volume-per-time of agricultural shipments leaving Ukraine and other exporters." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_war_stalemate" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
