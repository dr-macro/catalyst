          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="High-frequency, high-intensity diplomatic signaling (public warnings, red-lines, mobilized rhetoric) increases adversary threat perception and domestic political pressure, raising the probability of tit-for-tat reprisals and accelerating escalation dynamics." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="russia_ukraine_war" />
