      <edge source="western_alliance_realign::integration_pressure" target="iran_regional_conflict::chokepoint_transit_cap" id="708">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Institutional integration pressure facilitates coordinated maritime enforcement (escorts, embargo enforcement, temporary closures) to implement collective measures, which can temporarily reduce throughput through narrow sea chokepoints like the Strait of Hormuz." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
