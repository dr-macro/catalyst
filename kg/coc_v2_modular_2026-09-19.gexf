          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sharp escalation in Ukraine ties down diplomatic and military attention and creates perceived windows of opportunity that Iranian leadership and proxy groups exploit to increase kinetic operations in the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_regional_conflict" />
