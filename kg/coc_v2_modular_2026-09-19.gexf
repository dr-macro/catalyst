          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Hikes in short-term policy rates increase bank lending costs and corporate borrowing rates for working capital and project loans, prompting firms to delay or cancel near-term capex in semiconductor and related manufacturing." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="us_china_tech_rivalry" />
