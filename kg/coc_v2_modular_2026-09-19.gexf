      <edge source="western_alliance_realign::diplomatic_signal_flow" target="iran_regional_conflict::oil_price_level" id="744">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalating public diplomatic signals (threats, warnings, announced red lines) increase market perceptions of imminent supply disruption and drive near-term oil price spikes as traders reprice short-term risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
