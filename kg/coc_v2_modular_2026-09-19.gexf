      <edge source="iran_regional_conflict::conflict_intensity" target="global_bond_rate_shock::cross_border_flows" id="77">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Escalating military intensity in the region triggers risk‑off portfolio shifts and mandate/liquidity withdrawals by global investors, producing net capital outflows from exposed countries and into safe‑haven assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::conflict_intensity" target="global_bond_rate_shock::bond_market_liquidity" id="78">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher conflict intensity raises counterparty, operational and sanction risks for market‑makers and funds, prompting inventory cuts, wider dealer spreads and reduced willingness to trade, which directly compresses bond market liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::conflict_intensity" target="russia_ukraine_war::escalation_dynamics" id="79">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An intensification of kinetic operations in the Iran regional conflict draws US/NATO naval and air assets and political attention away from Europe, lowering short-term deterrence signaling and increasing opportunities and incentives for Russia to take escalatory actions in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::conflict_intensity" target="us_china_tech_rivalry::export_control_str" id="80">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sharp escalations and high‑profile kinetic activity attributed to Iran or its proxies prompt policymakers to broaden and tighten export controls on dual‑use and advanced technologies to prevent diversion and limit adversary access." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::conflict_intensity" target="western_alliance_realign::diplomatic_signal_flow" id="81">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Sharper and more frequent kinetic incidents prompt emergency consultations, ministerial calls, public statements and high-level visits among Western capitals to coordinate responses and deconfliction." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="western_alliance_realign" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::conflict_intensity" target="western_alliance_realign::policy_alignment_level" id="82">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Escalating military activity produces a shared threat assessment that drives coordinated sanctions, arms transfers and unified diplomatic positions across Western governments." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
