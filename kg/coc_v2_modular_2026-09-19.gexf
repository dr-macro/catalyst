          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher short-term policy rates raise borrowing and rollover costs for donor governments and defence contractors, tightening fiscal space and delaying or scaling back procurement and payments that fund weapons deliveries to Ukraine." />
