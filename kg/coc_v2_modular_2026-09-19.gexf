          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Stronger institutional pressure for integration drives joint subsidy schemes, pooled procurement commitments and regulatory harmonisation that make investment in allied tech manufacturing projects comparatively more attractive, redirecting private and public capital into those builds." />
