      <edge source="russia_ukraine_war::weapons_transfer_rate" target="global_bond_rate_shock::bond_market_liquidity" id="183">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Rapid escalation in weapons deliveries raises counterparty and settlement risks (and can trigger secondary sanctions), causing primary dealers and market-makers to reduce inventories and repo/intermediation activity, thereby degrading bond market liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_rate_shock" />
