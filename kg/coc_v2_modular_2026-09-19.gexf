      <edge source="global_bond_rate_shock::cross_border_flows" target="us_china_tech_rivalry::capital_invest_flow" id="586">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A global bond-rate-induced reallocation of capital toward higher sovereign yields draws down cross-border financing available for foreign direct investment and project finance, directly reducing the flow of funds into capital‑intensive tech manufacturing projects." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_rate_shock" />
          <attvalue for="39" value="us_china_tech_rivalry" />
