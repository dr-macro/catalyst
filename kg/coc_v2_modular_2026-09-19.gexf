          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="An elevated risk premium tied to the regional conflict raises the cost of debt and required returns, directly reducing the willingness of firms and sponsors to commit the large, long‑dated capital needed for new tech and fab projects." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::financial_risk_premium" target="western_alliance_realign::policy_alignment_level" id="97">
