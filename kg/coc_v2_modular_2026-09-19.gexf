          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater pressure toward formal integration enables synchronized sanctions, secondary measures and regulatory alignments that raise counterparty and sovereign risk perceptions, lifting spreads, insurance costs and other geopolitical risk premia for the region." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::integration_pressure" target="russia_ukraine_war::weapons_transfer_rate" id="710">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Institutional integration pressure creates fast-track agreement mechanisms and standing procedures (e.g., mutual-assistance clauses and harmonized export approvals) that directly accelerate and increase cross-border weapons deliveries into Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
