          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A surge in weapons and electronics transfers diverts scarce components, testing capacity and logistics into military channels, producing immediate shortages and degradation in the commercial semiconductor supply chain's ability to absorb and recover from shocks relevant to the US–China rivalry." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
