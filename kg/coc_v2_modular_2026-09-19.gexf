          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rapid uptick in escalation creates emergency risk assessments and legal/political cover for the U.S. and partners to broaden and accelerate export-control lists and enforcement (covering dual‑use and semiconductor-related items), tightening flows relevant to the US–China tech competition within weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
