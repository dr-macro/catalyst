      <edge source="russia_ukraine_war::battlefield_intensity" target="global_bond_rate_shock::bond_market_volatility" id="162">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Sharp increases in battlefield activity produce sudden geopolitical-risk repricing and rapid portfolio rebalancing (flight-to-quality and hedging trades), driving up realized and implied volatility in global bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::battlefield_intensity" target="iran_regional_conflict::oil_price_level" id="163">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Large spikes in kinetic intensity in Ukraine heighten market fears about Russian export disruptions and sanction spillovers, driving an immediate rise in global crude prices through supply-risk premia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::battlefield_intensity" target="us_china_tech_rivalry::capital_invest_flow" id="164">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sustained high battlefield intensity raises urgency about defense‑relevant supply vulnerabilities, prompting accelerated government subsidies and private capital commitments to domestic/ally chip fabs and tooling to insulate the U.S. tech base from rivals like China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
