          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp shifts or reversals in cross‑border capital flows trigger rapid government-to-government outreach (official visits, public assurances, coordination requests for swap lines or capital controls), increasing the frequency and intensity of diplomatic signaling among allied states." />
