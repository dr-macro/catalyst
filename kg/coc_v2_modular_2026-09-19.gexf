      <edge source="western_alliance_realign::integration_pressure" target="global_bond_rate_shock::bond_market_liquidity" id="707">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Increased institutional integration_pressure produces regulatory harmonization and centralized clearing/settlement arrangements that reduce market fragmentation and increase depth and ease of trading in sovereign and corporate bonds, improving liquidity." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
