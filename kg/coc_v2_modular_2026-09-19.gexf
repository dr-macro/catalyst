          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger Western alliance coordination on trade, investment screening and industrial incentives channels new fab and supplier contracts toward a smaller set of allied jurisdictions, increasing geographic concentration of advanced semiconductor production among friendly nodes and away from China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
