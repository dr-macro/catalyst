      <edge source="russia_ukraine_war::alliance_cohesion" target="iran_regional_conflict::financial_risk_premium" id="209">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger cohesion among Western allies over the Ukraine crisis lowers uncertainty about coordinated responses in adjacent theatres, which reduces geopolitical risk spreads and thus the financial risk premium priced into markets tied to Middle East exposures." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
