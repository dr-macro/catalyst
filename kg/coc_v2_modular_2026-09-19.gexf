      <edge source="iran_regional_conflict::financial_risk_premium" target="global_bond_rate_shock::bond_market_volatility" id="94">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rise in the geopolitical financial risk premium causes rapid repricing across fixed‑income markets (widening spreads, forced de‑leveraging and larger bid/ask moves), which directly increases realized and implied bond-market volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::financial_risk_premium" target="russia_ukraine_war::weapons_transfer_rate" id="95">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher geopolitical risk premia increase financing and insurance costs for arms purchases and long-distance logistics, prompting buyers and suppliers to defer or scale back deliveries of weapons and ammunition to Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::financial_risk_premium" target="us_china_tech_rivalry::capital_invest_flow" id="96">
        <attvalues>
