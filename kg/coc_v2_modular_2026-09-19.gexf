      <edge source="russia_ukraine_war::alliance_cohesion" target="global_bond_rate_shock::cross_border_flows" id="208">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Increased cohesion among Western allies enables coordinated sanctions, asset freezes and regulatory measures that accelerate capital flight from Russian/targeted assets and redirect net cross-border flows into core sovereign bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_rate_shock" />
