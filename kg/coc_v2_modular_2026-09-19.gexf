      <edge source="iran_regional_conflict::chokepoint_transit_cap" target="global_bond_rate_shock::long_term_yield" id="37">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A sustained fall in shipping chokepoint throughput creates persistent supply insecurity for energy and goods, lifting inflation expectations and term premia and thereby pushing up long‑term sovereign yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::chokepoint_transit_cap" target="russia_ukraine_war::weapons_transfer_rate" id="38">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Attacks or closures that reduce throughput at Middle Eastern chokepoints force rerouting, lengthen transit times and raise insurance/logistics costs, causing delays and reduced volume of weapons and heavy equipment shipments destined for Europe and Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::chokepoint_transit_cap" target="us_china_tech_rivalry::supply_chain_resilience" id="39">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Reductions in throughput at key Middle East maritime chokepoints from attacks or interdiction directly increase transit delays, route fragility and single‑point dependencies, thereby degrading the resilience of semiconductor supply networks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="us_china_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::chokepoint_transit_cap" target="western_alliance_realign::integration_pressure" id="40">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Reductions in chokepoint throughput (i.e., lower transit capacity) increase political pressure to create formal collective maritime security, shared logistics and preferential corridor arrangements among Western institutions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="western_alliance_realign" />
          <attvalue for="28" value="0" />
