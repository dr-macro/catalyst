      <edge source="russia_ukraine_war::weapons_transfer_rate" target="iran_regional_conflict::conflict_intensity" id="184">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sustained increases in outside weapons deliveries into the Ukraine theatre push Russia to source arms (notably UAVs and munitions) from Iran and accelerate Iran's production/exports, enabling wider distribution of Iranian systems to regional proxies and raising regional fighting levels." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
