          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sustained spike in oil prices raises Russia's hydrocarbon export revenues and fiscal space, enabling faster procurement, ammunition production and sustainment of deployed forces, thereby improving Russia's relative military capability in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
