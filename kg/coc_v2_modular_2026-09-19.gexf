      <edge source="western_alliance_realign::diplomatic_signal_flow" target="global_bond_rate_shock::bond_market_volatility" id="743">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large spikes in diplomatic_signal_flow (public threats, visible military coordination, or high-profile escalatory statements) cause immediate repricing of geopolitical risk and generate higher short-term realised and implied volatility in bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="global_bond_rate_shock" />
