          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Sustained rises in geopolitical risk premia raise the cost of cross-border financing and fiscal exposure, prompting allied governments to harmonize financial measures, sanctions enforcement and market-support policies." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="western_alliance_realign" />
          <attvalue for="28" value="0" />
