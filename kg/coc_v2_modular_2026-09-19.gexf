      <edge source="western_alliance_realign::policy_alignment_level" target="global_bond_rate_shock::bond_market_volatility" id="678">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rise in policy_alignment_level among Western governments reduces geopolitical and policy uncertainty, prompting investors to cut risk premia and lowering short- to medium-term realised and implied bond-market volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="global_bond_rate_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::policy_alignment_level" target="iran_regional_conflict::conflict_intensity" id="679">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A higher level of allied policy alignment rapidly enables coordinated military authorization, intelligence-sharing and joint operations against Iranian forces and proxies, producing immediate upticks in kinetic engagements and reciprocal strikes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::policy_alignment_level" target="russia_ukraine_war::military_cap_balance" id="680">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Closer policy alignment enables coordinated intelligence sharing, common targeting priorities, and synchronized training/logistics support that directly improve Ukrainian operational effectiveness relative to Russian forces, shifting the military capability balance." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="western_alliance_realign::policy_alignment_level" target="us_china_tech_rivalry::export_control_str" id="681">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher policy alignment among Western allies shortens the diplomatic and legal path to coordinated sanctions and harmonised export-control lists, producing faster and broader tightening of technology transfer restrictions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="western_alliance_realign" />
          <attvalue for="39" value="us_china_tech_rivalry" />
