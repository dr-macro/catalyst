          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Changes in physical flows of oil and refined products from the conflict region (pipelines, export terminals) alter global available supply and prompt near‑term price adjustments as markets rebalance and traders price in shortages or gluts." />
