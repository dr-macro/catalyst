          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A marked increase in external arms deliveries heightens geopolitical tensions and the perceived dual‑use risk of foreign tech, motivating EU regulators to expand export controls and stricter oversight of AI platforms and cross‑border tech transfers." />
