          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Reductions or interruptions in energy shipments to Europe raise operating costs and reliability risk for energy‑intensive AI datacenters and HPC clusters, prompting investors to delay or withdraw funding for regional AI projects." />
