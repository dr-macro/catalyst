      <edge source="china_eu_tech_rivalry::ai_capital_flow" target="opec_energy_volatility::energy_supply_disruption" id="360">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
