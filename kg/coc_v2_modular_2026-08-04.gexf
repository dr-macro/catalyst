      <edge source="us_iran_confront::transit_disruption_rate" target="china_eu_tech_rivalry::ai_asset_price_volatilit" id="60">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Repeated maritime interdictions through key chokepoints create shortfalls and shipment delays for AI hardware (chips, racks), triggering sudden supply‑driven repricing and larger intraday swings in AI‑exposed equities and component suppliers." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="china_eu_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::transit_disruption_rate" target="japan_fx_bond_stress::cross_border_flows" id="61">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Repeated maritime disruptions force Japanese importers to draw on foreign credit lines and pre-finance shipments while exporters accelerate or delay receipts, producing immediate net cross-border capital movements (larger gross flows and temporary net inflows to cover trade financing needs)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="japan_fx_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
