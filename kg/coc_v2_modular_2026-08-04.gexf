      <edge source="rus_ukr_war::cross_border_strike_rate" target="rus_ukr_war::casualty_response_capaci" id="173">
        <attvalues>
          <attvalue for="27" value="intra_causal" />
          <attvalue for="29" value="3" />
          <attvalue for="33" value="-" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="rus_ukr_war::cross_border_strike_rate" target="china_eu_tech_rivalry::regulatory_scrutiny" id="174">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="An uptick in cross‑border strikes that demonstrably employ drones, guidance systems or autonomy accelerates policymaker concern over weaponized AI and drives faster adoption of rules limiting procurement, deployment, and third‑party AI components." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="rus_ukr_war" />
          <attvalue for="39" value="china_eu_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="rus_ukr_war::cross_border_strike_rate" target="japan_fx_bond_stress::investor_positioning" id="175">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising cross-border strike rates heighten acute geopolitical tail risk and prompt global investors to cut directional risk and leverage (e.g., unwind carry trades and long-duration positions), reducing aggregate investor positioning in Japan-linked FX and bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="rus_ukr_war" />
          <attvalue for="39" value="japan_fx_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="rus_ukr_war::cross_border_strike_rate" target="opec_energy_volatility::maritime_transit_risk" id="176">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Increased missile, drone, and naval strikes that target or occur near ports, merchant vessels, and sea lanes raise the probability of ship damage, rerouting, insurance claims, and temporary closures, directly increasing transit risk for commercial shipping." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="rus_ukr_war" />
          <attvalue for="39" value="opec_energy_volatility" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="rus_ukr_war::cross_border_strike_rate" target="opec_energy_volatility::energy_supply_disruption" id="177">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher rates of cross‑border strikes that hit terminals, storage, pipelines, or power infrastructure cause direct outages, export shutdowns, or evacuation of facilities, producing immediate interruptions to oil and gas deliveries." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="rus_ukr_war" />
          <attvalue for="39" value="opec_energy_volatility" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="rus_ukr_war::cross_border_strike_rate" target="us_iran_confront::transit_disruption_rate" id="178">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
