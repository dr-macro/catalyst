          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="An increase in energy supply flow reduces imported energy inflation for Japan, lowering market-implied expectations that the Bank of Japan will need to tighten policy in the near term." />
