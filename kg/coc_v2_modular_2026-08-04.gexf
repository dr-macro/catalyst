      <edge source="us_iran_confront::mil_escalation_threat" target="china_eu_tech_rivalry::regulatory_scrutiny" id="33">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A marked uptick in US–Iran military escalation leads EU and Chinese regulators to fast‑track and broaden AI rules and export controls on dual‑use technologies because policymakers cite immediate national‑security risks, raising the intensity and scope of scrutiny within weeks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="china_eu_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::mil_escalation_threat" target="china_eu_tech_rivalry::ai_capital_flow" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Heightened military confrontation raises geopolitical risk premia and investor risk aversion, causing venture and institutional investors to pull back or delay cross‑border AI funding rounds in China and the EU." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="china_eu_tech_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::mil_escalation_threat" target="opec_energy_volatility::military_engagement_rate" id="35">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising credible threats and posturing increase the probability of preemptive or retaliatory strikes and miscalculation-driven exchanges between forces in the theatre, raising the frequency and intensity of kinetic engagements." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="opec_energy_volatility" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_confront::mil_escalation_threat" target="opec_energy_volatility::maritime_transit_risk" id="36">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Heightened military threat prompts naval interdictions, exclusion zones, harassment of commercial vessels and more aggressive rules of engagement around chokepoints, directly increasing the likelihood that merchant shipping will be attacked, detained or rerouted." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="opec_energy_volatility" />
          <attvalue for="28" value="0" />
        </attvalues>
