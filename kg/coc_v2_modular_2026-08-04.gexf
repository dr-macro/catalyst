          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A spike in US–Iran military escalation diverts strategic air- and sealift, prepositioned stocks, and maintenance/repair capacity toward the Middle East and force-protection tasks, reducing the available logistics throughput and resupply rotations that sustain operations in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
