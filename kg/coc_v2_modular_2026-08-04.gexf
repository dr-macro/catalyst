        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="More frequent incidents raise freight and insurance costs, reduce available tanker capacity and force longer routings or cargo delays, which raise market risk premia and prompt near-term upward moves in benchmark crude prices even before full physical shortages appear." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="opec_energy_volatility" />
          <attvalue for="28" value="0" />
