          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Increased disruptions to shipping through key chokepoints (e.g., tanker attacks, interdictions) force rerouting, delay deliveries and raise insurance/operational constraints that directly reduce timely crude and refined fuel shipments into European and Black Sea supply chains serving Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_confront" />
          <attvalue for="39" value="rus_ukr_war" />
