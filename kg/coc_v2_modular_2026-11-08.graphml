<edge source="china_tech_rivalry::diplomatic_tension" target="global_market_repricing::nominal_govt_bond_yield" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Acute diplomatic escalation (e.g., sanctions or confrontational rhetoric) triggers risk‑off flows into safe‑haven sovereign debt (notably US Treasuries), increasing demand and driving down nominal government bond yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_tech_rivalry</data>
  <data key="d40">global_market_repricing</data>
</edge>
<edge source="china_tech_rivalry::diplomatic_tension" target="russia_ukraine_war::transatl_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Escalating adversarial diplomatic exchanges between China and Western governments force European capitals to weigh economic ties to Beijing against coordinated policy on Ukraine, producing divergent national responses and weakening transatlantic policy alignment and burden‑sharing.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_tech_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="china_tech_rivalry::diplomatic_tension" target="us_iran_escalation::diplomatic_engagement_in" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Rising China–US diplomatic tension makes Beijing less willing and less able to serve as a back‑channel or broker with Tehran, removing a deconfliction/messaging conduit and reducing the frequency and intensity of formal and informal US–Iran diplomatic contacts.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_tech_rivalry</data>
  <data key="d40">us_iran_escalation</data>
</edge>
