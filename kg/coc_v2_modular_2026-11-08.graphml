<edge source="china_tech_rivalry::regulatory_tightness" target="ai_buildout_backlash::financing_cost_datactr" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.72</data>
  <data key="d37">Sharper and less predictable regulatory intervention (permits, local content, data rules) increases project execution and compliance risk for data‑centre builds, prompting lenders and investors to demand higher all‑in financing costs to cover regulatory risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_tech_rivalry</data>
  <data key="d40">ai_buildout_backlash</data>
</edge>
