  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">An increase in unemployment raises political and public pressure over job dislocation from automation/AI, spurring more frequent legislative proposals and regulatory debate and thereby elevating uncertainty about future AI/data‑centre rules.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_market_repricing</data>
  <data key="d40">ai_buildout_backlash</data>
</edge>
<edge source="global_market_repricing::unemployment_rate" target="china_tech_rivalry::regulatory_tightness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A sharp increase in global (and export‑dependent) unemployment weakens external demand, incentivising Beijing to protect domestic employment and strategic domestic champions via tighter, more interventionist regulation and preferential rules for local firms.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_repricing</data>
  <data key="d40">china_tech_rivalry</data>
</edge>
<edge source="global_market_repricing::unemployment_rate" target="russia_ukraine_war::transatl_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Higher unemployment intensifies domestic political pressure to prioritize social and economic relief, eroding public and parliamentary support for sustained allied burden‑sharing and coordinated assistance to Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_market_repricing</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
