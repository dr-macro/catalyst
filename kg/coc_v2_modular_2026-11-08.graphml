<edge source="us_iran_escalation::chokepoint_vulnerability" target="ai_buildout_backlash::credit_spreads_datactr" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Heightened vulnerability of maritime and land transit nodes raises the perceived risk that hardware deliveries and construction timelines will be disrupted, prompting lenders to demand wider spreads on data‑centre loans to cover increased operational and replacement risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_escalation</data>
  <data key="d40">ai_buildout_backlash</data>
</edge>
<edge source="us_iran_escalation::chokepoint_vulnerability" target="china_tech_rivalry::foreign_firm_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Greater vulnerability of Persian Gulf and nearby sea lanes increases shipping disruptions, delay risk and insurance premiums for supply chains linking to China, causing multinational firms to regard operations tied to China as higher operational and reputational risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_escalation</data>
  <data key="d40">china_tech_rivalry</data>
</edge>
<edge source="us_iran_escalation::chokepoint_vulnerability" target="global_market_repricing::headline_inflation_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Physical threats or interdiction of major maritime transit (e.g., Strait of Hormuz) constrains oil and commodity flows and raises freight/energy costs, which pass through quickly to consumer prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_escalation</data>
  <data key="d40">global_market_repricing</data>
</edge>
<edge source="us_iran_escalation::chokepoint_vulnerability" target="russia_ukraine_war::energy_supply_stability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising vulnerability of key Persian Gulf transit chokepoints (e.g., Strait of Hormuz) from US–Iran tensions causes immediate disruptions and insurance/shipping reroutes that reduce and destabilize energy deliveries and fuel availability for European and regional consumers relevant to the Ukraine theatre.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_iran_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
