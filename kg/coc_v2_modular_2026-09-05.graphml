</edge>
<edge source="global_bond_shock::bond_fund_net_flows" target="us_iran_hostilities::financial_market_volatil" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Large net redemptions from bond funds force managers to sell across fixed income and related credit positions into thin markets, amplifying price swings and increasing overall market volatility.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_shock</data>
  <data key="d39">us_iran_hostilities</data>
</edge>
