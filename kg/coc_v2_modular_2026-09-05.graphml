<edge source="china_tech_push::ai_investment_rate" target="energy_supply_shift::tanker_traffic_vol" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher investment in AI funds rapid deployment of port and logistics optimisation systems (berth scheduling, fuel routing, customs automation) in Chinese-controlled hubs, shortening dwell times and increasing the effective throughput of tankers transiting critical chokepoints.</data>
  <data key="d37">6-18 months</data>
