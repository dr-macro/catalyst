  <data key="d28">2</data>
  <data key="d33">+</data>
</edge>
<edge source="global_bond_shock::market_liquidity_bonds" target="china_tech_push::compute_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sharp deterioration in bond‑market liquidity disrupts banks' and corporate treasuries' ability to roll short‑term funding and issue debt for capex, which forces postponement or downsizing of data‑centre builds and therefore reduces near‑term additions to aggregate compute capacity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_shock</data>
  <data key="d39">china_tech_push</data>
</edge>
<edge source="global_bond_shock::market_liquidity_bonds" target="energy_supply_shift::perceived_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A sudden deterioration in bond-market liquidity raises margin and collateral demands across the financial system, forcing commodity traders and refiners to cut physical positions and prompting markets to reassess and raise the perceived probability of near-term fuel supply disruptions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_shock</data>
  <data key="d39">energy_supply_shift</data>
</edge>
<edge source="global_bond_shock::market_liquidity_bonds" target="us_iran_hostilities::maritime_flow_disruption" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sharp deterioration in bond-market liquidity tightens bank balance sheets and trade‑finance availability for shippers and commodity traders, causing shipment delays, cancelled sailings or payment frictions that disrupt maritime flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_shock</data>
  <data key="d39">us_iran_hostilities</data>
</edge>
<edge source="global_bond_shock::cross_border_capflow_rat" target="global_bond_shock::nominal_long_yield" id="0">
