<edge source="us_iran_hostilities::financial_market_volatil" target="china_tech_push::ai_investment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Spikes in market volatility raise cost of capital and institutional risk aversion, causing Chinese corporates and VCs to delay or scale back planned AI capex and fundraising rounds.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_hostilities</data>
  <data key="d39">china_tech_push</data>
</edge>
<edge source="us_iran_hostilities::financial_market_volatil" target="global_bond_shock::market_liquidity_bonds" id="0">
