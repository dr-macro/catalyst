  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.95</data>
  <data key="d36">Higher crude benchmark prices raise refinery feedstock costs and therefore wholesale/spot prices for refined fuels as refiners pass through input cost changes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_hostilities</data>
  <data key="d39">energy_supply_shift</data>
</edge>
<edge source="us_iran_hostilities::oil_price_level" target="russia_ukraine_war::escalation_risk_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A sustained rise in oil prices increases Russia's hydrocarbon revenues and reduces Western political appetite for costly countermeasures, enabling Moscow to finance higher-intensity operations and lowering incentives to avoid escalation.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_hostilities</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
