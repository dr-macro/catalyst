<edge source="us_iran_hostilities::maritime_flow_disruption" target="china_tech_push::ai_investment_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Interruptions to seaborne shipments of servers, storage and networking hardware push cloud providers and hyperscalers to front‑load and localise AI infrastructure investment to secure supply chains and avoid transport risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_hostilities</data>
  <data key="d39">china_tech_push</data>
</edge>
<edge source="us_iran_hostilities::maritime_flow_disruption" target="energy_supply_shift::tanker_traffic_vol" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Direct interruptions, closures or denial-of-access in key chokepoints force shipowners to delay, cancel or reroute voyages, reducing the number of tankers transiting the chokepoint.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_hostilities</data>
  <data key="d39">energy_supply_shift</data>
</edge>
<edge source="us_iran_hostilities::maritime_flow_disruption" target="energy_supply_shift::perceived_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Observable disruptions to maritime flows increase market and stakeholder estimates of the probability and severity of near-term supply interruptions for crude and refined fuels.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_hostilities</data>
  <data key="d39">energy_supply_shift</data>
</edge>
<edge source="us_iran_hostilities::maritime_flow_disruption" target="russia_ukraine_war::cross_border_incidents" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Significant disruption to key seaborne routes from US–Iran hostilities forces NATO and partner states to redeploy naval and air assets to the Middle East, weakening deterrence in the Black Sea/Baltic and thereby increasing the frequency of cross‑border probing and incidents by Russia.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_hostilities</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
