<edge source="energy_supply_shift::maritime_incident_rate" target="global_bond_shock::cross_border_capflow_rat" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher frequency of interdictions and attacks raises regional counterparty and shipping risk, prompting nonresident investors and banks to pull back from financing and holdings of affected sovereign/corporate debt, reducing cross‑border capital inflows into fixed‑income markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_supply_shift</data>
  <data key="d39">global_bond_shock</data>
</edge>
<edge source="energy_supply_shift::maritime_incident_rate" target="russia_ukraine_war::cross_border_incidents" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Increased interdictions, seizures or attacks on commercial vessels provoke direct naval/coastguard responses and retaliation by affected littoral states, producing more frequent cross-border kinetic and law-enforcement incidents.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_supply_shift</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="energy_supply_shift::maritime_incident_rate" target="us_iran_hostilities::maritime_flow_disruption" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">An increase in interdiction incidents (attacks, seizures, mines) directly forces vessel slowdowns, rerouting, transits suspension and port closures, producing immediate interruptive effects on seaborne flows through chokepoints.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">energy_supply_shift</data>
  <data key="d39">us_iran_hostilities</data>
</edge>
<edge source="energy_supply_shift::tanker_traffic_vol" target="energy_supply_shift::perceived_supply_risk" id="0">
