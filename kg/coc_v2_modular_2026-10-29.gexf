          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Escalating kinetic operations raise global risk‑off sentiment, driving accelerated portfolio withdrawals from emerging markets and directly increasing Brazil’s net capital outflow rate." />
