          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rise in financial risk premia increases hedging and funding costs and triggers rapid reallocations out of commodity positions, reducing futures market liquidity and amplifying short‑term swings in oil and gas prices." />
