      <edge source="iran_regional_escalation::shipping_lane_disruption" target="brazil_market_turmoil::market_volatility" id="290">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Disruptions in key maritime routes raise insurance and freight costs, delay Brazilian commodity shipments and create uncertainty over export receipts, provoking sharp repricing across equities, bonds and FX tied to Brazil and thus higher market volatility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="brazil_market_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::shipping_lane_disruption" target="global_money_markets::market_volatility" id="291">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute disruptions to key maritime corridors (e.g., Strait of Hormuz, Bab al-Mandeb) produce immediate uncertainty about commodity deliveries, insurance and rerouting costs and counterparty exposures, triggering rapid repricing and spikes in implied and realised volatility across commodity, FX and equity markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="global_money_markets" />
          <attvalue for="27" value="0" />
