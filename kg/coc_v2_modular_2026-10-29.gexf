      <edge source="russia_ukraine_war::tanker_movement_rate" target="brazil_market_turmoil::exchange_rate_pressure" id="107">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher tanker movement through key sea routes reduces fuel‑related shipping disruptions and freight costs for Brazilian exporters and importers, improving the trade position and relieving downward pressure on the real." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="brazil_market_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::tanker_movement_rate" target="global_money_markets::market_volatility" id="108">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increase in tanker volume/frequency eases immediate disruption signals, reduces shipping insurance and freight-rate stress, and thereby dampens energy-driven realized and implied volatility across markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_money_markets" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::tanker_movement_rate" target="iran_regional_escalation::shipping_lane_disruption" id="109">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Reduced tanker throughput via Black Sea routes forces rerouting through Suez/Strait of Hormuz and concentrates traffic in narrow chokepoints where Iranian-aligned actors and state interdictions raise the frequency and impact of maritime disruptions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::tanker_movement_rate" target="us_china_tech_rivalry::semiconductor_supply_cap" id="110">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp reductions in maritime oil/refined-fuel shipments raise energy and logistics costs and cause temporary power/fuel shortages at energy-intensive fabs and chemical suppliers, lowering near-term fabrication output capacity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
