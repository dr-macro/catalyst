      <edge source="iran_regional_escalation::conflict_intensity" target="brazil_market_turmoil::investor_confidence" id="252">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising conflict intensity raises global geopolitical risk premia and triggers risk‑off flows that reduce both foreign and domestic investors' willingness to hold Brazilian assets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="brazil_market_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::conflict_intensity" target="brazil_market_turmoil::capital_outflow_rate" id="253">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Escalating regional fighting induces a global flight to safety and margin calls that prompt cross‑border investors to repatriate funds from emerging markets, increasing Brazil's net capital outflow rate." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="brazil_market_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::conflict_intensity" target="global_money_markets::risk_premia" id="254">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Rising kinetic activity and proxy strikes increase perceived sovereign, corporate and operational risk in the region, causing investors to demand wider credit spreads and higher equity/risk premia to compensate for elevated probability of losses and capital flight." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="global_money_markets" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::conflict_intensity" target="russia_ukraine_war::military_pressure_level" id="255">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened Iranian regional fighting draws Western naval/air/missile‑defense assets and political attention toward the Middle East, degrading real‑time support and munitions flows to Ukraine and enabling Russia to increase kinetic pressure on the front." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::conflict_intensity" target="us_china_tech_rivalry::geopolitical_trade_restr" id="256">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A spike in Iranian regional military activity drives the US and partners to broaden sanctions and export controls tied to national-security concerns, producing tighter tech trade restrictions that spill into US–China controls." />
