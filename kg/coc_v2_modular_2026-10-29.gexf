      <edge source="global_money_markets::short_term_policy_rate" target="brazil_market_turmoil::exchange_rate_pressure" id="698">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rise in major global short‑term policy rates tightens dollar funding conditions and raises foreign return premia, producing immediate FX derivative squeezes and portfolio rebalancing that put downward pressure on the Brazilian real." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_money_markets" />
          <attvalue for="38" value="brazil_market_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_money_markets::short_term_policy_rate" target="iran_regional_escalation::hydrocarbon_supply_flow" id="699">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained increases in short‑term policy rates raise dollar funding costs and borrowing spreads for upstream firms and sovereign export finance, delaying investment and maintenance and reducing oil and gas output and exports over time." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_money_markets" />
          <attvalue for="38" value="iran_regional_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_money_markets::short_term_policy_rate" target="russia_ukraine_war::sanction_effectiveness" id="700">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher short-term policy rates tighten global dollar and euro liquidity and raise the cost/availability of correspondent banking and trade finance that Russian corporates and intermediaries rely on, making existing financial restrictions more binding and thus increasing sanctions' practical effectiveness." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_money_markets" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_money_markets::short_term_policy_rate" target="us_china_tech_rivalry::ai_investment_flow" id="701">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Higher short-term policy rates raise the cost of debt and increase discount rates, directly reducing venture fundraising, late-stage valuations and corporate capex available for AI projects, lowering AI investment flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_money_markets" />
