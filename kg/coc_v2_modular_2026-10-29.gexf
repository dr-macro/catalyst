          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising risk premia lead insurers, banks and commodity traders to raise margins, withdraw services or add restrictive onboarding requirements for counterparties perceived as higher risk, creating de facto regulatory and commercial barriers that reduce market access for Russian suppliers." />
