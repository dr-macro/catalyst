      <edge source="russia_ukraine_war::military_pressure_level" target="global_money_markets::rate_expectations" id="80">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sudden escalation in military pressure triggers flight-to-safety into sovereign bonds and reassessment of near-term growth, causing markets to lower implied probabilities of near-term policy rate hikes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_money_markets" />
          <attvalue for="27" value="0" />
        </attvalues>
