      <edge source="iran_regional_escalation::hydrocarbon_supply_flow" target="brazil_market_turmoil::exchange_rate_pressure" id="274">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained reductions in regional hydrocarbon flows push up global fuel import bills for Brazil, worsening the current account and increasing demand for foreign exchange to pay for energy imports, thereby heightening depreciation pressure on the real." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="brazil_market_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::hydrocarbon_supply_flow" target="global_money_markets::short_term_policy_rate" id="275">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained increase in regional hydrocarbon supply flow eases oil and gas-driven inflationary pressure, reducing central banks' near-term impetus to tighten and thereby lowering the likely path of short-term policy rates; conversely a drop raises inflationary pressure and pushes rates up." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="global_money_markets" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_escalation::hydrocarbon_supply_flow" target="russia_ukraine_war::sanction_effectiveness" id="276">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Disruptions to Middle Eastern hydrocarbon output or logistics tighten global supply, motivating buyers and intermediaries to tolerate sanction‑evasion or seek less stringent sourcing rules, which reduces the practical leverage of restrictions on Russian exports." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_regional_escalation" />
          <attvalue for="38" value="russia_ukraine_war" />
