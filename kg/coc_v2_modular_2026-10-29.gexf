          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher risk premia drive up war‑risk insurance and charter rates for vessels transiting high‑risk areas, prompting shippers to delay, reroute or reduce transits through Persian‑Gulf/Strait of Hormuz corridors and thereby increasing disruption metrics." />
