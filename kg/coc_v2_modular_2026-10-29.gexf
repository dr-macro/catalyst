          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher military pressure in the Ukraine theatre draws Western naval assets toward European waters and/or strains logistics, lowering deterrence and surveillance in the Gulf/Red Sea and enabling more successful attacks or interdictions that disrupt regional shipping lanes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_regional_escalation" />
