      <edge source="russia_ukraine_war::sanction_effectiveness" target="brazil_market_turmoil::investor_confidence" id="53">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Greater effectiveness of sanctions increases the risk of secondary sanctions and compliance costs for banks and corporates with Russia‑linked exposures, prompting international investors to de‑risk Brazilian positions and lowering investor confidence." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="brazil_market_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanction_effectiveness" target="global_money_markets::risk_premia" id="54">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="More effective sanctions restrict targeted actors' access to finance and counterparties, increasing perceived default and liquidity risk and forcing investors to demand higher risk premia on exposed credits and equities." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_money_markets" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanction_effectiveness" target="us_china_tech_rivalry::geopolitical_trade_restr" id="55">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Visible effectiveness of sanctions on Russia provides policymakers a tested toolkit and political cover to broaden export controls and sectoral trade restrictions against strategic competitors (including China)." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanction_effectiveness" target="us_china_tech_rivalry::ai_investment_flow" id="56">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Demonstrated success of sanctions that disrupt access to foreign technology and capital spurs governments and private investors to redirect funding into domestic AI and adjacent tech to reduce strategic dependence." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
