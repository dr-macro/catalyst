<edge source="alliance_cred_apac::operational_sustainabili" target="ai_capital_governance::model_performance" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Reduced operational sustainability shortens continuous deployment and live testing windows for platform sensors and AI systems, cutting the volume and continuity of real‑world data used to refine models and thereby slowing or reducing measurable model performance gains.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">alliance_cred_apac</data>
  <data key="d39">ai_capital_governance</data>
</edge>
<edge source="alliance_cred_apac::operational_sustainabili" target="iran_hormuz_crisis::strait_throughput_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Improved operational sustainability enables continuous protective operations (escorts, rapid response, counter‑sabotage) that keep shipping insurance and routing stable and thus maintain chokepoint throughput, while reduced sustainability leads to interruptions and lower throughput.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">alliance_cred_apac</data>
  <data key="d39">iran_hormuz_crisis</data>
</edge>
