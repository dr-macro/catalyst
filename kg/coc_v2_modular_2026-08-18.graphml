<edge source="alliance_cred_apac::logistics_backlog" target="ai_capital_governance::compute_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A growing logistics and maintenance backlog diverts defense and allied procurement budgets toward repairs and sustainment, delaying or canceling investments in new high‑performance compute infrastructure that would expand available compute capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">alliance_cred_apac</data>
  <data key="d39">ai_capital_governance</data>
</edge>
<edge source="alliance_cred_apac::logistics_backlog" target="russia_ukraine_war::defense_supply_levels" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">A rising maintenance and logistics backlog in APAC forces reallocation and cannibalization of NATO/US supply-chain capacity (airlift, warehouses, spare stocks) to sustain forward forces there, reducing immediate inventories and shipment capacity available to replenish Ukrainian munitions and spares.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">alliance_cred_apac</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
