<edge source="alliance_security_realig::cross_border_refugee_flo" target="global_bond_credit_stres::long_term_yields" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Substantial and sustained refugee inflows raise host-country near-term fiscal spending and expected future debt issuance, increasing sovereign risk premia and pushing up long-dated government yields in affected markets.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">alliance_security_realig</data>
  <data key="d40">global_bond_credit_stres</data>
</edge>
<edge source="alliance_security_realig::cross_border_refugee_flo" target="us_china_rivalry::agentic_deployment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Large, fast refugee movements create urgent border-management and humanitarian processing needs that governments and NGOs meet by procuring and fielding agentic systems (surveillance drones, autonomous triage/translation agents), accelerating deployment rates.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">alliance_security_realig</data>
  <data key="d40">us_china_rivalry</data>
</edge>
