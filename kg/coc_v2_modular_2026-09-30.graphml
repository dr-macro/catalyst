<edge source="global_bond_credit_stres::cross_border_flows" target="alliance_security_realig::cross_border_refugee_flo" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A sudden negative swing in cross-border capital flows (capital flight or remittance stoppage) sharply reduces household income and fiscal capacity in a fragile conflict zone, triggering rapid deterioration of services and livelihoods that drives people to cross borders seeking refuge.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_credit_stres</data>
  <data key="d40">alliance_security_realig</data>
</edge>
