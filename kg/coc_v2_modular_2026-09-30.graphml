<edge source="alliance_security_realig::diplomatic_tension_level" target="global_bond_credit_stres::cross_border_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Rising diplomatic friction (sanctions, trade restrictions, reputational risk) causes fast, anticipatory portfolio reallocation and withdrawal of cross-border funding from exposed jurisdictions into safe-haven markets, producing net outflows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">alliance_security_realig</data>
  <data key="d40">global_bond_credit_stres</data>
</edge>
<edge source="alliance_security_realig::diplomatic_tension_level" target="iran_us_standoff::policy_response" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Escalating diplomatic friction among states involved in the standoff prompts governments to enact sanctions, export controls, or emergency energy measures (e.g., SPR releases), increasing the intensity and frequency of official energy-market interventions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">alliance_security_realig</data>
  <data key="d40">iran_us_standoff</data>
</edge>
<edge source="alliance_security_realig::diplomatic_tension_level" target="russia_ukraine_war::allied_military_support" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalating diplomatic confrontations and public condemnations raise domestic political incentives for allied governments to demonstrate resolve by increasing or fast-tracking military assistance packages.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">alliance_security_realig</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="alliance_security_realig::diplomatic_tension_level" target="us_china_rivalry::regulatory_scrutiny" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising diplomatic friction between states triggers near-term government actions—export controls, entity listings, mandatory vendor reviews and expanded investigations—directly increasing the intensity and scope of regulatory scrutiny on rival-country AI firms and services.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">alliance_security_realig</data>
  <data key="d40">us_china_rivalry</data>
</edge>
<edge source="alliance_security_realig::diplomatic_tension_level" target="us_china_rivalry::capital_flow_ai" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
