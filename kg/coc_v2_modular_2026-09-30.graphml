  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_stress" target="alliance_security_realig::diplomatic_tension_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Acute energy shortages and price spikes prompt importing states to lodge formal protests, impose countermeasures or seek emergency supply deals, increasing bilateral and multilateral diplomatic frictions tied to the conflict.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">alliance_security_realig</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_stress" target="global_bond_credit_stres::policy_rate_expectations" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">War-related energy shortfalls and price spikes push up near-term CPI and headline inflation expectations, prompting markets to price in faster and larger central-bank tightening.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_bond_credit_stres</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_stress" target="global_bond_credit_stres::long_term_yields" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Sustained increases in energy prices raise inflation expectations and term premia on long-dated debt, directly lifting long‑term nominal government yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_bond_credit_stres</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_stress" target="iran_us_standoff::oil_price" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Disruptions to Russian hydrocarbon flows and related re-routing/risk premia from the Russia–Ukraine war tighten global supply and increase price risk, directly pushing up global crude prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_us_standoff</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_stress" target="us_china_rivalry::agentic_deployment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Acute energy shortages and higher electricity prices raise datacenter and cloud costs, leading firms to delay or scale back rollouts of energy‑intensive autonomous agent services and thus reducing deployment rate.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_rivalry</data>
</edge>
