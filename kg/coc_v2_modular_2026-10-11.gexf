          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A sustained rise in diesel prices raises near‑term inflation and fiscal outlays (via subsidies or weaker growth), deteriorating sovereign fiscal metrics and prompting investors to demand higher risk premia on eurozone sovereign debt." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="eurozone_bond_stress" />
