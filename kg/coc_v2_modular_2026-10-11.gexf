      <edge source="iran_houthi_maritime::sanctions_policy_intensi" target="china_taiwan_grayzone::coercion_intensity" id="454">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Escalatory sanctions targeting maritime actors provoke retaliatory or preemptive disruptive maritime behavior and divert US/allied attention and assets, creating an operational window that China can exploit to increase gray‑zone coercive pressure on Taiwan." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_houthi_maritime" />
          <attvalue for="38" value="china_taiwan_grayzone" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_houthi_maritime::sanctions_policy_intensi" target="eurozone_bond_stress::sovereign_credit_spreads" id="455">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalation of sanctions or aggressive policy measures tied to Iran/Houthi maritime incidents raises compliance and trade frictions for European firms and increases near‑term fiscal uncertainty (through higher subsidies, energy costs or trade disruption), leading investors to demand wider sovereign credit spreads for affected euro-area issuers." />
          <attvalue for="36" value="3-12 months" />
          <attvalue for="37" value="iran_houthi_maritime" />
          <attvalue for="38" value="eurozone_bond_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_houthi_maritime::sanctions_policy_intensi" target="russia_ukraine_war::sanctions_evasion_rate" id="456">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="Escalation of targeted sanctions and enforcement against Iran/Houthi shipping incentivizes the expansion and refinement of concealment tactics (e.g., ship‑to‑ship transfers, opaque flags, broker networks) that increase the global rate at which sanctioned flows are routed around restrictions and can be adopted by other sanctioned actors." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_houthi_maritime" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_houthi_maritime::sanctions_policy_intensi" target="us_china_ai_rivalry::compute_supply_capacity" id="457">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.72" />
          <attvalue for="35" value="Greater maritime-focused sanctions and secondary‑sanctions enforcement (inspections, port denials, carrier blacklisting) directly block or delay shipments of semiconductor fabrication equipment, test gear and datacenter hardware into China, reducing immediately allocable compute hardware capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_houthi_maritime" />
          <attvalue for="38" value="us_china_ai_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
