          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher diesel prices raise the value of liquid cargoes and the economic payoff from interdiction or seizure, provoking insurers and charterers to demand larger risk premia for tankers operating in corridors vulnerable to Houthi action." />
          <attvalue for="36" value="0-6 months" />
