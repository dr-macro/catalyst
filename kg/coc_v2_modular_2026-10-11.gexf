          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Loss of Russian diesel exports forces importers to source refined product from more distant suppliers (Middle East, East Asia), directly increasing the volume of tanker shipments transiting routes and chokepoints used by Iran-Houthi-affected maritime traffic." />
