      <edge source="eurozone_bond_stress::market_volatility" target="china_taiwan_grayzone::investor_risk_premium" id="614">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Spikes in eurozone market volatility increase global hedge and margin costs and push up cross‑asset implied volatilities, which lifts the cost of insuring and holding assets linked to Taiwan and therefore raises the investor risk premium on those exposures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="eurozone_bond_stress" />
          <attvalue for="38" value="china_taiwan_grayzone" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="eurozone_bond_stress::market_volatility" target="iran_houthi_maritime::shipping_risk_premium" id="615">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Spikes in eurozone-driven financial market volatility raise cross‑asset risk premia and push insurers, owners and charterers to reprice hazard exposure for Red Sea/GoG transits, lifting the shipping risk premium demanded on tankers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="eurozone_bond_stress" />
          <attvalue for="38" value="iran_houthi_maritime" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="eurozone_bond_stress::market_volatility" target="russia_ukraine_war::diesel_price_level" id="616">
