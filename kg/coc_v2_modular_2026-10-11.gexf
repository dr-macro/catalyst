          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An uptick in sanctions‑evasion activity raises compliance and counterparty risk for correspondent banks and asset managers, causing them to curtail or reroute eurozone inbound and outbound capital flows to avoid exposure or fines." />
