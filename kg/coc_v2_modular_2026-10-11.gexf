      <edge source="eurozone_bond_stress::banking_sector_stress" target="iran_houthi_maritime::shipping_risk_premium" id="655">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Acute stress in eurozone banks contracts trade‑finance, reduces availability of letters of credit and counterparty capacity to back marine insurance/reinsurance, and thus forces insurers and charterers to charge higher premiums for tanker voyages through Houthi‑exposed routes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="eurozone_bond_stress" />
          <attvalue for="38" value="iran_houthi_maritime" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="eurozone_bond_stress::banking_sector_stress" target="russia_ukraine_war::diesel_supply_flow" id="656">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened bank stress leads banks to curtail trade finance, letters of credit and correspondent services used to finance and insure cross‑border fuel shipments, directly reducing the volume of diesel imports/exports that can be executed." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="eurozone_bond_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
