          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Increased eurozone fixed‑income and related market volatility raises risk premia and drives short‑term flows into commodity futures and physical commodity hoarding, pushing up diesel spot and futures prices across major hubs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="eurozone_bond_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
