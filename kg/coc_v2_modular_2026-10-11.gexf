          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sharp diesel price increases raise logistics and manufacturing costs across East Asian supply chains, worsening near‑term earnings outlooks and volatility for firms exposed to cross‑strait trade and thereby increasing the investor risk premium on assets linked to Taiwan/China." />
          <attvalue for="36" value="0-6 months" />
