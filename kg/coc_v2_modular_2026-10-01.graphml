<edge source="bond_market_shock::policy_rate_expectations" target="ai_global_rivalry::safety_risk_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Stronger market expectations of near‑term rate hikes increase pressure on AI firms to hit revenue targets quickly (pricing, faster productization), which can shorten safety testing cycles and raise perceived systemic AI safety risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">bond_market_shock</data>
  <data key="d39">ai_global_rivalry</data>
</edge>
<edge source="bond_market_shock::policy_rate_expectations" target="china_regional_power::foreign_scrutiny_intensi" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Markets pricing in higher policy rates in advanced economies increase perceived refinancing and balance‑sheet stress for China‑linked investments, which foreign regulators interpret as higher risk and therefore intensify security, transaction and investment scrutiny of Chinese actors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">bond_market_shock</data>
  <data key="d39">china_regional_power</data>
</edge>
