<edge source="us_iran_standoff::conflict_expectation" target="ai_global_rivalry::regulatory_activity_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Rising market and stakeholder expectations of imminent escalation prompt regulators and legislators to fast-track export controls, sanctions, and oversight actions targeting dual-use AI technologies to deny adversaries advantage, raising the pace of regulatory interventions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">ai_global_rivalry</data>
</edge>
<edge source="us_iran_standoff::conflict_expectation" target="bond_market_shock::nominal_long_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sudden rise in market expectations of wider or prolonged US–Iran escalation raises sovereign and term risk premia (flight-to-liquid assets, higher inflation/war-risk premia), pushing up long-dated nominal yields within weeks.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">bond_market_shock</data>
</edge>
<edge source="us_iran_standoff::conflict_expectation" target="china_regional_power::fiscal_subsidy_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising market and official expectations of sustained escalation raise the perceived near‑term risk of energy and logistics shocks, prompting Beijing to deploy or increase targeted fiscal transfers and subsidies (energy, transport, key manufacturers, households) to blunt economic and social fallout.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_iran_standoff</data>
  <data key="d39">china_regional_power</data>
</edge>
<edge source="us_iran_standoff::conflict_expectation" target="russia_europe_war::market_expectations_of_s" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
