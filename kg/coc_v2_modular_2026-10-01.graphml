<edge source="russia_europe_war::energy_price_level" target="ai_global_rivalry::chip_supply_constraint" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained increases in energy prices raise operating costs for fabs and ancillary suppliers, forcing production slowdowns and delaying capacity expansions that tighten chip availability for AI infrastructure.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_europe_war</data>
  <data key="d39">ai_global_rivalry</data>
</edge>
<edge source="russia_europe_war::energy_price_level" target="bond_market_shock::nominal_long_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sustained rise in energy prices boosts near-term CPI and inflation expectations and raises term premia as investors demand compensation for higher expected inflation and volatility, driving up nominal long-term yields.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_europe_war</data>
  <data key="d39">bond_market_shock</data>
</edge>
<edge source="russia_europe_war::energy_price_level" target="china_regional_power::fiscal_subsidy_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">A spike in global energy prices driven by the Russia–Europe war raises Chinese import and domestic fuel costs, prompting Beijing to expand targeted fiscal transfers and energy subsidies to households and energy‑intensive industries to contain inflation and social unrest.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_europe_war</data>
  <data key="d39">china_regional_power</data>
</edge>
<edge source="russia_europe_war::energy_price_level" target="china_regional_power::interest_rate_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained higher imported energy prices feed into Chinese consumer and producer inflation, creating upward pressure on monetary policy that makes the People's Bank of China less likely to cut policy rates and may prompt modest tightening or higher market interest rates to anchor inflation expectations.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_europe_war</data>
  <data key="d39">china_regional_power</data>
</edge>
<edge source="russia_europe_war::energy_price_level" target="us_iran_standoff::political_hawkishness" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sustained spikes in energy prices from the Russia–Europe war raise domestic political pressure in the US and among its allies to secure supply lines and penalize sources of disruption, prompting more hawkish rhetoric and policy stances toward Iran as a potential threat to maritime energy flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_europe_war</data>
  <data key="d39">us_iran_standoff</data>
</edge>
