<edge source="china_regional_power::foreign_scrutiny_intensi" target="ai_global_rivalry::regulatory_activity_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rise in foreign investigations and security screening of Chinese AI firms prompts immediate reciprocal enforcement, accelerated rulemaking and new oversight initiatives in multiple jurisdictions, increasing the overall tempo of regulatory actions against AI.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_regional_power</data>
  <data key="d39">ai_global_rivalry</data>
</edge>
<edge source="china_regional_power::foreign_scrutiny_intensi" target="bond_market_shock::investor_liquidity_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">An increase in external governments' scrutiny of Chinese transactions prompts non‑domestic investors to reduce or reallocate directly held China exposure and move proceeds into global fixed‑income funds, raising net inflows into bond vehicles.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">china_regional_power</data>
  <data key="d39">bond_market_shock</data>
