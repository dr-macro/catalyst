          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Spikes in geopolitical tension prompt rapid safe‑haven capital flows into major reserve currencies (especially USD), mechanically raising their exchange value and the composite reserve currency index within weeks as traders reprice risk and central banks/sovereign funds shift short‑term allocations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_west_rivalry" />
          <attvalue for="39" value="global_energy_volatility" />
