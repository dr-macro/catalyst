      <edge source="china_west_rivalry::vehicle_import_flow" target="bond_market_stress::currency_pressure_index" id="407">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sustained increase in vehicle imports raises demand for foreign currency to pay suppliers and widens the trade deficit, generating immediate depreciation pressure and higher exchange-rate volatility for the domestic currency." />
