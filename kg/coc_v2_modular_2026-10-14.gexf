          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating attacks increase settlement and counterparty risk and induce market-makers to pull inventory and widen quotes, directly reducing depth and tradability in bond markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="bond_market_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_attack_rate" target="china_west_rivalry::manu_invest_flow" id="266">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating kinetic attacks raise perceptions of systemic geopolitical and supply‑chain risk, prompting firms and investors to accelerate reshoring and friend‑shoring of auto and related tech production into Europe, increasing manufacturing investment flows." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_west_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_attack_rate" target="global_energy_volatility::geopolitical_tension" id="267">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.95" />
          <attvalue for="36" value="An increased tempo and intensity of kinetic attacks raises regional spillover risk perceptions and triggers broader strategic alarm, directly elevating measured geopolitical tension and risk premia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_volatility" />
          <attvalue for="28" value="0" />
