      <edge source="global_energy_volatility::reserve_currency_index" target="bond_market_stress::cross_border_flows" id="549">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Appreciation in a major reserve currency increases expected returns and safe‑asset demand in that currency, drawing incremental cross‑border capital into reserve‑currency‑denominated fixed‑income instruments and altering net flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_volatility" />
