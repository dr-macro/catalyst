      <edge source="global_energy_volatility::reserve_currency_index" target="gulf_proxy_campaign::infra_operational_capaci" id="550">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Weakening of major reserve currencies raises the local-currency cost of imported spare parts, maintenance services, and foreign-denominated insurance/premia, reducing the ability of airports, terminals and refineries to sustain full operational capacity over the medium term." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_energy_volatility" />
          <attvalue for="39" value="gulf_proxy_campaign" />
          <attvalue for="28" value="0" />
