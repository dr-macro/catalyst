        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating military responses raise sovereign and geopolitical risk premia, prompting quicker FX repricing and elevated depreciation pressure as investors sell local currency exposures and hedge costs rise." />
