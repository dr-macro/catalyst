          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An increase in the frequency and intensity of attacks raises event risk and uncertainty about sovereign/corporate credit and fiscal costs, triggering faster repricing and larger short-term swings in sovereign and corporate bond yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="bond_market_stress" />
