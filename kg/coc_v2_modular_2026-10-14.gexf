        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A sharp intensification of military responses drives risk-off capital flows into major safe‑haven reserve currencies (notably the USD), lifting a composite reserve‑currency strength index via FX demand and yield differentials." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="gulf_proxy_campaign" />
          <attvalue for="39" value="global_energy_volatility" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="gulf_proxy_campaign::military_response_intens" target="russia_ukraine_war::military_attack_rate" id="123">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalatory Gulf military operations and allied redeployments shift Western focus and logistical capacity, creating political space that Russian commanders can exploit to increase tempo and scale of offensive strikes in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="gulf_proxy_campaign" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
