      <edge source="china_west_rivalry::vehicle_import_flow" target="global_energy_volatility::oil_price" id="408">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="An increase in vehicle import flows (notably EVs and efficient models) lowers projected gasoline/diesel demand growth in Europe, reducing near‑term crude demand expectations and exerting downward pressure on oil prices over subsequent quarters." />
