      <edge source="russia_ukraine_war::sanctions_enforcement" target="bond_market_stress::cross_border_flows" id="295">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Stronger enforcement raises legal/compliance and correspondent-banking risk, prompting banks, asset managers and custodians to halt or withdraw purchases of bonds tied to sanctioned jurisdictions and related counterparties, directly reducing cross-border fixed-income flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="bond_market_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforcement" target="china_west_rivalry::trade_policy_tightness" id="296">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Stronger enforcement capacity and legal precedents developed to implement Russia sanctions are rapidly repurposed to expand export controls and import restrictions on dual‑use vehicle and tech inputs, producing tighter European trade policy toward strategic suppliers including China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_west_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforcement" target="global_energy_volatility::reserve_currency_index" id="297">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Stronger, more rigorously enforced sanctions concentrate cross-border transactions in reserve-currency-cleared channels and force counterparties to hold and settle in major reserve currencies, increasing demand and strengthening the reserve-currency index." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_volatility" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_enforcement" target="gulf_proxy_campaign::energy_export_flow" id="298">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Tighter enforcement of sanctions on Russian oil/fuel forces importers to source replacement volumes from Gulf producers, increasing Gulf shipment rates to global markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="gulf_proxy_campaign" />
          <attvalue for="28" value="0" />
        </attvalues>
