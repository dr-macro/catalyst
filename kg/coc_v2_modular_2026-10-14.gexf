          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Rising regional geopolitical tension increases signaling, mobilization, and permissive intent among state and non-state patrons, directly raising the frequency of proxy kinetic strikes (drones, missiles, attacks on infrastructure) as actors exploit or escalate the environment." />
          <attvalue for="37" value="0-6 months" />
