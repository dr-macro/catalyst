          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Spikes in geopolitical tension trigger abrupt re-pricing of risk and flight-to-safety flows that cause rapid shifts in demand across sovereign and corporate bonds, producing larger intraday and realized yield swings." />
