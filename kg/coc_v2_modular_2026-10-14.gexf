      <edge source="russia_ukraine_war::alliance_cohesion_level" target="china_west_rivalry::geopolitical_tension" id="278">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A rise in alliance cohesion around the Russia–Ukraine war produces coordinated strategic posture, intelligence-sharing and security commitments (including deeper NATO–Indo‑Pacific ties) that directly increase friction and perceived threat between Western coalitions and China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_west_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion_level" target="global_energy_volatility::oil_price" id="279">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher political and operational cohesion among partner states leads to coordinated measures (e.g., embargoes, synchronized import reductions, tighter insurance/transport constraints) that reduce accessible supply and increase risk premia, lifting oil prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_energy_volatility" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion_level" target="gulf_proxy_campaign::military_response_intens" id="280">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A decline in Western alliance cohesion reduces coordinated diplomatic and deterrent pressure on regional actors, lowering external restraints and enabling higher-intensity military countermeasures in Gulf proxy engagements." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="gulf_proxy_campaign" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
