          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A spike in China–West geopolitical tension prompts visible Western naval/security deployments, sanctions and interdiction operations in the Gulf/Red Sea that Iran-aligned actors interpret as direct threats and respond with an uptick in missile/drone/ship-based strikes on shipping and energy infrastructure." />
