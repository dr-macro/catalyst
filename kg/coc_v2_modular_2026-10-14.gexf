      <edge source="global_energy_volatility::geopolitical_tension" target="china_west_rivalry::geopolitical_tension" id="603">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Energy-related spikes in geopolitical risk (supply cut-offs, sanctioning of energy routes or suppliers) lead governments to use energy diplomacy and countermeasures that directly escalate bilateral security frictions between China and Western states." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_energy_volatility" />
          <attvalue for="39" value="china_west_rivalry" />
