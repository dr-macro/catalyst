<edge source="ai_governance_crisis::model_autonomy_level" target="russia_ukraine_war::unmanned_weapons_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Rising autonomy reduces required human-in-the-loop oversight for UAVs and loitering munitions, permitting commanders to deploy larger numbers and longer-duration missions through software upgrades rather than slower crewed-force expansions.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">ai_governance_crisis</data>
  <data key="d39">russia_ukraine_war</data>
