<edge source="currency_activism_shocks::fx_interv_intensity" target="hormuz_standoff::shipping_throughput" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Sustained large-scale FX interventions commonly precipitate sudden foreign-exchange controls and payment frictions that directly impede letters-of-credit and bunker/port payments, causing commercial shippers to delay or reroute transits and reducing throughput through the chokepoint.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">currency_activism_shocks</data>
  <data key="d39">hormuz_standoff</data>
</edge>
<edge source="currency_activism_shocks::fx_interv_intensity" target="russia_ukraine_war::sanctions_enforcement" id="0">
