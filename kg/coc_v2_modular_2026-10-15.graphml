<edge source="china_eu_auto_rivalry::policy_restriction" target="global_financial_ai::capital_flow_tech" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Tightened export controls and technology-transfer conditions in the China–EU auto rivalry prompt public funds and private investors to reallocate capital toward domestic tech and semiconductor firms to substitute restricted imports and secure supply, boosting net capital flows into the technology sector.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_auto_rivalry</data>
  <data key="d40">global_financial_ai</data>
</edge>
<edge source="china_eu_auto_rivalry::policy_restriction" target="mideast_houthi_campaign::defensive_response_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Tighter China–EU auto trade/regulatory restrictions prompt rerouting of commerce and political signalling that leads flag states and insurers to demand or deploy additional naval/air escorts and defensive measures for affected shipping lanes, increasing the observable defensive response level in the theatre.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">china_eu_auto_rivalry</data>
  <data key="d40">mideast_houthi_campaign</data>
</edge>
