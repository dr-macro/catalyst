<edge source="global_energy_diesel::diesel_inventory_level" target="china_eu_auto_rivalry::vehicle_trade_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Higher global diesel inventories reduce spot diesel price volatility and freight/land-transport fuel cost risk, lowering per-unit logistics costs and enabling a higher short-term volume of cross-border vehicle shipments between China and the EU.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_diesel</data>
  <data key="d40">china_eu_auto_rivalry</data>
</edge>
<edge source="global_energy_diesel::diesel_inventory_level" target="global_financial_ai::bond_yield_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A rise in global diesel inventories eases near‑term fuel‑price and inflation pressures and reduces term and risk premia, lowering long‑term sovereign and high‑grade bond yields within months.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_diesel</data>
  <data key="d40">global_financial_ai</data>
</edge>
