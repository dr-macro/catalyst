  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Greater alliance_cohesion among Western and partner states in reaction to the Russia–West conflict produces more coordinated naval and air deployments and shared rules of engagement in the Red Sea corridor, raising the intensity and frequency of defensive and retaliatory operations against Houthi attacks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_west_conflict</data>
  <data key="d40">mideast_houthi_campaign</data>
</edge>
