<edge source="global_financial_ai::capital_flow_tech" target="global_energy_diesel::crude_supply_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sustained large capital flows into the technology sector divert equity and private capital away from upstream oil companies and service‑sector financing, reducing drilling, maintenance and near‑term investment and causing a measurable decline in crude production rates.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_financial_ai</data>
  <data key="d40">global_energy_diesel</data>
</edge>
