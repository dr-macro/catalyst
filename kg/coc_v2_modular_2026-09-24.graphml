  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A fall in international diesel shipments reduces tanker transits that normally pass through Persian Gulf chokepoints, directly lowering commercial traffic volume through those straits.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">persian_gulf_conflict</data>
</edge>
<edge source="global_energy_supply_sho::diesel_trade_flows" target="russia_ukraine_war::energy_flow_stability" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Reductions or disruptions in cross‑border diesel shipments create localized shortfalls at terminals and depots, producing interruptions in fuel delivery corridors and degrading the continuity of energy supplies to military and civilian users.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_energy_supply_sho::diesel_trade_flows" target="us_china_strategic_rival::diplomatic_engagement" id="0">
