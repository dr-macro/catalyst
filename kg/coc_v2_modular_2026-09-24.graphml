<edge source="global_energy_supply_sho::chokepoint_congestion" target="ai_governance_and_race::model_capability_growth" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Increased congestion at maritime chokepoints delays shipments of specialized accelerator hardware and completed server racks from a small set of manufacturing hubs, directly constraining available training capacity and slowing the pace at which organizations can scale up model training and thus capability growth.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">ai_governance_and_race</data>
</edge>
<edge source="global_energy_supply_sho::chokepoint_congestion" target="ai_governance_and_race::model_release_cadence" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Persistent delays in cross‑border delivery of compute hardware and replacement parts caused by chokepoint congestion force labs and service providers to defer or stagger planned training and deployment cycles, reducing the frequency of new model releases.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">ai_governance_and_race</data>
</edge>
<edge source="global_energy_supply_sho::chokepoint_congestion" target="persian_gulf_conflict::escalation_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising congestion at maritime chokepoints increases close encounters, delays and interdiction operations by naval forces and coast guards, which raises the frequency of confrontations and operational escalation in the Gulf.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">persian_gulf_conflict</data>
</edge>
<edge source="global_energy_supply_sho::chokepoint_congestion" target="russia_ukraine_war::drone_campaign_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Increased congestion and delays at maritime chokepoints slow or block inbound shipments of drone airframes, electronics, batteries and munitions, reducing sortie rates and the geographic tempo of UAS strike and ISR operations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_energy_supply_sho::chokepoint_congestion" target="us_china_strategic_rival::geopolitical_tension" id="0">
