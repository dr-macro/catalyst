<edge source="ai_governance_and_race::model_capability_growth" target="global_energy_supply_sho::diesel_trade_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Faster growth in deployed AI model capabilities drives wider adoption of real-time fleet, routing and inventory optimization tools across logistics networks, reducing diesel consumption in freight and thereby lowering cross-border diesel shipment volumes.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_governance_and_race</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="ai_governance_and_race::model_capability_growth" target="persian_gulf_conflict::escalation_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Faster growth in deployed AI capabilities (e.g., autonomous targeting, persistent ISR, and decision‑support tools) lowers the perceived cost and increases tempo of offensive operations among state and proxy actors in the Gulf, raising the likelihood and magnitude of escalatory strikes.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_governance_and_race</data>
  <data key="d40">persian_gulf_conflict</data>
</edge>
<edge source="ai_governance_and_race::model_capability_growth" target="russia_ukraine_war::drone_campaign_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Faster growth in deployed model capabilities produces more robust onboard autonomy, perception and swarm-coordination software that militaries and proxies integrate into UASs, increasing the frequency, range and effectiveness of drone strike and recon operations.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_governance_and_race</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
