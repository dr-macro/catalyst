<edge source="persian_gulf_conflict::chokepoint_traffic_volum" target="global_energy_supply_sho::chokepoint_congestion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Concentrated increases in convoying, military transits or diverted commercial tonnage through alternative narrow passages overload throughput capacity and cause delays and queuing at key maritime chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">persian_gulf_conflict</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="persian_gulf_conflict::chokepoint_traffic_volum" target="russia_ukraine_war::supply_chain_strain" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Disruptions and rerouting around Persian Gulf chokepoints increase shipment times and port congestion on alternative routes, producing immediate bottlenecks and delays for defense-related components and spares bound for the Russia–Ukraine theater.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">persian_gulf_conflict</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="persian_gulf_conflict::chokepoint_traffic_volum" target="us_china_strategic_rival::semiconductor_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Severe slowdowns or closures at Gulf chokepoints delay critical shipments of wafers, specialty gases and fab equipment, forcing production cuts or idling that reduce the immediate flexibility of semiconductor manufacturing capacity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">persian_gulf_conflict</data>
  <data key="d40">us_china_strategic_rival</data>
</edge>
