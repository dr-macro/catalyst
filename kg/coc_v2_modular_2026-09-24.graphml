  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A spike in conflict escalation triggers domestic political pressure and national security reviews that prompt governments to impose or accelerate stricter AI governance measures (e.g., restrictions on dual‑use capabilities, monitoring requirements, or emergency controls).</data>
  <data key="d38">6-18 months</data>
  <data key="d39">persian_gulf_conflict</data>
  <data key="d40">ai_governance_and_race</data>
</edge>
<edge source="persian_gulf_conflict::escalation_intensity" target="global_energy_supply_sho::diesel_price_level" id="0">
