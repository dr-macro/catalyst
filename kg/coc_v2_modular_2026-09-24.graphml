<edge source="global_energy_supply_sho::refining_throughput" target="us_china_strategic_rival::strategic_autonomy_push" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained declines in global refining throughput prompt policymakers in the US and China to accelerate industrial and policy measures to expand domestic refining and alternative fuel capacity, strengthening the push for strategic autonomy in energy and related supply chains.</data>
  <data key="d38">6-18 months</data>
