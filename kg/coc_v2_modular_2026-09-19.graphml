  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A sustained spike in oil prices raises Russia's hydrocarbon export revenues and fiscal space, enabling faster procurement, ammunition production and sustainment of deployed forces, thereby improving Russia's relative military capability in Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_regional_conflict</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
