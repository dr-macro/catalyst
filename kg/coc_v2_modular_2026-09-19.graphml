<edge source="us_china_tech_rivalry::supply_chain_resilience" target="iran_regional_conflict::conflict_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Improved global supply-chain resilience (diversification, inventory buffers, alternate routes) reduces the leverage gained by threatening Gulf transit, diminishing Iran's incentive to escalate militarily and lowering the intensity of kinetic actions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_tech_rivalry</data>
  <data key="d40">iran_regional_conflict</data>
</edge>
