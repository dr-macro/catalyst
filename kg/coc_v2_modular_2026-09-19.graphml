  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A deterioration in bond-market liquidity makes issuance for large-scale, long‑lead fab financing more costly or unavailable, directly constraining the ability of companies to fund new advanced-node capacity expansions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_bond_rate_shock</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
<edge source="global_bond_rate_shock::bond_market_liquidity" target="western_alliance_realign::integration_pressure" id="0">
