<edge source="western_alliance_realign::trade_integration_degree" target="global_bond_rate_shock::cross_border_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Deeper trade_integration_degree lowers transactional and regulatory frictions, expands trade finance and predictable settlement flows, and thereby attracts larger net cross-border capital flows into debt and equity markets.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">western_alliance_realign</data>
  <data key="d40">global_bond_rate_shock</data>
</edge>
<edge source="western_alliance_realign::trade_integration_degree" target="us_china_tech_rivalry::advanced_chip_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Deeper tariff-free access and regulatory compatibility across allied markets lowers the cost and lead times for importing equipment, materials and personnel, enabling faster commissioning and scaling of advanced-node fabs in integrated jurisdictions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">western_alliance_realign</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
