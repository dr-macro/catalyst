<edge source="western_alliance_realign::diplomatic_signal_flow" target="global_bond_rate_shock::bond_market_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Large spikes in diplomatic_signal_flow (public threats, visible military coordination, or high-profile escalatory statements) cause immediate repricing of geopolitical risk and generate higher short-term realised and implied volatility in bond markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_alliance_realign</data>
  <data key="d40">global_bond_rate_shock</data>
</edge>
<edge source="western_alliance_realign::diplomatic_signal_flow" target="iran_regional_conflict::oil_price_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Escalating public diplomatic signals (threats, warnings, announced red lines) increase market perceptions of imminent supply disruption and drive near-term oil price spikes as traders reprice short-term risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">western_alliance_realign</data>
  <data key="d40">iran_regional_conflict</data>
</edge>
<edge source="western_alliance_realign::diplomatic_signal_flow" target="russia_ukraine_war::escalation_dynamics" id="0">
