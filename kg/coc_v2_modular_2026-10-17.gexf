      <edge source="russia_ukraine_war::satcom_access_avail" target="global_energy_supply_cri::maritime_attack_rate" id="52">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Improved availability/reliability of commercial satellite communications enhances merchant situational awareness, AIS/monitoring and timely reporting, enabling avoidance, deterrence or rapid response that lowers the incidence of successful hostile actions against shipping and energy infrastructure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_energy_supply_cri" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
