        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Tighter Chinese regulatory scrutiny that expands export controls and compliance checks makes Chinese firms and banks less willing/able to route sanctioned goods and transactions to Russian actors, increasing the effective intensity of sanctions enforcement." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="russia_ukraine_war" />
