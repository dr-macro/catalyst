          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater availability/reliability of commercial satellite communications provides Iran‑backed proxies with resilient command, timing and guidance links for UAVs and loitering munitions, increasing both frequency and accuracy of strike operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
