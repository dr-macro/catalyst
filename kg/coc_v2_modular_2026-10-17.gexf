      <edge source="russia_ukraine_war::satcom_access_avail" target="global_economic_strain::market_volatility" id="51">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A deterioration or loss of commercial satcom availability disrupts market data, trading connectivity and surveillance (especially for remote regions/segments), increasing execution uncertainty and short-term asset-price volatility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_economic_strain" />
          <attvalue for="27" value="0" />
