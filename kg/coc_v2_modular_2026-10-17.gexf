      <edge source="global_economic_strain::sovereign_fiscal_stress" target="china_tech_trade_rivalry::regulatory_scrutiny" id="717">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Growing fiscal pressure pushes states to prioritize industrial protection and revenue-preserving oversight, leading to expanded export controls, investment screening, and enforcement measures targeting technology flows linked to China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_economic_strain" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_economic_strain::sovereign_fiscal_stress" target="global_energy_supply_cri::maritime_attack_rate" id="718">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute fiscal pressure forces cuts to naval/coastguard patrols and to contracted maritime security, and increases likelihood of unpaid/undermotivated local forces, which raises the frequency of piracy and asymmetric attacks on commercial energy shipping." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_economic_strain" />
          <attvalue for="38" value="global_energy_supply_cri" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_economic_strain::sovereign_fiscal_stress" target="iran_proxy_escalation::escalation_strength" id="719">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Acute increases in sovereign fiscal stress for a regional patron prompt political leaders to rely more on deniable proxy operations and calibrated attacks to project power and rally domestic support, which strengthens reciprocal escalation feedbacks between opponents and proxies." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_economic_strain" />
          <attvalue for="38" value="iran_proxy_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_economic_strain::sovereign_fiscal_stress" target="russia_ukraine_war::alliance_defense_commit" id="720">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising sovereign fiscal stress forces governments to reallocate budgetary resources and delay or scale back announced defense aid, procurement and deployments to Ukraine, reducing allied defence commitments." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_economic_strain" />
          <attvalue for="38" value="russia_ukraine_war" />
