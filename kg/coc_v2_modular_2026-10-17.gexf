      <edge source="china_tech_trade_rivalry::regulatory_scrutiny" target="global_economic_strain::cross_border_capital_flo" id="372">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Heightened regulatory scrutiny (e.g., tighter foreign-ownership limits, inspections, or delisting risk) prompts foreign investors to reduce or withdraw allocations to Chinese tech, directly cutting cross-border capital flows into the market." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="global_economic_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::regulatory_scrutiny" target="global_economic_strain::market_volatility" id="373">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="New or intensified regulatory actions increase uncertainty about earnings, compliance costs and legal risk for large tech firms, triggering abrupt repricing and spikes in equity and options-implied volatility across markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="global_economic_strain" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::regulatory_scrutiny" target="global_energy_supply_cri::maritime_attack_rate" id="374">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating regulatory scrutiny and export controls against Chinese tech firms provoke state-led or state-tolerated asymmetric retaliation and coercive maritime operations (harassment, interceptions, attacks on vessels in contested sea lanes) as a political signal, raising the incidence of hostile actions against commercial shipping and maritime energy infrastructure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="global_energy_supply_cri" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_tech_trade_rivalry::regulatory_scrutiny" target="iran_proxy_escalation::supply_chain_disruption" id="375">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stricter Chinese export controls and enforcement on dual‑use chips, sensors and AI-enabled subsystems immediately reduce legally available channels for proxies to obtain strike-enabling hardware, degrading their ability to interdict shipping and regional logistics and thereby lowering the incidence of attack-driven supply‑chain disruption." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_tech_trade_rivalry" />
          <attvalue for="38" value="iran_proxy_escalation" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
