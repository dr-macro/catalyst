          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A disruption or reduction in energy supply flows raises near-term headline inflation and inflation expectations (via higher fuel and power prices), prompting markets to price in a steeper central-bank tightening path." />
