          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher allied defense commitment produces more naval escorts, patrols and air surveillance for trade routes and energy infrastructure, raising the expected cost of maritime attacks and thus reducing their frequency." />
