          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="War-driven interruptions and volatility in energy flows raise electricity and operating costs for AI datacentres and cloud providers, reducing projected returns and causing financiers to delay, reprice, or withdraw capital from energy‑intensive AI projects (including investments tied to China)." />
          <attvalue for="36" value="0-6 months" />
