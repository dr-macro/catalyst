          <attvalue for="35" value="A direct fall in net cross-border capital flows reduces the pool of foreign and syndicated financing available to AI startups and infrastructure projects, cutting observable capital deployment into AI (including into China-focused AI firms)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_economic_strain" />
          <attvalue for="38" value="china_tech_trade_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_economic_strain::cross_border_capital_flo" target="global_energy_supply_cri::tanker_availability_inde" id="705">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Sudden net outflows and withdrawal of correspondent-banking relationships constrain trade finance and owners' access to working capital, causing shipowners to idle, cancel charters, or be unable to operate/maintain vessels, which reduces effective tanker availability." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_economic_strain" />
          <attvalue for="38" value="global_energy_supply_cri" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_economic_strain::cross_border_capital_flo" target="iran_proxy_escalation::armed_strike_intensity" id="706">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rise in cross-border capital flows increases the volume of funds and hard-currency transfers reaching patron states, diasporas, and informal finance channels that directly bankroll, equip and sustain Iranian-aligned proxy groups, enabling a higher tempo and intensity of strikes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_economic_strain" />
          <attvalue for="38" value="iran_proxy_escalation" />
          <attvalue for="27" value="0" />
