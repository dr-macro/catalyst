          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Higher allied defence commitments translate into increased defence procurement, deployments, and transfer of equipment or financial aid by contributing governments, raising near- to medium-term borrowing needs and debt-servicing pressures." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_economic_strain" />
          <attvalue for="27" value="0" />
