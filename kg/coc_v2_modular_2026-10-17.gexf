          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Stronger, more public allied defence commitments increase the likelihood of coordinated security-driven industrial policies and decoupling, raising perceived geopolitical risk and lowering investor appetite for AI exposures connected to rival states such as China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
