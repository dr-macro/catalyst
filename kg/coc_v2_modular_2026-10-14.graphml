<edge source="global_energy_volatility::reserve_currency_index" target="bond_market_stress::cross_border_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Appreciation in a major reserve currency increases expected returns and safe‑asset demand in that currency, drawing incremental cross‑border capital into reserve‑currency‑denominated fixed‑income instruments and altering net flows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_volatility</data>
  <data key="d40">bond_market_stress</data>
</edge>
