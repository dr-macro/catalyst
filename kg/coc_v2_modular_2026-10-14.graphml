  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Net inflows into assets denominated in a reserve currency increase demand for that currency to settle purchases, directly appreciating the reserve currency index relative to other currencies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">bond_market_stress</data>
  <data key="d40">global_energy_volatility</data>
