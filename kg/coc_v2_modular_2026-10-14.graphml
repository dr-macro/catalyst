<edge source="bond_market_stress::currency_pressure_index" target="china_west_rivalry::vehicle_import_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Heightened currency pressure that produces relative depreciation of the renminbi or a weaker euro makes Chinese vehicle exporters more price-competitive in Europe, mechanically increasing volumes of vehicle imports.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">bond_market_stress</data>
  <data key="d40">china_west_rivalry</data>
</edge>
<edge source="bond_market_stress::currency_pressure_index" target="global_energy_volatility::oil_price" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Depreciation pressure on major energy-consuming currencies raises local-currency retail prices for dollar-priced oil, suppressing consumption and lowering near-term physical crude demand and prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">bond_market_stress</data>
  <data key="d40">global_energy_volatility</data>
</edge>
<edge source="bond_market_stress::currency_pressure_index" target="gulf_proxy_campaign::energy_export_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Acute currency pressure prompts authorities to impose FX controls and disrupts dollar-denominated settlement and insurance arrangements, delaying shipments and reducing the rate of oil and LNG exports until payment/settlement frictions are resolved.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">bond_market_stress</data>
  <data key="d40">gulf_proxy_campaign</data>
</edge>
