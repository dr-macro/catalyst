  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Rising regional geopolitical tension increases signaling, mobilization, and permissive intent among state and non-state patrons, directly raising the frequency of proxy kinetic strikes (drones, missiles, attacks on infrastructure) as actors exploit or escalate the environment.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_volatility</data>
  <data key="d40">gulf_proxy_campaign</data>
</edge>
<edge source="global_energy_volatility::geopolitical_tension" target="gulf_proxy_campaign::airline_cancellation_rat" id="0">
