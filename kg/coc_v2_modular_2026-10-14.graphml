</edge>
<edge source="russia_ukraine_war::alliance_cohesion_level" target="china_west_rivalry::geopolitical_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">A rise in alliance cohesion around the Russia–Ukraine war produces coordinated strategic posture, intelligence-sharing and security commitments (including deeper NATO–Indo‑Pacific ties) that directly increase friction and perceived threat between Western coalitions and China.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">china_west_rivalry</data>
</edge>
<edge source="russia_ukraine_war::alliance_cohesion_level" target="global_energy_volatility::oil_price" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Higher political and operational cohesion among partner states leads to coordinated measures (e.g., embargoes, synchronized import reductions, tighter insurance/transport constraints) that reduce accessible supply and increase risk premia, lifting oil prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_volatility</data>
</edge>
<edge source="russia_ukraine_war::alliance_cohesion_level" target="gulf_proxy_campaign::military_response_intens" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A decline in Western alliance cohesion reduces coordinated diplomatic and deterrent pressure on regional actors, lowering external restraints and enabling higher-intensity military countermeasures in Gulf proxy engagements.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">gulf_proxy_campaign</data>
</edge>
