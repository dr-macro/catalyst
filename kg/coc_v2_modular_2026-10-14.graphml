  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">An increase in the frequency and intensity of attacks raises event risk and uncertainty about sovereign/corporate credit and fiscal costs, triggering faster repricing and larger short-term swings in sovereign and corporate bond yields.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">bond_market_stress</data>
</edge>
<edge source="russia_ukraine_war::military_attack_rate" target="bond_market_stress::bond_market_liquidity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalating attacks increase settlement and counterparty risk and induce market-makers to pull inventory and widen quotes, directly reducing depth and tradability in bond markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">bond_market_stress</data>
</edge>
<edge source="russia_ukraine_war::military_attack_rate" target="china_west_rivalry::manu_invest_flow" id="0">
