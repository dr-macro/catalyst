<edge source="global_energy_volatility::geopolitical_tension" target="bond_market_stress::yield_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Spikes in geopolitical tension trigger abrupt re-pricing of risk and flight-to-safety flows that cause rapid shifts in demand across sovereign and corporate bonds, producing larger intraday and realized yield swings.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_volatility</data>
  <data key="d40">bond_market_stress</data>
</edge>
<edge source="global_energy_volatility::geopolitical_tension" target="china_west_rivalry::geopolitical_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Energy-related spikes in geopolitical risk (supply cut-offs, sanctioning of energy routes or suppliers) lead governments to use energy diplomacy and countermeasures that directly escalate bilateral security frictions between China and Western states.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_volatility</data>
  <data key="d40">china_west_rivalry</data>
</edge>
<edge source="global_energy_volatility::geopolitical_tension" target="gulf_proxy_campaign::kinetic_attack_rate" id="0">
