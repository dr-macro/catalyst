<edge source="western_alliance_realign::regulatory_alignment" target="middle_east_energy::insurance_premium_avail" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Closer regulatory alignment with sanctioning or enhanced-risk standards forces insurers and reinsurers to withdraw or limit coverage for clients and routes that fail new compliance thresholds, raising premiums and reducing availability for Middle Eastern energy shipments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">western_alliance_realign</data>
  <data key="d39">middle_east_energy</data>
</edge>
<edge source="western_alliance_realign::regulatory_alignment" target="russia_ukraine_war::drone_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Harmonizing technical and dual‑use regulatory standards reduces barriers to cross‑border transfers and commercial sourcing of drone components, expanding supply chains and raising the rate at which unmanned systems are fielded in the conflict over the medium term.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">western_alliance_realign</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="western_alliance_realign::regulatory_alignment" target="space_weapons_race::launch_cadence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Harmonization of export controls, licensing and safety standards removes cross‑border bureaucratic delays for satellite exports and foreign launches, shortening approval timelines and enabling more frequent launches.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">western_alliance_realign</data>
  <data key="d39">space_weapons_race</data>
</edge>
<edge source="western_alliance_realign::regulatory_alignment" target="us_china_tech_rivalry::advanced_chip_capacity" id="0">
