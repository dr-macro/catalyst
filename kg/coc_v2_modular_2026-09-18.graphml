<edge source="russia_ukraine_war::energy_supply_disruption" target="middle_east_energy::energy_export_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Interruptions to Russian energy supplies prompt importers (Europe, Asia) to divert purchases to Middle Eastern producers and accelerate tanker loadings and terminal throughput, raising near‑term export throughput/utilization of spare capacity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">middle_east_energy</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_disruption" target="space_weapons_race::launch_cadence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Interruptions to fuel and power supplies for manufacturing sites and launch complexes increase costs, force temporary shutdowns or rescheduling, and reduce the short‑term number of orbital launches.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">space_weapons_race</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_disruption" target="us_china_tech_rivalry::advanced_chip_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Recurrent energy and supply shocks expose reliance risks and prompt US/EU/allied subsidy and permitting programs to accelerate construction of domestic advanced semiconductor fabs, increasing installed advanced chip production capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_disruption" target="western_alliance_realign::trade_tension_partner" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Interruptions to Russian gas and oil exports prompt Western import restrictions, sanctions and import‑diversification measures while Russia imposes counter‑measures, producing immediate rises in bilateral trade frictions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">western_alliance_realign</data>
</edge>
