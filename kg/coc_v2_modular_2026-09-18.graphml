<edge source="russia_ukraine_war::alliance_cohesion_level" target="space_weapons_race::launch_cadence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Tighter political and operational unity among security partners leads to coordinated replenishment and resilience programs for military and dual‑use constellations, pooled launch contracts and prioritized access to launch ranges, raising the allied launch tempo.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">space_weapons_race</data>
</edge>
<edge source="russia_ukraine_war::alliance_cohesion_level" target="us_china_tech_rivalry::regulatory_restrictions" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Greater political and operational unity among US allies driven by the war enables coordinated export controls, harmonized investment screening and shared sanctions programs that tighten regulatory restrictions on Chinese access to sensitive technologies.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
