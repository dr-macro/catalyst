<edge source="middle_east_energy::fuel_price_level" target="russia_ukraine_war::military_engagement" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained rise in global oil and fuel prices driven by Middle East market pressure increases Russian energy export revenue and fiscal room, enabling higher operational tempo and sustainment of combat operations in Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_energy</data>
