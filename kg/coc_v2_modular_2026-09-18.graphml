<edge source="middle_east_energy::insurance_premium_avail" target="russia_ukraine_war::arms_flow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Sharp increases in marine and cargo insurance premiums or withdrawal of cover for routes near Middle East hotspots raises transport costs and risk for maritime and multimodal shipments of weapons and munitions to Ukraine, leading to measurable delays or reductions in the tempo of arms deliveries.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_energy</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="middle_east_energy::insurance_premium_avail" target="us_china_tech_rivalry::tech_capital_inflow_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A rise in marine/cargo insurance premiums or a drop in insurance availability for energy and shipping routes materially raises perceived logistics and project risk for semiconductor supply chains, reducing investors' willingness to commit cross-border capital into tech manufacturing and fabs.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">middle_east_energy</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
