<edge source="russia_ukraine_war::drone_attack_rate" target="middle_east_energy::insurance_premium_avail" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A higher rate of drone attacks in the Russia–Ukraine war increases insurer perception of unmanned‑weapon threats and the likelihood of similar attacks on ships and coastal energy facilities, driving up premiums and exclusions for regional energy shipments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">middle_east_energy</data>
</edge>
<edge source="russia_ukraine_war::drone_attack_rate" target="western_alliance_realign::regulatory_alignment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in combat and proliferated drone use spurs allied regulators to standardize export controls, airspace safety rules and counter‑UAS certification with partners to limit technology leakage and interoperable responses.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">western_alliance_realign</data>
</edge>
