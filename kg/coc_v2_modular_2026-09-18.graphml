<edge source="western_alliance_realign::diplomatic_alignment" target="middle_east_energy::military_deployment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A shift toward closer diplomatic alignment with regional partners typically triggers basing agreements, joint exercises and explicit security commitments that lead to faster redeployment or augmentation of allied forces in the Middle East.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">western_alliance_realign</data>
  <data key="d39">middle_east_energy</data>
</edge>
<edge source="western_alliance_realign::diplomatic_alignment" target="russia_ukraine_war::alliance_cohesion_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Tighter diplomatic alignment with a foreign union produces synchronized positions, sanctions and public messaging that directly raise political and operational unity among security partners responding to Russia's actions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">western_alliance_realign</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="western_alliance_realign::diplomatic_alignment" target="space_weapons_race::counterspace_capability_" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Deeper diplomatic alignment produces formal intelligence‑sharing agreements, combined operational planning and authorized technology transfer that accelerate joint development and fielding of counterspace systems.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">western_alliance_realign</data>
  <data key="d39">space_weapons_race</data>
</edge>
<edge source="western_alliance_realign::diplomatic_alignment" target="us_china_tech_rivalry::regulatory_restrictions" id="0">
