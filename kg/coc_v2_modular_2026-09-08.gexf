          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="More fragmented ownership of oil assets and contracts creates opportunities for intermediary firms and opaque payment chains that can reroute proceeds to military procurement while evading sanctions, increasing flows that sustain operations." />
