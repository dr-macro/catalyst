      <edge source="global_bond_turmoil::nonbank_funding_stress" target="global_energy_shock::state_directed_economy" id="726">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute stress in non‑bank funding channels forces independent E&amp;P firms and private midstream operators to curtail investment or sell assets, prompting governments to deploy state oil companies, emergency directives or targeted recapitalisations to sustain production and service delivery." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_turmoil" />
          <attvalue for="38" value="global_energy_shock" />
          <attvalue for="27" value="0" />
