      <edge source="china_us_tech_trade::capital_investment_ai" target="russia_ukraine_war::external_security_coop" id="547">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Expanded commercial and defense AI investment in the US and allied firms produces deployable ISR, analytics and secure-communications products that governments and partners rapidly use to coordinate military assistance and intelligence sharing for Ukraine, strengthening external security cooperation among those partners." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_us_tech_trade" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
