          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating maritime security risk produces a flight-to-quality as investors seek safe assets, boosting demand for U.S. Treasuries and pushing nominal yields down independent of commodity-price channels." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
