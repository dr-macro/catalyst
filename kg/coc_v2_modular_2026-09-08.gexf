      <edge source="china_us_tech_trade::regulatory_scrutiny" target="global_bond_turmoil::bond_market_liquidity" id="578">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Intensified cross‑border technology controls and compliance requirements cause dealers and funds to reduce inventories and withdraw from intermediation of securities linked to affected firms, widening bid‑ask spreads and reducing bond market depth." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_us_tech_trade" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_us_tech_trade::regulatory_scrutiny" target="global_energy_shock::state_directed_economy" id="579">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Intensified US/China tech export controls prompt the targeted government to centrally coordinate energy procurement, financing and overseas asset deals through state-owned oil companies to secure supplies and hard currency, increasing the degree of state direction in the oil sector." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_us_tech_trade" />
          <attvalue for="38" value="global_energy_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_us_tech_trade::regulatory_scrutiny" target="global_energy_shock::contract_enforceability" id="580">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="New export licensing, sanctions and extraterritorial compliance obligations create legal uncertainty and risk of penalty for counterparties, causing suspension, repudiation or litigation of cross-border oil contracts and reducing predictable enforceability of those contracts." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_us_tech_trade" />
          <attvalue for="38" value="global_energy_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_us_tech_trade::regulatory_scrutiny" target="global_energy_shock::sovereign_asset_access" id="581">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened export controls and associated sanctions incentivize onshoring, re‑domiciliation and creation of legal ring‑fences around state-linked oil assets, making them harder for external claimants or foreign creditors to seize or monetize." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_us_tech_trade" />
          <attvalue for="38" value="global_energy_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
