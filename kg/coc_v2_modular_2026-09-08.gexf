      <edge source="us_iran_maritime_war::maritime_security_risk" target="china_us_tech_trade::regulatory_scrutiny" id="30">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Spikes in maritime security incidents give US policymakers political cover and intelligence evidence to broaden export controls, sanctions and compliance requirements targeting Chinese access to AI compute and cloud services." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
          <attvalue for="38" value="china_us_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_war::maritime_security_risk" target="china_us_tech_trade::ai_compute_capacity" id="31">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Heightened maritime attacks and convoy risks disrupt shipments of GPUs, servers and spare parts and force cloud providers to throttle or relocate workloads, reducing available AI compute capacity that depends on cross-border hardware flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
          <attvalue for="38" value="china_us_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_war::maritime_security_risk" target="global_bond_turmoil::bond_market_liquidity" id="32">
        <attvalues>
