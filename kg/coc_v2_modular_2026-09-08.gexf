          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A pronounced fall in bond‑market liquidity elevates transaction costs and forces distressed sellers into fire sales, which are typically purchased by a small number of well‑capitalised buyers (often state or strategic investors), reducing dispersion of ownership and increasing concentration." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_turmoil" />
          <attvalue for="38" value="global_energy_shock" />
          <attvalue for="27" value="0" />
