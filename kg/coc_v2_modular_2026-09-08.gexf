          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A deterioration in enforceability of oil‑sector contracts directly reduces the value and fungibility of receivables and collateral used by shadow banks and money‑market funds, prompting higher haircuts and liquidity hoarding that raise non‑bank funding stress." />
