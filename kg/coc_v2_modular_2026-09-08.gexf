      <edge source="us_iran_maritime_war::maritime_blockade_degree" target="china_us_tech_trade::capital_investment_ai" id="103">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A more intensive blockade raises shipping and insurance costs and elevates perceived geopolitical risk, prompting foreign and US investors to delay, downsize or withdraw financing for AI infrastructure projects tied to China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
          <attvalue for="38" value="china_us_tech_trade" />
