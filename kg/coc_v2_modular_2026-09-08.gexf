          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A fall in private capital flows into AI (driven by trade frictions) reallocates financing toward large, state-backed energy projects and acquisitions by national oil firms, increasing consolidation and thereby reducing fragmentation of oil asset ownership." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_us_tech_trade" />
          <attvalue for="38" value="global_energy_shock" />
          <attvalue for="27" value="0" />
