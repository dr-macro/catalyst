          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Weakened enforceability of energy and infrastructure contracts makes developers unable to secure long‑term, reliable power and service agreements, prompting postponement or cancellation of planned data‑centre construction." />
