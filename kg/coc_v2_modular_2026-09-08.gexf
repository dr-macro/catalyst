          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher maritime security risk increases the likelihood of attacks and insurance/operational losses, prompting primary dealers and market-makers to pull back, widen bid-ask spreads and reduce inventory, thereby lowering bond market liquidity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
