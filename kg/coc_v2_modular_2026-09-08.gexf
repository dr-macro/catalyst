          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Large capital inflows accelerate development and commercialization of offensive AI tooling and specialist contractor capacity (automated exploit discovery, malware generation, intrusion-as-a-service), which directly increases the frequency and sophistication of cyber intrusions against actors in the Russia–Ukraine context." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_us_tech_trade" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
