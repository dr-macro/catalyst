      <edge source="global_bond_turmoil::nonbank_funding_stress" target="russia_ukraine_war::wartime_funding_flow" id="727">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute stress in non‑bank funding (export credit, private arms finance, commercial paper) dries up private and commercial channels used to finance arms, logistics and reconstruction, directly reducing the volume and timeliness of wartime transfers to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_turmoil" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
