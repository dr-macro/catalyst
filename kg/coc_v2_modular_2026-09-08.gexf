      <edge source="china_us_tech_trade::capital_investment_ai" target="global_bond_turmoil::nonbank_funding_stress" id="544">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A rapid surge in AI capital spending (VC rounds, project financing, M&amp;A) draws large tranches of term funding from private credit funds and asset managers, tightening available non‑bank liquidity and raising rollover and margin pressures in the shadow‑bank sector." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_us_tech_trade" />
