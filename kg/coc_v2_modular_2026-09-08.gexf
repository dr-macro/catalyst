          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater fragmentation of title and revenue claims in oil assets increases episodic payment and FX settlement frictions for oil exporters/importers, raising the likelihood and magnitude of central‑bank interventions to stabilise FX and domestic bond markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_energy_shock" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="27" value="0" />
