          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Stronger external security cooperation leads governments to tighten investment screening and impose sanctions/blacklists that directly block or deter Chinese M&amp;A and capital flows into US/allied AI infrastructure, reducing cross‑border capital_investment_ai from China." />
