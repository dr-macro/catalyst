          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharp deterioration in global bond market liquidity forces allied treasuries and defence ministries to prioritise domestic market stabilisation and short‑term financing needs, reducing the pace and scope of coordinated security assistance and intelligence support to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_turmoil" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
