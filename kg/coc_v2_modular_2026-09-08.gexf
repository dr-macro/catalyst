          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Greater fragmentation and opacity of oil‑asset ownership obscures links to foreign state actors, which triggers faster and broader regulatory reviews and restrictions on related cross‑border tech investments and partnerships." />
