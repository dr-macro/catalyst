          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising non‑bank funding stress reduces short‑term credit and liquidity available to commodity traders, shipowners and marine insurers, prompting insurers to withdraw capacity and operators to avoid high‑risk transits, which raises assessed and realized maritime security risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_turmoil" />
