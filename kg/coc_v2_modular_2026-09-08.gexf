          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Stress in non‑bank credit channels reduces availability of private credit, venture and mezzanine funding—particularly important in China—leading startups and smaller cloud providers to postpone or shrink AI infrastructure investments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_turmoil" />
          <attvalue for="38" value="china_us_tech_trade" />
          <attvalue for="27" value="0" />
