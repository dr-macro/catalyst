        </attvalues>
      </edge>
      <edge source="us_iran_maritime_war::maritime_blockade_degree" target="global_bond_turmoil::nonbank_funding_stress" id="104">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A tighter maritime blockade disrupts trade flows and delays export receipts, triggering margin calls and liquidity mismatches for trade-finance conduits and shadow lenders and thereby increasing nonbank funding stress." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_war::maritime_blockade_degree" target="global_energy_shock::sovereign_asset_access" id="105">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Intensified maritime blockades and port restrictions immobilize cargo and revenue flows, prompt banks and insurers to freeze related accounts/transactions and cause custodians to withhold or seize shipments, materially reducing the ability of external claimants to access or monetize state-linked maritime assets and receipts." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
          <attvalue for="38" value="global_energy_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_war::maritime_blockade_degree" target="global_energy_shock::contract_enforceability" id="106">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Widespread blockade-driven failures to perform deliveries increase force-majeure invocations, produce cross-jurisdictional disputes and discourage courts and insurers from reliably upholding remedies, lowering predictable enforceability of oil-sector contracts." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
          <attvalue for="38" value="global_energy_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_maritime_war::maritime_blockade_degree" target="russia_ukraine_war::external_security_coop" id="107">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="An intensified maritime blockade in the Middle East forces Western navies and security planners to reallocate assets and attention to regional escort and de‑confliction tasks, reducing their capacity and political bandwidth for coordinated security assistance and intelligence efforts tied to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_maritime_war" />
          <attvalue for="38" value="russia_ukraine_war" />
