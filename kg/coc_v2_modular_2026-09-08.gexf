          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Reduced accessibility of sovereign assets (e.g., freezes, nationalization risk, or limits on pledging state-linked revenue) raises counterparty and collateral risk for financiers, causing banks and institutional investors to pull or withhold funding for cross-border AI infrastructure projects." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_energy_shock" />
