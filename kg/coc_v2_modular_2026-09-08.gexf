      <edge source="global_energy_shock::state_directed_economy" target="china_us_tech_trade::ai_compute_capacity" id="301">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="When energy policy becomes more state‑directed, authorities may reallocate limited electricity and fuel toward prioritized domestic industries or state projects, reducing available power for commercial data centres and thereby lowering deployable AI compute capacity." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_energy_shock" />
          <attvalue for="38" value="china_us_tech_trade" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_shock::state_directed_economy" target="global_bond_turmoil::policy_rate_expectations" id="302">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rapid increase in state direction of oil production and pricing reduces market responsiveness and raises near‑term energy price volatility and inflation expectations, causing markets to price a higher path for short‑term policy rates." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_energy_shock" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_shock::state_directed_economy" target="russia_ukraine_war::wartime_funding_flow" id="303">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An increase in state direction lets authorities rapidly reallocate hydrocarbon sales, suspend market pricing, and prioritize budget transfers to defence suppliers, directly raising funds available for military operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_energy_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_shock::state_directed_economy" target="russia_ukraine_war::external_security_coop" id="304">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Greater state control over energy exports enables targeted discounts, supply guarantees or threats to individual states, producing cleavages among external partners and degrading coordinated security assistance and policy alignment." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_energy_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_energy_shock::state_directed_economy" target="us_iran_maritime_war::maritime_security_risk" id="305">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An increase in state-directed control of the oil sector enables governments to deploy and coordinate naval, coastguard and state-linked militias to protect or interdict energy shipments, raising the probability and severity of hostile actions against commercial vessels." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_energy_shock" />
