      <edge source="russia_ukraine_war::kinetic_operation_int" target="global_bond_shock::bond_market_liquidity" id="34">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Spikes in kinetic activity drive flight-to-safety and tail-risk hedging while reducing dealer willingness to warehouse sovereign paper, widening bid-ask spreads and degrading bond-market liquidity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::kinetic_operation_int" target="iran_regional_conflict::proxy_attack_frequency" id="35">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="High kinetic intensity in Ukraine diverts diplomatic, intelligence and military attention and ties up partner capacities, reducing external constraints and oversight on Iran and its proxies and thereby enabling a higher tempo of proxy attacks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_regional_conflict" />
