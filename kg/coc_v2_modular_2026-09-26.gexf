      <edge source="us_china_rivalry::bilat_political_tension" target="energy_market_stress::diesel_price_level" id="214">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute increases in bilateral political tension raise geopolitical risk premia, push up marine insurance and freight costs on key shipping routes and trigger precautionary buying, which together lift spot diesel prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="energy_market_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::bilat_political_tension" target="global_bond_shock::market_volatility" id="215">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Spikes in bilateral political tension (diplomatic incidents, military posturing) directly raise geopolitical risk premia and trigger rapid portfolio rebalancing and flight-to-safety, increasing realized and implied market volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_bond_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::bilat_political_tension" target="iran_regional_conflict::diplomatic_engagement" id="216">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rising US–China political tension reduces cooperation and mutual trust, causing Beijing and Washington to withhold participation or block third‑party mediation on Iran and thereby cutting the intensity and continuity of diplomatic talks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::bilat_political_tension" target="iran_regional_conflict::escalation_threshold" id="217">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher bilateral tension raises the perceived risk that a localized incident could draw in great‑power competition, causing regional actors to lower their tolerance for continued hostilities (i.e., a lower perceived escalation threshold)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::bilat_political_tension" target="russia_ukraine_war::kinetic_operation_int" id="218">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising US–China political tension draws US and allied diplomatic attention and some forward-deployable logistics and munitions priority toward the Indo‑Pacific, reducing the pace and predictability of sustained Western military assistance to Ukraine and thereby creating openings Russia can exploit to intensify kinetic operations." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::bilat_political_tension" target="russia_ukraine_war::sanctions_pressure_level" id="219">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="As bilateral tensions increase, China becomes less willing to cooperate with Western sanctions enforcement or secondary pressure measures, enabling Russia to route trade and finance around restrictions and thus lowering effective cumulative sanctions pressure." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
