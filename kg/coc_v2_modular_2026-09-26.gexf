      <edge source="russia_ukraine_war::sanctions_pressure_level" target="energy_market_stress::diesel_export_volume" id="57">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Expanded sanctions on Russian energy sectors and associated banking/shipping services directly block sales, payments and insurance for diesel shipments, causing an immediate reduction in export flows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_market_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="global_bond_shock::corporate_funding_cost" id="58">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Expanded sanctions and the risk of secondary sanctions constrain correspondent banking and dollar clearing access for institutions, forcing banks and corporates to pay higher risk premia and borrowing spreads when issuing or rolling over debt." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="iran_regional_conflict::sanctions_pressure" id="59">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Heightened sanctions pressure against Russia normalizes and expands legal/regulatory frameworks and allied coordination mechanisms that governments and multilateral partners then repurpose or extend to impose new or tighter sanctions on Iran." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="us_china_rivalry::export_control_strength" id="60">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Expansion and normalization of sanctions regimes against Russia create legal, technical and bureaucratic precedents and interagency pathways that policymakers and regulators then apply to China, prompting broader and tighter export‑control lists and enforcement regimes." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="us_china_rivalry::capital_invest_flows" id="61">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Heightened sanctions and secondary‑sanctions risk tied to the Russia conflict increases compliance costs and risk aversion among Western banks and institutional investors, leading them to scale back cross‑border M&amp;A, portfolio and project finance exposure to jurisdictions perceived as sanction‑risky, including targets linked to China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure_level" target="concept::sanctions_pressure_level" id="62">
        <attvalues>
          <attvalue for="27" value="instance_of" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="russia_ukraine_war::allied_readiness_level" id="63">
