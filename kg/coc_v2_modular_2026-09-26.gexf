      <edge source="iran_regional_conflict::military_escalation" target="energy_market_stress::diesel_price_level" id="346">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Higher intensity of kinetic operations near key sea lanes and terminals raises insurance and security premia and produces immediate fears of supply disruption, pushing up spot diesel prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="energy_market_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::military_escalation" target="global_bond_shock::market_volatility" id="347">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rapid increases in kinetic operations produce sudden geopolitical risk shocks that prompt fast portfolio rebalancing and option/hedging flows, lifting realized and implied volatility in global fixed-income and broader markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="global_bond_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::military_escalation" target="global_bond_shock::bond_market_liquidity" id="348">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute escalation forces dealer risk limits and inventory reductions and creates one-sided safe‑haven flows, causing market‑making to withdraw and bid-ask spreads and price impact in sovereign bond markets to widen (i.e., lower liquidity)." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="global_bond_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::military_escalation" target="russia_ukraine_war::kinetic_operation_int" id="349">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A spike in Iranian-region kinetic operations forces U.S./NATO naval and air assets to redeploy to the Middle East, temporarily reducing deterrent presence in the Black Sea and Eastern Europe and enabling Russia to increase kinetic operations in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_regional_conflict::military_escalation" target="us_china_rivalry::bilat_political_tension" id="350">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sharp uptick in kinetic operations around Iran forces Washington to publicly demand Beijing curb its ties or material flows to Tehran; Chinese refusal or equivocation elicits US diplomatic sanctions, public reproach and reciprocal measures, directly heightening US–China political tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_regional_conflict" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
