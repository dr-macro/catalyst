          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Increased fiscal financing pressure raises the political and budgetary incentive for governments to restrict diesel exports to protect domestic supply, limit subsidy burdens, or suppress local price inflation." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_shock" />
