      <edge source="russia_ukraine_war::kinetic_operation_int" target="energy_market_stress::refiner_run_rates" id="33">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Direct strikes, sabotage or the need to relocate personnel and equipment at refinery sites force lowered throughput or temporary shutdowns, reducing run rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_market_stress" />
