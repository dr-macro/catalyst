      <edge source="global_bond_shock::fiscal_fin_pressure" target="iran_regional_conflict::proxy_attack_frequency" id="577">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher sovereign financing stress in Gulf backers forces near-term budget cuts and delays to off‑budget transfers, directly reducing cash flows to allied militias and lowering the rate of proxy strikes." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
