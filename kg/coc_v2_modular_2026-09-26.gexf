      <edge source="us_china_rivalry::tech_decouple_degree" target="global_bond_shock::long_term_nominal_yields" id="236">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater technological decoupling fragments global R&amp;D and supply chains, lowering long-run productivity and expected real growth and thereby reducing equilibrium real rates and pressuring long-term nominal sovereign yields downward." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="global_bond_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_rivalry::tech_decouple_degree" target="iran_regional_conflict::proxy_attack_frequency" id="237">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Deeper technological decoupling incentivizes alternative bilateral tech and dual‑use transfers outside established multinational controls (including from actors seeking to hedge ties with the US), enhancing Iranian and proxy strike capabilities and raising the rate of proxy attacks over time." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_rivalry" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
