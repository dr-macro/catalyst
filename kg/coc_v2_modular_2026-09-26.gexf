          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="A sustained rise in diesel prices raises per-unit revenue from legal and illicit diesel sales and smuggling, directly increasing funds available to Iran-aligned proxy groups and enabling higher operational tempo of attacks." />
