      <edge source="russia_ukraine_war::energy_supply_disruption" target="energy_market_stress::diesel_price_level" id="69">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Physical interruptions to production, pipelines or loading terminals reduce available diesel volumes on markets, raising spot prices through tighter immediate supply." />
