          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rapid increase in diesel export restrictions (especially by exporters linked to Beijing or affecting US allies) is read as intentional energy leverage or coercion, prompting the US to escalate diplomatic protests, sanctions threats and public confrontations with China, raising bilateral political tension." />
