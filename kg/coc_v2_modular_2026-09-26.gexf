      <edge source="global_bond_shock::bond_market_liquidity" target="energy_market_stress::diesel_inventory_levels" id="541">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A liquidity squeeze in bond markets reduces availability of repo and short-term financing lines that traders and storage owners use to carry product stocks, forcing rapid drawdowns or reduced accumulation of diesel inventories." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="39" value="energy_market_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_shock::bond_market_liquidity" target="iran_regional_conflict::proxy_attack_frequency" id="542">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A global drop in bond market liquidity raises transaction costs and frictions for cross‑border payments and sovereign issuance, constraining the operational funding pipelines that sustain proxy operations and reducing attack frequency." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_shock::bond_market_liquidity" target="us_china_rivalry::capital_invest_flows" id="543">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Deteriorating sovereign bond market liquidity increases transaction costs and tail‑risk concerns for global investors, causing them to curtail cross-border equity and debt investments and slow M&amp;A activity between the US and China." />
