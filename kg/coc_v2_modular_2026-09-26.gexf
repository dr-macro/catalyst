      <edge source="russia_ukraine_war::escalation_feedback" target="energy_market_stress::diesel_price_level" id="136">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Stronger escalation cycles increase geopolitical risk premia and insurance/shipping costs, which are passed into futures and spot markets and push diesel prices upward." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_market_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_feedback" target="global_bond_shock::market_volatility" id="137">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger escalation-feedback dynamics increase the probability and abruptness of military or political shock events, prompting sudden re-pricing across asset classes and raising realized and implied market volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_feedback" target="iran_regional_conflict::escalation_threshold" id="138">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Visible strong escalation-feedback in Ukraine (rapid reciprocal cycles of retaliation) shifts regional threat perceptions and risk calculations, causing actors to expect spirals and therefore lower their perceived threshold for taking preemptive or escalatory measures." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::escalation_feedback" target="us_china_rivalry::tech_decouple_degree" id="139">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Stronger escalation dynamics in the Russia‑Ukraine war highlight the vulnerability of integrated tech and supply chains in a high‑intensity conflict, prompting policymakers to accelerate policies and industrial measures to segregate critical technology ecosystems from strategic rivals such as China." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
