          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rising sovereign financing stress in major sanctioning states raises the political and budgetary cost of maintaining broad, long-duration sanctions and enforcement programs, reducing the scope or intensity of sanctions they apply to Russia." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
