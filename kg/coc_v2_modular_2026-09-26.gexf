      <edge source="russia_ukraine_war::energy_supply_disruption" target="global_bond_shock::long_term_nominal_yields" id="70">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Acute interruptions to Russian energy flows raise near-term inflation expectations and term premia as markets price higher future policy rates and energy-related sovereign risk, lifting long-dated nominal yields globally." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="iran_regional_conflict::military_escalation" id="71">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Disruptions to global energy supply from the Russia-Ukraine war elevate fuel and shipping security concerns, prompting states and non-state actors in the Middle East to increase naval escorts, interdiction missions and pre-emptive strikes to secure routes and facilities, raising regional kinetic intensity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_regional_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_disruption" target="us_china_rivalry::bilat_political_tension" id="72">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="War-driven disruptions in European and global energy markets push China to deepen energy and strategic ties with Russia (e.g., increased imports, long‑term contracts), which the United States interprets as geopolitical alignment and responds with diplomatic pressure and strategic countermeasures that raise bilateral tensions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
