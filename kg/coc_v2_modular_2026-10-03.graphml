<edge source="global_bond_rout::fiscal_stress" target="mideast_escalation::regional_security_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.65</data>
  <data key="d37">A global bond rout raises sovereign borrowing costs for Middle Eastern governments, forcing rapid subsidy or payroll cuts and reducing capacity for policing, which increases protests, insurgent recruitment and the probability of interstate or intrastate escalation.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_bond_rout</data>
  <data key="d40">mideast_escalation</data>
</edge>
<edge source="global_bond_rout::fiscal_stress" target="russia_ukraine_war::security_threat_intensit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Rising sovereign fiscal stress in major donor countries forces near-term cuts, delays, or conditionality on military and economic aid to Ukraine, weakening Ukrainian operational capacity and thereby increasing security threat intensity on the front lines and border areas.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_rout</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_bond_rout::cross_border_flows" target="global_bond_rout::long_nominal_yields" id="0">
