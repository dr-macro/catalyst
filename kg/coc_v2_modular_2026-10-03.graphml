  <data key="d37">Escalating local insecurity drives down-the-supply-chain actions (commercial draws to meet urgent domestic demand, relocation or seizure of stocks, and reduced inbound logistics), producing an observable drop in aggregated stored diesel volumes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">mideast_escalation</data>
  <data key="d40">global_fuel_shock</data>
</edge>
<edge source="mideast_escalation::regional_security_risk" target="russia_ukraine_war::security_threat_intensit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A sharper escalation in the Middle East diverts Western diplomatic, intelligence and materiel attention or prompts redeployment of assets, weakening deterrence and support postures that enable increased Russian kinetic or hybrid operations, raising security threat intensity in the Russia–Ukraine war.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">mideast_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="mideast_escalation::regional_security_risk" target="us_china_rivalry::export_control_tightness" id="0">
