  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">A spike in regional insecurity generates political pressure and risk assessments that prompt policymakers to expand or tighten licensing restrictions and controls on AI‑relevant hardware and software transfers.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">mideast_escalation</data>
  <data key="d40">us_china_rivalry</data>
</edge>
