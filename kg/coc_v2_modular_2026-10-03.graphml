<edge source="global_fuel_shock::diesel_import_flows" target="mideast_escalation::energy_supply_disruption" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A sustained drop in diesel import volumes directly reduces delivered fuel to power plants, transport fleets and industrial users in import-dependent states, causing immediate outages, rationing and delayed fuel-dependent services.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_fuel_shock</data>
  <data key="d40">mideast_escalation</data>
</edge>
<edge source="global_fuel_shock::diesel_import_flows" target="russia_ukraine_war::energy_supply_disruption" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A reduction in diesel import flows into the theatre causes immediate shortfalls for transport, backup generators and heating in frontline and civilian systems, producing measurable interruptions to energy services and deliveries.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_fuel_shock</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
