<edge source="global_fuel_shock::geopolitical_tension" target="global_bond_rout::cross_border_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising geopolitical tension produces sanctions, correspondent-bank restrictions and settlement frictions that directly interrupt cross-border payments and capital transactions, reducing net cross-border flows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_fuel_shock</data>
  <data key="d40">global_bond_rout</data>
</edge>
<edge source="global_fuel_shock::geopolitical_tension" target="mideast_escalation::maritime_transit_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Rising geopolitical tension increases the probability of state or non-state hostile actions (attacks, interdictions, increased naval escorts or closures) in key chokepoints, directly raising the risk of shipping disruptions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_fuel_shock</data>
  <data key="d40">mideast_escalation</data>
