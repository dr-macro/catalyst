<edge source="global_fuel_shock::diesel_supply_rate" target="russia_ukraine_war::security_threat_intensit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A fall in the global diesel supply rate reduces available fuel for mechanized units and logistics for one or both combatants, lowering their ability to sustain high-tempo offensive operations and thus reducing near-term intensity of large-scale military actions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_fuel_shock</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_fuel_shock::diesel_supply_rate" target="us_china_rivalry::semiconductor_supply" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A fall in global diesel supply reduces availability of diesel for on-site backup generators and for road/sea logistics of critical chemicals and substrates, causing immediate production slowdowns and output curtailments at fabs and upstream suppliers.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_fuel_shock</data>
  <data key="d40">us_china_rivalry</data>
</edge>
