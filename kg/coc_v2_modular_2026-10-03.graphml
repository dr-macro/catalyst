<edge source="russia_ukraine_war::security_threat_intensit" target="global_bond_rout::investor_risk_aversion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Escalations in military and hybrid threats raise perceived tail‑risk and operational uncertainty for cross‑border investment, directly increasing investor risk aversion and preference for safe assets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_bond_rout</data>
</edge>
<edge source="russia_ukraine_war::security_threat_intensit" target="global_bond_rout::cross_border_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Heightened security threats trigger accelerated private capital outflows, repatriation and precautionary withdrawal of foreign credit lines from exposed jurisdictions and corridors, reducing net cross‑border inflows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_bond_rout</data>
</edge>
<edge source="russia_ukraine_war::security_threat_intensit" target="global_fuel_shock::diesel_inventory_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalating military and hybrid threats prompt commercial buyers and some governments to increase precautionary stockpiles of diesel and delay outbound shipments, raising aggregated inventory levels in the near term.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_fuel_shock</data>
</edge>
<edge source="russia_ukraine_war::security_threat_intensit" target="mideast_escalation::regional_security_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained high-intensity operations in Ukraine force Western militaries to reallocate assets and political attention away from the Middle East, creating windows for regional states and proxies to press advantages and carry out cross-border attacks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">mideast_escalation</data>
</edge>
<edge source="russia_ukraine_war::security_threat_intensit" target="us_china_rivalry::export_control_tightness" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Escalation of military and hybrid threats around the Russia–Ukraine war prompts the US and allies to broaden and tighten national‑security export controls on dual‑use AI hardware and software to limit adversary access.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_rivalry</data>
</edge>
<edge source="russia_ukraine_war::security_threat_intensit" target="us_china_rivalry::semiconductor_supply" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Rising conflict intensity drives sanctions, targeted restrictions, and logistical disruptions (including curtailed exports of critical materials and transport interruptions), directly reducing available inputs and operational continuity for semiconductor fabs and lowering chip throughput.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_rivalry</data>
</edge>
<edge source="russia_ukraine_war::security_threat_intensit" target="us_china_rivalry::investment_flow_to_ai" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Greater perceived geopolitical and military risk increases government defense R&amp;D and attracts private capital into security‑oriented AI startups and capabilities as investors reposition toward technologies deemed strategic in the US–China competition.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_rivalry</data>
</edge>
