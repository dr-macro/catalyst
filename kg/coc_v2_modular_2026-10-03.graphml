<edge source="us_china_rivalry::export_control_tightness" target="global_bond_rout::cross_border_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Stricter US-led export controls on AI hardware, software and related services directly block transactions and force multinationals to curtail sales and inward/outward investment, reducing net cross-border capital and trade-finance flows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">global_bond_rout</data>
</edge>
<edge source="us_china_rivalry::export_control_tightness" target="global_fuel_shock::diesel_spot_price" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Tighter AI-related export controls provoke reciprocal trade measures and disruption of cross‑border flows of refinery catalysts, specialized equipment, and spare parts, constraining diesel supply chains and pushing up spot prices.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">global_fuel_shock</data>
</edge>
<edge source="us_china_rivalry::export_control_tightness" target="global_fuel_shock::geopolitical_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Escalating export restrictions on strategic AI hardware increase bilateral friction and precipitate diplomatic and economic countermeasures, raising measured geopolitical tension that affects energy markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">global_fuel_shock</data>
</edge>
<edge source="us_china_rivalry::export_control_tightness" target="mideast_escalation::maritime_transit_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Tighter US export controls provoke Chinese countermeasures and stepped-up naval/maritime security operations (including escorting, interdictions, and shadowing) and increase proxy harassment around regional chokepoints, directly raising the likelihood of shipping incidents and transit interruptions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">mideast_escalation</data>
</edge>
<edge source="us_china_rivalry::export_control_tightness" target="mideast_escalation::oil_price_volatility" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Heightened export restrictions increase Sino‑US political and economic friction, prompting market reassessments and risk premia on Mideast supply security that translate into larger short‑term swings in oil prices.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">mideast_escalation</data>
</edge>
<edge source="us_china_rivalry::export_control_tightness" target="russia_ukraine_war::security_threat_intensit" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Tighter export controls immediately restrict shipments of advanced AI hardware, software and dual‑use components (and deter third‑party re‑exports), directly degrading Russian procurement of sensors, targeting systems and compute for autonomous systems and thereby reducing the immediacy and effectiveness of military/hybrid threats.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
