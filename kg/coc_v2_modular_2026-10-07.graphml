  <data key="d28">intra_causal</data>
  <data key="d29">2</data>
  <data key="d34">+</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_disruption" target="russia_ukraine_war::commodity_supply_gap" id="0">
  <data key="d28">intra_causal</data>
  <data key="d29">3</data>
  <data key="d34">+</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_disruption" target="ai_power_shift::model_deployment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Acute energy supply disruptions and price spikes force cloud and datacenter operators to ration capacity or postpone large-model rollouts to reduce load and costs, lowering the short-term rate at which new models are deployed into production.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">ai_power_shift</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_disruption" target="middle_east_maritime::oil_price_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Disruptions to Russian energy exports and pipeline flows push importers to seek alternative fuels and increase short-term demand for seaborne crude and LNG, tightening markets and raising global oil price benchmarks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">middle_east_maritime</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_disruption" target="middle_east_maritime::tanker_transit_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Loss or curtailment of Russian pipeline and seaborne supplies forces buyers (especially in Europe and Asia) to increase seaborne purchases from Middle Eastern producers, raising tanker transits through regional chokepoints.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">middle_east_maritime</data>
</edge>
<edge source="russia_ukraine_war::energy_supply_disruption" target="us_china_competition::corporate_relocation" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">War-driven disruptions and price spikes in global energy markets raise operating costs and supply-risk premiums for energy‑intensive manufacturers in affected markets, prompting firms to shift production and supply‑chain nodes toward lower‑cost or more energy‑secure locations.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_competition</data>
</edge>
