<edge source="middle_east_maritime::tanker_transit_rate" target="ai_power_shift::model_deployment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A sustained reduction in tanker transits disrupts maritime logistics for specialized AI hardware and fuel deliveries to data-center supply chains, causing procurement delays and rollout slowdowns for new or updated AI models.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">ai_power_shift</data>
</edge>
<edge source="middle_east_maritime::tanker_transit_rate" target="us_china_competition::regulatory_intervention" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A sustained decline in tanker transits through key chokepoints prompts US and Chinese authorities to adopt emergency regulatory measures (export controls, stockpile releases, shipping guarantees), so higher transit rates reduce the likelihood/intensity of such interventions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">us_china_competition</data>
</edge>
