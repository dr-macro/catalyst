<edge source="north_korea_escalation::defense_capacity" target="middle_east_maritime::insurance_premium_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">A noticeable rise in North Korean defense production that alters threat perceptions and forces reallocation of naval escorts raises perceived transit risk and causes insurers to increase war-risk and marine premiums for vessels operating in adjacent high-risk sea lanes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_escalation</data>
  <data key="d40">middle_east_maritime</data>
</edge>
<edge source="north_korea_escalation::defense_capacity" target="us_china_competition::foreign_investor_sent" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Noticeable increases in North Korean weapons production and strike capability raise near‑term conflict and disruption risk in Northeast Asia, depressing foreign investor willingness to add or retain exposure to regional markets closely tied to China and its supply chains.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_escalation</data>
  <data key="d40">us_china_competition</data>
</edge>
