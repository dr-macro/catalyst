<edge source="middle_east_maritime::insurance_premium_level" target="north_korea_escalation::arms_tech_proliferation" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Rising marine and war‑risk insurance premiums increase the cost and operational risk for ship operators and shadow brokers, discouraging clandestine maritime transfers of weapons and dual‑use goods destined for North Korea and reducing proliferation flows.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">north_korea_escalation</data>
</edge>
<edge source="middle_east_maritime::insurance_premium_level" target="russia_ukraine_war::allied_military_aid_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Spikes in war‑risk and transport insurance raise freight costs and shrink the pool of carriers willing to carry oversized or sensitive military cargo, causing suppliers to delay, reduce or reroute shipments and lowering the pace of allied materiel deliveries.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="middle_east_maritime::insurance_premium_level" target="us_china_competition::corporate_credit_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Higher marine and war‑risk insurance premiums raise operating costs and increase perceived credit risk for trade‑exposed firms, prompting banks and non‑bank lenders to tighten or withdraw new credit facilities to those corporates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">us_china_competition</data>
</edge>
