<edge source="russia_ukraine_war::strike_intensity" target="ai_power_shift::safety_incident_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Spikes in kinetic strike intensity create urgent battlefield needs that push militaries and contractors to hastily deploy experimental AI-enabled targeting, autonomy and logistics systems with limited testing, increasing the frequency and severity of AI-related safety and operational incidents (including spillovers to civilian-adjacent systems).</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">ai_power_shift</data>
</edge>
<edge source="russia_ukraine_war::strike_intensity" target="north_korea_escalation::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">A sharp increase in Russian strike intensity compels the US and NATO to prioritize forces and political attention toward Europe, producing short‑term resource and presence gaps that strain coordination and perceived reassurance among US allies in Northeast Asia.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">north_korea_escalation</data>
</edge>
