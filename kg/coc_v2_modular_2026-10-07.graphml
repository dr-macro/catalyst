<edge source="north_korea_escalation::alliance_cohesion" target="ai_power_shift::model_deployment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Tighter policy coordination among allied states in response to escalation increases cross-border security vetting, export screening and joint certification requirements for AI systems, slowing international deployments by firms operating across those jurisdictions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_escalation</data>
  <data key="d40">ai_power_shift</data>
</edge>
<edge source="north_korea_escalation::alliance_cohesion" target="middle_east_maritime::maritime_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Fractures or diversion of allied coordination over a Korea crisis prompt faster redeployment of U.S. and allied naval assets to East Asia and reduce routine presence/deterrence in the Middle East, creating windows in which maritime attackers increase operations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_escalation</data>
  <data key="d40">middle_east_maritime</data>
</edge>
<edge source="north_korea_escalation::alliance_cohesion" target="us_china_competition::regulatory_intervention" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.68</data>
  <data key="d37">Greater policy coordination among the US and its Northeast Asian allies in response to DPRK escalation yields synchronized export controls, investment screening and sanctions targeting technology and logistics links, increasing the frequency and severity of regulatory actions that shape US–China economic competition.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_escalation</data>
  <data key="d40">us_china_competition</data>
</edge>
