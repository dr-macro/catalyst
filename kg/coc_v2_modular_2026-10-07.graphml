<edge source="north_korea_escalation::sanctions_pressure_level" target="ai_power_shift::regulatory_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">A sharp escalation by North Korea prompts governments to broaden sanctions and export controls and to fast-track AI governance and oversight measures on national-security grounds, raising overall regulatory pressure on commercial AI activity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">north_korea_escalation</data>
  <data key="d40">ai_power_shift</data>
</edge>
<edge source="north_korea_escalation::sanctions_pressure_level" target="us_china_competition::corporate_relocation" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Heightened and broadened sanctions tied to North Korean networks raise secondary‑sanctions risk for firms and financial intermediaries operating through or with Chinese counterparties, prompting multinational firms to accelerate shifting production or supply nodes to lower‑risk jurisdictions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">north_korea_escalation</data>
  <data key="d40">us_china_competition</data>
</edge>
