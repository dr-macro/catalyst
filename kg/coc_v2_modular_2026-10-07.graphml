<edge source="russia_ukraine_war::allied_military_aid_flow" target="ai_power_shift::model_capability_growth" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Large-scale allied military aid packages include procurement, co-funded R&amp;D, datasets and fielding contracts for autonomous ISR, perception and decision-support systems that accelerate private-sector investment and transfer of advanced models and architectures into faster-capability development cycles.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">ai_power_shift</data>
</edge>
<edge source="russia_ukraine_war::allied_military_aid_flow" target="middle_east_maritime::insurance_premium_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Surges in allied military aid to Eastern Europe prompt redeployment of Western naval and security assets away from the Middle East, reducing on-station deterrence and causing insurers to raise war-risk and hull premiums for regional transits.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">middle_east_maritime</data>
</edge>
<edge source="russia_ukraine_war::allied_military_aid_flow" target="us_china_competition::geopolitical_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Sustained increases in US and allied military aid to Ukraine signal more assertive alliance behavior and operational integration, which China interprets as a demonstration of US global power projection and prompts Beijing to accelerate countermeasures, raising US–China strategic tension.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_competition</data>
</edge>
