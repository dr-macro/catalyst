<edge source="ai_power_shift::model_capability_growth" target="north_korea_escalation::arms_tech_proliferation" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.65</data>
  <data key="d37">Rapid improvements in model capabilities lower technical barriers for designing and operating dual‑use autonomous systems and cyber tools, enabling more actors and middlemen to produce or adapt advanced weapon-relevant designs that flow to DPRK proxies and illicit networks.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_power_shift</data>
  <data key="d40">north_korea_escalation</data>
</edge>
<edge source="ai_power_shift::model_capability_growth" target="north_korea_escalation::defense_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Stronger AI models accelerate simulation-driven design, supply-chain optimization and predictive maintenance in defense firms, directly raising production and sustainment throughput for allied defense industrial bases.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_power_shift</data>
  <data key="d40">north_korea_escalation</data>
</edge>
<edge source="ai_power_shift::model_capability_growth" target="russia_ukraine_war::strike_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Faster improvement in model capabilities enables better automated ISR, target recognition, fire-control and autonomy for loitering munitions and artillery correction systems, allowing combatants to execute strikes with higher tempo and precision.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_power_shift</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="ai_power_shift::model_capability_growth" target="us_china_competition::geopolitical_tension" id="0">
