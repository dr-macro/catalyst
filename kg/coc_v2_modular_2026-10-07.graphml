<edge source="middle_east_maritime::maritime_attack_rate" target="ai_power_shift::regulatory_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">A sharp rise in maritime attacks raises immediate geopolitical/security concerns among affected states and trading partners, triggering accelerated export controls, war-risk restrictions, and tighter oversight of dual-use technologies (including compute/hardware transfers and cloud services) that increase regulatory activity around commercial AI.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">ai_power_shift</data>
</edge>
<edge source="middle_east_maritime::maritime_attack_rate" target="north_korea_escalation::logistics_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A spike in maritime attacks draws allied naval escorts, ISR assets and interdiction effort into the Middle East, reducing surveillance and interdiction resources in East Asian sea lanes and thereby easing Pyongyang's ability to move fuel, munitions and materiel by sea.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">north_korea_escalation</data>
</edge>
<edge source="middle_east_maritime::maritime_attack_rate" target="north_korea_escalation::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Sustained maritime attacks in the Middle East force allied capitals to reallocate political capital and military assets and expose differences in threat tolerance and burden‑sharing, reducing synchronized policy coordination and mutual support on unrelated issues such as North Korea.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">north_korea_escalation</data>
</edge>
<edge source="middle_east_maritime::maritime_attack_rate" target="russia_ukraine_war::energy_supply_disruption" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">A sustained rise in attacks on tankers and offshore terminals forces route closures, port suspensions and cargo diversions that immediately reduce volumes of crude and refined product delivered to downstream markets, producing observable supply interruptions and volatility.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="middle_east_maritime::maritime_attack_rate" target="us_china_competition::geopolitical_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.9</data>
  <data key="d37">Rising attacks on shipping provoke immediate naval deployments, convoy operations, allied security commitments and public blame between Washington and Beijing, intensifying strategic rivalry in the Indo‑Pacific.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime</data>
  <data key="d40">us_china_competition</data>
</edge>
