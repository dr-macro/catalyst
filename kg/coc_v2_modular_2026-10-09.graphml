<edge source="iran_hormuz_escalation::maritime_attack_rate" target="france_bond_crisis::sovereign_spread_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained rise in attacks raises Europe-specific geopolitical risk and market volatility, prompting re‑pricing of euro sovereign risk and widening France's credit spread vs safer benchmarks as investors demand a premium for perceived exposure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="iran_hormuz_escalation::maritime_attack_rate" target="france_bond_crisis::cross_border_capflow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Escalating attacks trigger near‑term risk‑off behaviour among non‑resident asset managers and sovereign wealth funds, causing an outflow or reduced inflows of foreign capital into French bonds and equities as they cut euro‑area exposure.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="iran_hormuz_escalation::maritime_attack_rate" target="germany_industry_transit::diplomatic_tension" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Repeated or high‑profile attacks on merchant shipping in the Strait of Hormuz attributed to Iranian forces or proxies trigger formal protests, sanctions, and reciprocal measures, directly raising diplomatic friction between Germany and Iran/related states.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">germany_industry_transit</data>
</edge>
<edge source="iran_hormuz_escalation::maritime_attack_rate" target="russia_ukraine_war::military_force_projectio" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in hostile incidents in the Gulf compels US/UK/NATO to reassign naval and air assets to escort and protect shipping and to deter regional escalation, directly reducing the scale and tempo of deployable conventional assets available for operations and surge support in the Ukraine theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_hormuz_escalation::maritime_attack_rate" target="us_china_tech_trade::gpu_supply_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A rise in attacks around the Hormuz region raises routing risk and delays for global maritime container and component shipments, causing production and delivery bottlenecks that temporarily reduce available GPU shipment throughput to major markets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
<edge source="iran_hormuz_escalation::maritime_attack_rate" target="us_china_tech_trade::export_controls_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating hostile maritime incidents amplify national-security arguments and political pressure in Washington and allied capitals, prompting faster or stricter export-control measures on sensitive semiconductor and AI hardware flows to adversary states.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
