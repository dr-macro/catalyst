<edge source="germany_industry_transit::diplomatic_tension" target="france_bond_crisis::cross_border_capflow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating diplomatic disputes involving Germany (e.g., transit sanctions or high‑profile trade spats) raise perceived political risk in the euro area and trigger nonresident investors to reduce or withdraw allocations to French bonds and equities, producing net capital outflows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="germany_industry_transit::diplomatic_tension" target="iran_hormuz_escalation::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.67</data>
  <data key="d36">Escalating German diplomatic actions (e.g., public condemnations, expulsions, or coordinated EU moves) raise bilateral tensions and provide Iran incentive to signal or retaliate by authorizing more hostile incidents against commercial shipping in Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">iran_hormuz_escalation</data>
