  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Greater opacity about incidents and intentions increases uncertainty about tail risks, causing foreign and domestic investors to scale back participation in French sovereign primary auctions until visibility improves.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="russia_ukraine_war::information_opacity" target="iran_hormuz_escalation::insurance_freight_rates" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">High opacity around incidents and attributions in the Russia–Ukraine theater increases insurers' model uncertainty and tail‑risk premia, producing immediate upward pressure on marine insurance and freight surcharges for vessels operating in the Gulf even absent new local attacks.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_hormuz_escalation</data>
</edge>
