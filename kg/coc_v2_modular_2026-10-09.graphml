<edge source="iran_hormuz_escalation::insurance_freight_rates" target="france_bond_crisis::govt_bond_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sharp increases in Gulf insurance and freight costs transmit into higher import prices and near‑term inflation expectations, leading investors to demand higher nominal yields on French government debt to compensate for expected inflation and potential central‑bank tightening.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="iran_hormuz_escalation::insurance_freight_rates" target="germany_industry_transit::supply_chain_vuln" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising marine insurance and freight costs for Gulf‑origin shipments raise transport expenses and push shippers to reduce sailings or reroute, producing delays, concentrated sourcing, and higher exposure for German manufacturers dependent on timely oil/chemical inputs.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
  <data key="d39">germany_industry_transit</data>
</edge>
