<edge source="germany_industry_transit::supply_chain_vuln" target="france_bond_crisis::govt_bond_yield" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Acute disruptions in German transit and parts supply (ports, rail corridors, just‑in‑time inputs) reduce near‑term eurozone manufacturing output and growth expectations, prompting investors to demand higher nominal yields on French sovereign paper to compensate for worsened fiscal and macro prospects.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="germany_industry_transit::supply_chain_vuln" target="russia_ukraine_war::military_force_projectio" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Acute fragility in German industrial supply chains (spare parts, munitions components, logistics services) causes delays or shortfalls in weapons and sustainment deliveries to Ukraine, reducing Ukrainian defensive capacity and thereby enabling Russia to increase the scale or tempo of conventional operations.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">russia_ukraine_war</data>
