<edge source="germany_industry_transit::info_breach_rate" target="france_bond_crisis::bank_funding_stress" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widespread cyber breaches affecting German logistics and payments providers cause operational payment interruptions and counterparty losses that transmit liquidity shocks to French banks with direct exposures, increasing their short‑term funding costs and roll‑over stress.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="germany_industry_transit::info_breach_rate" target="iran_hormuz_escalation::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.58</data>
  <data key="d36">A spike in successful breaches of German industry or logistics providers can expose tanker itineraries, cargo manifests, or enforcement patterns, enabling Iranian-linked proxies to pick higher-probability windows/targets and thereby increase maritime attacks in the Strait of Hormuz.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">iran_hormuz_escalation</data>
</edge>
<edge source="germany_industry_transit::info_breach_rate" target="russia_ukraine_war::hybrid_attack_activity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising information‑security breaches in German industrial and logistics firms leak operational data and/or create footholds that hostile actors can exploit to conduct or facilitate cyber intrusions, sabotage, and covert disruptions tied to the Russia‑Ukraine conflict.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="germany_industry_transit::info_breach_rate" target="us_china_tech_trade::export_controls_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">High‑profile breaches at German semiconductor or AI firms that reveal design/IP transfers or Chinese actor access catalyze US policy responses to tighten export controls to prevent further technology leakage.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
