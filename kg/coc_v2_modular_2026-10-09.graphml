<edge source="iran_hormuz_escalation::tanker_fleet_available" target="germany_industry_transit::supply_chain_vuln" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">An increase in tankers willing to transit Gulf routes directly reduces shipment backlogs and delivery delays for crude and feedstocks, lowering the fragility and single‑supplier exposure of German industrial supply chains.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_escalation</data>
