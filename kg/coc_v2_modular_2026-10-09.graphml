  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rise in cross‑border hybrid attacks on energy/transport or payments infrastructure elevates growth and inflation uncertainty for France, leading investors to demand higher nominal yields on French government bonds.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="russia_ukraine_war::hybrid_attack_activity" target="germany_industry_transit::info_breach_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">An uptick in deniable cyber and sabotage operations (malware, supply‑chain intrusions, credential theft and targeted OT attacks) directly raises successful compromises of networks and vendors used by German industry, increasing observed information‑security breaches.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">germany_industry_transit</data>
</edge>
<edge source="russia_ukraine_war::hybrid_attack_activity" target="germany_industry_transit::tech_dependency_level" id="0">
