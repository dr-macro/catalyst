</edge>
<edge source="germany_industry_transit::trade_restriction_lvl" target="iran_hormuz_escalation::oil_export_throughput" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.76</data>
  <data key="d36">Tighter German-led trade restrictions and related downstream compliance pressure reduce buyers, payment channels, and insurance availability for Iranian crude, directly lowering the volume of oil successfully exported via Gulf maritime routes.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">iran_hormuz_escalation</data>
</edge>
<edge source="germany_industry_transit::trade_restriction_lvl" target="russia_ukraine_war::escalation_feedback" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Tightening German export controls and trade restrictions on dual‑use and industrial goods provokes reciprocal measures, hardens signaling and encourages tit‑for‑tat responses among Russia and Western backers, strengthening the reinforcing loops that amplify escalation.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="germany_industry_transit::trade_restriction_lvl" target="us_china_tech_trade::export_controls_intensit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A measurable tightening of Germany's export restrictions on semiconductor/dual‑use equipment creates regulatory precedent and prompts allied regulatory alignment and information‑sharing that leads the US to raise and more strictly enforce export controls affecting flows to China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">germany_industry_transit</data>
  <data key="d39">us_china_tech_trade</data>
</edge>
