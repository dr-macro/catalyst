<edge source="russia_ukraine_war::military_force_projectio" target="france_bond_crisis::cross_border_capflow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A sustained increase in large‑scale Russian military operations raises regional risk premia and triggers foreign portfolio rebalancing away from French bonds and equities into safer assets, producing net capital outflows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">france_bond_crisis</data>
</edge>
<edge source="russia_ukraine_war::military_force_projectio" target="germany_industry_transit::supply_chain_vuln" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Expanded Russian conventional operations and deployments near maritime and overland transit corridors (Black Sea, Baltic, overland routes) force rerouting, port/route restrictions and higher insurance/lead‑time exposure, directly increasing fragility in German industrial supply chains.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">germany_industry_transit</data>
</edge>
<edge source="russia_ukraine_war::military_force_projectio" target="iran_hormuz_escalation::maritime_attack_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Expanded Russian force projection leads to transfers of long‑range maritime strike systems, munitions and tactical advisers (or the diversion of Russian naval assets) to Iran and its proxies, materially enabling more frequent and higher‑intensity attacks on tankers and maritime infrastructure in the Strait of Hormuz.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_hormuz_escalation</data>
</edge>
<edge source="russia_ukraine_war::military_force_projectio" target="us_china_tech_trade::chip_prices" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Expanded conventional force deployments and kinetic operations disrupt key maritime and overland logistics corridors and increase insurance and rerouting costs, directly raising procurement and delivery costs for chips and accelerators and thereby lifting market prices.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_trade</data>
