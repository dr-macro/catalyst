  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Regulatory actions imposing audits, temporary certifications, or restrictions on AI/automated control systems used in refining prompt precautionary outages or deratings while firms implement compliance fixes, lowering utilization rates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_ai_race_and_gover</data>
  <data key="d40">global_energy_supply_sho</data>
