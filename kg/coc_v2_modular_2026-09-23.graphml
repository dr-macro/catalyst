  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Wider deployment of AI-driven freight-matching, routing and real-time logistics platforms increases cargo turnover and reduces frictions, producing a measurable rise in short-term cross-border shipments of diesel and related distillates.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_ai_race_and_gover</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="global_ai_race_and_gover::deployment_scale" target="middle_east_iran_houthis::kinetic_attack_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Wide-scale rollouts of commercially available AI perception and autonomy models make high-performance guidance and target-recognition components readily available for integration into loitering munitions and guided drones, raising the frequency and lethality of kinetic strikes by proxies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_ai_race_and_gover</data>
  <data key="d40">middle_east_iran_houthis</data>
</edge>
