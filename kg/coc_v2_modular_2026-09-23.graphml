<edge source="global_energy_supply_sho::diesel_price_level" target="global_ai_race_and_gover::commercialization_pressu" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A sharp rise in diesel prices increases electricity and logistics operating costs for cloud providers and edge operators (via higher grid generation and backup fuel costs), eroding margins and investor appetite for rapid, capital‑intensive AI rollouts and thus lowering market pressure to commercialize new models quickly.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_energy_supply_sho</data>
  <data key="d40">global_ai_race_and_gover</data>
</edge>
