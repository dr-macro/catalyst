</edge>
<edge source="russia_ukraine_war::defense_support_flow" target="global_ai_race_and_gover::safety_investment" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Rising defense-oriented funding and grants earmarked for the conflict expands budgets for robustness, red-teaming, and verification of AI systems as militaries and contractors allocate resources to ensure battlefield reliability and avoid catastrophic failures.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_ai_race_and_gover</data>
</edge>
<edge source="russia_ukraine_war::defense_support_flow" target="middle_east_iran_houthis::maritime_disruption_leve" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Surges in Western defense aid to Ukraine drive redeployment and longer forward-stationing of US/NATO naval and air assets to Europe, reducing patrols and real-time deterrence in the Red Sea/Gulf and thereby enabling more Houthi interdiction of shipping.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">middle_east_iran_houthis</data>
</edge>
<edge source="russia_ukraine_war::defense_support_flow" target="us_china_strategic_compe::strategic_trust" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained increases in Western defense aid to Ukraine signal a stronger US willingness to provide military backing to partners, which reduces Beijing's trust in US restraint and intentions toward regional contingencies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_strategic_compe</data>
</edge>
