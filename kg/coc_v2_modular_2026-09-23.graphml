<edge source="russia_ukraine_war::military_intensity" target="global_ai_race_and_gover::deployment_scale" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Escalations on the battlefield create urgent operational requirements and real-world testing opportunities that push armed forces and contractors to hurriedly field and scale AI-enabled sensors, targeting, and logistics systems.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_ai_race_and_gover</data>
</edge>
<edge source="russia_ukraine_war::military_intensity" target="global_energy_supply_sho::refinery_util_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalated kinetic activity (strikes, artillery, mines, logistics disruption) damages refinery infrastructure, forces evacuations or interrupts feedstock and transport, causing immediate drops in local refinery throughput and utilization.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_energy_supply_sho</data>
</edge>
<edge source="russia_ukraine_war::military_intensity" target="us_china_strategic_compe::supply_chain_resilience" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Spikes in kinetic activity disrupt commodity flows, shipping routes and insurance costs, prompting firms and governments to diversify suppliers, stockpile critical inputs and reconfigure logistics, thereby increasing cross‑border supply‑chain resilience over the medium term.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_strategic_compe</data>
</edge>
