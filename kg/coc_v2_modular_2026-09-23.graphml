  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Wider operational deployment of AI-enabled ISR, targeting aids and autonomous munitions increases strike tempo and target discrimination capacity on the battlefield, enabling higher-frequency and more precise kinetic operations.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_ai_race_and_gover</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
