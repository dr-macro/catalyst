<edge source="iran_gulf_flashpoint::crude_throughput_rate" target="tech_ai_superpower_rival::ai_hardware_supply" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Disruptions or slowdowns in crude transit through key chokepoints increase maritime congestion, freight rates and marine insurance costs, delaying and economically constraining shipments of heavy/urgent AI hardware and components to global customers.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_flashpoint</data>
  <data key="d39">tech_ai_superpower_rival</data>
</edge>
<edge source="iran_gulf_flashpoint::crude_throughput_rate" target="us_canada_trade_war::bilateral_trade_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Higher crude throughput through key routes eases global shipping congestion and insurance premiums, lowering transport and input costs and supporting larger US–Canada trade volumes; the reverse occurs when throughput falls.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_gulf_flashpoint</data>
  <data key="d39">us_canada_trade_war</data>
</edge>
<edge source="iran_gulf_flashpoint::crude_throughput_rate" target="us_treasury_bond_crisis::long_term_yields" id="0">
