  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A collapse in policy credibility raises political pressure on decision‑makers to show decisive action, prompting quicker introduction of visible reciprocal trade measures (tariffs/quotas) to signal responsiveness.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">us_canada_trade_war</data>
