<edge source="us_canada_trade_war::retaliation_rate" target="iran_gulf_flashpoint::sec_pressure_effect" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rising pace of reciprocal US–Canada trade measures produces political backlash and reduces Ottawa’s willingness to coordinate with Washington on enforcement and information‑sharing for extraterritorial/secondary sanctions, weakening their practical effectiveness against third parties dealing with Iran.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_canada_trade_war</data>
  <data key="d39">iran_gulf_flashpoint</data>
</edge>
