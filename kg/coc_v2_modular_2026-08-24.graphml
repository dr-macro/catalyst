<edge source="us_treasury_bond_crisis::policy_credibility" target="iran_gulf_flashpoint::sec_pressure_effect" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained loss of US policy credibility after a Treasury crisis reduces foreign banks' and states' belief in consistent enforcement and political follow‑through, lowering their perceived legal/political risk and weakening the deterrent effect of US secondary measures on commerce with Iran.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">iran_gulf_flashpoint</data>
</edge>
<edge source="us_treasury_bond_crisis::policy_credibility" target="tech_ai_superpower_rival::ai_capital_inflows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A rapid decline in policy credibility raises macro and regulatory uncertainty, increasing required returns and drying up high-risk long-duration funding, causing venture and corporate AI investment to contract sharply.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">tech_ai_superpower_rival</data>
</edge>
<edge source="us_treasury_bond_crisis::policy_credibility" target="us_canada_trade_war::retaliation_rate" id="0">
