<edge source="us_treasury_bond_crisis::market_intervention_flow" target="russia_ukraine_war::resupply_rate_defense" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Increased net purchases of long-maturity Treasuries inject cash into U.S. money markets and ease dollar funding and trade-finance lines, directly enabling faster payments, letters-of-credit and deliveries of defensive systems to Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_treasury_bond_crisis::market_intervention_flow" target="tech_ai_superpower_rival::ai_capital_inflows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Net purchases of long-maturity bonds (increased intervention flow) inject reserves and lower risk premia, directly easing financing conditions and prompting banks, VCs, and corporates to deploy more capital into AI projects and funds.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">tech_ai_superpower_rival</data>
