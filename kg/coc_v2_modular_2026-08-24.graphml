<edge source="us_treasury_bond_crisis::long_term_yields" target="russia_ukraine_war::resupply_rate_defense" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained rises in long-term yields increase borrowing and hedging costs for European purchasers and defense contractors and raise the cash-flow burden on procurement, leading buyers and suppliers to delay or scale back deliveries of defensive systems.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_treasury_bond_crisis::long_term_yields" target="tech_ai_superpower_rival::market_concentration" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Sustained increases in long-term yields raise the cost of capital and favor large, cash-rich incumbents over smaller, capital-intensive challengers, accelerating M&amp;A and capacity consolidation in AI hardware and cloud services.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">tech_ai_superpower_rival</data>
</edge>
<edge source="us_treasury_bond_crisis::long_term_yields" target="us_canada_trade_war::supply_chain_integ" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained higher long‑term yields increase the cost of financing capital expenditures and inventory for multinational production, leading firms to postpone or scale back cross‑border integration projects and reduce interdependence.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">us_canada_trade_war</data>
</edge>
<edge source="us_treasury_bond_crisis::long_term_yields" target="us_canada_trade_war::retaliation_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising long‑term borrowing costs increase economic strain on exposed domestic industries, which intensify lobbying for protection and induce authorities to introduce reciprocal trade measures at a faster pace.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_treasury_bond_crisis</data>
  <data key="d39">us_canada_trade_war</data>
</edge>
