<edge source="russia_ukraine_war_diplo::great_power_pressure" target="mid_east_gulf_escalation::nonstate_attack_activity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Heightened great‑power competition leads Russia to expand covert materiel, training, and intelligence support to Iran‑aligned militias and proxy groups, enabling more frequent and capable attacks on shipping and terminals.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war_diplo</data>
  <data key="d39">mid_east_gulf_escalation</data>
</edge>
<edge source="russia_ukraine_war_diplo::great_power_pressure" target="turkey_regional_realignm::regional_alignment_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Intensified strategic competition among major powers forces Ankara to accelerate hedging and partnership shifts (e.g., deeper outreach to Russia, China or NATO partners) to preserve strategic autonomy and leverage, increasing the rate of regional alignment changes.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war_diplo</data>
  <data key="d39">turkey_regional_realignm</data>
</edge>
