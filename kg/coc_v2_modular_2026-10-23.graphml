<edge source="mid_east_gulf_escalation::nonstate_attack_activity" target="eurozone_bond_stress::sovereign_spread" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising attacks on shipping and terminals increase trade disruption and insurance costs for export‑dependent eurozone countries, prompting investors to demand wider yield spreads on sovereigns with large external financing needs.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_gulf_escalation</data>
  <data key="d39">eurozone_bond_stress</data>
</edge>
<edge source="mid_east_gulf_escalation::nonstate_attack_activity" target="russia_ukraine_war_diplo::private_comm_control" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A spike in attacks on shipping and terminals prompts private operators (insurers, satellite and comms firms, shipping companies) to centralize, restrict, or harden access to their communications and tracking services to mitigate risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_gulf_escalation</data>
  <data key="d39">russia_ukraine_war_diplo</data>
</edge>
<edge source="mid_east_gulf_escalation::nonstate_attack_activity" target="turkey_regional_realignm::maritime_control_cap" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Rising attacks on shipping and infrastructure by non‑state actors directly compels Turkey to expand maritime patrols, ISR deployments and interdiction operations, thereby increasing its effective maritime control capacity in the short term.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_gulf_escalation</data>
  <data key="d39">turkey_regional_realignm</data>
</edge>
<edge source="mid_east_gulf_escalation::nonstate_attack_activity" target="us_china_tech_rivalry::chip_rare_earth_supply" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.62</data>
  <data key="d36">Increased attacks on shipping and terminals in Gulf and adjacent sea lanes disrupt maritime logistics, force route diversions and raise insurance costs, producing immediate shipment delays and shortages of semiconductors and critical raw-material consignments bound for AI hardware manufacturing.</data>
  <data key="d37">0-6 months</data>
