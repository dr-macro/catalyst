<edge source="eurozone_bond_stress::sovereign_bond_yields" target="mid_east_gulf_escalation::diplomatic_deescalation" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained rises in eurozone sovereign yields raise borrowing costs and near‑term fiscal strain, prompting governments to curtail costly overseas diplomatic initiatives and crisis mediation capacity, reducing coordinated de‑escalation efforts.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">eurozone_bond_stress</data>
  <data key="d39">mid_east_gulf_escalation</data>
</edge>
<edge source="eurozone_bond_stress::sovereign_bond_yields" target="russia_ukraine_war_diplo::great_power_pressure" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A sharp rise in eurozone sovereign yields forces governments to reallocate political capital and military/diplomatic resources to domestic economic stabilization, weakening coordinated EU deterrence and opening space for increased great‑power maneuvering around the Russia–Ukraine front.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">eurozone_bond_stress</data>
  <data key="d39">russia_ukraine_war_diplo</data>
</edge>
