<edge source="russia_ukraine_war::infrastructure_damage" target="global_bond_market_shock::credit_spread_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Destruction of ports, transport and energy infrastructure disrupts exporters' revenues and supply chains, worsening corporate cash flows and sovereign fiscal positions in exposed countries and causing investors to demand wider credit spreads to compensate for higher default and liquidity risk.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_bond_market_shock</data>
</edge>
<edge source="russia_ukraine_war::infrastructure_damage" target="us_china_tech_trade_riva::accel_supply_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Physical damage to Ukrainian industrial facilities and power/transport infrastructure reduces production and export of critical inputs (notably neon gas and stable power for fabs), immediately lowering semiconductor fab throughput that produces AI accelerators.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">us_china_tech_trade_riva</data>
</edge>
