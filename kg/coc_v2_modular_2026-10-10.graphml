<edge source="middle_east_maritime_con::crude_price_level" target="global_bond_market_shock::nominal_yield_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A sustained rise in crude prices directly lifts consumer and producer inflation expectations and forces central banks to signal or implement tighter policy, which raises nominal sovereign yields across maturities.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime_con</data>
  <data key="d40">global_bond_market_shock</data>
</edge>
<edge source="middle_east_maritime_con::crude_price_level" target="russia_ukraine_war::sanctions_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained increases in global crude prices raise domestic energy bills and inflation in sanctioning states, generating political pressure to delay, soften, or carve out exemptions from new Russia-directed sanctions to avoid further consumer pain.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">middle_east_maritime_con</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
