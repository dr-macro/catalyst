<edge source="global_bond_market_shock::debt_service_burden" target="middle_east_maritime_con::perceived_shipping_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Higher sovereign debt-service burdens force governments to cut or delay spending on naval patrols, port security and security subsidies, raising operator perceptions of vulnerability to attacks, seizures and unprotected transits.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_market_shock</data>
  <data key="d40">middle_east_maritime_con</data>
</edge>
<edge source="global_bond_market_shock::debt_service_burden" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Rising sovereign debt service in major donor states forces fiscal reallocation and domestic political pressure to cut or slow foreign military and economic support, reducing coordinated burden‑sharing and alignment among allies.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_bond_market_shock</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
