  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Widening credit spreads raise the cost and reduce availability of trade finance and short‑term commercial funding used by energy traders and shippers, causing curtailed shipments and inventory drawdowns that widen fuel and gas shortfalls in affected markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_market_shock</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="global_bond_market_shock::credit_spread_level" target="us_china_tech_trade_riva::accel_demand_intensity" id="0">
