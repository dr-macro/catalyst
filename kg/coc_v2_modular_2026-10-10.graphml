<edge source="global_bond_market_shock::credit_spread_level" target="middle_east_maritime_con::corporate_operational_re" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Widening credit spreads raise borrowing and working-capital costs for shipping, charterers and energy firms, prompting expedited operational responses such as route avoidance, sailings suspensions and capacity reallocation to reduce cash burn.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_market_shock</data>
  <data key="d40">middle_east_maritime_con</data>
