        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stress" target="alliance_security_realig::diplomatic_tension_level" id="219">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Acute energy shortages and price spikes prompt importing states to lodge formal protests, impose countermeasures or seek emergency supply deals, increasing bilateral and multilateral diplomatic frictions tied to the conflict." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="alliance_security_realig" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stress" target="global_bond_credit_stres::policy_rate_expectations" id="220">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="War-related energy shortfalls and price spikes push up near-term CPI and headline inflation expectations, prompting markets to price in faster and larger central-bank tightening." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_credit_stres" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stress" target="global_bond_credit_stres::long_term_yields" id="221">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Sustained increases in energy prices raise inflation expectations and term premia on long-dated debt, directly lifting long‑term nominal government yields." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_credit_stres" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stress" target="iran_us_standoff::oil_price" id="222">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Disruptions to Russian hydrocarbon flows and related re-routing/risk premia from the Russia–Ukraine war tighten global supply and increase price risk, directly pushing up global crude prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_us_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::energy_supply_stress" target="us_china_rivalry::agentic_deployment_rate" id="223">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Acute energy shortages and higher electricity prices raise datacenter and cloud costs, leading firms to delay or scale back rollouts of energy‑intensive autonomous agent services and thus reducing deployment rate." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
