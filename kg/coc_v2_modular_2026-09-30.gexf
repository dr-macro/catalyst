      <edge source="global_bond_credit_stres::long_term_yields" target="iran_us_standoff::refined_fuel_stocks" id="491">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher long‑term yields increase the opportunity and financing costs of holding inventories for both commercial and strategic actors, prompting drawdowns or reduced purchases that lower refined fuel stock levels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_credit_stres" />
          <attvalue for="39" value="iran_us_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
