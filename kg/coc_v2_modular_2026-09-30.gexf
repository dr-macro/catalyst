      <edge source="iran_us_standoff::maritime_disruption" target="alliance_security_realig::armed_conflict_intensity" id="39">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Sustained disruption of shipping (attacks, mines, seizures) provokes immediate naval escorts, interdiction operations, and counterstrikes by the US and partner navies as well as kinetic retaliation by Iran or proxies, raising the tempo and geographic spread of military engagements." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_standoff" />
          <attvalue for="39" value="alliance_security_realig" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_standoff::maritime_disruption" target="alliance_security_realig::diplomatic_tension_level" id="40">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Repeated incidents affecting third‑party commercial vessels trigger formal protests, emergency consultations, sanctions threats, and coalition-building among affected states, increasing bilateral and multilateral diplomatic friction." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_standoff" />
          <attvalue for="39" value="alliance_security_realig" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_standoff::maritime_disruption" target="global_bond_credit_stres::fixed_income_liquidity" id="41">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Acute shipping-route insecurity raises trade-finance and counterparty risk and forces dealers to hoard balance sheet and widen bid-ask spreads, directly reducing market depth and liquidity in fixed-income markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_standoff" />
          <attvalue for="39" value="global_bond_credit_stres" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_standoff::maritime_disruption" target="russia_ukraine_war::supply_chain_disruption" id="42">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Worsening maritime disruption in the Persian Gulf/Red Sea raises freight rates, insurance premiums and forces rerouting and longer voyages that absorb global shipping capacity and cause delays and bottlenecks for sea‑borne deliveries (including weapons, spare parts and fuel) destined for Ukraine, increasing supply‑chain disruption supporting the war effort." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_standoff" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_standoff::maritime_disruption" target="us_china_rivalry::capital_flow_ai" id="43">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Repeated shipping disruptions tied to the Iran–US standoff raise perceived supply-chain and naval risk, prompting investors and defense buyers to channel additional capital into autonomous maritime systems, logistics AI and surveillance startups tied to US–China competition." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_standoff" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_us_standoff::maritime_disruption" target="us_china_rivalry::cyber_exploit_rate" id="44">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened maritime insecurity drives rapid deployment of networked navigation, sensing and command AI for ships and coastal systems, creating high-value targets that elicit increased state and criminal cyber operations against AI assets in the US–China rivalry." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="iran_us_standoff" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
