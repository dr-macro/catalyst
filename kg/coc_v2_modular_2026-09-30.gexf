      <edge source="global_bond_credit_stres::long_term_yields" target="alliance_security_realig::armed_conflict_intensity" id="490">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained rise in long-term yields raises sovereign borrowing costs and forces fiscally constrained governments to delay/curtail defense procurement and contractor payments, reducing operational tempo and lowering near-term kinetic intensity." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_credit_stres" />
          <attvalue for="39" value="alliance_security_realig" />
          <attvalue for="28" value="0" />
        </attvalues>
