      <edge source="russia_ukraine_war::allied_military_support" target="alliance_security_realig::armed_conflict_intensity" id="202">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rapid increase in delivered weapons, ammunition, surveillance and targeting support enables recipient forces to conduct higher-tempo offensives and sustain engagements, directly raising the scale and frequency of kinetic operations." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="alliance_security_realig" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_military_support" target="alliance_security_realig::cross_border_refugee_flo" id="203">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Provision of offensive-capable systems (e.g., long‑range fires, air support) intensifies localized bombardment and territorial shifts that displace civilians and prompt cross-border flight independent of aggregate battle-space metrics." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="alliance_security_realig" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_military_support" target="global_bond_credit_stres::cross_border_flows" id="204">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalation signalled by greater allied military support intensifies sanctions risk and geopolitical uncertainty, triggering rapid reallocation of private and institutional capital into safe‑haven jurisdictions and sovereign assets, increasing measured cross‑border flows into those markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_credit_stres" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_military_support" target="iran_us_standoff::maritime_disruption" id="205">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A surge in allied military support to Ukraine reallocates Western naval and air assets toward Europe (or increases forward operations that draw on the same assets), reducing deterrent presence in the Persian Gulf and enabling greater Iranian harassment/attacks on commercial shipping, raising maritime disruption." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="iran_us_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::allied_military_support" target="us_china_rivalry::capital_flow_ai" id="206">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Larger allied military assistance expands defense procurement and government R&amp;D contracts for AI-enabled systems, which in turn channels increased public and private investment into AI firms and startups." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
