      <edge source="alliance_security_realig::armed_conflict_intensity" target="global_bond_credit_stres::risk_appetite" id="664">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A rapid escalation of kinetic operations raises uncertainty and tail-risk perceptions, prompting institutional and retail investors to de-risk portfolios and increase allocations to safe assets, thereby lowering aggregate risk appetite." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="alliance_security_realig" />
          <attvalue for="39" value="global_bond_credit_stres" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_security_realig::armed_conflict_intensity" target="global_bond_credit_stres::fixed_income_liquidity" id="665">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Heightened conflict drives order imbalances and volatility in regionally exposed sovereign and corporate bonds while dealer balance-sheet constraints and repo funding stress reduce market depth and widen bid-ask spreads." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="alliance_security_realig" />
          <attvalue for="39" value="global_bond_credit_stres" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_security_realig::armed_conflict_intensity" target="iran_us_standoff::maritime_disruption" id="666">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Intensified kinetic operations (naval strikes, air attacks, missile barrages) in or near the Gulf/Red Sea directly threaten commercial shipping and prompt route suspensions or convoying that immediately increases maritime transit disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="alliance_security_realig" />
          <attvalue for="39" value="iran_us_standoff" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_security_realig::armed_conflict_intensity" target="russia_ukraine_war::allied_military_support" id="667">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="A sharp rise in frontline fighting and materiel losses creates immediate operational needs and political pressure that prompt allies to accelerate and expand weapons, ammunition, and logistics deliveries to sustain the defending force." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="alliance_security_realig" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_security_realig::armed_conflict_intensity" target="russia_ukraine_war::energy_supply_stress" id="668">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Increased kinetic operations and strikes against export nodes (ports, pipelines, Black Sea shipping) physically reduce flows and force rerouting, producing near-term supply shortfalls and price spikes for regional energy markets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="alliance_security_realig" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="alliance_security_realig::armed_conflict_intensity" target="us_china_rivalry::cyber_exploit_rate" id="669">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in kinetic conflict raises incentives and operational cover for state and proxy actors to launch cyber operations against adversary AI infrastructure (model endpoints, data pipelines, control systems) to degrade battlefield automation, increasing cyber exploit frequency and severity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="alliance_security_realig" />
          <attvalue for="39" value="us_china_rivalry" />
          <attvalue for="28" value="0" />
