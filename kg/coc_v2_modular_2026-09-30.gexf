          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Rising long‑term sovereign yields increase governments' debt‑service and borrowing costs, constraining discretionary budgets and leading to slower, smaller or delayed external military assistance and procurement for partners supporting Ukraine." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_credit_stres" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
