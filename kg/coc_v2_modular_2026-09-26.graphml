<edge source="global_bond_shock::bond_market_liquidity" target="energy_market_stress::diesel_inventory_levels" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A liquidity squeeze in bond markets reduces availability of repo and short-term financing lines that traders and storage owners use to carry product stocks, forcing rapid drawdowns or reduced accumulation of diesel inventories.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_shock</data>
  <data key="d40">energy_market_stress</data>
</edge>
<edge source="global_bond_shock::bond_market_liquidity" target="iran_regional_conflict::proxy_attack_frequency" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A global drop in bond market liquidity raises transaction costs and frictions for cross‑border payments and sovereign issuance, constraining the operational funding pipelines that sustain proxy operations and reducing attack frequency.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_shock</data>
  <data key="d40">iran_regional_conflict</data>
</edge>
<edge source="global_bond_shock::bond_market_liquidity" target="us_china_rivalry::capital_invest_flows" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Deteriorating sovereign bond market liquidity increases transaction costs and tail‑risk concerns for global investors, causing them to curtail cross-border equity and debt investments and slow M&amp;A activity between the US and China.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_shock</data>
  <data key="d40">us_china_rivalry</data>
</edge>
