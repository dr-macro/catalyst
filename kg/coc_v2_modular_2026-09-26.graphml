<edge source="us_china_rivalry::trade_barrier_intensity" target="energy_market_stress::diesel_export_volume" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">New or intensified tariffs, quotas and sanctions directly restrict or make uneconomic cross‑border diesel shipments between affected markets, reducing physical export volumes.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">us_china_rivalry</data>
