<edge source="energy_market_stress::policy_export_restrictio" target="global_bond_shock::corporate_funding_cost" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Tighter diesel export restrictions worsen cash flows and counterparty risk for trading, logistics and downstream firms and raise perceived default risk and risk premia, increasing corporate borrowing costs.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_market_stress</data>
  <data key="d40">global_bond_shock</data>
</edge>
<edge source="energy_market_stress::policy_export_restrictio" target="us_china_rivalry::bilat_political_tension" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A rapid increase in diesel export restrictions (especially by exporters linked to Beijing or affecting US allies) is read as intentional energy leverage or coercion, prompting the US to escalate diplomatic protests, sanctions threats and public confrontations with China, raising bilateral political tension.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_market_stress</data>
  <data key="d40">us_china_rivalry</data>
</edge>
