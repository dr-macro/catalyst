  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">An increase in refinery run rates raises immediate refined‑product output available for domestic consumption and export, directly lowering the incidence of supply interruptions along distribution chains.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_market_stress</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="energy_market_stress::refiner_run_rates" target="us_china_rivalry::capital_invest_flows" id="0">
