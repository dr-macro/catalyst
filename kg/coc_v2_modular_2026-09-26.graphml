  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Spikes in kinetic activity drive flight-to-safety and tail-risk hedging while reducing dealer willingness to warehouse sovereign paper, widening bid-ask spreads and degrading bond-market liquidity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_bond_shock</data>
</edge>
<edge source="russia_ukraine_war::kinetic_operation_int" target="iran_regional_conflict::proxy_attack_frequency" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">High kinetic intensity in Ukraine diverts diplomatic, intelligence and military attention and ties up partner capacities, reducing external constraints and oversight on Iran and its proxies and thereby enabling a higher tempo of proxy attacks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_regional_conflict</data>
</edge>
