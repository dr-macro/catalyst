  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">An increase in cross‑border diesel export volumes delivers physical shipments into deficit markets (including Ukraine/adjacent hubs) and immediately reduces the frequency and scale of missed deliveries and localized outages.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_market_stress</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
