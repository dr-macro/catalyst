<edge source="energy_market_stress::diesel_price_level" target="global_bond_shock::long_term_nominal_yields" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">A sustained rise in diesel prices feeds directly into headline and near-term inflation expectations and term premia, prompting markets to demand higher compensation on long-dated sovereign bonds.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_market_stress</data>
  <data key="d40">global_bond_shock</data>
</edge>
<edge source="energy_market_stress::diesel_price_level" target="iran_regional_conflict::proxy_attack_frequency" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">A sustained rise in diesel prices raises per-unit revenue from legal and illicit diesel sales and smuggling, directly increasing funds available to Iran-aligned proxy groups and enabling higher operational tempo of attacks.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_market_stress</data>
  <data key="d40">iran_regional_conflict</data>
</edge>
<edge source="energy_market_stress::diesel_price_level" target="russia_ukraine_war::kinetic_operation_int" id="0">
