<edge source="iran_regional_conflict::diplomatic_engagement" target="russia_ukraine_war::escalation_feedback" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Higher sustained diplomatic engagement over the Iran crisis preserves Western crisis-management bandwidth and backchannels, reducing the propensity for reciprocal, amplifying escalation cycles in the Russia–Ukraine theatre; conversely, a drop in engagement raises escalation feedback.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_regional_conflict</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
