<edge source="global_bond_shock::corporate_funding_cost" target="energy_market_stress::refiner_run_rates" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Rising corporate borrowing costs raise refiners' working-capital and crude-financing expenses and worsen access to short-term trade credit, prompting refiners to cut throughput to conserve liquidity and avoid margin losses.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_bond_shock</data>
  <data key="d40">energy_market_stress</data>
</edge>
