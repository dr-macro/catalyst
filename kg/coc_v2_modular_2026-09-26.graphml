  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising diesel spot prices raise fuel procurement and operating costs for mechanized units and logistics networks, constraining sortie rates and lowering the tempo of offensive operations where budgets and supply chains are tight.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_market_stress</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="energy_market_stress::diesel_price_level" target="us_china_rivalry::trade_barrier_intensity" id="0">
