  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Physical curtailment of oil/gas flows reduces local power availability or forces utilities to defer new hookups, directly causing AI infrastructure projects to be postponed or slowed while operators secure reliable power.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">ai_infra_market_shift</data>
</edge>
<edge source="iran_gulf_escalation::energy_supply_disruption" target="cyber_critical_attacks::cyber_attack_incidence" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Physical disruptions to oil and gas flows force operators into emergency configurations, increased remote access and degraded patching/segmentation while simultaneously raising the economic and strategic value of energy targets, provoking opportunistic criminals and state-linked groups to mount more cyber intrusions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">cyber_critical_attacks</data>
</edge>
<edge source="iran_gulf_escalation::energy_supply_disruption" target="russia_ukraine_war::allied_political_cohesio" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Physical disruptions to Gulf oil and gas flows force European and other allies into emergency bilateral energy negotiations and divergent procurement choices, producing disputes over sanctions, price‑cap implementation and burden‑sharing that weaken coordinated political stances toward Russia.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_escalation::energy_supply_disruption" target="russia_ukraine_war::kinetic_conflict_intensi" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Disruptions to Gulf hydrocarbon flows push up energy revenues and create fiscal/political space for energy exporters while simultaneously raising political costs for sustained Western military support, enabling or incentivizing higher Russian operational tempo in Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_escalation::energy_supply_disruption" target="sino_us_geoecon_rivalry::security_econ_policy" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Physical interruptions to Gulf oil and gas flows lead both Washington and Beijing to explicitly reframe economic measures (subsidies, stockpiling, trade measures) as national‑security imperatives aimed at energy and supply resilience.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">sino_us_geoecon_rivalry</data>
