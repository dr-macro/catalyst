<edge source="sino_us_geoecon_rivalry::export_control_stringenc" target="ai_infra_market_shift::compute_capacity_stock" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Tighter export controls on accelerators, high-end chips and related components directly prevent cross‑border shipments and installations of AI hardware, producing immediate shortfalls in operational compute capacity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">sino_us_geoecon_rivalry</data>
  <data key="d40">ai_infra_market_shift</data>
</edge>
<edge source="sino_us_geoecon_rivalry::export_control_stringenc" target="cyber_critical_attacks::cyber_attack_incidence" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Tighter export controls block legal transfer of advanced components and knowledge, incentivizing state and criminal actors to conduct cyber intrusions against research labs, suppliers, and supply‑chain partners to acquire embargoed technology.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">sino_us_geoecon_rivalry</data>
  <data key="d40">cyber_critical_attacks</data>
</edge>
<edge source="sino_us_geoecon_rivalry::export_control_stringenc" target="iran_gulf_escalation::maritime_incident_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Sharper export controls on advanced components push Beijing toward deeper security cooperation and material/dual‑use transfers to Iran (or faster arms‑supply workarounds), materially increasing Iranian/Proxy capability and willingness to mount drone/mine/attacker operations against shipping.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">sino_us_geoecon_rivalry</data>
  <data key="d40">iran_gulf_escalation</data>
</edge>
<edge source="sino_us_geoecon_rivalry::export_control_stringenc" target="russia_ukraine_war::allied_political_cohesio" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Stricter US-led export controls on technologies bound for China create economic and industrial friction with trade-dependent allies (especially in Europe and East Asia), producing policy disagreements and delays in coordinated sanctions and aid decisions related to Ukraine that reduce allied political cohesion.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">sino_us_geoecon_rivalry</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
