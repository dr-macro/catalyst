<edge source="russia_ukraine_war::external_security_compet" target="ai_infra_market_shift::ai_capital_inflow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Escalating great‑power security competition leads governments to increase defence and strategic AI budgets and prompts private investors to back dual‑use AI firms, raising net capital flows into AI.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">ai_infra_market_shift</data>
</edge>
<edge source="russia_ukraine_war::external_security_compet" target="ai_infra_market_shift::project_delay_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Heightened strategic rivalry triggers export restrictions, component embargoes (GPUs, networking), and tighter investment reviews that interrupt supply chains and approvals, increasing delays for AI infrastructure projects.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">ai_infra_market_shift</data>
</edge>
<edge source="russia_ukraine_war::external_security_compet" target="iran_gulf_escalation::maritime_incident_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Escalating great‑power security competition linked to the Ukraine war increases permissive conditions and proxy activity at sea, producing more interdictions, harassments and testing of maritime boundaries in the Gulf region.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_gulf_escalation</data>
</edge>
<edge source="russia_ukraine_war::external_security_compet" target="sino_us_geoecon_rivalry::domestic_tech_capacity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">Amplified great‑power security competition linked to the Russia war accelerates political support and budgetary commitments (grants, procurement guarantees, regulatory preferences) to scale domestic semiconductor and AI hardware production, directly expanding indigenous advanced‑tech capacity to reduce reliance on China.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">sino_us_geoecon_rivalry</data>
</edge>
