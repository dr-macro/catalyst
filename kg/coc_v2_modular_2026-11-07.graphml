<edge source="ai_infra_market_shift::data_center_build_rate" target="cyber_critical_attacks::cross_boundary_connect" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">New or expanded data centers increase colocations, peering, and cloud interconnect agreements and attract enterprise migrations, concretely increasing the density and permeability of technical and organizational links that move data and code across previously separated domains.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">ai_infra_market_shift</data>
