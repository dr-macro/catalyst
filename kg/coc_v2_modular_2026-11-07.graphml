<edge source="iran_gulf_escalation::maritime_incident_rate" target="ai_infra_market_shift::data_center_build_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A rise in hostile incidents in Gulf shipping lanes increases delays, rerouting and insurance costs for sea‑freighted AI hardware (GPUs, racks, power gear), prompting firms to postpone or cancel data‑center construction starts.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">ai_infra_market_shift</data>
</edge>
<edge source="iran_gulf_escalation::maritime_incident_rate" target="cyber_critical_attacks::cross_boundary_connect" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Surging attacks and interdictions on shipping prompt carriers and ports to rapidly reroute, onboard alternate third‑party logistics providers and adopt new tracking/coordination platforms, increasing the density and permeability of technical and organizational links across domains.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">cyber_critical_attacks</data>
</edge>
<edge source="iran_gulf_escalation::maritime_incident_rate" target="russia_ukraine_war::external_security_compet" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A rise in hostile maritime incidents in the Gulf compels the US, UK and regional partners to reposition naval forces and escalate maritime signalling, which sharpens great‑power security competition dynamics and increases strategic pressure and contestation that spill into the Ukraine theatre.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_gulf_escalation::maritime_incident_rate" target="sino_us_geoecon_rivalry::export_control_stringenc" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A spike in Gulf maritime incidents prompts US policy makers to tighten export controls and broaden end‑use/end‑user restrictions (and press allies to align) to prevent technologies transiting insecure sea lanes from being diverted to Chinese military or dual‑use programs.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_gulf_escalation</data>
  <data key="d40">sino_us_geoecon_rivalry</data>
</edge>
