<edge source="ai_infra_market_shift::regulatory_scrutiny" target="iran_gulf_escalation::diplomatic_activity_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A rapid increase in regulatory scrutiny in Western jurisdictions triggers immediate export‑control filings, license denials and coordination requests that force Gulf states and partners into intensified shuttle diplomacy to negotiate exemptions and manage supply/security fallout.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">ai_infra_market_shift</data>
  <data key="d40">iran_gulf_escalation</data>
</edge>
<edge source="ai_infra_market_shift::regulatory_scrutiny" target="russia_ukraine_war::allied_political_cohesio" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.75</data>
  <data key="d37">Divergent or intensifying regulatory scrutiny (export controls, data/privacy rules) among supporting states generates disputes over permitted AI transfers and intelligence sharing, producing public and private frictions that reduce policy alignment among allies.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">ai_infra_market_shift</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="ai_infra_market_shift::regulatory_scrutiny" target="sino_us_geoecon_rivalry::export_control_stringenc" id="0">
