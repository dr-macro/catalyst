<edge source="russia_ukraine_war::compliance_risk" target="cyber_critical_attacks::insider_compromise_risk" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Rising perceived risk that deals or ceasefires will be violated incentivizes preemptive human‑intelligence and recruitment efforts by adversaries and proxies, increasing the likelihood that insiders will be co‑opted or compromised.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">cyber_critical_attacks</data>
</edge>
<edge source="russia_ukraine_war::compliance_risk" target="sino_us_geoecon_rivalry::security_econ_policy" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Rising perceptions that negotiated commitments can be flouted (from Russian violations) lead policymakers to explicitly reframe economic instruments as national‑security tools (e.g., tighter investment screening, industrial subsidies justified on security grounds) targeted at strategic competitors including China.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">sino_us_geoecon_rivalry</data>
</edge>
