      <edge source="iran_gulf_standoff::maritime_attack_rate" target="china_geostrategic_push::ai_capability" id="34">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained rise in attacks on commercial shipping prompts Chinese state and corporate actors to accelerate procurement and development of AI systems for maritime domain awareness, autonomous vessels and logistics optimization to protect trade routes and reduce exposure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="china_geostrategic_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_standoff::maritime_attack_rate" target="european_institutional_f::sovereign_bond_spreads" id="35">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A spike in attacks on commercial vessels produces immediate insurance and commodity‑price shocks and prompts short‑term investor flight from riskier euro‑area debt, widening sovereign spreads especially for fiscally fragile states." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_standoff::maritime_attack_rate" target="global_oil_market_shock::product_price_level" id="36">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Increased attacks on tankers produce immediate cargo delays, higher insurance and freight costs and a trader risk-premium that is passed into spot and futures refined-fuel prices, pushing up regional product price levels." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="global_oil_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_standoff::maritime_attack_rate" target="global_oil_market_shock::diesel_supply_gap" id="37">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="More frequent/intense attacks cause cancellations and rerouting of diesel cargoes and off-spec deliveries, reducing delivered volumes to consuming markets and widening diesel shortfalls (a more negative supply gap)." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="global_oil_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_standoff::maritime_attack_rate" target="russia_ukraine_war::sanctions_pressure" id="38">
