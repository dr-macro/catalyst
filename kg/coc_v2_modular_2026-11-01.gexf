      <edge source="china_geostrategic_push::geopolitical_tension" target="european_institutional_f::policy_uncertainty" id="487">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising China‑driven geopolitical tensions force EU institutions into rapid debates over trade restrictions, investment screening and industrial subsidies, increasing unpredictability about near‑term regulatory and fiscal choices faced by firms and markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_geostrategic_push" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_geostrategic_push::geopolitical_tension" target="european_institutional_f::banking_sector_solvency" id="488">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating geopolitical friction leads to sanctions, frozen counterparties and sudden re‑pricing of China‑exposed corporate credits, producing higher loan losses and capital strain for European banks with direct China/Asia exposures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_geostrategic_push" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_geostrategic_push::geopolitical_tension" target="global_oil_market_shock::geo_conflict_intensity" id="489">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rise in geopolitical tension tied to China's geostrategic moves increases the probability of kinetic incidents, naval interdictions and targeted sanctions that immediately raise the frequency and intensity of events disrupting energy-related infrastructure and shipping lanes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_geostrategic_push" />
          <attvalue for="38" value="global_oil_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_geostrategic_push::geopolitical_tension" target="iran_gulf_standoff::military_posture" id="490">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A sharp uptick in China's geostrategic pressure prompts the US and regional partners to surge naval assets and exercises in the Gulf, which in turn provokes reciprocal Iranian force deployments and readiness increases." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="china_geostrategic_push" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="china_geostrategic_push::geopolitical_tension" target="russia_ukraine_war::alliance_cohesion" id="491">
        <attvalues>
