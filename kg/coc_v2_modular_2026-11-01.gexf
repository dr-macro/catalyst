          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A drop in commercial shipping throughput raises delivery times and hardware costs for AI projects, leading private investors and firms—particularly those dependent on imported chips and servers—to delay or scale back capital deployment into AI R&amp;D and capex." />
          <attvalue for="36" value="0-6 months" />
