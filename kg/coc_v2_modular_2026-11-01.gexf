      <edge source="russia_ukraine_war::sanctions_pressure" target="china_geostrategic_push::export_control_restrict" id="319">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Expanded and more aggressive sanctions regimes and vetting practices developed against Russia are institutionalized and extended into formal export‑control lists and licensing practices that are then applied to high‑end dual‑use technologies relevant to China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_geostrategic_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="china_geostrategic_push::ai_capability" id="320">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Broader sanctions pressure and the resulting risk‑aversion by suppliers and payment processors limit Chinese firms' access to the newest chips, software tools and cloud services, directly slowing near‑term model training capacity and deployment." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_geostrategic_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="european_institutional_f::banking_sector_solvency" id="321">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Expanded financial sanctions and correspondent‑bank de‑risking sever access to euro‑clearing and force write‑downs on European banks' Russian assets while producing energy‑sector loan losses and liquidity strains that directly erode bank capital ratios." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="european_institutional_f::sovereign_bond_spreads" id="322">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sanctions‑driven trade and energy disruptions raise fiscal costs for energy‑importing EU states and increase investor perceptions of debt risk, producing wider sovereign yield premia for the most exposed countries." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="global_oil_market_shock::diesel_supply_gap" id="323">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Expanded financial and trade sanctions (export bans, secondary sanctions, restrictions on tankers/insurance) directly curtail Russian diesel exports and limit rerouting options, producing an immediate negative gap between diesel supply and demand in affected markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_oil_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="global_oil_market_shock::refining_margin_level" id="324">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sanctions that disrupt crude flows and increase logistics/insurance costs change available feedstock quality and raise product scarcity, directly widening the spread between refined-product prices and crude costs for refineries able to sell into tight markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_oil_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_pressure" target="iran_gulf_standoff::shipping_throughput" id="325">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Tighter sanctions and export controls on Russian seaborne oil push trade flows to be rerouted and compensated by increased tanker lift from the Persian Gulf, raising commercial throughput through the chokepoint." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
