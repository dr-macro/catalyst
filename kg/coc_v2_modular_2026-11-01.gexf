          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rising market perception of supply risk raises demand for precautionary inventories and drives speculative buying and risk premia in refined-product markets, elevating refined product price levels rapidly." />
