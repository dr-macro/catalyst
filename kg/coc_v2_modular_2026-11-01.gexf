          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A rise in geopolitical conflict intensity prompts governments to impose or tighten formal export controls and licensing on critical components and know‑how to deny adversaries capabilities and to reduce technology leakage." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="china_geostrategic_push" />
