          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An uptick in geopolitical conflict intensity increases the propensity for state and proxy actors to conduct interdiction, harassment, mining, and missile/DRONE strikes on commercial vessels in the Gulf as part of broader coercive or asymmetric campaigns." />
