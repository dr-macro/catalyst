      <edge source="european_institutional_f::policy_uncertainty" target="china_geostrategic_push::export_control_restrict" id="795">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising policy uncertainty within European institutions drives precautionary regulatory tightening and accelerates adoption of stricter export‑control rules and licensing scrutiny for sensitive dual‑use technologies destined for China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="european_institutional_f" />
          <attvalue for="38" value="china_geostrategic_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="european_institutional_f::policy_uncertainty" target="china_geostrategic_push::private_capital_flow" id="796">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened regulatory and political unpredictability in Europe leads Chinese firms and investors to curtail outbound deals and repatriate or redirect capital into domestic AI R&amp;D and capex, increasing private AI investment flows in China." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="european_institutional_f" />
          <attvalue for="38" value="china_geostrategic_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="european_institutional_f::policy_uncertainty" target="global_oil_market_shock::product_price_level" id="797">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher European policy uncertainty around sanctions, price caps or fuel regulation drives precautionary buying and adds a risk premium to markets, raising spot refined‑product prices (particularly middle distillates) in the short term." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="european_institutional_f" />
          <attvalue for="38" value="global_oil_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="european_institutional_f::policy_uncertainty" target="iran_gulf_standoff::supply_risk_perception" id="798">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher European policy uncertainty about sanctions, diplomatic stances, or enforcement creates ambiguity about future restrictions and escalation risk, leading oil traders, insurers and logistics managers to mark up the perceived probability and severity of Gulf supply disruptions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="european_institutional_f" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="european_institutional_f::policy_uncertainty" target="russia_ukraine_war::alliance_cohesion" id="799">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher institutional policy uncertainty in European bodies (disputed rules on sanctions, energy or arms transfers) creates asymmetric national responses and delays decision‑making, producing visible fractures and reduced coordinated action among allies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="european_institutional_f" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
