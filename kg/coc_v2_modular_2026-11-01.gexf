          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="If China adopts a more confrontational posture toward Western states, its perceived neutrality and credibility as a broker in Russia–Ukraine talks will fall, reducing its ability to shape negotiation outcomes on behalf of Moscow." />
