          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Augmented naval deployments and convoy protections reduce the success rate and frequency of opportunistic maritime attacks and interdictions, thereby lowering the short-term intensity and incidence of geopolitical incidents that disrupt energy logistics." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="global_oil_market_shock" />
