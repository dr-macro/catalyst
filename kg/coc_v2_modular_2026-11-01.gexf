          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in attacks on commercial shipping pushes up energy prices and political sensitivity to further energy-sector penalties, weakening domestic and coalition appetite to expand or tighten sanctions on Russia's energy exports." />
