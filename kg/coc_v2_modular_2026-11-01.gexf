          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating China–US strategic friction draws US political and military focus to the Indo‑Pacific and triggers disputes among allies over priorities and burden‑sharing for Ukraine support, eroding coordinated policy and resource commitments." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_geostrategic_push" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
