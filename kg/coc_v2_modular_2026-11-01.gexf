      </edge>
      <edge source="global_oil_market_shock::product_price_level" target="china_geostrategic_push::private_capital_flow" id="629">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained increases in refined‑product prices raise operating and logistics costs for tech firms and chip manufacturers, compress corporate free cash flow and raise project breakeven costs, which causes private investors to delay or reduce AI capital deployment." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="china_geostrategic_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_market_shock::product_price_level" target="european_institutional_f::policy_uncertainty" id="630">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A spike in refined fuel prices provokes rapid political debate and ad‑hoc interventions (price caps, subsidies, emergency measures) and forces frequent policy choices that increase unpredictability about future economic policy." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_market_shock::product_price_level" target="iran_gulf_standoff::supply_risk_perception" id="631">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sharp rises in refined product prices are interpreted by traders and policymakers as signals of market tightness or disruption, leading to an upward revision in the assessed probability and severity of supply interruptions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_market_shock::product_price_level" target="russia_ukraine_war::military_force_projectio" id="632">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="A sustained rise in refined-product prices increases export and fiscal receipts for hydrocarbon exporters (including Russia) and thereby expands available budgetary and procurement resources for sustaining or expanding conventional operations in Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_market_shock::product_price_level" target="russia_ukraine_war::sanctions_pressure" id="633">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher domestic gasoline/diesel prices caused by refinery/product price spikes raise public and political resistance in sanctioning states, reducing willingness to broaden or tighten economic measures against Russia in the near term." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
