          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A sustained escalation in regional military deployments raises political pressure on central banks to prioritize growth/support measures (energy subsidies, easing) over inflation targets, eroding market perceptions of consistent commitment to stated monetary rules." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_gulf_standoff" />
          <attvalue for="38" value="european_institutional_f" />
