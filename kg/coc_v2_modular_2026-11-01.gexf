      <edge source="global_oil_market_shock::geo_conflict_intensity" target="european_institutional_f::sovereign_bond_spreads" id="661">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising geopolitical conflict raises the perceived risk of energy‑supply shocks and fiscal stress for energy‑importing European states, prompting investors to demand higher sovereign risk premia and widen spreads." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
