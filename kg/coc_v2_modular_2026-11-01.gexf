      <edge source="european_institutional_f::banking_sector_solvency" target="global_oil_market_shock::diesel_supply_gap" id="809">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A deterioration in European banking-sector solvency leads banks to tighten or withdraw trade finance and letters-of-credit for cross-border refined‑fuel shipments, interrupting exports from EU refineries and producing immediate regional diesel shortfalls." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="european_institutional_f" />
          <attvalue for="38" value="global_oil_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="european_institutional_f::banking_sector_solvency" target="iran_gulf_standoff::shipping_throughput" id="810">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Deterioration in European banks' solvency tightens trade finance and marine insurance availability, causing exporters and carriers to delay, downscale or re-route shipments that would transit the Gulf chokepoint, reducing throughput." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="european_institutional_f" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="european_institutional_f::banking_sector_solvency" target="russia_ukraine_war::sanctions_pressure" id="811">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Worsening solvency in major European banks makes regulators and finance ministries reluctant to implement or enforce broad financial measures (e.g., full SWIFT cuts, aggressive secondary sanctions) for fear of systemic contagion, thereby reducing the scope and intensity of sanctions pressure on Russia." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="european_institutional_f" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
