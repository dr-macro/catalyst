      <edge source="global_oil_market_shock::diesel_supply_gap" target="global_oil_market_shock::regulatory_scrutiny_leve" id="640">
        <attvalues>
          <attvalue for="26" value="intra_causal" />
          <attvalue for="28" value="2" />
          <attvalue for="32" value="-" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_market_shock::diesel_supply_gap" target="european_institutional_f::gdp_growth_momentum" id="641">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A diesel shortfall immediately constrains freight, construction and agricultural logistics, causing production disruptions and inventory bottlenecks that slow industrial output and overall GDP momentum." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_market_shock::diesel_supply_gap" target="iran_gulf_standoff::supply_risk_perception" id="642">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="An increase in the diesel supply gap (i.e., supply exceeding demand) reduces market and stakeholder assessments of near‑term disruption risk, whereas a shrinking/negative gap raises perceived supply risk; hence movements in the gap directly alter risk perception." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_oil_market_shock::diesel_supply_gap" target="russia_ukraine_war::military_force_projectio" id="643">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A larger diesel supply surplus (positive gap) improves fuel availability for Ukrainian and allied logistics and mechanized operations, degrading Russia's relative ability to expand cross‑border conventional operations; conversely a shortage would favor Russian operational freedom." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_oil_market_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
