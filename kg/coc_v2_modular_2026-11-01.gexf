          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An elevated regional military posture increases the likelihood of incidents and interstate alignments that draw in major powers, directly intensifying strategic friction and diplomatic hostility involving China and its competitors." />
