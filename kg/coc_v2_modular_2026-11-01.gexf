      <edge source="russia_ukraine_war::alliance_cohesion" target="china_geostrategic_push::geopolitical_tension" id="302">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Greater policy alignment and operational coordination among the US and its allies forged during the Russia–Ukraine war is redirected into coordinated strategic posture and deterrence in the Indo‑Pacific, increasing bilateral and multilateral tensions with China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_geostrategic_push" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="european_institutional_f::monetary_credibility" id="303">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained fall in alliance cohesion creates differentiated fiscal responses and political pressure on the ECB (calls for monetary financing or relaxed remit), weakening market belief in the central bank's independence and commitment to its stated inflation objectives." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="european_institutional_f" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::alliance_cohesion" target="iran_gulf_standoff::military_posture" id="304">
