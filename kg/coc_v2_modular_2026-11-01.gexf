          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Greater cohesion and resource commitment among Western allies to counter Russia leads the United States and partners to redeploy naval and air assets toward Europe, reducing sustained forward deployments and deterrent posture in the Gulf." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_standoff" />
          <attvalue for="27" value="0" />
