<edge source="russia_ukraine_war::drone_attack_intensity" target="currency_market_shock::market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">A surge in drone attacks against energy, transport and trading infrastructure raises intraday price volatility and counterparty credit concerns, prompting market makers and liquidity providers to widen spreads and reduce inventory, lowering market liquidity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">currency_market_shock</data>
</edge>
<edge source="russia_ukraine_war::drone_attack_intensity" target="global_ai_competition::compute_demand_for_ai" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Surges in drone attacks create immediate demand for AI-powered detection, tracking, simulation and retraining workloads, increasing short-term consumption of compute resources for defense R&amp;D and deployed systems.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_ai_competition</data>
</edge>
<edge source="russia_ukraine_war::drone_attack_intensity" target="strait_hormuz_standoff::incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.65</data>
  <data key="d36">Higher combat use and visible effectiveness of unmanned aerial attacks accelerates transfer of drone platforms, tactics and munitions to Middle Eastern proxies and black‑market suppliers, enabling more frequent successful attacks on vessels in the Strait.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">strait_hormuz_standoff</data>
</edge>
<edge source="russia_ukraine_war::drone_attack_intensity" target="us_china_econ_rivalry::onshore_mfg_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Sustained increases in drone attack activity drive accelerated government procurement and targeted subsidies for counter‑UAS sensors, munitions and related components, prompting firms to expand domestic production lines and capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_econ_rivalry</data>
</edge>
