<edge source="currency_market_shock::long_term_nominal_yield" target="global_ai_competition::ai_model_capability" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained rise in long-term nominal yields reduces the present value of long-horizon R&amp;D returns and convinces firms and institutional backers to cut or postpone ambitious, compute-intensive AI model development programs, slowing capability gains.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">currency_market_shock</data>
  <data key="d39">global_ai_competition</data>
</edge>
<edge source="currency_market_shock::long_term_nominal_yield" target="russia_ukraine_war::alliance_cohesion" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained rise in long-term sovereign yields raises government borrowing and debt‑service costs, shrinking fiscal space and prompting domestic political pressure to cut or delay foreign military assistance, which undermines sustained agreement and coordinated action among allies.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">currency_market_shock</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
