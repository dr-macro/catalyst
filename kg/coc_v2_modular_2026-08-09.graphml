  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Growth in domestic fabrication and assembly capacity shortens hardware lead times and reduces supply risk, making investment in local AI startups, data centers and edge infrastructure more attractive and thereby increasing capital flows into the sector.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_econ_rivalry</data>
