<edge source="currency_market_shock::market_liquidity" target="strait_hormuz_standoff::rerouting_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A market liquidity shock reduces availability and raises cost of war-risk hedges and short-term trade finance, leading shippers and underwriters to prefer longer but safer alternative routes and thus increase the rate at which vessels reroute around the chokepoint.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">currency_market_shock</data>
  <data key="d39">strait_hormuz_standoff</data>
</edge>
<edge source="currency_market_shock::market_liquidity" target="us_china_econ_rivalry::prices_critical_inputs" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising market liquidity lowers bid-ask spreads and risk premia for trading physical and financial claims on critical inputs, reducing short-term spot and contract prices for polysilicon, wafers and other inputs.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">currency_market_shock</data>
  <data key="d39">us_china_econ_rivalry</data>
</edge>
