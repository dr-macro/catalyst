<edge source="iran_houthi_escalation::maritime_incident_rate" target="russia_ukraine_war::defense_funding_avail" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">A sustained rise in attacks on commercial and naval shipping forces governments to reallocate immediate defense procurement and budgetary resources to naval patrols, convoy protection and port security, shrinking funds available for external assistance to Ukraine.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_houthi_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
