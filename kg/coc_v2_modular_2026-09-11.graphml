<edge source="global_financial_stress::sovereign_yield_level" target="russia_ukraine_war::political_will_backers" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained increases in sovereign yields raise visible debt‑service burdens and consumer borrowing costs, driving domestic economic pain and electoral or public pressure that erodes political support for continued external involvement.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
