  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widening corporate spreads signal higher counterparty and funding risk, prompting correspondent banks and shipping/service providers to tighten compliance and de-risk by refusing or restricting Iran-related transactions, which effectively raises the intensity of trade and financial restrictions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">iran_houthi_escalation</data>
</edge>
<edge source="global_financial_stress::corporate_spread_level" target="north_korea_nuclear::missile_prod_capacity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widening corporate credit spreads raise borrowing and trade‑finance costs for component manufacturers and assemblers in regional supplier countries, constraining their output and exports of precision parts and thereby reducing North Korea's aggregate missile production capacity.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_financial_stress</data>
  <data key="d39">north_korea_nuclear</data>
</edge>
