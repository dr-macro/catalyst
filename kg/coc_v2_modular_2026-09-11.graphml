<edge source="north_korea_nuclear::cross_border_cap_flow" target="global_financial_stress::market_liquidity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sudden reduction in cross‑border capital flows into Asian and defence‑sensitive bond markets (driven by North Korean nuclear escalations) removes nonresident liquidity providers and raises margin/financing costs for dealers, materially reducing bond market depth and tradability.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">global_financial_stress</data>
</edge>
