<edge source="north_korea_nuclear::strategic_alignment" target="global_financial_stress::sovereign_yield_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A measurable increase in coordinated security alignment and posture among major powers in response to North Korean nuclear developments typically entails near‑term higher defence outlays and expected sovereign issuance, putting upward pressure on benchmark sovereign yields.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">global_financial_stress</data>
</edge>
<edge source="north_korea_nuclear::strategic_alignment" target="iran_houthi_escalation::sanctions_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">A demonstrable tightening of strategic alignment or formal cooperation between North Korea and Iran triggers rapid policy responses from the US/EU/allies (e.g., targeted secondary sanctions, shipping restrictions, and designation of facilitation networks), increasing the measured intensity of trade and financial restrictions on Iranian and associated actors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">iran_houthi_escalation</data>
</edge>
<edge source="north_korea_nuclear::strategic_alignment" target="us_china_tech_rivalry::export_control_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sharp escalation in North Korean nuclear activity drives closer US–Japan–ROK security coordination and coalitions that rapidly harmonize and expand export controls and licensing regimes targeting dual‑use and advanced tech flows to China.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
