  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising cross‑border capital flows routed through North Korean/Russian networks facilitate sanctions‑evasion and liquidity transfers that augment Russian access to funds or credit for military procurement, increasing readily available resources for defense operations.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">north_korea_nuclear</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
