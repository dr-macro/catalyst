      <edge source="russia_ukraine_war::state_pressure_level" target="china_tech_pressure::state_policy_intensity" id="55">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Sustained use of diplomatic, regulatory and financial pressure on private providers in the conflict sets a precedent that induces other states to increase the use of direct economic and administrative tools to steer domestic tech and communications firms for security objectives." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_tech_pressure" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::state_pressure_level" target="democratic_unrest_wave::policy_forcefulness" id="56">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained state pressure on providers to block/disrupt services creates legal and operational precedents and normalizes government intervention in communications, which domestic authorities then cite to justify more coercive policing, censorship and emergency measures against unrest." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="democratic_unrest_wave" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::state_pressure_level" target="global_finance_shock::sovereign_fiscal_pressur" id="57">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained state pressure (diplomatic, regulatory, financial or covert) that forces provider operational changes or induces sanctions compels governments to underwrite replacement services, provide bailouts/compensations and increase defence/support spending, widening deficits and raising sovereign refinancing needs." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_finance_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
