      <edge source="global_finance_shock::energy_supply_balance" target="china_tech_pressure::state_policy_intensity" id="664">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A deterioration in the energy supply balance (tighter supply) compels rapid government rationing, sectoral prioritization and emergency regulatory actions, increasing state policy intensity to allocate scarce energy and protect critical industries." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_finance_shock" />
