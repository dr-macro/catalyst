          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A jump in investor risk aversion tightens financial conditions (widened spreads, equity falls, funding stress), prompting central banks to ease policy (lower real policy rates or add liquidity) to stabilize markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="democratic_unrest_wave" />
          <attvalue for="38" value="global_finance_shock" />
          <attvalue for="27" value="0" />
