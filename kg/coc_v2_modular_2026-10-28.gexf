      <edge source="democratic_unrest_wave::policy_forcefulness" target="china_tech_pressure::tech_controls_tightness" id="843">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="When states respond to unrest with more forceful policing and legal crackdowns they simultaneously mandate expanded digital surveillance, mandatory data access and tighter platform compliance, directly increasing the tightness of technology controls." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="democratic_unrest_wave" />
          <attvalue for="38" value="china_tech_pressure" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="democratic_unrest_wave::policy_forcefulness" target="global_finance_shock::sovereign_fiscal_pressur" id="844">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="More forceful state responses raise immediate security and enforcement expenditures and often require emergency transfers or revenue foregone while economic activity falls, widening budget deficits and near‑term refinancing needs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="democratic_unrest_wave" />
          <attvalue for="38" value="global_finance_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="democratic_unrest_wave::policy_forcefulness" target="russia_ukraine_war::service_restriction_rate" id="845">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="States responding more forcefully to unrest rapidly deploy export controls, telecom directives and legal orders that require or enable commercial operators to throttle, block or refuse satellite service to designated zones or actors in the Russia–Ukraine theatre." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="democratic_unrest_wave" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="democratic_unrest_wave::policy_forcefulness" target="us_iran_standoff::proxy_attack_rate" id="846">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.68" />
          <attvalue for="35" value="Heavy-handed state repression increases regime calculation that asymmetric retaliation via allied proxies is an effective deterr (and gives proxies recruiting narratives), prompting more proxy strikes against perceived external supporters such as U.S. forces and partners." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="democratic_unrest_wave" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
