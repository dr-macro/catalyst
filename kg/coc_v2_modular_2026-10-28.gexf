          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened external countermeasures against China escalate US‑China strategic competition and drive reallocation of Western naval and intelligence assets toward the Indo‑Pacific, reducing deterrent presence in the Gulf and thereby increasing the risk of commercial shipping delays, reroutings, or incidents tied to the US‑Iran standoff." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="china_tech_pressure" />
