      <edge source="us_iran_standoff::energy_supply_risk" target="china_tech_pressure::state_policy_intensity" id="297">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Elevated risk of oil and gas interruptions prompts importing states to intensify state-directed measures (strategic releases, subsidies, investment screening, targeted industrial supports) to secure energy and related critical supply chains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="china_tech_pressure" />
