          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Security-driven risks to production and transit (attacks on terminals/tankers, precautionary shutdowns) directly remove barrels/volumes from markets and tighten the near-term supply-demand balance." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="global_finance_shock" />
