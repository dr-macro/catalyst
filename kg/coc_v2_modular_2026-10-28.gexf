      <edge source="us_iran_standoff::energy_supply_risk" target="democratic_unrest_wave::investor_risk_aversion" id="298">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="An increased risk of oil/gas supply disruption raises near-term macro and corporate earnings uncertainty and commodity-price volatility, causing investors to shift away from risky assets and increase cash/hedge positions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="democratic_unrest_wave" />
          <attvalue for="27" value="0" />
