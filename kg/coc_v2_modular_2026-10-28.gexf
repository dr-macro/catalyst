      <edge source="russia_ukraine_war::satcom_availability" target="china_tech_pressure::export_controls" id="30">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="If wartime degradation or denial of commercial satellite connectivity reveals critical capability gaps, governments accelerate and broaden export restrictions on satellite components and related high-end communications gear to prevent adversary acquisition and preserve supply‑chain leverage." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_tech_pressure" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::satcom_availability" target="democratic_unrest_wave::contagion_susceptibility" id="31">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Higher satellite connectivity in the conflict theatre increases cross‑border information flows (live video, calls to diaspora, rapid messaging), raising the likelihood that tactics, narratives and mobilization cues spread to other regions and trigger allied protests." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="democratic_unrest_wave" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::satcom_availability" target="global_finance_shock::real_output_growth" id="32">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Reduced availability of high‑bandwidth, low‑latency satellite connectivity in conflict‑adjacent regions disrupts logistics, remote operations, precision agriculture and supply‑chain coordination, directly lowering near‑term regional GDP growth with modest global spillovers." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_finance_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::satcom_availability" target="us_iran_standoff::military_tension_level" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Large reductions in commercial satcom availability over the Ukraine theatre force the US to redeploy military ISR/communications assets and forward naval/air units to preserve coverage and redundancy, producing visible increases in hostile readiness and kinetic deterrent posture versus Iran." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
