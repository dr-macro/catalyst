        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::service_restriction_rate" target="china_tech_pressure::corporate_repositioning" id="70">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Frequent or large-scale throttling and geographic service cutoffs in the conflict prompt multinational firms to move infrastructure, diversify vendors and relocate traffic or production to reduce operational exposure to similar restrictions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="china_tech_pressure" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::service_restriction_rate" target="democratic_unrest_wave::protest_event_rate" id="71">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Frequent throttling or shutdowns of commercial communications in or near the conflict provoke local and regional grievances and spur ad‑hoc organizing (street demonstrations, flash mobs) as affected populations protest loss of information and services." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="democratic_unrest_wave" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::service_restriction_rate" target="global_finance_shock::term_structure_of_rates" id="72">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Frequent deliberate throttling or geographic disabling of commercial communications causes short‑term liquidity and clearing frictions for banks and trading venues (outage‑driven trade/settlement delays), raising short‑term funding costs relative to long rates and steepening the yield curve within days to weeks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_finance_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::service_restriction_rate" target="us_iran_standoff::allied_cohesion_level" id="73">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Frequent coordinated service restrictions used against Russia create legal, regulatory and operational coordination channels and precedents among the US and partners that are then reused to align joint pressure and responses in the US–Iran standoff, increasing coalition cohesion." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
