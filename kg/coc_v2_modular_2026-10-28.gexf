          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_finance_shock::sovereign_fiscal_pressur" target="china_tech_pressure::state_policy_intensity" id="602">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising sovereign fiscal pressure forces authorities to increase administrative interventions, directed credit and industrial support (to stabilize revenues, employment and strategic firms), thereby raising overall state-directed policy intensity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_finance_shock" />
          <attvalue for="38" value="china_tech_pressure" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_finance_shock::sovereign_fiscal_pressur" target="democratic_unrest_wave::protest_event_rate" id="603">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Acute sovereign fiscal pressure forces rapid subsidy cuts, delayed public wages or new consumption taxes that produce immediate material grievances and trigger organized protests and strikes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_finance_shock" />
          <attvalue for="38" value="democratic_unrest_wave" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_finance_shock::sovereign_fiscal_pressur" target="russia_ukraine_war::satcom_availability" id="604">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising fiscal pressure in donor and allied states reduces budgetary allocations and ad‑hoc purchases of commercial satellite capacity (including subsidised wartime bandwidth), lowering the net available satcom capacity for actors in the theatre." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_finance_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_finance_shock::sovereign_fiscal_pressur" target="russia_ukraine_war::state_pressure_level" id="605">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating fiscal stress motivates governments to extract concessions from private providers (via regulatory demands, procurement conditions, or diplomatic pressure) to secure communications or revenue, increasing the intensity and persistence of state pressure on operators." />
