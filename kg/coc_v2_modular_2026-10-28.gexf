      <edge source="global_finance_shock::monetary_policy_stance" target="china_tech_pressure::corporate_repositioning" id="580">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A tightening monetary policy stance (higher real rates) raises borrowing and working‑capital costs and reduces cross‑border financing, which increases firms' incentives to relocate production closer to demand or to diversify suppliers to lower financing and inventory risks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_finance_shock" />
          <attvalue for="38" value="china_tech_pressure" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_finance_shock::monetary_policy_stance" target="democratic_unrest_wave::investor_risk_aversion" id="581">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rapid monetary tightening raises short-term rates and market volatility and depresses risky asset valuations, prompting investors to shift toward safe assets and increase measured risk aversion." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_finance_shock" />
          <attvalue for="38" value="democratic_unrest_wave" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_finance_shock::monetary_policy_stance" target="russia_ukraine_war::provider_control_autonom" id="582">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A tighter monetary stance raises borrowing costs and liquidity stress for commercial satellite/communications firms, forcing them into government loans, conditional financing or creditor covenants that curtail their unilateral decision‑making over service allocations." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_finance_shock" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="global_finance_shock::monetary_policy_stance" target="us_iran_standoff::allied_cohesion_level" id="583">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A sustained tightening in global monetary policy raises borrowing costs and inflationary pressures for US partners, forcing domestic budget retrenchment and politically constraining willingness to absorb additional security burdens, which erodes coalition alignment in an Iran crisis." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="global_finance_shock" />
          <attvalue for="38" value="us_iran_standoff" />
          <attvalue for="27" value="0" />
