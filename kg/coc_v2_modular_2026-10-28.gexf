          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating external countermeasures (investment bans, sanctions, asset restrictions) trigger export losses and capital outflows in targeted economies, reducing tax revenues and prompting emergency spending and higher borrowing needs that raise sovereign fiscal pressure." />
