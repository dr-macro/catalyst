          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An uptick in third‑party countermeasures against China (sanctions, investment curbs, designations) prompts Beijing to signal or deepen strategic ties with Iran, which in turn leads the US and regional partners to align more closely politically and operationally to counter the perceived China‑Iran axis." />
          <attvalue for="36" value="0-6 months" />
