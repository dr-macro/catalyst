          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Increased sanctions, designations and investment curbs by third states raise legal and financial risk for operators, prompting more frequent geofencing, throttling or suspension of services affecting actors in the conflict zone." />
