      <edge source="global_finance_shock::energy_supply_balance" target="democratic_unrest_wave::protest_event_rate" id="665">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Sharp energy shortages or large price spikes (fuel, electricity) produce immediate service disruptions and cost-of-living shocks that mobilize street protests, especially in regions dependent on fuel subsidies." />
