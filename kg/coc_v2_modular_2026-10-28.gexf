      <edge source="us_iran_standoff::military_tension_level" target="china_tech_pressure::external_countermeasures" id="243">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher interstate military tension increases political pressure on governments to penalize perceived enablers through sanctions, designations and investment curbs, raising the aggregate level of external countermeasures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="china_tech_pressure" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::military_tension_level" target="democratic_unrest_wave::contagion_susceptibility" id="244">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Escalating military tensions amplify regional media attention, refugee flows and politicized cross-border narratives, lowering barriers to imitation and increasing the likelihood that unrest in one country spreads to others." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="democratic_unrest_wave" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_standoff::military_tension_level" target="global_finance_shock::sovereign_fiscal_pressur" id="245">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Sustained higher military tension forces governments to increase defense spending, contingency outlays and borrowing costs, raising budget deficits and overall sovereign refinancing pressure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="global_finance_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
