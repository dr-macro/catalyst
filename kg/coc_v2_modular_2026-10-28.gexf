      <edge source="democratic_unrest_wave::investor_risk_aversion" target="china_tech_pressure::corporate_repositioning" id="817">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Higher investor risk aversion drives asset managers and shareholders to demand reduced exposure to politically unstable jurisdictions, accelerating firms' decisions to relocate production and reconfigure supply chains away from affected markets, increasing corporate repositioning rates." />
          <attvalue for="36" value="6-18 months" />
