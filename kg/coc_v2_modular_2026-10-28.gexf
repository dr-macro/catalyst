      <edge source="us_iran_standoff::energy_supply_risk" target="global_finance_shock::monetary_policy_stance" id="300">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising risk of energy disruption lifts headline and expected inflation, prompting central banks to raise the effective policy rate (tighten stance) to counter near-term inflationary pressures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_iran_standoff" />
          <attvalue for="38" value="global_finance_shock" />
