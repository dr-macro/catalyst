      <edge source="russia_ukraine_war::provider_control_autonom" target="democratic_unrest_wave::investor_risk_aversion" id="44">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="When commercial providers can unilaterally alter or withdraw services in response to the war, businesses face unpredictable continuity and regulatory risk, prompting investors to demand higher risk premia and shift toward safer assets." />
