          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Escalating sanctions compel foreign operators and service providers to divest or be expelled from local projects, reducing the extent of external actors' operational and proprietary control over the reserves." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="39" value="energy_geopolitics_shift" />
          <attvalue for="28" value="0" />
