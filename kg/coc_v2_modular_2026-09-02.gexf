          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Shifts in on‑the‑ground combat power change which armed actor can seize, defend or deny access to onshore and offshore fields, so a rise in an adversary's military strength reduces the ability of external investors or states to hold operational control over those reserves." />
          <attvalue for="37" value="6-18 months" />
