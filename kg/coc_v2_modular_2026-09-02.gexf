      <edge source="russia_ukraine_war::kinetic_attack_intensity" target="energy_geopolitics_shift::supply_disruption_risk" id="186">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="Increased kinetic strikes against pipelines, terminals and transport corridors physically damage energy infrastructure and logistics, directly raising the likelihood and severity of upstream and midstream supply disruptions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="energy_geopolitics_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
