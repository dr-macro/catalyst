          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher long-term yields increase the cost of capital for defense contractors and their suppliers, leading firms to cut inventory, delay investment and subcontracting, which degrades the reliability and continuity of defense-relevant supply chains." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_bond_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
