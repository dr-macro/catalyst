          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising long-term government bond yields increase discount rates and the cost of project financing for capital‑intensive upstream oil investments, causing firms to defer or cancel capacity expansion and thus reduce near‑term production capability." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_bond_stress" />
          <attvalue for="39" value="energy_geopolitics_shift" />
