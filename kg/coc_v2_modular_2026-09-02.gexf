      <edge source="ai_tech_competition::model_capability" target="energy_geopolitics_shift::oil_production_capacity" id="755">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Higher-performing models enable more accurate reservoir simulation, real‑time completion optimization and drilling control algorithms that increase throughput and recoverable output from existing wells." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_tech_competition" />
          <attvalue for="39" value="energy_geopolitics_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_tech_competition::model_capability" target="monetary_bond_stress::policy_signal_intensity" id="756">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rapid, high‑visibility jump in model capability provokes immediate public comment and guidance from central banks, finance ministries and regulators about economic disruption and financial stability, increasing the frequency and intensity of official policy communications." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_tech_competition" />
          <attvalue for="39" value="monetary_bond_stress" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_tech_competition::model_capability" target="russia_ukraine_war::kinetic_attack_intensity" id="757">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Marked improvements in deployed AI models (better real‑time ISR fusion, target recognition and strike routing) shorten sensor-to-shooter cycles and enable higher tempo, more precise strike sorties, raising the observable rate and scale of kinetic attacks." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_tech_competition" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_tech_competition::model_capability" target="us_iran_gulf_conflict::sanctions_pressure" id="758">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Rapid improvements in AI model capability enable more effective detection, attribution and automated analysis of sanctions-evasion networks (shipping, finance, front companies), giving policymakers the evidence and operational tools to broaden and intensify targeted sanctions against Iranian actors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="ai_tech_competition" />
          <attvalue for="39" value="us_iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="ai_tech_competition::model_capability" target="us_iran_gulf_conflict::tanker_incidents" id="759">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Higher AI capability accelerates development and deployment of maritime ISR, autonomous drones and precision targeting aids for state and proxy forces in the Gulf, increasing the tempo and accuracy of interdictions and low‑level kinetic encounters that raise tanker incident rates." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="ai_tech_competition" />
