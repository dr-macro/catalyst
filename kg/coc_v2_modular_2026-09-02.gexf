          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sustained, high-intensity Russian strikes raise near-term tail‑risk perceptions for global energy and trade, causing investors and insurers to demand higher risk premia on Gulf‑linked assets and financings." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
