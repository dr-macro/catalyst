          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Spikes in kinetic attack intensity prompt flight-to-safety and rapid risk‑off rebalancing, driving large net inflows into core government bonds and outflows from equities and risk assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="monetary_bond_stress" />
          <attvalue for="28" value="0" />
