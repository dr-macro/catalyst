      <edge source="us_iran_gulf_conflict::sanctions_pressure" target="ai_tech_competition::regulatory_pressure" id="44">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Escalating sanctions routines prompt governments to broaden export controls, compliance checks and licensing regimes to cover AI-relevant hardware and software, raising formal regulatory activity aimed at AI development and transfer." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="39" value="ai_tech_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_gulf_conflict::sanctions_pressure" target="ai_tech_competition::investment_flow" id="45">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Intensified sanctions drive public and private actors to onshore or ally-source critical AI supply chains and chip capacity, channeling new capital into domestic AI R&amp;D and infrastructure to reduce dependence on sanctioned/exposed partners." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_gulf_conflict" />
          <attvalue for="39" value="ai_tech_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
