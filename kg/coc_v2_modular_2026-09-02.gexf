          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Large net portfolio outflows from risk assets into safe assets depress growth and commodity demand expectations and trigger selling in commodity-linked positions, lowering oil prices." />
