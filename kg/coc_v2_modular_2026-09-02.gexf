      <edge source="monetary_bond_stress::portfolio_flow_volumes" target="ai_tech_competition::market_concentration" id="464">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sustained reallocation of portfolio flows out of risk assets into safe bonds reduces liquidity and follow-on funding for smaller AI startups, increasing exits, distress sales and acquisition opportunities that consolidate customers and infrastructure among a few well-capitalized incumbents." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_bond_stress" />
          <attvalue for="39" value="ai_tech_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
