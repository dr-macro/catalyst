      <edge source="monetary_bond_stress::portfolio_flow_volumes" target="energy_geopolitics_shift::control_over_reserves" id="465">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Rising cross‑border portfolio inflows provide foreign energy firms and funds with liquidity to acquire equity stakes or finance takeovers of oil assets, increasing external actors' operational or proprietary control over reserves." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="monetary_bond_stress" />
          <attvalue for="39" value="energy_geopolitics_shift" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="monetary_bond_stress::portfolio_flow_volumes" target="russia_ukraine_war::alliance_cohesion" id="466">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.55" />
          <attvalue for="36" value="Larger net portfolio inflows into allied markets relieve fiscal and currency stress and sustain domestic political support for external military assistance, whereas rapid outflows (the inverse) increase domestic pressure to reduce foreign aid and thereby weaken political‑military cohesion among allies." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="monetary_bond_stress" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
