          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Rising sovereign borrowing costs force governments to reallocate or cut discretionary budgets and near-term R&amp;D/subsidy programs for strategic technologies, reducing public support for AI research, compute grants and national model-development initiatives." />
          <attvalue for="37" value="6-18 months" />
