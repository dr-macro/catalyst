          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="An increase in combat-capable forces and battlefield attrition in the Russia‑Ukraine war accelerates arms transfers, training exchanges, and doctrine diffusion to regional actors and proxies, which raises the operational capability and intent to conduct asymmetric attacks on commercial shipping in the Gulf, increasing tanker incidents." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_iran_gulf_conflict" />
          <attvalue for="28" value="0" />
        </attvalues>
