          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Increased kinetic combat and personnel losses create urgent operational gaps that accelerate fielding and adoption of autonomous sensors, logistics drones and AI decision aids to substitute for or protect human forces, raising the rate of automation deployment." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="ai_tech_competition" />
          <attvalue for="28" value="0" />
