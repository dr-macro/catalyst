<edge source="russia_ukraine_war::infra_resilience_level" target="iran_gulf_flashpoint::transit_risk_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Higher resilience of energy and transport infrastructure in the Russia–Ukraine theatre reduces demonstrable vulnerability and insurance/re-routing pressures, which lowers perceived shipping transit risk in the Gulf (and vice versa when resilience falls).</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_gulf_flashpoint</data>
</edge>
