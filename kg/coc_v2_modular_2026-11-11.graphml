<edge source="us_political_shift::public_alignment" target="iran_gulf_flashpoint::diplo_engage_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">A rapid net shift in public preferences toward de‑escalation raises political pressure on elected officials to initiate or expand diplomatic contacts and negotiations with Gulf parties and intermediaries.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_political_shift</data>
  <data key="d39">iran_gulf_flashpoint</data>
</edge>
<edge source="us_political_shift::public_alignment" target="russia_ukraine_war::disinfo_prevalence" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Growing domestic public sympathy for narratives critical of Ukraine or supportive of disengagement increases receptive audiences and domestic amplification channels for Russian-origin disinformation, raising its overall prevalence and reach.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_political_shift</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_political_shift::public_alignment" target="us_china_tech_rivalry::media_attention_intensit" id="0">
