<edge source="russia_ukraine_war::disinfo_prevalence" target="global_inflation_and_rat::portfolio_reallocation_r" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">1</data>
  <data key="d35">0.6</data>
  <data key="d36">Widespread disinformation about shortages, sanctions or bank stability increases perceived uncertainty and tail‑risk, prompting faster investor reallocation toward liquid and perceived safe assets.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_inflation_and_rat</data>
</edge>
<edge source="russia_ukraine_war::disinfo_prevalence" target="iran_gulf_flashpoint::diplo_engage_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Expanded disinformation campaigns that amplify or misattribute incidents in the Gulf increase perceived threat and ambiguity among regional and extra‑regional actors, prompting more frequent diplomatic contacts, clarifications and crisis management talks.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">iran_gulf_flashpoint</data>
</edge>
<edge source="russia_ukraine_war::disinfo_prevalence" target="us_china_tech_rivalry::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Widespread, adversary‑linked disinformation campaigns expose platform moderation and foreign‑influence vulnerabilities, leading regulators to open probes and increase enforcement actions against intermediaries and cross‑border data practices affecting Chinese and other firms.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
<edge source="russia_ukraine_war::disinfo_prevalence" target="us_political_shift::public_alignment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Coordinated false or misleading narratives about the war amplify partisan framings and entrenched cues from political leaders, increasing public alignment with competing political positions and parties.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_political_shift</data>
</edge>
