<edge source="global_inflation_and_rat::portfolio_reallocation_r" target="iran_gulf_flashpoint::oil_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A rapid increase in portfolio allocations into commodity exposures or energy-linked instruments pushes futures curves and spot liquidity toward higher crude prices as funds buy oil-related contracts and storage/hedging activity rises.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_inflation_and_rat</data>
  <data key="d39">iran_gulf_flashpoint</data>
</edge>
<edge source="global_inflation_and_rat::portfolio_reallocation_r" target="russia_ukraine_war::kinetic_attack_intensity" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Rapid reallocations of portfolios into commodity and energy exposures push up energy prices and cash flows to major hydrocarbon exporters, materially increasing those exporters' export revenue available for military procurement and sustainment, enabling higher kinetic activity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_inflation_and_rat</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_inflation_and_rat::portfolio_reallocation_r" target="us_china_tech_rivalry::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Rapid investor reallocation toward concentrated positions in strategic tech firms or toward foreign tech players raises systemic and national‑security concerns, prompting regulators to increase investigations, transaction reviews, and enforcement actions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_inflation_and_rat</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
