  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Intensified regulatory enforcement against Chinese-linked shipping and tech firms leads Beijing to increase naval/paramilitary escorts and presence around key energy choke points to protect national commerce, raising the frequency of risky close encounters and the perceived shipping transit risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">iran_gulf_flashpoint</data>
</edge>
