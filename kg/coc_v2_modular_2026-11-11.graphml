<edge source="us_political_shift::oversight_intensity" target="global_inflation_and_rat::cross_border_capital_flo" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Intensified high-profile oversight and investigations increase perceived regulatory and political risk for foreign investors, prompting reduced new inflows and net withdrawals of cross-border capital.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_political_shift</data>
  <data key="d39">global_inflation_and_rat</data>
</edge>
<edge source="us_political_shift::oversight_intensity" target="iran_gulf_flashpoint::diplo_engage_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">High‑intensity congressional oversight and investigations constrain executive discretion and politicize foreign‑policy channels, reducing the frequency and scale of formal diplomatic engagement with Gulf and Iranian interlocutors.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_political_shift</data>
  <data key="d39">iran_gulf_flashpoint</data>
</edge>
<edge source="us_political_shift::oversight_intensity" target="us_china_tech_rivalry::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Heightened congressional oversight and investigations into tech firms' China ties produce direct referrals, publicized findings, and political pressure that prompt agencies (e.g., Commerce, FTC) to open or intensify enforcement actions and supervisory reviews of affected companies.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_political_shift</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
