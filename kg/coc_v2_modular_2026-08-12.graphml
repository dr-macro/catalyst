<edge source="global_currency_friction::policy_rate_level" target="taiwan_cross_strait::investment_capital_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Higher global policy interest rates increase home‑market returns and discount rates while raising borrowing costs for leveraged cross‑border deals, directly reducing appetite and feasibility for foreign portfolio and direct investment into Taiwanese industry and tech.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_currency_friction</data>
  <data key="d40">taiwan_cross_strait</data>
</edge>
