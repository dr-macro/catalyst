<edge source="iran_hormuz_standoff::maritime_throughput_rate" target="global_energy_volatility::export_flow_volume" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.95</data>
  <data key="d36">A higher rate of commercial tonnage and cargo transiting the chokepoint directly increases the actual volume of crude and refined products that can be exported from producing regions in the same period.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_standoff</data>
  <data key="d39">global_energy_volatility</data>
