<edge source="iran_hormuz_standoff::maritime_throughput_rate" target="ai_governance_cyber_risk::ai_investment_flow" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A sustained fall in throughput (disrupted shipments and longer transit times) increases component and logistics scarcity and raises risk premia, causing investors and corporations to delay or reduce capital deployment into AI projects and infrastructure.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">iran_hormuz_standoff</data>
