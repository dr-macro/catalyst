  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A rise in maritime incidents forces urgent rerouting, increases trade/disruption-related margin calls and insurance collateral for shippers and commodity traders, and spikes short-term demand for dollar trade and pre-export finance, widening cross-currency basis spreads and funding stress.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">hormuz_standoff</data>
  <data key="d40">global_currency_friction</data>
</edge>
<edge source="hormuz_standoff::maritime_incident_rate" target="taiwan_cross_strait::manufacturing_export_flo" id="0">
