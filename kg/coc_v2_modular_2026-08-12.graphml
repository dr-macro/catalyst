<edge source="hormuz_standoff::oil_price_level" target="russia_ukraine_war::drone_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Sustained spikes in global oil prices boost export revenue for Russia on short notice, increasing available budget and hard-currency purchasing power to procure, field, or replenish drones and munitions, thereby raising the frequency of drone attacks in the Ukraine theater.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">hormuz_standoff</data>
