<edge source="us_china_tech_rivalry::cross_border_capital" target="iran_hormuz_standoff::coercive_leverage" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.6</data>
  <data key="d36">Rising cross-border capital directed into Iranian ports, shipbuilding, and defense-related firms (via Chinese or third-party investors/circumvention channels) finances materiel and infrastructure upgrades that materially increase Iran's ability to threaten or disrupt sea lanes, thereby raising its coercive leverage.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_tech_rivalry</data>
  <data key="d39">iran_hormuz_standoff</data>
