  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Higher commercial throughput through the chokepoint (fewer stoppages) reduces congestion, transit delays and insurance spikes, thereby lowering the magnitude of trade disruptions that spill into the Russia–Ukraine trade system.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_hormuz_standoff</data>
  <data key="d39">russia_ukraine_war</data>
