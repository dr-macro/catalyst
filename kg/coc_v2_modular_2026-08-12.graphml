<edge source="ai_governance_cyber_risk::cyber_risk_prevalence" target="global_energy_volatility::tanker_risk_premium" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">AI-enabled cyberattacks against ship navigation, port IT and chartering platforms increase incidents and claims expectations, which insurers and charterers price as a higher maritime/tanker risk premium.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_governance_cyber_risk</data>
  <data key="d39">global_energy_volatility</data>
</edge>
<edge source="ai_governance_cyber_risk::cyber_risk_prevalence" target="global_energy_volatility::maritime_transit_capacit" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">Successful cyber intrusions on port operating systems, vessel automation or traffic-management platforms directly force slowdowns, berth closures and rerouting that reduce sustainable crude/product shipment throughput through chokepoints.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_governance_cyber_risk</data>
  <data key="d39">global_energy_volatility</data>
</edge>
<edge source="ai_governance_cyber_risk::cyber_risk_prevalence" target="iran_hormuz_standoff::security_incident_rate" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">An increase in AI-enabled cyber risk raises the frequency of successful attacks on ship navigation (AIS/GPS spoofing), port ICS and tanker terminal controls, producing immediate operational failures, collisions, seizures or shutdowns that show up as higher security-incident counts.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">ai_governance_cyber_risk</data>
  <data key="d39">iran_hormuz_standoff</data>
</edge>
