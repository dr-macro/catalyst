  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">An increase in cross‑border technology transfer reduces operational uncertainty for multinationals in supply chains, decreasing precautionary drawdowns of USD credit lines and hedging demand and thereby easing cross‑currency funding strains over time.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">taiwan_cross_strait</data>
  <data key="d40">global_currency_friction</data>
</edge>
<edge source="taiwan_cross_strait::technology_transfer_flow" target="russia_ukraine_war::drone_attack_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">2</data>
  <data key="d36">0.55</data>
  <data key="d37">Accelerated transfer of guidance algorithms, AI payload designs, or manufacturing know‑how from Taiwan to firms in the region enables faster fielding of more effective UAVs by third parties or beneficiaries, raising the frequency and effectiveness of drone attacks in the Russia–Ukraine war.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">taiwan_cross_strait</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="taiwan_cross_strait::technology_transfer_flow" target="us_china_tech_rivalry::trade_control_level" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.75</data>
  <data key="d37">An uptick in transfers of sensitive designs, process IP or equipment from Taiwanese entities to PRC firms triggers immediate policy responses (licensing changes, new entity listings and stricter export controls) from the US and allies to block further leakage.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">taiwan_cross_strait</data>
  <data key="d40">us_china_tech_rivalry</data>
</edge>
