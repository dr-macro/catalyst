<edge source="global_energy_volatility::export_flow_volume" target="iran_hormuz_standoff::chokepoint_control_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">An increase in regional export volumes concentrates more valuable traffic through the strait, expanding opportunities for local actors to exert coercive influence over passage or selectively interdict shipments, thereby raising effective control.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_volatility</data>
  <data key="d39">iran_hormuz_standoff</data>
</edge>
<edge source="global_energy_volatility::export_flow_volume" target="us_china_tech_rivalry::supply_chain_resilience" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A sustained fall in exported crude and refined product volumes raises fuel and feedstock shortages for downstream plants, causing production stoppages and weakening the ability of high‑tech value chains to maintain throughput and recover from disruptions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_volatility</data>
  <data key="d39">us_china_tech_rivalry</data>
</edge>
