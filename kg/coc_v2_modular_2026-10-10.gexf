          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A sharp rise in perceived risk to merchant shipping from attacks in the Middle East prompts allied navies and governments to coordinate patrols, intelligence-sharing, and diplomatic measures, increasing short-term operational and policy alignment among partners also engaged on Russia–Ukraine issues." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
