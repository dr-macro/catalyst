      <edge source="middle_east_maritime_con::route_closure_extent" target="china_taiwan_grayzone_pr::gray_zone_operations" id="70">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Significant closures or avoidance of Middle East sea lanes force US and allied navies to redeploy to the region, reducing forward deterrent presence in the Indo‑Pacific and creating an opening that Beijing exploits by increasing low‑visibility maritime and paramilitary pressure around Taiwan." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_maritime_con::route_closure_extent" target="china_taiwan_grayzone_pr::strategic_pressure" id="71">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Prolonged or expanding closures in Middle Eastern chokepoints divert diplomatic and military attention of major Western powers, lowering the political cost for Beijing to conduct coordinated economic, military and diplomatic pressure campaigns related to Taiwan." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_maritime_con::route_closure_extent" target="global_bond_market_shock::capital_flow_net" id="72">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Expansion of route closures sharply increases trade and geopolitical risk for exposed regions, prompting cross‑border investors to withdraw or withhold capital from affected markets and reallocate to safer jurisdictions, producing net outflows." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="global_bond_market_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_maritime_con::route_closure_extent" target="russia_ukraine_war::energy_supply_gap" id="73">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Physical closure or effective avoidance of key sea lanes in the Middle East prevents scheduled seaborne oil and LNG cargoes from reaching transshipment hubs and end markets that supply European and NATO states, producing immediate delivered shortfalls and market gaps relevant to the Russia–Ukraine war theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
