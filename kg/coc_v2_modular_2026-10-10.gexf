      <edge source="russia_ukraine_war::energy_supply_gap" target="global_bond_market_shock::nominal_yield_level" id="228">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A sudden shortfall in gas and oil shipments drives sharp spikes in consumer and producer energy prices, lifting headline inflation and compelling central banks (particularly in Europe) to raise policy rates, which pushes up sovereign nominal yields across maturities." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_market_shock" />
          <attvalue for="28" value="0" />
