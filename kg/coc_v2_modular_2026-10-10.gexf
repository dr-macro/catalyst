      <edge source="russia_ukraine_war::energy_supply_gap" target="china_taiwan_grayzone_pr::investor_risk_perception" id="227">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Widening energy supply gaps drive higher global energy prices, shipping costs and production disruptions that amplify supply‑chain and inflationary risks for export‑dependent Taiwan, increasing investors' aggregated perception of political‑economic risk in Taiwan‑exposed assets." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
