          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Increased closure or avoidance of key sea lanes directly interrupts shipments of wafers, specialized components and finished accelerators and delays inputs to regional fabs, immediately lowering available accelerator production and deployment capacity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
