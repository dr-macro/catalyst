      <edge source="russia_ukraine_war::sanctions_intensity" target="china_taiwan_grayzone_pr::economic_enforcement" id="244">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="As Western and allied sanctions against Russia intensify, Chinese regulators and state financial institutions increase export controls, compliance checks and enforcement actions to prevent firms from triggering secondary sanctions or illicit finance risks, raising domestic economic enforcement activity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="global_bond_market_shock::capital_flow_net" id="245">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Broad, severe financial and trade sanctions (including de‑banking and payment rail exclusions) force institutional investors and banks to divest sanctioned assets and curtail cross‑border lending, producing large net outflows from affected markets and reducing global cross‑border capital flows into higher‑risk jurisdictions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="global_bond_market_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="middle_east_maritime_con::maritime_energy_flow" id="246">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Stronger sanctions that restrict Russian seaborne oil and LNG exports compel buyers to source more volume from Middle Eastern producers, increasing tanker transits through Suez, the Red Sea and adjacent chokepoints." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_maritime_con" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="middle_east_maritime_con::corporate_operational_re" id="247">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Intensified sanctions increase legal, banking and counterparty risk for firms trading with Russian-linked cargoes, prompting rapid operational responses such as route changes, contract suspensions, reflagging and increased vetting." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_maritime_con" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::sanctions_intensity" target="us_china_tech_trade_riva::procure_finance_rate" id="248">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher sanctions intensity raises counterparty risk and compliance costs for banks and lessors, leading them to reduce or tighten lending and leasing for procurement of AI accelerators where counterparties or supply‑chain links are perceived as exposed to sanctions." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
