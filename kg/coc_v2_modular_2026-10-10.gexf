          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating coordinated Chinese multi‑domain pressure (diplomatic, regulatory, commercial) on third‑country ports, insurers and service providers compels global energy and shipping firms to accelerate reflagging, contractual rerouting and contingency operations to preserve access and compliance." />
          <attvalue for="37" value="6-18 months" />
