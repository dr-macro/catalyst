          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.9" />
          <attvalue for="36" value="A shortfall in available Russian supply tightens global balances and raises benchmark crude prices as markets price the immediate supply deficit and associated risk premia." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_maritime_con" />
          <attvalue for="28" value="0" />
