          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Physical damage to Ukrainian industrial facilities and power/transport infrastructure reduces production and export of critical inputs (notably neon gas and stable power for fabs), immediately lowering semiconductor fab throughput that produces AI accelerators." />
          <attvalue for="37" value="0-6 months" />
