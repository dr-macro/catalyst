          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Greater cohesion among allied navies and partners driven by the conflict leads to coordinated patrols, convoy escorts and intelligence-sharing in regional sea lanes, reducing operators' assessment of exposure to attacks or seizures." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="middle_east_maritime_con" />
          <attvalue for="28" value="0" />
        </attvalues>
