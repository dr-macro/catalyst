          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Destruction of ports, transport and energy infrastructure disrupts exporters' revenues and supply chains, worsening corporate cash flows and sovereign fiscal positions in exposed countries and causing investors to demand wider credit spreads to compensate for higher default and liquidity risk." />
          <attvalue for="37" value="0-6 months" />
