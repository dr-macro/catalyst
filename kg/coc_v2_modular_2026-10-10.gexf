          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Rising market and operator assessments of ship attack/seizure risk increase uncertainty and expected costs for firms with cross‑Strait supply chains, prompting investors to mark up political and operational risk for assets exposed to the Taiwan‑China theater." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
