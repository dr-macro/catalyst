          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Increased policy alignment among allied states in reaction to the war enables coordinated multilateral export controls and harmonized regulatory measures that broaden and tighten restrictions on advanced AI hardware trade with strategic competitors." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
