      <edge source="us_china_tech_trade_riva::regulatory_tightness" target="china_taiwan_grayzone_pr::strategic_pressure" id="413">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Stronger US export controls and regulatory requirements increase China's use of coordinated economic, diplomatic, and military levers (e.g., trade measures, targeted sanctions, naval posturing) as a calibrated retaliation and deterrent against actors implementing those controls." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade_riva::regulatory_tightness" target="china_taiwan_grayzone_pr::economic_enforcement" id="414">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Tighter foreign tech/regulatory regimes prompt Chinese authorities to escalate domestic enforcement (export reviews, audits, capital controls and trade compliance actions) to control flows and punish firms perceived to undermine strategic supply chains." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade_riva::regulatory_tightness" target="global_bond_market_shock::nominal_yield_level" id="415">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Sharp new US/China export controls and regulatory escalation materially raise geopolitical and policy risk premia, prompting global investors to demand higher yields on sovereign debt and pushing nominal yields up." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="global_bond_market_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade_riva::regulatory_tightness" target="middle_east_maritime_con::perceived_shipping_risk" id="416">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Tighter US/Western export controls on advanced chips and AI hardware prompt China and third‑party actors to increase naval escorts, militia patrols and hardening of commercial convoys to protect critical imports, and prompt insurers and shippers to reassess exposure—raising market perceptions of shipping risk in Middle Eastern sea lanes." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="middle_east_maritime_con" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_tech_trade_riva::regulatory_tightness" target="russia_ukraine_war::sanctions_intensity" id="417">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A near-term tightening of export controls and regulatory regimes on advanced AI hardware by the US/EU will be operationalized by adding more entities, technologies and intermediary channels to restricted lists and by expanding enforcement cooperation with partners, directly increasing the breadth and severity of sanctions regimes relevant to Russia and its procurement networks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_tech_trade_riva" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
