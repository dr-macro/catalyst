      <edge source="global_bond_market_shock::capital_flow_net" target="china_taiwan_grayzone_pr::investor_risk_perception" id="615">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Acute net capital outflows from China/Taiwan assets following a global bond shock raise liquidity and FX concerns and trigger repricing of political and operational risk for regional exposures, directly increasing investor perceptions of cross‑strait investment risk." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_market_shock::capital_flow_net" target="middle_east_maritime_con::maritime_energy_flow" id="616">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Net capital outflows from regional markets reduce foreign-exchange liquidity and import financing for energy buyers and charter markets, causing immediate reductions or delays in seaborne crude, product and LNG shipments through Middle East routes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="39" value="middle_east_maritime_con" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_market_shock::capital_flow_net" target="russia_ukraine_war::resilience_capacity" id="617">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sudden decline in cross‑border capital flows to the conflict region constrains financing for reconstruction contractors and imports of repair equipment and spare parts, slowing restoration and lowering repair capacity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_market_shock::capital_flow_net" target="us_china_tech_trade_riva::accel_supply_capacity" id="618">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Higher net cross‑border capital inflows into hardware‑producing jurisdictions increase available project financing and foreign direct investment for factory build‑out and tooling, lifting accelerator production and deployment capacity over the medium term." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
