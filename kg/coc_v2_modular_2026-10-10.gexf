        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Tighter Chinese enforcement of trade, payment and customs rules (e.g., stricter import licensing, payment-screening, or sudden restrictions) disrupts Chinese refiners' crude procurement and payment flows, causing cancelled or deferred shipments from Middle Eastern suppliers and lowering seaborne energy throughput." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="china_taiwan_grayzone_pr" />
          <attvalue for="39" value="middle_east_maritime_con" />
          <attvalue for="28" value="0" />
