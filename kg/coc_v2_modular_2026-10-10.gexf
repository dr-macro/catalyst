          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Acute fuel and gas shortfalls drive spikes in energy prices and inflationary pressure, prompting faster monetary tightening and risk‑off behavior that reduces the availability and depth of capital markets for AI companies and hardware financing." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
