        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Deterioration or visible fragmentation in allied cohesion over the Russia response reduces Beijing's perceived political and military costs of coercion, prompting China to step up coordinated multi‑domain pressure campaigns toward Taiwan." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
