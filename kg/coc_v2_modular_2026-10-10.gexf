          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A marked rise in global nominal yields increases the cost of carry and strengthens the discount rate (and often the dollar), reducing speculative and demand-side support for oil and exerting downward pressure on crude benchmark prices." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="39" value="middle_east_maritime_con" />
