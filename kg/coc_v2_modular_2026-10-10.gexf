      <edge source="middle_east_maritime_con::corporate_operational_re" target="china_taiwan_grayzone_pr::economic_enforcement" id="102">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="When firms rapidly reroute, suspend or relocate maritime‑dependent operations in response to Middle East disruptions, Chinese authorities respond by ramping targeted fiscal, regulatory and trade enforcement (e.g., audits, tighter approvals, export controls) to deter capital flight and preserve economic leverage." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="china_taiwan_grayzone_pr" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_maritime_con::corporate_operational_re" target="global_bond_market_shock::contagion_intensity" id="103">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Coordinated, large‑scale operational responses (suspensions, reroutings, capacity reallocations) create simultaneous revenue and liquidity shocks across multiple sectors and regions, increasing the likelihood and strength of cross‑market stress transmission." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="global_bond_market_shock" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_maritime_con::corporate_operational_re" target="russia_ukraine_war::resilience_capacity" id="104">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="If energy and maritime companies accelerate suspensions and withdraw crews, contractors and specialized logistics from risky regions, the pool of private-sector repair contractors, equipment and shipping slots available for rebuilding and sustaining critical infrastructure in the Russia–Ukraine theater is reduced, lowering recovery speed and capacity." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="russia_ukraine_war" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="middle_east_maritime_con::corporate_operational_re" target="us_china_tech_trade_riva::accel_demand_intensity" id="105">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="When firms intensify operational responses (rerouting, hedging), they often accelerate orders and stockpile AI accelerators to hedge supply disruptions, producing a near-term spike in aggregate accelerator demand." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="middle_east_maritime_con" />
          <attvalue for="39" value="us_china_tech_trade_riva" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
