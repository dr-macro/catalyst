          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Acute disruptions to energy and key commodity supplies raise near-term inflation expectations and term premia, forcing repricing of long-dated sovereign bonds upward." />
