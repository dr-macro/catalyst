          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Heightened volatility in commodity and freight markets tied to the Russia–Ukraine war raises perceived systemic risk for tanker and merchant routes, prompting insurers to widen war‑risk and hull/policy premia for ships operating in regions where Iran exerts pressure." />
          <attvalue for="36" value="0-6 months" />
