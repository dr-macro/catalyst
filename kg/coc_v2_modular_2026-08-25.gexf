      <edge source="iran_maritime_pressure::oil_flow_volume" target="russia_ukraine_war::critical_supply_risk" id="78">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A reduction in crude and refined product throughput through key chokepoints directly increases shortages and rerouting pressure for fuel and bunker supply chains used to sustain military and logistical operations supporting the Ukraine war, raising critical‑supply risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_maritime_pressure" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_maritime_pressure::oil_flow_volume" target="treasury_market_stress::long_term_yields" id="79">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained increase in oil transit volumes eases near‑term supply concerns, lowers upside inflation and geopolitical risk premia priced into long‑dated sovereign bonds, and so reduces long‑term yields." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_maritime_pressure" />
          <attvalue for="38" value="treasury_market_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_maritime_pressure::oil_flow_volume" target="us_canada_tariff_row::political_pressure_level" id="80">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sustained reduction in oil transit volume pushes up fuel and transport costs, hurting energy‑intensive sectors and regional employers who then press policymakers for protective trade actions or relief, raising domestic political pressure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_maritime_pressure" />
          <attvalue for="38" value="us_canada_tariff_row" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_maritime_pressure::oil_flow_volume" target="us_china_tech_rivalry::compute_capacity" id="81">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Acute reductions in oil transit volume drive up regional fuel and electricity prices and can cause localized fuel shortages, forcing temporary curtailment or higher operating costs at energy‑intensive datacenters and fabs and thereby reducing available compute." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_maritime_pressure" />
          <attvalue for="38" value="us_china_tech_rivalry" />
