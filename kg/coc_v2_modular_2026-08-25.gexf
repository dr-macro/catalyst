      <edge source="iran_maritime_pressure::shipping_insurance_premi" target="russia_ukraine_war::market_disruption" id="98">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A sharp rise in shipping insurance and war‑risk premia for vessels in the Iran‑affected sea lanes immediately raises transport costs, forces rerouting and hedging, and triggers price and volatility spikes in energy, grain and commodity markets linked to the Russia–Ukraine conflict." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_maritime_pressure" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_maritime_pressure::shipping_insurance_premi" target="treasury_market_stress::market_volatility" id="99">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rapid rise in shipping war‑risk and insurance premia acts as a high‑frequency signal of elevated geopolitical risk that causes immediate repricing across fixed‑income desks and increases trade volumes into/out of Treasuries, raising intramarket price swings." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_maritime_pressure" />
          <attvalue for="38" value="treasury_market_stress" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_maritime_pressure::shipping_insurance_premi" target="us_canada_tariff_row::political_pressure_level" id="100">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A sharp rise in shipping insurance and war‑risk premia immediately raises landed import prices and delivery uncertainty for firms and consumers, spurring industry and constituency lobbying for protective or compensatory trade measures that increase domestic political pressure on governments." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_maritime_pressure" />
          <attvalue for="38" value="us_canada_tariff_row" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_maritime_pressure::shipping_insurance_premi" target="us_china_tech_rivalry::chip_manufacturing_cap" id="101">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising war‑risk and hull insurance premia raise the cost and risk of maritime transport for high‑value semiconductor tools, substrates and chemicals, prompting delays, cancellations or reduced frequency of shipments that create immediate throughput bottlenecks at fabs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_maritime_pressure" />
          <attvalue for="38" value="us_china_tech_rivalry" />
          <attvalue for="27" value="0" />
        </attvalues>
