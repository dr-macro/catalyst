          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Deep US‑Canada manufacturing integration means tariffs or border frictions disrupt delivery of servers, power equipment and specialized components for North American data centers, delaying builds and expansions and reducing available AI training/inference compute capacity in the near term." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_canada_tariff_row" />
          <attvalue for="38" value="us_china_tech_rivalry" />
