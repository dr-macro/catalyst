          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sharp increases in Treasury-market volatility produce visible losses for pension funds, money-market stress and sudden credit tightening for exporters and manufacturers, which quickly raises domestic business and voter demands for protectionist measures and therefore heightens political pressure to impose tariffs." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="treasury_market_stress" />
          <attvalue for="38" value="us_canada_tariff_row" />
