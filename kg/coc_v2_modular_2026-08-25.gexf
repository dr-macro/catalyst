          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp Treasury-market volatility triggers risk-off behavior by asset managers and creates political pressure on legislators and ministries to shore up domestic markets, causing donor states and private contractors to slow or defer shipments and financing for Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="treasury_market_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
