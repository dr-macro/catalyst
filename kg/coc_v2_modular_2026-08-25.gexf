          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Disruption of integrated US–Canada supply and maintenance chains delays delivery of spare parts, repair crews and specialist equipment used for energy and logistics infrastructure relevant to Ukraine’s sustainment, increasing susceptibility to outages and cascading failures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_canada_tariff_row" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_canada_tariff_row::industrial_interdependen" target="us_china_tech_rivalry::compute_capacity" id="495">
