          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.9" />
          <attvalue for="35" value="Volatility and functional strains in commodity, insurance and related markets produce margin calls, forced reallocations and cross-market spillovers that directly amplify price swings in the Treasury market." />
          <attvalue for="36" value="0-3 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="treasury_market_stress" />
          <attvalue for="27" value="0" />
