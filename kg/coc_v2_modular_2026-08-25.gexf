      <edge source="iran_maritime_pressure::maritime_security_level" target="russia_ukraine_war::international_support_fl" id="93">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="An increase in naval escorts and active maritime security in response to Iran pressure lowers transit risk for weapons and aid shipments and thereby facilitates higher rates of military and materiel transfers to Ukraine; conversely, a drop in security suppresses those flows." />
