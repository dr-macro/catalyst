      <edge source="us_canada_tariff_row::industrial_interdependen" target="russia_ukraine_war::critical_supply_risk" id="493">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A breakdown in deep US–Canada manufacturing integration severs just‑in‑time lines for components (electronics, ammunition subcomponents, vehicle parts) used in Western supplies to Ukraine, directly increasing the risk of shortages and rerouting failures in those critical supply chains." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_canada_tariff_row" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
