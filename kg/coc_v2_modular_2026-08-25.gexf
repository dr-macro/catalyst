      <edge source="treasury_market_stress::market_volatility" target="russia_ukraine_war::critical_supply_risk" id="606">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Elevated volatility in Treasury and related fixed-income markets leads banks and insurers to withdraw or repricing trade finance and war-risk insurance, raising the likelihood of interrupted deliveries of fuel, spare parts and munitions into Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="treasury_market_stress" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
