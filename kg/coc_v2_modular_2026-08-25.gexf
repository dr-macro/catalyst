          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Heightened commodity and financial volatility tied to the conflict increases investor risk aversion and liquidity constraints, producing a measurable short-term pullback in venture and institutional funding into AI startups and projects." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
