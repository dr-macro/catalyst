  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Material risks to commodity supplies trigger export controls, rerouting of trade and emergency diplomacy that rapidly transmit political and economic shocks and signals across neighboring and linked states.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_energy_volatility</data>
  <data key="d39">global_political_realign</data>
</edge>
