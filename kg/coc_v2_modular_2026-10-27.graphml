<edge source="global_political_realign::institutional_trust" target="global_energy_volatility::energy_price_level" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A marked decline in institutional trust precipitates policy paralysis, regulatory flip-flops or elevated risk of resource seizures that reduce effective supply or add a sustained risk premium, lifting energy price levels.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_political_realign</data>
  <data key="d39">global_energy_volatility</data>
</edge>
<edge source="global_political_realign::institutional_trust" target="russia_ukraine_war::governmental_pressure_fl" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Declines in public trust in institutions incentivize governments to exert more formal and informal pressure on private communications providers to control narratives and limit disruptive content related to the conflict.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_political_realign</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_political_realign::institutional_trust" target="us_china_rivalry::regulatory_scrutiny" id="0">
