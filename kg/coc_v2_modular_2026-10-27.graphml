  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.9</data>
  <data key="d36">An increased supply disruption risk premium is directly incorporated into bids and futures pricing, raising the market-clearing price for energy commodities above baseline supply-demand fundamentals.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">global_energy_volatility</data>
</edge>
<edge source="iran_regional_escalation::energy_supply_risk_premi" target="global_political_realign::investor_sentiment" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Rising risk premia on energy supply elevate perceived geopolitical and market risk, prompting portfolio reallocation toward safe assets and a contemporaneous deterioration in investor risk appetite.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">global_political_realign</data>
</edge>
