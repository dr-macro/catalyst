  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Visible government pressure on private communications providers to censor or alter services erodes public perceptions of institutional independence and fairness, causing a measurable drop in aggregate trust in core institutions.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">global_political_realign</data>
</edge>
<edge source="russia_ukraine_war::governmental_pressure_fl" target="us_china_rivalry::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.75</data>
  <data key="d36">Visible government pressure on private comms providers to alter services in the Ukraine war normalizes and politicizes national-security interventions in commercial tech, prompting regulators to open investigations, tighten reporting requirements and broaden oversight of AI firms and cross‑border data/chip flows tied to the US–China rivalry.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">russia_ukraine_war</data>
  <data key="d39">us_china_rivalry</data>
</edge>
