<edge source="us_china_rivalry::regulatory_scrutiny" target="global_energy_volatility::commodity_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Escalating AI-related export controls and compliance enforcement drive onshoring and stockpiling of critical chips and associated metals and inputs, producing localized bottlenecks and raising assessed supply-disruption risk for energy- and metals-related commodity chains.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">global_energy_volatility</data>
</edge>
<edge source="us_china_rivalry::regulatory_scrutiny" target="global_political_realign::crossborder_signal" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Higher regulatory scrutiny tied to US–China rivalry (export controls, sanctions, enforcement actions) generates immediate transnational alerts and countermeasures that propagate through diplomatic channels, supply chains and financial markets, increasing the speed and strength of cross-border shock transmission.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">global_political_realign</data>
</edge>
<edge source="us_china_rivalry::regulatory_scrutiny" target="russia_ukraine_war::governmental_pressure_fl" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Escalating regulatory scrutiny of AI vendors tied to US–China rivalry generates additional formal and informal government demands on commercial communications providers (compliance checks, export-control enforcement, data-localization orders) relevant to the Russia–Ukraine theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="us_china_rivalry::regulatory_scrutiny" target="russia_ukraine_war::commercial_satcom_access" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Regulatory bans or compliance burdens on specific AI/telemetry software and foreign vendors implicated by US–China rivalry cause satellite operators or their software suppliers to disable features or withdraw services in contested regions, reducing available commercial satcom capacity.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">us_china_rivalry</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
