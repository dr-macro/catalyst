<edge source="iran_regional_escalation::seaborne_transport_disru" target="russia_ukraine_war::military_dependency_comm" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Disruptions to maritime logistics delay delivery of military-grade communications terminals and bespoke SATCOM hardware to Ukraine and its partners, leading frontline forces to rely more heavily on immediately available commercial satellite communications for command, control and ISR.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
