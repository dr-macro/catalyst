<edge source="iran_regional_escalation::regional_conflict_intens" target="global_energy_volatility::investor_risk_appetite" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Escalating regional hostilities raise geopolitical uncertainty and prompt portfolio reallocations toward safe assets, reducing aggregate investor willingness to hold riskier energy and commodity exposures.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">global_energy_volatility</data>
</edge>
<edge source="iran_regional_escalation::regional_conflict_intens" target="global_political_realign::protest_magnitude" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.72</data>
  <data key="d36">Sharp increases in regional fighting produce high-casualty incidents and intense media coverage that mobilize local populations and diasporas into immediate demonstrations for or against government policy and military action.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">global_political_realign</data>
</edge>
<edge source="iran_regional_escalation::regional_conflict_intens" target="russia_ukraine_war::service_restriction_inte" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.55</data>
  <data key="d36">Escalating regional conflict raises operational, insurance and legal risk for commercial providers, causing them to proactively implement technical restrictions (geofencing, beam shutdowns, bandwidth curtailment) over broader regions, which increases the intensity and scope of service restrictions affecting users in the Russia–Ukraine war zone.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="iran_regional_escalation::regional_conflict_intens" target="us_china_rivalry::investor_risk_appetite" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Sustained escalation in regional conflicts increases geopolitical tail‑risk perceptions among global asset managers and VC funds, causing a measurable pullback in willingness to accept valuation and operational risk in internationally linked AI investments.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">iran_regional_escalation</data>
  <data key="d39">us_china_rivalry</data>
