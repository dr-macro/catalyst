<edge source="global_political_realign::crossborder_signal" target="global_energy_volatility::commodity_supply_risk" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.75</data>
  <data key="d36">Faster and stronger cross-border transmission of political and regulatory shocks (sanctions, export controls, border closures) causes secondary supplier interruptions and logistical cascades that raise commodity supply disruption risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_political_realign</data>
  <data key="d39">global_energy_volatility</data>
</edge>
<edge source="global_political_realign::crossborder_signal" target="iran_regional_escalation::cross_border_strike_freq" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.85</data>
  <data key="d36">Faster, stronger cross-border signal transmission (communications, targeting data and logistics channels) directly enables Iranian command-and-control and proxy networks to coordinate and time more frequent long‑range strikes across borders.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_political_realign</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="global_political_realign::crossborder_signal" target="iran_regional_escalation::seaborne_transport_disru" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Enhanced cross‑border signalling accelerates coordination of maritime harassment, interdiction and information operations by state and proxy actors (targeting routes, flag states or ports), directly increasing rates of seaborne transport disruption.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_political_realign</data>
  <data key="d39">iran_regional_escalation</data>
</edge>
<edge source="global_political_realign::crossborder_signal" target="russia_ukraine_war::service_restriction_inte" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">Faster and stronger cross-border transmission of political information and coordination prompts states to implement targeted technical and policy restrictions (throttling, geofencing, targeted shutdowns) to blunt spillovers into the Russia–Ukraine theatre.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_political_realign</data>
  <data key="d39">russia_ukraine_war</data>
</edge>
<edge source="global_political_realign::crossborder_signal" target="us_china_rivalry::regulatory_scrutiny" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.65</data>
  <data key="d36">Faster and stronger cross-border transmission of political, information or financial shocks leads governments to impose export controls, data/localization rules and additional compliance checks on cross-border AI activity, increasing regulatory scrutiny.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_political_realign</data>
  <data key="d39">us_china_rivalry</data>
</edge>
