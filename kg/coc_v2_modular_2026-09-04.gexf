      <edge source="us_iran_hostilities::maritime_incident_rate" target="energy_supply_reordering::supply_chain_bottleneck" id="39">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rise in maritime security incidents (attacks, mines, interdictions) directly causes port closures, longer berth queues, rerouting to longer routes and inspection delays that increase logistics congestion and bottlenecks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="39" value="energy_supply_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_hostilities::maritime_incident_rate" target="global_bond_turmoil::market_volatility" id="40">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Higher frequency of maritime security incidents produces episodic news shocks about trade and supply risk that trigger rapid portfolio rebalancing and larger intraday price swings in bond and related markets, raising measured market volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_hostilities::maritime_incident_rate" target="russia_ukraine_warfare::alliance_cohesion" id="41">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A rising tempo of maritime incidents in the Persian Gulf forces allies to prioritize divergent national responses and burden-sharing (security patrols, force posture, energy exemptions), producing fractures in policy alignment and coordinated action on Russia-related security measures." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="39" value="russia_ukraine_warfare" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_hostilities::maritime_incident_rate" target="us_china_competition::geopolitical_tension" id="42">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rise in security incidents affecting commercial and flagged vessels creates diplomatic disputes and accusations (over responsibility, freedom of navigation and convoying), leading the US and China to take opposing public and policy positions that increase bilateral strategic friction." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="39" value="us_china_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
