      <edge source="us_china_competition::geopolitical_tension" target="energy_supply_reordering::sanction_intensity" id="401">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.85" />
          <attvalue for="36" value="Escalating US–China strategic rivalry triggers new targeted export controls, secondary-sanctions threats and more aggressive enforcement against counterparties, directly raising the intensity of sanctions applied to firms and transactions." />
