      <edge source="global_bond_turmoil::market_volatility" target="energy_supply_reordering::crude_export_flow_rate" id="583">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Spikes in bond-market volatility drive higher margin calls and counterparty credit limits for commodity traders and refiners, causing temporary reductions in forward hedging and executed shipments that lower crude export flow rates." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="39" value="energy_supply_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_turmoil::market_volatility" target="us_china_competition::geopolitical_tension" id="584">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp increases in bond‑market volatility induce policy makers to adopt protective, visible measures (capital controls, defensive industrial measures, public warnings) that escalate public confrontation and reciprocal trade/tech measures between the US and China." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="39" value="us_china_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_turmoil::market_volatility" target="us_iran_hostilities::oil_shipment_throughput" id="585">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A spike in bond-market volatility raises war-risk and hull insurance premia and short-term funding costs for shipowners, prompting rerouting, voyage cancellations and capacity idling that immediately reduce oil shipments through contested maritime routes." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="39" value="us_iran_hostilities" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="global_bond_turmoil::market_volatility" target="us_iran_hostilities::naval_military_intensity" id="586">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sharp increases in financial-market volatility that threaten oil and trade flows incentivize US policymakers and regional commands to surge naval escorts, patrols and deterrent operations to reassure markets and deter opportunistic attacks." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="39" value="us_iran_hostilities" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
