          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A rise in crude export flows eases near-term global oil supply, lowering headline inflation and inflation risk premia and thereby reducing long-duration nominal government yields." />
          <attvalue for="37" value="0-6 months" />
