          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Tighter bond-market liquidity reduces availability of short-term funding and repo/secured financing used by traders, shipping firms and ports, increasing delays and congestion that raise supply-chain bottleneck levels for crude and equipment." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="39" value="energy_supply_reordering" />
          <attvalue for="28" value="0" />
