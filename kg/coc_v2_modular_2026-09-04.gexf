          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="A sudden drop in bond‑market liquidity increases transaction, hedging and trade‑finance costs and can interrupt FX and settlement channels used by defense firms and intermediaries, causing delays or cancellations of weapons deliveries." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="global_bond_turmoil" />
          <attvalue for="39" value="russia_ukraine_warfare" />
