          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating sanctions that constrain energy exports and financial channels push up near‑term headline inflation and risk premia, leading markets to price a higher path for short‑term policy rates." />
