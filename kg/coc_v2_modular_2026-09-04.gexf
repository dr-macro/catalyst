      <edge source="us_china_competition::geopolitical_tension" target="energy_supply_reordering::foreign_capital_commitme" id="402">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Heightened rivalry increases perceived political and sanction risk for investors in jurisdictions tied to the adversary, causing firms and financiers to delay, withdraw or reduce committed upstream oil project capital." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="energy_supply_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="global_bond_turmoil::market_volatility" id="403">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Spikes in US–China geopolitical competition raise event-risk and counterparty-uncertainty that prompt rapid repositioning and stop-driven trading in fixed-income markets, directly increasing short-term bond-market price volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="russia_ukraine_warfare::arms_transfer_rate" id="404">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Intensified US–China strategic competition prompts the United States and partners to accelerate and expand conventional weapons transfers to Ukraine as both signaling to rivals and reassurance to allies, increasing the flow of arms into the theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="russia_ukraine_warfare" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="us_iran_hostilities::maritime_incident_rate" id="405">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="As US–China competition intensifies, US naval assets and surveillance are redeployed toward the Indo‑Pacific, reducing forward deterrence in the Persian Gulf and thereby prompting Iran to increase harassment and interdiction of commercial vessels." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="us_iran_hostilities" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="us_iran_hostilities::naval_military_intensity" id="406">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="A rising US–China rivalry causes the US and partners to shift carriers, escorts and patrol groups to the Indo‑Pacific, directly lowering the tempo of US-led naval operations in the Middle East theatre." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_china_competition" />
          <attvalue for="39" value="us_iran_hostilities" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_china_competition::geopolitical_tension" target="us_iran_hostilities::restrictive_measures_int" id="407">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Escalating US–China strategic rivalry prompts the US to tighten secondary sanctions and port/service restrictions aimed at preventing China‑Iran economic ties, thereby raising the intensity of maritime‑related restrictive measures against Iran." />
