      <edge source="us_iran_hostilities::global_oil_price_level" target="energy_supply_reordering::foreign_capital_commitme" id="83">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Sustained higher global oil prices improve project economics and expected returns, prompting international firms and financiers to increase pledged capital or restart delayed upstream/midstream investments in the producing jurisdiction." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="39" value="energy_supply_reordering" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_hostilities::global_oil_price_level" target="global_bond_turmoil::long_term_nominal_yield" id="84">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.8" />
          <attvalue for="36" value="Sustained rises in global oil prices lift realized and expected CPI inflation and inflation risk premia, prompting investors to demand higher compensation on long-duration nominal government bonds and thus pushing long-term yields up." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="us_iran_hostilities::global_oil_price_level" target="russia_ukraine_warfare::kinetic_strike_intensity" id="85">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="A spike in global oil prices driven by US–Iran hostilities raises Russian hydrocarbon export revenues and budgetary room for procurement and munitions production, enabling Moscow to sustain or increase the tempo and scale of overt kinetic strikes in Ukraine." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="39" value="russia_ukraine_warfare" />
          <attvalue for="28" value="0" />
        </attvalues>
