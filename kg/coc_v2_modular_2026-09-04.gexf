          <attvalue for="33" value="-" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="Higher naval and kinetic activity around export terminals and choke points reduces safe access for tankers, forces loadings to be suspended or capacities reduced, and thereby directly cuts exported volumes." />
