      <edge source="energy_supply_reordering::sanction_intensity" target="global_bond_turmoil::market_volatility" id="747">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="An increase in sanctions enforcement abruptly removes counterparties and raises uncertainty about energy deliveries and payment channels, triggering rapid repricing across rates and credit and spiking short-term bond-market volatility." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_supply_reordering" />
          <attvalue for="39" value="global_bond_turmoil" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_reordering::sanction_intensity" target="russia_ukraine_warfare::kinetic_strike_intensity" id="748">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.6" />
          <attvalue for="36" value="Intensified sanctions targeting a key energy producer's exports (particularly Russia) reduce short‑term revenues and may prompt the sanctioned state to escalate overt military operations in Ukraine to compensate politically and attempt to change bargaining dynamics." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_supply_reordering" />
          <attvalue for="39" value="russia_ukraine_warfare" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_reordering::sanction_intensity" target="us_china_competition::geopolitical_tension" id="749">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.75" />
          <attvalue for="36" value="A sharp increase in sanctions on a major oil exporter prompts China to deepen energy partnerships, purchase via secondary channels, and provoke US countermeasures and diplomatic penalties, producing immediate interstate friction between Washington and Beijing." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_supply_reordering" />
          <attvalue for="39" value="us_china_competition" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_reordering::sanction_intensity" target="us_iran_hostilities::maritime_incident_rate" id="750">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="3" />
          <attvalue for="35" value="0.7" />
          <attvalue for="36" value="Tighter external sanctions on a producing jurisdiction (e.g., oil export curbs or ship-targeted financial measures) prompt retaliatory asymmetric maritime actions (seizures, harassment, mine/IED placement) against commercial shipping and third-party vessels to raise costs and pressure enforcement states, increasing incident frequency." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_supply_reordering" />
          <attvalue for="39" value="us_iran_hostilities" />
          <attvalue for="28" value="0" />
        </attvalues>
      </edge>
      <edge source="energy_supply_reordering::sanction_intensity" target="us_iran_hostilities::naval_military_intensity" id="751">
        <attvalues>
          <attvalue for="27" value="cross_causal" />
          <attvalue for="33" value="+" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Escalating sanctions drive both the producing state to increase naval patrols and harassment operations and the US (and partners) to deploy additional naval assets for interdiction, escorting and deterrence, raising overall maritime military activity." />
          <attvalue for="37" value="0-6 months" />
          <attvalue for="38" value="energy_supply_reordering" />
          <attvalue for="39" value="us_iran_hostilities" />
          <attvalue for="28" value="0" />
        </attvalues>
