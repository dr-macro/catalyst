          <attvalue for="33" value="-" />
          <attvalue for="29" value="2" />
          <attvalue for="35" value="0.65" />
          <attvalue for="36" value="Sustained oil-price spikes raise energy and transport costs and increase capital costs and inflation risks, which reduce profitability of new fab projects and slow planned capacity expansions for advanced semiconductors used in AI." />
          <attvalue for="37" value="6-18 months" />
          <attvalue for="38" value="us_iran_hostilities" />
          <attvalue for="39" value="us_china_competition" />
