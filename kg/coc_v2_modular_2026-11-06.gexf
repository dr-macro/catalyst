      <edge source="tech_trade_and_chip_riva::geopolitical_tension" target="ai_buildout_and_bust::regulatory_constraint_in" id="886">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Rising geopolitical tensions lead governments to impose or accelerate stricter permitting, security screenings and legal limits on AI infrastructure and foreign participation, raising regulatory intensity for buildout." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_trade_and_chip_riva" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_trade_and_chip_riva::geopolitical_tension" target="iran_gulf_conflict::shipping_disruption_rate" id="887">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalation in great‑power tech rivalry drives increased naval presence, intelligence operations and permissive conditions for proxies, which in turn produces more boarding, harassment and attacks on commercial vessels transiting the Gulf." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_trade_and_chip_riva" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_trade_and_chip_riva::geopolitical_tension" target="russia_ukraine_war::multinational_coop" id="888">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Escalating strategic rivalry in the technology domain sharpens threat perceptions among Western and like‑minded states, prompting them to accelerate and deepen coordinated sanctions, information‑sharing and joint assistance policies toward Russia and Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_trade_and_chip_riva" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_trade_and_chip_riva::geopolitical_tension" target="us_political_realignment::exec_leg_alignment" id="889">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Rising geopolitical tension drives bipartisan framing of tech and national‑security priorities, increasing cooperation and agenda alignment between the executive and key legislative actors on related measures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_trade_and_chip_riva" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="27" value="0" />
