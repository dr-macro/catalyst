          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Greater coordinated action among allies in response to the war produces harmonized export controls, sanctions and joint screening regimes that directly raise the intensity and scope of regulatory restrictions on AI-related trade, investment and operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
