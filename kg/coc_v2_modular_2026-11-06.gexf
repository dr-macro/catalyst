          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="An uptick in strikes against energy and transport infrastructure increases local grid unreliability and insurance/financing costs, which directly depresses ground‑up starts and slows planned data‑center construction in affected regions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_buildout_and_bust" />
