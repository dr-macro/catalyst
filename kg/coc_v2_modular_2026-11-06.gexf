      <edge source="russia_ukraine_war::military_aid_flow" target="iran_gulf_conflict::shipping_disruption_rate" id="447">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained increases in Western military deliveries to Ukraine force redeployment or prioritization of naval and airlift assets toward Europe and away from Gulf security missions, reducing on‑station deterrence and enabling more attacks/inspections that disrupt merchant shipping." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_aid_flow" target="tech_trade_and_chip_riva::crossborder_capital_flow" id="448">
