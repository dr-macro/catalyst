          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rapid tightening of export controls normalizes a harder regulatory posture across technology and adjacent sectors, prompting agencies and legislators to adopt more restrictive rules and enforcement standards." />
