      <edge source="iran_gulf_conflict::oil_price_level" target="russia_ukraine_war::domestic_polit_pressure" id="279">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher oil prices driven by Iran-Gulf tensions raise household energy and transport costs across NATO states, increasing inflationary pressure and voter dissatisfaction and thereby intensifying domestic political constraints on leaders' foreign-policy flexibility." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::oil_price_level" target="tech_trade_and_chip_riva::resource_nationalism" id="280">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained higher oil prices increase rents for resource exporters, giving governments fiscal room and political incentive to tighten export rules, prioritize domestic processing, or assert control over upstream and related inputs." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="tech_trade_and_chip_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::oil_price_level" target="us_political_realignment::regulatory_direction" id="281">
