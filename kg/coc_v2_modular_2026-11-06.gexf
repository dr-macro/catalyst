      <edge source="iran_gulf_conflict::conflict_intensity" target="ai_buildout_and_bust::capital_flow_rate" id="215">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Escalating kinetic activity raises regional geopolitical risk premiums and investor uncertainty, prompting reallocation away from riskier tech and infrastructure bets and reducing net capital flows into AI projects tied to the region or exposed supply chains." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::conflict_intensity" target="ai_buildout_and_bust::regulatory_constraint_in" id="216">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising conflict prompts governments to impose export controls, sanctions, foreign‑ownership limits and heightened national‑security reviews that directly increase regulatory restrictions on AI buildout and operations." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::conflict_intensity" target="russia_ukraine_war::military_aid_flow" id="217">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A spike in Iran-Gulf conflict intensity forces the US and key allies to reallocate munitions, surveillance assets, and logistical lift to the Middle East, slowing or reducing the volume and cadence of weapons and ammunition deliveries destined for Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::conflict_intensity" target="russia_ukraine_war::multinational_coop" id="218">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A significant uptick in Iran-Gulf conflict intensity produces competing operational priorities and threat perceptions among allies (some focused on regional deterrence, others on Europe), creating friction and reducing alignment and coordination on sanctions, timing of aid, and joint actions regarding Russia." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="iran_gulf_conflict::conflict_intensity" target="tech_trade_and_chip_riva::export_control_tightness" id="219">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A rise in kinetic attacks and military incidents prompts immediate national security responses (sanctions, licensing reviews, targeted denial lists) that expand and tighten outbound technology controls to deny dual‑use goods and tech to perceived adversaries." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="tech_trade_and_chip_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
