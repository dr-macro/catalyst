      <edge source="russia_ukraine_war::military_aid_flow" target="ai_buildout_and_bust::capital_flow_rate" id="446">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained high volumes of external military assistance reallocates public budgetary capacity and shifts private investor demand toward defense suppliers while raising geopolitical risk premia, thereby reducing net capital flowing into AI investments and infrastructure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_buildout_and_bust" />
