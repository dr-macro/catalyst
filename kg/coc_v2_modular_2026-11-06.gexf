          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained rises in external military aid raise perceived geopolitical and regulatory risk for investors and trigger tighter foreign investment screening and voluntary divestments in sensitive tech sectors, reducing cross‑border M&amp;A and investment flows." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="tech_trade_and_chip_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_aid_flow" target="us_political_realignment::legislative_control_bala" id="449">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Larger, recurring congressional funding packages for Ukraine make aid a high-profile vote that exposes and deepens intra-majority splits and increases incumbent vulnerability in swing districts, narrowing the governing coalition's legislative margin during the next election cycle." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_political_realignment" />
          <attvalue for="27" value="0" />
