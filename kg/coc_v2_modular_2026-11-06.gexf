      <edge source="russia_ukraine_war::domestic_polit_pressure" target="ai_buildout_and_bust::corporate_ai_investment_" id="465">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Rising domestic political pressure tied to the war prompts governments and firms to tighten scrutiny of foreign partnerships and to favour politically safe, short‑term expenditures, causing firms to delay or scale back corporate capital expenditures on AI R&amp;D and infrastructure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::domestic_polit_pressure" target="iran_gulf_conflict::negotiation_intensity" id="466">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rising domestic political pressure in donor governments to prioritize resources and political capital for the Ukraine effort reduces diplomatic bandwidth and willingness to invest in Gulf mediation, lowering the momentum and resourcing of formal talks." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::domestic_polit_pressure" target="tech_trade_and_chip_riva::export_control_tightness" id="467">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Rising domestic political pressure on allied governments accelerates legislative and administrative moves to restrict exports of dual‑use tech and chips to countries seen as supporting the aggressor, tightening controls independent of multilateral action." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="tech_trade_and_chip_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::domestic_polit_pressure" target="us_political_realignment::exec_leg_alignment" id="468">
