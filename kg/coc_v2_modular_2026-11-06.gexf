          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A shift toward tighter export and compliance regulation increases approval times and legal hurdles for defense transfers and dual‑use shipments, slowing the pace and volume of material deliveries to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_realignment" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
