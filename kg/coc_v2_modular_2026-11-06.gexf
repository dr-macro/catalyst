      <edge source="us_political_realignment::exec_leg_alignment" target="ai_buildout_and_bust::data_center_construction" id="42">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Strong alignment between the executive and legislature accelerates interagency permitting, utility coordination and access to federal sites/permits, reducing delay and increasing the rate of data‑center groundbreakings and starts." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_realignment" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::exec_leg_alignment" target="iran_gulf_conflict::conflict_intensity" id="43">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Greater executive‑legislative alignment lowers political obstacles to presidential use of force and rapid approval of military aid to Gulf partners, increasing the probability and scale of US‑linked kinetic operations that raise regional conflict intensity." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_realignment" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::exec_leg_alignment" target="russia_ukraine_war::negotiation_hardening" id="44">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Stronger executive‑legislative policy alignment reduces mixed messaging and domestic pressure for compromise, emboldening Kyiv and its backers to adopt firmer negotiating positions and reducing willingness to make concessions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_political_realignment" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::exec_leg_alignment" target="tech_trade_and_chip_riva::export_control_tightness" id="45">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Greater executive‑legislative alignment enables the executive to secure rapid legislative approval for outbound technology restrictions, appropriations for enforcement, and statutory updating of controls, increasing the strictness and scope of export controls." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_realignment" />
          <attvalue for="38" value="tech_trade_and_chip_riva" />
          <attvalue for="27" value="0" />
        </attvalues>
