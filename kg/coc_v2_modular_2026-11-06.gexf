          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A marked escalation in Gulf conflict intensity triggers a rally‑round‑the‑flag dynamic and security-focused congressional votes, increasing short-term policy and agenda alignment between the executive and a majority of legislators on military and sanction measures." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
