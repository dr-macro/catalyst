          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher allied coordination on sanctions and export controls generates political and technical pressure on U.S. agencies and Congress to adopt tighter regulatory measures (sanctions lists, export controls, tariffs, CFIUS-like restrictions) to harmonize policy with partners." />
