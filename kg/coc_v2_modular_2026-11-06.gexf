      <edge source="us_political_realignment::legislative_control_bala" target="ai_buildout_and_bust::capital_flow_rate" id="32">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A dominant legislative majority can pass large, time‑limited subsidies, loan guarantees and targeted tax credits for AI projects that directly unlock institutional and venture capital into AI funds and infrastructure." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_political_realignment" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::legislative_control_bala" target="russia_ukraine_war::military_aid_flow" id="33">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A shift that increases the governing coalition's legislative margin directly eases appropriations and authorization votes, enabling larger and faster congressional-approved weapons and funding packages to flow to Ukraine." />
