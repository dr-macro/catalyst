          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A shift toward regulatory tightening increases permitting timelines, compliance costs and local content or facility‑siting requirements that delay, raise the cost of, or cancel fab investments, reducing near‑term semiconductor production capacity additions." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="us_political_realignment" />
          <attvalue for="38" value="tech_trade_and_chip_riva" />
          <attvalue for="27" value="0" />
