        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Higher rates of shipping disruption physically delay delivery of racks, GPUs, power gear and other specialized components, causing data‑center groundbreakings, outfitting and completions to be postponed or cancelled." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
