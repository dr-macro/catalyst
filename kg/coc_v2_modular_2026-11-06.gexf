      <edge source="tech_trade_and_chip_riva::export_control_tightness" target="ai_buildout_and_bust::corporate_ai_investment_" id="736">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.78" />
          <attvalue for="35" value="Tighter export controls directly block or delay firms' access to advanced accelerators and critical components, raising procurement costs and forcing corporations to scale back or postpone AI capital expenditures." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="tech_trade_and_chip_riva" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_trade_and_chip_riva::export_control_tightness" target="iran_gulf_conflict::conflict_intensity" id="737">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Rapid tightening of export controls on dual‑use tech raises Iranian perceptions of existential economic and military pressure, incentivizing Tehran to increase proxy and direct hostile actions in the Gulf to raise costs and deter further restrictions." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_trade_and_chip_riva" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_trade_and_chip_riva::export_control_tightness" target="russia_ukraine_war::military_aid_flow" id="738">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Tighter export controls on semiconductors, sensors and other dual‑use components directly constrain suppliers and delay deliveries of critical subsystems used in weapons and ISR platforms, reducing the volume and cadence of externally supplied materiel to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_trade_and_chip_riva" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_trade_and_chip_riva::export_control_tightness" target="russia_ukraine_war::negotiation_hardening" id="739">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Broadening and publicizing punitive export restrictions signals punitive intent and raises domestic political costs for the targeted leadership, provoking more intransigent bargaining positions and reducing willingness to compromise in negotiations over the conflict." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="tech_trade_and_chip_riva" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="tech_trade_and_chip_riva::export_control_tightness" target="us_political_realignment::regulatory_direction" id="740">
