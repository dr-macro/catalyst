          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Increased attacks, inspections or route closures delay or block delivery of critical inputs (wafer substrates, gases, specialty chemicals, equipment), forcing fabs to slow or halt runs and thereby reducing effective semiconductor output." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="tech_trade_and_chip_riva" />
