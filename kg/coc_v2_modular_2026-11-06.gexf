          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="Higher alignment among external states produces coordinated sanction packages and harmonized control lists, prompting governments to broaden and tighten outbound technology export rules in a synchronized fashion." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="tech_trade_and_chip_riva" />
