          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A spike in kinetic strikes in Ukraine elevates global risk premia for energy supply and logistics (insurance, transit routes), prompting immediate upward pressure on benchmark crude prices." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
