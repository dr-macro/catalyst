          <attvalue for="32" value="-" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="A spike in global oil prices creates political pressure to boost domestic energy output, leading executives and legislators to fast-track deregulatory measures (e.g., expedited permitting, relaxed constraints) that shift net regulatory direction toward deregulatory policies." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="us_political_realignment" />
