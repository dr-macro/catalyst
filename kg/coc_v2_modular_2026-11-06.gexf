      <edge source="iran_gulf_conflict::shipping_disruption_rate" target="russia_ukraine_war::military_aid_flow" id="299">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Increased disruptions to Gulf shipping raise transit times, insurance and rerouting costs for commercial and military cargoes, causing delays, lower throughput or cancellation of arms shipments from manufacturers in Asia/MENA to Europe and thereby reducing effective aid flow to Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
