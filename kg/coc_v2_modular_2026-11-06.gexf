      <edge source="iran_gulf_conflict::oil_price_level" target="ai_buildout_and_bust::corporate_ai_investment_" id="278">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sustained higher oil prices increase energy and input costs and compress corporate margins, causing firms to defer or scale back discretionary capital expenditures such as AI infrastructure, tooling and R&amp;D." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_gulf_conflict" />
          <attvalue for="38" value="ai_buildout_and_bust" />
          <attvalue for="27" value="0" />
        </attvalues>
