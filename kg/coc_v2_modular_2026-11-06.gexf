      <edge source="us_political_realignment::regulatory_direction" target="iran_gulf_conflict::shipping_disruption_rate" id="56">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A shift toward tighter regulatory/sanctions direction triggers more aggressive maritime enforcement, interdictions and inspections of vessels linked to Iran or its proxies, directly increasing the rate of shipping disruptions in the Gulf and adjacent sea lanes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="us_political_realignment" />
          <attvalue for="38" value="iran_gulf_conflict" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="us_political_realignment::regulatory_direction" target="russia_ukraine_war::military_aid_flow" id="57">
