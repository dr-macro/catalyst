          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Sharp upticks in strike frequency create rapid operational changes that compel faster, sometimes contradictory public statements and ad hoc requirements for assistance, reducing the clarity and credibility of policymakers' commitments in the short term." />
