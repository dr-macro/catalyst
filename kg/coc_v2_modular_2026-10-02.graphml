  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widening sovereign credit spreads signal fiscal stress and raise visible pressures for austerity or emergency interventions, which erode public confidence in government competence and institutional reliability.</data>
  <data key="d37">6-18 months</data>
  <data key="d38">global_bond_market_rout</data>
  <data key="d39">alliance_reliability_shi</data>
</edge>
<edge source="global_bond_market_rout::sovereign_credit_spreads" target="russia_ukraine_escalatio::emergency_policy_activat" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">Widening sovereign spreads increase fiscal strain and refinancing costs, pushing governments to deploy emergency energy measures (stock releases, subsidies, export restrictions) to stabilize domestic markets and social unrest.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_rout</data>
  <data key="d39">russia_ukraine_escalatio</data>
