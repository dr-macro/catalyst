<edge source="global_bond_market_rout::market_liquidity" target="alliance_reliability_shi::information_amplificatio" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.7</data>
  <data key="d36">Acute declines in market liquidity produce sharp price moves, trading halts and high-profile distressed transactions that generate intense media coverage and social-media circulation, amplifying crisis narratives.</data>
  <data key="d37">0-3 months</data>
  <data key="d38">global_bond_market_rout</data>
  <data key="d39">alliance_reliability_shi</data>
</edge>
<edge source="global_bond_market_rout::market_liquidity" target="mid_east_gulf_disruption::oil_price_volatility" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.8</data>
  <data key="d36">A bond-market rout drains liquidity across interdealer and commodities desks, thinning market-making in oil futures (wider bid/ask, reduced depth) and so raising realized and implied oil price volatility.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_rout</data>
  <data key="d39">mid_east_gulf_disruption</data>
</edge>
<edge source="global_bond_market_rout::market_liquidity" target="us_china_strategic_rival::semiconductor_resilience" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A bond-market driven liquidity squeeze raises short‑term funding and trade‑finance costs for chip fabs and component suppliers, forcing cutbacks, delayed capex and inventory drawdowns that directly reduce semiconductor supply‑chain robustness.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">global_bond_market_rout</data>
  <data key="d39">us_china_strategic_rival</data>
</edge>
