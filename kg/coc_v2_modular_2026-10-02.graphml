</edge>
<edge source="mid_east_gulf_disruption::oil_price_volatility" target="global_bond_market_rout::long_term_nominal_yields" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">Spikes in oil price volatility raise inflation uncertainty and term premia, driving up long-maturity nominal yields as investors demand greater compensation for inflation and risk.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_gulf_disruption</data>
  <data key="d39">global_bond_market_rout</data>
