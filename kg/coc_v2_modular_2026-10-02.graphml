<edge source="mid_east_gulf_disruption::crude_export_flow" target="global_bond_market_rout::cross_border_flows" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">+</data>
  <data key="d28">2</data>
  <data key="d35">0.6</data>
  <data key="d36">A fall in crude export physical flows alters trade receipts and forces portfolio rebalancing (including repatriation or flight-to-safety), producing measurable shifts in cross-border capital flows.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_gulf_disruption</data>
  <data key="d39">global_bond_market_rout</data>
</edge>
<edge source="mid_east_gulf_disruption::crude_export_flow" target="us_china_strategic_rival::strategic_competition" id="0">
  <data key="d27">cross_causal</data>
  <data key="d33">-</data>
  <data key="d28">3</data>
  <data key="d35">0.7</data>
  <data key="d36">A sustained drop in Gulf crude exports impairs Chinese energy security and prompts Beijing to accelerate bilateral supplier deals and naval/logistical deployments while the U.S. counters with intensified diplomacy, arms sales and sanctions—raising bilateral strategic-economic competition within months.</data>
  <data key="d37">0-6 months</data>
  <data key="d38">mid_east_gulf_disruption</data>
  <data key="d39">us_china_strategic_rival</data>
</edge>
