<edge source="russia_ukraine_war::export_throughput_rate" target="global_financial_tension::portfolio_realloc_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A fall in agricultural export throughput raises near-term sovereign and corporate revenue uncertainty for exporters and trade-linked markets, prompting faster shifts of investor allocations into defensive assets and away from affected EM and commodity-linked positions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">global_financial_tension</data>
</edge>
<edge source="russia_ukraine_war::export_throughput_rate" target="iran_war_stalemate::domestic_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">A fall in Ukrainian/Russian agricultural export throughput tightens global staple supplies and raises food inflation in import-dependent markets like Iran, increasing consumer hardship and domestic political pressure.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">russia_ukraine_war</data>
  <data key="d40">iran_war_stalemate</data>
</edge>
