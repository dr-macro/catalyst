  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Higher risk and incidents to major maritime routes (Suez/Red Sea) force rerouting, increase insurance and voyage times and reduce vessel availability, directly lowering the volume-per-time of agricultural shipments leaving Ukraine and other exporters.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_war_stalemate</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
<edge source="iran_war_stalemate::shipping_disruption" target="us_china_rivalry::geopolitical_tension_lev" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Repeated Iran-related attacks and insurance-cost spikes on key maritime routes force the U.S. and China into naval escorts, competing port-access diplomacy, and security guarantees that raise bilateral strategic tensions.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_war_stalemate</data>
  <data key="d40">us_china_rivalry</data>
</edge>
