<edge source="global_financial_tension::long_term_yield" target="energy_market_shift::capital_flow_oil" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Rising long-term yields increase the discount rate applied to multi-year upstream projects and make debt and equity financing more expensive for capital-intensive oil developments, lowering project NPVs and prompting reduced investment into the sector.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">energy_market_shift</data>
</edge>
<edge source="global_financial_tension::long_term_yield" target="us_china_rivalry::fab_investment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.85</data>
  <data key="d37">Sustained increases in long-term yields raise the discount rate and borrowing costs for multi-year semiconductor projects, reducing NPVs and causing firms and financiers to delay or cancel fab capex starts.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">us_china_rivalry</data>
</edge>
