<edge source="iran_war_stalemate::oil_export_constraint" target="energy_market_shift::capital_flow_oil" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.7</data>
  <data key="d37">Physical or administrative constraints on oil exports reduce predictable revenue streams, raise project and offtake risk, and increase insurer/lender costs, causing upstream investors and banks to withhold or withdraw capital from oil projects.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_war_stalemate</data>
  <data key="d40">energy_market_shift</data>
</edge>
<edge source="iran_war_stalemate::oil_export_constraint" target="global_financial_tension::long_term_yield" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Physical or administrative constraints on oil exports raise global crude prices and inflation expectations, increasing term premia and pushing long-term sovereign yields higher.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_war_stalemate</data>
  <data key="d40">global_financial_tension</data>
</edge>
<edge source="iran_war_stalemate::oil_export_constraint" target="russia_ukraine_war::military_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">Constraints on Middle East oil exports raise global oil prices and therefore Russian export revenues, materially increasing Moscow's short-term budgetary capacity to procure ammunition, pay contractors, and sustain higher-tempo operations in Ukraine.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_war_stalemate</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
