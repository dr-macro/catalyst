<edge source="iran_war_stalemate::shipping_disruption" target="energy_market_shift::asset_transfer_flow" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Increased risk of maritime interdiction or route instability makes cross-border due diligence and deal execution more costly and uncertain, slowing or cancelling planned sales and transfers of energy assets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_war_stalemate</data>
  <data key="d40">energy_market_shift</data>
</edge>
<edge source="iran_war_stalemate::shipping_disruption" target="global_financial_tension::bond_market_liquidity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">Increased risk of maritime interruptions spikes volatility and counterparty/funding strains, causing dealers to pull back and bid-ask spreads to widen, reducing bond market liquidity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">iran_war_stalemate</data>
  <data key="d40">global_financial_tension</data>
</edge>
