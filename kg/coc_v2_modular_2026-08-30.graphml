<edge source="energy_market_shift::expropriation_risk" target="global_financial_tension::bond_market_liquidity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">Rising risk of regulatory expropriation in energy-producing jurisdictions causes dealers and funds to withdraw market-making capacity and reduce willingness to hold affected sovereign/corporate bonds, widening spreads and reducing depth in those bond markets.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">energy_market_shift</data>
  <data key="d40">global_financial_tension</data>
</edge>
<edge source="energy_market_shift::expropriation_risk" target="us_china_rivalry::fab_investment_rate" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.65</data>
  <data key="d37">Increased risk that host governments will seize or alter asset ownership reduces foreign semiconductor firms' willingness to commit capital to new fabs, slowing the rate of fab investment in affected jurisdictions.</data>
  <data key="d38">6-18 months</data>
  <data key="d39">energy_market_shift</data>
  <data key="d40">us_china_rivalry</data>
</edge>
