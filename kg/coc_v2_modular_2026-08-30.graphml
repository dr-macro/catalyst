<edge source="global_financial_tension::short_term_rate" target="energy_market_shift::capital_flow_oil" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">3</data>
  <data key="d36">0.8</data>
  <data key="d37">An increase in short-term interest rates raises the cost of revolving credit and short-dated project financing for E&amp;P firms, causing firms and lenders to cut or delay upstream capital commitments and reducing net capital flows into the oil sector.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">energy_market_shift</data>
</edge>
<edge source="global_financial_tension::short_term_rate" target="iran_war_stalemate::domestic_pressure" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">+</data>
  <data key="d29">3</data>
  <data key="d36">0.7</data>
  <data key="d37">A rise in global short-term interest rates tightens dollar and trade-finance liquidity and increases import financing costs for Iran-dependent firms, producing supply squeezes and price spikes that amplify domestic economic and political pressure.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">iran_war_stalemate</data>
</edge>
<edge source="global_financial_tension::short_term_rate" target="russia_ukraine_war::military_intensity" id="0">
  <data key="d28">cross_causal</data>
  <data key="d34">-</data>
  <data key="d29">2</data>
  <data key="d36">0.6</data>
  <data key="d37">A rise in global short‑term interest rates raises borrowing costs and fiscal pressure on donor governments and on wartime logistics financing, slowing weapons deliveries and sustainment budgets and thereby reducing operational tempo and intensity.</data>
  <data key="d38">0-6 months</data>
  <data key="d39">global_financial_tension</data>
  <data key="d40">russia_ukraine_war</data>
</edge>
