          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.55" />
          <attvalue for="35" value="A spike in hostile incidents in the Hormuz corridor forces Western navies and airlift/logistics assets to be re-tasked to protect shipping and evac/escort missions and creates political attention on the Middle East, which delays shipments and lowers the tempo and political willingness to dispatch new large-scale military transfers to Ukraine." />
