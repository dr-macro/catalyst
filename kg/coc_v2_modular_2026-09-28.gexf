          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A measurable drop in crude export volumes through Hormuz forces rerouting and competition for limited refined product and bunker cargoes, producing short-term logistic bottlenecks and fuel delivery shortfalls that reduce the continuity of power generation and transport fuel supplies in Europe and Ukraine." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
          <attvalue for="38" value="russia_ukraine_war" />
          <attvalue for="27" value="0" />
