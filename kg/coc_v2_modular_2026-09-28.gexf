          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A sharp uptick in Russian strikes raises US demands that China use its leverage to restrain Moscow, and if Beijing does not take visible action the result is an observable decline in US policymakers' trust in Chinese commitments." />
