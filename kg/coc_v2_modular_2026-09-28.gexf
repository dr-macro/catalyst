          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Persistent reductions in Iranian oil exports lead China to deepen bilateral energy deals or covert procurement to secure supplies, which prompts US policymakers to downgrade trust in Chinese commitments to uphold sanctions and cooperative agreements." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
