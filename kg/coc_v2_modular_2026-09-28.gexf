          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="A drop in crude export volumes reduces FX receipts for exporting jurisdictions and forces reserve drawdowns or sovereign/corporate asset sales, producing net capital outflows (reduced cross-border inflows) from those markets." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="iran_hormuz_flashpoint" />
