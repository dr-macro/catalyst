          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Increased kinetic/aerial strikes prompt adversaries to shift to and escalate cyber operations (to degrade sensors, comms, and C2) and to exploit disrupted systems, raising the frequency of successful compromises of AI-dependent infrastructure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
