          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="During bond-market stress, cross-border capital rebalances toward large, liquid incumbents and safe-haven jurisdictions, channeling investment and contracts into a smaller set of AI providers and infrastructure providers and thereby increasing concentration of economic and operational exposure." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_market_shock" />
          <attvalue for="38" value="ai_agent_systemic_risks" />
