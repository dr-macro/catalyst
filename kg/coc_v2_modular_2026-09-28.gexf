          <attvalue for="32" value="-" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Net capital outflows (a fall in cross-border inflows) reduce available financing for traders and insurers and raise counterparty/default concerns, which markets translate quickly into higher market-implied expectations of future oil-supply risk." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="global_bond_market_shock" />
