      <edge source="russia_ukraine_war::military_aid_flow" target="ai_agent_systemic_risks::exposure_concentration" id="96">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.65" />
          <attvalue for="35" value="Surges in military aid concentrate procurement and integration of AI-capable hardware and software with a limited set of defense contractors and cloud/hosting providers, increasing concentration of economic and operational exposure to those actors." />
