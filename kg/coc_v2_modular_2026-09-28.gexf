          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="Faster operational deployment of autonomous and semi-autonomous weaponized agents (loitering munitions, strike drones, swarms) increases the number of platforms available for attacks, raising the observed rate of kinetic and aerial strikes." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="ai_agent_systemic_risks" />
          <attvalue for="38" value="russia_ukraine_war" />
