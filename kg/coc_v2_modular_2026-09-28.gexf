          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="A rapid increase in strikes causes immediate revenue disruption, supply-chain interruption and elevated default and liquidity risk for firms in the combat zone and their suppliers, which raises risk premia and widens corporate bond spreads." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="global_bond_market_shock" />
          <attvalue for="27" value="0" />
        </attvalues>
