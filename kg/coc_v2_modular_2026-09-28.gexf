          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.8" />
          <attvalue for="35" value="Sharp reversals or reductions in cross-border capital flows withdraw financing, force local asset sales and increase risk premia in the region, directly lowering investor confidence in Ukraine/Russia-exposed assets." />
