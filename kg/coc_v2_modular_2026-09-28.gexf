      <edge source="russia_ukraine_war::military_aid_flow" target="iran_hormuz_flashpoint::maritime_attack_frequenc" id="97">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.7" />
          <attvalue for="35" value="A surge in military aid to Ukraine forces the U.S. and allied navies to reassign ships and escorts to the European theatre, reducing persistent deterrent presence in the Persian Gulf and thereby enabling more maritime attacks on commercial shipping." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="iran_hormuz_flashpoint" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_aid_flow" target="us_china_strategic_rival::strategic_tension_level" id="98">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="3" />
          <attvalue for="34" value="0.85" />
          <attvalue for="35" value="A sustained rise in Western military aid to Ukraine causes Beijing to perceive a more assertive US-led security posture and to respond by hardening its own military-diplomatic stance, increasing overall strategic tension between Washington and Beijing." />
          <attvalue for="36" value="0-6 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_strategic_rival" />
          <attvalue for="27" value="0" />
        </attvalues>
      </edge>
      <edge source="russia_ukraine_war::military_aid_flow" target="us_china_strategic_rival::tech_flow_regulation" id="99">
        <attvalues>
          <attvalue for="26" value="cross_causal" />
          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.75" />
          <attvalue for="35" value="Larger and more sophisticated transfers of materiel into the conflict prompt US policymakers to expand and tighten export controls and investment screening on dual‑use technologies to prevent re‑routing or proliferation, increasing regulation affecting China." />
          <attvalue for="36" value="6-18 months" />
          <attvalue for="37" value="russia_ukraine_war" />
          <attvalue for="38" value="us_china_strategic_rival" />
