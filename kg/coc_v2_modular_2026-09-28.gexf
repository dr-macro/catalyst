          <attvalue for="32" value="+" />
          <attvalue for="28" value="2" />
          <attvalue for="34" value="0.6" />
          <attvalue for="35" value="Faster deployment of autonomous/AI-enabled drones, unmanned surface vessels, and precision guidance tools widens operational capacity for state proxies or irregular forces to mount more frequent deniable strikes against commercial shipping." />
